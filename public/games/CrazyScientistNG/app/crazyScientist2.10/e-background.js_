        spinCompleteDelay: 500,
        speedUpReelsFactor: 50,
        intrigueSpeedReelsFactor: 1.5,
        tweenDuration: {
            oldSymbols: 150,
            blur: 75, //50 if forceSetTimeOut false
            newSymbols: 150,
            blurDurationType: 'factor', //duration/duration
            animationType: 'linear'  // custom/linear
        },
        // symbolsBlurKeys: [],
        _symbolsBlurKeys: [],
        tweenStartInterval: 0,
        tweenEndInterval: 0,
        blursShiftOnReelsHold: true
    };

    Object.defineProperty(this.params, 'symbolsBlurKeys', {
        get: function () {
            return this._symbolsBlurKeys;
        },
        set: function (value) {
            var scatters = nge.localData.get('scatterSymbols');

            this._symbolsBlurKeys = value.filter(function (symbol) {
                return scatters.indexOf(symbol) === -1;
            });
        }
    });

    this.params.symbolsBlurKeys =
        nge.App.getInstance('Com.SlotMachine.Symbols')
        .items
        .map(function (symbol) {
            return symbol.name;
        });
});



