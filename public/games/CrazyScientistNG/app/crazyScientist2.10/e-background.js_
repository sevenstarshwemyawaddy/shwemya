nge.App[nge.appNS].Com.Credits = {};



nge.App[nge.appNS].Com.Credits.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _creditContainer;
    var _creditsAmounts;
    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        this.createDefault();

        var data = nge.localData.get('balance');

        _creditContainer = nge.findOne('.creditsNumber');
        _creditsAmounts = nge.findAll('.creditsNumber');

        if (data)
            nge.rafSetTimeout(function () {
                _drawText(data);
            }, 1);


        if (!_created)
            _subscribe();

        _created = true;
        return true;
    };

    var _change = function (data) {
        _drawText(data);

        _creditContainer.maxSizeResize('width', 130);

        return true;
    };

    var _drawText = function (data) {
        var balance = (data && data.totalAmount) ?
            data.totalAmount : nge.localData.get('balance.totalAmount');

        for (var k in _creditsAmounts)
            _creditsAmounts[k].text = nge.Lib.Money.toCoinsInt(balance);
    };

    var _subscribe = function () {
        nge.observer.add('balance.amount', _change);
        nge.observer.add('coins.change', _change);
    };
});



nge.App[nge.appNS].Com.Freespin = {};



nge.App[nge.appNS].Com.Freespin.Controller = nge.Com.Freespin.Controller.extend(function () {
    var _self = this;
    var _spins;

    var _popupImage;
    var _popupText;
    
    var _freespinsInProgress = false;
    var _subscribed = false;
    var _enterAnimationFinished = false;

    var _startFreespinsOnCycleComplete = false;
    var _finishFreespinsOnCycleComplete = false;

    this.freespinStartFrames = [0];
    this.moreFreespinsFrames = [0];
    this.freespinFinishFrames = [0];

    this.animationSpeed = 0;

    this.popupDurations = {
        start: 3000,
        inside: 3000,
        finish: 4650
    };

    this.textAppearsBeforeAnimation = true;

    this.defaultColor = '#FF8600';
    this.defaultFontSize = 16;

    var _baseFreespinStart = this.super.freespinStart.bind(this);
    var _baseFinishFreespin = this.super.finishFreespin.bind(this);

    this._baseFreespinStart = _baseFreespinStart;
    this._baseFinishFreespin = _baseFinishFreespin;

    this.create = function () { 
        this.super.create();
        this.createDefault();

        _freespinsInProgress = false;

        if (_finishFreespinsOnCycleComplete)
            _finishFreespinsOnCycleComplete = false;

        _popupText = nge.findOne('^popupText');
        _popupImage = nge.findOne('^popupImage');
        
        if(_popupImage)
            _popupImage.visible = false;

        if (!_subscribed) 
            this.subscribe();

        _subscribed = true;
    };

    this.setText = function (text) {
        _popupText.text = text || '';
    };

    this.animatePopup = function (options, callback) {
        var frames = options.frames;
        var text = options.text;
        var duration = options.duration;
        callback = callback || function () {};

        var frame = 0;

        var animationFinished = function () {
            if (!_self.textAppearsBeforeAnimation)
                _self.setText(text);
            nge.rafSetTimeout(callback, duration);
        };

        var popupOpenStep = function () {
            _popupImage.loadTexture('popup' + frames[frame]);
            frame += 1;

            frame > frames.length - 1
                ? animationFinished()
                : nge.rafSetTimeout(popupOpenStep, _self.animationSpeed);
        };

        _popupImage.visible = true;
        if (_self.textAppearsBeforeAnimation)
            _self.setText(text);
        popupOpenStep();
    };

    this.closePopup = function () {
        if (_popupImage) {
            _popupImage.visible = false;
        }

        if (_popupText) {
            _popupText.text = '';
        }
    };

    this.startFreespins = function () {
        if (_enterAnimationFinished && !_freespinsInProgress) {
            this.closePopup();
            _baseFreespinStart(_spins);
            _freespinsInProgress = true;
            _enterAnimationFinished = false;
        }
    };

    this.startText = function (spins) {
        return spins + ' FREE GAMES WON';
    };

    this.inProgressText = function (spins) {
        return spins + ' more FREE GAMES WON';
    };

    this.finishText = function () {
        var totalWinCoins = parseFloat((nge.localData.get('freespin.totalWinCoins')).toFixed(2));
        return 'Feature win\n' + totalWinCoins + ' credits';
    };

    this.localFreespinInProgress = function () {
        return _freespinsInProgress;
    };

    var _setDownText = function (text, colors, fontSize) {
        nge.observer.fire('infoPanel.showText', {
            text: text,
            position: 'down',
            colors: colors,
            fontSize: fontSize
        });
    };

    var _freespinStart = function () {
        nge.localData.set('spaceHandler.isEnable', false);
        nge.observer.fire('buttons.disable.auto');
        _enterAnimationFinished = false;

        _freespinsInProgress
            ? nge.observer.fire('popupInsideBonus.animate.start')
            : nge.observer.fire('popup.animate.start');

        var state = _freespinsInProgress ? 'inside' : 'start';

        _self.animatePopup({
            text: _self[_freespinsInProgress ? 'inProgressText' : 'startText'](_spins),
            frames: _freespinsInProgress ? _self.moreFreespinsFrames : _self.freespinStartFrames,
            duration: _self.popupDurations[state],
            freespinState: state
        }, function () {
            if (!_freespinsInProgress) {
                nge.observer.fire('buttons.freespinStart');
                _enterAnimationFinished = true;

                _setDownText(nge.i18n.get('PRESS A BUTTON TO BEGIN'), [{color: _self.defaultColor, from: 0}], _self.defaultFontSize);
                nge.localData.set('spaceHandler.isEnable', true);
            } else {
                _self.closePopup();
                _baseFreespinStart(_spins);
                nge.observer.fire('freespin.resume');
            }
        });
    };

    var _finishFreespin = function () {
        nge.observer.fire('popupFinish.animate.start');

        _self.animatePopup({
            frames: _self.freespinFinishFrames,
            text: _self.finishText(),
            duration: _self.popupDurations.finish,
            freespinState: 'finish'
        }, function () {
            _baseFinishFreespin();
            _freespinsInProgress = false;
            nge.observer.fire('popupFinish.animate.stop');
            nge.observer.fire('buttons.freespinFinish');
            nge.observer.fire('freespin.counterReset');
        });
    };

    this._finishFreespin = _finishFreespin;

    var _winlinesCompleteHandler = function () {
        if (_startFreespinsOnCycleComplete) {
            _startFreespinsOnCycleComplete = false;
            _freespinStart();
        }

        if (_finishFreespinsOnCycleComplete) {
            _finishFreespinsOnCycleComplete = false;
            _self._finishFreespin();
        }
    };

    this.freespinStart = function (spins) {
        _spins = spins;
        _startFreespinsOnCycleComplete = !_self._restoringFlag;
        nge.localData.set('freespin.inProgress', true);

        if (_freespinsInProgress)
            nge.observer.fire('freespin.pause');

        if (_self._restoringFlag) {
            _enterAnimationFinished = true;
            nge.observer.fire('buttons.freespinContinue');
        
            var bonusWin = nge.localData.get('brain.restoreGame.lastResponse.totalBonusWin');
            nge.observer.fire('freespin.restoreText', bonusWin);
        } else {
            _setDownText(nge.i18n.get('BONUS FEATURE WON'), [{color: _self.defaultColor, from: 0}], _self.defaultFontSize);
        }
    };

    this.finishFreespin = function () {
        _finishFreespinsOnCycleComplete = true;
    };

    this.subscribe = function () {
        nge.observer.add('slotMachine.spinStart', this.closePopup);
        nge.observer.add('gamble.taking.stop', this.closePopup);
        nge.observer.add('gamble.go', this.closePopup);
        nge.observer.add('freespin.press.spinButton', this.startFreespins);
        nge.observer.add('spinAndWinComplete', _winlinesCompleteHandler);
        nge.observer.add('freespin.end', function(){
            nge.observer.fire('freespin.counterReset');
        });
    };
});



