nge.Com.LayersSwitcher.Controller = nge.Com.Base.extend(function () {
    var _settings = {
        cfg: null,
        objects: {},
        next: null,
        current: null
    };

    var _self = this;
    var _subscribed;
    var _helper;

    this.create = function () {
        this.createDefault();

        _helper = this.getInstance('Helper');
        _getCfg();

        _settings.next = {name: '', layer: false};
        _settings.current = {name: '', layer: false};

        _findSelectors();
        _show(_settings.cfg.defaultLayer);

        if (!_subscribed)
            _subscribe();

        if (_settings.cfg.autoSwitch) {
            var rafer = function () {
                nge.rafSetTimeout(rafer, _settings.cfg.autoSwitchDelay);
                var totalLayersCount = Object.keys(_settings.cfg.layers).length - 1;
                var layer = nge.Lib.Helper.getRandomInt(0, totalLayersCount);
                var key = Object.keys(_settings.cfg.layers[layer]);
                nge.observer.fire('layersSwitcher.show', key);
            };
            nge.rafSetTimeout(rafer, _settings.cfg.autoSwitchDelay);
        }
    };

    /**
     * Show layer by it's name
     * @param {String} nextLayerName next layer name
     */
    var _show = function (nextLayerName) {
        _settings.next.name = nextLayerName.split(' ')[0];

        if (_settings.next.name === _settings.current.name) {
            console.warn('LayersSwitcher: trying to change to the same layer', _settings.current.name);
            return;
        }

        _settings.next.layer = _settings.cfg.layers[_settings.next.name];
        if (!_settings.next.layer) {
            console.error('No layer with key', _settings.next.name);
            return;
        }

        _changeListVisibility(_settings.cfg.allContainers, false);
        _changeListVisibility(_settings.next.layer.static, true);

        _animate(function() {
            nge.observer.fire('layerSwitcher.animationComplete', nextLayerName);
        });

        _settings.current = {name: _settings.next.name, layer: _settings.next.layer};

        if (nge.localData.get('layersSwitcher.debug')) {
            console.log('layerSwircher.show: %c' + nextLayerName, 'color:yellow;background:black');
        }
    };

    function _getCfg() {
        var globalCfg = _self.getInstance('Cfg');

        if (!globalCfg || !globalCfg.scenes) {
            console.error('nge.Com.LayersSwitcher.Controller no state cfg', globalCfg);
            return false;
        }

        var stateName = nge.statesManager.getCurrentName();
        var params = globalCfg.scenes[stateName];

        _settings.cfg = nge.Com.LayersSwitcher.Model(params);
    }

    function _findSelectors() {
        _settings.objects = {};
        for (var i = 0; i < _settings.cfg.allContainers.length; i++) {
            var name = _settings.cfg.allContainers[i];
            _settings.objects[name] = nge.findOne('^' + name);
        }
    }

    function _animate(callback) {
        for (var i in _helper.animationTypes) {
            var animType = _helper.animationTypes[i].name;
            var currentLayerHasAnimation = _settings.current.layer && _settings.current.layer[animType];
            var nextLayerHasAnimation = _settings.next.layer && _settings.next.layer[animType];
            if (currentLayerHasAnimation || nextLayerHasAnimation) {
                _helper.animationTypes[animType](_settings, callback);
            }
        }
    }

    function _changeListVisibility(list, visibility) {
        if (!list)
            return;

        for (var i = 0; i < list.length; i++) {
            if (!_settings.objects[list[i]]) {
                console.error('nge.Com.LayersSwitcher.Controller error: no key', list[i]);
            }

            _settings.objects[list[i]].visible = visibility;
        }
    }

    function _subscribe() {
        nge.observer.add('layersSwitcher.show', _show);
        _subscribed = true;
    }
});



nge.Com.LayersSwitcher.Helper = Class.extend(function () {
    this.singleton = true;

    /* animations that will work after layer changes */
    this.animationTypes = {
        'darkLayer': function (settings, callback) {
            var rootParent = settings.objects[settings.cfg.allContainers[0]].parent;
            var capturingUtil = nge.Com.LayersSwitcher.Capture;
            var current = settings.current;
            var nextLayer = settings.next.layer;
          
            var image;
            if (current.layer && current.layer.darkLayer) {
                image = nge.localData.get('layersSwitcher.animations.darkLayer.image');
                image.parent.remove(image);
                image.destroy();
            }
            if (nextLayer && nextLayer.darkLayer) {
                image = capturingUtil.generateImage(0x000000, rootParent);
                if (callback) callback();
                nge.localData.set('layersSwitcher.animations.darkLayer.image', image);
            }
        },
        'fromDark': function (settings, callback) {
            var rootParent = settings.objects[settings.cfg.allContainers[0]].parent;
            var capturingUtil = nge.Com.LayersSwitcher.Capture;
            var nextLayer = settings.next.layer;
            
            if (nextLayer && nextLayer.fromDark) {
                var generatedImage = capturingUtil.generateImage(0x000000, rootParent);
                capturingUtil.animate(generatedImage, 1000, {alpha: 0}, function () {
                    if (callback) callback();
                }, true, false);
            }
        },
        'capture': function (settings, callback) {
            var rootParent = settings.objects[settings.cfg.allContainers[0]].parent;
            var capturingUtil = nge.Com.LayersSwitcher.Capture;
            var current = settings.current;
            var nextLayer = settings.next.layer;
            /**
             * Start capturing animation. Takes scene shot according to 'exclude' and 'overlay' params
             * @param {Object} capture capturing params from layersSwitcher/cfg.js
             */
            var captureIn = function (capture) {
                var captureImage;
                /*  save hierarchy  */
                
                // save root parent hierarchy
                rootParent.children.forEach(function (child) {
                    child.primalZ = child.z;
                });

                _changeListVisibility(settings.cfg.allContainers, settings, false);
                _changeListVisibility(settings.current.layer.static, settings, true);

                /*  capture image  */
                var captureTexture = capturingUtil.getTexture(capture.exclude);
                captureImage = capturingUtil.getImage(captureTexture, rootParent);

                _changeListVisibility(settings.cfg.allContainers, settings, false);
                _changeListVisibility(settings.next.layer.static, settings, true);

                /*  bubble up overlay container to the top of parent hierarchy  */
                if (capture.overlay) {
                    capture.overlay.forEach(function (elName) {
                        var element = _getElementByName(elName, settings);
                        if (!element)
                            return;

                        element.primalZ = element.z;
                        element.primalParent = element.parent;

                        // change parent if element nested
                        if (rootParent !== element.parent) {
                            element.parent.remove(element);
                            rootParent.add(element);
                        }

                        rootParent.bringToTop(element);
                    });
                }

                captureImage.visible = true;
                nge.localData.set('layersSwitcher.animations.capture.captureImage', captureImage);
            };

            /**
             * End capturing animation
             * @param {Object} capture capturing params from layersSwitcher/cfg.js
             */
            var captureOut = function (capture) {
                var captureImage = nge.localData.get('layersSwitcher.animations.capture.captureImage');
                
                if (captureImage) {
                    capturingUtil.animate(captureImage, 500, {alpha: 0}, function () {
                        if (capture.overlay) {
                            // restore parents
                            capture.overlay.forEach(function (elName) {
                                var element = _getElementByName(elName, settings);
                                if (element.primalParent !== rootParent) {
                                    rootParent.remove(element);
                                    element.primalParent.add(element);
                                }
                            });

                            // restore z-indices
                            capture.overlay.forEach(function (elName) {
                                var element = _getElementByName(elName, settings);
                                element.z = element.primalZ;
                            });

                            // sort primal parents children order
                            rootParent.sort();
                            capture.overlay.forEach(function (elName) {
                                var element = _getElementByName(elName, settings);
                                element.parent.sort();
                            });
                        }
                        
                        if (callback)
                            callback();
                    }, true, false);
                } else {
                    console.error('Invalid captureImage', captureImage);
                }
            };

            if (current.layer && current.layer.capture) {
                captureOut(current.layer.capture);
            }

            if (nextLayer && nextLayer.capture) {
                captureIn(nextLayer.capture);
            }
        },
        'bounce': function (settings, callback) {
            /**
             * Bouncing animation for container
             * @param {Object} el container
             * @param {Number} direction direction of bounce animation (-1 or 1)
             * @param {String} elementName container name
             * @param {Function} callback called on the end of bouncing animaiton
             */
            var animation = function (el, direction, elementName, callback) {
                el.visible = true;
                // var tween;

                var tweens = nge.localData.get('layersSwitcher.animations.bounce.tweens');
                if (tweens && tweens[elementName]) {
                    tweens[elementName].stop(true);
                }

                var bgIndex = 0;
                var tween;
                var oldbg;
                var time = direction > 0 ? 750 : 500;
                var tint = 0.7;
                var scaleBase = 0.5 * (1 - direction);
                var scaleF = 0.5 * (1 + direction);

                for (var i = 0; i < el.children.length; i++) {
                    if (!el.getChildAt(i).hasClass('cover'))
                        continue;

                    bgIndex = i;
                    oldbg = el.getChildAt(i);
                    oldbg.alpha = direction > 0 ? 0 : tint;
                    el.parent.addChildAt(oldbg, el.parent.getChildIndex(el));
                    nge.tween.add(oldbg).
                        to(
                            {alpha: direction > 0 ? tint : 0},
                            time,
                            direction > 0 ? nge.Lib.Tween.Easing.Cubic.Out : nge.Lib.Tween.Easing.Cubic.In,
                            true
                        );
                }

                if(!el.original)
                    el.original = { x: el.centerX, y: el.centerY };

                el.scale.x = el.scale.y = scaleBase;

                var tweenCallback = function () {
                    el.scale.x = el.scale.y = 1; //direction > 0 ? 1 : 0;
                    el.centerX = el.original.x;
                    el.centerY = el.original.y;
                    if (oldbg)
                        el.addChildAt(oldbg, bgIndex);
                    tween = null;

                    delete tweens[elementName];
                    nge.localData.set('layersSwitcher.animations.bounce.tweens', tweens);

                    if (callback)
                        return callback();
                };

                tween = nge.tween.add(el.scale);
                tween.to(
                    {x: scaleF, y: scaleF},
                    time,
                    direction > 0 ? nge.Lib.Tween.Easing.Elastic.Out : nge.Lib.Tween.Easing.Back.In,
                    false
                );
                tween.onUpdateCallback(function () {
                    el.centerX = el.original.x;
                    el.centerY = el.original.y;

                }, this);
                tween.onComplete.add(tweenCallback, this);
                tween.start();

                if (!tweens)
                    tweens = {};
                tweens[elementName] = tween;
                nge.localData.set('layersSwitcher.animations.bounce.tweens', tweens);
            };

            var previousLayer = settings.current.layer;
            var nextLayer = settings.next.layer;

            /*  TODO (reiven): need to find solution for problem when we 
             bounce element in one layer, then don't debounce it in another and 
             then we need to decounce it in third state  */

            /*  run debounce for previous layer  */
            if (previousLayer && previousLayer.bounce) {
                previousLayer.bounce.forEach(function (elementName) {
                    if (!nextLayer.static.includes(elementName)) {
                        var el = _getElementByName(elementName, settings);
                        if (!el)
                            return;

                        animation(el, -1, elementName, function () {
                            el.visible = false;
                            if (callback)
                                callback();
                        });
                    }
                });
            }

            /*  run bounce for new layer  */
            if (nextLayer && nextLayer.bounce) {
                nextLayer.bounce.forEach(function (elementName) {
                    var el = _getElementByName(elementName, settings);
                    if (!el)
                        return;
                    animation(el, 1, elementName, callback);
                });
            }
        },
        'fakeLoaderOn': function(settings, callback) {
            var nextLayer = settings.next.layer;
            if (nextLayer && nextLayer.fakeLoaderOn) {
                var duration = nextLayer.fakeLoaderOn.showDuration || 500;
                _changeListVisibility(settings.cfg.allContainers, settings, false);
                _changeListVisibility(settings.current.layer.static, settings, true);

                var loadingBarContainer = nge.findOne('^loadingBarContainer');
                if (!loadingBarContainer)
                    loadingBarContainer = nge.objects.create('loadingBarContainer');
                loadingBarContainer.alpha = 0;

                var fill = nge.find('^loadingBarFill');
                fill.visible = true;

                var tween = nge.tween.add(loadingBarContainer).to({ alpha: 1 }, duration, null, true);
                tween.onComplete.addOnce(function() {
                    _changeListVisibility(settings.cfg.allContainers, settings, false);
                    loadingBarContainer.alpha = 1;
                    if (callback) callback();
                }, this);
            }
        },
        'fakeLoaderOff': function (settings, callback) {
            var nextLayer = settings.next.layer;
            if (nextLayer && nextLayer.fakeLoaderOff) {
                var delay = nextLayer.fakeLoaderOff.hideDelay || 0;
                var duration = nextLayer.fakeLoaderOff.hideDuration || 500;
                var loadingBarContainer = nge.findOne('^loadingBarContainer');
                if (!loadingBarContainer)
                    loadingBarContainer = nge.objects.create('loadingBarContainer');
                loadingBarContainer.alpha = 1;

                var fill = nge.find('^loadingBarFill');
                if (fill) {
                    fill.visible = true;
                //     var mask = nge.objects.create(new nge.Mlm.Objects.Mask({rects: [[0, 0, fill.width, fill.height]]}));
                //     fill.addChild(mask);
                //     fill.mask = mask;
                }

                /* 
                    @Note (reiven): i use delay here with rafSetTimeout here, because 
                    tweens sometimes don't work on state start with their's own delay
                */
                nge.rafSetTimeout(function() {
                    var tween = nge.tween.add(loadingBarContainer).to({ alpha: 0 }, duration, null, true);
                    tween.onComplete.addOnce(function() {
                        loadingBarContainer.alpha = 0;
                        loadingBarContainer.destroy();
                        if (callback) callback();
                    }, this);
                }, delay);
            }
        }
    };

    /**
     * Gets searched element by name from _objects or through nge.findOne
     * @param {string} name container/group/etc. name
     * @param {object} settings settings
     * @returns {Object} returns searched element or undefined
     */
    function _getElementByName(name, settings) {
        var element = settings.objects[name] || nge.findOne('^' + name);

        if (!element)
            console.error('Cant\'t find element ', name);

        return element;
    }

    function _changeListVisibility(list, settings, visibility) {
        if (!list)
            return;

        for (var i = 0; i < list.length; i++) {
            if (!settings.objects[list[i]])
                console.error('nge.Com.LayersSwitcher.Controller error: no key', list[i]);
            settings.objects[list[i]].visible = visibility;
        }
    }
});



nge.Com.LayersSwitcher.Capture = {
    /**
     * Capture current screen into texture
     * @param {array} exclude - container's names to exclude from shot
     * @returns {object} texture
     */
    getTexture: function(exclude) {
        nge.observer.fire('capture.started');
        var i, excludeObj;
        if (exclude) {
            for (i = 0; i < exclude.length; i++) {
                excludeObj = nge.findOne('^' + exclude[i]);
                if (excludeObj)
                    excludeObj.visible = false;
                else
                    console.error('Can\'t exclude object with name "' + exclude[i] + '". Maybe it doesn\'t exist');
            }
        }

        nge.game.paused = true;

        var texture = new Phaser.RenderTexture(
            nge.game,
            nge.game.width,
            nge.game.height,
            'cover',
            Phaser.scaleModes.SHOW_ALL,
            nge.game.renderer.resolution);
        var tempGraphic = nge.objects.create(new nge.Mlm.Objects.Graphics({}));
        tempGraphic.beginFill(nge.game.stage.backgroundColor);
        tempGraphic.lineStyle(1, nge.game.stage.backgroundColor, 1);
        tempGraphic.drawRect(0, 0, nge.game.width, nge.game.height);
        tempGraphic.endFill();
        texture.renderXY(tempGraphic, 0, 0);
        tempGraphic.clear();
        texture.renderXY(nge.game.world, -nge.game.camera.x, -nge.game.camera.y);
        
        nge.game.paused = false;
        
        if (exclude) {
            for (i = 0; i < exclude.length; i++) {
                excludeObj = nge.findOne('^' + exclude[i]);
                if (excludeObj) {
                    excludeObj.visible = true;
                }
            }
        }

        nge.observer.fire('capture.ended');
        return texture;
    },

    /**
     * Generate image with color
     * @param {number} color color of image HEX,
     * @param {object} parent parent group
     * @returns {object} image (visible: true)
     */
    generateImage: function(color, parent) {
        var graphics = nge.objects.create(new nge.Mlm.Objects.Graphics({}));
        graphics.beginFill(color);
        graphics.drawRect(0, 0, 1, 1); 
        graphics.endFill();

        var image = nge.objects.create(new nge.Mlm.Objects.Image({ assetKey: '1px_empty' }));
        image.loadTexture(graphics.generateTexture());

        image.width = nge.game.width / nge.game.world.scale.x;
        image.height = nge.game.height / nge.game.world.scale.y;
        image.visible = true;
        parent = parent || nge.game.world;
        parent.add(image);
        parent.bringToTop(image);
        return image;
    },

    /**
     * Create image from texture and add to parent
     * @param {object} texture source texture
     * @param {object} parent parent group
     * @returns {object} image (visible: false)
     */
    getImage: function(texture, parent) {
        var image = nge.objects.create(new nge.Mlm.Objects.Image({ assetKey: '1px_empty' }));
        image.loadTexture(texture);
        image.width = nge.game.width / nge.game.world.scale.x;
        image.height = nge.game.height / nge.game.world.scale.y;
        image.visible = false;
        parent = parent || nge.game.world;
        parent.add(image);
        parent.bringToTop(image);
        return image;
    },

    /**
     * @param {object} image image object
     * @param {number} duration tween duration in ms (default: 0)
     * @param {object} data data for animation (default: {})
     * @param {function} callback callback function
     * @param {boolean} autoStart autoStart
     * @param {number} ease nge.Lib.Tween.Easing mode (default: nge.Lib.Tween.Easing.Linear.None)
     * @param {number} delay delay
     * @param {boolean} repeat repeat
     * @param {boolean} yoyo yoyo effect
     * @returns {object} tween
     */
    animate: function(image, duration, data, callback, autoStart, ease, delay, repeat, yoyo) {
        var tween = nge.tween.add(image)
            .to(data || {},
                duration || 0,
                ease || nge.Lib.Tween.Easing.Linear.None,
                autoStart,
                delay,
                repeat,
                yoyo);

        tween.onComplete.addOnce(function() {
            image.parent.remove(image);
            image.destroy();
            if (callback) return callback();
        }, this);

        return tween;
    },

    __test: function() {
        var texture = this.getTexture();
        var image = this.getImage(texture, nge.game.world);
        image.visible = true;
        this.animate(
            image,
            2000,
            { alpha: 0 },
            function() {},
            true,
            false,
            0);
    }
};



nge.Com.LayersSwitcher.Model = function (param) {
    if (!param)
        param = {};

    return {
        'baseScreen': (param.hasOwnProperty('baseScreen')) ? param.baseScreen : 'game',
        'defaultLayer': (param.hasOwnProperty('defaultLayer')) ? param.defaultLayer : 'game',
        'autoSwitch': (param.hasOwnProperty('autoSwitch')) ? param.autoSwitch : false,
        'autoSwitchDelay': (param.hasOwnProperty('autoSwitchDelay')) ? param.autoSwitchDelay : 2000,
        'allContainers': (param.hasOwnProperty('allContainers')) ? param.allContainers : [],
        'layers': (param.hasOwnProperty('layers')) ? param.layers : []
    };
};



nge.Com.Lines = {};



nge.Com.Lines.Controller = nge.Com.Base.extend(function () {
    var _created,
        _maxLines;
    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        this.createDefault();
        var lc = nge.localData.get('lines.cfg');
        _maxLines = 1;

        if (lc)
            _maxLines = lc[lc.length - 1];

        nge.localData.set('maxLinesValue', _maxLines);
        _setDefault();
        if (!_created)
            _subscribe();
        _created = true;
        return true;
    };

    var _setDefault = function () {
        var val = nge.localData.get('lines.value');
        if (!val) {
            val = 1;
            var linesCFG = nge.localData.get('lines.cfg');
            if (linesCFG)
                val = linesCFG[linesCFG.length - 1];
        }

        _setVal(val, true);
        return true;
    };

    var _minusNC = function () {
        _minus(true);
    };

    var _plusNC = function () {
        _plus(true);
    };

    var _minus = function (nonCycle) {
        var val = nge.localData.get('lines.value');
        var linesCFG = nge.localData.get('lines.cfg');
        if (!val)
            return false;

        var i = linesCFG.indexOf(val);
        i--;

        if (!linesCFG[i])
            i = (nonCycle) ? 0 : (linesCFG.length - 1);

        val = linesCFG[i];
        nge.observer.fire('lines.set', val);
        return true;
    };

    var _plus = function (nonCycle) {
        var val = nge.localData.get('lines.value');
        var linesCFG = nge.localData.get('lines.cfg');
        if (!val)
            return false;

        var i = linesCFG.indexOf(val);
        i++;

        if (!linesCFG[i])
            i = (nonCycle) ? (linesCFG.length - 1) : 0;

        val = linesCFG[i];
        nge.observer.fire('lines.set', val);
        return true;
    };

    var _setVal = function (v, isDefaultValue) {
        nge.observer.fire('winlines.hideAll');

        if (!isDefaultValue) {
            nge.observer.fire('lines.change', v);
            nge.localData.set('winlines.updated', true);
        }

        var textArr = nge.findAll('.linesNumber');
        for (var k in textArr)
            textArr[k].text = v;

        nge.localData.set('lines.value', v);
    };

    var _setMax = function () {
        _setVal(_maxLines);
    };

    var _subscribe = function () {
        nge.observer.add('brain.openGameSuccess', _setDefault);
        nge.observer.add('lines.down', _minus);
        nge.observer.add('lines.up', _plus);
        nge.observer.add('lines.downNC', _minusNC);
        nge.observer.add('lines.upNC', _plusNC);
        nge.observer.add('lines.set', _setVal);
        nge.observer.add('lines.update', _setDefault);
        //nge.observer.add('maxbet.go', _setMax);
    };
});



nge.Com.Load = {};



nge.Com.Load.Controller = nge.Com.Base.extend(function () {
    var _cfg;

    this.preload = function () {
        this.preloadDefault();
        _cfg = this.getInstance('Cfg');

        _auth();

        nge.userInfoHTML('Preloading fonts and sounds');
        if (nge.localData.get('settings.imageQuality') !== '_src')
            _preloadUber();
        _preloadFonts();
        _preloadCustomJs();
    };

    this.create = function () {
        this.createDefault();

        nge.rafSetTimeout(function () {
            nge.statesManager.display('loadAssets');
        }, 1);
    };

    var _auth = function () {
        nge.userInfoHTML('Attempting to Auth');
        nge.observer.fire('brain.authRequest');
    };

    var _preloadUber = function () {
        var antiCacheSuffix = nge.assets.getAntiCacheSuffix();
        var imagesPath = nge.assets.getImagesPath();
        nge.wrap.load.json('uber_json', imagesPath + 'uber.json' + antiCacheSuffix);
    };

    var _preloadFonts = function () {
        var antiCacheSuffix = nge.assets.getAntiCacheSuffix();
        var _fonts = _cfg.fonts || {};

        for (var fontName in _fonts) {
            nge.wrap.load.font(fontName, nge.realPathPrefix + _fonts[fontName] + '.otf' + antiCacheSuffix);
        }
    };

    var _preloadCustomJs = function () {
        var customJsUrl = nge.Lib.Helper.parseGetParams('customJs');

        if (customJsUrl)
            nge.Lib.Helper.loadJsCssFile(customJsUrl, 'js');
    };
});



