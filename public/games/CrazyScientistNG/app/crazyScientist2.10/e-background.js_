nge.App[nge.appNS].Mlm.Brain.Mobile.ButtonsNewLogic.States.SettingsState = nge.App.ClassicGameBase.Mlm.Brain.ButtonsNewLogic.States.SettingsState.extend(function () {

    var _balanceRecieved = true;
    var _paytableShowed = false;
    var _quickSettingsPanelMobileButton = null;
    var _self = this;
    
    this.init = function(buttons){
        this.super.init(buttons);
        _quickSettingsPanelMobileButton = nge.findOne('^quickSettingsPanelMobileButtonButton');
    };
    
    this.model = {
        order: ['SHARED'],
        actions: {
            SHARED:{
                soundMobile: {
                    callback: function () {
                        nge.observer.fire('settings.soundSwitch');
                    }
                },
                infoMobile: {
                    enabled: ['enableCheck'],
                    callback: function(){
                        var event = 'paytable.';
                        event += _paytableShowed ? 'hide' : 'show';
                        nge.observer.fire(event);
                    }
                },
                betMinusPanelMobile: {
                    enabled: ['enableCheck', '!paytableShowed', '!offerInProgress'],
                    callback: function(){
                        nge.observer.fire('bet.down');
                    }
                },
                betPlusPanelMobile: {
                    enabled: ['enableCheck', '!paytableShowed', '!offerInProgress'],
                    callback: function(){
                        nge.observer.fire('bet.up');
                    }
                },

                coinMinusMobile: {
                    enabled: ['enableCheck', '!paytableShowed', '!offerInProgress'],
                    callback: function () {
                        nge.observer.fire('coins.down');
                    }
                },
                coinPlusMobile: {
                    enabled: ['enableCheck', '!paytableShowed', '!offerInProgress'],
                    callback: function () {
                        nge.observer.fire('coins.up');
                    }
                },
                quickSettingsPanel:{
                    callback: function () {
                    if(_paytableShowed)
                        nge.observer.fire('paytable.hide');
                    else
                        nge.observer.fire('quickSettings.panelSwitch');
                    }
                },
            }
        }
    };

    this.subscribeCfgExt = {
        'paytable.show': 'paytableShowHandler',
        'paytable.hide': 'paytableHideHandler'
    };

    this.propUpdateHandlers = {
        enableCheck: function(){
            var isReadyState = nge.localData.get('slotMachine.state');
            var lastResponse = nge.localData.get('slotMachine.lastResponse');
            return _balanceRecieved && (isReadyState === 'Ready' || !isReadyState) && !lastResponse;
        },
        paytableShowed: function(){
            return _paytableShowed;
        },
        offerInProgress: function(){
            return nge.localData.get('freeGame.inProgress');
        }
    };

    this.slotMachineSpinCommandHandler = function(){
        _balanceRecieved = false;
    };

    this.balanceResponseHandler = function(){
        _balanceRecieved = true;
    };

    this.paytableShowHandler = function(){
        _paytableShowed = true;
        nge.observer.fire('quickSettings.panelSwitch');

        nge.rafSetTimeout(function(){
            _quickSettingsPanelMobileButton.setFrames(8,7,6);
        }, 5);
    };

    this.paytableHideHandler = function(){
        _paytableShowed = false;

        nge.rafSetTimeout(function(){
            _quickSettingsPanelMobileButton.setFrames(2,1,0);
        }, 5);
    }; 
});



