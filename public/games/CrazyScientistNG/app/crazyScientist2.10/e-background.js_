nge.App[nge.appNS].Com.JackpotStatusPanel = {};



nge.App[nge.appNS].Com.JackpotStatusPanel.Controller = nge.Com.Base.extend(function () {
    
    var _created;
    var _service;
    var _responce = null;

    /**
     * create
     * @returns {Boolean} - creation result
     */
    this.create = function () {
       
        this.createDefault();

        if(!_created)
            this.subscribe();

        this.initLayers();

        _created = true;
        return true;
    };

    this.update = function(deltaTime){
        if(_created && _responce)
            _service.update(deltaTime.deltaT);
    };

    var _onPaytableShow = function(){
        if(_responce)
            _service.hidePanel();
    };
    var _onPaytableHide = function(){
        if(_responce)
            _service.showPanel();
    };

    var _onJackpotStart = function () {
        if(_responce)
            _service.hidePanel();
    };

    var _jackpotResponseHandler = function(response){
        _responce = response;
        nge.observer.fire('jackpotStatusPanel.showed');
        _service.handleResponse(response);
    };

    this.subscribe = function(){
        nge.observer.add('slotMachine.jackpotResponse', _jackpotResponseHandler);
        nge.observer.add('paytable.show', _onPaytableShow);
        nge.observer.add('paytable.hide', _onPaytableHide);
        nge.observer.add('jackpot.start', _onJackpotStart);

        this.customSubscribe();
    };

    this.customSubscribe = function(){};

    this.initLayers = function(){
        _service = this.getInstance('Service');
        _service.init();
    };
});



nge.App[nge.appNS].Com.JackpotStatusPanel.Service = nge.Com.Base.extend(function () {
    var _view;
    var _timer;

    this.init = function(){
        _view = this.getInstance('View');
        _timer = 0;
        _view.init();
    };

    this.update = function(deltaTime){
        _timer += deltaTime;
        
        if(_timer >= 1000){
            var frame = Math.floor(_timer/1000);
            _view.decrementTimer(frame);
            _timer = 0;
        }
    };

    this.handleResponse = function(response){
        this.switchJackpotStatusPanelVisibility(response);
        this.updateJackpotWinAmounts(response);
        this.updateTimer(response);
    };

    this.switchJackpotStatusPanelVisibility = function(response){
        _view.switchJackpotStatusPanelVisibility(response.result);
    };

    this.showPanel = function(){
        _view.showPanel();
    };

    this.hidePanel = function(){
        _view.hidePanel();
    };
    
    this.updateJackpotWinAmounts = function(response){
        _view.updateJackpotInfo(response.data.jackpots);
    };

    this.updateTimer = function(response){
        var msTimer = parseInt(response.data.timer || 0, 10);
        
        if(!msTimer) 
            return;

        msTimer += 999;
        if(msTimer >= 30999)
            msTimer = 30000;
        var sTimer = Math.floor(msTimer/1000);
        _view.updateTimer(sTimer);
    };
});



