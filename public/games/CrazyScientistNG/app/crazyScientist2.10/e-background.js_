nge.Com.SettingsButton = {};



nge.Com.SettingsButton.Animator = Class.extend(function () {

    this.firstCreation = function (callback) {
        _firstCreation(callback);
        return true;
    };

    var _firstCreation = function (callback) {
        var container = nge.find('^btn_settings');

        var y = container.y + 300;

        var reelTween = nge.tween.add(container);
        reelTween.from({
            y: y
        }, 600, nge.Lib.Tween.Easing.Back.Out, false, 600).onComplete.add(function () {
            if (callback)
                callback();
        });
        reelTween.start();
    };
});



