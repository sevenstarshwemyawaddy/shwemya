    var _imagePath = nge.appPath + 'img/';
    const _ldgz = nge.Lib.Helper.LdgZero;

    var _assetsContents = [

        { type: mt.assets.IMAGE, key: 'big_win_conter_frame_central', fullPath: _imagePath + 'bigWin/counter.png' },//
