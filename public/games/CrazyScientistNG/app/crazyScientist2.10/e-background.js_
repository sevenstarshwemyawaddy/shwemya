nge.App[nge.appNS].Com.Gamble.View = Class.extend(function () {
    this.selector = '#';

    var _self = this;

    var _slotMachineParts;
    var _gambleScreen;

    var _gambleActionButtons = {
        'gambleActionRed': null,
        'gambleActionBlack': null,
        'gambleAction2Red': null,
        'gambleAction2Black': null
    };

    var _gambleVars = {
        'gambleCardBig': null,
        'gamble-hc-0': null,
        'gamble-hc-1': null,
        'gamble-hc-2': null,
        'gamble-hc-3': null,
        'gamble-hc-4': null,
        'gambleAmount': null,
        'gambleToWin': null,
        'gambleAmountCredits': null,
        'gambleToWinCredits': null
    };

    this.slotMachineParts = [
        '^slotMachineContainer'
    ];

    this.bigTextureFramesCount = 2;
    var _bigTextureFrame = 0;

    this.initVars = function (obj) {
        var objNames = Object.getOwnPropertyNames(obj);

        objNames.forEach(function(objName){
            obj[objName] = nge.findOne(_self.selector.concat(objName));
        });
    };

    var _initGambleButtons = function () {
        _self.initVars(_gambleActionButtons);
    };

    var _initGambleVars = function () {
        _self.initVars(_gambleVars);
    };

    this.init = function () {
        _slotMachineParts = this.slotMachineParts.map(function (value) {
            return nge.findOne(value);
        });

        _gambleScreen = nge.findOne('^gambleScreen');
        _gambleScreen.visible = false;
        _initGambleButtons();
        _initGambleVars();
    };

    var _updateBigTextureFrame = function () {
        _bigTextureFrame = _bigTextureFrame === _self.bigTextureFramesCount - 1
            ? 0
            : _bigTextureFrame + 1;
    };

    this.updateGambleBigTexture = function () {
        _gambleVars.gambleCardBig.loadTexture('gambleCardBig' + _bigTextureFrame);
        _updateBigTextureFrame();
    };

    this.showGambleResult = function (resultColor, callback) {
        _gambleVars.gambleCardBig.loadTexture('gambleCardBig' + resultColor);
        callback();
    };

    this.showGambleButtons = function () {
        return false;
    };

    this.gambleTakeHandler = function () {
        var gambleBtnCons = nge.findAll('.gambleBtnCon');

        for (var k = 0; k < gambleBtnCons.length; k++) 
            gambleBtnCons[k].visible = false;

        this.showSlotMachine();
    };

    this.hideGambleButtons = function () {
        this.showSlotMachine();
    };

    this.redrawHistory = function (history) {
        for (var k = 0; k < history.length; k++) {
            if (k > 4)
                break;

            var card = history[k];
            var texture = nge.Lib.Helper.strReplace('Big', 'Small', card);
            var hc = _gambleVars['gamble-hc-'.concat(k)];
            hc.loadTexture(texture);
        }
    };

    this.winRedraw = function (win) {
        if (win === 0)
            return;


        var currency = nge.localData.get('balance.currency');

        if(_gambleVars.gambleAmount)
            _gambleVars.gambleAmount.text = (+win).toFixed(2) + ' ' + currency;
        if(_gambleVars.gambleToWin)
            _gambleVars.gambleToWin.text = ((+win) * 2).toFixed(2) + ' ' + currency; 
        if(_gambleVars.gambleAmountCredits)
            _gambleVars.gambleAmountCredits.text = nge.Lib.Money.toCoinsInt(win);
        if(_gambleVars.gambleToWinCredits)
            _gambleVars.gambleToWinCredits.text = nge.Lib.Money.toCoinsInt(2 * win);
    };

    var _setRedFrame = function(gambleActionRedTexture, isTabletOrMobile){
        var gambleActionRed = _gambleActionButtons.gambleActionRed;
        
        if (!gambleActionRed.input.pointerOver() || isTabletOrMobile)
            gambleActionRed.loadTexture(gambleActionRedTexture);
        else
            gambleActionRed.loadTexture('gambleRed2');
    };

    var _setBlackFrame = function(gambleActionBlackTexture, isTabletOrMobile){
        var gambleActionBlack = _gambleActionButtons.gambleActionBlack;
        
        if (!gambleActionBlack.input.pointerOver() || isTabletOrMobile)
            gambleActionBlack.loadTexture(gambleActionBlackTexture);
        else
            gambleActionBlack.loadTexture('gambleBlack2');
    };

    this.updateGambleButtons = function (lastColorIsRed) {
        var gambleActionRedTexture = (lastColorIsRed) ? 'gambleRed2' : 'gambleRed1';
        var gambleActionBlackTexture = (lastColorIsRed) ? 'gambleBlack1' : 'gambleBlack2';
        var isTabletOrMobile = nge.Lib.Helper.mobileAndTabletCheck();

        _setRedFrame(gambleActionRedTexture, isTabletOrMobile);
        _setBlackFrame(gambleActionBlackTexture, isTabletOrMobile);
      
        nge.observer.fire('buttons.switchFrame.red', (lastColorIsRed) ? 1 : 2);
        nge.observer.fire('buttons.switchFrame.black', (lastColorIsRed) ? 2 : 1);
    };

    this.resetButtons = function () {
        _gambleActionButtons.gambleActionRed.loadTexture('gambleRed1');
        _gambleActionButtons.gambleActionBlack.loadTexture('gambleBlack1');
        nge.observer.fire('buttons.switchFrame.red', 1);
        nge.observer.fire('buttons.switchFrame.black', 1);
    };

    this.toggleSlotMachine = function (visible) {
        _slotMachineParts.forEach(function (part) {
            if(part)
                part.visible = visible;
        });
    };

    this.showSlotMachine = function () {
        this.toggleSlotMachine(true);

        _gambleScreen.visible = false;
    };

    this.showGambleScreen = function () {
        this.toggleSlotMachine(false);

        _gambleScreen.visible = true;
    };
});



nge.App[nge.appNS].Com.Gamble.UI_v3 = {};



nge.App[nge.appNS].Com.Gamble.UI_v3.Tpl = function (imagePath) {
    if(!imagePath)
        imagePath = nge.appPath + 'img/gamble/';

    var _tpl = nge.App[nge.appNS].Com.Gamble.Tpl(imagePath);
    var gambleScreen = _tpl.objects.contents.filter(function (obj) { return obj.name === 'gambleScreen'; })[0];

    var addCreditsItem = function (id) {
        var item = gambleScreen.contents.filter(function (obj) { return obj.id === id; })[0];
        var newItem = nge.Lib.Helper.jsObjClone(item);
        newItem.id = newItem.id + 'Credits';
        gambleScreen.contents.splice(gambleScreen.contents.indexOf(item), 0, newItem);
    };

    addCreditsItem('gambleAmount');
    addCreditsItem('gambleToWin');

    return _tpl;
};



nge.App[nge.appNS].Com.Jackpot = {};



nge.App[nge.appNS].Com.Jackpot.AnimationManager = nge.Com.Base.extend(function () {

    var _cfg;
    var _self = this;
    var _animations = {};

    this.configureManager = function(cfg){
        _cfg = cfg;
    };

    this.startAnimation = function(animationName){
    
        if(!_animations[animationName]){
            var tween = this.createAnimationTween(animationName);
            _animations[animationName] = {};
            _animations[animationName].tween = tween;
        }
          
        _animations[animationName].tween.start();
    };

    this.getAnimation = function(animationName){
        return _animations[animationName];
    };

    this.createAnimationTween = function(spriteSheetName, container, position, to){
        
        for(var animationName in _cfg.animations){
                    
            if(spriteSheetName === animationName){
                
                var animCfg = nge.Lib.Helper.jsObjClone(_cfg.animations[animationName]);
                
                if(!animCfg.to)
                    animCfg.to = {};

                if(to)
                    for(var k in to){
                        animCfg.to[k] = to[k];
                    }
                    
                return _createTween(spriteSheetName, container, position, animCfg);
            }              
        }   
    };

    var _createTween = function(spriteSheetName, container, position, animationCfg){
        var duration;
        var repeat;
        var frames = [];
        var textureBehavior;
        var delay;
        var yoyo;
        var reverse;
        var to = {};
        var animationTexture;
        var spriteOldParams = {};
        var easing;

        frames = animationCfg.frames || [];
        duration = animationCfg.duration || 0;
        repeat = animationCfg.repeat || 0;
        textureBehavior = animationCfg.textureBehavior;
        delay = animationCfg.delay || 0;
        yoyo = animationCfg.yoyo || false;
        to = animationCfg.to || {};
        reverse = animationCfg.reverse || false;
        easing = animationCfg.easing || null;

        animationTexture = nge.findOne('^' + spriteSheetName);

        if(!animationTexture){
            
            if(!position)
                position = {x: 0, y: 0};
            
            animationTexture = nge.objects.create(nge.Mlm.Objects.Image({
                assetKey: spriteSheetName + '0',
                isVisible: false, 
                x: position.x,
                y: position.y,
                anchorX: 0.5,
                anchorY: 0.5
            }), container);
        }

        for(var k in to){
            spriteOldParams[k] = animationTexture[k];
        }
        animationTexture.scale.set(1 / nge.assets.getQualityFactor());  
     
        var tween = nge.tween.add(animationTexture);
        tween.to(to, duration, easing, false, delay, repeat, yoyo);

        if(reverse){
            
            var old = {};

            for(var key in to){
                old[key] = tween.target[key];
            }

            tween.to(old, duration, null, false, delay);
        }


        if(textureBehavior && textureBehavior.onStart)
            tween.onStart.add(function(){
                for(var key in textureBehavior.onStart){
                    nge.Lib.Helper.recursiveSet(key, textureBehavior.onStart[key], tween.target);
                }
            });

        if(textureBehavior && textureBehavior.onComplete)
            tween.onComplete.add(function(){
                for(var key in textureBehavior.onComplete){
                    nge.Lib.Helper.recursiveSet(key, textureBehavior.onComplete[key], tween.target);
                }
            });

        var spritesCount = frames.length;
        var totalFrameCount = 0;
        
        frames.forEach(function(frameCount){
            totalFrameCount += frameCount;
        });
        
        tween.onUpdateCallback(function (t, v) {
            var spriteIndex = 0;
            var tempFrameIndex = Math.floor(totalFrameCount * v);
            
            if(spritesCount > 1 && tempFrameIndex > frames[spriteIndex]){
                var modificator = 1;
                tempFrameIndex -= frames[spriteIndex];
                tempFrameIndex -= modificator;
                spriteIndex++;
            }

            var spiteSheetName = spriteSheetName + spriteIndex;
            t.target.loadTextureFromSpritesheet(spiteSheetName, tempFrameIndex);
        });

        return tween;
    };

    this.createScaleTween = function(_sprite, _scaleMulti, _duration, _repeat){

        var oldScaleX = _sprite.scaleX;
        var oldScaleY = _sprite.scaleY;
        var halfDuration = _duration / 2;
        var newScaleX = oldScaleX * _scaleMulti;
        var newScaleY = oldScaleY * _scaleMulti;
        
        var tweenScale = nge.tween.add(_sprite).
            to({scaleX: newScaleX, scaleY: newScaleY}, halfDuration).
            to({scaleX: oldScaleX, scaleY: oldScaleY}, halfDuration);

        tweenScale.onStart.add(function(){
            _sprite.isRunning = true;
        });

        tweenScale.onComplete.add(function(){
            _sprite.scale.set(oldScaleX, oldScaleY);
            _sprite.isRunning = false;
        
            if(--_repeat >= 0)
                tweenScale.start();             
        });

        return tweenScale;
    };

    this.createAnimationFlowTween = function(mainAnimationName, onStartAnimations, onCompleteAnimations, container, position, to) {

        var animationMain = this.createAnimationTween(mainAnimationName, container, position, to);

        onStartAnimations.forEach(function(anim){
            
            if(typeof anim === 'string')
                animationMain.onStart.add(function(){
                    _self.createAnimationTween(anim, container, position).start();
                });
            else
                animationMain.onStart.add(function(){
                    anim.start();
                });
        });

        onCompleteAnimations.forEach(function(anim){
            
            if(typeof anim === 'string')
                animationMain.onComplete.add(function(){
                    _self.createAnimationTween(anim, container, position).start();
                });
            else
                animationMain.onComplete.add(function(){
                    anim.start();
                });
        });

        return animationMain;

    };
});



nge.App[nge.appNS].Com.Jackpot.Cfg = Class.extend(function () {
