nge.App[nge.appNS].Com.BigWin = {};



nge.App[nge.appNS].Com.BigWin.Cfg = Class.extend(function () {

    this.singleton = true;

    this.params = {
        shadowPopupCover: false,
        firstStepScaleSpeed: 1,
        firstStepScale: 1.1,
        lightsVisible: true,
        backgroundStarScale: 3,
        containerStartScale: 4,
        containerStartFromAlpha: true,
        thresholds: {
            big: 5,
            mega: 10,
            super: 15,
            ultra: 20
        },
        emitters: {
            splash: [
                {
                    config: 'splash',
                    animated: true,
                    framerate: 30,
                    count: 15, 
                    prefix: 'coin_', 
                    variants: 5,
                    blendMode: 0,
                    ldgZero: 3
                },
                {
                    config: 'splash_stars',
                    animated: false,
                    count: 2, 
                    prefix: 'big_win_particle_texture_star_', 
                    blendMode: 0,
                    ldgZero: 2
                }
            ],
            loop: [
                {
                    config: 'coins_loop',
                    animated: true,
                    framerate: 30,
                    count: 15, 
                    prefix: 'coin_', 
                    variants:10,
                    blendMode: 0,
                    ldgZero: 3
                },
                {
                    config: 'stars_loop',
                    animated: false,
                    count: 2, 
                    prefix: 'big_win_particle_texture_star_', 
                    blendMode: 0,
                    ldgZero: 2
                }
            ]
        }
    };

    this.get = function() {
        return this.params;
    };
});



nge.App[nge.appNS].Com.BigWin.Controller = nge.Com.Base.extend(function () {
    var _self = this;
    var _cfg;
    var _running;
    var _subscribed;
    var _container;
    var _scalableContainer;
    var _scalableStarContainer;
    var _bigWinStars;
    var _background;
    var _scalingTween;
    var _counterTween;
    var _bigWins = [];
    var _winValue;
    var _currentAmount;
    var _qualityFactor;
    var _totalBet;
    var _startIndex;
    var _tweens;

    var _emittersSplash;
    var _emittersLoop;
    var _emitterParent;

    var _lightsVisible;
    var _bigWinCounterContainer;

    var _startPopupPickemCover;

    this.bigWinAmount;
    this.bigWinCounterLeft;
    this.bigWinCounterRight;
    this.bigWinCounterCenter;
    
    this.fairyButtonPressEvent = 'slotMachine.quickFinish';
    this.needSpinButtonOverCover = true;

    this.create = function () {
        this.createDefault();

        _qualityFactor = nge.assets.getQualityFactor();
        _cfg = this.getInstance('Cfg').get();
        _running = false;
        _container = nge.findOne('^bigWinGameContainer');
        _bigWinCounterContainer = nge.findOne('^bigWinCounterContainer');
        _lightsVisible = _cfg.lightsVisible;

        _startPopupPickemCover = nge.findOne('^bigWinPopupCover');
        _startPopupPickemCover.loadTexture('bigWinPopupCover');
        _startPopupPickemCover.visible = false;
        _startPopupPickemCover.scale.x = 1920;
        _startPopupPickemCover.scale.y = 1080;
        _startPopupPickemCover.alpha = _cfg.shadowPopupCover ? 1 : 0;
        _startPopupPickemCover.interactive = true;
        _startPopupPickemCover.on('pointerdown', _quickFinishDone);

        _startIndex = 0;
        _bigWins = [];
        _tweens = [];

        var text;
        var lights;
        var i;

        for (i = 0; i < 4; i++) {
            var bigWin = {
                enable: false
            };
            text = nge.findOne('^bigWin' + i);
            text.scale.set(1 / _qualityFactor);
            bigWin.text = text;
            if (_lightsVisible) {
                lights = nge.findOne('^bigWinLights' + i);
                lights.scale.set(1 / _qualityFactor);
                bigWin.lights = lights;
            }

            _bigWins.push(bigWin);
        }

        _bigWinStars = nge.find('^bigWinStar1');

        _self.bigWinCounterLeft = nge.findOne('^bigWinCounterLeft');
        _self.bigWinCounterRight = nge.findOne('^bigWinCounterRight');
        _self.bigWinCounterCenter = nge.findOne('^bigWinCounterCenter');
        _self.bigWinAmount = nge.findOne('^bigWinAmount');
        _background = nge.findOne('^bigWinBackground');
        _background.scale.set(_cfg.backgroundStarScale / _qualityFactor);
        _scalableContainer = nge.findOne('^bigWinScalableContainer');
        _scalableStarContainer = nge.findOne('^bigWinScalableStarsContainer');
        _self.bigWinCounterLeft.frameName = 'big_win_conter_frame_left.png';
        _self.bigWinCounterCenter.frameName = 'big_win_conter_frame_central.png';
        _self.bigWinCounterRight.frameName = 'big_win_conter_frame_right.png';

        _emittersSplash = [];
        _emittersLoop = [];
        _emitterParent = nge.findOne('^bigWinEmitterContainer');

        _self.bigWinCounterLeft.scale.set(1 / _qualityFactor);
        _self.bigWinCounterRight.scale.set(1 / _qualityFactor);
        _self.bigWinCounterCenter.scale.set(1 / _qualityFactor);

        if (!_subscribed)
            this.subscribe();

        _container.visible = false;

        var _bigWinContainer = nge.findOne('^bigWinContainer');
        _bigWinContainer.add(nge.findOne('^bigWinInnerContainer'));
    };

    var _getParticles = function (particleInfo) {
        var particles = [];
        var i;
        var index;
        if (particleInfo.animated) {
            for (var n = 0; n < particleInfo.variants; n++) {
                var texture = [];

                var id = nge.Lib.Helper.getRandomInt(0, particleInfo.count);
                for (i = 0; i < particleInfo.count; i++) {
                    id = id >= particleInfo.count ? 0 : id;
                    index = nge.Lib.Helper.LdgZero(id, particleInfo.ldgZero);
                    texture.push(particleInfo.prefix + index);
                    id++;
                }
                particles.push({
                    framerate: particleInfo.framerate,
                    loop: true,
                    textures: texture
                });
            }
        } else {
            for (i = 0; i < particleInfo.count; i++) {
                index = nge.Lib.Helper.LdgZero(i, particleInfo.ldgZero);
                particles.push(particleInfo.prefix + index);
            }
        }
        return particles;
    };

    var _initializeEmitter = function (parent, x, y, emitterInfo) {
        var emitter = nge.objects.create(new nge.Mlm.Objects.Emitter({
            'type': mt.objects.EMITTER,
            name: emitterInfo.config,
            particles: _getParticles(emitterInfo),
            assetKey: emitterInfo.config,
            animated: emitterInfo.animated
        }));
        parent.add(emitter);
        emitter.x = x;
        emitter.y = y;
        emitter.blendMode = emitterInfo.blendMode;
        emitter.emitter.emit = false;
        return emitter.emitter;
    };

    this.setAmount = function (amount) {
        _self.bigWinAmount.text = amount;
        _self.bigWinAmount.updateTransform();
        _self.changeWinAmountFieldSize();
        nge.observer.fire('bigWin.amount', amount);
    };

    this.changeWinAmountFieldSize = function () {
        _self.bigWinCounterLeft.x = -(_self.bigWinAmount.width / 2 + 10);
        _self.bigWinCounterRight.x = (_self.bigWinAmount.width / 2 + 10);
        _self.bigWinCounterCenter.scale.x = (_self.bigWinAmount.width / 8) / _qualityFactor;
    };

    var _reset = function () {
        _running = false;

        _emittersSplash.forEach(function (item) {
            item.emit = false;
        });
        _emittersSplash = [];
        _emittersLoop.forEach(function (item) {
            item.emit = false;
        });
        _emittersLoop = [];

        if (_scalingTween)
            _scalingTween.stop();
        if (_counterTween)
            _counterTween.stop();
        for (var i = 0; i < _tweens.length; i++) {
            if (_tweens[i])
                _tweens[i].stop();
        }

        _container.visible = false;

        for (var i = 0; i < _bigWins.length; i++) {

            _bigWins[i].text.visible = false;
            _bigWins[i].enable = i === 0;
            _bigWins[i].text.alpha = 1;
            _bigWins[i].text.scale.set(1 / _qualityFactor);

            if (_lightsVisible) {
                _bigWins[i].lights.visible = false;
                _bigWins[i].lights.alpha = 1;
                _bigWins[i].lights.scale.set(1 / _qualityFactor);
            }
        }
    };

    var _getEnableBigWin = function (index) {
        var bigWin = _bigWins[index];
        bigWin.text.visible = true;
        bigWin.text.alpha = 1;

        if (_lightsVisible) {
            bigWin.lights.visible = true;
            bigWin.lights.alpha = 1;
        }
        return bigWin;
    };

    var _scale = function (duration) {
        _scalingTween = nge.tween.add(_container.scale).to({
            x: _cfg.firstStepScale,
            y: _cfg.firstStepScale
        }, duration * _cfg.firstStepScaleSpeed, nge.Lib.Tween.Easing.Linear.None, false);

        _scalingTween.onComplete.addOnce(function () {
            _container.scale.set(_cfg.firstStepScale);
        }, this);

        _cfg.emitters.splash.forEach(function (item) {
            var emitter = _initializeEmitter(_emitterParent, 0, 0, item);
            _emittersSplash.push(
                emitter
            );
            emitter.emit = true;
        });

        _cfg.emitters.loop.forEach(function (item) {
            var emitter = _initializeEmitter(_emitterParent, 0, 0, item);
            _emittersLoop.push(
                emitter
            );
            emitter.emit = true;
        });
        _scalingTween.start();
    };

    var _createCounterTween = function (data) {
        var _target = { x: 0 };
        _totalBet = nge.Lib.Money.toCoins(+nge.localData.get('totalBet.value'));
        var _finishValue = data.value / _totalBet;

        _counterTween = nge.tween.add(_target).to({ x: data.value }, data.duration, nge.Lib.Tween.Easing.Linear.None, false);
        _counterTween.onUpdateCallback(function (tween, value, tweenData) {

            if (!_running)
                return;

            _currentAmount = Math.ceil(tween.target.x);
            _self.setAmount(_currentAmount);

            _currentAmount /= _totalBet;

            if (_cfg.thresholds.mega <= _currentAmount && _startIndex === 0) {
                _running = !(_finishValue === _currentAmount);
                _startIndex = 1;
                _changeBigWin(0, _startIndex, !_running);
            } else if (_cfg.thresholds.super <= _currentAmount && _startIndex === 1) {
                _running = !(_finishValue === _currentAmount);
                _startIndex = 2;
                _changeBigWin(1, _startIndex, !_running);
            } else if (_cfg.thresholds.ultra <= _currentAmount && _startIndex === 2) {
                _running = !(_finishValue === _currentAmount);
                _startIndex = 3;
                _changeBigWin(2, _startIndex, !_running);
            }
        });
        _counterTween.onComplete.addOnce(function () {
            if (_running) {
                nge.observer.fire('bigWin.counter.complete');
                nge.observer.fire('bigWin.complete.start');
                _self.setAmount(data.value);

                if (_scalingTween)
                    _scalingTween.stop();

                var tween = nge.tween.add(_scalableContainer.scale).to({ x: 1.1, y: 1.1 }, 250, nge.Lib.Tween.Easing.Linear.None, false);
                tween.onComplete.addOnce(function () {
                    _scalableContainer.scale.set(1.1);
                    tween = nge.tween.add(_scalableContainer.scale).to({ x: 0, y: 0 }, 300, nge.Lib.Tween.Easing.Back.In, false, 1000);
                    tween.onComplete.addOnce(function () {
                        _scalableContainer.scale.set(0.01);
                        _reset();
                        nge.observer.fire('bigWin.complete');
                    }, this);
                    tween.start();
                    _tweens.push(tween);
                }, this);
                tween.start();
                _tweens.push(tween);
            }
        }, this);
        _counterTween.start();
    };

    var _createCircleTween = function () {
        _background.angle = 0;
        var tween = nge.tween.add(_background).to({ angle: 360 }, 10000, nge.Lib.Tween.Easing.Linear.None, true, 0, -1);
        tween.onUpdateCallback(function (tween, value, tweenData) {
            for (var i = 0; i < _bigWinStars.length; i++)
                _bigWinStars[i].angle = _background.angle;
        });
        _tweens.push(tween);

        var currentBigWin = _getEnableBigWin(0);

        if (_lightsVisible) {
            currentBigWin.lights.alpha = 1;
            tween = nge.tween.add(currentBigWin.lights).to({ alpha: 0 }, 250, nge.Lib.Tween.Easing.Linear.None, true, 0, -1, true);
            _tweens.push(tween);
        }
    };

    var _show = function (data) {
        if (_running)
            return;

        _reset();

        _winValue = data.value;
        _startIndex = 0;
        _container.alpha = 1;
        _container.scale.set(1);
        _container.visible = true;
        _self.setAmount(0);

        _scalableContainer.alpha = _cfg.containerStartFromAlpha ? 0: 1;
        _scalableContainer.scale.set(1);

        if(nge.localData.get('wasQuickFinish')) {
            _self.setAmount(+_winValue);

            var finalStage = 3;
            if (_cfg.thresholds.ultra <= _winValue)
                finalStage = 2;
            else if (_cfg.thresholds.super <= _winValue)
                finalStage = 1;
            else if (_cfg.thresholds.mega <= _winValue)
                finalStage = 0;

            for (var i = 0; i < 4; i++) {
                var bigWinStage = _bigWins[i];
                bigWinStage.text.alpha = 0;
                bigWinStage.text.visible = false;
                bigWinStage.enable = false;

                if (_lightsVisible) {
                    bigWinStage.lights.alpha = 0;
                    bigWinStage.lights.visible = false;
                }
            }

            var finalBigWin = _getEnableBigWin(finalStage);
            _showNextBigWin(finalBigWin, true);
            nge.observer.fire('bigWin.start');
            nge.observer.fire('bigWin.counter.complete');
            return;
        }

        _running = true;
        _scalableContainer.scale.set(_cfg.containerStartScale);

        _totalBet = nge.Lib.Money.toCoins(+nge.localData.get('totalBet.value'));
        var firstStepScaleDuration = data.duration / ((data.value / _totalBet) / _cfg.thresholds.mega);

        _createCounterTween(data);

        _scalableStarContainer.alpha = 0;
        _scalableStarContainer.scale.set(0.01);

        var tween = nge.tween.add(_scalableStarContainer.scale).to({ x: 1.15, y: 1.15 }, 625, nge.Lib.Tween.Easing.Linear.None, false);
        tween.onUpdateCallback(function (tween, value, tweenData) {
            _scalableStarContainer.alpha = tweenData.percent;
        });
        tween.onComplete.addOnce(function () {
            _scalableStarContainer.scale.set(1.15);
            nge.observer.fire('bigWin.startShow');
        }, this);
        tween.start();
        _tweens.push(tween);

        tween = nge.tween.add(_scalableContainer.scale).to({ x: 0.75, y: 0.75 }, 500, nge.Lib.Tween.Easing.Linear.None, false);
        tween.onUpdateCallback(function (tween, value, tweenData) {
            if(_cfg.containerStartFromAlpha)
                _scalableContainer.alpha = tweenData.percent;
            
            _background.alpha = tweenData.percent;
            // _scalableStarContainer.alpha = tweenData.percent;
            // _scalableContainer.scale = _scalableContainer.scale;
        });
        tween.onComplete.addOnce(function () {
            _scalableContainer.scale.set(0.75);
            if (_self.needSpinButtonOverCover)
                nge.observer.fire('buttons.startBigWin');
            nge.observer.fire('fairyButton.enableAndSetCallback', _self.fairyButtonPressEvent);
            nge.observer.fire('bigWin.scale.complete');
            // _scalableStarContainer.scale = _scalableContainer.scale;
            tween = nge.tween.add(_scalableContainer.scale).to({ x: 1, y: 1 }, 125, nge.Lib.Tween.Easing.Linear.None, false);
            tween.onComplete.addOnce(function () {
                _scalableContainer.scale.set(1);
                _scale(firstStepScaleDuration);
            }, this);
            tween.start();
            _tweens.push(tween);
        }, this);
        tween.start();
        _tweens.push(tween);
        _createCircleTween();
        nge.observer.fire('bigWin.start');
    };

    var _showNextBigWin = function (nextBigWin, closeBigWin) {

        nextBigWin.text.scale.set(0.01);
        nextBigWin.text.alpha = 1;

        if (_lightsVisible) {
            nextBigWin.lights.alpha = 1;
            nextBigWin.lights.scale.set(0.01);
        }

        _cfg.emitters.splash.forEach(function (item) {
            var emitter = _initializeEmitter(_emitterParent, 0, 0, item);
            _emittersSplash.push(
                emitter
            );
            emitter.emit = true;
        });

        if (!_running)
            nge.observer.fire('bigWin.quickFinish.start');

        var tween = nge.tween.add(nextBigWin.text.scale).to({ x: 1.2 / _qualityFactor, y: 1.2 / _qualityFactor }, 250, nge.Lib.Tween.Easing.Linear.None, false);
        if (_lightsVisible){
            tween.onUpdateCallback(function (tween, value, tweenData) {
                nextBigWin.lights.scale = nextBigWin.text.scale;
            });
        }

        tween.onComplete.addOnce(function () {
            nextBigWin.text.scale.set(1.2 / _qualityFactor);
            if (closeBigWin) {
                tween = nge.tween.add(nextBigWin.text.scale).to({ x: 1 / _qualityFactor, y: 1 / _qualityFactor }, 250, nge.Lib.Tween.Easing.Linear.None, false);
                if (_lightsVisible){
                    tween.onUpdateCallback(function (tween, value, tweenData) {
                        nextBigWin.lights.scale = nextBigWin.text.scale;
                    });
                }
                tween.onComplete.addOnce(function () {
                    nextBigWin.text.scale.set( 1 / _qualityFactor);
                    tween = nge.tween.add(_container.scale).to({ x: 0, y: 0 }, 400, nge.Lib.Tween.Easing.Linear.None, false, 1000);
                    tween.onStart.add(function () {
                        nge.observer.fire('bigWin.complete.start');
                    });
                    tween.onUpdateCallback(function (tween, value, tweenData) {
                        _container.alpha = 1 - tweenData.percent;
                    });
                    tween.onComplete.addOnce(function () {
                        _container.scale.set(0.01);
                        _reset();
                        nge.observer.fire('bigWin.quickFinish');
                        nge.observer.fire('bigWin.complete');
                    }, this);
                    tween.start();
                    _tweens.push(tween);
                });
            } else {
                tween = nge.tween.add(nextBigWin.text.scale).to({ x: 1 / _qualityFactor, y: 1 / _qualityFactor }, 250, nge.Lib.Tween.Easing.Linear.None, false);
                if (_lightsVisible){
                    tween.onUpdateCallback(function (tween, value, tweenData) {
                        nextBigWin.lights.scale = nextBigWin.text.scale;
                    });
                }
                tween.onComplete.addOnce(function () {
                    nextBigWin.text.scale.set( 1 / _qualityFactor);
                    if (_lightsVisible) {
                        tween = nge.tween.add(nextBigWin.lights).to({ alpha: 0 }, 250, nge.Lib.Tween.Easing.Linear.None, true, 0, -1, true);
                        tween.start();
                        _tweens.push(tween);
                    }
                }, this);
            }
            tween.start();
            _tweens.push(tween);
        }, this);

        tween.start();
        _tweens.push(tween);
    };

    var _closeCurrentBigWin = function (currentBigWin) {

        var tween = nge.tween.add(_bigWinCounterContainer.scale).to({ x: 1.1, y: 1.1 }, 200, nge.Lib.Tween.Easing.Linear.None, false, 150, 1, true);
        tween.start();
        tween.onComplete.addOnce(function () {
            _bigWinCounterContainer.scale.set(1.1);
        }, this);
        _tweens.push(tween);

        _scalableContainer.scale.set(1);

        tween = nge.tween.add(_scalableContainer.scale).to({ x: 1.1, y: 1.1 }, 350, nge.Lib.Tween.Easing.Linear.None, false, 0, 1, true);
        
        // tween.onComplete.addOnce(function () {
        //     // _scalableContainer.scale.set(1.1);
        // }, this);

        // tween.start();
        // _tweens.push(tween);

        tween = nge.tween.add({ x: 1 }).to({ x: 1, y: 1 }, 350, nge.Lib.Tween.Easing.Linear.None, false);
        tween.onUpdateCallback(function (tween, value, tweenData) {
            currentBigWin.text.alpha = 1 - value;
            if (_lightsVisible)
                currentBigWin.lights.alpha = 1 - value;
            var scale = 1 + 2.5 * value;
            if (scale < 2) {
                currentBigWin.text.scale.set(scale / _qualityFactor);
                if (_lightsVisible)
                    currentBigWin.lights.scale.set(scale / _qualityFactor);
            }
        });
        tween.onComplete.addOnce(function () {
            currentBigWin.text.alpha = 0;
            currentBigWin.text.visible = false;
            currentBigWin.enable = false;

            if (_lightsVisible) {
                currentBigWin.lights.alpha = 0;
                currentBigWin.lights.visible = false;
            }
        }, this);
        tween.start();
        _tweens.push(tween);
    };

    var _changeBigWin = function (currentIndex, nextIndex, closeBigWin) {
        nge.observer.fire('bigWin.changestate');

        var currentBigWin = _getEnableBigWin(currentIndex);
        var nextBigWin = _getEnableBigWin(nextIndex);

        _showNextBigWin(nextBigWin, closeBigWin);
        _closeCurrentBigWin(currentBigWin);
    };

    var _cancel = function () {
        if(!_running)
            return;
        _reset();
        nge.observer.fire('bigWin.complete');
    };

    var _quickFinishDone = function () {
        if (!_running)
            return;
        _running = false;

        if (_scalingTween)
            _scalingTween.stop();
        if (_counterTween)
            _counterTween.stop();

        _self.setAmount(+_winValue);

        _winValue /= _totalBet;

        if (_cfg.thresholds.ultra <= _winValue && _startIndex < 3)
            _changeBigWin(_startIndex, 3, true);
        else if (_cfg.thresholds.super <= _winValue && _startIndex < 2)
            _changeBigWin(_startIndex, 2, true);
        else if (_cfg.thresholds.mega <= _winValue && _startIndex < 1)
            _changeBigWin(_startIndex, 1, true);
        else {
            
            var tween = nge.tween.add(_scalableContainer.scale).to({ x: 1.1, y: 1.1 }, 250, nge.Lib.Tween.Easing.Linear.None, false, 1000);
            nge.observer.fire('bigWin.quickFinish.start');
            tween.onComplete.addOnce(function () {
                _scalableContainer.scale.set(1.1);
                nge.observer.fire('bigWin.counter.complete');
                nge.observer.fire('bigWin.complete.start');
                tween = nge.tween.add(_container.scale).to({ x: 0, y: 0 }, 350, nge.Lib.Tween.Easing.Linear.None, false);
                tween.onUpdateCallback(function (tween, value, tweenData) {
                    _container.alpha = 1 - tweenData.percent;
                });
                tween.onComplete.addOnce(function () {
                    _container.scale.set(0.01);
                    _container.alpha = 0;
                    _reset();
                    nge.observer.fire('bigWin.quickFinish');
                    nge.observer.fire('bigWin.complete');
                }, this);
                tween.start();
                _tweens.push(tween);
            }, this);
            tween.start();
            _tweens.push(tween);
        }
    };

    var _tweePopupAlpha = function (shadow, open) {
        var targetAlpha = open ? 0.5 : 0;
        if (open) {
            shadow.visible = true;
            shadow.alpha = 0;
        }
        var tween = nge.tween.add(shadow).to({ alpha: targetAlpha }, 400, nge.Lib.Tween.Easing.Linear.None, false);
        tween.onComplete.add(function () {
            shadow.alpha = targetAlpha;
            if (!open)
                shadow.visible = false;
        });
        tween.start();
    };

    var _openShadow = function () {
        if(_cfg.shadowPopupCover)
            _tweePopupAlpha(_startPopupPickemCover, true);
    };

    var _closeShadow = function () {
        if(_cfg.shadowPopupCover)
            _tweePopupAlpha(_startPopupPickemCover, false);
    };

    var _onAnywayComplete = function () {
        if (_self.needSpinButtonOverCover)
            nge.observer.fire('buttons.completeBigWin');
        nge.observer.fire('fairyButton.disable');
    };

    this.subscribe = function () {
        nge.observer.add('riverslot.bigWin.show', _show);
        nge.observer.add('riverslot.bigWin.hide', _cancel);
        nge.observer.add('slotMachine.quickFinish', _quickFinishDone);
        nge.observer.add('Transport.close', _cancel);
        nge.observer.add('bigWin.scale.complete', _openShadow);
        nge.observer.add('bigWin.complete.start', _closeShadow);
        nge.observer.add('bigWin.complete', _onAnywayComplete);
        _subscribed = true;
    };
});



