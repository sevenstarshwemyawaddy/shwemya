    ];
    // Stroke
    this.stroke = {
        weight: 3,
        colors: [
            '0x006ea3', //1
            '0xc00000', //2
            '0x005701', //3
            '0xa59c00', //4
            '0xbd219e', //5
            '0x00a145', //6
