nge.App[nge.appNS].Com.CreditsTotalBet = {};



nge.App[nge.appNS].Com.CreditsTotalBet.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _self = this;
    this.enableMaxWidth = false;
    this.maxWidth = 150;
    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        this.createDefault();

        nge.rafSetTimeout(_update, 1);

        if (!_created)
            _subscribe();

        _created = true;
        return true;
    };

    var _update = function () {
        var creditsAmount = nge.findAll('.creditsTotalBetNumber');

        if (!creditsAmount)
            return;

        var tb = nge.localData.get('totalBet.value');
        var cv = nge.localData.get('coins.value');
        var extraBet = (nge.localData.get('extraBet') === '1') ? nge.localData.get('extraBetMult') : 1;

        creditsAmount.forEach(function (creditsAmount) {
            creditsAmount.text = parseFloat((tb / cv).toFixed(2) * extraBet);
            if (_self.enableMaxWidth)
                creditsAmount.maxSizeResize('width', _self.maxWidth);
        });
    };

    var _subscribe = function () {
        nge.observer.add('totalBet.change', _update);
    };
});



nge.App[nge.appNS].Com.CurrencySwitcher= {};



nge.App[nge.appNS].Com.CurrencySwitcher.Controller = nge.Com.Base.extend(function () {
    var _created = false;
    var _self = this;
    
    var _typeEnum = {
        CREDITS: 0,
        CURRENCY: 1
    };

    this.selectors = {
        creditsSelectors: {
            '^totalBetCoinsContentContainer': null,
            '^balanceCoinsContentContainer': null,
            '#gambleToWinCredits': null,
            '#gambleAmountCredits': null,
            '.creditsWinNumber': null,
            '^offerFreeGamesWinCredits': null
        },
        currencySelectors: {
            '^totalBetContentContainer': null,
            '^balanceContentContainer': null,
            '#gambleAmount': null,
            '#gambleToWin': null,
            '.winNumber': null,
            '^offerFreeGamesWin': null
        }
    };

    var _initObjValues = function(obj){
        for(var selector in obj)
            obj[selector] = nge.findAll(selector);
    };

    var _initVars = function(){
        for(var selectorsType in _self.selectors)
            _initObjValues(_self.selectors[selectorsType]);
    };

    var _switchTextsArr = function(obj, valueType, selectorsType){
        obj.forEach(function(text){
            var needShowCredits = false;

            if(valueType === _typeEnum.CREDITS)
                needShowCredits = selectorsType.indexOf('credits') !== -1;
            
            if(valueType === _typeEnum.CURRENCY)
                needShowCredits = selectorsType.indexOf('credits') === -1;    

            text.visible = needShowCredits;
        });
    };

    var _switchTo = function(obj, valueType, selectorsType){
        for(var selector in obj){
            if(obj[selector])
                _switchTextsArr(obj[selector], valueType, selectorsType);
        }
    };

    var _switch = function() {    
        var inCoins = nge.localData.get('settings.settingsDisplayValuesInCoins') || false;
        nge.localData.set('settings.settingsDisplayValuesInCoins', !inCoins);

        var valueType = inCoins ? _typeEnum.CREDITS : _typeEnum.CURRENCY;

        for(var selectorsType in _self.selectors)        
            _switchTo(_self.selectors[selectorsType], valueType, selectorsType);
    };

    var _onButtonsPress = function(target) {
        if(target === 'currencyChanger'){
            _switch();
            nge.observer.fire('denom_change.play');
        }
    };

    this.subscribe = function() {
        nge.observer.add('buttons.pressCommand', _onButtonsPress);
        nge.observer.add('currencySwitcher.switch', _switch);
    };

    this.create = function () {
        this.createDefault();
        
        var inCoins = nge.localData.get('settings.settingsDisplayValuesInCoins');
        if (typeof inCoins === 'undefined')
            nge.localData.set('settings.settingsDisplayValuesInCoins', false);
        else
            nge.localData.set('settings.settingsDisplayValuesInCoins', !inCoins);

        _initVars();
        _switch();

        if (!_created){
            this.subscribe();
        }

        _created = true;
        return true;
    };
});



