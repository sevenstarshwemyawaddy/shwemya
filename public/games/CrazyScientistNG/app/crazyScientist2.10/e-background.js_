nge.App[nge.appNS].Com.WinlinesAddon = {};



nge.App[nge.appNS].Com.WinlinesAddon.Cfg = Class.extend(function () {
    this.singleton = true;

    /**
     * slot machine settings
     */
    this.params = {
        generateLines: true,
        cacheBorderWinObjectsAsBitmap: true,
        cacheRouteframeObjectsAsBitmap: true,
        border: {// used only if there's no textures
            weight: 6,
            offsetX: 0,
            offsetY: -3,
            textOffsetX: 0,
            textOffsetY: 0,
            width: 98,
            height: 36,
            colors: false, // or array ['0x000000', '0x000000', ...]
            alpha: 1,
            stroke: {// if false - no stroke, true - use winines.cfg's stroke
                weight: 2,
                colors: false, // or array ['0x000000', '0x000000', ...]
                alpha: 1
            },
            background: {// if false - no background
                color: '0x000',
                alpha: 0.65
            },
            scatter: {// 'false' if there's no scatter
                color: '0xF5990C',
                strokeColor: '0xD5870C'
            },
            textSameColor: false
        },
        routeframe: {// used only if there's no textures
            offsetX: 0,
            offsetY: 0,
            weight: 6,
            width: 252,
            height: 252,
            colors: false, // or array ['0x000000', '0x000000', ...]
            alpha: 1,
            stroke: {// if false - no stroke, true - use winines.cfg's stroke
                weight: 4,
                colors: false, // or array ['0x000000', '0x000000', ...]
                alpha: 1
            },
            scatter: {// 'false' if there's no scatter
                color: '0xF5990C',
                strokeColor: '0xD5870C'
            }
        },

        routeframesNeed: true,
        borderWinNeed: true,
        scaleFactor: 2,
        borderWin: 2,
        borderWinOffsets: false, //or [{x:12, y:123},{x:55, y:543}...]
        routeframesUnderSymbols: false, //if true winlinesAddonContainer will be added at SM parent container
        rowsXoffset: false, // or array like [15, 20, 30, 40, 50]
        rowsYoffset: false, // or array like [15, 20, 30, 40, 50]

        textStyle: {
            font: 'bold 18pt "roboto_condensed_regular"',
            fill: '#fff',
            align: 'left'
        }
    };

    /**
     * get params
     * @returns {Object}
     */
    this.get = function () {
        return this.params;
    };

});



nge.App[nge.appNS].Com.WinlinesAddon.Controller = nge.Com.Base.extend(function () {
    var _self;
    var _cfg;
    var _instance;
    var _linesCache = {};

    this.lineSelector = '#';

    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        _self = this;
        _linesCache = {};

        this.createDefault();

        if (!_instance) {
            _cfg = this.getInstance('Cfg').get();

            if (_cfg.generateLines)
                _instance = this.getInstance('LinesController');
            else
                _instance = this.getInstance('TexturesController');

            _subscribe();
        }

        _instance.create();

        var defaultVal = nge.localData.get('lines.value');
        _updateTpl(defaultVal);

        return true;
    };

    var _updateTpl = function (v) {
        var wl = nge.localData.get('winlines');

        for (var i = 1; i < wl.length + 1; i++) {
            var vis = false;

            if (i <= v)
                vis = true;

            _changeLineAddonVisibility(i, vis);
        }
    };

    var _changeLineAddonVisibility = function (n, vis) {

        var rSelector = _self.lineSelector.concat('lm-r-', n);
        var lSelector = _self.lineSelector.concat('lm-l-', n);

        if(!_linesCache[rSelector])
            _linesCache[rSelector] = nge.findOne(_self.lineSelector.concat('lm-r-', n));

        if(!_linesCache[lSelector])
            _linesCache[lSelector] = nge.findOne(_self.lineSelector.concat('lm-l-', n));

        if (_linesCache[rSelector])
            _linesCache[rSelector].visible = vis;

        if (_linesCache[lSelector])
            _linesCache[lSelector].visible = vis;
    };

    var _subscribe = function () {
        nge.observer.add('lines.change', _updateTpl);
    };

});



nge.App[nge.appNS].Com.WinlinesAddon.TexturesController = nge.Com.Base.extend(function () {
    var _self;
    var _created;
    var _cfg;
    var _smCfg;
    var _container;
    var _symbolWidth;
    var _symbolHeight;
    var _winlines;
    var _scatter = false;
    var _wonCoinValue;

    var _cache = {};

    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        _self = this;

        _smCfg = this.getInstance('Cfg', 'slotMachine').get();

        _cfg = this.getInstance('Cfg').get();

        _cache = {};

        var addon = _createAddon();
        var tpl = this.getInstance('Tpl', false, addon);
        var parent = nge.findOne('^winlinesAddonContainer');
        nge.objects.create(tpl.objects.contents[0], parent);

        if (_cfg.routeframesUnderSymbols) {
            //winlinesAddonContainer will be added at SM parent container
            var SMcon = nge.findOne('^' + _smCfg.parentName);
            SMcon.add(parent);
            //coords correction
            parent.x -= SMcon.x;
            parent.y -= SMcon.y;
        }

        if (!_created)
            _subscribe();

        _created = true;
        return true;
    };

    var _createAddon = function () {
        _container = nge.findOne('^' + _smCfg.parentName);

        if (!_container)
            return false;

        var cData = _container.mt.data;

        _symbolWidth = cData.width / _smCfg.mw;
        _symbolHeight = cData.height / _smCfg.mh;

        _winlines = nge.localData.get('winlines');

        var addon = [];
        for (var n = 0; n < _winlines.length; n++) {
            var winline = new nge.Mlm.Objects.Folder(
                {"name": "w-a-line-" + n, isVisible: false});
            _drawLineAddon(winline, _winlines[n], n);
            addon.push(winline);
        }

        //universal 4 scatter
        var scBorder = nge.wrap.cache.checkImageKey('border_win_scatter');
        var scFrame = nge.wrap.cache.checkImageKey('gn_routeframes_scatter');

        if (scBorder && scFrame) {
            _scatter = true;
            var winline = new nge.Mlm.Objects.Folder(
                {"name": "w-a-line-scatter", isVisible: false});
            _winlines['scatter'] = _winlines[0];
            _drawLineAddon(winline, _winlines['scatter'], 'scatter');
            addon.push(winline);
        }

        return addon;
    };

    var _getItemFromCache = function(item){
        if(!_cache[item])
            _cache[item] = nge.findOne('^'.concat(item));
       
        return _cache[item];
    };

    var _drawLineAddon = function (con, lineData, n) {
        var offsetX = 0;
        var offsetY = 0;

        offsetX = (_smCfg.rowsXoffset) ? _smCfg.rowsXoffset[0] : 0 +
        (_cfg.rowsXoffset) ? _cfg.rowsXoffset[0] : 0;

        offsetY = (_smCfg.rowsYoffset) ? _smCfg.rowsYoffset[0] : 0 +
        (_cfg.rowsYoffset) ? _cfg.rowsYoffset[0] : 0;



        var suffix = _cfg.suffix || n;
        if (typeof suffix === "number")
            suffix = nge.Lib.Helper.LdgZero(n, 3);

        //small bar
        if (_cfg.borderWinNeed) {
            var text = new nge.Mlm.Objects.Text({
                "name": "w-a-text-" + n,
                x: _symbolWidth / 2 + offsetX,
                y: lineData[0] * _symbolHeight + _symbolHeight + offsetY,
                text: '1000',
                'anchorX': 0.5, 'anchorY': 1, style: _cfg.textStyle
            });
            con.contents.push(text);

            var key = 'border_win_' + suffix;
            var object = new nge.Mlm.Objects.Image({
                "name": "w-a-sb-" + n,
                x: _symbolWidth / 2 + offsetX,
                y: lineData[0] * _symbolHeight + _symbolHeight + offsetY,
                assetKey: key,
                'anchorX': 0.5, 'anchorY': 1
            });
            con.contents.push(object);
        }

        //borders
        if (_cfg.routeframesNeed) {
            for (var i = 0; i < lineData.length; i++) {
                var key = 'gn_routeframes_' + suffix;

                offsetX = (_smCfg.rowsXoffset) ? _smCfg.rowsXoffset[i] : 0 +
                (_cfg.rowsXoffset) ? _cfg.rowsXoffset[i] : 0;

                offsetY = (_smCfg.rowsYoffset) ? _smCfg.rowsYoffset[i] : 0 +
                (_cfg.rowsYoffset) ? _cfg.rowsYoffset[i] : 0;

                var elCon = new nge.Mlm.Objects.Folder({
                    name: "w-a-el-" + n + "-" + i,
                    x: i * _symbolWidth + _symbolWidth / 2 + offsetX,
                    y: (0.5 + parseInt(lineData[i])) * _symbolHeight + offsetY
                });

                con.contents.push(elCon);

                var object = new nge.Mlm.Objects.Image({
                    assetKey: key, scaleX: _cfg.scaleFactor, scaleY: _cfg.scaleFactor,
                    'anchorX': 0.5, 'anchorY': 0.5
                });
                elCon.contents.push(object);
            }
        }
    };

    var _winHandler = function () {
        _wonCoinValue = nge.localData.get('coins.value');
    };

    var _show = function (data) {
        var spinning = nge.localData.get('slotMachineSpinning');
        if (spinning)
            return false;

        var line = data.selectedLine;
        if (typeof line === 'undefined')
            if (_scatter)
                line = 'scatter';
            else
                return false;

        var amount = data.amount;
        var cv = _wonCoinValue || nge.localData.get('coins.value');

        var add = _getItemFromCache('w-a-line-'.concat(line));
        add.visible = true;

        if (_cfg.borderWinNeed) {
            var text = _getItemFromCache('w-a-text-'.concat(line));
            text.text = parseFloat((amount / cv).toFixed(2));
        }

        var winline = _winlines[line];
        var visibleArr = [];

        for (var i = 0; i < winline.length; i++) {
            visibleArr[i] = false;
        }

        var first = true;
        for (var i = 0; i < data.wonSymbols.length; i++) {
            var coords = data.wonSymbols[i];

            if (winline[coords[0]] === coords[1])
                visibleArr[coords[0]] = true;

            var offsetX = (_smCfg.rowsXoffset) ? _smCfg.rowsXoffset[coords[0]] : 0 +
            (_cfg.rowsXoffset) ? _cfg.rowsXoffset[coords[0]] : 0;
            var offsetY = (_smCfg.rowsYoffset) ? _smCfg.rowsYoffset[coords[0]] : 0 +
            (_cfg.rowsYoffset) ? _cfg.rowsYoffset[coords[0]] : 0;

            if (line === 'scatter') {
                visibleArr[coords[0]] = true;   
                var addon = _getItemFromCache('w-a-el-scatter-'.concat(coords[0]));
                addon.y = coords[1] * _symbolHeight + _symbolHeight / 2 + offsetY;
            }

            if (_cfg.borderWinNeed && first && visibleArr[coords[0]]) {
                first = false;
                var textWin =  _getItemFromCache('w-a-text-'.concat(line));
                var bwo = _cfg.borderWinOffsets[line];
                var textOffset = {
                    x: (bwo && bwo.x) ? bwo.x : 0,
                    y: (bwo && bwo.y) ? bwo.y : 0
                };

                textWin.x = coords[0] * _symbolWidth + _symbolWidth / 2 + offsetX + textOffset.x;
                textWin.y = coords[1] * _symbolHeight + _symbolHeight + offsetY + textOffset.y;
                
                var borderWin = _getItemFromCache('w-a-sb-'.concat(line));
                borderWin.x = textWin.x;
                borderWin.y = textWin.y;

                var visibility = (amount > 0) ? true : false;
                textWin.visible = visibility;
                borderWin.visible = visibility;
            }
        }

        //change visibility
        if (_cfg.routeframesNeed) {
            for (var i = 0; i < visibleArr.length; i++) {
                var el = _getItemFromCache('w-a-el-'.concat(line, '-', i));
                if (el)
                    el.visible = visibleArr[i];
            }
        }
    };

    var _hide = function (data) {
        for (var n = 0; n < _winlines.length; n++) {
            var add = _getItemFromCache('w-a-line-'.concat(n));
            if (add)
                add.visible = false;
        }

        //scatter
        var add = _getItemFromCache('w-a-line-scatter');
        if (add)
            add.visible = false;
    };

    var _subscribe = function () {
        //_show
        if (_cfg.routeframesUnderSymbols)
            nge.observer.add("winlines.lineHighlite.start.previousHided", _show);
        else
            nge.observer.add("winlines.lineHighlite.startComplete", _show);

        nge.observer.add('winlines.view.startHideAll', _hide);
        nge.observer.add('win', _winHandler);
    };
});



nge.App[nge.appNS].Com.WinlinesAddon.LinesController = nge.Com.Base.extend(function () {
    var _self;
    var _subscribed = false;
    var _cfg;
    var _winlineCfg;
    var _smCfg;
    var _smContainer;
    var _symbolWidth = 0;
    var _symbolHeight = 0;
    var _winlines;
    var _scatter;
    var _wonCoinValue;
    var _parent;

    var _drawSegment = function (graphics, startX, startY, endX, endY, weight, color, alpha) {
        var a = alpha || 1;
        graphics.beginFill(color, a);
        graphics.lineStyle(weight, color, a);
        graphics.moveTo(startX, startY);

        graphics.lineTo(endX, endY);
        graphics.moveTo(endX, endY);
        graphics.endFill();
    };

    var _drawConnector = function (graphics, x, y, size, color, alpha) {
        var a = alpha || 1;
        graphics.beginFill(color, a);
        graphics.lineStyle(0, color, 0);
        graphics.drawCircle(x, y, size / 2);
        graphics.endFill();
    };

    var _drawBackground = function (graphics, x, y, width, height, color, alpha) {
        var a = alpha || 1;
        graphics.beginFill(color, a);
        graphics.drawRect(x, y, width, height);
        graphics.endFill();
    };

    var _drawShape = function (shapeData, graphics) {
        var drawShapeLines = function (width, height, weight, color, alpha) {
            var sides = [{x: 0, y: 0}, {x: width, y: 0}, {x: width, y: height}, {x: 0, y: height}];
            for (var iSide = 0; iSide < sides.length; iSide++) {
                var side = sides[iSide];
                var nextSide = sides[(iSide + 1) >= sides.length ? 0 : iSide + 1];
                _drawConnector(graphics, side.x, side.y, weight, color, alpha);
                _drawSegment(graphics, side.x, side.y, nextSide.x, nextSide.y, weight, color, alpha);
            }
        };

        if (shapeData.background) {
            _drawBackground(
                graphics,
                0, 0,
                shapeData.width,
                shapeData.height,
                shapeData.background.color,
                shapeData.background.alpha);
        }

        if (shapeData.stroke) {
            drawShapeLines(
                shapeData.width, shapeData.height,
                shapeData.strokeWeight + shapeData.weight,
                shapeData.strokeColor,
                shapeData.strokeAlpha);
        }

        drawShapeLines(
            shapeData.width, shapeData.height,
            shapeData.weight,
            shapeData.color,
            shapeData.alpha);
    };

    var _drawLineAddon = function (winlineContainer, lineData, lineIndex) {
        var offsetX = (_smCfg.rowsXoffset)
            ? _smCfg.rowsXoffset[0]
            : (0 + (_cfg.rowsXoffset) ? _cfg.rowsXoffset[0] : 0);

        var offsetY = (_smCfg.rowsYoffset)
            ? _smCfg.rowsYoffset[0]
            : (0 + (_cfg.rowsYoffset) ? _cfg.rowsYoffset[0] : 0);

        var graphics;

        var getStrokeData = function (stroke, index) {
            if (stroke === false) {
                return {stroke: null};
            }

            var winlineStroke = _winlineCfg.stroke;
            var strokeWeight = stroke ? stroke.weight : (winlineStroke ? winlineStroke.weight : 0);
            var strokeColors = (stroke && stroke.colors) || (winlineStroke && winlineStroke.colors);
            var strokeAlpha = stroke ? stroke.alpha : (winlineStroke ? winlineStroke.alpha : 1);
            var s = stroke || winlineStroke;
            return {
                stroke: s,
                weight: strokeWeight,
                color: strokeColors[index],
                alpha: strokeAlpha
            };
        };

        if (_cfg.routeframesNeed) {
            for (var i = 0; i < lineData.length; i++) {
                offsetX = (_smCfg.rowsXoffset) ? _smCfg.rowsXoffset[i] : 0 +
                    (_cfg.rowsXoffset) ? _cfg.rowsXoffset[i] : 0;

                offsetY = (_smCfg.rowsYoffset) ? _smCfg.rowsYoffset[i] : 0 +
                    (_cfg.rowsYoffset) ? _cfg.rowsYoffset[i] : 0;

                graphics = nge.objects.create(new nge.Mlm.Objects.Graphics({name: 'w-a-el-' + lineIndex + '-' + i}));
                graphics.name = 'w-a-el-' + lineIndex + '-' + i;
                var w = _cfg.routeframe ? _cfg.routeframe.width : 0;
                var h = _cfg.routeframe ? _cfg.routeframe.height : 0;
                var innerOffsetX = _cfg.routeframe ? _cfg.routeframe.offsetX : 0;
                var innerOffsetY = _cfg.routeframe ? _cfg.routeframe.offsetY : 0;
                graphics.x = ((i * _symbolWidth) + (_symbolWidth / 2) + offsetX) - (w / 2) + innerOffsetX;
                graphics.y = (((0.5 + parseInt(lineData[i])) * _symbolHeight) + offsetY) - (h / 2) + innerOffsetY;

                var color = (lineIndex === 'scatter'
                    ? _cfg.routeframe.scatter.color
                    : (_cfg.routeframe.colors[lineIndex] || _winlineCfg.lineColors[lineIndex]));

                var s = getStrokeData(_cfg.routeframe.stroke, lineIndex);

                var strokeColor = (lineIndex === 'scatter')
                    ? _cfg.routeframe.scatter.strokeColor
                    : s.color;

                _drawShape({
                    width: _cfg.routeframe.width,
                    height: _cfg.routeframe.height,
                    weight: _cfg.routeframe.weight,
                    color: color,
                    alpha: _cfg.routeframe.alpha,
                    stroke: s.stroke,
                    strokeWeight: s.weight,
                    strokeColor: strokeColor,
                    strokeAlpha: s.alpha
                }, graphics);
                graphics.cacheAsBitmap = true;
                winlineContainer.add(graphics);
            }
        }

        if (_cfg.borderWinNeed) {
            // border
            graphics = nge.objects.create(new nge.Mlm.Objects.Graphics({
                name: 'w-a-sb-' + lineIndex
            }));
            graphics.name = 'w-a-sb-' + lineIndex;
            var w = _cfg.border ? _cfg.border.width : 0;
            var h = _cfg.border ? _cfg.border.height : 0;
            var innerOffsetX = _cfg.border ? _cfg.border.offsetX : 0;
            var innerOffsetY = _cfg.border ? _cfg.border.offsetY : 0;
            graphics.x = ((_symbolWidth / 2) + offsetX) - (w / 2) + innerOffsetX;
            graphics.y = ((lineData[0] * _symbolHeight) + _symbolHeight + offsetY) - h + innerOffsetY;

            var color = (lineIndex === 'scatter'
                ? _cfg.border.scatter.color
                : (_cfg.border.colors[lineIndex] || _winlineCfg.lineColors[lineIndex]));

            var s = getStrokeData(_cfg.border.stroke, lineIndex);

            var strokeColor = (lineIndex === 'scatter')
                ? _cfg.border.scatter.strokeColor
                : s.color;

            _drawShape(
                {
                    width: _cfg.border.width,
                    height: _cfg.border.height,
                    weight: _cfg.border.weight,
                    color: color,
                    alpha: _cfg.border.alpha,
                    stroke: s.stroke,
                    strokeWeight: s.weight,
                    strokeColor: strokeColor,
                    strokeAlpha: s.alpha,
                    background: _cfg.border.background
                }, graphics);
            graphics.cacheAsBitmap = true;
            winlineContainer.add(graphics);

            // text
            var x = (_symbolWidth / 2) + offsetX + (_cfg.border ? _cfg.border.textOffsetX : 0);
            var y = (lineData[0] * _symbolHeight) + _symbolHeight + offsetY + (_cfg.border ? _cfg.border.textOffsetY : 0);
            var textStyle = _cfg.textStyle;
            if (_cfg.border.textSameColor) {
                textStyle = nge.Lib.Helper.jsObjClone(_cfg.textStyle);
                textStyle.fill = color.replace('0x', '#');
            }

            var text = nge.objects.create(new nge.Mlm.Objects.Text({
                name: 'w-a-text-' + lineIndex,
                x: x,
                y: y,
                text: '1000',
                style: textStyle,
                anchorX: 0.5,
                anchorY: 1
            }), winlineContainer);
            text.name = 'w-a-text-' + lineIndex;
        }
    };

    var _createAddon = function () {
        _smContainer = nge.findOne('^' + _smCfg.parentName);

        if (!_smContainer)
            return false;
        _self.winlinesAddonContainer.contents = [];

        var cData = _smContainer.mt.data;
        _symbolWidth = cData.width / _smCfg.mw;
        _symbolHeight = cData.height / _smCfg.mh;
        _winlines = nge.localData.get('winlines');

        for (var n = 0; n < _winlines.length; n++) {
            let winline = nge.objects.create(new nge.Mlm.Objects.Folder({
                name: 'w-a-line-' + n,
                isVisible: false
            }));
            winline.name = 'w-a-line-' + n;
            _drawLineAddon(winline, _winlines[n], n);
            _self.winlinesAddonContainer.add(winline);
        }

        // Scatters
        const scBorder = _cfg.border && _cfg.border.scatter !== false;
        const scFrame = _cfg.routeframe && _cfg.routeframe.scatter !== false;

        if (scBorder && scFrame) {
            _scatter = true;
            let winline = nge.objects.create(new nge.Mlm.Objects.Folder({
                name: 'w-a-line-scatter',
                isVisible: false
            }));
            winline.name = 'w-a-line-scatter';
            _winlines['scatter'] = _winlines[0];
            _drawLineAddon(winline, _winlines['scatter'], 'scatter');
            _self.winlinesAddonContainer.add(winline);
        }
    };

    var _winHandler = function () {
        _wonCoinValue = nge.localData.get('coins.value');
    };

    var _show = function (data) {
        var spinning = nge.localData.get('slotMachineSpinning');
        if (spinning)
            return false;

        var line = data.selectedLine;
        if (typeof line === 'undefined')
            if (_scatter)
                line = 'scatter';
            else
                return false;

        var amount = data.amount;
        var cv = _wonCoinValue || nge.localData.get('coins.value');

        var addon = nge.findOne('^w-a-line-' + line, _self.winlinesAddonContainer);
        addon.visible = true;

        if (_cfg.borderWinNeed) {
            var text = addon.children.find((o) => {return o.mt.data.type === mt.objects.TEXT; });
            text.text = parseFloat((amount / cv).toFixed(2));
        }

        var winline = _winlines[line];
        var visibleArr = [];

        for (let i = 0; i < winline.length; i++) {
            visibleArr[i] = false;
        }

        var first = true;

        for (let i = 0; i < data.wonSymbols.length; i++) {
            var coords = data.wonSymbols[i];

            if (winline[coords[0]] === coords[1])
                visibleArr[coords[0]] = true;

            var offsetX = (_smCfg.rowsXoffset)
                ? _smCfg.rowsXoffset[coords[0]]
                : (0 + (_cfg.rowsXoffset) ? _cfg.rowsXoffset[coords[0]] : 0);

            var offsetY = (_smCfg.rowsYoffset)
                ? _smCfg.rowsYoffset[coords[0]]
                : (0 + (_cfg.rowsYoffset) ? _cfg.rowsYoffset[coords[0]] : 0);

            if (line === 'scatter') {
                visibleArr[coords[0]] = true;

                var scatter = nge.findOne('^w-a-line-scatter', _self.winlinesAddonContainer).children[coords[0]];
                var h = _cfg.routeframe ? _cfg.routeframe.height : 0;
                var innerOffsetY = _cfg.routeframe ? _cfg.routeframe.offsetY : 0;
                scatter.y = ((coords[1] * _symbolHeight) + (_symbolHeight / 2) + offsetY) - (h / 2) + innerOffsetY;
            }

            if (_cfg.borderWinNeed && first && visibleArr[coords[0]]) {
                first = false;
                
                var textWin = addon.children.find((o) => {return o.mt.data.type === mt.objects.TEXT; });
                var bwo = _cfg.borderWinOffsets[line];
                var textOffset = {x: (bwo && bwo.x) ? bwo.x : 0, y: (bwo && bwo.y) ? bwo.y : 0};

                textWin.x = (coords[0] * _symbolWidth) + (_symbolWidth / 2) + offsetX + textOffset.x;
                textWin.y = (coords[1] * _symbolHeight) + _symbolHeight + offsetY + textOffset.y;
                var borderWin = nge.findOne('^w-a-sb-' + line, addon);
                var w = _cfg.border ? _cfg.border.width : 0;
                var h = _cfg.border ? _cfg.border.height : 0;
                var innerOffsetX = _cfg.border ? _cfg.border.offsetX : 0;
                var innerOffsetY = _cfg.border ? _cfg.border.offsetY : 0;
                borderWin.x = textWin.x - (w / 2) + innerOffsetX;
                borderWin.y = textWin.y - h + innerOffsetY;

                textWin.x += (_cfg.border ? _cfg.border.textOffsetX : 0);
                textWin.y += (_cfg.border ? _cfg.border.textOffsetY : 0);

                var visibility = (amount > 0);
                textWin.visible = visibility;
                borderWin.visible = visibility;
            }
        }

        //change visibility
        if (_cfg.routeframesNeed) {
            for (let i = 0; i < visibleArr.length; i++) {
                let el = nge.findOne('^w-a-el-' + line + '-' + i, addon);
                if (el)
                    el.visible = visibleArr[i];
            }
        }
    };

    var _hide = function () {
        for (let n = 0; n < _winlines.length; n++) {
            let add = nge.findOne('^w-a-line-' + n, _self.winlinesAddonContainer);
            if (add)
                add.visible = false;
        }

        let add = nge.findOne('^w-a-line-scatter', _self.winlinesAddonContainer);
        if (add)
            add.visible = false;
    };

    var _subscribe = function () {
        if (_cfg.routeframesUnderSymbols) {
            nge.observer.add('winlines.lineHighlite.start.previousHided', _show);
        } else {
            nge.observer.add('winlines.lineHighlite.startComplete', _show);
        }

        nge.observer.add('winlines.view.startHideAll', _hide);
        nge.observer.add('win', _winHandler);
        _subscribed = true;
    };

    this.create = function () {
        _self = this;
        _smCfg = this.getInstance('Cfg', 'slotMachine').get();
        _cfg = this.getInstance('Cfg').get();
        _winlineCfg = this.getInstance('Cfg', 'winlines');

        _parent = nge.findOne('^winlinesAddonContainer');
        _self.winlinesAddonContainer = nge.findOne('^winlinesAddon');

        _createAddon();

        if (_cfg.routeframesUnderSymbols) {
            var SMcon = nge.findOne('^' + _smCfg.parentName);
            SMcon.add(_parent);
            _parent.x -= SMcon.x;
            _parent.y -= SMcon.y;
        }

        if (!_subscribed)
            _subscribe();
    };
});



