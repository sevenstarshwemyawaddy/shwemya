    });
});




nge.App[nge.appNS].Tpl.Groups = {};



nge.App[nge.appNS].Tpl.Groups.BetSettings = function () {
    var _imagePath = nge.appPath + 'img/';
    var _styles = {
        '.sliderMinMax': {
            style: {
                font: '29pt futuraptmedium',
                fill: '#eee0bf'
            }
        },
        '.settingName': {
            style: {
                font: '39pt futuraptmedium',
                fill: '#fec36d'
            }
        },
        '.betContainerName': {
            style: {
                font: '37pt futuraptheavy',
                fill: '#fec36d'
            }
        },
        '.betContainerValue': {
            style: {
                font: '37pt futuraptheavy',
                fill: '#ffffff'
            }
        },
        '.sliderValue': {
            style: {
                font: '28pt futuraptmedium',
                fill: '#efc273'
            }
        },
        '.sliderTooltipValue': {
            style: {
                font: '28pt futuraptmedium',
                fill: '#000000'
            }
        }
    };

    return {
        styles: _styles,
        "assets": {
            "name": "assets",
            "contents": [
