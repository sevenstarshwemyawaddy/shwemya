            ]
        }
    };
};



nge.App[nge.appNS].Com.Autospin.View = nge.Com.Base.extend(function() {
    var AUTO_CLOSE_TIME = 3000;

    // INIT ASSET NAMES FOR PANEL ELEMENTS DRAWING
    this.panelButtonAssetKey = 'autospinAmountSetterButton';
    this.panelSeparatorAssetKey = 'autospinAmountSetterSeparator';

    // PANEL OFFSETS
    this.firstPanelElementTopYOffset = 1;
    this.yPanelOffset = 20;
    this.yPanelElementsOffset = 20;

    this.infinityTextYOffset = -10;

    var _self = this;
    var _buttonModel;
    var _separatorModel;
    var _autospinAmounts;

    var _panelAnimationInProgress = false;
    var _autospinAmountsPanelElements;
    var _autospinAmountAnimationDuration;
    var _panelAnimationState;
    var _autoInProgress = false;
    var _panel;
    var _container;
    var _autospinCounter;
    var _autoCloseTimer;
    var _amountButtons;
    var _autospinButton;

    var _panelAnimationType = {
        open: 1,
        close: -1
    };

    this.panelIsOpened = function() {
        return _panelAnimationState === _panelAnimationType.open;
    };

    this.autospinAmountOpen = function(isEnable){
        var amount = nge.localData.get('autospinAmount');
        if(!isEnable || amount > 0)
            return;
        if(_panelAnimationState === _panelAnimationType.close && !_autoInProgress)
            _self.autospinPressHandler(_panelAnimationType.open);
    };

    this.finishAutospins = function() {
        _self.hideAutospinText();
        if (_autospinButton && _checkAutospinButton()) {
            _autospinButton.setFrames(2, 1, 4);
            if (_autospinButton._onOriginal) {
                _autospinButton._onOriginal = {
                    _onOverFrame: 2,
                    _onOutFrame: 1,
                    _onDownFrame: 4,
                    _onUpFrame: 4
                };
            }
        }
    };

    this.autospinTryStartHandler = function(amount) {
        var val = _checkInfinity(amount);
        _setAutospinButtonText(val);
        if(!nge.localData.get('autospin'))
            _self.hideAutospinText();  
    };

    this.spinStartHandler = function(amount) {
        var val = _checkInfinity(amount);
        _setAutospinButtonText(val);
    };

    this.autospinAmountClose = function() {
        if(_panelAnimationState === _panelAnimationType.open)
            _self.autospinPressHandler(_panelAnimationType.close);
    };

    this.updateAutospinButtonAmount = function(amount) {
        _setAutospinButtonFrames();
        var val = _checkInfinity(amount);
        _setAutospinButtonText(val);
    };

    this.pickAmountItem = function(amount) {
        _self.autospinAmountClose();
        _self.updateAutospinButtonAmount(amount);
    };

    this.autospinPressHandler = function(type) {
        if(_panelAnimationInProgress)
            return;

        _panelAnimationState = type;

        var from = {
            y: _panel.y,
            scaleY: _panel.mask.scale.y
        };
        
        var to = {
            y: from.y - (_panel.height * type),
            scaleY: type > 0 ? 1 : 0.04
        };

        var checkElVisibility = function(element) {
            if(type < 0 && element.y > to.y)
                element.visible = false;
            else if(type > 0 && element.y < 900)
                element.visible = true;
        };

        var moveElements = function() {
            _autospinAmountsPanelElements.all.forEach(function(element, index) {
                element.y = _panel.y + _autospinAmountsPanelElements[index].yOffset;
                checkElVisibility(element);
            });
        };

        _container.visible = true;
        var tween = nge.tween.add(from).to(to, _autospinAmountAnimationDuration);
        tween.frameBased = true;

        var yPanelOffset = + (type > 0 ? _self.yPanelOffset : -_self.yPanelOffset);
        
        tween.onUpdateCallback(function (context, time, tweenData) {
            var y = tweenData.percent * (tweenData.vStart.y - tweenData.vEnd.y);
            _panel.y = tweenData.vStart.y - y + (yPanelOffset * tweenData.percent);
            var scale = tweenData.percent * (tweenData.vStart.scaleY - tweenData.vEnd.scaleY);
            _panel.mask.scale.y = (tweenData.vStart.scaleY - scale);
            moveElements();
        });

        tween.onComplete.add(function() {
            _panel.mask.scale.y = to.scaleY;
            _panel.y = to.y + yPanelOffset;
            _self.controller.inputEnabled = type > 0;
            moveElements();
            nge.observer.fire('autospinPanel.animation.end');
            _panelAnimationInProgress = false;
            if(_panelAnimationState === _panelAnimationType.close)
                _container.visible = false;
        });
        
        tween.onStart.add(function() {
            nge.observer.fire('autospinPanel.animation.start');
        });
        _panelAnimationInProgress = true;
        tween.start();
    };

    this.drawElementToPanel = function(panel, index, val) {
        var value = val;

        var buttonData = {
            group: nge.objects.create(new nge.Mlm.Objects.Folder()),
            button: null,
            text: null,
            x: panel.width / 2,
            y: (((index+ 1) * _buttonModel.height) +
                         (_separatorModel.height * index) - (index * 1) + 
                         _self.firstPanelElementTopYOffset)
        };
        panel.addChild(buttonData.group);

        var generateText = function(buttonData) {
            var style = 'menuElementBase';
            
            if (value === 'Infinity') {
                value = '∞';
                style = 'menuElementInfinity';
            }

            var model = {
                type: mt.objects.TEXT,
                'text': '_',
                'x': buttonData.x,
                'y': buttonData.y + (style === 'menuElementInfinity' ? (_self.infinityTextYOffset) : 0)
            };
            
            var text = nge.objects.create(model);
            text.addClass(style);
            text.style.strokeThickness = +text.style.strokeThickness;
            text.text = value;
            
            buttonData.text = text;
            buttonData.group.addChild(text);
        };

        var generateButton = function(buttonData) {
            var btnModel = nge.Lib.Helper.jsObjClone(_buttonModel.getData());
            btnModel.x = buttonData.x;
            btnModel.y = buttonData.y;
            btnModel.anchorX = 0.5;
            btnModel.anchorY = 0.5;
        
            var button = nge.objects.create(btnModel);
            button.inputEnabled = true;
            button.events.onInputUp.add(_self.controller.onElementWasClicked(value));
            
            buttonData.button = button;
            buttonData.group.addChild(button);

            button.onInputOver.add(function(){
                var style = mt.data.styles['.menuElementOver'].style;
                buttonData.text.fill = style.fill;
                buttonData.text.stroke = style.stroke || '#000';
                buttonData.text.strokeThickness = style.strokeThickness || 0;
            });
            
            button.onInputOut.add(function(){
                var baseClass = buttonData.text.getData().class;
                var style = mt.data.styles['.' + baseClass].style;
                buttonData.text.fill = style.fill;
                buttonData.text.stroke = style.stroke || '#000';
                buttonData.text.strokeThickness = style.strokeThickness || 0;
            });

            button.scale.set(1);
        };
        
        var generateSeparator = function(){
            var separatorModel = nge.Lib.Helper.jsObjClone(_separatorModel.getData());
            separatorModel.anchorX = 0.5;
            separatorModel.x = panel.width/2;
            separatorModel.y = (((index + 1) * _buttonModel.height) + 
                                (_separatorModel.height * index) + 
                                ((_buttonModel.height / 2)) - ((index * 1) + 1) + 
                                _self.firstPanelElementTopYOffset);
            
            var separator = nge.objects.create(separatorModel, panel);
            separator.scale.set(1 / nge.assets.getQualityFactor(), 1 / nge.assets.getQualityFactor());
        };
     
        generateButton(buttonData);
        generateText(buttonData);
        _amountButtons.push(buttonData.button);

        if(index >= (_autospinAmounts.length - 1)) 
            return;
        generateSeparator();
    };

    this.hideAutospinText = function() {
        _autospinCounter.visible = false;
    };

    function _checkAutospinButton() {
        if (_autospinButton && _autospinButton.input &&
            _autospinButton.input._pointerData && _autospinButton.input._pointerData.length > 0) {
            return true;
        }
    }

    function _setAutospinButtonFrames() {
        if (_autospinButton && _checkAutospinButton()) {
            _autospinButton.setFrames(6, 5, 4);
            if (_autospinButton._onOriginal) {
                _autospinButton._onOriginal = {
                    _onOverFrame: 6,
                    _onOutFrame: 5,
                    _onDownFrame: 4,
                    _onUpFrame: 5
                };
            }
        }
    }

    function _setElementToStartPos(element, index, elementStartYPosition, panelFinalYPosition) {
        _autospinAmountsPanelElements[index] = {};
        _autospinAmountsPanelElements[index].yOffset = element.y - panelFinalYPosition;
        
        element.y = elementStartYPosition + (element.height / 2); 
        element.visible = false;
    }
    
    function _setAutospinButtonText(val) {
        _autospinCounter.text = val;
        _autospinCounter.visible = true;
    }

    function _generatePanelMask(panel) {

        var mask = nge.objects.create(new nge.Mlm.Objects.Mask({rects: [[0, 0, panel.width, panel.height - 6]]}));
        mask.scale.set(1, 0.04);
        panel.addChild(mask);
        panel.mask = mask; 
        
        _panelAnimationState = _panelAnimationType.close;
    }

    function _drawElementsToPanel(panel) {
        _amountButtons = [];
        _autospinAmounts.forEach(function(el, index){
            _self.drawElementToPanel(panel, index, el);
        });
        _buttonModel.visible = false;
        _separatorModel.visible = false;
        _buttonModel.destroy();
        _separatorModel.destroy();
    }

    function _setElementsToStartPos(panel) {
        _autospinAmountsPanelElements.all = _container.children.slice(1);
        var elementStartYPosition = panel.y;
        var panelFinalYPosition = elementStartYPosition;
        _autospinAmountsPanelElements.all.forEach(function(element, index){
            _setElementToStartPos(element, index, elementStartYPosition, panelFinalYPosition);
        });
    }

    function _checkInfinity(val) {
        if(val === 'Infinity') {
            _autospinCounter.removeClass('autoButtonAmountTextBase');
            _autospinCounter.addClass('autoButtonAmountTextInfinity');
            return '∞';
        }
        _autospinCounter.removeClass('autoButtonAmountTextInfinity');
        _autospinCounter.addClass('autoButtonAmountTextBase');
        return val;
    }

    // -  Automatic closing -

    function _onInputOver() {
        // console.log('%cSTOP TIMER', 'background:red;color:white;');
        nge.rafClearTimeout(_autoCloseTimer);
    }

    function _onInputOut() {
        // console.log('%cSTART TIMER', 'background:red;color:yellow;');
        _autoCloseTimer = nge.rafSetTimeout(function() {
            _self.autospinAmountClose();
        }, AUTO_CLOSE_TIME);
    }

    function _checkButton(button, callback) {
        if (_autospinButton === button)
            return callback();
        for (var i in _amountButtons)
            if (_amountButtons[i] === button)
                return callback();
    }

    this.onButtonHover = function(button) {
        _checkButton(button, _onInputOver);
    };

    this.onButtonUnhover = function(button) {
        _checkButton(button, _onInputOut);
    };

    this.create = function(controller) {
        console.log('[AUTOSPIN] view.create');
        _self.controller = controller;

        _autospinAmounts = controller.autospinAmounts;
        _autospinAmountAnimationDuration = controller.autospinAmountAnimationDuration;

        // TODO: JSCLIENT-5469. Присвоить autoPlayAmountPanelContainer уникальное имя
        _container = nge.findOne('^autospinAmountSetterPanel').parent;
        _container.visible = false;
        _autospinCounter = nge.findOne('^autoPlayAmountButtonText');
        _autospinButton = nge.findOne('^autoButtonButton');
        _autospinAmountsPanelElements = {};

        _buttonModel = nge.findOne('^' + _self.panelButtonAssetKey);
        _separatorModel= nge.findOne('^' + _self.panelSeparatorAssetKey);
        _panel = nge.findOne('^autospinAmountSetterPanel');
        if (!_panel)
            console.error('autospinAmountSetterPanel not found. Check psdAliases');
      
        _drawElementsToPanel(_panel);
        _setElementsToStartPos(_panel);   
        _generatePanelMask(_panel);

        _container.pivot.x =_container.width * 0.55;

        _autoCloseTimer = null;
    };
});



nge.App[nge.appNS].Com.Autospin.Mobile = {};



nge.App[nge.appNS].Com.Autospin.Mobile.Controller = nge.App[nge.appNS].Com.Autospin.Controller.extend(function() {
    this.useAmountSetter = false;
});



nge.App[nge.appNS].Com.AutospinSimple = {};



nge.App[nge.appNS].Com.AutospinSimple.Mobile = {};



nge.App[nge.appNS].Com.AutospinSimple.Mobile.Controller = nge.App.ClassicGameBase.Com.AutospinSimple.Controller.extend(function () {

    var _created;

    this.create = function () {
        this.super.create();
        
        if (!_created) 
            this.subscribe();
            
        _created = true;

        return true;
    };

    var _balanceResponseHandler = function(){
        this.setTakingFinished(true);
    }.bind(this);
    
    this.subscribe = function () {
        nge.observer.add('balance.amount', _balanceResponseHandler);
    };
});



nge.App[nge.appNS].Com.Balance = {};



nge.App[nge.appNS].Com.Balance.UI_v3 = {};



nge.App[nge.appNS].Com.Balance.UI_v3.Controller = nge.App.ClassicGameBase.Com.Balance.UI_v3.Controller.extend(function () {
    let _created = false;
    let _canUpdateBalance = true; 

    this._updateText = this.super._drawText;

    this._drawText = data => {
        if(_canUpdateBalance)
            this.super._drawText(data);
    };

    this.create = () => {
        this.super.create();
   
        if(!_created)
            this.customSubscribe();

        this.updateText();
        _created = true;
    };

    this.updateText = () => {
        const { balance } = nge.localData.get();
        this._updateText(balance);
    };

    this.balanceRequest = () => {
        _canUpdateBalance = false;
    };

    this.spinRequest = () => {
        _canUpdateBalance = true;
    };

    this.customSubscribe = () => {
        nge.observer.add('balance.update', this.updateText);
        nge.observer.add('balanceRequest', this.balanceRequest);
        nge.observer.add('slotMachine.spinRequest', this.spinRequest);
    };
});



nge.App[nge.appNS].Com.Balance.UI_v3.Blue = {};



