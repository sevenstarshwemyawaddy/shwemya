nge.App[nge.appNS].Com.Info = {};



nge.App[nge.appNS].Com.Info.Controller = nge.Com.Base.extend(function () {

    var _created = false;
    var _self = this;
    this.service = null;

    // creating new component
    this.create = function (){

        _checkComponentLayer();

        var isPages = _self.service.checkPages();

        if (!isPages)
            return false;

        if(!_created)
            _self.subscribe();

        _created = true;
    };

    this.next = function(){
        _self.service.showNextPage();
    };

    this.previous = function(){
        _self.service.showPreviousPage();
    };

    this.resetPages = function(layer){
        if(!layer || layer.indexOf('info') === -1)
            return;
        
        _self.service.resetPages(layer);
    };

    // subscriber
    this.subscribe = function(){
        nge.observer.add('info.next', _self.next);
        nge.observer.add('info.previous', _self.previous);
        nge.observer.add('layersSwitcher.show', _self.resetPages);
    };

    // init component layers
    var _checkComponentLayer = function(){
        if(!_self.service){
            _self.service = _self.getInstance('Service');
        }
    };

});



nge.App[nge.appNS].Com.Info.Service = Class.extend(function () {

    this.view = null;

    var _self = this;

    var _curPageNum;
    var _helpPagesArray;
    var _paginationSpritesArray;

    this.checkPages = function(){
        _checkInstances();

        _helpPagesArray = _initHelpPages();
        _paginationSpritesArray = _initPagination();

        if(_helpPagesArray.length === 0 || _paginationSpritesArray.length === 0)
            return false;

        _self.resetPages();

        return true;
    };

    this.showNextPage = function () {
        _self.showPageByNum(++_curPageNum);
    };

    this.showPreviousPage = function () {
        _self.showPageByNum(--_curPageNum);
    };

    this.showPageByNum = function(n){
        _curPageNum = _validatePage(n);

        _hideAllPages();

        _showPageByNum(_curPageNum);
        _showPaginationByNum(_curPageNum);
        nge.observer.fire('info.page.change', _curPageNum);
    };

    var _checkInstances = function () {
        if(_self.view)
            return false;
        _self.view = _self.getInstance('View');
    };

    var _hideAllPages = function () {
        _helpPagesArray.forEach(function (page) {
            _self.view.switchElementVisibility(page, false);
        });
        _paginationSpritesArray.forEach(function (element) {
            _self.view.switchElementFrame(element, 0);
        });
    };

    var _initHelpPages = function () {
        var pagesContainer = nge.findOne('^pagesInfoContainer');

        if(!pagesContainer)
            return [];

        return pagesContainer.children.reverse();
    };

    var _initPagination = function () {
        var pagesPaginationContainer = nge.findOne('^paginationInfoContainer');

        if(!pagesPaginationContainer)
            return [];

        return pagesPaginationContainer.children.reverse();
    };

    this.resetPages = function () {
        _curPageNum = 0;
        _self.showPageByNum(_curPageNum);
    };

    var _showPaginationByNum = function (pageNum) {
        var activeElement = _paginationSpritesArray[pageNum];
        _self.view.switchElementFrame(activeElement, 1);
    };

    var _showPageByNum = function (pageNum) {
        var page = _helpPagesArray[pageNum];
        _self.view.switchElementVisibility(page, true);
    };

    var _validatePage = function (curPageNum) {
        var max = _helpPagesArray.length - 1;
        if (curPageNum > max)
            curPageNum = 0;
        else if (curPageNum < 0)
            curPageNum = max;
        return curPageNum;
    };
});



nge.App[nge.appNS].Com.Info.View = Class.extend(function () {

    this.switchElementVisibility = function (element, isVisible) {
        element.visible = isVisible;
    };
    this.switchElementFrame = function (element, frame) {
        element.frame = frame;
        if(element.buttonMode || element.inputEnabled)
            element.setFrames(frame, frame, frame, frame);
    };

});



nge.App[nge.appNS].Com.InfoPanel = {};



nge.App[nge.appNS].Com.InfoPanel.Controller = nge.Com.Base.extend(function () {
    var _self;
    var _created;
    var _textUp;
    var _textDown;
    var _textUpColors;
    var _textDownColors;

    var _defaultParams = {
        x: false,
        anchorX: false
    };

    var _tweenDuration = 150;
    var _tweenWidthMaxFactor = 1.3;
    var _lastShowCall = {up: false, down: false};
    var _tweens = {up: false, down: false};

    this.defaultColor = '#ffffff';
    this.defaultColorStroke = 'rgba(255, 255, 255, 1)';
    this.defaultStrokeThickness = 0;

    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        _self = this;
        this.createDefault();

        _textUp = nge.findOne('.infoPanelTextUp');
        _textDown = nge.findOne('.infoPanelTextDown');

        // new ui (v3) fix
        if(!_textDown || !_textUp)
            return false;

        for (var k in _defaultParams) {
            _defaultParams[k] = _textUp[k];
        }

        if (!_created)
            _subscribe();

        _created = true;
        return true;
    };

    var _resetStyles = function (textData) {
        var obj = (textData.position === "down") ? _textDown : _textUp;
        obj.clearColors();
        obj.strokeThickness = _self.defaultStrokeThickness;
    };

    var _resetObjDefaults = function (obj) {
        for (var k in _defaultParams) {
            obj[k] = _defaultParams[k];
        }
    };

    this.show = function (data) {
        var textData = _self.getInstance('Model', false, data);

        _resetStyles(textData);

        var obj;
        var position = (textData.position === 'down') ? 'down' : 'up';

        if (position === 'down') {
            obj = _textDown;
            _textDownColors = textData.colors;
        } else {
            obj = _textUp;
            _textUpColors = textData.colors;
        }

        var prevWidth = obj.width;

        obj.attr('style.font', textData.font);
        obj.text = textData.text;

        if (textData.colors) {
            var textDataColorsArrLen = textData.colors.length;
            for (var k = 0; k < textDataColorsArrLen; k++) {
                var colorCfg = textData.colors[k];
                obj.addColor(colorCfg.color, colorCfg.from);
            }
            //fix phaser bug with addColor() and cut the text
            obj.text += ' ';
        }

        if (textData.stroke) {
            var textDataStrokesArrLen = textData.stroke.length;
            for (var i = 0; i < textDataStrokesArrLen; i++) {
                var strokeCfg = textData.stroke[i];
                obj.addStrokeColor(strokeCfg.color, strokeCfg.from);
            }
        }

        //tween jerk prevention
        var tweenNeed = false;

        if (textData.text.length > 0) {
            var time = nge.Lib.Time.get();

            tweenNeed = ((time < _lastShowCall[position] + _tweenDuration) &&
                1 / _tweenWidthMaxFactor <= Math.abs(prevWidth / obj.width) &&
                Math.abs(prevWidth / obj.width) <= _tweenWidthMaxFactor
                );

            _lastShowCall[position] = time;

            if (tweenNeed) {
                _stopTween(position);

                if (obj.anchor.x !== 0) {
                    obj.anchor.x = 0;
                    obj.x = _defaultParams.x - prevWidth / 2;
                }

                _tweens[position] = nge.tween.add(obj).to(
                    {x: _defaultParams.x - obj.width / 2},
                    _tweenDuration
                    );

                _tweens[position].onComplete.addOnce(function () {
                    _tweens[position] = null;
                });

                _tweens[position].start();
            }
        }

        if (!tweenNeed) {
            _stopTween(position);
            _resetObjDefaults(obj);
        }
    };

    var _stopTween = function (position) {
        if (_tweens[position]) {
            _tweens[position].stop();
            _tweens[position] = null;
        }
    };

    var _subscribe = function () {
        nge.observer.add('infoPanel.showText', _self.show);
    };
});



nge.App[nge.appNS].Com.InfoPanel.Model = function (param) {
