if(window.Phaser && window.Phaser.Signal)
    nge.Lib.Signal = window.Phaser.Signal;
else
    nge.Lib.Signal = class Signal {
        constructor() {
            this.listeners = [];
        }
        addOnce(cb, context, priority, args) {
            this.listeners.push({
                callback: cb.bind(context || this),
                context: context || this,
                priority: priority || 0,
                args: args || args,
                once: true
            });
            this.listeners.sort(function(a, b) {
                return a.priority > b.priority;
            });
        }
        add(cb, context, priority, ...args) {
            this.listeners.push({
                callback: cb.bind(context || this),
                context: context || this,
                priority: priority || 0,
                args: args || args,
                once: false
            });
            this.listeners.sort(function(a, b) {
                return a.priority > b.priority;
            });
        }
        dispatch(...args) {
            this.listeners.forEach(listener => {
                if(listener.once) {
                    if(listener.fired)
                        return;
                    listener.fired = true;
                }
                listener.callback(...args.concat(listener.args));
            });
            _.remove(this.listeners, function(listener) {
                return listener.once && listener.fired;
            });
        }
        remove(cb) {
            const index = this.listeners.findIndex(function(element) {
                return element.callback === cb;
            });
            if(index >= 0)
                this.listeners.splice(index, 1);
        }
        clear() {
            this.listeners = [];
        }
        removeAll() {
            this.listeners = [];
        }
        dispose() {
            this.clear();
        }
    };



nge.Lib.Time = {
    get: function (foo) {
        if (!foo)
            foo = new Date;
        var unixtime_ms = foo.getTime();
        return unixtime_ms;
    },
    getUnixtime: function (foo) {
        if (!foo)
            foo = new Date;
        var unixtime_ms = foo.getTime();
        var unixtime = ~~(unixtime_ms / 1e3);
        return unixtime;
    },
    HHMMSS: function () {
        var d = new Date();
        return  d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds() +
            '|' + d.getMilliseconds();
    },
    /**
     * Форматирование времени
     *
     * @param {Number} num
     * @param {Boolean} toArray
     * @returns {String}
     */
    secToHHMMSS: function (num, toArray) {
        var sec_num = ~~num;
        var hours = ~~(sec_num / 3600);
        var minutes = ~~((sec_num - hours * 3600) / 60);
        var seconds = sec_num - hours * 3600 - minutes * 60;
        if (hours < 10) {
            hours = "0" + hours;
        }
        if (minutes < 10) {
            minutes = "0" + minutes;
        }
        if (seconds < 10) {
            seconds = "0" + seconds;
        }
        if (toArray)
            return{H: hours, M: minutes, S: seconds};
        var time = hours + ":" + minutes + ":" + seconds;
        return time;
    },
    /**
     * Форматирование даты
     *
     * @param {Date} date
     * @param {Boolean} toArray
     * @returns {String}
     */
    dateToDDMMYYYYHHMMSS: function (date, toArray) {
        var day = date.getDate() < 10 ? "0" + date.getDate() : date.getDate();
        var month = date.getMonth() + 1 < 10 ? "0" + (date.getMonth() + 1) : date.getMonth() + 1;
        var year = date.getFullYear();
        var h = date.getHours() < 10 ? "0" + date.getHours() : date.getHours();
        var m = date.getMinutes() < 10 ? "0" + date.getMinutes() : date.getMinutes();
        var s = date.getSeconds() < 10 ? "0" + date.getSeconds() : date.getSeconds();
        if (toArray)
            return{d: day, m: month, y: year, H: h, M: m, S: s};
        return day + "." + month + "." + year + " " + h + ":" + m + ":" + s;
    },
    /**
     * Форматирование даты
     *
     * @param {Date} unixtime
     * @param {String} d delimiter
     * @returns {String}
     */
    unixtimeToDDMMYYYY: function (unixtime, d) {
        if (!d)
            d = ".";

        var date = new Date(unixtime * 1000);

        var day = date.getDate() < 10 ? "0" + date.getDate() : date.getDate();
        var month = date.getMonth() + 1 < 10 ? "0" + (date.getMonth() + 1) : date.getMonth() + 1;
        var year = date.getFullYear();
        return day + d + month + d + year;
    },
    getDeltaT: function (lastCallMS) {
        if (lastCallMS)
            return this.get() - lastCallMS;

        return false;
    }
};



/**
 *
 * @param {type} config
 * @returns {nge.Lib.Timeline}
 *
 * usage example:

 var tl = new nge.Lib.Timeline(
 {
        duration: 1000,
        // timePoints need to be sorted by 'time'
        timePoints: [
            {time: 200, callback: function(){log('200 msec pass')}},
            {time: 600, callback: function(){log('600 msec pass')}}
        ],
        onComplete: function(){log('done')}
    }
 );

 tl.start()

 */

nge.Lib.Timeline = function (config) {
    var _defaultConfig = {
        duration: 1000,
        // timePoints need to be sorted by 'time'
        timePoints: [], //{time: 200, callback: function}
        onComplete: null
    };

    config = nge.Lib.Helper.mergeObjs(_defaultConfig, config);

    var _dt;
    var _lastPointIndex = 0;
    var _totalTimePoints = config.timePoints.length;
    var _currentTimePoint;

    var _tween = nge.tween.add({x: 0});
    _tween.to({
        x: config.duration //x: 1
    }, config.duration);

    function _checkTimePoints(dt) {
        for (_lastPointIndex; _lastPointIndex < _totalTimePoints; _lastPointIndex++) {
            _currentTimePoint = config.timePoints[_lastPointIndex];
            if (_currentTimePoint.time <= dt) {
                _currentTimePoint.callback();
            } else {
                break;
            }
        }
    }

    _tween.onStart.add(function () {
        _checkTimePoints(0);
    });

    _tween.onUpdateCallback(function (context, time, tweenData) {
        _dt = tweenData.dt;
        _checkTimePoints(_dt);
    }).onComplete.add(function () {
        _checkTimePoints(config.duration);
        if (config.onComplete) {
            config.onComplete();
        }
    });

    this.start = function () {
        _lastPointIndex = 0;
        _tween.start();
    };

    return this;
};



nge.Lib.TweenTools = {
    spritesAnimation: nge.Mlm.TweenManager.Controller.spritesAnimation
};



nge.Lib.Tween = {
    Easing: nge.Mlm.TweenManager.Tween.Easing
};



nge.Lib.Tweens = function () {
    var _tweens = {};
    var _subscibed = false;
    var _curTime = 0;
    var _tweenIndex = 0;
    var _self = this;

    this.globalTimeScale = 1;
    this.tweens = _tweens;

    this.add = function (object) {
        _chkSubscribe();

        _tweenIndex++;
        var key = _curTime + '_' + _tweenIndex;

        var tween = {
            id: key,
            isRunning: false,
            target: object,
            to: _to,
            start: _start,
            pause: _pause,
            resume: _resume,
            stop: _stop,
            points: [],

            _timeScale: 1,
            get timeScale() {
                return this._timeScale;
            }, set timeScale(a) {
                if (this._timeScale === a || !this.points[0])
                    return this._timeScale;

                var timeDiff = ~~(_curTime - this.points[0].timeStart) * (_self.globalTimeScale * this._timeScale);

                if (this.points[0].duration - timeDiff <= 0)
                    return this._timeScale;

                this.points[0].duration -= timeDiff;
                this.points[0].timeStart = _curTime;

                //update current point data
                for (var k in this.points[0].propsTo)
                    this.points[0].propsFrom[k] = this.target[k];

                this._timeScale = a;

                return this._timeScale;
            },

            _started: false,
            _paused: false,
            _pauseTime: false,
            _timeBonus: 0,
            _complete: false,
            _functions: {
                onStart: [],
                onUpdate: [],
                onComplete: []
            }
        };

        //need to add some functions
        tween.onComplete = {
            addOnce: function (f) {
                tween._functions.onComplete.push(f);
            }
        };

        tween.onStart = {
            addOnce: function (f) {
                tween._functions.onStart.push(f);
            }
        };

        tween.onUpdateCallback = function (f) {
            tween._functions.onUpdate.push(f);
        };

        _tweens[key] = tween;

        return tween;
    };

    var _chkSubscribe = function () {
        if (_subscibed)
            return true;

        _subscibed = true;
        _subscibe();
        _update();
    };

    var _to = function (propsTo, duration, easing, autostart, startDelay) {
        var propsFrom = {};

        for (var k in propsTo)
            propsFrom[k] = this.target[k];

        if (!startDelay)
            startDelay = 0;

        this.points.push({propsTo: propsTo, duration: duration, easing: easing, propsFrom: propsFrom, timeStart: _curTime + startDelay, startDelay: startDelay});
        this._complete = false;

        if (autostart)
            this.start();
    };

    var _start = function () {
        this._started = true;
        this.isRunning = true;

        for (var i = 0; i < this._functions.onStart.length; i++)
            this._functions.onStart[i]();

        if (this._timeBonus > 0)
            _calcStep(this, true);
    };

    var _pause = function () {
        this._paused = true;
        this.isRunning = false;
        this._pauseTime = _curTime;
    };

    var _resume = function () {
        if (this.points && this.points[0])
            this.points[0].timeStart += (_curTime - this._pauseTime);

        this._paused = false;
        this.isRunning = true;
        this._pauseTime = 0;
    };

    var _stop = function () {
        this._complete = true;
        this.isRunning = false;
        delete _tweens[this.id];
    };

    var _update = function () {
        var curTime = nge.Lib.Time.get();

        //global pause ?
        if (nge.game.paused) {
            var delta = curTime - _curTime;

            for (var k in _tweens)
                if (_tweens[k].points && _tweens[k].points[0])
                    _tweens[k].points[0].timeStart += delta;

            return true;
        }

        _curTime = curTime;

        for (var k in _tweens)
            if (_tweens[k]._complete)
                delete _tweens[k];
            else if (_tweens[k]._started && !_tweens[k]._paused)
                _calcStep(_tweens[k]);

        return true;
    };

    var _calcStep = function (tween, onStartCall) {
        var point = tween.points[0];  // {propsTo: propsTo, duration: duration, easing: easing, propsFrom: propsFrom, timeStart: _curTime}

        if (_curTime < point.timeStart)
            return false;

        var progress = _applyDelta(tween, point, onStartCall);

        for (var i = 0; i < tween._functions.onUpdate.length; i++)
            tween._functions.onUpdate[i](tween, progress);

        //complete
        if (progress === 1) {
            tween.points.shift();

            if (tween.points.length === 0) {
                //no points
                tween._complete = true;
                tween.isRunning = false;
                var onComplete = tween._functions.onComplete;
                tween._functions.onStart = [];
                tween._functions.onUpdate = [];
                tween._functions.onComplete = [];

                for (var i = 0; i < onComplete.length; i++)
                    onComplete[i]();
            } else {
                var startDelay = _curTime + tween.points[0].startDelay;

                //calc step for new point
                tween.points[0].timeStart = _curTime + startDelay;

                //update start data
                for (var k in tween.points[0].propsTo)
                    tween.points[0].propsFrom[k] = tween.target[k];

                if (startDelay)
                    nge.setTimeout(function () {
                        _calcStep(tween);
                    }, startDelay);
                else
                    _calcStep(tween);
            }
        }
    };

    var _applyDelta = function (tween, point, onStartCall) {
        if (tween._timeBonus > 0) {
            point.timeStart -= tween._timeBonus;
            tween._timeBonus = 0;
        }

        var time = _curTime;
        var progress = (time - point.timeStart) * tween.timeScale * _self.globalTimeScale / point.duration;  // 0-1

        //cannot finish tween onstart in one tick (callbacks magic)
        if (progress >= 1 && onStartCall)
            progress = 0.99;

        if (progress > 1) {
            progress = 1;

            tween._timeBonus = ~~((time - point.timeStart) - point.duration / (tween.timeScale * _self.globalTimeScale));
        }

        //apply objects props
        for (var k in point.propsTo)
            tween.target[k] = point.propsFrom[k] + (point.propsTo[k] - point.propsFrom[k]) * progress;

        return progress;
    };

    var _subscibe = function () {
        nge.observer.add(
            'StatesManager.update.start',
            _update,
            false,
            true
            );
    };
};



nge.Lib.Uploader = function () {

    this.beforeSubmit = function () {
        //check whether client browser fully supports all File API
        if (window.File && window.FileReader && window.FileList && window.Blob)
        {
            var fsize = $('#FileInput')[0].files[0].size; //get file size
            var ftype = $('#FileInput')[0].files[0].type; // get file type
            //allow file types
            switch (ftype)
            {
                case 'image/png':
                case 'image/gif':
                case 'image/jpeg':
                case 'image/pjpeg':
                case 'text/plain':
                case 'text/html':
                case 'application/x-zip-compressed':
                case 'application/pdf':
                case 'application/msword':
                case 'application/vnd.ms-excel':
                case 'video/mp4':
                    break;
                default:
                    $("#output").html("<b>" + ftype + "</b> Unsupported file type!");
                    return false;
            }

            //Allowed file size is less than 5 MB (1048576 = 1 mb)
            if (fsize > 5242880)
            {
                alert("<b>" + fsize + "</b> Too big file! <br />File is too big, it should be less than 5 MB.");
                return false;
            }
        }
        else
        {
            //Error for older unsupported browsers that doesn't support HTML5 File API
            alert("Please upgrade your browser, because your current browser lacks some new features we need!");
            return false;
        }
    };

    this.OnProgress = function (event, position, total, percentComplete)
    {
        //Progress bar
        $('#progressbox').show();
        $('#progressbar').width(percentComplete + '%'); //update progressbar percent complete
        $('#statustxt').html(percentComplete + '%'); //update status text
        if (percentComplete > 50)
        {
            $('#statustxt').css('color', '#000'); //change status text to white after 50%
        }
    };
};



nge.Lib.Validator = {
    float: function (val, castFlag) {
        var need = parseFloat(val);
        if (castFlag)
            return need;
        return (val === need);
    },
    floatMoney: function (val, castFlag) {
        var need = parseFloat(val).toFixed(2);
        var arr = [];
        var t = 0;
        for (var i = need.length - 1; i >= 0; i--) {
            if (i === need.length - 3) {
                arr.push(',');
                continue;
            }
            if (i < need.length - 4) {
                t++;
                if (t % 3 === 0) {
                    arr.push('.');
                }
            }
            arr.push(need[i]);
        }
        if (castFlag)
            return arr.reverse().join('');
        return (val === need);
    },
    convertToFloat: function (val) {
        return this.floatMoney(val, true);
    },
    moneyWithPeriod: function (val) {
        var result;
        if (val.length === 0)
            result = "000";
        if (val.length === 1)
            result = "00" + val;
        if (val.length === 2)
            result = "0" + val;
        if (val.length > 2)
            result = val;
        return result.substring(0, result.length - 2) + "." +
                result.substring(result.length - 2, result.length);
    }
};



