nge.Com.WinInfo = {};



nge.Com.WinInfo.Controller = nge.Com.Base.extend(function() {
    var _created;
    var _self;

    this.preload = function() {
        this.preloadDefault();
    };

    this.create = function() {
        _self = this;
        this.createDefault();
        if (!_created) {
            _subscribe();
        }
        _created = true;
        return true;
    };

    this.customSubscribe = function() {
        return true;
    };

    var _subscribe = function() {
        nge.observer.add('win', _winHandler);
        nge.observer.add('loose', _winHandler);
        _self.customSubscribe();
        return true;
    };

    var _winHandler = function(data) {
        var winText = nge.find('^winInfoWinAmountValue');
        if (winText) {
            winText.text = nge.localData.get('currency') +
                nge.Lib.Validator.convertToFloat(data.winAmount);
        }
        var winMultiplier = nge.find('^winInfoWinFactorValue');
        if (winMultiplier) {
            winMultiplier.text = nge.Lib.Validator.convertToFloat(
                data.winMultiplier
            );
        }
    };

});



