/* global nge */

/**
 * Created by s.kleimenov 06.12.2018
 */

nge.App[nge.appNS].Com.Winlines.CachedMarkers.ControllerExtension = function () {
    var _rafId;
    var _cfg;
    var _lines = {};

    this.create = function () {
        this.super.create();
        _cfg = this.getInstance('CfgMode').get();

        _lines[_cfg.leftMarkers.containerName] = {
            container: null,
            sprite: null,
            x: _cfg.leftMarkers.x,
            y: _cfg.leftMarkers.y
        };
        
        _lines[_cfg.rightMarkers.containerName] = {
            container: null,
            sprite: null,
            x: _cfg.rightMarkers.x,
            y: _cfg.rightMarkers.y
        };
        _generateLineMarkers();
    };

    var _generateLinesPart = function(linesPartName){
        if(!_lines[linesPartName].container)
            _lines[linesPartName].container = nge.findOne('^'.concat(linesPartName));

        if(!_lines[linesPartName].container){
            console.warn('Check lineMarkers container name');
            return false;
        }

        if(_lines[linesPartName].sprite){
            _lines[linesPartName].sprite.visible = false;
            _lines[linesPartName].sprite.destroy();
            _lines[linesPartName].sprite = null;
        }

        var container = _lines[linesPartName].container;
        container.visible = true;

        var texture = container.generateTexture();
        _lines[linesPartName].sprite = nge.game.add.sprite(_lines[linesPartName].x, _lines[linesPartName].y, texture);
        var key = nge.localData.get('lines.value') + '';
        _lines[linesPartName].sprite.y += _offsets[key] || 0;
        container.parent.addChild(_lines[linesPartName].sprite);

        container.visible = false;
    };

    var _generateLineMarkers = function () {
        Object.getOwnPropertyNames(_lines).forEach(_generateLinesPart);
        _rafId = null;
    };

    var _linesSet = function () {
        if (_rafId)
            nge.rafClearTimeout(_rafId);
        _rafId = nge.rafSetTimeout(_generateLineMarkers, 1);
    };

    this.customSubscribe = function () {
        this.super.customSubscribe();
        nge.observer.add('lines.set', _linesSet);
    };
};




