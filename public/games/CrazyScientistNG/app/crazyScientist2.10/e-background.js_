        this.data = {
            state: nge.Lib.Helper.recursiveGet('data.state', options, false),
            totalBonusWin: nge.Lib.Helper.recursiveGet('data.totalBonusWin', options, false),

            freeSpinRemain: nge.Lib.Helper.recursiveGet('data.freeSpinRemain', options, false),
            freeSpinsTotal: nge.Lib.Helper.recursiveGet('data.freeSpinsTotal', options, false)
        };

        var spinResults = nge.Mlm.Transport.Helper.parseSpinResults(nge.Lib.Helper.recursiveGet('data', options, false));
        for (var key in spinResults)
            this.data[key] = spinResults[key];

        var params = nge.Lib.Helper.recursiveGet('data.params', options, false);
        if (params)
            this.data.params = params;

        var expandingSymbol = nge.Lib.Helper.recursiveGet('data.expandingSymbol', options, false);
        if (expandingSymbol)
            this.data.expandingSymbol = expandingSymbol;

        var reSpinRemain = nge.Lib.Helper.recursiveGet('data.reSpinRemain', options, false);
        if (reSpinRemain)
            this.data.reSpinRemain = reSpinRemain;

        var reSpinTotal = nge.Lib.Helper.recursiveGet('data.reSpinTotal', options, false);
        if (reSpinTotal)
            this.data.reSpinTotal = reSpinTotal;

        if(this.data.freeSpinRemain === '0') {
            this.data.gameParameters = nge.Mlm.Transport.Helper.parseBonusEnd(options);
        }

        var dataSlotWin = nge.Lib.Helper.recursiveGet('data.slotWin', options, false);
        var slotWin = nge.Mlm.Transport.Helper.parseSlotWin(dataSlotWin);
        if (slotWin)
