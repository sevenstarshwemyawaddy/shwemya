/**
 * @author r.rakhman
 * @date   12.10.2017
 */
nge.App[nge.appNS].Com.InnerJackpot.Controller = nge.Com.Base.extend(function () {
    var _self = this;
    var _created;
    var _cfg;

    var _jackpotPopup;
    var _jackpotPopupText;
    var _jackpotPopupImg;

    var _jackpotValues = [];
    var _jackpotPopupLightTween;
    var _payouts;
    var _jackpotPlayareaValues = [];
    var _creditsJackpotPlayareaValues = [];
    var _lastSpinStartStake;
    var _lastSpinStartStakeCredits;
    var _lastSpinStartCV;
    var _localStakeChanged = false;

    this.currencyColor = '#00BFFF';

    this.create = function () {
        this.super.create();
        if (!_created)
            _subscribe();

        _cfg = this.getInstance('CfgMode').get();

        _jackpotPopupLightTween = null;
        _jackpotPopup = nge.findOne('^innerJackpotackpotPopup');
        _jackpotPopupText = nge.findOne('^innerJackpotPopupText');
        _jackpotPopupImg = nge.findOne('^innerJackpotPopupImg');

        var slotMachineGameContainer = nge.findOne('^slotMachineGameContainer');
        var slotMachineJackpotValues = nge.findAll('.slotMachineJackpotValue');
        var i;
        for (i = 0; i < slotMachineJackpotValues.length; i++)
            slotMachineGameContainer.add(slotMachineJackpotValues[i]);

        var gambleContainer = nge.findOne('^gambleScreen');
        var gambleJackpotValues = nge.findAll('.gambleJackpotValue');
        for (i = 0; i < gambleJackpotValues.length; i++)
            gambleContainer.add(gambleJackpotValues[i]);

        _jackpotValues = [];
        _cfg.selectors.forEach(function (jInfo) {
            var els = nge.findAll(jInfo.selector);
            if (els) {
                els.forEach(function (el) {
                    _jackpotValues.push({ element: el, symbol: jInfo.symbol });
                });
            }
        });

        _jackpotPlayareaValues = nge.findAll('.jackpotPlayareaValue');
        _creditsJackpotPlayareaValues = nge.findAll('.creditsJackpotPlayareaValue');

        _rememberStake();
        _payouts = _calcPayouts(nge.localData.get('payout.cfg'));
        _drawJackpots();

        _created = true;
        return _created;
    };

    var _jackpotShow = function () {
        _jackpotPopup.visible = true;

        var totalWin = nge.localData.get('slotMachine.slotWin.totalWin');
        var totalWinCoins = nge.Lib.Money.toCoins(totalWin);

        nge.observer.fire('infoPanel.showText', {
            text: 'WIN ' + totalWinCoins,
            position: 'up',
            colors: [{ color: '#ff8600', from: 4 }]
        });

        _jackpotPopupText.text = totalWinCoins;
        _jackpotPopupImg.alpha = 0;
        _jackpotPopupLightTween = nge.game.add.tween(_jackpotPopupImg).
            to({ alpha: 1 }, 700, Phaser.Easing.Linear.None, true, 0, -1, true);
    };

    var _jackpotHide = function () {
        _jackpotPopup.visible = false;
        if (_jackpotPopupLightTween)
            _jackpotPopupLightTween.stop();
    };

    var _calcPayouts = function (payout) {
        var convertedPayout = {};
        var totalPayouts = 0;
        var payoutArrLen = payout.length;

        outer:
        for (var i = 0; i < payoutArrLen; i++) {
            var symbols = payout[i].symbols;
            var coins = payout[i].payout;
            var matchCount = payout[i].matchCount;
            var symbolQty = 0;
            var payoutName = symbols[0];

            if (coins === 0 || symbols.length !== 20)
                continue;

            if (matchCount > 0) { // then we get "any symbol" payout
                payoutName = 'any_' + symbols.join('_');
                symbolQty = matchCount;
            } else {
                var symbolsArrLen = symbols.length;
                for (var j = 0; j < symbolsArrLen; j++) {
                    if (payoutName !== symbols[j])
                        continue outer;

                    symbolQty++;
                }
            }

            if (!convertedPayout[payoutName]) {
                totalPayouts++;
                convertedPayout[payoutName] = { name: symbolQty, value: coins };
            }
        }

        if (totalPayouts < 7)
            return null;

        return convertedPayout;
    };

    var _decorateThousands = function (number, delimiter) {
        if (!number)
            return false;

        if (!delimiter)
            delimiter = ' ';

        var parts = number.toString().split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, delimiter);
        return parts.join('.');
    };

    var _drawJackpots = function () {
        if (!_payouts)
            return;

        var l = nge.localData.get('lines.value');
        var b = nge.localData.get('bet.value');
        var cv = nge.localData.get('coins.value');
        var stakeCoinsMult = _localStakeChanged ? l * b * cv / _lastSpinStartStake : 1;
        var stakeCoinsMultCredits = _localStakeChanged ? l * b / _lastSpinStartStakeCredits : 1;

        if (_jackpotValues) {
            _jackpotValues.forEach(function (item) {
                item.element.text = Math.round(_payouts[item.symbol].value / _lastSpinStartCV * stakeCoinsMultCredits).toString();
            });
        }

        var currency = nge.localData.get('balance.currency') || '';
        _jackpotPlayareaValues.forEach(function (obj) {
            var text = _decorateThousands((_payouts['0'].value * stakeCoinsMult).toFixed(2));
            obj.text = text + ' ' + currency;
            obj.clearColors();
            obj.addColor(_self.currencyColor, text.length);
            obj.maxSizeResize('width', 240);
        });

        _creditsJackpotPlayareaValues.forEach(function (obj) {
            obj.text = _decorateThousands(Math.round(_payouts['0'].value / _lastSpinStartCV * stakeCoinsMultCredits));
            obj.maxSizeResize('width', 240);
        });
    };

    var _payoutsUpdateResponse = function (responce) {
        if (responce && responce.data && responce.data.payouts)
            _payouts = _calcPayouts(responce.data.payouts);

        _drawJackpots();
    };

    var _pressHandler = function (name) {
        var redrawJackpots = name.indexOf('hold') !== -1 ||
            name.indexOf('linePlusMobile') !== -1 ||
            name.indexOf('lineMinusMobile') !== -1 ||
            name.indexOf('linesChanger') !== -1;

        if (redrawJackpots)
            nge.rafSetTimeout(_drawJackpots, 200);
    };

    var _rememberStake = function () {
        _localStakeChanged = false;
        var l = nge.localData.get('lines.value');
        var b = nge.localData.get('bet.value');
        var cv = nge.localData.get('coins.value');
        _lastSpinStartCV = cv;
        _lastSpinStartStake = l * b * cv;
        _lastSpinStartStakeCredits = l * b;
    };

    var _onBetChange = function () {
        _localStakeChanged = true;
        _drawJackpots();
    };

    var _subscribe = function () {
        nge.observer.add('innerJackpot.show', _jackpotShow);
        nge.observer.add('slotMachine.spinStart', _jackpotHide);
        nge.observer.add('slotMachine.spinStart', _rememberStake);
        nge.observer.add('gamble.take', _jackpotHide);
        nge.observer.add('gamble.go', _jackpotHide);
        nge.observer.add('bet.change', _onBetChange);
        nge.observer.add('lines.change', _onBetChange);
        nge.observer.add('coins.change', _onBetChange);
        nge.observer.add('buttons.pressCommand', _pressHandler);
        nge.observer.add('transportMessage.PayoutsUpdateResponse', _payoutsUpdateResponse);
    };
});



/**
 * @author r.rakhman
 * @date   16.10.2017
 */

nge.App[nge.appNS].Com.InnerJackpot.Tpl = function () {
    var _imagePath = nge.appPath + 'img/playarea/';
    return {
        styles: {
            '.jackpotPopupYellow': {
                style: {
                    'font': '40pt "arial_bold"',
                    'fill': '#FFFF00',
                    'align': 'center',
                    'stroke': '#222222',
                    'strokeThickness': 6
                }
            }
        },
        assets: {
            contents: [
                {key: 'jackpot_0', fullPath: _imagePath + 'jackpot_0.png'},
                {key: 'jackpot_1', fullPath: _imagePath + 'jackpot_1.png'}
            ]
        },
        objects: {
            contents: [
                {
                    type: 1,
                    isVisible: false,
                    name: 'innerJackpotPopup',
                    contents: [
                        {type: 2, x: 960 + 10, y: 450 + 180, anchorX: 0.5, anchorY: 0.5, class: 'jackpotPopupYellow', name: 'innerJackpotPopupText'},
                        {type: 0, x: 960, y: 450, anchorX: 0.5, anchorY: 0.5, assetKey: 'jackpot_1', name: 'innerJackpotPopupImg'},
                        {type: 0, x: 960, y: 450, anchorX: 0.5, anchorY: 0.5, assetKey: 'jackpot_0'}
                    ]
                }
            ]
        }
    };
};



