nge.App[nge.appNS].Tpl.Groups.ScrollbarVertical = function (imagesPath) {
    var _scroll = nge.Tpl.Groups.ScrollbarVertical(imagesPath);

    if(!imagesPath)
        imagesPath = nge.appPath + 'img/';

    return {
        'assets': {
            'name': 'assets',
            'contents': [
                {
                    type: mt.objects.IMAGE,
                    'fullPath': imagesPath + 'scrollbar/scroll_bg.png',
                    'key': 'img/scrollbar/scroll_bg.png'
                },
                {
                    type: mt.objects.IMAGE,
                    'fullPath': imagesPath + 'scrollbar/scroll_touch.png',
                    'key': 'img/scrollbar/scroll_touch.png'
                }
            ]
        },
        'objects': {
            'name': 'objects',
            'contents': _scroll.objects.contents
        }
    };
};



