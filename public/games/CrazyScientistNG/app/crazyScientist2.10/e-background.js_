                {'key': 'bgUp', 'fullPath': _imagePathOfferList + 'bg_up.png'},
                {'key': 'line', 'fullPath': _imagePathOfferList + 'line.png'},
                {'key': 'btnGreenOfferStatistic', 'width': 1280, 'height': 96, 'frameWidth': 320, 'fullPath': _imagePathOfferStatistic + 'green_button_atlas.png'},
                {'key': 'rectangleBox2', 'fullPath': _imagePathOfferStatistic + 'rectangle.png'},
                {'key': 'btnRedOfferCancel', 'width': 992, 'height': 96, 'frameWidth': 248, 'fullPath': _imagePathOfferCancel + 'red_button_atlas.png'},
                {'key': 'btnGreenOfferCancel', 'width': 992, 'height': 96, 'frameWidth': 248, 'fullPath': _imagePathOfferCancel + 'small_green_atlas.png'}
