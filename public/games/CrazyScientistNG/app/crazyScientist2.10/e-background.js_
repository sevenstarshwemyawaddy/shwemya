nge.App[nge.appNS].Mlm.Brain.Mobile = {};




nge.App[nge.appNS].Mlm.Brain.Mobile.Buttons = nge.App.RiverGameBase.Mlm.Brain.Mobile.Buttons.extend(function () {

    var _customButton01Enabled;
    var _customButton02Enabled;

    let _cache = {};
    let _getObjFromCache = name => {
        if(!_cache[name])
            _cache[name] = nge.findOne(`^${name}`);

        return _cache[name];
    };

    var _determineCustomBtn02 = function(){
        if(typeof customButtons !== 'undefined')
            _customButton02Enabled = !!customButtons.customBtn02;
    };

    var _determineCustomBtn01 = function () {
        if(typeof customButtons !== 'undefined')
            _customButton01Enabled = !!customButtons.customBtn01;
    };

    let _restoreBonusGameState = function(){
        _determineCustomBtn01();
        _determineCustomBtn02();

        let spinStateAvail = false;
        let otherAvail = false;
        let visible = false;

        const restoredState = nge.localData.get('slotMachine.lastResponse.state');

        if(restoredState === 'FreeSpins')
            spinStateAvail = true;

        if(!restoredState && nge.localData.get('slotMachine.state') === 'FreeSpins')
            spinStateAvail = true;
        

        if((!restoredState && nge.localData.get('slotMachine.state') === 'Ready') || (!restoredState && !nge.localData.get('slotMachine.state'))){
            visible = true;
            spinStateAvail = true;
            otherAvail = true;
        }
    
        const config = {
            infoMobile: {
                callback: function(){
                    nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageOneHeaderContainer', container: 'pageOneContainer'});
                    nge.observer.fire('paytable.show');
                },
                enabled: true,
                visible: true
        
            },
            mobileBackToGameButton: {
                callback: function(){
                    nge.observer.fire('paytable.hide');
                },
                enabled: true,
                visible: true
        
            },
            pageOneTrigger: {
                callback: function(){
                    nge.observer.fire('denom_change.play');
                    nge.observer.fire('paytable.updatePayout');
                    nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageOneHeaderContainer', container: 'pageOneContainer'}, 1);
                },
                enabled: true,
                visible: true
        
            },
            pageTwoTrigger: {
                callback: function(){
                    nge.observer.fire('denom_change.play');
                    nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageTwoHeaderContainer', container: 'pageTwoContainer'}, 1);
                },
                enabled: true,
                visible: true
        
            },
            quickSettingsPanel: {
                callback: function(){
                    nge.observer.fire('denom_change.play');
                    nge.observer.fire('quickSettings.panelSwitch');
                },
                enabled: true,
                visible: true
            },
            coinMinusMobile: {
                enabled: otherAvail
            },
            coinPlusMobile: {
                enabled: otherAvail        
            },
            betSettingButtonMobile: {
                enabled: otherAvail
            },
            stopMobile: {
                visible: false
            },
            spinMobile: {
                visible: spinStateAvail
            },
            autoSpinMobile: {
                visible: visible
            }
        };

        if(_customButton01Enabled)
            config.customBtn01 = {
                visible: visible
            };

        if(_customButton02Enabled)
            config.customBtn02 = {
                visible: visible
            };

        nge.observer.fire('buttons.changeData', config);
    };

    this.onRestoreExtension = function(){
        this.super.onRestoreExtension();

        // if(nge.localData.get('slotMachine.lastResponse'))
        _restoreBonusGameState();

    };

    this._buttonsCreateEndHandler = () => {
        this._cofigureDroneButtons();
        this._cofigureFlaskButtons();
    };

    this._cofigureDroneButtons = () => {
        const config = {};

        for (let i = 1; i < 7; i++) {
            const callback = () => {
                this._changeDroneButtonsEnableStatusTo(false);
           
                nge.observer.fire('pickupBonusGame.sendRequest', i); 
            };
            const name = 'dron' + i;
            config[name] = { callback };         
        }

        nge.observer.fire('buttons.changeData', config);
    };

    this._cofigureFlaskButtons = () => {
        const config = {};

        for (let i = 1; i < 7; i++) {
            const callback = () =>{
                this._changeLaternButtonsEnableStatusTo(false);
                nge.observer.fire('pickupBonusGame.sendRequest', i); 
            };
            const name = 'pg10' + i;
            config[name] = { callback };         
        }

        nge.observer.fire('buttons.changeData', config);
    };

    this._changeDroneButtonsEnableStatusTo = (isEnable) => {
        const config = {};
        for (let i = 1; i < 7; i++) {
            const name = 'dron' + i;
            config[name] = { enabled: isEnable };   
            
            const obj =_getObjFromCache(name + 'Container');
            obj && obj.children[0] && obj.children[0].scale.set(1 / nge.assets.getQualityFactor());
        }

        config.settingsMobile = {
            enabled: isEnable
        };

        config.infoMobile = {
            enabled: isEnable
        };
        
        nge.observer.fire('buttons.changeData', config);
    };

    this._changeLaternButtonsEnableStatusTo = (isEnable) => {
        const config = {};

        for (let i = 1; i < 7; i++) {
            const name = 'pg10' + i;
            config[name] = { enabled: isEnable };
            
            const obj =_getObjFromCache(name + 'Container');
            obj && obj.children[0] && obj.children[0].scale.set(1 / nge.assets.getQualityFactor());
        }

        config.settingsMobile = {
            enabled: isEnable
        };

        config.infoMobile = {
            enabled: isEnable
        };
        
        nge.observer.fire('buttons.changeData', config);

        nge.observer.fire('buttons.changeData', config);
    };

    var _onFreespinContinueHandler = function () {
        nge.observer.fire('freespin.press.spinButton');
    };

    this._pickupBonusGameStart = () => {
        this.changeButtonState('autoSpinMobile', undefined, undefined, false, false);
    };

    this._disableLaternButtonsHandler = () => this._changeLaternButtonsEnableStatusTo(false);
    this._enableLaternButtonsHandler = () => this._changeLaternButtonsEnableStatusTo(true);

    this._disableDroneButtonsHandler = () => this._changeDroneButtonsEnableStatusTo(false);
    this._enableDroneButtonsHandler = () => this._changeDroneButtonsEnableStatusTo(true);

    this._pickupBonusGameStartHandler = () => this._pickupBonusGameStart();

    this._buttonsPressCommandHandler = (btnName) => {
        const noPressSoundBtns = [
            'soundMobile',
            'autoSpinMobile',
            'stopMobile',
            'spinMobile'
        ];

        if(noPressSoundBtns.indexOf(btnName) === -1)
            nge.observer.fire('sound.pressButton');

    };

    let _onPaytableHide = function(){
        nge.rafSetTimeout(_restoreBonusGameState, 1);
    };

    this.subscribe = function(){
        this.super.subscribe();
        nge.observer.add('buttons.freespinContinue', _onFreespinContinueHandler, false, true);        
        nge.observer.add('buttons.pressCommand', this._buttonsPressCommandHandler, false, true);
        nge.observer.add('pickupBonusGame.start', this._pickupBonusGameStartHandler, false, true);
        nge.observer.add('buttons.latern.disable', this._disableLaternButtonsHandler, false, true);
        nge.observer.add('buttons.latern.enable', this._enableLaternButtonsHandler, false, true);
        nge.observer.add('buttons.drone.disable', this._disableDroneButtonsHandler, false, true);
        nge.observer.add('buttons.drone.enable', this._enableDroneButtonsHandler, false, true);
        nge.observer.add('buttons.create.end', this._buttonsCreateEndHandler, false, true);
        nge.observer.add('paytable.hide', _onPaytableHide, false, true);
    
    };
});



