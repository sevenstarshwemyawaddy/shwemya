nge.App[nge.appNS].Com.Balance.Mobile = {};



nge.App[nge.appNS].Com.Balance.Mobile.Controller = nge.App.ClassicGameBase.Com.Balance.Mobile.Controller.extend(function () {
    let _created = false;
