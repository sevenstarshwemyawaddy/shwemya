nge.App[nge.appNS].Com.BonusWheel.Controller = nge.Com.Base.extend(function() {
    var _self = this;
    var _created = false;
    var _cfg;
    var _wheels = [];
    var _lastBonusItem;

    var _initPopup = function (initData) {
        var parent = initData.parentContainerSelector ? nge.findOne(initData.parentContainerSelector) : null;
        var common = initData.commonContainerSelector ? nge.findOne(initData.commonContainerSelector) : null;
        var unique = initData.uniqueContainerSelector ? nge.findOne(initData.uniqueContainerSelector) : null;
        nge.observer.add('bonusWheel.popup.' + initData.popupName + '.show', function (data) {
            if (initData.layer)
                nge.observer.fire('layersSwitcher.show', initData.layer);

            if (parent) {
                parent.visible = true;
                for (var i = 0; i < parent.children.length; i++)
                    parent.children[i].visible = false;
            }

            if (common)
                common.visible = true;
            unique.visible = true;

            if (data.dynamicElements)
                for (var i = 0; i < data.dynamicElements.length; i++) {
                    var elem = data.dynamicElements[i];
                    var obj = nge.findOne(elem.selector);
                    if (elem.type === 'text')
                        obj.text = elem.value;
                    else if (elem.type === 'sprite')
                        obj.loadTexture(elem.value);
                }

            nge.observer.add('buttons.pressCommand', function (name) {
                if (name !== initData.buttonName)
                    return;
                nge.observer.remove('buttons.pressCommand', false, 'buttons.pressCommand.' + initData.buttonName);
                if (data.buttonCallback)
                    data.buttonCallback();
                nge.observer.fire('bonusWheel.popup.' + initData.buttonName + '.buttonPressed');
            }, 'buttons.pressCommand.' + initData.buttonName);
        });
    };

    var _initPopups = function () {
        for (var i = 0; i < _cfg.popups.length; i++)
            _initPopup(_cfg.popups[i]);
    };

    var _initWheels = function () {
        _wheels = [];
        _cfg.wheels.forEach(function (wheelData) {
            var wheel = nge.findOne(wheelData.containerSelector);
            _wheels.push(wheel);
            var center = nge.findOne(wheelData.centerSelector);
            var offset = {x: center.x - wheel.x, y: center.y - wheel.y};
            wheel.x = center.x;
            wheel.y = center.y;
            for (var i = 0; i < wheel.children.length - 1; i++) {
                wheel.children[i].x -= offset.x;
                wheel.children[i].y -= offset.y;
            }
        });
    };

    this.create = function () {
        _cfg = this.getInstance('Cfg');

        _initWheels();
        _initPopups();

        if (!_created) {
            this.subscribe();
        }
        _created = true;
        return _created;
    };

    this.correctFinalPosition = function (sectorAngle) {
        return sectorAngle * ((Math.random() * 0.9) + 0.05);
    };
/*
    var _lastdt = 1;
    var _lastReelAngleOld = 0;
    var _lastReelAngleNew = 0;

    this.update = function (dt) {
        if (!_wheels[0])
            return;

        _lastdt = dt.deltaT;
        _lastReelAngleOld = _lastReelAngleNew;
        _lastReelAngleNew = _wheels[0].angle;
    };

    var _getWheelSpeed = function () {
        return (_lastReelAngleNew - _lastReelAngleOld) / _lastdt * 1000;
    };*/

    var _bonusWheelSpinStart = function (index) {
        _lastBonusItem = null;

        var LOOP = 360;
        var _sectorsCount = _cfg['wheel' + (index + 1) + 'Sectors'].length;
        var _sectorAngle = LOOP / _sectorsCount;

        var _currentLoop = _cfg.minLoops;
        var _tween = nge.tween.add(_wheels[index]);

        _tween.to({angle: _wheels[index].angle + _cfg.speedUpAngle}, 1500, nge.Lib.Tween.Easing.Back.In, false);
        _tween.onComplete.addOnce(function() {
            _tween = nge.tween.add(_wheels[index]).to({angle: _wheels[index].angle + LOOP}, _cfg.loopTime, nge.Lib.Tween.Easing.Linear.None, false);
            _tween.loop(true);
            _tween.onLoop.add(function() {
                if(--_currentLoop > 0 || !_lastBonusItem)
                    return;
                _tween.stop();
                _wheels[index].angle %= LOOP;
                var _currentAngle = _wheels[index].angle;
                var _targetSector = parseInt(_lastBonusItem.value, 10);
                var _targetAngle = _targetSector * _sectorAngle + _cfg.wheels[index].pointerAngle + _self.correctFinalPosition(_sectorAngle);
                var _stopAngle = _targetAngle - _cfg.slowDownAngle;

                if(_stopAngle < _currentAngle) {
                    _stopAngle += LOOP;
                    _targetAngle += LOOP;
                }

                var _stopDiffAngle = _stopAngle - _currentAngle;
                var _stoptime = _cfg.loopTime * (_stopDiffAngle / LOOP);

                _tween = nge.tween.add(_wheels[index]).to({angle: _stopAngle}, _stoptime, nge.Lib.Tween.Easing.Linear.None, false);
                _tween.onComplete.addOnce(function() {
                    //nge.Lib.Console.color('--- 1', '#ff5', '#33a');
                    //console.log('Full speed: ' + _getWheelSpeed());
                    //_tween = nge.tween.add(_wheels[index]).to({angle: _targetAngle - 120}, 2000, function (k) {
                    //  return Math.pow(k, 0.75);
                    //}, false);

                    //nge.rafSetTimeout(function () {
                    //    nge.rafSetTimeout(function () {
                    //        console.log('Start speed: ' + _getWheelSpeed());
                    //    }, 1);
                    //}, 1);

                    //_tween.onComplete.addOnce(function() {
                        //nge.Lib.Console.color('--- 2', '#ff5', '#33a');
                        //console.log('Finish speed: ' + _getWheelSpeed());

                        _tween = nge.tween.add(_wheels[index]).to({angle: _targetAngle}, 6000, nge.Lib.Tween.Easing.Back.Out, false);
                        //nge.rafSetTimeout(function () {
                        //    nge.rafSetTimeout(function () {
                        //        console.log('New speed: ' + _getWheelSpeed());
                        //    }, 1);
                        //}, 1);
                        _tween.onComplete.addOnce(function() {
                            nge.observer.fire('bonusWheel.stopped', _cfg['wheel' + (index + 1) + 'Sectors'][_targetSector], 1000);
                        }, this);
                        _tween.start();
                    //}, this);
                    //_tween.start();
                }, this);
                _tween.start();
            }, this);
            _tween.start();
        }, this);
        _tween.start();
    };

    var _bonusWheel1SpinStart = function () {
        _bonusWheelSpinStart(0);
    };

    var _bonusWheel2SpinStart = function () {
        _bonusWheelSpinStart(1);
    };

    var _onResponse = function (data) {
        _lastBonusItem = data.bonusItem;
    };

    this.subscribe = function () {
        nge.observer.add('bonusWheel.1.spinStart', _bonusWheel1SpinStart);
        nge.observer.add('bonusWheel.2.spinStart', _bonusWheel2SpinStart);
        nge.observer.add('bonusWheel.actionResponse', _onResponse);
    };
});



