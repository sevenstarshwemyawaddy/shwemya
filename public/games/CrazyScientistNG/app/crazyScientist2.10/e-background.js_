        'wordWrap': (param.hasOwnProperty('wordWrap')) ? param.wordWrap : true,
        'isVisible': (param.hasOwnProperty('isVisible')) ? param.isVisible : true,
        'maxWidth': (param.hasOwnProperty('maxWidth')) ? param.maxWidth : false,
        'maxHeight': (param.hasOwnProperty('maxHeight')) ? param.maxHeight : false,
        'append': (param.hasOwnProperty('append')) ? param.append : true,
        'text': (param.hasOwnProperty('text')) ? nge.i18n.get(param.text) : ' ',
        'gradient': (param.hasOwnProperty('gradient')) ? param.gradient : false, // can be [[0, '#8ED6FF'],[0.65, '#ccc'],[1, '#004CB3']]. First param will be number (0-1) as a persents of text height
        'custom': (param.hasOwnProperty('custom')) ? param.custom : {},
        'blendMode': (param.hasOwnProperty('blendMode')) ? param.blendMode : PIXI.BLEND_MODES.NORMAL,
        //system
        _classes: (param.hasOwnProperty('_classes')) ? param._classes : [],
        _originalModel: (param.hasOwnProperty('_originalModel')) ? param._originalModel : (param) ? nge.Lib.Helper.jsObjClone(param) : null,
        _parentClasses: (param.hasOwnProperty('_parentClasses')) ? param._parentClasses : [],
        _styles: (param.hasOwnProperty('_styles')) ? param._styles : {}
    };

    var _getFontComponents = function (font) {
        var styleFontArr = font.split(' ');
        var sfaLen = styleFontArr.length;

        var res = {};

        res.fontFamily = styleFontArr[sfaLen - 1];
        res.fontSize = styleFontArr[sfaLen - 2];

        if (sfaLen > 2)
            res.fontWeight = styleFontArr[sfaLen - 3];

        if (sfaLen > 3)
            res.fontStyle = styleFontArr[sfaLen - 4];

        return res;
    };

    if ((param.hasOwnProperty('style') && param['style'] && param.style.hasOwnProperty('font'))) {
        var fParams = _getFontComponents(param['style']['font']);
        nge.Lib.Helper.mergeObjs(result['style'], fParams, result['style']);
    }

    var _chkUnsubscribe = function () {
        //if object inactual
        if (_object && !_object.game)
            result._unsubscribe();
    };

    var fontContains = function (s, fontSizeType) {
        return s.indexOf(fontSizeType) !== -1;
    };

    var _refresh = function () {
        _chkUnsubscribe();

        if (!nge.device.android)
            return;

        var scaleFactor = nge.game.scale.isFullScreen ? 1 : nge.wrap.states.world.scale.x;
        var _data = _object.getData();
        var _shadowOffsetX = 0;
        var _shadowOffsetY = 0;
        for (var i in _data._styles) {
            var _style = _data._styles[i].style;
            if (!_style)
                continue;
            if (_style.shadowOffsetX)
                _shadowOffsetX = _style.shadowOffsetX;
            if (_style.shadowOffsetY)
                _shadowOffsetY = _style.shadowOffsetY;
        }

        _object.resolution = scaleFactor;
        _object.shadowOffsetX = _shadowOffsetX * scaleFactor;
        _object.shadowOffsetY = _shadowOffsetY * scaleFactor;
    };

    var _handleFont = function (action, value) {
        switch (action) {
            case 'set':
                var fParams = _getFontComponents(value);
                for (var k in fParams)
                    _object.attr('style.' + k, fParams[k]);
                break;
            case 'get':
            default:
                return _object.style.fontWeight + ' ' + _object.style.fontSize + ' ' + _object.style.fontFamily;
                break;
        }
    };

    result._subscribe = function () {
        nge.observer.add('window.resize', _refresh, 'object.text.' + _id, true);
    };

    result._unsubscribe = function () {
        nge.observer.remove('window.resize', false, 'object.text.' + _id, true);
    };

    result._customAutoCheckMaxSize = function (sizeType) {
        var sp = (sizeType === 'height') ? _object._sizeParams.height : _object._sizeParams.width;

        var reactive = nge.Lib.Helper.makeReactive(
            _object.canvas,
            sp.sn,
            function (a) {
                var max = _object.getData()[sp.max];

                _object.maxSizeResize(sp.sn, max);
            }
        );

        if (!reactive) { //fucking old mobile ios (< 10.0)
            var curSize = 0;

            var rafChecker = function () {
                if (!_object.game) {
                    return false; //dead objects
                }

                nge.rafSetTimeout(rafChecker, 1000);

                if (curSize === _object[sp.sn])
                    return true;

                var max = _object.getData()[sp.max];
                _object.maxSizeResize(sp.sn, max);
                curSize = _object[sp.sn];
                return true;
            };

            nge.rafSetTimeout(rafChecker, 1000); // first call will be after first RAF
        }
    };

    //prototype functions
    result._protoF = {
        _init: function (object) {
            _object = object;
        },
        handleFont: _handleFont,
        validate: function () {
            var chkFontFamily = function (fontFamily) {
                var fontAvaliable = nge.Lib.Helper.isFontAvailable(fontFamily);

                if (!fontAvaliable)
                    console.error('no fontFamily ', fontFamily);
            };

            var fontFamily;

            //check text styles
            if (_object.style.fontFamily) {
                fontFamily = _object.style.fontFamily;
                chkFontFamily(fontFamily);
            }

            if (_object.lineSpacing)
                console.warn('Text validation error. Do not use lineSpacing, it doesent work in v2. Use lineHeight.', _object);
        },
        addColor: function (color, position)
        {
            if (!_object.colors)
                _object.colors = [];

            _object.colors[position] = color;
            _object.dirty = true;
            _object.updateText();
        }
    };

    return result;
};



nge.Mlm.Objects.UnityEmitter = function (param) {
    if (!param)
        param = {};

    return {
        'id': (param.hasOwnProperty('id')) ? param.id : false,
        'name': (param.hasOwnProperty('name')) ? param.name : false,
        'class': (param.hasOwnProperty('class')) ? param.class : false,
        'scaleX': (param.hasOwnProperty('scaleX')) ? param.scaleX : 1,
        'scaleY': (param.hasOwnProperty('scaleY')) ? param.scaleY : 1,
        'alignX': (param.hasOwnProperty('alignX')) ? param.alignX : 'left',
        'alignY': (param.hasOwnProperty('alignY')) ? param.alignY : 'top',
        'angle': (param.hasOwnProperty('angle')) ? param.angle : 0,
        'alpha': (param.hasOwnProperty('alpha')) ? param.alpha : 1,
        'isVisible': (param.hasOwnProperty('isVisible')) ? param.isVisible : true,
        'x': (param.hasOwnProperty('x')) ? param.x : 0,
        'y': (param.hasOwnProperty('y')) ? param.y : 0,
        'z': (param.hasOwnProperty('z')) ? param.z : 0,
        'type': mt.objects.UNITY_EMITTER,
        'assetKey': (param.hasOwnProperty('assetKey')) ? param.assetKey : false,
        //system
        _originalModel: (param.hasOwnProperty('_originalModel')) ? param._originalModel : (param) ? nge.Lib.Helper.jsObjClone(param) : null
    };
};



nge.Mlm.ObjectsEditor = {};



nge.Mlm.ObjectsEditor.Controller = function () {
    var _service;
    var _panelIsset;

    this.init = function () {
        if (!_service) {
            _service = new nge.Mlm.ObjectsEditor.Service();
            _service.init();
            _subscribe();
        }
    };

    this.display = function () {
        _panelIsset ? this.close() : this.open();
        return true;
    };

    this.open = function () {
        _panelIsset = true;
        nge.observer.fire('objectsEditor.open');
        return _service.open();
    };

    this.close = function () {
        _panelIsset = false;
        nge.observer.fire('objectsEditor.close');
        return _service.close();
    };

    this.assetsNewFolder = function () {
        return _service.assetsNewFolder();
    };

    this.assetsDeleteSelected = function () {
        return _service.assetsDeleteSelected();
    };

    this.assetsExportSelected = function () {
        return _service.assetsExportSelected();
    };

    this.assetsAddObject = function () {
        return _service.assetsAddObject();
    };

    this.assetsAddBtn = function () {
        return _service.assetsAddBtn();
    };

    this.objectsAddText = function () {
        return _service.objectsAddText();
    };

    this.objectsNewFolder = function () {
        return _service.objectsNewFolder();
    };

    this.objectsDeleteSelected = function () {
        return _service.objectsDeleteSelected();
    };

    this.objectsExportSelected = function () {
        return _service.objectsExportSelected();
    };

    this.resolutionsExport = function () {
        return _service.resolutionsExport();
    };

    this.resolutionAdd = function () {
        return _service.resolutionAdd();
    };

    this.resolutionsDeleteSelected = function () {
        return _service.resolutionsDeleteSelected();
    };

    this.resolutionSelect = function () {
        return _service.resolutionSelect();
    };

    this.applyResolution = function (name) {
        return _service.applyResolution(name);
    };

    this.setResolution = function (name) {
        return _service.setResolution(name);
    };

    /**
     * model Row Edit
     * @param {nge.Mlm.ObjectsEditor.Model} model
     * @returns {Boolean}
     */
    this.edit = function (model) {
        return _service.edit(model);
    };

    this.update = function () {
        return _update();
    };

    this.modelAddRow = function () {
        return _service.modelAddRow();
    };

    var _update = function () {
        if (_panelIsset)
            _service.update();
        return true;
    };

    var _subscribe = function () {
        nge.observer.add(
                'StatesManager.create.end',
                _update,
                false,
                true
                );
        return true;
    };

};



nge.Mlm.ObjectsEditor.Model = function (options) {
    return {
        type: options && options.type || 'object',
        name: options && options.name || false,
        key: options && options.key || false,
        value: options && options.value || false,
        worldOnlyFlag: options && options.worldOnlyFlag || false //just for object type
    };
};



nge.Mlm.ObjectsEditor.Service = function () {
    var _view;
    var _viewAssets;
    var _viewObjects;
    var _viewResolutions;
    var _viewModels;
    var _activeResolution = 'main'; // main/... mixed 

    this.init = function () {
        _view = new nge.Mlm.ObjectsEditor.View();
        _viewAssets = new nge.Mlm.ObjectsEditor.ViewAssets();
        _viewObjects = new nge.Mlm.ObjectsEditor.ViewObjects();
        _viewModels = new nge.Mlm.ObjectsEditor.ViewModels();
        _viewResolutions = new nge.Mlm.ObjectsEditor.viewResolutions();
    };

    this.open = function () {
        if ($('.objectsEditor').length > 0) {
            $('.objectsEditor').show();
            _viewResolutions.resolutionSelect(nge.resolutionsManager.getName());
            return true;
        }

        $.get('../../js/mlm/objectsEditor/tpl.html', function (html) {
            _viewAssets.setModelsEditor(_viewModels);
            _viewObjects.setModelsEditor(_viewModels);
            _viewResolutions.setModelsEditor(_viewModels);
            _view.createDom(html);
            _viewAssets.prepareUploader();
            _viewAssets.prepareTree();
            _viewAssets.buildTree();
            _viewObjects.prepareTree();
            _viewObjects.buildTree();
            _viewResolutions.prepareTree();
            _viewResolutions.buildTree();
            _viewResolutions.resolutionSelect(nge.resolutionsManager.getName());
        });

        return true;
    };

    this.close = function () {
        $('.objectsEditor').hide();
        return true;
    };

    this.update = function () {
        _viewAssets.prepareTree();
        _viewAssets.buildTree();
        _viewObjects.prepareTree();
        _viewObjects.buildTree();
        _viewResolutions.prepareTree();
        _viewResolutions.buildTree();
        return true;
    };

    this.assetsNewFolder = function () {
        return _viewAssets.assetsNewFolder();
    };

    this.assetsDeleteSelected = function () {
        return _viewAssets.assetsDeleteSelected();
    };

    this.assetsExportSelected = function () {
        return _viewAssets.assetsExportSelected();
    };

    this.assetsAddObject = function () {
        return _viewAssets.assetsAddObject(_viewObjects.addAssetAsObject);
    };

    this.assetsAddBtn = function () {
        return _viewAssets.assetsAddObject(_viewObjects.addAssetAsBtn);
        ;
    };

    this.objectsExportSelected = function () {
        return _viewObjects.objectsExportSelected();
    };

    this.objectsDeleteSelected = function () {
        return _viewObjects.objectsDeleteSelected();
    };

    this.objectsNewFolder = function () {
        return _viewObjects.objectsNewFolder();
    };

    this.objectsAddText = function () {
        return _viewObjects.objectsAddText();
    };

    this.resolutionsExport = function () {
        return _viewResolutions.resolutionsExport();
    };

    this.resolutionAdd = function () {
        return _viewResolutions.resolutionAdd();
    };

    this.resolutionsDeleteSelected = function () {
        var res = _viewResolutions.resolutionsDeleteSelected();
        if (!res)
            return false;

        //active res deleted
        if (res === _activeResolution) {
            var resCfg = nge.App.getInstance('Cfg.Resolutions').get();
            _viewResolutions.resolutionSelect(resCfg[0].name);
        }

        return true;
    };

    this.resolutionSelect = function () {
        return _viewResolutions.resolutionSelect();
    };

    this.applyResolution = function (name) {
        var oldRes = nge.resolutionsManager.getName();
        _viewObjects.applyResolution(name, oldRes);
        _activeResolution = name;
    };

    this.setResolution = function (name) {
        nge.resolutionsManager.set(name);
    };

    this.edit = function (model) {
        switch (model.type) {
            case 'object':
                if (_activeResolution !== 'main' && model.key.indexOf('custom.') !== 0)
                    model.key = 'properties_' + _activeResolution + '.' + model.key;

                _viewObjects.modelRowEdit(model);
                break;
            case 'asset':
                _viewAssets.modelRowEdit(model);
                break;
            case 'resolution':
                _viewResolutions.modelRowEdit(model);
                break;
        }
        return true;
    };

    this.modelAddRow = function () {
        return _viewModels.modelAddRow();
    };
};



nge.Mlm.ObjectsEditor.View = function () {
    var _assetsMainCount = 0;

    this.createDom = function (html) {
        var div = $('<div class="objectsEditor"></div>');
        $("body").append(div);
        div.html(html);

        var printIt = function (t) {
            var win = window.open('', '', 'toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=yes,width=800,height=600');
            if (win) {
                var text = t;
                text = '<pre style="word-wrap: break-word; white-space: pre-wrap;">' + text + '</pre>';
                win.document.write(text);
                win.document.close();
                win.focus();
            }

            return false;
        };

        $('.assets-export-selected').bind('click', function () {
            printIt(nge.objectsEditor.assetsExportSelected());
        });
        $('.objects-export-selected').bind('click', function () {
            printIt(nge.objectsEditor.objectsExportSelected());
        });
        $('.resolutions-export-selected').bind('click', function () {
            printIt(nge.objectsEditor.resolutionsExport());
        });

        var blocks = ['resolutions', 'assets', 'objects', 'settings'];

        for (var k in blocks) {
            var block = blocks[k];
            var blockBind = function (b) {
                $('.' + b + '-content').hide();
                $('.' + b + '-roll').bind('click', function () {
                    var res = $('.' + b + '-content').css('display') === 'none';
                    var content = $('.' + b + '-content');
                    res ? content.show() : content.hide();
                    var roll = $('.' + b + '-roll').find('b');
                    res ? roll.html('-') : roll.html('+');
                });
            };
            blockBind(block);
        }

        return true;
    };
};



nge.Mlm.ObjectsEditor.ViewAssets = function () {
    var _assetsMainCount = 0;
    var _modelsEditor;

    this.setModelsEditor = function (o) {
        _modelsEditor = o;
    };

    this.prepareUploader = function () {
        $('#FileInput').change(function () {
            $('#assetUploaderForm').ajaxSubmit({
                target: '#output',
                beforeSubmit: nge.uploader.beforeSubmit,
                success: function (res) {
                    var result = JSON.parse(res);
                    log('Upload success', result);
                    _assetsMainCount++;
                    var model = {
                        id: _assetsMainCount,
                        pid: 0,
                        type: 'file',
                        name: result.name
                    };
                    _insertIntoTree(model);
                    //insert image into  mt.data.assets
                    if (!mt.findItemInTemplate(
                        'name', result.name, mt.data.assets
                        )) {
                        var asset = new nge.Mlm.Assets.Image();
                        asset.id = result.name;
                        asset.name = result.name;
                        asset.fullPath = 'img/' + result.name;
                        asset.key = '/' + result.name;
                        asset.width = result.width;
                        asset.height = result.height;
                        asset.frameWidth = result.width;
                        asset.frameHeight = result.height;
                        asset.source = 'img/' + result.name;
                        mt.data.assets.contents.push(asset);

                        var loader = new Phaser.Loader(nge.game);
                        //loader.image(asset.key, asset.fullPath);
                        loader.spritesheet(asset.key, asset.fullPath, asset.frameWidth, asset.frameHeight);
                        loader.start();
                    }
                },
                uploadProgress: nge.uploader.OnProgress,
                resetForm: true
            });
        });
        return true;
    };

    /**
     * 
     * @param {Object} el {id, pid, name, type}
     * @param {Boolean} dontAddIntoTree
     * @returns {Boolean}
     */
    var _insertIntoTree = function (el, dontAddIntoTree) {
        var body = $('#assetsTreeViewBody');
        var parent = '';
        if (el.pid)
            parent = nge.Lib.Helper.strReplace('{pid}', el.pid, _treeParentPattern);

        var html = _treePattern;
        html = nge.Lib.Helper.strReplace('{id}', el.id, html);
        html = nge.Lib.Helper.strReplace('{parent}', parent, html);
        html = nge.Lib.Helper.strReplace('{type}', el.type, html);
        html = nge.Lib.Helper.strReplace('{name}', el.name, html);


        if (!dontAddIntoTree) {
            var node = $("#assetsTreeView").treetable("node", "0");
            $("#assetsTreeView").treetable("loadBranch", node, html);
            _makeTreeAlive();
        } else {
            body.append($(html));
        }

        return true;
    };

    this.prepareTree = function () {
        $('.ui-assetsTreeView').html('').append(
            '<table id="assetsTreeView">' +
            '<tbody id="assetsTreeViewBody"></tbody>' +
            '</table>'
            );
        var parent = mt.data.assets.contents;

        var parseA = function (po, pid) {
            var i = 1;
            for (var k in po) {
                var el = po[k];
                var model = {
                    id: i,
                    pid: pid,
                    type: 'folder',
                    name: el.name
                };
                if (pid)
                    model.id = pid + '-' + model.id;
                if (el.width && el.height)
                    model.type = 'file';

                _insertIntoTree(model, true);

                if (model.type === 'folder')
                    parseA(el.contents, model.id);
                i++;
            }
            return (i - 1);
        };
        _assetsMainCount = parseA(parent, false);
        return true;
    };

    this.buildTree = function () {
        $("#assetsTreeView").treetable({expandable: true});

        // Highlight selected row
        $("#assetsTreeView tbody").on("mousedown", "tr", function () {
            $(".selected").not(this).removeClass("selected");
            $(this).toggleClass("selected");
            _editModel();
        });

        _makeTreeAlive();
        return true;
    };

    var _makeTreeAlive = function () {
        // Drag & Drop Code
        $("#assetsTreeView .file, #assetsTreeView .folder").draggable({
            helper: "clone",
            opacity: .75,
            refreshPositions: true,
            revert: "invalid",
            revertDuration: 300,
            scroll: true
        });

        $("#assetsTreeView .folder").each(function () {
            $(this).parents("#assetsTreeView tr").droppable({
                accept: ".file, .folder",
                drop: function (e, ui) {
                    var droppedEl = ui.draggable.parents("tr");
                    $("#assetsTreeView").treetable(
                        "move", droppedEl.data("ttId"),
                        $(this).data("ttId")
                        );
                    //assets regroup
                    var name = droppedEl.find('.assetName').html();
                    var parentName = $(this).find('.assetName').html();
                    if (parentName === name)
                        return false;

                    log('>moving ' + name + ' into ' + parentName);

                    var asset = mt.findItemInTemplate(
                        'name', name, mt.data.assets
                        );
                    if (asset) {
                        mt.deleteItemInTemplate(
                            'name', name, mt.data.assets
                            );
                        var assetP = mt.findItemInTemplate(
                            'name', parentName, mt.data.assets
                            );
                        if (assetP && assetP.contents)
                            assetP.contents.push(asset);
                        else
                            log('>>> ERROR: no assetP ' + parentName);
                    } else {
                        log('>>> ERROR: no asset ' + name);
                    }
                },
                hoverClass: "accept",
                over: function (e, ui) {
                    var droppedEl = ui.draggable.parents("tr");
                    if (this !== droppedEl[0] && !$(this).is(".expanded")) {
                        $("#assetsTreeView").treetable(
                            "expandNode",
                            $(this).data("ttId")
                            );
                    }
                }
            });
        });
        return true;
    };

    this.assetsNewFolder = function () {
        _assetsMainCount++;
        var model = {
            id: _assetsMainCount,
            pid: 0,
            type: 'folder',
            name: 'Folder' + _assetsMainCount
        };
        _insertIntoTree(model);
        //insert folder into  mt.data.assets
        if (!mt.findItemInTemplate(
            'name', model.name, mt.data.assets
            )) {
            var asset = new nge.Mlm.Assets.Folder();
            asset.id = model.name;
            asset.name = model.name;
            asset.fullPath = '/' + model.name;
            mt.data.assets.contents.push(asset);
        }
        return true;
    };

    this.assetsDeleteSelected = function () {
        var id = $("#assetsTreeView tbody").find('.selected').data('ttId');
        var name = $("#assetsTreeView tbody").
            find('.selected').find('.assetName').html();

        if (!id)
            return false;

        var node = $("#assetsTreeView").treetable("node", id);
        jQuery('#assetsTreeView').treetable("unloadBranch", node);
        node.row.remove();
        var tree = node.tree;
        delete tree[node.id];
        //delete from mt.data.assets
        var res = mt.deleteItemInTemplate(
            'name', name, mt.data.assets
            );
        if (!res)
            log('>>> ERROR: asset ' + name + ' was not deleted');
        return true;
    };

    this.assetsExportSelected = function () {
        var name = $("#assetsTreeView tbody").
            find('.selected').find('.assetName').html();
        var el = mt.findItemInTemplate(
            'name', name, mt.data.assets
            );
        var str = JSON.stringify(el, null, "\t");
        return str;
    };

    this.assetsAddObject = function (callback) {
        var name = $("#assetsTreeView tbody").
            find('.selected').find('.assetName').html();
        var el = mt.findItemInTemplate(
            'name', name, mt.data.assets
            );
        if (!el.key)
            return false;

        callback(el);
        return true;
    };

    var _editModel = function () {
        _modelsEditor.close();
        var name = $("#assetsTreeView tbody").
            find('.selected').find('.assetName').html();
        var el = mt.findItemInTemplate(
            'name', name, mt.data.assets
            );

        if (!name || !el) {
            return false;
        }

        var scheme = _getScheme(el);
        var model = nge.Lib.Helper.jsObjClone(scheme);
        for (var k in model) {
            model[k] = nge.Lib.Helper.recursiveGet(model[k], el);
        }
        //share custom fields
        for (var k in el.custom) {
            model['custom.' + k] = el.custom[k];
        }

        model.scheme = _assetImageEditingModel;
        _modelsEditor.edit(model, 'asset');
    };

    var _getScheme = function (el) {
        var type = 'folder';
        if (el.key)
            type = 'image';

        var scheme = _assetFolderEditingModel;
        switch (type) {
            case 'folder':
                scheme = _assetFolderEditingModel;
                break;
            case 'image':
                scheme = _assetImageEditingModel;
                break;
        }
        return scheme;
    };

    this.modelRowEdit = function (model) {
        var v = model.value;
        var k = model.key;
        var reload = false;
        if (v == parseFloat(v))
            v = parseFloat(v);

        var name = $("#assetsTreeView tbody").
            find('.selected').find('.assetName').html();
        var el = mt.findItemInTemplate(
            'name', name, mt.data.assets
            );

        var scheme = _getScheme(el);

        //apply
        var key = k;
        if (scheme[k])
            key = scheme[k];
        else if (!nge.Lib.Helper.recursiveGet(key, el))
            reload = true;

        nge.Lib.Helper.recursiveSet(key, v, el);
        //corrections
        if (k === 'name')
            $("#assetsTreeView tbody").
                find('.selected').find('.assetName').html(v);
        else if (k === 'frameWidth' || k === 'frameHeight') {
            //reload asset
            if (nge.wrap.cache.getImage(el.key))
                nge.wrap.cache.removeImage(el.key);

            var onLoaded = function () {
                log('loaded');
                var objs = nge.objects.findItemsInWorld(
                    'assetKey', el.key
                    );
                for (var k in objs) {

                    var frame = new Phaser.Frame(
                        el.frameMax, 0, 0, el.frameWidth, el.frameHeight
                        );
                    objs[k].setTexture(PIXI.TextureCache[el.key]);
                    objs[k].setFrame(frame);
                }
            };

            var loader = new Phaser.Loader(nge.game);
            loader.spritesheet(el.key, el.fullPath, el.frameWidth, el.frameHeight);
            loader.onLoadComplete.addOnce(onLoaded);
            loader.start();
        }
        if (reload)
            _editModel();
        return true;
    };

    var _treePattern = '<tr data-tt-id="{id}"{parent}><td><span class="{type} assetName">{name}</span></td></tr>';
    var _treeParentPattern = ' data-tt-parent-id="{pid}"';

    var _assetImageEditingModel = {
        'name': 'name',
        'key': 'key',
        'frameWidth': 'frameWidth',
        'frameHeight': 'frameHeight',
        'width': 'width',
        'height': 'height',
        'frameMax': 'frameMax',
        'margin': 'margin',
        'spacing': 'spacing',
        'anchorX': 'anchorX',
        'anchorY': 'anchorY',
        'fps': 'fps'
    };

    var _assetFolderEditingModel = {
        'name': 'name'
    };
};



nge.Mlm.ObjectsEditor.ViewModels = function () {
    var _type;  // object/asset/resolution

    this.edit = function (model, type, fixed) {
        _type = type;
        $('.objectsEditorSettings').html('');

        var prefix = '';
        var html = '';
        if (fixed)
            prefix = ' disabled';
        for (var k in model) {
            if (k === 'scheme')
                continue;

            html += '<label for="objectsEditorModel-' + k + '"class="objectsEditorLabel">' + k +
                    '</label><input class="objectsEditorModel" id="objectsEditorModel-'
                    + k + '" value="' + model[k] + '" ' + prefix + '><br>';
        }
        $('.objectsEditorSettings').html(html);
        $('.newRow').show();
        $('.objectsEditorModel').focusin(_focusin);
        $('.objectsEditorModel').focusout(_focusout);
        $('.objectsEditorModel').change(_change);
        $('.objectsEditorModel').keyup(_change);
        $('.objectsEditorModel').bind('DOMMouseScroll mousewheel', _wheel);

        return true;
    };

    var _wheel = function (e) {
        var k = 0;

        if (e.originalEvent.wheelDelta > 0 || e.originalEvent.detail < 0)
            k = 1;
        else
            k = -1;

        // if (this.value == parseFloat(this.value))
        if (this.value === '')
            this.value = 0;

        if (!isNaN(this.value))
            this.value = parseFloat(this.value) + k;

        _change(e);
    };

    var _focusin = function () {
        if (!this._haschanged) {
            this.valueBak = this.value;
            this.value = '';
            this._haschanged = true;
        }
    };

    var _focusout = function () {
        if (this._haschanged && this.value === '') {
            this.value = this.valueBak;
        }
    };

    var _change = function (e) {
        var id = nge.Lib.Helper.strReplace(
                'objectsEditorModel-',
                '',
                e.currentTarget.id
                );
        var value = e.currentTarget.value;
        var model = new nge.Mlm.ObjectsEditor.Model({
            type: _type,
            key: id,
            value: value
        });
        nge.objectsEditor.edit(model);
        return true;
    };

    this.close = function () {
        _type = false;
        $('.objectsEditorSettings').html('');
        $('.newRow').hide();
        return true;
    };

    this.modelAddRow = function () {
        var id = 'custom.' + $('.newRowTitle').val();
        var model = new nge.Mlm.ObjectsEditor.Model({
            type: _type,
            key: id
        });
        nge.objectsEditor.edit(model);
        $('.newRowTitle').val('');
        return true;
    };
};



nge.Mlm.ObjectsEditor.ViewObjects = function () {
    var _objectsMainCount = 0;
    var _modelsEditor;
    var _activeResolution;

    this.setModelsEditor = function (o) {
        _modelsEditor = o;
    };
    /**
     * 
     * @param {Object} el {id, pid, name, type}
     * @param {Boolean} dontAddIntoTree
     * @returns {Boolean}
     */
    var _insertIntoTree = function (el, dontAddIntoTree) {
        var body = $('#objectsTreeViewBody');
        var parent = '';
        if (el.pid)
            parent = nge.Lib.Helper.strReplace('{pid}', el.pid, _treeParentPattern);
        var html = _treePattern;
        html = nge.Lib.Helper.strReplace('{id}', el.id, _treePattern);
        html = nge.Lib.Helper.strReplace('{parent}', parent, html);
        html = nge.Lib.Helper.strReplace('{type}', el.type, html);
        html = nge.Lib.Helper.strReplace('{name}', el.name, html);
        if (!dontAddIntoTree) {
            var node = $("#objectsTreeView").treetable("node", "0");
            $("#objectsTreeView").treetable("loadBranch", node, html);
            _makeTreeAlive();
        } else {
            body.append($(html));
        }

        return true;
    };
    this.prepareTree = function () {
        $('.ui-objectsTreeView').html('').append(
            '<table id="objectsTreeView">' +
            '<tbody id="objectsTreeViewBody"></tbody>' +
            '</table>'
            );
        var parent = mt.data.objects.contents;
        var parseA = function (po, pid) {
            var i = 1;
            for (var k in po) {
                var el = po[k];
                var model = {
                    id: i,
                    pid: pid,
                    type: 'file',
                    name: el.name
                };
                if (pid)
                    model.id = pid + '-' + model.id;
                if (el.type === 1)
                    model.type = 'folder';
                _insertIntoTree(model, true);
                if (model.type === 'folder')
                    i += parseA(el.contents, model.id);
                i++;
            }
            return (i - 1);
        };
        _objectsMainCount = parseA(parent, false);
        return true;
    };
    this.buildTree = function () {
        $("#objectsTreeView").treetable({expandable: true});
        // Highlight selected row
        $("#objectsTreeView tbody").on("mousedown", "tr", function () {
            $(".selected").not(this).removeClass("selected");
            $(this).toggleClass("selected");
            _editModel();
        });
        _makeTreeAlive();
        return true;
    };
    var _makeTreeAlive = function () {
        // Drag & Drop Code
        $("#objectsTreeView .file, #objectsTreeView .folder").draggable({
            helper: "clone",
            opacity: .75,
            refreshPositions: true,
            revert: "invalid",
            revertDuration: 300,
            scroll: true
        });
        $("#objectsTreeView .folder").each(function () {
            $(this).parents("#objectsTreeView tr").droppable({
                accept: ".file, .folder",
                drop: function (e, ui) {
                    var droppedEl = ui.draggable.parents("tr");
                    $("#objectsTreeView").treetable(
                        "move", droppedEl.data("ttId"),
                        $(this).data("ttId")
                        );
                    //objects regroup
                    var name = droppedEl.find('.objectName').html();
                    var parentName = $(this).find('.objectName').html();
                    if (parentName === name)
                        return false;
                    log('>moving ' + name + ' into ' + parentName);
                    var obj = mt.findItemInTemplate(
                        'name', name, mt.data.objects
                        );
                    if (obj) {
                        mt.deleteItemInTemplate(
                            'name', name, mt.data.objects
                            );
                        var objectP = mt.findItemInTemplate(
                            'name', parentName, mt.data.objects
                            );
                        if (objectP && objectP.contents)
                            objectP.contents.unshift(obj);
                        else
                            log('>>> ERROR: no objectP ' + parentName);
                        //now in world
                        var gr = nge.findOne('^' + parentName);
                        var el = nge.findOne('^' + name);
                        if (gr && el)
                            gr.add(el);
                        else
                            log('>>> ERROR: no objects in world - gr,el:', gr, el);
                    } else {
                        log('>>> ERROR: no object ' + name);
                    }
                },
                hoverClass: "accept",
                over: function (e, ui) {
                    var droppedEl = ui.draggable.parents("tr");
                    if (this !== droppedEl[0] && !$(this).is(".expanded")) {
                        $("#objectsTreeView").treetable(
                            "expandNode",
                            $(this).data("ttId")
                            );
                    }
                }
            });
        });
        return true;
    };
    this.objectsAddText = function () {
        _objectsMainCount++;
        var model = {
            id: _objectsMainCount,
            pid: 0,
            type: 'file',
            name: 'Text' + _objectsMainCount
        };
        _insertIntoTree(model);
        //insert folder into  mt.data.objects
        if (!mt.findItemInTemplate(
            'name', model.name, mt.data.objects
            )) {
            var obj = new nge.Mlm.Objects.Text();
            obj.id = model.name;
            obj.name = model.name;
            obj.fullPath = '/' + model.name;
            mt.data.objects.contents.push(obj);
            nge.objects.create(model.name);
        }
        return true;
    };
    this.objectsNewFolder = function () {
        _objectsMainCount++;
        var model = {
            id: _objectsMainCount,
            pid: 0,
            type: 'folder',
            name: 'Folder' + _objectsMainCount
        };
        _insertIntoTree(model);
        //insert folder into  mt.data.objects
        if (!mt.findItemInTemplate(
            'name', model.name, mt.data.objects
            )) {
            var obj = new nge.Mlm.Objects.Folder();
            obj.id = model.name;
            obj.name = model.name;
            obj.fullPath = '/' + model.name;
            mt.data.objects.contents.push(obj);
            nge.objects.create(obj.name);
        }
        return true;
    };
    this.objectsDeleteSelected = function () {
        var id = $("#objectsTreeView tbody").find('.selected').data('ttId');
        var name = $("#objectsTreeView tbody").
            find('.selected').find('.objectName').html();
        if (!id)
            return false;
        var node = $("#objectsTreeView").treetable("node", id);
        jQuery('#objectsTreeView').treetable("unloadBranch", node);
        node.row.remove();
        var tree = node.tree;
        delete tree[node.id];
        //delete from mt.data.objects
        var res = mt.deleteItemInTemplate(
            'name', name, mt.data.objects
            );
        if (!res)
            log('>>> ERROR: object ' + name + ' was not deleted');
        //delete frim state
        var res = nge.findOne('^' + name).destroy(true);
        return true;
    };
    this.objectsExportSelected = function () {
        var name = $("#objectsTreeView tbody").
            find('.selected').find('.objectName').html();
        var el = mt.findItemInTemplate(
            'name', name, mt.data.objects
            );
        var str = JSON.stringify(el, null, "\t");

        return str;
    };
    this.addAssetAsObject = function (el) {
        if (!el)
            return false;
        _objectsMainCount++;
        var nameArr = el.name.split('.');
        nameArr.pop();
        var newName = nameArr.pop() + _objectsMainCount;
        var model = {
            id: _objectsMainCount,
            pid: 0,
            type: 'file',
            name: newName
        };
        _insertIntoTree(model);
        //insert folder into  mt.data.objects
        if (!mt.findItemInTemplate(
            'name', model.name, mt.data.objects
            )) {
            var obj = new nge.Mlm.Objects.Image();
            obj.id = newName;
            obj.name = newName;
            obj.assetId = el.id;
            obj.fullPath = el.fullPath;
            obj.assetKey = el.key;
            obj.height = el.height;
            obj.width = el.width;
            mt.data.objects.contents.push(obj);
            nge.objects.create(newName);
        }

        return true;
    };
    var _editModel = function () {
        _modelsEditor.close();
        var name = $("#objectsTreeView tbody").
            find('.selected').find('.objectName').html();
        var el = mt.findItemInTemplate(
            'name', name, mt.data.objects
            );
        var elw = nge.findOne('^' + name);
        if (!name || !el) {
            return false;
        }

        if (!elw) {
            nge.objects.create(name);
            elw = nge.findOne('^' + name);
            el.isVisible = false;
            elw.visible = false;
        }

        var scheme = _getScheme(el);
        var model = nge.Lib.Helper.jsObjClone(scheme);
        for (var k in model) {
            var mtk = model[k]['mt'];
            model[k] = nge.Lib.Helper.recursiveGet('properties_' + _activeResolution + '.' + mtk, el);
            if (typeof model[k] === 'undefined')
                model[k] = nge.Lib.Helper.recursiveGet(mtk, el);
        }
        //share custom fields
        for (var k in el.custom) {
            model['custom.' + k] = el.custom[k];
        }

        model.scheme = scheme;
        _modelsEditor.edit(model, 'object');
    };
    var _getScheme = function (el) {
        var type = 'folder';
        if (el.type === 2)
            type = 'text';
        if (el.type === 0)
            type = 'image';
        if (el.type === 4)
            type = 'button';
        var scheme = _objectFolderEditingModel;
        switch (type) {
            case 'folder':
                scheme = _objectFolderEditingModel;
                break;
            case 'text':
                scheme = _objectTextEditingModel;
                break;
            case 'image':
                scheme = _objectImageEditingModel;
                break;
            case 'button':
                scheme = _objectButtonEditingModel;
                break;
        }
        return scheme;
    };

    this.modelRowEdit = function (model) {
        if (!model.name)
            model.name = $("#objectsTreeView tbody").
                find('.selected').find('.objectName').html();
        _modelRowEdit(model);
    };

    var _modelRowEdit = function (model) {
        var name = model.name,
            k = model.key,
            v = model.value,
            worldOnlyFlag = model.worldOnlyFlag;

        var reload = false;
        if (!isNaN(v))
            v = parseFloat(v);

        var res = mt.findItemInTemplate(
            'name', name, mt.data.objects, true
            );
        var el = res.object;
        var parent = res.parent;
        var elw = nge.findOne('^' + name);
        var scheme = _getScheme(el);

        //apply
        var keyMt = k;
        var keyW = k;
        var propertyFlag = false;
        if (keyW.indexOf('properties_') === 0) {
            propertyFlag = true;
            keyW = keyW.split('.')[1];
        }

        if (scheme[k]) {
            keyMt = scheme[k]['mt'];
            keyW = scheme[k]['world'];
        } else if (!propertyFlag && !nge.Lib.Helper.recursiveGet(keyMt, el)) {
            reload = true;
        }

        if (!worldOnlyFlag)
            nge.Lib.Helper.recursiveSet(keyMt, v, el);
        //world corrections 4 btn
        if (el.btnFrames) {
            if (k === 'action')
                try {
                    log("action is correct");
                    eval('v = ' + v);
                } catch (e) {
                    log("action is incorrect");
                }
            if (k === 'scaleX')
                v = v * el.width;
            if (k === 'scaleY')
                v = v * el.height;
        }
        nge.Lib.Helper.recursiveSet(keyW, v, elw);

        //corrections
        if (k === 'fontSize' || k === 'fontFamily') {
            var font = el['style']['fontSize'] + 'pt ' + '"' +
                el['style']['fontFamily'] + '"';
            el['style']['font'] = font;
            //elw.setStyle({font: font});
        }
        if (k === 'name')
            $("#objectsTreeView tbody").
                find('.selected').find('.objectName').html(v);
        if (k === 'z') {
            //objects in mt parent array sort
            var contents = parent.contents;
            contents.sort(function (a, b) {
                if (!a.z)
                    a.z = 0;
                if (!b.z)
                    b.z = 0;
                return parseInt(b.z) - parseInt(a.z);
            });
            //remove children in world
            for (var k in contents) {
                var el = nge.findOne('^' + contents[k].name);

                if (el)
                    el.destroy(true);
            }

            //create children by mt
            var parentW = nge.findOne('^' + parent.name);

            //for (var k in contents) {
            for (var i = contents.length - 1; i > -1; i--) {
                nge.objects.create(contents[i].name, parentW);
            }

        }

        //removing deprecated propertie
        if (k.indexOf('properties_') === 0) {
            var kArr = k.split('.');
            var val = nge.Lib.Helper.recursiveGet(kArr[1], el);
            if (val === v)
                nge.Lib.Helper.recursiveDelete(k, el);
        }

        if (reload)
            _editModel();
        return true;
    };

    this.addAssetAsBtn = function (el) {
        if (!el)
            return false;
        _objectsMainCount++;
        var nameArr = el.name.split('.');
        nameArr.pop();
        var newName = nameArr.pop() + _objectsMainCount;
        var model = {
            id: _objectsMainCount,
            pid: 0,
            type: 'file',
            name: newName
        };
        _insertIntoTree(model);
        //insert folder into  mt.data.objects
        if (!mt.findItemInTemplate(
            'name', model.name, mt.data.objects
            )) {
            var obj = new nge.Mlm.Objects.Button();
            obj.id = newName;
            obj.name = newName;
            obj.assetId = el.id;
            obj.fullPath = el.fullPath;
            obj.assetKey = el.key;
            obj.height = el.height;
            obj.width = el.width;
            mt.data.objects.contents.push(obj);
            nge.objects.create(newName);
        }

        return true;
    };

    this.applyResolution = function (name, oldName) {
        _activeResolution = name;

        var f = function (parent) {
            //for every element
            for (var k in parent.contents) {
                var el = parent.contents[k];
                //get scheme
                var scheme = _getScheme(el);
                //for every property by model
                for (var k1 in scheme) {
                    var kmt = scheme[k1]['mt'];

                    //restore main
                    var valOld = nge.Lib.Helper.recursiveGet(
                        kmt,
                        el['properties_' + oldName]
                        );

                    var valDef = nge.Lib.Helper.recursiveGet(kmt, el);
                    //restore defaults
                    if (valOld !== undefined) {
                        var model = new nge.Mlm.ObjectsEditor.Model({
                            name: el.name,
                            key: k1,
                            value: valDef,
                            worldOnlyFlag: true
                        });
                        _modelRowEdit(model);
                    }
                    //set new
                    var valNew = nge.Lib.Helper.recursiveGet(
                        kmt,
                        el['properties_' + name]
                        );
                    if (valNew !== undefined) {
                        var model = new nge.Mlm.ObjectsEditor.Model({
                            name: el.name,
                            key: k1,
                            value: valNew,
                            worldOnlyFlag: true
                        });
                        _modelRowEdit(model);
                    }
                }

                if (el.contents && el.contents.length > 0)
                {
                    f(el);
                }
            }

            return true;
        };

        return f(mt.data.objects) || false;
    };

    var _treePattern = '<tr data-tt-id="{id}"{parent}><td><span class="{type} objectName">{name}</span></td></tr>';
    var _treeParentPattern = ' data-tt-parent-id="{pid}"';
    var _objectFolderEditingModel = {
        'name': {mt: 'name', world: 'name'},
        'x': {mt: 'x', world: 'x'},
        'y': {mt: 'y', world: 'y'},
        'z': {mt: 'z', world: 'z'},
        'angle': {mt: 'angle', world: 'angle'},
        'anchorX': {mt: 'anchorX', world: 'anchor.x'},
        'anchorY': {mt: 'anchorY', world: 'anchor.y'},
        //'isFixedToCamera': {mt: 'isFixedToCamera', world: 'isFixedToCamera'},
        'width (ns*)': {mt: 'width', world: 'width'},
        'height (ns*)': {mt: 'height', world: 'height'},
        'scaleX': {mt: 'scaleX', world: 'scaleX'},
        'scaleY': {mt: 'scaleY', world: 'scaleY'},
        'alpha': {mt: 'alpha', world: 'alpha'},
        'isVisible': {mt: 'isVisible', world: 'visible'}
    };
    var _objectTextEditingModel = {
        'name': {mt: 'name', world: 'name'},
        'x': {mt: 'x', world: 'x'},
        'y': {mt: 'y', world: 'y'},
        'z': {mt: 'z', world: 'z'},
        'angle': {mt: 'angle', world: 'angle'},
        'anchorX': {mt: 'anchorX', world: 'anchor.x'},
        'anchorY': {mt: 'anchorY', world: 'anchor.y'},
        'text': {mt: 'text', world: 'text'},
        'fontSize': {mt: 'style.fontSize', world: 'fontSize'},
        'fill': {mt: 'style.fill', world: 'fill'},
        'stroke': {mt: 'style.stroke', world: 'stroke'},
        'scaleX': {mt: 'scaleX', world: 'scaleX'},
        'scaleY': {mt: 'scaleY', world: 'scaleY'},
        'alpha': {mt: 'alpha', world: 'alpha'},
        'isVisible': {mt: 'isVisible', world: 'visible'}
    };
    var _objectImageEditingModel = {
        'name': {mt: 'name', world: 'name'},
        'x': {mt: 'x', world: 'x'},
        'y': {mt: 'y', world: 'y'},
        'z': {mt: 'z', world: 'z'},
        'angle': {mt: 'angle', world: 'angle'},
        'anchorX': {mt: 'anchorX', world: 'anchor.x'},
        'anchorY': {mt: 'anchorY', world: 'anchor.y'},
        'scaleX': {mt: 'scaleX', world: 'scaleX'},
        'scaleY': {mt: 'scaleY', world: 'scaleY'},
        'alpha': {mt: 'alpha', world: 'alpha'},
        'frame': {mt: 'frame', world: 'frame'},
        'isVisible': {mt: 'isVisible', world: 'visible'}
    };
    var _objectButtonEditingModel = {
        'name': {mt: 'name', world: 'name'},
        'x': {mt: 'x', world: 'x'},
        'y': {mt: 'y', world: 'y'},
        'z': {mt: 'z', world: 'z'},
        'angle': {mt: 'angle', world: 'angle'},
        'anchorX': {mt: 'anchorX', world: 'anchor.x'},
        'anchorY': {mt: 'anchorY', world: 'anchor.y'},
        'scaleX': {mt: 'scaleX', world: 'width'},
        'scaleY': {mt: 'scaleY', world: 'height'},
        'alpha': {mt: 'alpha', world: 'alpha'},
        'isVisible': {mt: 'isVisible', world: 'visible'},
        'action': {mt: 'action', world: 'events.onInputUp._bindings.0._listener'},
        'btnFramesOver': {mt: 'btnFrames.over', world: '_onOverFrame'},
        'btnFramesOut': {mt: 'btnFrames.out', world: '_onOutFrame'},
        'btnFramesDown': {mt: 'btnFrames.down', world: '_onDownFrame'}
    };
};



nge.Mlm.ObjectsEditor.viewResolutions = function () {
    var _resolutionsMainCount = 0;
    var _modelsEditor;

    this.setModelsEditor = function (o) {
        _modelsEditor = o;
    };

    /**
     * 
     * @param {Object} el {id, pid, name, type}
     * @param {Boolean} dontAddIntoTree
     * @returns {Boolean}
     */
    var _insertIntoTree = function (el, dontAddIntoTree) {
        var body = $('#resolutionsTreeViewBody');
        var parent = '';
        var html = _treePattern;
        html = nge.Lib.Helper.strReplace('{parent}', parent, html);
        html = nge.Lib.Helper.strReplace('{type}', el.type, html);
        html = nge.Lib.Helper.strReplace('{name}', el.name, html);


        if (!dontAddIntoTree) {
            var node = $("#resolutionsTreeView").treetable("node", "0");
            $("#resolutionsTreeView").treetable("loadBranch", node, html);
        } else {
            body.append($(html));
        }

        return true;
    };

    this.prepareTree = function () {
        $('.ui-resolutionsTreeView').html('').append(
                '<table id="resolutionsTreeView">' +
                '<tbody id="resolutionsTreeViewBody"></tbody>' +
                '</table>'
                );
        var parent = nge.Cfg.Resolutions.contents;

        var parseA = function (po, pid) {
            var i = 1;
            for (var k in po) {
                var el = po[k];
                var model = {
                    id: i,
                    pid: pid,
                    type: 'folder',
                    name: el.name
                };
                if (pid)
                    model.id = pid + '-' + model.id;
                if ((el.width && el.height) || el.text)
                    model.type = 'file';

                _insertIntoTree(model, true);

                if (model.type === 'folder')
                    i += parseA(el.contents, model.id);
                i++;
            }
            return (i - 1);
        };
        _resolutionsMainCount = parseA(parent, false);
        return true;
    };

    this.buildTree = function () {
        $("#resolutionsTreeView").treetable({expandable: true});

        // Highlight selected row
        $("#resolutionsTreeView tbody").on("mousedown", "tr", function () {
            $(".selected").not(this).removeClass("selected");
            $(this).toggleClass("selected");
            _editModel();
        });
        return true;
    };

    this.resolutionsDeleteSelected = function () {
        var name = $("#resolutionsTreeView tbody").
                find('.selected').find('.resolutionName').html();

        if (!name)
            return false;

        var el = mt.findItemInTemplate(
                'name', name, nge.Cfg.Resolutions
                );
        if (el._fixed)
            return false;

        //remove all props from all objects models
        var po; //parent object
        while (
                po = mt.findItemInTemplate(
                        'properties_' + name, '*ANY*', mt.data.objects, true
                        )) {
            delete po.object['properties_' + name];
        }

        var node = $("#resolutionsTreeView").treetable("node", name);
        jQuery('#resolutionsTreeView').treetable("unloadBranch", node);
        node.row.remove();
        var tree = node.tree;
        delete tree[node.name];
        //delete from mt.data.resolutions
        var res = mt.deleteItemInTemplate(
                'name', name, nge.Cfg.Resolutions
                );
        if (!res)
            log('>>> ERROR: resolution ' + name + ' was not deleted');
        return name;
    };

    this.resolutionsExport = function () {
        var el = nge.Cfg.Resolutions;
        var str = JSON.stringify(el, null, "\t");
        return str;
    };

    this.resolutionAdd = function () {
        _resolutionsMainCount++;
        var model = nge.Lib.Helper.jsObjClone(_resolutionPattern);
        model.name += _resolutionsMainCount;

        _insertIntoTree(model);
        nge.Cfg.Resolutions.contents.push(model);

        return true;
    };
    var _editModel = function () {
        _modelsEditor.close();
        var name = $("#resolutionsTreeView tbody").
                find('.selected').find('.resolutionName').html();
        var el = mt.findItemInTemplate(
                'name', name, nge.Cfg.Resolutions
                );

        if (!name || !el) {
            return false;
        }

        var scheme = _resolutionEditingModel;
        var model = nge.Lib.Helper.jsObjClone(scheme);
        for (var k in model) {
            model[k] = nge.Lib.Helper.recursiveGet(model[k], el);
        }
        model.scheme = scheme;
        _modelsEditor.edit(model, 'resolution', el._fixed);
    };

    this.modelRowEdit = function (model) {
        var v = model.value;
        var k = model.key;
        if (!isNaN(v))
            v = parseFloat(v);

        var name = $("#resolutionsTreeView tbody").
                find('.selected').find('.resolutionName').html();
        var el = mt.findItemInTemplate(
                'name', name, nge.Cfg.Resolutions
                );

        var scheme = _resolutionEditingModel;
        nge.Lib.Helper.recursiveSet(scheme[k], v, el);

        if (el.width > el.height)
            el.orientation = 0;
        else
            el.orientation = 1;

        if (k === 'name') {
            $("#resolutionsTreeView tbody").
                    find('.selected').find('.resolutionName').html(v);
        }

        return true;
    };

    this.resolutionSelect = function (name) {
        if (!name)
            name = $("#resolutionsTreeView tbody").
                    find('.selected').find('.resolutionName').html();

        var el = mt.findItemInTemplate(
                'name', name, nge.Cfg.Resolutions
                );

        if (!name || !el) {
            return false;
        }

        //unmark resolutions
        $("#resolutionsTreeView tbody").each(function () {
            $(this).find('.resolutionName').removeClass('star').
                    removeClass('file').addClass('file');
        });
        //mark resolution with star
        $("#resolutionsTreeView tbody").
                find("[data-tt-id='" + name + "']").find('.resolutionName').
                removeClass('file').addClass('star');
        //set resolution to service
        nge.objectsEditor.setResolution(el.name);
        return true;
    };

    var _treePattern = '<tr data-tt-id="{name}"{parent}><td><span class="{type} resolutionName">{name}</span></td></tr>';
    var _treeParentPattern = ' data-tt-parent-id="{pid}"';

    var _resolutionPattern = {
        "name": 'newResolution',
        "width": 1600,
        "height": 1000,
        "orientation": 0
    };

    var _resolutionEditingModel = {
        'name': 'name',
        'width': 'width',
        'height': 'height'/*,
         'orientPortrait(0/1)': 'orientation'*/
    };
};



nge.Mlm.Brain = {};



nge.Mlm.Brain.Sounds = Class.extend(function () {

    this.soundsUnused = []; //array of sounds keys
    this.soundExt = [];

    /**
     * s: soundKey in the games cache. see 'cfg/sounds.js' to find loaded sound files keys
     * e: event name which sound manager will be listen
     * action: action which soundManager will fire. default action is 'play'.
     * if action is empty willl be fired 'sound.play' action. 
     * otherwise 'sound.[action]' action will be fired.
     * check soundManager for available actions(ex. 'play', 'pause', 'resume','stop', 'volume')
     * @type {Array}
     */
    this._soundCfgBase = [
        {s: 'animClown', e: 'sound.winLineSymbols.TopAward', action: 'play', loop: false},
        {s: 'animClown', e: 'sound.winLineSymbols.TopAward', action: 'volume', volume: 0.5},
        {s: 'bigWin', e: 'bigWin'},
        {s: 'clickCloseBtn', e: 'clickCloseBtn'},
        {s: 'clickV1', e: 'button.click'},
        {s: 'gambleLose', e: 'gamble.lose'},
        {s: 'gambleWin', e: 'gamble.win'},
        {s: 'lineHighliteV1', e: 'winlines.lineHighlite.start'},
        {s: 'lose', e: 'loose'},
        {s: 'otherAnim', e: 'winlines.lineHighlite.start'},
        {s: 'spinCrunk', e: 'slotMachine.spinStart'},
        {s: 'spinStopV1', e: 'slotMachine.spinComplete'},
        {s: 'whooshReel1', e: 'slotMachine.reel_0.animation.start'},
        {s: 'whooshReel2', e: 'slotMachine.reel_1.animation.start'},
        {s: 'whooshReel3', e: 'slotMachine.reel_2.animation.start'},
        {s: 'whooshReel4', e: 'slotMachine.reel_3.animation.start'},
        {s: 'whooshReel5', e: 'slotMachine.reel_4.animation.start'},
        {s: 'win', e: 'win'}
    ];

    this.subscribe = function () {
        var totalSoundsArr = [];
        var allSoundsList = this.soundExt.concat(this._soundCfgBase);

        //removing unused sounds
        for (var i = 0; i < allSoundsList.length; i++)
            if (this.soundsUnused.indexOf(allSoundsList[i].s) === -1)
                totalSoundsArr.push(allSoundsList[i]);

        nge.localData.set('brain.sounds.cfg', totalSoundsArr);
        _subscribeCfg(totalSoundsArr);

        if (this.customSubscribe)
            this.customSubscribe();

        return true;
    };

    var _subscribeCfg = function (cfg) {
        for (var k in cfg) {
            var sound = cfg[k];

            if (!sound.action)
                sound.action = 'play';

            var eName = 'sound.' + sound.e + '-' + sound.s;

            //remove event if exists
            nge.observer.remove(sound.e, false, eName);

            //add sound event
            (function (sound, eName) {
                nge.observer.add(
                    sound.e,
                    function () {
                        nge.observer.fire('sound.' + sound.action, sound);
                    },
                    eName,
                    true
                    );
            })(sound, eName);
        }
    };
});



nge.Mlm.Brain.Controller = Class.extend(function () {
    var _gsId;
    var _self = this;

    this._logicBlocks = [
        'blackJack', 'cheats', 'game', 'keno', 'main', /*'phrases', */'poker',
        'scratch', 'slot', 'sounds'
    ];
    this._logicBlocksInstances = {};

    var _transportRequests = [];
    var _transportRequestTime = 0;
    var _transportRequestMaxDelay = 15000;

    this.do = function () {
        var params = Array.prototype.slice.call(arguments);
        params.unshift(_self);
        var res = nge.Lib.Helper.logicBlocksDo.apply(this, params);
        return res;
    };

    this.init = function () {
        _createLogicBlocksInstances();
        _self.do('subscribe');
        _subscribe();
        return true;
    };

    this.showGamePlayState = function () {
        //game
        _self.do('showGamePlayState');
    };

    var _createLogicBlocksInstances = function () {
        for (var k in _self._logicBlocks) {
            var name = _self._logicBlocks[k];
            var nameCap = nge.Lib.Helper.capitaliseFirstLetter(name);
            _self._logicBlocksInstances[name] = nge.App.getInstance('Mlm.Brain.' + nameCap);
        }
    };

    var _subscribe = function () {

        nge.observer.add(
            'brain.openGameSuccess',
            function (data) {
                _gsId = data.gsId;
                _self.do('setGsId', _gsId);
            },
            false,
            true
            );

        nge.observer.add(
            'Transport.close',
            function (data) {
                _gsId = false;
                _self.do('setGsId', _gsId);
            },
            false,
            true
            );

        return true;
    };
});



nge.Mlm.Brain.FeaturesCfg = Class.extend(function () {
    this.required = ['SimpleSlot'];
    this.supported = ['Offers', 'Jackpots'];
});



nge.Mlm.Brain.Cheats = Class.extend(function () {
    var _self = this;

    this.subscribe = function () {
        //out LoadCheatCodesRequest
        nge.observer.add('cheatsManager.getList', _self.getListHandler, false, true);

        //in LoadCheatCodesResponse
        nge.observer.add('transportMessage.LoadCheatCodesResponse', _self.listResponceHandler, false, true);

        //out cheat
        nge.observer.add('brain.CheatRequest', _self.cheatRequestHandler, false, true);

        //in cheat
        nge.observer.add('transportMessage.CheatResponse', _self.cheatResponseHandler, false, true);
    };

    this.getListHandler = function () {
        var mm = nge.App.getInstance('Mlm.Transport.Models.LoadCheatCodesRequest', false, {
            'msgId': 'a5ed3e5e-ae0a-9574-1fb9-609c33c263f0',
            'result': true,
            'data': {}
        });

        nge.transport.send(mm);
    };

    /**
     * 
     * @param {Object} data - like {data: {codes:{codeTitle1:codeCode1, codeTitle2:codeCode2}}}
     * @returns {undefined}
     */
    this.listResponceHandler = function (data) {
        data = data.data;
        nge.observer.fire('cheatsManager.list', data);
    };

    this.cheatRequestHandler = function (code) {
        var mm = nge.App.getInstance('Mlm.Transport.Models.CheatRequest', false, {
            "msgId": "85091bd5-79ea-4b23-8224-5a0c1c593e53",
            'result': true,
            "data": {
                "code": code
            }
        });

        nge.transport.send(mm);
    };

    this.cheatResponseHandler = function (data) {
        //do nothing
    };
});



nge.Mlm.Brain.Game = Class.extend(function () {
    var _gsId;
    var _self;

    this.setGsId = function (id) {
        _gsId = id;
    };

    this.getGsId = function () {
        return _gsId;
    };

    var _selfDestroy = function () {
        nge.statesManager.stop();

        setTimeout(function () {
            nge.observer.clear();
            window.nge = null;
            delete window.nge;

            window.onerror = function () {
                return true;
            };
        }, 1);  //run after 1 second to end some observer pocesses
    };

    this.subscribe = function () {
        _self = this;

        nge.observer.add('fatal.error', _selfDestroy, false, true);

        nge.observer.add(
            'Transport.close',
            function (type) {
                var firstAuthComplete = nge.localData.get('brain.firstAuthComplete');

                if (!firstAuthComplete) {
                    var code = 'Network Error';
                    var description = 'Unknown error. Please try again later';
                    nge.userFatalErrorHTML(code, description);

                    return false;
                }

                _userInfoReconnect();

                var msg = 'Disconnected! Trying to restore connection...';
                nge.brain.do('clearWaitingList');
                nge.observer.fire('infoPanel.show', msg);
                nge.observer.fire('brain.disableButtons');
                nge.observer.fire('Transport.clearMessagesQuery');
                nge.observer.setPrefix('disconnected');

                var reconnectDelay = nge.Lib.Helper.getRandomInt(1000, 15000);
                nge.localData.set('brain.transport.reconnectDelay', reconnectDelay);
                nge.rafSetTimeout(nge.transport.reconnect, reconnectDelay);
            },
            false,
            true
            );

        nge.observer.add(
            'Transport.open',
            function (type) {
                var msg = 'Hurray ! Connection restored!';
                nge.localData.set('brain.transport.reconnectDelay', false);
                nge.brain.do('clearWaitingList');
                nge.observer.fire('infoPanel.show', msg);
                nge.observer.fire('brain.enableButtons');
                //we can do new messages )))
                nge.observer.fire('Transport.clearMessagesQuery');
            },
            false,
            true
            );

        _self.gambleSubscription();
        _self.welcomeSubscription();
        _self.tutorialSubscription();
        _self.freeGamesSubscription();

        nge.observer.add('welcomePopup.showTutorial', _self.welcomePopupTutorial, false, true);
        nge.observer.add('infoPanel.stakeChanged', _self.updateInfoPanel, false, true);
        nge.observer.add('coins.change', _self.updateInfoPanel, false, true);
        nge.observer.add('bet.change', _self.updateInfoPanel, false, true);
        nge.observer.add('lines.change', _self.updateInfoPanel, false, true);
        nge.observer.add('brain.restoredGame', _self.restoreGame, false, true);

        _self.customSubscribe();
        return true;
    };

    this.welcomeSubscription = function () {
        nge.observer.add(
            'Com.Base.animateDefault.end',
            function () {
                if (nge.localData.get('showTutorial'))
                    nge.observer.fire('welcomePopup.show');
                else
                    nge.observer.fire('freeGames.show');
            },
            false,
            true
            );
    };

    this.tutorialSubscription = function () {
        nge.observer.add(
            'welcomePopup.hidden',
            function () {
                nge.observer.fire('tutorial.show');
            },
            false,
            true
            );
    };

    this.freeGamesSubscription = function () {
        nge.observer.add(
            'tutorial.closed',
            function () {
                nge.observer.fire('freeGames.show');
            },
            false,
            true
            );
    };

    this.welcomePopupTutorial = function (show) {
        var mm = nge.App.getInstance('Mlm.Transport.Models.TutorialRequest', false, {
            "msgId": "85091bd5-79ea-4b23-8224-5a0c1c593e53",
            "data": {
                "showTutorial": show
            }
        });
        nge.transport.send(mm);
        return true;
    };

    this.gambleSubscription = function () {
        nge.observer.add(
            'gamble.actionRequest',
            function (data) {
                var mm = nge.App.getInstance('Mlm.Transport.Models.GambleRequest', false, {
                    'msgId': '37e88b5c-18e9-9075-1720-d77e12802e49',
                    'gsId': _self.getGsId(),
                    'result': true,
                    'data': (data) ? data : {}
                });
                nge.transport.send(mm);
                nge.brain.do('waitForResponse', 'Gamble');
            },
            false,
            true
            );

        nge.observer.add(
            'transportMessage.GambleResponse',
            function (data) {
                nge.brain.do('receivedResponse', 'Gamble');
                data = data.data;
                nge.observer.fire('gamble.response', data);
            },
            false,
            true
            );
    };

    this.customSubscribe = function () { };

    this.updateInfoPanel = function () {
        var linesCfg = nge.localData.get('lines.cfg');
        var betCfg = nge.localData.get('bet.cfg');
        var currency = nge.localData.get('currency');

        if (!linesCfg)
            return false;

        var totalLines = linesCfg.length;
        var totalBet = betCfg.length;
        var l = nge.localData.get('lines.value');
        var b = nge.localData.get('bet.value');
        var c = nge.localData.get('coins.value');
        var stake = l * b * c;
        var mainInfoText;

        if (totalLines > 1)
            mainInfoText = nge.i18n.get('bet_per_line',
                nge.Lib.Validator.floatMoney(b * c, true),
                currency,
                nge.Lib.Validator.floatMoney(stake, true));
        else
            mainInfoText = nge.i18n.get('coins_total_bet',
                nge.Lib.Validator.floatMoney(c, true),
                currency,
                nge.Lib.Validator.floatMoney(stake, true));


        //linesInfoText
        var linesInfoText = '';
        if (totalLines > 1)
            linesInfoText = nge.i18n.get('number_lines', l);

        //coinsInfoText
        var coinsInfoText = '';

        if (totalBet > 1)
            coinsInfoText = nge.i18n.get('coins_per_line', b);

        mainInfoText = linesInfoText + coinsInfoText + mainInfoText;

        nge.observer.fire('infoPanel.show', mainInfoText);
    };

    this.updateBalance = function () {
        var currentBalance = nge.localData.get('balance');

        if (!currentBalance) {
            console.warn('nge.Mlm.Brain.Game.updateBalance: Cant update Balance! No currentBalance!');
            nge.rafSetTimeout(_self.updateBalance, 100);
            return true;
        }

        var l = nge.localData.get('lines.value');
        var b = nge.localData.get('bet.value');
        var c = nge.localData.get('coins.value');
        var bm = nge.localData.get('betMultiplier');
        var stake = l * b * c * bm;

        var newAmount =
            nge.Lib.Validator.float(currentBalance.totalAmount, true) -
            nge.Lib.Validator.float(stake, true);

        if (newAmount < 0)
            return false;

        var newBalance = {'totalAmount': newAmount, 'curr': currentBalance.curr};

        var freeGamesInProgress = nge.localData.get('freeGame.inProgress');

        if (!freeGamesInProgress)
            nge.observer.fire('balance.amount', newBalance);

        return true;
    };

    this.restoreGame = function (data) {
        if (!data.restoredGameCode)
            return false;

        nge.localData.set('brain.restoreGame', data);
    };

    this.showDefaultPlayState = function () {
        nge.statesManager.display('play', 'loader');
    };

    var _userInfoReconnect = function () {
        nge.observer.fire(
            'userInfo.setUpdate',
            (function () {
                var i = 0;
                var firstCallDelay = 1500;
                var lastCallDelay = -firstCallDelay;

                return function (delta) {
                    lastCallDelay += delta.deltaT;

                    if (lastCallDelay < 10)
                        return false;

                    var text = nge.i18n.get('RECONNECT ');
                    var alpha = Math.abs(50 - i % 100) / 50;

                    this.show({text: text, alpha: alpha});
                    lastCallDelay = 0;
                    i++;
                };
            })()
            );

        nge.observer.fire('userInfo.show', {text: nge.i18n.get('Connection lost')});
    };
});



nge.Mlm.Brain.Main = Class.extend(function () {
    var _authComplete = false;
    var _gameName = false;
    var _self;
    var _idleStatus = false;
    var _idleDelay = 60000; //ms
    var _lastActionTime = 0;
    var _gsId;
    var _waitForResponseTime = 5000; //5 sec
    var _waitForResponseData = {};
    var _firstLaunchPassed = false;

    this.setGsId = function (id) {
        _gsId = id;
    };

    this.getGsId = function () {
        return _gsId;
    };

    this.clearWaitingList = function () {
        for (var k in _waitForResponseData) {
            _removeWaiting(k);
        }
    };

    this.waitForResponse = function (key, waitTime) {
        if (!waitTime)
            waitTime = _waitForResponseTime;

        _removeWaiting(key);
        _waitForResponseData[key] = nge.rafSetTimeout(
            function () {
                _waitingFail(key);
            },
            waitTime
            );
    };

    this.receivedResponse = function (key) {
        _removeWaiting(key);
    };

    var _waitingFail = function (key) {
        nge.transport.close();
    };

    var _removeWaiting = function (key) {
        if (_waitForResponseData[key]) {
            nge.rafClearTimeout(_waitForResponseData[key]);
            delete _waitForResponseData[key];
        }
    };

    this.subscribe = function () {
        _self = this;
        _lastActionTime = nge.Lib.Time.get();
        _self.actionHandler();
        _self.idleDetect();

        //in SystemError
        nge.observer.add(
            'transportMessage.SystemError',
            function (data) {
                var text = data.data.debugMessage;
                nge.observer.fire('infoPanel.show', text);
            },
            false,
            true
            );

        //out auth
        nge.observer.add(
            'brain.authRequest',
            function () {
                //reauth on reconnect handler
                nge.observer.add(
                    'transport.ready',
                    _authFunction,
                    false,
                    true
                    );

                var transportReady = nge.localData.get('transport.ready');

                if (transportReady)
                    _authFunction();
            },
            false,
            true
            );

        //out JackpotAmountRequest
        nge.observer.add(
            'jackpotRequest',
            function () {
                var mm = nge.App.getInstance('Mlm.Transport.Models.JackpotAmountRequest', false, {
                    "msgId": "85091bd5-79ea-4b23-8224-5a0c1c593e53",
                    'gsId': _gsId,
                    'result': true,
                    "data": {}
                });
                nge.transport.send(mm);
            },
            false,
            true
            );

        nge.observer.add(
            'transportMessage.JackpotAmountResponse',
            function (data) {
                nge.localData.set('jackpot', data.data);
                nge.observer.fire('jackpot.amount', data.data);
            },
            false,
            true
            );

        //out BalanceRequest
        nge.observer.add(
            'balanceRequest',
            function () {
                if (!_gsId)
                    return false;

                var mm = nge.App.getInstance('Mlm.Transport.Models.BalanceRequest', false, {
                    "msgId": "85091bd5-79ea-4b23-8224-5a0c1c593e53",
                    'result': true,
                    "data": {}
                });
                nge.transport.send(mm);
                nge.brain.do('waitForResponse', 'Balance');
            },
            false,
            true
            );

        //in balance
        nge.observer.add(
            'transportMessage.BalanceResponse',
            function (data) {
                nge.brain.do('receivedResponse', 'Balance');
                nge.localData.set('balance', data.data);
                nge.observer.fire('balance.amount', data.data);
            },
            false,
            true
            );

        //in BalanceUpdateNotification
        nge.observer.add(
            'transportMessage.BalanceUpdateNotification',
            function (data) {
                nge.localData.set('balance', data.data);
                nge.observer.fire('balance.amount', data.data);
            },
            false,
            true
            );

        nge.observer.add(
            'transportMessage.APIVersionResponse',
            _APIVersionResponse,
            false,
            true
            );

        nge.observer.add(
            'transportMessage.CheckBrokenGameResponse',
            _checkBrokenGameResponse,
            false,
            true
            );

        //in openGame
        nge.observer.add(
            'transportMessage.AuthResponse',
            function (data) {

                if (data.cmd === 'SystemError') {
                    nge.observer.fire('brain.disableButtons');
                    return false;
                }

                nge.localData.set('brain.firstAuthComplete', true);
                nge.brain.do('receivedResponse', 'Auth');

                var data = data.data;

                //Game Session ID
                data.gsId = 'GS' + nge.Lib.Helper.getRandomInt(1000000, 9999999);

                //reset data
                nge.localData.set('brain.restoreGame', false);
                nge.localData.set('bonusGame.lastResponse', false);
                nge.localData.set('freespin', false);
                nge.localData.set('respin', false);

                //save Data 4 slotMachine
                nge.localData.set('slotMachine', data);
                nge.localData.set('pokerMachine', data);
                //bet (coins per line)
                var betCFG = [];
                if (typeof data.bets === 'number') {
                    for (var i = 1; i <= data.bets; i++) {
                        betCFG.push(i);
                    }
                } else {
                    //normal array
                    betCFG = data.bets;
                }

                if (betCFG.length === 0)
                    betCFG = [1];

                nge.localData.set('bet.cfg', betCFG);

                if (data && data.defaultBet)
                    nge.localData.set('bet.value', data.defaultBet);
                
                //betMultiplier (setting once)
                nge.localData.set('betMultiplier', (data.betMultiplier) ? parseFloat(data.betMultiplier) : 1);

                //lines
                if (data && data.gameParameters && data.gameParameters.maxLines) {
                    var linesCFG = [];

                    for (var i = 1; i <= data.gameParameters.maxLines; i++) {
                        linesCFG.push(i);
                    }

                    if (linesCFG.length === 0)
                        linesCFG = [0];

                    nge.localData.set('lines.cfg', linesCFG);
                }

                if (data && data.defaultLines) {
                    var curLines = data.defaultLines;
                    if (typeof curLines === 'object')
                        curLines = data.defaultLines.length;

                    nge.localData.set('lines.value', curLines);
                }

                //coins (coins size)
                var coinsCFG = [];
                if (data.coinValues)
                    coinsCFG = data.coinValues;

                if (coinsCFG.length === 0)
                    coinsCFG = [1];

                nge.localData.set('coins.cfg', coinsCFG);

                if (data.showTutorial)
                    nge.localData.set('showTutorial', data.showTutorial);

                if (data && data.defaultCoinValue)
                    nge.localData.set('coins.defaultCoin', data.defaultCoinValue);
                
                if (data && data.gameParameters && data.gameParameters.rtp)
                    nge.localData.set('rtp', data.gameParameters.rtp);

                if (data && data.gameParameters && data.gameParameters.payouts)
                    nge.localData.set('payout.cfg', data.gameParameters.payouts);

                if (data && data.gameParameters && data.gameParameters.availableLines)
                    nge.localData.set('winlines', data.gameParameters.availableLines);

                nge.observer.fire('brain.openGameSuccess', data);

                //restoredGameCode
                if (data.restoredGameCode && data.lastResponse) {
                    if (data.restoredGameCode === nge.localData.get('gameCode')) {
                        nge.observer.fire('brain.restoredGame', data);
                    } else {
                        console.error('data.restoredGameCode form different game: ',
                            data.restoredGameCode
                            );
                        return false;
                    }
                }

                //set sesId
                nge.transport.setSESID(data.sessionId);

                //make focus
                nge.wrap.states.focusCanvas();

                //get balance
                nge.observer.fire('balanceRequest');

                if (data && data.gameParameters && data.gameParameters.freeGameRounds) {
                    var freeGames = data.gameParameters.freeGameRounds;
                    if (freeGames) {
                        freeGames = {
                            inProgress: true,
                            amount: data.gameParameters.freeGameRounds,
                            totalAmount: data.gameParameters.freeGameRounds,
                            coin: data.gameParameters.freeGameCoin,
                            coinsPerBet: data.gameParameters.freeGameCoinsPerBet,
                            freeGameExpiration: data.gameParameters.freeGameExpiration,
                            lines: data.gameParameters.freeGameLines || 0
                        };
                        nge.localData.set('freeGame', freeGames);
                    }
                }

                //if reconnect
                if (_gameName)
                    nge.observer.fire('brain.openGame');

                var lang;
                if (!data.language) {
                    //use defaults
                    lang = nge.Cfg.Main.lang;
                } else {
                    lang = data.language;
                }
                
                nge.Cfg.Main.lang = lang;
                nge.localData.set('lang', lang);

                //load i18n file if need
                nge.i18n.update();

                //reconnect
                if (_firstLaunchPassed)
                    nge.statesManager.display(nge.statesManager.getDefaultState());
                else
                    _firstLaunchPassed = true;
            },
            false,
            true
            );

        nge.observer.add('history.request', function (gameRoundId) {
            var mm = nge.App.getInstance('Mlm.Transport.Models.HistoryDetailRequest', false, {
                "msgId": "85091bd5-79ea-4b23-8224-5a0c1c593e53",
                'result': true,
                "data": {
                    "@type": "HistoryDetailRequest",
                    "gameRoundId": gameRoundId
                }

            });
            nge.transport.send(mm);
        }, false, true);

        nge.observer.add('transportMessage.common', function (data) {
            var data = data.data;

            if (data && data.gameParameters && data.gameParameters.initialSymbols)
                nge.localData.set('slotMachine.gameParameters.initialSymbols', data.gameParameters.initialSymbols);
        }, false, true);

        this.customSubscribe();
        return true;
    };

    var _authFunction = function () {
        _APIVersionRequest();
    };

    var _APIVersionRequest = function () {
        var apiVerArr = nge.Cfg.Main.apiVersion.split('.');

        var mm = nge.App.getInstance('Mlm.Transport.Models.APIVersionRequest', false, {
            "msgId": "32c44111-f0b7-4e4f-b774-2aa86cfd8e2a",
            'result': true,
            "data": {
                "versionMajor": apiVerArr[0] || 0,
                "versionMinor": apiVerArr[1] || 0,
                "gameId": nge.gameCode
            }
        });

        nge.transport.send(mm);
        nge.brain.do('waitForResponse', 'APIVersion', 30000); //30sec
    };

    var _APIVersionResponse = function (data) {
        nge.brain.do('receivedResponse', 'APIVersion');

        if (!data || !data.result) {
            var descr = 'API version error';
            console.error(descr);
            nge.userFatalErrorHTML('Auth Error', descr);
            return false;
        }

        _waitForResponseTime = parseFloat(nge.Lib.Helper.recursiveGet(
            'data.transportConfig.reconnectTimeout',
            data,
            _waitForResponseTime
            ));

        _checkBrokenGameRequest();
    };

    var _checkBrokenGameRequest = function () {
        var userId = nge.Lib.Helper.parseGetParams('userId');
        var upass = nge.Lib.Helper.parseGetParams('upass');
        var gameMode = nge.Lib.Helper.parseGetParams('gameMode');
        var userData = _getUserData();

        var mm = nge.App.getInstance('Mlm.Transport.Models.CheckBrokenGameRequest', false, {
            "msgId": "32c44111-f0b7-4e4f-b774-2aa86cfd8e2a",
            'result': true,
            "data": {
                "userId": userId || 0,
                "authToken": upass || "",
                "gameMode": gameMode || "normal",
                "userData": userData
            }
        });

        nge.transport.send(mm);
        nge.brain.do('waitForResponse', 'CheckBrokenGame', 30000); //30sec
    };

    var _checkBrokenGameResponse = function (data) {
        nge.brain.do('receivedResponse', 'CheckBrokenGame');
        var data = data.data;
        if (!data) {
            var descr = 'CheckBrokenGameResponse no data !!!';
            console.error(descr);
            nge.userFatalErrorHTML('Auth Error', descr);
            return false;
        }

        if (!data.haveBrokenGame || data.haveBrokenGame === 'false') {
            _sendAuthRequest();
            return false;
        }

        //restoring game
        var restoredGameCode = data.restoredGameCode.toString();
        var curGameCode = nge.Cfg.Main.gameCode.toString();

        if (restoredGameCode === curGameCode) {
            _sendAuthRequest();
            return false;
        }

        //restoring other game
        //launcher.html?game=12&userId=123123
        var userId = nge.Lib.Helper.parseGetParams('userId');
        var upass = nge.Lib.Helper.parseGetParams('upass');

        var urlParams = nge.Lib.Helper.parseGetParams();
        urlParams.game = restoredGameCode;

        var urlParamsStrings = [];

        for (var k in urlParams)
            urlParamsStrings.push(k + '=' + urlParams[k]);

        var querystring = urlParamsStrings.join("&");

        window.location.href = '../../launcher.html?' + querystring;
    };

    var _sendAuthRequest = function () {
        var gameCode = gid || nge.Cfg.Main.gameCode;
        nge.localData.set('gameCode', gameCode);
        _authComplete = true;

        var features = nge.App.getInstance('Mlm.Brain.FeaturesCfg');

        var mode = nge.Lib.Helper.parseGetParams('mode');
        var userId = nge.Lib.Helper.parseGetParams('userId');
        var upass = nge.Lib.Helper.parseGetParams('upass');
        var gid = nge.Lib.Helper.parseGetParams('gid');
        var pid = nge.Lib.Helper.parseGetParams('pid');
        var userData = _getUserData();

        var mm = nge.App.getInstance('Mlm.Transport.Models.AuthRequest', false, {
            "msgId": "32c44111-f0b7-4e4f-b774-2aa86cfd8e2a",
            'result': true,
            "data": {
                "userId": userId || 0,
                "authToken": upass || "",
                //"gamePlayMode": (mode) ? mode : "fun",
                "gameCode": gameCode,
                expectedFeatures: {//todo
                    required: features.required,
                    supported: features.supported
                },
                "productId": pid || "test",
                "userData": userData
            }
        });

        nge.transport.send(mm);
        nge.brain.do('waitForResponse', 'Auth', 30000); //30sec
    };

    var _getUserData = function () {
        var osData = nge.Lib.Helper.getOsAndVersion();

        return {
            "os": osData.os, //OS
            "osVersion": osData.version,
            "mobile": nge.Lib.Helper.mobileAndTabletCheck(),
            "browser": nge.Lib.Helper.browserDetect(),
            "jsCoreVersion": nge.Cfg.Main.version,
            "gameVersion": nge.Cfg.Main.gameVersion,
            "apiVersion": nge.Cfg.Main.apiVersion,
            "initialResolution": nge.resolutionsManager.getCurrent()
        };
    };

    this.actionHandler = function () {
        nge.observer.add(
            'button.click',
            function () {
                _lastActionTime = nge.Lib.Time.get();
            },
            false,
            true
            );
    };

    this.idleDetect = function () {
        nge.observer.add(
            'StatesManager.update.start',
            function () {
                var delta = nge.Lib.Time.get() - _lastActionTime;
                //log(delta, _idleDelay, _idleStatus)
                if (delta > _idleDelay && !_idleStatus) {
                    _idleStatus = true;
                    nge.observer.fire('idle.start');
                }
                if (delta <= _idleDelay && _idleStatus) {
                    _idleStatus = false;
                    nge.observer.fire('idle.end');
                }
            },
            false,
            true
            );
    };

    this.customSubscribe = function () {

    };
});


nge.Mlm.ResolutionsManager = {};



nge.Mlm.ResolutionsManager.Controller = function () {
    var _activeResolution = false; //object
    var _active = false; //is this an active module?
    var _resCfg; //Cfg.Resolutions.contents
    var _adaptiveCfg; //Cfg.Resolutions.adaptiveCfg
    var _templateSize = {orientation: 0, width: 0, height: 0};
    var _statesOrientations = {};
    var _currentOrientation = null;

    var _winParams = {}; // cache window size

    var _set = function (resolution) {
        var res;
        if (typeof resolution === 'string') {
            res = _resCfg.filter(
                function (element) {
                    return element.name === resolution;
                }
            );
            res = res[0];
        } else
            res = resolution;

        if (!res)
            return false;

        var dp = window.devicePixelRatio;
        var mobile = nge.Lib.Helper.mobileAndTabletCheck();

        //calc templete size start
        var keysArr = ['width', 'height'];
        _templateSize.orientation = res.orientation;

        for (var i = 0; i < keysArr.length; i++)
            _templateSize[keysArr[i]] = res.base[keysArr[i]];

        if (res.adaptive) {
            var ttkey = (res.width / res.height > res.base.width / res.base.height) ? 0 : 1;
            var otkey = (ttkey === 1) ? 0 : 1;

            _templateSize[keysArr[ttkey]] = ~~(res[keysArr[ttkey]] * res.base[keysArr[otkey]] / res[keysArr[otkey]]);
        }
        //calc templete size end

        //maxResolutionFactor
        var maxResolutionFactor = Math.min(nge.App.getInstance('Cfg.Resolutions').maxSize() / Math.max(res.width, res.height), 1);
        var cRes = {
            width: ~~(res.width * maxResolutionFactor),
            height: ~~(res.height * maxResolutionFactor)
        };

        //resize canvas
        nge.wrap.states.resize(cRes.width, cRes.height);

        //props scale 
        nge.wrap.states.world.scale.x = cRes.width / _templateSize.width;
        nge.wrap.states.world.scale.y = cRes.height / _templateSize.height;

        //canvas css scale
        var canvas = nge.wrap.states.renderer.view;
        $(canvas).css('width', res.width / dp);
        $(canvas).css('height', res.height / dp);

        PIXI.settings.TEXT_RESOLUTION = 1; // (!mobile) ? 1 : 1 / window.devicePixelRatio; //res.width * window.devicePixelRatio / _resCfg[0].width; //todo test this formule

        _activeResolution = res;
        return true;
    };

    var _refresh = function () {
        if (!_active)
            return false;

        var iOS = nge.Lib.Device.iOS;

        var win = {
            width: iOS ? window.innerWidth : $(window).width(),
            height: iOS ? window.innerHeight : $(window).height()
        };

        // this code block repairs jquery chrome bug on android devices
        // with orientation and resizing by caching width/height params
        if (nge.game.scale.isLandscape && nge.device.android) {
            var isFS = nge.game.scale.isFullScreen;

            if (!isFS && !_winParams.notFullScreen) {
                _winParams.notFullScreen = {};
                _winParams.notFullScreen.width = win.width;
                _winParams.notFullScreen.height = win.height;
            } else if (isFS && !_winParams.fullScreen) {
                _winParams.fullScreen = {};
                _winParams.fullScreen.width = win.width;
                _winParams.fullScreen.height = win.height;
            }

            win.width = isFS ? _winParams.fullScreen.width : _winParams.notFullScreen.width;
            win.height = isFS ? _winParams.fullScreen.height : _winParams.notFullScreen.height;
        }

        if (window.devicePixelRatio && window.devicePixelRatio !== 1) {
            win.width *= window.devicePixelRatio;
            win.height *= window.devicePixelRatio;
        }

        var orientation = win.width > win.height ? 0 : 1;
        var factor = win.width > win.height ? 'width' : 'height';

        var current = _resCfg[0];
        if (_resCfg.length > 1) {
            //select optimal
            for (var k in _resCfg) {
                var res = _resCfg[k];
                if (res.orientation !== orientation)
                    continue;

                if (
                    (current.orientation !== orientation) ||
                    (current[factor] < res[factor] && res[factor] < win[factor]) ||
                    (win[factor] < current[factor] && res[factor] < current[factor])
                    )
                    current = res;
            }
        }

        // TODO: это условие ломает неадаптивный режим. Этот блок должен выполняться вне зависимости от количества конфигов и адаптивности
        // TODO: подумать как мы можем использовать набор заготовленных заранее размеров экранов и надо ли нам теперь это, если у нас в арсенале есть адаптивная верстка ?
        //if (_resCfg.length === 1 || current.adaptive) 
        {
            //gen from current
            var curProp = current.width / current.height;
            var winProp = win.width / win.height;

            if (current.adaptive) {
                var key = nge.device.desktop ? 'desctop' : 'mobile';
                var adaptiveParams = _adaptiveCfg[key];
                if (adaptiveParams.supported) {
                    var orientationKey = orientation ? 'vertical' : 'horizontal';
                    var limits = adaptiveParams.limits[orientationKey];
                    curProp = nge.Lib.Helper.intMakeBetween(winProp, limits.min, limits.max);
                }
            }

            var temp = nge.Lib.Helper.jsObjClone(current);
            temp.name = 'temp';
            temp.base = current;

            if (curProp > winProp) {
                temp.width = Math.floor(win.width);
                temp.height = Math.floor(temp.width / curProp);
            } else {
                temp.height = Math.floor(win.height);
                temp.width = Math.floor(temp.height * curProp);
            }

            current = temp;
        }

        _set(current);
        log('set new Resolution', nge.Cfg.Main.orientations[_templateSize.orientation], current, 'win params:', win);

        // TODO: Событие смены разрешения должно также отправлять новый размер шаблона, так как просто разрешение не имеет значения для дерева объектов
        nge.observer.fire('resolutionsManager.newResolution', {resolution: current, template: _templateSize});

        if (_currentOrientation !== _templateSize.orientation) {
            _currentOrientation = _templateSize.orientation;
            _setOrientationClass();
            nge.observer.fire('resolutionsManager.orientation.change', nge.Cfg.Main.orientations[_templateSize.orientation]);
        }

        return true;
    };

    var _setOrientationClass = function () {
        let stateName = nge.statesManager.getCurrentName() + 'State';
        let state = nge.findOne('^' + stateName);
        if (!state)
            return;

        var oldClass = _statesOrientations[stateName] || null;
        var newClass = nge.Cfg.Main.orientations[_templateSize.orientation];

        if (oldClass !== newClass) {
            _statesOrientations[stateName] = newClass;

            if (state.hasClass(oldClass))
                state.removeClass(oldClass, true);
            if (!state.hasClass(newClass))
                state.addClass(newClass, true);

            nge.objects.setStyles(state);
            nge.App.removeSysInstancesMode(oldClass);
            nge.App.addSysInstancesMode(newClass);
        }
    };

    var _subscribe = function () {
        nge.observer.add('window.resize', _refresh, false, true);
        nge.observer.add('StatesManager.create.end', _setOrientationClass, false, true);

        // TODO: подписка на это событие уже есть в run.js. Из-за этого refresh срабатывает 2 раза за одно изменение разрешения. Нужно оставить только одну подписку
        /*var windowResizeEVT = function () {
         nge.observer.fire('window.resize');
         };
         
         $(window).resize(windowResizeEVT);*/

        return true;
    };

    /**
     * 
     * @param {mixed} resolution resName/resObject
     * @returns {Boolean} result
     */
    this.set = function (resolution) {
        return _set(resolution);
    };

    this.getName = function () {
        return _activeResolution.name;
    };

    this.getCurrent = function () {
        return _activeResolution;
    };

    this.getTemplateSize = function () {
        return _templateSize;
    };

    this.refresh = function () {
        return _refresh();
    };

    this.init = function () {
        _resCfg = nge.App.getInstance('Cfg.Resolutions').get();
        _adaptiveCfg = nge.App.getInstance('Cfg.Resolutions').getAdaptive();
        _activeResolution = _resCfg[0];
        _active = true;
        _refresh();
        _subscribe();
    };
};



nge.Mlm.SoundManager = {};



nge.Mlm.SoundManager.Controller = function () {
    const FORMATS = ['ogg', 'm4a', 'mp3', 'wav'];

    this._isReady = false;
    this.format = null;
    this.cfg = null;
    this.sources = [];
    this.audios = null;

    this.isReady = () => {
        return this._isReady;
    };

    this.preload = () => {
        nge.localData.set('sounds.preload', 'started');
        const antiCacheSuffix = nge.assets.getAntiCacheSuffix();

        if (Howler.noAudio) {
            nge.rafSetTimeout(() => {
                nge.localData.set('sounds.preload', 'done');
                nge.observer.fire('sounds.preloaded');
            }, 1000);
            return true;
        }

        // TODO: звуковая подсистема имеет свой загрузчик до унификации метода загрузки
        this.loader = new nge.Mlm.Loader.Controller(nge.wrap.cache);


        let uber = null;
        if (nge.wrap.cache.checkJSONKey('uber_json'))
            uber = nge.wrap.cache.getJSON('uber_json');

        let spritemap;
        if (nge.Cfg.Main.mode === 'production' && !uber)
            return console.color('[SOUND MANAGER]: failed to load uber.json', '#ff0000', '#000000');
        if (nge.Cfg.Main.mode === 'production' && !uber['gameaudio.json'])
            return console.color('[SOUND MANAGER]: no gameaudio in uber.json', '#ff0000', '#000000');

        if (uber && uber['gameaudio.json'])
            spritemap = uber['gameaudio.json'].spritemap;
        else
            this.loader.addJSON('gameaudioJson', 'sounds/gameaudio.json' + antiCacheSuffix);

        const customSounds = nge.App.getInstance('Cfg.Sounds').custom;
        if (customSounds) {
            for (let key in customSounds) {
                const track = customSounds[key];

                let realPath = nge.realPathPrefix + track;
                realPath = realPath.replace('game:', nge.appPath).replace('sounds/', 'sounds/' + this.format + '/') + '.' + this.format + antiCacheSuffix;

                this.loader.addSound(key, realPath);
            }
        }

        this.loader.addSound('gameaudio', 'sounds/gameaudio.' + this.format + antiCacheSuffix);
        this.loader.onComplete.addOnce((err) => {
            if (!spritemap)
                spritemap = nge.wrap.cache.getJSON('gameaudioJson').spritemap;

            if (err)
                return console.color('[SOUND MANAGER]: failed to load gameaudio', '#ff0000', '#000000');

            spritemap = _.mapValues(spritemap, (value) => {
                return [value.start * 1000, (value.end - value.start) * 1000];
            });

            // TODO: необходимо удалить cfg/sounds.js и этот код
            Object.keys(this.cfg).forEach((key) => {
                const filename = this.cfg[key].replace('game:sounds/', '').replace('game:/sounds/', '').replace('game/sounds/', '');
                spritemap[key] = spritemap[filename];
            });

            const sprite = new Howl({
                src: [nge.wrap.cache.getBlob('gameaudio')],
                format: this.format,
                preload: true,
                sprite: spritemap
            });

            this.audios = {};
            for (let sound in spritemap) {
                this.audios[sound] = 
                {
                    source: sprite,
                    volume: 1
                };
            }
            this.sources.push(sprite);

            if (customSounds) {
                for (let key in customSounds) {
                    var howl = new Howl({
                        src: [nge.wrap.cache.getBlob(key)],
                        format: this.format,
                        preload: true
                    });
                    this.audios[key] = 
                    {
                        source: howl,
                        volume: 1
                    };
                    this.sources.push(howl);
                }
            }

            sprite.on('load', () => {
                console.color('[SOUND MANAGER]: gameaudio initialized', '#00ff00', '#000000');

                this._isReady = true;
                nge.localData.set('sounds.preload', 'done');
                nge.observer.fire('sounds.preloaded');
            });

            sprite.on('loaderror', (err) => {
                console.color('[SOUND MANAGER]: gameaudio initialization failed: ' + err, '#ff0000', '#000000');
            });

            sprite.on('play', (id) => {
                //console.color('[SOUND MANAGER]: play: ' + id, '#00ff00', '#000000');
            });

            sprite.on('playerror', (id, err) => {
                console.color('[SOUND MANAGER]: playback error: ' + id + ' - ' + err, '#ff0000', '#000000');
            });

            sprite.on('end', (id) => {
                const key = _.findKey(this.audios, ['id', id]);
                if (key)
                    nge.observer.fire('sound.stopped.' + key);
            });

            sprite.on('pause', (id) => {
                //console.color('[SOUND MANAGER]: stop: ' + id, '#00ff00', '#000000');
            });

            sprite.on('stop', (id) => {
                const key = _.findKey(this.audios, ['id', id]);
                if (key)
                    nge.observer.fire('sound.stopped.' + key);
            });

            sprite.on('unlock', () => {
                console.color('[SOUND MANAGER]: unlock', '#00ff00', '#000000');
            });
        });
        this.loader.start();
    };

    /**
     * Initialize sound manager
     * @returns {Boolen} initialization status
     */
    this.init = () => {
        this.cfg = nge.App.getInstance('Cfg.Sounds').contents;

        const supportedFormat = this.test(FORMATS);

        if (!supportedFormat) {
            Howler.noAudio = true;
            console.color('[SOUND MANAGER]: no supported formats detected. Entering silent mode...', '#ff0000', '#000000');
            return false;
        }

        console.color('[SOUND MANAGER]: use ' + supportedFormat + ' format', '#00ff00', '#000000');
        this.format = supportedFormat;

        // JSCLIENT-4206 workaround
        const howl = new Howl({
            src: [''],
            format: this.format,
            preload: true
        });

        this.subscribe();
        nge.localData.set('settings.sounds', nge.Cfg.Main.sounds);
        return true;
    };

    /**
     * Check if sound exists and ready for use
     * @param {String} key sound
     * @returns {Boolen} sound existance status
     */
    this.checkKey = (key) => {
        return this.cfg[key] && this.cfg[key].source;
    };

    /**
     * Get sound's duration in milliseconds
     * @param {String} key sound
     * @returns {Number} sound duration in milliseconds
     */
    this.getDurationMS = (key) => {
        if (!this.checkKey(key))
            return 0;
        
        const source = this.cfg[key].source;
        if(source._sprite)
            return ~~source._sprite[key][1];
        else
            return ~~source.duration();
    };

    /**
     * Get first supported format
     * @param {Array} codecs array of possible formats
     * @returns {String} supported format or false if no acceptable codecs found
     * @private
     */
    this.test = (codecs = []) => {
        for (let i in codecs) {
            if (Howler.codecs(codecs[i]))
                return codecs[i];
        }
        return null;
    };

    /**
     * Play single sound
     * @param {Object} cfg sound config
     * @returns {Boolean} success status
     */
    this.play = (cfg) => {
        if (!this.isReady() || !this.check(cfg.s))
            return false;

        const loop = cfg.loop || false;
        const relaunch = cfg.relaunch || false;
        const id = this.audios[cfg.s].id;

        if (id && this.audios[cfg.s].source.playing(id)) {
            if (relaunch)
                this.stop(cfg);
            else
                return false;
        }

        this.audios[cfg.s].id = this.audios[cfg.s].source.play(cfg.s);
        this.audios[cfg.s].source.loop(loop, this.audios[cfg.s].id);
        this.audios[cfg.s].source.volume(this.audios[cfg.s].volume, this.audios[cfg.s].id);

        return true;
    };

    /**
     * Pause single sound
     * @param {Object} cfg sound config
     * @returns {Boolean} success status
     */
    this.pause = (cfg) => {
        if (!this.isReady() || !this.check(cfg.s))
            return;

        const id = this.audios[cfg.s].id;
        if (!id || !this.audios[cfg.s].source.playing(id))
            return false;

        this.audios[cfg.s].source.pause(id);

        return true;
    };

    /**
     * Resume single sound
     * @param {Object} cfg sound config
     * @returns {Boolean} success status
     */
    this.resume = (cfg) => {
        if (!this.isReady() || !this.check(cfg.s))
            return;

        const id = this.audios[cfg.s].id;
        if (!id || this.audios[cfg.s].source.playing(id))
            return false;

        this.audios[cfg.s].source.play(id);

        return true;
    };

    /**
     * Check if sound subsystem is ready to use
     * @param {String} key sound key
     * @returns {Boolean} sounds subsystem status
     * @private
     */
    this.check = (key) => {
        const settings = nge.localData.get('settings.sounds');

        if (!settings || settings === 'off')
            return false;

        if (Howler.noAudio) {
            console.color('[SOUND MANAGER]: silent mode enabled', '#ff0000', '#000000');
            return false;
        }

        if (this.sources.length === 0) {
            console.color('[SOUND MANAGER]: sources list is empty', '#ff0000', '#000000');
            return false;
        }

        if(key) {
            if(!this.audios[key]) {
                console.color('[SOUND MANAGER]: no sound with key: ' + key, '#ff0000', '#000000');
                return false;
            }
            if(this.audios[key].source.state() !== 'loaded') {
                console.color('[SOUND MANAGER]: sprite is not ready: ' + this.audios[key].source.state(), '#ff0000', '#000000');
                return false;
            }
        }

        return true;
    };

    /**
     * Stop single sound
     * @param {Object} cfg sound config
     * @returns {Boolean} success status
     */
    this.stop = (cfg) => {
        if (!this.check(cfg.s))
            return false;

        const id = this.audios[cfg.s].id;

        if (!id)
            return false;

        this.audios[cfg.s].source.stop(id);
        // this.audios[cfg.s] = null;
        return true;
    };

    /**
     * Change volume for single sound
     * @param {Object} cfg sound config
     * @returns {Boolean} success status
     */
    this.volume = (cfg) => {
        if (!this.check(cfg.s))
            return false;

        this.audios[cfg.s].volume = cfg.volume;

        const id = this.audios[cfg.s].id;

        if (!id)
            return false;

        if (cfg.duration)
            this.audios[cfg.s].source.fade(this.audios[cfg.s].source.volume(null, id), cfg.volume, cfg.duration, id);
        else
            this.audios[cfg.s].source.volume(cfg.volume, id);

        return true;
    };

    /**
     * Change volume for all sounds
     * @param {Number} value volume
     * @returns {Boolean} success status
     */
    this.volumeAll = (value) => {
        if (!this.check())
            return false;

        Howler.volume(value);
        nge.localData.set('settings.globalVolume', value);

        return true;
    };

    /**
     * Stop all sounds
     * @returns {Boolean} success status
     */
    this.stopAll = () => {
        if (!this.check())
            return false;

        for(let source of this.sources) {
            source.stop();
        }

        return true;
    };

    /**
     * Stop all sounds and unload assets
     * @returns {Boolean} success status
     */
    this.destroyAll = () => {
        if (!this.check())
            return false;

        for(let source of this.sources) {
            source.unload();
        }

        this.audios = {};

        return true;
    };

    // Compability
    this.isSoundDecoded = (key) => {
        return this.isReady();
    };

    /**
     * Subsribe to observer events
     * @returns {Boolean} success status
     */
    this.subscribe = () => {
        nge.observer.add('sound.play', this.play, false, true);
        nge.observer.add('sound.pause', this.pause, false, true);
        nge.observer.add('sound.resume', this.resume, false, true);
        nge.observer.add('sound.stop', this.stop, false, true);
        nge.observer.add('sound.volume', this.volume, false, true);
        nge.observer.add('sound.volumeAll', this.volumeAll, false, true);
        nge.observer.add('sound.stopAll', this.stopAll, false, true);
        nge.observer.add('sound.destroyAll', this.destroyAll, false, true);
        nge.observer.add('settings.sounds.changed', _chkSettings, false, true);
        return true;
    };

    // TODO: Мусор
    var _chkSettings = function (state) {
        if (!state)
            _stopAll();
    };

    // TODO: УДОЛИ
    this.getSound = (key) => {
        return this.sprite;
    };
};



nge.Mlm.States = {};



nge.Mlm.States.Controller = Class.extend(function () {
    var _self = this;
    this.states = {};
    this.loadingState;
    this.currentState;
    this.renderer;
    this.interaction;

    this.world;
    var _root;

    this.width = 0;
    this.height = 0;
    this.ratio = 1;

    var _loopLastCall = nge.Lib.Time.get();

    var _originalWidth;
    var _originalHeight;

    var _loaderState;

    var _loopStopped = false;
    var _loopPaused = false;

    /**
     * 
     * @param {Object} config  {width, height, renderer, state, scale}
     * @returns {nge.Mlm.States.Controller}
     */
    this.init = (config) => {
        if (_self.renderer)
            return _self;

        _originalWidth = _self.width = config.width;
        _originalHeight = _self.height = config.height;
        var osData = nge.Lib.Helper.getOsAndVersion();

        //renderer
        PIXI.settings.SCALE_MODE = PIXI.SCALE_MODES.LINEAR;
        PIXI.settings.TEXT_RESOLUTION = 1;

        if (osData.os === 'iOS' || osData.os === 'Mac OS X')
            PIXI.settings.PRECISION_FRAGMENT = PIXI.PRECISION.HIGH;

        _self.renderer = new PIXI.WebGLRenderer({preserveDrawingBuffer: true, width: config.width, height: config.height});  //todo: check if it is correct? if no - we shell use our renderer param
        document.body.appendChild(_self.renderer.view);

        //root and world
        _root = new PIXI.Container();
        _createWorld();

        // setup interaction
        _self.interaction = new PIXI.interaction.InteractionManager({root: _root, view: _self.renderer.view});

        _requestAnimFrame(_self.loop);
        _applyPrototypes();

        _loaderState = new nge.Mlm.States.State();

        return _self;
    };

    this.loop = () => {
        if (_loopStopped)
            return false;

        //todo get date from arguments? This is for forceUpdate in inactive tab (forcePC in adapter)
        _requestAnimFrame(function () {
            _self.loop();
        });

        if (!_loopPaused)
            _self.update();
    };

    this.update = () => {
        if (!_self.currentState || _self.currentState.isPaused())
            return;

        var deltaTime = _getDeltaTime();
        _self.interaction.update(deltaTime);

        _self.currentState.update();
        _self.currentState.render();
        _self.renderer.render(_root);
    };

    /**
     * 
     * @param {string} id
     * @param {Object} stateObject
     * @returns {undefined}
     */
    this.add = (id, stateObject) => {
        if (_self.states[id])
            return undefined;

        var state = new nge.Mlm.States.State();
        state = nge.Lib.Helper.mergeObjs(state, stateObject);
        _self.states[id] = state;

        return state;
    };

    this.checkState = (id) => {
        return (typeof _self.states[id] !== 'undefined') ? true : false;
    };

    this.start = (id, clearWorld) => {
        if (_self.states[id]) {
            if (_self.currentState)
                _self.currentState.pause();

            log('Mlm.States.Controller start: ', id);

            //todo clearWorld

            _self.currentState = _loaderState;
            _self.currentState.loadUpdate = _self.states[id].loadUpdate;
            _self.currentState.resume();
            _self.loadingState = _self.states[id];

            _preload();

            return true;
        }

        return false;
    };

    this.focusCanvas = () => {
        nge.wrap.states.renderer.view.focus();
    };

    this.stopLoop = () => {
        _loopStopped = true;
    };

    this.pauseLoop = () => {
        _loopPaused = true;
    };

    this.resumeLoop = () => {
        _getDeltaTime();
        _loopPaused = false;
    };

    this.isPausedLoop = () => {
        return _loopPaused;
    };

    this.resize = (w, h) => {
        _self.width = w;
        _self.height = h;
        _self.renderer.resize(w, h);
    };

    this.resetLoopTime = function () {
        _loopLastCall = Date.now();
    };

    var _preload = () => {
        _self.loadingState.preload();
        nge.wrap.load.onUpdate.add(_onUpdate);

        nge.wrap.load.onComplete.addOnce(function () {
            //all events must finish. Create must run in another raf cycle
            setTimeout(_create, 1);
        });

        nge.wrap.load.start();
    };

    var _onUpdate = () => {
        _self.currentState.loadUpdate();
    };

    var _create = () => {
        _self.currentState.pause();
        _clearLoaderState();
        _self.loadingState.create();  //world shutdawn
        _self.currentState = _self.loadingState;
        _self.loadingState = null;
        _self.currentState.resume();
    };

    var _clearLoaderState = () => {
        while (_self.world.children[0]) {
            _self.world.children[0].destroy();
            _self.world.removeChild(_self.world.children[0]);
        }

        _loaderState.loadUpdate = function () { };
    };

    /**
     * temporary deprecated
     * @returns {undefined}
     */
    var _rescale = () => {
        _self.ratio = Math.min(window.innerWidth / _originalWidth, window.innerHeight / _originalHeight);
        _self.width = _originalWidth * _self.ratio;
        _self.height = _originalHeight * _self.ratio;
        _self.renderer.resize(_self.width, _self.height);
        _self.world.scale.x = _self.world.scale.y = _self.ratio;
    };

    var _requestAnimFrame = (function () {
        return window.requestAnimationFrame ||
            window.webkitRequestAnimationFrame ||
            window.mozRequestAnimationFrame ||
            window.oRequestAnimationFrame ||
            window.msRequestAnimationFrame ||
            function (/* function FrameRequestCallback */ callback, /* DOMElement Element */ element)
            {
                window.setTimeout(callback, 0);
            };
    })();

    var _getDeltaTime = function () {
        var newTime = Date.now();
        var deltaTime = newTime - _loopLastCall;
        _loopLastCall = newTime;

        if (deltaTime < 0)
            deltaTime = 0;

        if (deltaTime > 1000)
            deltaTime = 1000;

        var deltaFrame = deltaTime * 60 / 1000; //1.0 is for single frame

        return deltaFrame;
    };

    var _createWorld = () => {
        _self.world = new PIXI.Container();
        _root.addChild(_self.world);
    };

    var _applyPrototypes = () => {
        _self.world.shutdown = _worldShutdown;
    };

    //prototypes
    var _worldShutdown = () => {
        //we need to save scale
        var scaleX = _self.world.scale.x;
        var scaleY = _self.world.scale.y;

        _self.world.destroy({children: true, texture: true, baseTexture: true});
        _createWorld();

        _self.world.scale.x = scaleX;
        _self.world.scale.y = scaleY;

        _applyPrototypes();
    };
});



nge.Mlm.States.State = Class.extend(function () {

    var _paused = false;

    var _updateCallback = () => {
    };

    this.preload = () => {
        //todo
    };

    this.loadUpdate = () => {
        //todo
    };

    this.create = () => {
        //todo
    };

    this.update = () => {
        _updateCallback();
    };

    this.render = () => {
        //todo
    };

    this.pause = () => {
        _paused = true;
    };

    this.resume = () => {
        _paused = false;
    };

    this.onUpdate = (callback) => {
        _updateCallback = callback;
    };

    this.isPaused = () => {
        return _paused;
    };

});



nge.Mlm.StatesManager = {};



nge.Mlm.StatesManager.Cfg = Class.extend(function () {

