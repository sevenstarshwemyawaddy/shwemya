nge.App[nge.appNS].Tpl.States = {};



nge.App[nge.appNS].Tpl.States.Play = function () {
    var _imagePath = nge.appPath + 'img/';

    var _playStyles = nge.tpl.group('playStyles');
    var _linesMarkers = nge.tpl.group('linesMarkers');

    var _tpl = {
        'styles': _playStyles.styles,
        'assets': {
            'name': 'assets',
            'contents': [
                {
                    type: mt.assets.GROUP,
                    'name': 'groupLinesMarkers',
                    'contents': _linesMarkers.assets.contents
                },
                { type: mt.assets.IMAGE, 'key': 'ui_group', 'fullPath': _imagePath + 'playarea/ui_group.png'},
                { type: mt.assets.IMAGE, 'key': 'playareaBg', 'fullPath': _imagePath + 'playarea/bg.jpg'},
                { type: mt.assets.IMAGE, 'key': 'playareaLogo', 'fullPath': _imagePath + 'playarea/logo_000.png'},

                { type: mt.assets.IMAGE, 'key': 'jackpotPopup_group', 'fullPath': _imagePath + 'playarea/jackpotPopup_group.png'}
            ]
        },
        'objects': {
            'name': 'objects',
            'contents': [
                {type: mt.objects.IMAGE, 'name': 'jackpotPopup_group', 'assetKey': 'jackpotPopup_group', 'x': '0', 'y': '0', 'alpha': '1'},
                {type: mt.objects.GROUP, 'name': 'jackpotStatusPanelContainer'},
                {type: mt.objects.IMAGE, x: 960, anchorX: 0.5, name: 'playareaLogo', 'assetKey': 'playareaLogo'},
                {type: mt.objects.GROUP, 'name': 'helpContainer'},
                {type: mt.objects.IMAGE, 'name': 'ui_group', 'assetKey': 'ui_group', 'x': '0', 'y': '0', 'alpha': '1'},
                {type: mt.objects.GROUP, 'name': 'fullscreenContainer'},          
                {type: mt.objects.GROUP, 'name': 'gambleContainer'},
                {type: mt.objects.GROUP, 'name': 'winlinesAddonContainer'},
                {type: mt.objects.GROUP, 'name': 'slotMachineContainer', 'contents': _linesMarkers.objects.contents},
                {type: mt.objects.IMAGE, 'name': 'playareaBg', 'assetKey': 'playareaBg'}
            ]
        }
    };

    var actions = nge.localData.get('actions') || [];
    var offers = [];
    for (var i = 0; i < actions.length; i++)
        if (actions[i].type && actions[i].type === 'offer')
            offers.push(actions[i]);

    if (offers.length === 0) {
        return _tpl;
    }

    _tpl.assets.contents.push({type: mt.assets.IMAGE, 'key': 'offers_group', 'fullPath': 'offers_group.png'});
    _tpl.objects.contents.splice(1, 0, {'type': 0, 'name': 'offers_group', 'assetKey': 'offers_group', 'x': '0', 'y': '0', 'alpha': '1'});
    return _tpl;
};



