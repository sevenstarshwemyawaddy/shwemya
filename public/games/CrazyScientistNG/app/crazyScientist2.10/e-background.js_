nge.App[nge.appNS].Tpl.Groups.Lang_ar = {};



nge.App[nge.appNS].Tpl.Groups.Lang_ar.PlayStylesExtension = function () {
    var _playStylesExtension = new nge.App[nge.appNS].Tpl.Groups.PlayStylesExtension();
    _playStylesExtension.styles['.uiTitles'].style.font = '28pt futuraptheavy'; //16
    _playStylesExtension.styles['.mobileUiTitles'].style.font = '44pt futuraptheavy'; //26
    return _playStylesExtension;
};



nge.App[nge.appNS].Tpl.Groups.Lang_zh = {};



nge.App[nge.appNS].Tpl.Groups.Lang_zh.PlayStylesExtension = function () {
    var _playStylesExtension = new nge.App[nge.appNS].Tpl.Groups.PlayStylesExtension();
    _playStylesExtension.styles['.uiTitles'].style.font = '22pt futuraptheavy'; //16
    _playStylesExtension.styles['.uiTitles'].style.strokeThickness = 3;
    _playStylesExtension.styles['.mobileUiTitles'].style.font = '36pt futuraptheavy'; //26
    _playStylesExtension.styles['.mobileUiTitles'].style.strokeThickness = 4;
    return _playStylesExtension;
};




