                {'key': 'playareaBtn_bottom_denom_plus', 'width': 224, 'height': 72, 'frameWidth': 56, 'fullPath': _imagePathOfferList + 'btn_bottom_denom_plus_sprite.png'},
                {'key': 'btnGreenOfferList', 'width': 1472, 'height': 96, 'frameWidth': 368, 'fullPath': _imagePathOfferList + 'big_green_button_atlas.png'},
                {'key': 'btnOrangeOfferList', 'width': 1472, 'height': 96, 'frameWidth': 368, 'fullPath': _imagePathOfferList + 'big_orange_button_atlas.png'},
                {'key': 'rectangleBox', 'fullPath': _imagePathOfferList + 'rectangle_2.png'},
