nge.App[nge.appNS].Com.SlotMachine.Cfg = nge.Com.SlotMachine.Cfg.extend(function () {
    var _blurSymbolsCount = [6, 10, 14, 18, 22];
    //_blurSymbolsCount = [12, 20, 28, 36, 44];

    this.params = {
        mw: 5,
        mh: 3,
        th: _blurSymbolsCount,
        imageWidth: 'original',
        imageHeight: 'original',
        parentName: 'slotMachineGameContainer',
        imgPath: nge.appPath + 'img/symbols/',
        blurAlpha: 1,
        spinCompleteDelay: 500,
        speedUpReelsFactor: 50,
        intrigueSpeedReelsFactor: 1.5,
        tweenType: 'custom', // default/custom
        tweenDuration: {
            oldSymbols: 225,
            blur: 75, //50 if forceSetTimeOut false
            newSymbols: 225,
            blurDurationType: 'factor', //duration/duration
            animationType: 'linear'  // custom/linear
        },
        // symbolsBlurKeys: [],
        _symbolsBlurKeys: [],
        tweenStartInterval: 0,
        tweenEndInterval: 0,
        blursShiftOnReelsHold: true,
        recyclerView: {
            enabled: false,
            reelsStopCounter: [5, 10, 15, 20, 25],
            reelsMinStopCounter: 0,
            reelsSpeed: [1, 1, 1, 1, 1],
            reelsIntrigueSpeed: 1.5,
            reelsSpeedUpSpeed: 2,
            hideBorderSymbols: true,
            borderSymbolsCount: 1,
            intrigueAdditionalCounter: 20
        }
    };

    Object.defineProperty(this.params, 'symbolsBlurKeys', {
        get: function () {
            return this._symbolsBlurKeys;
        },
        set: function (value) {
            var scatters = nge.localData.get('scatterSymbols');

            this._symbolsBlurKeys = value.filter(function (symbol) {
                return scatters.indexOf(symbol) === -1;
            });
        }
    });

    this.params.symbolsBlurKeys =
        nge.App.getInstance('Com.SlotMachine.Symbols')
        .items
        .map(function (symbol) {
            return symbol.name;
        });
});



nge.App[nge.appNS].Com.SlotMachine.Symbols = nge.Com.SlotMachine.Symbols.extend(function () {
    var _getAnimationFrames = function (prefix, count, suffix) {
        var animationFrames = [];
        for (var i = 0; i < count; i++) {
            animationFrames.push(prefix + nge.Lib.Helper.LdgZero(i, 3) + suffix);
        }
        return animationFrames;
    };

    this.items = [
        {
            name: '0',
            textureUrl: 'M00_000.jpg',
            repeat: 4,
            frameTime: 250,
            animateAllWinlinesCycle: true,
            winlineTime: 2550,
            animationSprite: false,
            animationSpriteExtension: 'jpg',
            frameWidth: 260,
            frameHeight: 260,
            multipack: 1,
            framesInLastSprite: 2,
            animationFrames: _getAnimationFrames('m00_', 2, '.jpg')
        },
        {
            name: '1',
            textureUrl: 'M01_000.jpg',
            repeat: 4,
            frameTime: 250,
            animateAllWinlinesCycle: true,
            winlineTime: 7250,
            animationSprite: false,
            animationSpriteExtension: 'jpg',
            frameWidth: 260,
            frameHeight: 260,
            multipack: 1,
            framesInLastSprite: 2,
            animationFrames: _getAnimationFrames('m01_', 2, '.jpg')
        },
        {
            name: '2',
            textureUrl: 'M02_000.jpg',
            frameTime: 150,
            animateAllWinlinesCycle: true,
            winlineTime: 2200,
            animationSprite: false,
            animationSpriteExtension: 'jpg',
            frameWidth: 260,
            frameHeight: 260,
            multipack: 1,
            framesInLastSprite: 30,
            animationFrames: _getAnimationFrames('m02_', 30, '.jpg')
        },
        {
            name: '3',
            textureUrl: 'M03_000.jpg',
            frameTime: 150,
            animateAllWinlinesCycle: true,
            winlineTime: 4600,
            animationSprite: false,
            animationSpriteExtension: 'jpg',
            frameWidth: 260,
            frameHeight: 260,
            multipack: 1,
            framesInLastSprite: 44,
            animationFrames: _getAnimationFrames('m03_', 44, '.jpg')
