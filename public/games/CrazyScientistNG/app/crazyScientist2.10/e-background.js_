        'position': nge.Lib.Helper.recursiveGet('position', param, 'down'), // up/down
        'colors': nge.Lib.Helper.recursiveGet('colors', param, []), //  [{color:'#ffff00', from:16}]
        'stroke': nge.Lib.Helper.recursiveGet('stroke', param, '#ffff00'), // "#985210"
        'strokeThickness': nge.Lib.Helper.recursiveGet('strokeThickness', param, 0)
    };
};



