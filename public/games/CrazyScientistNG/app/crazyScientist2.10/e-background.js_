nge.Com.FreeGameCounter = {};



nge.Com.FreeGameCounter.Controller = nge.Com.Base.extend(function () {
    var _created;

    this.preload = function () {
        this.preloadDefault();
    };

    this.create = function () {
        this.createDefault();

        if (!_created) {
            _subscribe();
        }
        _created = true;
        this.animateDefault();

        _check();
    };

    var _check = function () {
        var freeGamesInProgress = nge.localData.get('freeGame.inProgress');
        if (freeGamesInProgress) {
            nge.find('^freeGameCounterContainer').visible = true;
            nge.find('^counterButtonText').text =
                nge.localData.get('freeGame.totalAmount');
        } else {
            nge.find('^freeGameCounterContainer').visible = false;
        }
    };

    var _changeNumberCounter = function () {
        if (!nge.localData.get('freeGame') || nge.localData.get('freeGame.amount') <= 0) {
            nge.find('^freeGameCounterContainer').visible = false;
            return false;
        }
        nge.find('^counterButtonText').text =
            nge.localData.get('freeGame.amount');
    };

    var _subscribe = function () {
        nge.observer.add('kenoMachine.animationEnd', _changeNumberCounter, false, true);
        nge.observer.add('scratchMachine.scratchComplete', _changeNumberCounter, false, true);
    };
});



