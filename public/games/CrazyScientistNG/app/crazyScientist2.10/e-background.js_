nge.Com.TotalBet = {};



nge.Com.TotalBet.Controller = nge.Com.Base.extend(function () {
    var _created;

    this.create = function () {
        this.createDefault();
        _update();
        if (!_created)
            _subscribe();
        _created = true;
        return true;
    };

    var _update = function () {
        var l = nge.localData.get('lines.value');
        var b = nge.localData.get('bet.value');
        var c = nge.localData.get('coins.value');
        var bm = nge.localData.get('betMultiplier');

        if (!l || !b || c === undefined)
            return false;

        var totalBet = l * b * c * bm;
        nge.localData.set('totalBet.value', totalBet);
        var text = nge.find('.totalBetNumber');
        var hand = nge.localData.get('pokerMachine.gameParameters.handsQty');

        if (text) {
            // text.text = /*nge.localData.get('currency') +*/
            //     nge.Lib.Validator.convertToFloat(totalBet);

            text.text = totalBet.toFixed(2);
        }

        if (text && hand) {
            text.text = /*nge.localData.get('currency') +*/
                nge.Lib.Validator.convertToFloat(totalBet * hand);
        }

        nge.observer.fire('totalBet.change');
        return true;
    };

    var _subscribe = function () {
        nge.observer.add('brain.openGameSuccess', _update);
        nge.observer.add('bet.change', _update);
        nge.observer.add('lines.change', _update);
        nge.observer.add('coins.change', _update);
        nge.observer.add('totalBet.update', _update);
    };
});



