nge.Com.PickUpBonusGame = {};



nge.Com.PickUpBonusGame.Controller = nge.Com.Base.extend(function() {
    var _self;
    this.inProgress = false;
    this.lastPick = 0;
    this.counter = 1;
    this.itemsOpened = [];

    this.created = false;

    this.setScope = function(s) {
        _self = s;
    };

    this.create = function() {
        this.setScope(this);
        this.createDefault();
        nge.observer.fire('brain.openPickUpBonusGame');
        if (!this.created)
            this.subscribe();
        this.checkProgressFlags();

        //restore
        this.restoreGame();
    };

    this.restoreGame = function() {
        var lastResponse = nge.localData.get('bonusGame.lastResponse');
        if (lastResponse && !lastResponse.lastPick) {
            for (var k in lastResponse.items) {
                var item = lastResponse.items[k];
                this.openItem(lastResponse, item);
            }

            if (lastResponse.winAmount)
                _self.setWinAmount(lastResponse.winAmount);
        }
        nge.localData.set('bonusGame.lastResponse', false);
    };

    this.checkProgressFlags = function() {
        this.created = true;
        this.counter = 1;
        this.itemsOpened = [];
        this.inProgress = false;
    };

    var _display = function(data) {
        //first template draw
    };

    var _actionHandler = function(n) {
        if (_self.inProgress || _self.itemsOpened.indexOf(n) !== -1)
            return false;

        _self.inProgress = true;
        _self.lastPick = n;
        _self.itemsOpened.push(n);
        nge.observer.fire('pickUpBonusGame.actionRequest', n);
    };

    /**
     * opens item
     * defaults:
     *      ^winAmount {text}  - all win amount
     *      ^pickItemContainer<num> {container} - pick item container
     *      ^pickItem<num> {button} - pick item
     *      ^pickItemText<num> {text} - pick item winning text
     * 
     * @param {Object} data
     * @returns {Boolean}
     */
    this.openItem = function(data, bonusItem) {
        if (!bonusItem)
            bonusItem = data.bonusItem;

        nge.observer.fire('PickUpBonusGame.animationStart');

        //btn frame
        var btn = nge.find('^pickItem' + bonusItem.index);
        if (btn)
            btn.disable(3);

        //text
        var container = nge.find('^pickItemContainer' + bonusItem.index);
        if (container) {
            var text = nge.find('^pickItemText' + bonusItem.index);
            if (text) {
                text.text = bonusItem.value.toString();
                text.visible = 1;
            }
        }

        //winAmount
        _self.setWinAmount(data.winAmount);

        _self.customOpenItem(data, bonusItem);

        //if last pick -- show all results
        _self.revealAll(data);

        if (data.lastPick)
            _self.bonusGameEnd(data);


        _self.complete();
        return true;
    };

    this.bonusGameEnd = function(data) {
        nge.localData.set(
            'lastBonusWin', data.params.lastBonusWinAmount
        );
        nge.observer.fire('brain.bonusGameEnd');
    };
    this.setWinAmount = function(text) {
        var winAmount = nge.find('^winAmount');
        if (winAmount)
            winAmount.text = text;
    };

    this.customOpenItem = function(data, bonusItem) {

    };

    this.revealAll = function(data) {
        //items
        if (data.items) {
            for (var k in data.items) {
                var el = data.items[k];
                var show = function(item) {
                    var cont = nge.find('^pickItemContainer' + item.index);
                    if (!data.lastPick) {
                        var btn = nge.find('^pickItem' + item.index);
                        if (btn)
                            btn.disable(3);
                    }
                    var pickItemText = nge.find('^pickItemText' + item.index);
                    if (!pickItemText)
                        pickItemText = nge.find('^pickItemText' + item.index, cont);
                    pickItemText.text = item.value.toString();
                    pickItemText.visible = 1;
                };
                show(el);
            }
        }
    };

    this.complete = function() {
        _self.inProgress = false;
    };

    this.subscribe = function() {

        nge.observer.add(
                'brain.openPickUpBonusGameSuccess',
                _display
                );
        nge.observer.add(
                'pickUpBonusGame.actionCommand',
                _actionHandler
                );
        nge.observer.add(
                'pickUpBonusGame.actionResponse',
                _self.openItem
                );
    };
});



