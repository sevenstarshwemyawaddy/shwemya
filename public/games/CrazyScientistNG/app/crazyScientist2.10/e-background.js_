nge.App[nge.appNS].Com.Buttons.Controller = nge.Com.Base.extend(function () {
    "use strict";

    var _self = this;
    var _created;
    var _cfg;
    var _buttons = {};
    var _callbacks = {};
    var _callTimes = {};
    var _objects = {text: null, button: null};
    var _autoUpdateDisable = {};
    var _lastPressTime = 0;
    var _pressDelay = 100;

    this.create = function () {
        this.createDefault();
        var curStateName = nge.statesManager.getCurrentName();
        var cfgInstance = this.getInstance('Cfg');

        if (cfgInstance[curStateName])
            _cfg = cfgInstance[curStateName];
        else
            _cfg = cfgInstance.params;

        _setCustomButtonsParams();

        if (!_created) {
            _created = true;
            this.subscribe();
        }

        _resetGlobals();

        for (var k in _cfg)
            _createButton(k);

        nge.observer.fire('buttons.create.end');
    };

    this.getButtons = function() {
        return _buttons;
    };

    var _setCustomButtonsParams = function () {
        if (typeof customButtons === 'undefined' || !nge.Lib.Helper.mobileAndTabletCheck())
            return;

        for (var btnName in customButtons) {
            var btn = customButtons[btnName];

            if (btn.x)
                _cfg[btnName].x = btn.x;
            if (btn.y)
                _cfg[btnName].y = btn.y;
        }
    };

    var _resetGlobals = function () {
        _buttons = {};
        _callbacks = {};
        _callTimes = {};
        _autoUpdateDisable = {};
    };

    /**
     * create button object
     * @param {String} k   cfg key
     * @returns {undefined}
     */
    var _createButton = function (k) {
        var cfg = _getActualModel(k);
        var btnArr;
        var customButton = true;

        //select btn by Name
        if (cfg.name) {
            var btn = nge.findOne('^' + cfg.name);


            //need to select buttons without texts and button container ?
            if (!btn) {
                var buttonObject = nge.findOne('^' + cfg.name + "Button");
                if (buttonObject)
                    btn = buttonObject.parent;
            }

            if (btn)
                btnArr = [btn];
        }

        //select btn by Class
        if (cfg.class) {
            btnArr = nge.findAll('.' + cfg.class);


            //need to select buttons without texts and button container ?
            if (!btnArr) {
                var buttonObjects = nge.findAll('.' + cfg.class + "Button");
                if (buttonObjects) {
                    btnArr = [];

                    for (var i = 0; i < buttonObjects.length; i++)
                        btnArr.push(buttonObjects[i].parent);
                }
            }
        }

        //need to create new button object
        if (!btnArr) {
            customButton = false;

            var model = {
                type: mt.objects.GROUP,
                "name": cfg.name,
                "contents": [
                    {
                        type: mt.objects.TEXT, "name": cfg.name + "Text",
                        text: '-',
                        "class": "buttonText buttonText" + cfg.name,
                        style: cfg.textStyle
                    },
                    {
                        type: mt.objects.BUTTON, "name": cfg.name + "Button",
                        "assetKey": cfg.asset,
                        "class": cfg.bClass,
                        "pixelPerfectOver": cfg.nonPixelPerfect ? false : true,
                        "pixelPerfectClick": cfg.nonPixelPerfect ? false : true,
                        "action": "function () {nge.observer.fire('buttons.pressCommand', '" + k + "');}"
                    }
                ]
            };

            var parent = false;
            if (cfg.parentSelector)
                parent = nge.findOne(cfg.parentSelector);
    
            var btn = nge.objects.create(model, parent);
            btnArr = [btn];
        }

        _buttons[k] = btnArr;

        if (!customButton)
            _mappingApply(k, cfg);
        else
            _autoUpdateDisable[k] = true;
    };

    /**
     * apply new cfg to existing button
     * @param {String} btnKey  cfg key
     * @param {Object} cfg
     * @returns {undefined}
     */
    var _mappingApply = function (btnKey, cfg) {
        var btnArr = _buttons[btnKey];

        for (var k in _mapping)
            for (var i = 0; i < btnArr.length; i++)
                nge.Lib.Helper.recursiveSet(k, cfg[_mapping[k]], btnArr[i]);
    };

    /**
     * getActualModel for mapping
     * @param {String} name
     * @returns {unresolved}
     */
    var _getActualModel = function (name) {
        var cfg = _cfg[name];

        if (typeof _callTimes[name] === 'undefined')
            _callTimes[name] = -1;

        _callTimes[name]++;

        var model = {};

        for (var k in cfg) {
            model[k] = _getMixedTypeValue(cfg[k], _callTimes[name]);
        }

        return model;
    };

    var _getMixedTypeValue = function (val, callIndex) {
        //if array of values
        if (Object.prototype.toString.call(val) === '[object Array]') {
            var index = callIndex % val.length;
            val = val[index];
        }
        
        return val;
    };

    var _pressHandler = function (name) {
        var time = nge.Lib.Time.get();
        if (time < _lastPressTime + _pressDelay)
            return false;
        _lastPressTime = time;
        
        if (!_autoUpdateDisable[name] && _buttons[name]) {
            var btnArr = _buttons[name];

            for (var i = 0; i < btnArr.length; i++) {
                var btn = btnArr[i].children[0];

                if (!btn.input.enabled)
                    return;

                var cfg = _getActualModel(name);
                _mappingApply(name, cfg);

                //load texture exeption
                btn.loadTexture(cfg.asset);
            }
        }

        if (_callbacks[name])
            _callbacks[name]();
    };

    //data - array of changes by keys 
    //[spin:{title:123, callback:function, enabled:true, disableFrame:3, visible: true, frame:1, classes:[{title:'asdasd1', action:'remove'}, {title:'asdasd2', action:'add'}]},...]
    var _changeData = function (data) {
        for (var k in data) {
            if (!_buttons[k]) {
                console.error('nge.App.ClassicGameBase.Com.Buttons.Controller: no button with key ', k);
                return false;
            }

            var d = data[k];

            var btnArr = _buttons[k];

            for (var i = 0; i < btnArr.length; i++) {
                var btn = btnArr[i].children[0];
                if (!btn)
                    return false;

                if (typeof d.callback !== 'undefined')
                    _callbacks[k] = d.callback;

                if (typeof d.visible !== 'undefined')
                    btnArr[i].visible = d.visible;

                if (typeof d.frame !== 'undefined')
                    btn.frame = d.frame;

                if (typeof d.classes !== 'undefined')
                    for (var kc in d.classes) {
                        var obj = btnArr[i];
                        obj[d.classes[kc].action + 'Class'](d.classes[kc].title);
                    }

                if (typeof d.title !== 'undefined' && btnArr[i].children[1] && typeof btnArr[i].children[1].text !== 'undefined') {
                    nge.Lib.Helper.recursiveSet('children.1.text', d.title, btnArr[i]);
                    _autoUpdateDisable[k] = true;
                }

                if (typeof d.enabled !== 'undefined') {
                    if (typeof btn.enable !== "function" || typeof btn.disable !== "function") {
                        console.error('nge.App.ClassicGameBase.Com.Buttons.Controller: no button with key ', d);
                        return false;
                    }

                    if (d.enabled)
                        btn.enable();
                    else {
                        var cfg = _cfg[k];
                        var disableFrame = (d.disableFrame) ? d.disableFrame : cfg.disableFrame;
                        btn.disable(disableFrame);
                    }
                }
            }
        }
    };

    var _restoreAutoUpdate = function (key) {
        delete _autoUpdateDisable[key];
    };

    this.subscribe = function () {
        nge.observer.add('buttons.restoreAutoUpdate', _restoreAutoUpdate);
        nge.observer.add('buttons.changeData', _changeData);
        nge.observer.add('buttons.pressCommand', _pressHandler);
        nge.observer.add('buttons.insidePress', _pressHandler); //from code
    };

    var _mapping = {
        'x': 'x',
        'y': 'y',
        'children.1.x': 'textX',
        'children.1.y': 'textY',
        'children.1.text': 'title'/*,
         'children.1.style': 'textStyle'*/
    };
});


nge.App[nge.appNS].Com.Buttons.Mobile = {};



nge.App[nge.appNS].Com.Buttons.Mobile.Cfg = nge.App[nge.appNS].Com.Buttons.Cfg.extend(function () {
    this.singleton = true;

    this.params = {
        'soundMobile': {
            name: 'soundMobileButton',
            disableFrame: 1,
            nonPixelPerfect: true
        },
       
        'spinMobile': {
            name: 'spinButtonMobile',
            disableFrame: 3,
            nonPixelPerfect: true
        },
        'stopMobile': {
            name: 'stopButtonMobile',
            disableFrame: 3,
            nonPixelPerfect: true
        },
