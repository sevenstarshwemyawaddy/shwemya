    };
});




nge.App[nge.appNS].Com.Intro = {};




nge.App[nge.appNS].Com.Intro.Controller = nge.Com.Base.extend(function () {
    var INIT_STATUS = {
        NONE: 0,
        LOADING: 1,
        READY: 2
    };

    var _created = false;
    var _initStatus = INIT_STATUS.NONE;
    var _cache = {};

    this.playableStates = ['play'];

    this.preload = function () {
        var autostartEnabled = nge.Lib.Helper.getCookie('dontShowSplashScreen') === 'true';
        nge.localData.set('settings.dontShowSplashScreen', autostartEnabled);

        _initStatus = INIT_STATUS.NONE;

        if (nge.localData.get('introScreen.tranportClose')) {
            nge.localData.set('introScreen.tranportClose', false);
            nge.localData.set('introScreen.shown', false);
        }

        var shown = nge.localData.get('introScreen.shown');
        nge.localData.set('introScreen.shown', true);
        var needShow = nge.Lib.Helper.getCookie('dontShowSplashScreen') !== 'true';
        var canShow = this.playableStates.indexOf(nge.statesManager.getCurrentName()) !== -1;
        if (shown || !needShow || !canShow) {
            return;
        }
        _initStatus = INIT_STATUS.LOADING;
        this.super.preload();
    };

    this.create = function () {
        if (!_created)
            this.subscribe();
        _created = true;

        var wtfContainer = nge.findOne('^introInnerContainer');
        if (wtfContainer)
            wtfContainer.visible = false;

        _cache = {};
        nge.localData.set('introScreen.nowShowing', false);
        if (_initStatus !== INIT_STATUS.LOADING) {
            return;
        }
        this.createDefault();
        _cache.introContainer = nge.findOne('^introInnerContainer');
        _cache.introArrow = nge.findOne('^introArrow', _cache.introContainer);
        _cache.introBg = nge.findOne('^introBg', _cache.introContainer);

        //TODO(r.rakhman): Why here?
        _cache.introBg.inputEnabled = true;
        _cache.introBg.interactive = true;
        _cache.introContainer.visible = true;
        _initStatus = INIT_STATUS.READY;
        nge.localData.set('introScreen.nowShowing', true);
        _checkBoxUpdate(true);
    };

    var _onTransportClose = function () {
        if (_initStatus !== INIT_STATUS.READY)
            return;

        nge.localData.set('introScreen.tranportClose', true);
    };

    var _onCheckBoxClick = function () {
        _checkBoxUpdate(false);
    };

    var _checkBoxUpdate = function (refreshOnly) {
        var autostartEnabled = nge.Lib.Helper.getCookie('dontShowSplashScreen') === 'true';
        if (!refreshOnly)
            autostartEnabled = !autostartEnabled;
        _cache.introArrow.visible = autostartEnabled;
        nge.localData.set('settings.dontShowSplashScreen', autostartEnabled);
        nge.Lib.Helper.setCookie('dontShowSplashScreen', autostartEnabled);
    };

    var _onPlayButtonClick = function () {
        _cache.introContainer.visible = false;
        nge.localData.set('introScreen.nowShowing', false);
        nge.observer.fire('riverGameBase.intro.hide');
    };

    var _onButtonPress = function (name) {
        if (_initStatus !== INIT_STATUS.READY)
            return;

        if (name === 'autoStartCheckBox') {
            nge.observer.fire('denom_change.play');
            _onCheckBoxClick();
        }
        if (name === 'introPlayButton') {
            nge.observer.fire('denom_change.play');
            _onPlayButtonClick();
        }
    };

    /*
    var _onStatesManagerCreateEnd = function (state) {
        if (_initStatus !== INIT_STATUS.READY)
            return;

        var stateContainer = nge.findOne('^' + state + 'State');
        stateContainer.addChild(_cache.introContainer.parent);
    };
    */

    this.subscribe = function () {
        //nge.observer.add('StatesManager.create.end', _onStatesManagerCreateEnd);
        nge.observer.add('Transport.close', _onTransportClose);
        nge.observer.add('buttons.pressCommand', _onButtonPress);
    };
});




nge.App[nge.appNS].Com.Intro.Tpl = function () {
    var _intro = nge.tpl.group('intro');

    return {
        styles: _intro.styles,
        assets: {
            name: 'assets',
            contents: [
                { type: mt.assets.GROUP, contents: _intro.assets.contents }
            ]
        },
        objects: {
            name: 'objects',
            contents: [
                { type: mt.objects.GROUP, contents: _intro.objects.contents }
            ]}
    };
};



