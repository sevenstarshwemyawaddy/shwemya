        big_win_end: 'game:sounds/big_win_end',
        big_win_text_change: 'game:sounds/big_win_text_change',
        pick_appear: 'game:sounds/pick_appear',
        pick_disappear: 'game:sounds/pick_disappear',
        pick_free_spins: 'game:sounds/pick_free_spins',
        pick_multiplier: 'game:sounds/pick_multiplier',
        fs_popup_start: 'game:sounds/fs_popup_start',
        xw_popup: 'game:sounds/xw_popup',
        ambient_pickem: 'game:sounds/ambient_pickem',
        bs_background: 'game:sounds/bs_background',
        bn_background: 'game:sounds/bn_background'
    };
});




nge.App[nge.appNS].Com = {};


nge.App[nge.appNS].Com.Background = {};



nge.App[nge.appNS].Com.Background.Controller = nge.Com.Base.extend(function () {
    let _created = false;
    let _doctorTween = null;
    let _coverTween = null;
    let _lampTween = null;
    let _quality = 1;

    let _emitters = {
        splash: {},
        loop: {}
    };

    const COVER_ALPHA = 0.8;
    const DOCTOR_IDLE_ANIM_NAME = 'idle';
    const DOCTOR_IDLE_ANIM_FRAME_COUNT = 28;

    const DOCTOR_WIN_ANIM_NAME = 'win';
    const DOCTOR_WIN_ANIM_FRAME_COUNT = 29;

    const _objects = {
        '^popUpCoverContainer': null,
        '^doctor': null,
        '^light': null,
        '^bigWinCoverContainer': null
    };

    this.create = () => {
        this.createDefault();

        _quality = 1 / nge.assets.getQualityFactor();

        this._prepareLinks();
        this._reset();

        if (!_created)
            this._subscribe();


        this._startDoctorIdleAnimStartHandler();
        this._startLampAnimation();
    };

    this._getLdg = nge.Lib.Helper.LdgZero;

    this._getDoctorAnimationName = (animationType, index) => {
        return 'doctor_'.concat(animationType, '_', this._getLdg(index, 3));
    };

    this._prepareLinks = () => {
        for (let selector in _objects)
            _objects[selector] = nge.findOne(selector);

        for (let i = 0; i < 6; i++) {
            const splashName = `particlePopupEmitter_splash${i}`;
            _emitters.splash[splashName] = nge.findOne(`^${splashName}`);
        }
    };

    this._reset = () => {
        this._resetCover();
        this._resetDoctor();
    };

    this._resetCover = () => {
        _objects['^popUpCoverContainer'].visible = false;
        _objects['^popUpCoverContainer'].alpha = COVER_ALPHA;

        _objects['^bigWinCoverContainer'].visible = false;
        _objects['^bigWinCoverContainer'].alpha = COVER_ALPHA;
    };

    this._resetDoctor = () => {
        const textureName = this._getDoctorAnimationName(DOCTOR_IDLE_ANIM_NAME, 0);
        _objects['^doctor'].loadTexture(textureName);
    };

    this._stopDoctorTween = () => {
        // _doctorTween && _doctorTween.stop(true);
        // _doctorTween = null;
    };

    this._startDoctorTween = (animName, framesCount, onComplete, repeate = 0, yoyo = false) => {
        this._stopDoctorTween();
        const doctor = _objects['^doctor'];

        _doctorTween = nge.tween.add({
            x: 0
        }).to({
            x: framesCount
        }, 1800, null, false, 0, repeate, yoyo);

        let value = 0;
        let reverse = false;

        _doctorTween.onUpdateCallback((t, v, tv) => {
            if (value > v)
                reverse = !reverse;

            const totalValue = reverse ? (tv.vStart.x * (1 - v)) : (tv.vEnd.x * v);
            const index = Math.round(totalValue);
            const frameName = this._getDoctorAnimationName(animName, index);

            doctor.loadTexture(frameName);
            doctor.scale.set(_quality);

            value = v;
        });

        _doctorTween.onStart.add(this._resetDoctor);
        _doctorTween.onComplete.add(() => {
            this._resetDoctor();
            onComplete && onComplete();
        });
        _doctorTween.start();
    };

    this._startDoctorIdleAnimStartHandler = () =>
        this._startDoctorTween(DOCTOR_IDLE_ANIM_NAME, DOCTOR_IDLE_ANIM_FRAME_COUNT, null, -1, true);


    this._startDoctorWinAnimStartHandler = () =>
        this._startDoctorTween(DOCTOR_WIN_ANIM_NAME, DOCTOR_WIN_ANIM_FRAME_COUNT, this._startDoctorIdleAnimStartHandler);

    this._stopDoctorAnimHandler = () => this._stopDoctorTween();

    this._stopCoverTween = () => {
        _coverTween && _coverTween.stop(true);
        _coverTween = null;
    };

    this._showCover = (name) => {
        const cover = _objects[`^${name}`];

        _coverTween = nge.tween.add(cover)
            .to({
                alpha: COVER_ALPHA
            }, 100, null, false);

        cover.alpha = 0;
        cover.visible = true;


        _coverTween.onComplete.add(() => {
            cover.alpha = COVER_ALPHA;

            for (let name in _emitters.splash) {
                const e = _emitters.splash[name];
                if (e && e.emitter)
                    e.emitter.emit = true;
            }

        });

        _coverTween.start();
    };

    this._hideCover = (name) => {
        const cover = _objects[`^${name}`];

        _coverTween = nge.tween.add(cover)
            .to({
                alpha: 0
            }, 100, null, false);

        cover.alpha = COVER_ALPHA;


        _coverTween.onComplete.add(() => {
            cover.alpha = 0;
            cover.visible = false;
        });

        _coverTween.start();
    };

    this._showPopupCoverHandler = () => {
        this._stopCoverTween();
        this._showCover('popUpCoverContainer')
    };

    this._hidePopupCoverHandler = () => {
        this._stopCoverTween();
        this._hideCover('popUpCoverContainer');
    };

    this._showBigWinCoverHandler = () => {
        this._stopCoverTween();
        this._showCover('bigWinCoverContainer')
    };

    this._hideBigWinCoverHandler = () => {
        this._stopCoverTween();
        this._hideCover('bigWinCoverContainer');
    };

    this._startLampAnimation = () => {
        this._stopLampAnimation();

        const easing = nge.Lib.Tween.Easing.Bounce.In;
        const lamp = _objects['^light']
        lamp.visible = true;
        lamp.alpha = 1;

        _lampTween = nge.tween.add(lamp).to({
            alpha: 0
        }, 700, easing, false, 0, -1, true);
        _lampTween.start();
    };

    this._stopLampAnimation = () => {
        _lampTween && _lampTween.stop();
        _lampTween = null;
    };

    this._startLampAnimationHandler = () => this._startLampAnimation();
    this._stopLampAnimationHandler = () => this._stopLampAnimation();


    var _transportClose = function(){
        _objects['^popUpCoverContainer'].visible = false;
        _objects['^bigWinCoverContainer'].visible = false;

        for (let name in _emitters.splash) {
            const e = _emitters.splash[name];
            if (e && e.emitter)
                e.emitter.emit = false;
        }
    };

    this._subscribe = () => {
        nge.observer.add('Transport.close', _transportClose);
        nge.observer.add('background.doctor.idleStart', this._startDoctorIdleAnimStartHandler);
        nge.observer.add('background.doctor.winStart', this._startDoctorWinAnimStartHandler);
        nge.observer.add('background.doctor.animationStop', this._stopDoctorAnimHandler);
        nge.observer.add('background.cover.show', this._showPopupCoverHandler);
        nge.observer.add('background.cover.hide', this._hidePopupCoverHandler);
        nge.observer.add('background.coverBigWin.show', this._showBigWinCoverHandler);
        nge.observer.add('background.coverBigWin.hide', this._hideBigWinCoverHandler);
        nge.observer.add('background.lamp.animationStart', this._startLampAnimationHandler);
        nge.observer.add('background.lamp.animationStop', this._stopLampAnimationHandler);
    };
});



nge.App[nge.appNS].Com.Background.Tpl = function () {
    const _imagePath = nge.appPath + 'atlases/atlases_doctor/';
    const _contents = [];

    for (let i = 0; i < 29; i++) {
        const index = nge.Lib.Helper.LdgZero(i, 3);
        _contents.push({
            type: mt.assets.IMAGE,
            key: 'doctor_idle_'.concat(index),
            fullPath: _imagePath.concat('doctor_idle_', index, '.png')
        });
    }

    for (let i = 0; i < 30; i++) {
        const index = nge.Lib.Helper.LdgZero(i, 3);
        _contents.push({
            type: mt.assets.IMAGE,
            key: 'doctor_win_'.concat(index),
            fullPath: _imagePath.concat('doctor_win_', index, '.png')
        });
    }

    return {
        'assets': {
            'name': 'assets',
            'contents': _contents
        },
        objects: {
            name: 'objects',
            contents: [
            ]
        }
    };
};



nge.App[nge.appNS].Com.BigWin = {};



nge.App[nge.appNS].Com.BigWin.Controller = nge.App.RiverGameBase.Com.BigWin.Controller.extend(function () {

    let _waterTween = null;
    let _bubleTween = null;
    let _circleLightTween = null;
    let _lightAnimation = null;
    let _emittersContainerTweenAlpha = null;

    const BIG_WIN_EMITTERS_COUNT = 3;

    let _cache = {};

    let _colors = {
        3: 0x9e46c3,
        2: 0x327ade,
        1: 0x1a9f35,
        0: 0xe72490
    };

    this.needSpinButtonOverCover = false;

    var _quality = 1;

    this.create = function(){
        this.super.create();
        _cache = {};
        _quality = nge.assets.getQualityFactor();

        for(let i = 0; i < 4; i ++){
            const name = `bigWin${i}`;
            const cont = _getObjFromCache(name);

            const quality = nge.assets.getQualityFactor();
            
            cont.children.forEach(child =>{
                const isBubbles = child.getData().name && child.getData().name.indexOf('Bubbles') !== -1;
                const scale = isBubbles ? quality : 1;

                if(isBubbles){
                    child.x *= quality;
                    child.y *= quality;
                }

                child.scale.set(scale);
            });

            ['ultraWinShine', 'megaWinShine', 'superWinShine', 'bigWinShine'].forEach(name => {
                const obj = nge.findOne(`^${name}`);
                obj && obj.scale.set(2);
            });
        }

        _stopEmit();
    };
    
    const _ldgz = nge.Lib.Helper.LdgZero;
    
    // counterWater
    let _getObjFromCache = name => {
       
        if(!_cache[name])
            _cache[name] = nge.findOne(`^${name}`);

        return _cache[name];
            
    };

    this.changeWinAmountFieldSize = function(){};

    let _startWaterAnimation = function(){
        const water = _getObjFromCache('counterWater');
        water.scale.set(1.333 / _quality);
        
        _waterTween = nge.tween.add({}).to({ x: 35 }, 2000, null, false, 0, -1);
        _waterTween.onUpdateCallback((t, v, a) => {
            const index = _ldgz(Math.round(a.vEnd.x * v), 3);
            const name = `counter_water_${index}`;
            water.loadTexture(name);
        });

        _waterTween.start();
    };

    let _bigWinStartHandler = function() {
        nge.observer.fire('background.coverBigWin.show');
        _startWaterAnimation();
        _startBublesAnimation();
        _startCounterLightningAnimation();
    };

    let _startEmit = function(){
        if (_emittersContainerTweenAlpha && _emittersContainerTweenAlpha.stop) {
            _emittersContainerTweenAlpha.stop(false);
            _emittersContainerTweenAlpha = null;
        }
        let particleBigWinEmittersContainer = _getObjFromCache('particleBigWinEmittersContainer');
        particleBigWinEmittersContainer.alpha = 1;

        for(let i = 0; i < BIG_WIN_EMITTERS_COUNT; i++){
            const emitter = _getObjFromCache('particleBigWinEmitter' + i);
            if(emitter)
                emitter.emitter.emit = true;
        }
    };
    
    let _stopEmit = function(){
        for(let i = 0; i < BIG_WIN_EMITTERS_COUNT; i++){
            const emitter = _getObjFromCache('particleBigWinEmitter' + i);
            if(emitter){
                emitter.emitter.emit = false;
                // emitter.destroy();
            }
        }
    };

    let _startBublesAnimation = function() {
        const containersArr = [0, 1, 2, 3].map(index => { return _getObjFromCache(`bigWin${ index }Bubbles`) });

        _bubleTween = nge.tween.add({}).to({ x: 29 }, 2000, null, false, 0, -1);
        _bubleTween.onUpdateCallback((t, v, a) => {
            
            for(let i = 0; i < containersArr.length; i++){
                const cont = containersArr[i];

                if(!cont || !cont.parent.visible)
                    continue;

                cont.children.forEach(child => {
                    child.tint = _colors[i];
                    const mod = (child.getData().assetKey.indexOf('one') !== -1) ? 'one' : 'two'; 
                    const index = _ldgz(Math.round(a.vEnd.x * v), 3);
                    const name = `big_win_bubble_${mod}_${index}`;

                    child.loadTexture(name);
                });
            }
        });

        _bubleTween.start();
    };

    let _stopWaterAnimation = function() {
        _waterTween && _waterTween.stop(true);
        _waterTween = null;
    };

    let _stopBubleTween = function(){
        _bubleTween && _bubleTween.stop(true);
        _bubleTween = null;
    };

    let _bigWinCompleteHandler = function(){
        nge.localData.set('bigWin.show', false);
        nge.observer.fire('background.coverBigWin.hide');

        _stopWaterAnimation();
        _stopBubleTween();
        _stopEmit();
    };

    let _bigWinCompleteStartHandler = function () {
        // let particleBigWinEmittersContainer = _getObjFromCache('particleBigWinEmittersContainer');
        // particleBigWinEmittersContainer.alpha = 1;
        // _emittersContainerTweenAlpha = nge.tween.add(particleBigWinEmittersContainer);
        // _emittersContainerTweenAlpha.to({alpha: 0}, 300);
        // _emittersContainerTweenAlpha.start();
    };

    let _startCounterLightningAnimation = function(){
        _startCircleLightningAnimation();
        _fireLightAnimation();
    };

    let _stopCircleLightningAnimation = function(){
        _circleLightTween && _circleLightTween.stop(true);
        _circleLightTween = null;
    };

    let _startCircleLightningAnimation = function(){
        _stopCircleLightningAnimation();
        const circleLightning = _getObjFromCache('circleLightning');
        circleLightning.scale.set(2 / _quality);
        _circleLightTween = nge.tween.add({x: 0}).to({ x: 25 }, 1500, null, false);

        _circleLightTween.onStart.add(() => {
            circleLightning.visible = true;
        });

        _circleLightTween.onUpdateCallback((t, v, a) => {
            const index = _ldgz(Math.round(a.vEnd.x * v), 3);
            const name = `counter_lighiting_${index}`;
            circleLightning.loadTexture(name);
        });

        _circleLightTween.onComplete.add(() => {
            circleLightning.visible = false;
        });

        _circleLightTween.start();
    };

    let _changeStateHandler = function(){
        _startCounterLightningAnimation();
    };

    let _stopLightningAnimation = function(){
        _lightAnimation && _lightAnimation.stop(true);
        _lightAnimation = null;
    };

    let _fireLightAnimation = function(noParticles){
        const lightsAmount = 12;
        _stopLightningAnimation();
        _lightAnimation = nge.tween.add({x: 0}).to({ x: 20 }, 1500, null, false, 500);
        
        _lightAnimation.onStart.add(() => {
            for(let i = 0; i < lightsAmount; i++){
                let lightning = _getObjFromCache(`lightsLightning_${i}`);
             
                if(lightning){
                    lightning.loadTexture('lighiting_000');
                    lightning.scale.set(2 / _quality);
                    lightning.visible = true;
                }
            }
        });

        _lightAnimation.onUpdateCallback((t, v, a) => {
            for(let i = 0; i < lightsAmount; i++){
           
                let lightning = _getObjFromCache(`lightsLightning_${i}`);
                const index = _ldgz(Math.round(a.vEnd.x * v), 3);

                if(lightning)
                    lightning.loadTexture(`lighiting_${index}`)
            }
        });

        _lightAnimation.onComplete.add(() => {
            for(let i = 0; i < lightsAmount; i++){    
                let lightning = _getObjFromCache(`lightsLightning_${i}`);

                if(lightning)
                    lightning.visible = false;
            }
        });

        _lightAnimation.start();
    };
    
    let _counterCompleteHandler = function(){
        _startCounterLightningAnimation(true);
        _stopEmit();
    };

    let _startShowHandler = function(){
        if(!nge.localData.get('wasQuickFinish'))
            _startEmit();
    };

    let _quickFinishDone = function(){
        _stopEmit();
    };

    this.subscribe = function(){
        this.super.subscribe();
        nge.observer.add('slotMachine.quickFinish', _quickFinishDone);
        nge.observer.add('bigWin.startShow', _startShowHandler);
        nge.observer.add('bigWin.complete', _bigWinCompleteHandler);
        nge.observer.add('bigWin.complete.start', _bigWinCompleteStartHandler);
        nge.observer.add('bigWin.start', _bigWinStartHandler);
        nge.observer.add('bigWin.changestate', _changeStateHandler);
        nge.observer.add('bigWin.counter.complete', _counterCompleteHandler);
    };
});




