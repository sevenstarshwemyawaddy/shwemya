nge.App[nge.appNS].Com.Balance = {};



nge.App[nge.appNS].Com.Balance.Controller = nge.Com.Balance.Controller.extend(function () {
    var _self = this;
    var _created;
    var _numberContainer;
    this.currencyColor = '#00BFFF';
    this.maxWidth = 150;
    this.create = function () {
        var data = nge.localData.get('balance');

        _numberContainer = nge.findOne('.balanceNumber');

        var currencyTexts = nge.findAll('.currency');

        if (data && currencyTexts)
            currencyTexts.forEach(function (curr) {
                curr.text = data.currency;
            });

        if (data)
            nge.rafSetTimeout(function () {
                _self._drawText(data);
            }, 1);

        if (!_created) {
            _created = true;
            _subscribe();
        }
    };

    var _subscribe = function () {
        nge.observer.add('balance.amount', _self._change);
    };

    this._change = function (data) {

        var bet = nge.localData.get('totalBet.value');
        var balanceAmount = data.totalAmount;

        if (balanceAmount < bet) {
            nge.observer.fire('spinButton.disable');
            nge.observer.fire('autospinButton.disable');
            nge.observer.fire('pokerButton.disable');
            nge.observer.fire('kenoButton.disable');
            nge.observer.fire('infoPanel.show', 'NOT ENOUGH MONEY TO SPIN');
        }

        this._drawText(data);

        if (_numberContainer)
            _numberContainer.maxSizeResize('width', _self.maxWidth);

        var balance = nge.localData.set('balance.totalAmount', data.totalAmount);

        return true;
    };

    this._drawText = function (data) {

        var balanceNumbers = nge.findAll('.balanceNumber');
        var currency = data.currency || nge.localData.get('balance.currency');
        var text = parseFloat(data.totalAmount).toFixed(2) + ' ' + currency;

        for (var k in balanceNumbers) {
            balanceNumbers[k].text = text;
            balanceNumbers[k].maxSizeResize('width', _self.maxWidth);
            balanceNumbers[k].clearColors();
            balanceNumbers[k].addColor(_self.currencyColor, text.length - currency.length);
        }
    };
});



nge.App[nge.appNS].Com.Balance.Mobile = {};



nge.App[nge.appNS].Com.Balance.Mobile.Controller = nge.Com.Base.extend(function () {
    var _self = this;
    var _created;
    var _numberContainer;

    this.currencyColor = '#EFC273';
    this.maxWidth = 350;

    this.create = function () {
        this.createDefault();
        var data = nge.localData.get('balance');

        _numberContainer = nge.findOne('.balanceNumber');
        _numberContainer.maxSizeResize('width', _self.maxWidth);
        var currencyTexts = nge.findAll('.currency');

        if (data) {
            if (currencyTexts)
                currencyTexts.forEach(function (curr) {
                    curr.text = data.currency;
                });

            nge.rafSetTimeout(function () {
                _self._drawText(data);
            }, 1);
        }

        if (!_created)
            _subscribe();

        _created = true;
        return true;
    };

    var _change = function (data) {

        var bet = nge.localData.get('totalBet.value');
        var balanceAmount = data.totalAmount;

        if (balanceAmount < bet) {
            nge.observer.fire('spinButton.disable');
            nge.observer.fire('autospinButton.disable');
            nge.observer.fire('pokerButton.disable');
            nge.observer.fire('kenoButton.disable');
            nge.observer.fire('infoPanel.show', nge.i18n.get('NOT ENOUGH MONEY TO SPIN'));
        }

        _self._drawText(data);

        _numberContainer.maxSizeResize('width', _self.maxWidth);

        var balance = nge.localData.set('balance.totalAmount', data.totalAmount);

        return true;
    };

    this._drawText = function (data) {
        var balanceNumbers = nge.findAll('.balanceNumber');
        var currency = data.currency || nge.localData.get('balance.currency');
        var text = parseFloat(data.totalAmount).toFixed(2) + ' ' + currency;

        for (var k in balanceNumbers) {
            balanceNumbers[k].text = text;
            balanceNumbers[k].clearColors();
            balanceNumbers[k].maxSizeResize('width', _self.maxWidth);
            balanceNumbers[k].addColor(_self.currencyColor, text.length - currency.length);
        }
    };

    var _subscribe = function () {
        nge.observer.add('balance.amount', _change);
    };
});



