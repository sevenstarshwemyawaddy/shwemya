nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.States = {};


nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.States.BaseState = Class.extend(function () {
    this.id = null;

    var _win = false;
    var _cycleComplete = false;
    var _self = this;
    var _totalSubscribeCfg = null;

    this.changeStyleTypeEnum = {
        add: 'add',
        remove: 'remove'
    };

    // Prop sets event subscribe/unsubscribe logic automaticaly.
    // Works only for public callbacks.
    // Sets like [event name]: [public callback name] 
    this.subscribeCfg = {
        'slotMachine.spinStart': 'spinStartHandler',
        'slotMachine.spinCommand': 'slotMachineSpinCommandHandler',
        'win': 'winHandler',
        'winlines.animateByOne.cycleComplete.firstTime': 'cycleCompleteHandler',
        'transportMessage.BalanceResponse': 'balanceResponseHandler',
        'offer.apply': 'applyOfferHandler',
        'offers.result.goToGame': 'offerGoToGameHandler',
        'offers.list.later': 'offerListLaterHandler',
        'slotMachine.spinComplete': 'spinCompleteHandler',
        'slotMachine.stopCommand': 'spinStopHandler'
    };
    
    this.subscribeCfgExt = {};

    this.buttonsRefs = {};

    this.init = function(buttons){
        this.id = nge.Lib.Helper.getRandomInt(0, 999999);
        _totalSubscribeCfg = nge.Lib.Helper.mergeObjsRecursive(this.subscribeCfg,  this.subscribeCfgExt);

        this.fillButtonsRefs(buttons);
        this.subscribe();
    };

    this.destroy = function(){
        this.buttonsRefs = {};
        this.unsubscribe();
    };

    /**
     *  Function fills buttonsRefs prop by button refs
     *  @param {object} buttons - state buttons object from com.buttons.cfg
     */
    this.fillButtonsRefs = function(buttons){
        var btnNames = Object.getOwnPropertyNames(buttons);

        var getButtonRef = function(buttonName){
            var btn = nge.findOne('^' + buttons[buttonName].name + 'Button');

            if(!btn)
                btn = nge.findOne('^' + buttons[buttonName].name + 'ButtonButton');

            this.buttonsRefs[buttonName] = btn;
        }.bind(this);

        btnNames.forEach(getButtonRef);
    };

    /**
     *  Function fills buttonsRefs prop by button refs
     *  @param {string} btnName - button name
     *  @param {object} state - button frames state must have overFrame,
     *                          outFrame, downFrame and upFrame props
     */
    this.setButtonFrames = function(btnName, state){
        var button = this.getButtonByName(btnName);

        if(!button) return;

        if (nge.game.input.mouse.event)
            nge.game.input.mouse.onMouseMove(nge.game.input.mouse.event);
            
        button.setFrames(state.overFrame, state.outFrame, state.downFrame, state.upFrame);

        if (button._onOriginal) {

            button._onOriginal = {
                _onOverFrame: state.overFrame,
                _onOutFrame: state.outFrame,
                _onDownFrame: state.downFrame
            };
        }
    };

    /**
     *  Function search button in local cache
     *
     *  @param {string} btnName button name
     *  @return {Object|boolean} button object
     */
    this.getButtonByName = function(btnName){
        var button = this.buttonsRefs[btnName];

        if(!button){
            console.error(btnName, 'not found in state cache!');
            return false;
        }

        return button;
    };

    /**
     *  Function disables button
     *  @param {string} btnName - button name
     *  @param {number} frame - num of frame
     */
    this.disableButton = function(btnName, frame){
        var button = this.getButtonByName(btnName);

        if(!button) return;

        button.disable(frame);
    };

    /**
     *  Function enables button
     *  @param {string} btnName - button name
     */
    this.enableButton = function(btnName){
        var button = this.getButtonByName(btnName);

        if(!button) return;
        button.enable();
    };

    this.model = {
        // contains an order of actions.
        // if current action is not valid and next is valid then
        // state will switch to next action.
        // State may switch only when last action is active.
        //
        // '?' option marks action as 'optional'. If current action
        // isn't valid & next optional action isn't valid to, then
        // logic will ckeck next action from optional.
        order: [],

        actions: {}
    };

    /**
     *  Handler to check state valid status
     *  @return {Boolean} - result
     */
    this.validityCheckHandler = function(){
        return false;
    };

    /**
     *  Object that contains callbacks for checking
     *  actions valid status
     *
     *  Callback name consist from 'on' prefix and capitalized action name.
     *  If action name is more then one word they split by '_'.
     *  Callbacks must return 'boolean'.
     */
    this.actionUpdateHandlers = {};

    /**
     *  Object that contains callbacks for checking
     *  buttonState enabled/visible status.
     *  Callbacks must return 'boolean'.
     *
     *  '!' modificator will invert callback result.
     */
    this.propUpdateHandlers = {
        auto: function(){
            return nge.localData.get('autospin');
        },
        quickFinishEnable: function(){
            return !nge.localData.get('quickSpin.inProgress') && !_cycleComplete && _win;
        }
    };

    /**
     *  Object that contains callbacks for button actions.
     *  Using if many buttonStates callbacks have same logic or
     *  if callback have a lot of logic
     */
    this.callbackHandlers = {
        autoCallback: function(){
            var isAuto = nge.localData.get('autospin');
            var event = 'autospinSimple.';

            event += isAuto ? 'off' : 'on';
            nge.observer.fire(event);
        },
        quickFinishCallback: function(){
            nge.localData.set('quickSpin.inProgress', true);
            nge.observer.fire('slotMachine.quickFinish');
        }
    };

    /**
     *  Function to add/remove specified class
     *  @param {object} model - button model
     *  @param {string} style - style name
     *  @param {string} type - action type name described in changeStyleTypeEnum
     */
    this.changeStyle = function(model, style, type){
        model.classes = [{
            title: style,
            action: type
        }];
    };

    /**
     *  Object that contains callbacks for modifing button model
     *  before 'buttons.changeData' will be fired.
     *
     *  Callback name consist from 'on' prefix and capitalized action name.
     *  If action name is more then one word they split by '_'.
     *  Callbacks will receive button model in param.
     */
    this.beforeUpdateHandlers = {};

    /**
     *  Object that contains callbacks for modifing button model
     *  after 'buttons.changeData' will be fired.
     *
     *  Callback name consist from 'on' prefix and capitalized action name.
     *  If action name is more then one word they split by '_'.
     *  Callbacks will receive button model in param.
     */
    this.afterUpdateHandlers = {};

    this.winHandler = function(){
        _win = true;
    };

    this.spinStartHandler = function(){
        nge.localData.set('quickSpin.inProgress', false);
        _win = false;
        _cycleComplete = false;
    };

    this.cycleCompleteHandler = function(){
        _cycleComplete = true;
    };

    this.spinStopHandler = function(){};
    this.applyOfferHandler = function(){};
    this.offerGoToGameHandler = function(){};
    this.offerListLaterHandler = function(){};
    this.balanceResponseHandler = function(){};
    this.slotMachineSpinCommandHandler = function(){};
    this.stateResetHandler = function(){};
    this.spinCompleteHandler = function() {};

    this.subscribe = function(){
        for (var eventName in _totalSubscribeCfg){
            var callback = _self[_totalSubscribeCfg[eventName]];

            if(!nge.Lib.Helper.typeCheck.isFunction(callback))
                continue;
               
            nge.observer.add(eventName, callback, eventName.concat('.', this.id), true);
        }
    };

    this.unsubscribe = function(){
        for (var eventName in _totalSubscribeCfg){
            nge.observer.remove(eventName, false, eventName.concat('.', this.id), true);
        }
    };
});



nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.States.JackpotState = nge.App.ClassicGameBase.Mlm.Brain.ButtonsNewLogic.States.BaseState.extend(function () {

