                                    contents: [
                                      {
                                            type: 0,
                                            x: -100,
                                            name: 'bigWinCounterLeft',
                                            assetKey: '1px_empty',
                                            anchorX: 0.5,
                                            anchorY: 0.5
                                        },
                                        {
                                            type: 0,
                                            x: 100,
                                            name: 'bigWinCounterRight',
                                            assetKey: '1px_empty',
                                            anchorX: 0.5,
                                            anchorY: 0.5
                                        },
