nge.Com.Demo = {};



nge.Com.Demo.Controller = function () {

    this.create = function () {
        // prevent pause on focus lost
        nge.rafSetTimeout(this.gotoPlay, 1000);

        nge.observer.add(
            'StatesManager.create.end', function (state) {
                if (state === 'demo')
                    return false;

                nge.userInfoRemove();
                nge.observer.fire('game.readyToPlay');
                nge.observer.remove('StatesManager.create.end', false, 'userInfoRemove', true);

            }, 'userInfoRemove', true);

        return true;
    };

    this.gotoPlay = function () {
        nge.observer.fire('window.resize');
        nge.brain.showGamePlayState();
        nge.userInfoHTML('Preparing to show Game Play');
        return true;
    };
};



