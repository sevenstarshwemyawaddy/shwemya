nge.Com.Freespin = {};



nge.Com.Freespin.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _self;
    var _totalWin = 0;
    var _inProgress = false;
    this._canSpin = false;
    this._pauseMode;

    var _autospinSpinsLeftText;  //'^autospinSpinsLeftText'
    var _autospinSpinsTotal; //'^autospinSpinsTotal'
    this._restoringFlag = false;

    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        _self = this;
        _self._pauseMode = false;

        _autospinSpinsLeftText = nge.findOne('^autospinSpinsLeftText');
        _autospinSpinsTotal = nge.findOne('^autospinSpinsTotal');

        if (!_created)
            _subscribe();

        nge.localData.set('freespin.inProgress', false);
        nge.localData.set('spin.type', "SpinRequest");

        _created = true;
        _self._restoringFlag = false;
        return true;
    };

    this.freespinStart = function (spins) {
        nge.observer.fire('freespin.startProcess.start');
        spins = parseInt(spins);
        _inProgress = true;
        _self._canSpin = true;

        var freespinProgress = nge.localData.get('freespin.inProgress');
        var freespinTotalCount = nge.localData.get('freespin.spinsTotal');
        var freespinTotalCountResetFlag = nge.localData.get('freespin.spinsTotalResetFlag');

        if (freespinTotalCountResetFlag || !freespinProgress || !freespinTotalCount) {
            freespinTotalCount = 0;
            nge.localData.set('freespin.spinsTotalResetFlag', false);
        }

        freespinTotalCount += spins;
        var allData = nge.localData.getAll();

        _self.setSpinType();
        nge.localData.set('freespin.inProgress', true);

        nge.localData.set('freespin.lastSpin', false);

        if (!_self._restoringFlag) {
            nge.localData.set('freespin.spinsTotal', freespinTotalCount);
            nge.localData.set('freespin.spinsLeft', parseInt(nge.localData.get('freespin.spinsLeft')) || 0 + spins);
        }

        _self._spinCommand();
        nge.observer.fire('buttons.freespinMode');

        if (_autospinSpinsLeftText) {
            _autospinSpinsLeftText.text = spins;
            _autospinSpinsLeftText.visible = true;
        }

        if (_autospinSpinsTotal)
            _autospinSpinsTotal.text = spins;

        _self._restoringFlag = false;

        nge.observer.fire('freespin.startProcess.end');
        nge.observer.fire('autospinButton.disable');
        nge.observer.fire('maxBetButton.disable');
    };

    this.setSpinType = function () {
        nge.localData.set('spin.type', 'FreeSpinRequest');
    };

    this.setSpinsTotal = function (totalCount) {
        nge.localData.set('freespin.spinsTotal', totalCount);
    };

    var _spinHandleResponse = function (data) {
        if (!nge.localData.get('freespin.inProgress'))
            return false;

        if (_autospinSpinsLeftText)
            _autospinSpinsLeftText.text = nge.localData.get('freespin.spinsLeft') - 1;

        nge.localData.set('freespin.spinsLeft', parseInt(data.freeSpinRemain));
    };

    this.finishFreespin = function () {
        _inProgress = false;
        _totalWin = 0;

        var inProgress = nge.localData.get('freespin.inProgress');
        if (inProgress) {
            nge.localData.set('spin.type', "SpinRequest");
            nge.localData.set('freespin.spinsTotalResetFlag', true);
            nge.localData.set('freespin.inProgress', false);

            if (_autospinSpinsLeftText)
                _autospinSpinsLeftText.visible = false;
        }
        nge.observer.fire('freespin.end');
    };

    var _spinCompleteResponse = function () {
        var inProgress = nge.localData.get('freespin.inProgress');
        if (!inProgress)
            return false;

        var lastSpinWin = nge.localData.get('slotMachine.slotWin');
        var spinsLeft = parseInt(nge.localData.get('freespin.spinsLeft'));

        if (_autospinSpinsLeftText)
            _autospinSpinsLeftText.text = spinsLeft;

        if (spinsLeft === 0) {
            _self.finishFreespin();
        } else if (spinsLeft > 0)
            _self._canSpin = true;
    };

    var _winlinesCompleteHandler = function () {
        _self._spinCommand();
    };

    var _pause = function () {
        _self._pauseMode = true;
    };

    var _resume = function () {
        _self._pauseMode = false;
        _self._spinCommand();
    };

    this._spinCommand = function () {
        if (!_self._canSpin || _self._pauseMode)
            return false;

        nge.observer.fire('slotMachine.spinCommand');
        _self._canSpin = false;
    };

    var _spinRestore = function (data) {
        if (data.state !== 'FreeSpins' && data.state !== 'FreeReSpins')  //FreeReSpins === respins in freespins
            return false;

        var spins, totalCount = 0;

        if (data.freeSpinRemain) {
            spins = data.freeSpinRemain;
        } else {
            if (data.slotWin && data.slotWin.linePickBonus)
                for (var i = 0; i < data.slotWin.linePickBonus.length; i++) {
                    var bonusName = data.slotWin.linePickBonus[i].bonusName;

                    if (bonusName === 'FreeSpins' || bonusName === 'FreeReSpins') {
                        spins = data.slotWin.linePickBonus[i].params;
                        break;
                    }
                }
        }

        if (data.freeSpinsTotal)
            totalCount = parseInt(data.freeSpinsTotal);

        nge.localData.set('freespin.spinsLeft', spins);
        nge.localData.set('freespin.spinsTotal', totalCount);
        //need to wait until initial animation end
        _self._restoringFlag = true;
        nge.observer.fire('freespin.start', spins, 1300);

        return true;
    };

    var _winHandler = function (winAmount) {
        if (!_inProgress)
            return false;

        _totalWin = _totalWin + winAmount;

        nge.observer.fire('freespinWin', {
            winAmount: winAmount,
            freespinTotalWin: _totalWin
        });
    };

    var _subscribe = function () {
        nge.observer.add('freespin.start', _self.freespinStart);
        nge.observer.add('slotMachine.spinResponse', _spinHandleResponse);
        nge.observer.add('slotMachine.spinComplete', _spinCompleteResponse);
        nge.observer.add('freespin.restore', _spinRestore);
        nge.observer.add('win', _winHandler);
        nge.observer.add('spinAndWinComplete', _winlinesCompleteHandler);
        nge.observer.add('freespin.pause', _pause);
        nge.observer.add('freespin.resume', _resume);

        return true;
    };
});



nge.Com.FreeGamePopup = {};



nge.Com.FreeGamePopup.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _self;
    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        _self = this;
        this.createDefault();

        if (!_created) {
            _subscribe();
            _created = true;
        }
        return true;
    };

    var _show = function () {
        var freeSpins = nge.localData.get('slotMachine.lastResponseType');
        var freeGames = nge.localData.get('freeGame');
        if (!freeGames || freeSpins === "FreeSpinResponse") {
            _hide();
            return false;
        }
        var popup = nge.find('#freeGamePopup');
        popup.visible = true;
        var textFreeGames = nge.find('^winUserCodeText');
        textFreeGames.text = freeGames.amount;

        var freeGameCoinValue = nge.find('^freeGameCoinValue');
        freeGameCoinValue.text = nge.localData.get('currency') + freeGames.coin;

        var freeGameCoinsNumberValue = nge.find('^freeGameCoinsNumberValue');
        freeGameCoinsNumberValue.text = freeGames.coinsPerBet;

        var freeGameLinesValue = nge.find('^freeGameLinesValue');
        freeGameLinesValue.text = freeGames.lines;

        var freeGameExpValue = nge.find('^freeGameExpValue');
        freeGameExpValue.text = freeGames.freeGameExpiration;

        nge.observer.fire('brain.disableButtons');
        nge.observer.fire('settingsButton.disable');
        nge.observer.fire('euroButton.disable');
        nge.observer.fire('paytableButton.disable');
    };

    var _hide = function () {
        var popup = nge.find('#freeGamePopup');
        if (!popup) return false;
        popup.visible = false;
    };
    var _close = function () {
        _hide();
        nge.observer.fire('spinButton.enable');
    };

    var _subscribe = function () {
        nge.observer.add('freeGamePopup.hide', _hide);
        nge.observer.add('freeGames.show', _show);
        nge.observer.add('freeGamePopup.close', _close);
        nge.observer.add('freespin.end', _show);
        nge.observer.add('freespin.start', _hide);
        nge.observer.add('freespin.restore', _hide);
    };
});



