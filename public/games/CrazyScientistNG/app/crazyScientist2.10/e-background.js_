nge.Com.Gamble = {};



nge.Com.Gamble.Controller = nge.Com.Base.extend(function () {
    var self = null;
    var key = 'card';
    var path = 'gamble/cards/';
    var fullPathDefault = 'gamble/cards/card.png';
    var _created;
    var _currentColor = '';
    var totalWin = 0;
    var buttonsColor = ['black', 'red'];
    var _isWin;

    this.create = function () {
        self = this;
        totalWin = nge.localData.get('slotMachine.slotWin.totalWin') * 2;

        var text = 'YOU CAN WIN x2: ' + nge.Lib.Validator.floatMoney(totalWin, true) + nge.localData.get('currency');
        nge.localData.set("infoPanel.text", text);
        if (!_created)
            _subscribe();
        _created = true;
        return true;
    };

    var _show = function (data) {
        _gambleHandleResponse(data.winning);
    };

    var _actionRequest = function (color) {
        _currentColor = color;
        self.disableButtons();
        nge.observer.fire('gamble.actionRequest');
    };

    var _gambleHandleResponse = function (win) {
        var color = null;
        if (win > 0) {
            _isWin = true;
            color = _currentColor;
        } else {
            _isWin = false;
            color = buttonsColor.filter(function (value) {
                return value !== _currentColor;
            })[0];
        }
        var index = nge.Lib.Helper.getRandomInt(1, 26);
        var fullPath = path + color + "_" + index + '.png';
        nge.rafSetTimeout(function () {
            self._loadNewCardTexture(fullPath);
        }, 1000);
        self.complete();
    };

    this._loadNewCardTexture = function (fullPath) {
        var loader = new Phaser.Loader(nge.game);
        loader.image(key, nge.assets.getImagesPath() + fullPath);

        var onLoaded = function () {
            var objs = nge.find('^' + key);
            var texture = PIXI.TextureCache[key];
            var factor = nge.assets.getQualityFactor();
            if (!texture)
                return false;
            texture.width = texture.width / factor;
            texture.height = texture.height / factor;
            objs.width = texture.width;
            objs.height = texture.height;
            objs.setTexture(texture);
            nge.observer.fire('gamble.cardHasBeenShown');
        };

        loader.onLoadComplete.addOnce(onLoaded);
        loader.start();
    };

    this.complete = function () {
        nge.localData.set('slotMachine.slotWin.totalWin', 0);
        var totalWinText = nge.Lib.Validator.floatMoney(totalWin, true) + nge.localData.get('currency');
        nge.rafSetTimeout(function () {
            if (_isWin) {
                nge.find('^winCont').visible = true;
                nge.find('^winUserCodeText').text = totalWinText;
                nge.observer.fire('gamble.win');
            } else {
                nge.find('^loseCont').visible = true;
                nge.observer.fire('gamble.lose');
            }
            self._loadNewCardTexture(fullPathDefault);
        }, 2000);
        nge.rafSetTimeout(function () {

            self._loadNewCardTexture(fullPathDefault);
            nge.statesManager.display('play', true);
        }, 5000);
    };

    this.disableButtons = function () {
        var currentButton = nge.find('^btn_' + _currentColor);
        currentButton.disable('2');

        var secondColor = buttonsColor.filter(function (value) {
            return value !== _currentColor;
        })[0];

        var secondButton = nge.find('^btn_' + secondColor);
        secondButton.disable('0');
    };

    var _subscribe = function () {
        nge.observer.add('gamble.showCard', _actionRequest);
        nge.observer.add('gamble.response', _show);
    };
});



nge.Com.Gamble.Tpl = function () {};



nge.Com.GambleButton = {};



nge.Com.GambleButton.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _cfg;
    var tweenA;
    var _self;
    var disabled;

    var yEnable = 200;
    var yDisable = 0;

    var needAnimate = false;

    var _isTotalWin = function () {
        var totalWin = nge.localData.get('slotMachine.slotWin.totalWin');
        return (totalWin && totalWin > 0) ? true : false;
    };

    this.create = function () {
        this.createDefault();
        var cfg = this.getInstance('Cfg');
        _cfg = cfg.get();

        _self = this;

        if (_isTotalWin()) {
            _gambleButtonEnable();
        }
        if (!_created) {
            _subscribe();
        }
        _created = true;
    };

    var _gambleButtonEnable = function () {
        if (nge.localData.get('livingLargeBonusGameEnd')) {
            nge.localData.set('livingLargeBonusGameEnd', false);
            return false;
        }
        nge.find('^btn_gamble').enable(1);
        var autospinInProgress = nge.localData.get('autospin.inProgress');
        var freespinInProgress = nge.localData.get('freespin.inProgress');

        var isBonus = nge.localData.get(
            'slotMachine.slotWin.linePickBonus'
            ).length ? true : false;

        if (!autospinInProgress && !freespinInProgress && !isBonus && !disabled) {
            needAnimate = true;
            _self.animate(1);
        }
    };

    this.animate = function (enabled) {
        if (!needAnimate)
            return false;
        var startY = (enabled) ? yEnable : yDisable;
        var endY = (!enabled) ? yEnable : yDisable;
        var gambleContainer = nge.find('^gambleButtonContainer');
        gambleContainer.visible = true;
        var onCompleteCallback = function () {
            if (!enabled) {
                var gambleContainer = nge.find('^gambleButtonContainer');
                gambleContainer.visible = false;
                needAnimate = false;
            }
        };
        gambleContainer.y = startY;
        tweenA = nge.tween.add(gambleContainer).to({y: endY}, 1000, 'Quart.easeOut');
        tweenA.onComplete.add(onCompleteCallback, this);
        tweenA.start();
    };

    var _changeNeedAnimate = function () {
        needAnimate = false;
    };

    var _gambleButtonDisable = function () {
        nge.find('^btn_gamble').disable();
        _self.animate(0);
    };

    var _handleSpin = function () {
        if (_isTotalWin()) {
            disabled = false;
            _gambleButtonEnable();
        }
    };

    var _disableWithoutAnimation = function () {
        _changeNeedAnimate();
        nge.find('^gambleButtonContainer').visible = false;
        disabled = true;
    };

    var _subscribe = function () {
        nge.observer.add('slotMachine.spinComplete', _handleSpin);
        nge.observer.add('slotMachine.spinStart', _gambleButtonDisable);
        nge.observer.add('bigWin', _disableWithoutAnimation);
        nge.observer.add('freespin.end', _disableWithoutAnimation);
        nge.observer.add('brain.bonusGameEnd', _changeNeedAnimate, false, true);
        nge.observer.add('gamble.actionRequest', _changeNeedAnimate, false, true);
    };
});



