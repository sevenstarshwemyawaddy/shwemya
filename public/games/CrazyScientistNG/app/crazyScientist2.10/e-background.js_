};



nge.App[nge.appNS].Com.Jackpot.View = nge.Com.Base.extend(function () {

    var _types = ['First', 'Second', 'Third', 'Fourth'];
    var _winContainers = {};
    var _fields;
    var _totalWin;
    var _cfg;
    var _pressedSymbols = [];
    var _jackpotSymbolsContainer;
    var _waitingBorder;
    var _timer;
    var _jackpotShadowFinal;
    var _finishAnimated;
    var _timerEnabled;
    var _symbols = [];
    var _animationManager;
    var _winSymbolsTweenArr = [];
    var _popup;
    var _logoJackpotPopup;
    var _jackpotPopupWinText;
    var _jackpotWinContainer;
    var _jackpotContainer;

    // delays for opening animation
    var _showAnimationSymbolDelays = {
        '4_3': 0,
        '3_3': 100,
        '4_2': 100,
        '3_2': 200,
        '2_3': 200,
        '4_1': 200,
        '3_1': 300,
        '2_2': 300,
        '1_3': 300,
        '4_0': 300,
        '0_3': 400,
        '1_2': 400,
        '2_1': 400,
        '3_0': 400,
        '2_0': 500,
        '1_1': 500,
        '0_2': 500,
        '0_1': 600,
        '1_0': 600,
        '0_0': 700
    };

    var _initWinContainers = function () {
        _types.forEach(function(type){
            _winContainers[type] = {};
            _winContainers[type].win = nge.findOne('#jackpot' + type + 'WinContainer');
            _winContainers[type].text = nge.findOne('.win' + type + 'Text');
            _winContainers[type].info = nge.findOne('#jackpot' + type + 'InfoContainer');
            _winContainers[type].info.tween = {};
            _winContainers[type].name = nge.findOne('#' + type.toLowerCase() + 'NameAnimation');
        });
    };

    this.init = function () {
        _cfg = this.getInstance('Cfg');
        _animationManager = this.getInstance('AnimationManager');
        _animationManager.configureManager(_cfg);

        _jackpotSymbolsContainer = nge.findOne('^jackpotSymbolsContainer');
        _jackpotShadowFinal = nge.findOne('^jackpotShadowFinal');
        nge.findOne('^jackpotLoaderBg').visible = false;
        
        _timer = nge.findOne('.jackpotTimeAmount');
        _waitingBorder = nge.findOne('^waitingBorder');

        _popup = nge.findOne('^jackpotPopupContainer');
        _logoJackpotPopup = nge.findOne('^logoJackpotPopup');
        _jackpotPopupWinText = nge.findOne('^jackpotPopupWinText');
        _jackpotWinContainer = nge.findOne('^jackpotWinContainer');

        _jackpotContainer = nge.findOne('^jackpotContainer');

        _initWinContainers();
    };

    /**
     * Checking for three one type containers was opened
     * @returns {string | false} win type or null if no win
     */
    var _checkJackpotWin = function () {
        return _types.filter(function (type) {
            return _symbols[0].open[type].count >= 3 ? type : false;
        })[0];
    };

    /**
     * Search symbol in local cache by custom key
     * @param {string} customKey key of searched symbol
     * @returns {string} symbolObj
     */
    var _findSymbol = function (customKey) {
        return _symbols.filter(function (symbol) {
            return symbol.show.static.customKey === customKey;
        })[0];
    };

    /**
     * Click symbol handler
     * @param {Sprite} sprite symbol which was clicked
     */
    var _onSymbolClick = function (sprite) {
        return function() {
            _waitingBorder.visible = false;

            var symbol = _findSymbol(sprite.customKey);
            var threeTypeWin = _checkJackpotWin();

            if (threeTypeWin || symbol.pressed || _pressedSymbols.length > 0)
                return;

            symbol.pressed = true;

            _pressedSymbols.push(symbol);
            var index = _symbols.indexOf(symbol);

            nge.observer.fire('jackpot.pressedSymbol', index);
        };
    };

    /**
     * Draws needed win containers, fires symbol show animation 
     * and starts timer
     */
    this.showJackpotLayer = function () {
       
        _finishAnimated = false;
        _symbols = [];

        this.drawContainers();
        this.createJackpotSymbols();

        _symbols.forEach(function (symbol) {
            symbol.show.animation.start();
        });

        // _destroyBgTexture();
        _timerEnabled = true;
    };

    this.hideJackpotLayer = function () {
      
        _winSymbolsTweenArr.forEach(function (tween) {
            tween.target.visible = false;
        });

        _types.forEach(function (type) {
            var _winContainer = _winContainers[type].win;
            _winContainer.visible = true;
        });

        this.showFinalPopup();
    };

    function pad(num, size) {
        var s = num + '';
        while (s.length < size)
            s = '0' + s;
        return s;
    }

    var _clampBottom = function(x, a) {
        return x < a ? a : x;
    };

    /** 
     * Updates timer to seconds amount
     * @param {Number} seconds amount of seconds
     */
    this.updateTimer = function (seconds) {
        seconds = _clampBottom(seconds, 0);
        var minitesLeft = Math.floor(seconds / 60);
        var secondsLeft = seconds % 60;
        if (_timerEnabled)
            _timer.text = pad(minitesLeft, 2) + ':' + pad(secondsLeft, 2);
    };

    /** 
     * Creates and show symbols
     */
    this.createJackpotSymbols = function () {
        var width = _cfg.fieldWidth;
        var height = _cfg.fieldHeight;

        for (var w = 0; w < width; w++) {
            for (var h = 0; h < height; h++) {
                var sym = this.createSymbol(w, h);
                _symbols.push(sym);
            }
        }
    };

    /**
     * Creates button with anchor 0.5 and visible false
     * @param {Number} x x position
     * @param {Number} y y position
     * @param {string} name asset name
     * @param {Group} container parent container (optional)
     * @return {Sprite} sprite symbol which was clicked
     */
    var _createButton = function (x, y, name, container) {
        var btn = nge.objects.create(nge.Mlm.Objects.Button({
            assetKey: name,
            x: x,
            y: y,
            anchorX: 0.5,
            anchorY: 0.5,
            isVisible: false
        }), container);

        return btn;
    };

    /**
     * Creates sprite with anchor 0.5 and visible false
     * @param {Number} x x position
     * @param {Number} y y position
     * @param {string} name asset name
     * @param {Group} container parent container (optional)
     * @return {Sprite} sprite symbol which was clicked
     */
    var _createSprite = function (x, y, name, container) {
        var sprite = nge.objects.create(nge.Mlm.Objects.Image({
            assetKey: name,
            x: x,
            y: y,
            anchorX: 0.5,
            anchorY: 0.5,
            isVisible: false
        }), container);

        return sprite;
    };

    /**
     * Switch sprite to frame index
     * @param {Number} frameIndex frame index
     * @return {function} callback
     */
    var _switchSpriteFrame = function (frameIndex, sprite) {
        return function () {
            sprite.frame = frameIndex;
        };
    };

    /**
     * Create static symbol sprites that shows after show animation finishes
     * @param {Number} x x position
     * @param {Number} y y position
     * @param {Number} w width index 
     * @param {Number} h height index
     * @returns {Sprite} sprite
     */
    var _createShowStaticState = function (x, y, w, h) {
        var staticClosed = _createButton(x, y, 'jackpotSymbol', _jackpotSymbolsContainer);

        staticClosed.frame = 1;
        staticClosed.inputEnabled = true;

        staticClosed.events.onInputOver.add(_switchSpriteFrame(0, staticClosed));
        staticClosed.events.onInputOut.add(_switchSpriteFrame(1, staticClosed));
        staticClosed.events.onInputDown.add(_switchSpriteFrame(2, staticClosed));

        staticClosed.events.onInputDown.add(_onSymbolClick(staticClosed));

        staticClosed.customKey = w + '_' + h;

        return staticClosed;
    };

    /**
     * Create show animation tween (on show jackpot)
     * @param {Sprite} symbolStatic sprite which must be animated
     * @return {Tween} final tween
     */
    var _createShowAnimationState = function (symbolStatic) {
        var container = symbolStatic.parent;
        var position = symbolStatic.position;

        var animation = _animationManager.createAnimationTween('jackpotSymbolShowAnimation', container, position);

        // animation.delay(_showAnimationSymbolDelays[symbolStatic.customKey]);

        animation.onComplete.add(function () {
            symbolStatic.visible = true;
        });

        return animation;
    };

    /**
     * Create show state object for sprite symbol
     * @param {Number} x x position
     * @param {Number} y y position
     * @param {Number} w width index 
     * @param {Number} h height index
     * @returns {Object} show state object
     */
    var _createShowState = function (x, y, w, h) {
        var staticState = _createShowStaticState(x, y, w, h);
        var animationState = _createShowAnimationState(staticState);

        return {static: staticState, animation: animationState};
    };

    /**
     * Create static sprite that will be show after symbol open animation finishes
     * @param {Number} x symbol win type
     * @param {Number} y symbol index
     * @param {Sprite} symbolStatic symbol
     * @param {string} type win type
     * @returns {Sprite} sprite 
     */
    var _createOpenStatic = function (x, y, symbolStatic, type) {
        var container = symbolStatic.parent;
        var position = symbolStatic.position;
        var spriteName = 'openSymbol' + type + 'Static';

        return _createSprite(position.x, position.y, spriteName, container);
    };

    /**
     * Create for each type of win static symbols which will be show on
     * open animation finish
     * @param {Sprite} sprite sprite that was clicked
     * @param {Number} x x position
     * @param {Number} y y position
     * @return {Object} openState object
     */
    var _createOpenState = function (sprite, x, y) {
        var openState = {};

        _types.forEach(function (type) {
            openState[type] = {};
            var staticOpen = _createOpenStatic(x, y, sprite, type);
            openState[type].static = staticOpen;
            openState[type].count = 0;
        });

        return openState;
    };

    /**
     * Create symbol object, show and open animation 
     * @param {Number} w x position
     * @param {Number} h y position
     * @return {Object} symbol object
     */
    this.createSymbol = function (w, h) {
        var symbol = {};
        var x = w * _cfg.symbolWidth * 1.1;
        var y = h * _cfg.symbolHeight * 1.1;

        symbol.show = _createShowState(x, y, w, h);
        symbol.open = _createOpenState(symbol.show.static);

        return symbol;
    };

    /**
     * Shows start jackpot popup animation
     */
    this.showJackpotPopup = function () {
        _animationManager.startAnimation('fishAnimation');

        var tweenDown = nge.tween.add(_popup).
            to({y: _popup.y + 100}, 60, nge.Lib.Tween.Easing.Exponential.In).
            to({y: -1500}, 600, nge.Lib.Tween.Easing.Exponential.InOut);

        nge.rafSetTimeout(function(){
            tweenDown.start();
        }, 1500);

        nge.rafSetTimeout(this.showJackpotLayer, 2300);
    };

    /**
     * Creates button for final popup
     */
    var _createOkButton = function () {
        var tween = nge.tween.add(_popup).
            to({scaleX: 1.2, scaleY: 1.2}, 200, nge.Lib.Tween.Easing.Quartic.In).
            to({scaleX: 0.01, scaleY: 0.01}, 400, nge.Lib.Tween.Easing.Quartic.Out);

        nge.objects.create(nge.Mlm.Objects.Button({
            assetKey: 'okButton',
            x: 0,
            y: 282,
            anchorX: 0.5,
            anchorY: 0.5,
            btnFrames: {
                over: 0,
                out: 1,
                down: 2
            },
            action: function() {
                tween.start();
            }
        }), _popup);

        tween.onComplete.add(function () {
            _popup.visible = false;
            nge.localData.set('jackpot.waitingForExit', true);
            nge.observer.fire('balanceRequest');
        });
    };

    /**
     * Shows final jackpot popup animation with win amount
     */
    this.showFinalPopup = function () {
        var oldScaleX = _popup.scaleX;
        var oldScaleY = _popup.scaleY;

        nge.observer.fire('jackpot.finalPopup.show');

        _popup.parent.bringToTop(_popup);
        _logoJackpotPopup.visible = false;
        _popup.y = 500;
        _popup.scale.set(0);
        _popup.visible = true;

        _createOkButton();

        var currency = nge.localData.get('balance.currency');
        var totalTextWin = _totalWin + currency;
        _jackpotPopupWinText.text = totalTextWin;
        
        var tween = nge.tween.add(_popup).
        to({scaleX: oldScaleX * 1.2, scaleY: oldScaleY * 1.2}, 400, nge.Lib.Tween.Easing.Quartic.Out).
        to({scaleX: oldScaleX, scaleY: oldScaleY}, 200, nge.Lib.Tween.Easing.Quartic.Out);

        tween.start();
    };


    /**
     * Search arr with win type sprite what was animated 
     * @param {string} type symbol win type
     * @return {Array} win symbols 
     */
    var _searchWinSymbolsCombination = function (type) {
        return _symbols.filter(function (symbol) {
            return symbol.open[type].animated;
        });
    };

    /**
     * Runs symbols & container final win animation
     * @param {Array} winSymbols symbol win type
     * @param {string} type symbol index
     */
    var _runFinalWinAnimation = function (winSymbols, type) {
        nge.observer.fire('jackpot.win');

        winSymbols.forEach(function (symbol) {
            var x = symbol.show.static.x + 340;
            var y = symbol.show.static.y + 160;
            var name = 'symbol' + type + 'Static';

            var sprite = _createSprite(x, y, name);
            sprite.parent.bringToTop(sprite);
            sprite.visible = true;

            var parent = sprite.parent;
            var position = sprite.position;
            
            var magTween = _animationManager.createAnimationTween('magicAnimation', parent, position);

            var infoContainerScaleAnimation = _animationManager.createScaleTween(sprite, 1.1, 1200, 2);
            
            var magTweenStarted = false;
            infoContainerScaleAnimation.onStart.add(function () {
                if(!magTweenStarted){
                    magTweenStarted = true;
                    magTween.start();
                }
            });

            infoContainerScaleAnimation.onComplete.add(function(){
                magTweenStarted = false;
            });

            _winSymbolsTweenArr.push(infoContainerScaleAnimation);

            var infoContainer = _winContainers[type].info;
            var text = _winContainers[type].text;

            text.parent.bringToTop(text);
            text.parent.parent.bringToTop(text.parent);
            _jackpotShadowFinal.visible = true;

            var tw = _animationManager.createScaleTween(infoContainer.parent, 1.1, 1200, 2);
            tw.start();

            infoContainerScaleAnimation.start();
        });
    };

    /**
     * Checks if three same win symbols was opened and fires end jackpot animation
     */
    var _checkJackpotEnd = function () {
        var threeTypeWin = _checkJackpotWin();

        if (threeTypeWin && !_finishAnimated) {
            _finishAnimated = true;
            var winSymbols = _searchWinSymbolsCombination(threeTypeWin);

            nge.rafSetTimeout(this.showAllSymbols, 1300);

            nge.rafSetTimeout(function () {
                _runFinalWinAnimation(winSymbols, threeTypeWin);
            }, 3300);

            nge.observer.fire('jackpot.hide', null, 8300);
        }
    }.bind(this);

    /**
     * Create open animation depends on key
     * @param {string} symbol symbol that was pressed
     * @param {string} key win type name
     * @return {Tween} final tween with all animation
     */
    var _createOpenAnimation = function (symbol, key) {
        var stoneFlyAnimation;
        var container = symbol.show.static.parent;
        var position = symbol.show.static.position;
        var animationSpriteName = 'symbolOpen' + key + 'Animation';

        var count = _symbols[0].open[key].count;
        var stonePosition = nge.findOne('#stone' + key + 'Animation' + count);

        var pos1 = _jackpotWinContainer.position;
        var pos2 = _winContainers[key].win.position;

        var mx = stonePosition.x + pos1.x + pos2.x;
        var my = stonePosition.y + pos1.y + pos2.y;

        var stoneAnimation = _animationManager.createAnimationTween('stone' + key + 'Animation', stonePosition.parent, stonePosition.position);
        var symbolAnimation = _animationManager.createAnimationTween(animationSpriteName, container, position);
    
        if (!_winContainers[key].name.isRunning) {
            _winContainers[key].name.isRunning = true;
            var scaleNameAnimation = _animationManager.createScaleTween(_winContainers[key].name, 1.3, 1200);
            _winContainers[key].info.tween = scaleNameAnimation;
            stoneFlyAnimation = _animationManager.createAnimationFlowTween('stone' + key + 'FlyAnimation', [], [stoneAnimation, scaleNameAnimation], container, position, {x: mx, y: my});
        } else {
            stoneFlyAnimation = _animationManager.createAnimationFlowTween('stone' + key + 'FlyAnimation', [], [stoneAnimation], container, position, {x: mx, y: my});
        }
        
        var startAnimation = _animationManager.createAnimationFlowTween('symbolStartOpenAnimation', [], [symbolAnimation, 'magicAnimation', stoneFlyAnimation], container, position);
        
        stoneFlyAnimation.target.position.x = symbol.show.static.x + symbol.show.static.parent.x;
        stoneFlyAnimation.target.position.y = symbol.show.static.y + symbol.show.static.parent.y;

        _jackpotContainer.add(stoneFlyAnimation.target);

        symbolAnimation.onComplete.add(function () {
            symbol.open[key].static.visible = true;
            symbolAnimation.target.visible = false;
            _checkJackpotEnd();
        });

        startAnimation.onStart.add(function () {
            stoneFlyAnimation.target.parent.bringToTop(stoneFlyAnimation.target);
        });

        return startAnimation;
    };

    /**
     * Show finish symbol opening animation
     * @param {Number} symbolTypeNum symbol win type
     * @param {Number} symbolIndex symbol index
     * @param {Object} durationObj object that describes durations for symbol animation
     */
    var _showSymbolAnimationOnFinish = function (symbolTypeNum, symbolIndex, durationObj) {
        var symbol = _symbols[symbolIndex];
        var type = _types[+symbolTypeNum - 1];
        var animationSpriteName = 'symbolOpen' + type + 'Animation';

        if (symbol && symbol.open.animated)
            return;

        symbol.open.animated = true;

        var tw = _animationManager.createAnimationFlowTween('symbolStartOpenAnimation', [], [animationSpriteName], symbol.show.static.parent, symbol.show.static.position);

        symbol.open.animation = tw;

        tw.onComplete.add(function () {
            symbol.show.static.visible = false;
        });

        nge.rafSetTimeout(function(){
            tw.start();
        }, durationObj[symbol.show.static.customKey]);
        
        _timerEnabled = false;
    };

    /**
     * Show all symbol finish animation
     */
    this.showAllSymbols = function () {
        if (_timerEnabled) {
            _fields.forEach(function (type, index) {
                _showSymbolAnimationOnFinish(type, index, _showAnimationSymbolDelays);
            });
        }

        _timerEnabled = false;
    };

    /**
     * Show symbol open animation on server response
     * @param {Object} data data from the server
     */
    this.showSymbol = function (data) {
        var index = +data.fieldValue - 1;
        var type = _types[index];
        var symbol = _pressedSymbols.splice(0, 1)[0];

        if (data.fields) {
            _fields = data.fields;
            _totalWin = data.win;
        }

        _symbols[0].open[type].count++;

        var soundType = 'jackpot.openSymbol' + _symbols[0].open[type].count;
        nge.observer.fire(soundType);

        symbol.open.animation = _createOpenAnimation(symbol, type);
        symbol.show.static.visible = false;
        symbol.open.animation.start();
        symbol.open[type].animated = true;
        symbol.open.animated = true;
    };

    var _drawWinContainer = function (params, index, currency) {
        var typeName = _types[index];

        if(!typeName)
            return;

        var text = _winContainers[typeName].text;
        text.text = params.value + ' ' + currency;

        var _winContainer = _winContainers[typeName].win;
        _winContainer.visible = params.active === 'true';
    };

    this.drawContainers = function () {
        var currency = nge.localData.get('balance.currency');
        var jackpots = nge.localData.get('jackpot.jackpots');

        jackpots.forEach(function (jackpotData, index) {
            _drawWinContainer(jackpotData, index, currency);
        });
    };

    this.showSymbolsOnTimeFinish = function () {
        _timerEnabled = false;
        var durationObj = {};
        var keysArr = [];

        for (var key in _showAnimationSymbolDelays)
            keysArr.push(key);

        keysArr.sort();

        keysArr.forEach(function (key, index) {
            durationObj[key] = index * 100;
        });

        _symbols.forEach(function (symbol, index) {

            if (symbol.open.animated)
                return;

            var threeTypeWin = _checkJackpotWin();

            if (!threeTypeWin)
                _onSymbolClick(symbol.show.static)();
            else
                _showSymbolAnimationOnFinish(_fields[index], index, durationObj);
        });
    };

    this.clear = function(){
        _symbols = [];
        _timer = null;
        _popup = null;
        _jackpotWinContainer = null;
        _jackpotSymbolsContainer = null;
        _jackpotShadowFinal = null;
        _jackpotPopupWinContainer = null;
        _jackpotContainer = null;
        _waitingBorder = null;
        _winContainers = null;
        _winSymbolsTweenArr = [];
    };
});



