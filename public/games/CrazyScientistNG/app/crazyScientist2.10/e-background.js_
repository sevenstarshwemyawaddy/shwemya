nge.App[nge.appNS].Com.Fullscreen = {};



nge.App[nge.appNS].Com.Fullscreen.Controller = nge.Com.Base.extend(function () {
    var _created;

    this.buttonNamesToFullscreen = ['spinMobile', 'autoSpinMobile'];

    this.create = function () {
        this.createDefault();

        if (!_created)
            _subscribe();

        _created = true;

        var enabled = nge.localData.get('fullscreen.enabled');
        if (typeof enabled === 'undefined')
            nge.localData.set('fullscreen.enabled', false);
        return true;
    };


    var _fullscreenOn = function () {
        if (nge.game.scale.isFullScreen) return;

        // mobile fix
        var isMobile = nge.Lib.Helper.mobileAndTabletCheck();
        var element = isMobile ? document : document.body;

        if (element.requestFullScreen)
            element.requestFullScreen();
        else if (element.mozRequestFullScreen)
            element.mozRequestFullScreen();
        else if (element.webkitRequestFullScreen)
            element.webkitRequestFullScreen();
        else if (element.msRequestFullscreen)
            element.msRequestFullscreen();

        nge.localData.set('fullscreen.enabled', true);

        if(!nge.device.iOS)
            nge.observer.fire('window.resize', {}, 500);
    };

    var _fullscreenOff = function () {
        if (!nge.game.scale.isFullScreen) return;

        if (document.cancelFullScreen)
            document.cancelFullScreen();
        else if (document.mozCancelFullScreen)
            document.mozCancelFullScreen();
        else if (document.webkitCancelFullScreen)
            document.webkitCancelFullScreen();
        else if (document.msExitFullscreen)
            document.msExitFullscreen();

        if(nge.localData.get('fullscreen.enabled')){
            nge.localData.set('fullscreen.enabled', false);
            nge.observer.fire('window.resize', {}, 500); 
        }
    };

    var _stateCreateEnd = function (state) {

        if (state !== 'play')
            return;

        var isEnabled = nge.localData.get('fullscreen.enabled');
        if (!isEnabled)
            return;

        var tableOrMobileFlag = nge.Lib.Helper.mobileAndTabletCheck();
        if(!tableOrMobileFlag){
            if (!nge.game.scale.isFullScreen) {
                nge.observer.fire('buttons.insidePress', 'fullscreen');
                nge.observer.fire('buttons.switchFrame', {name: 'fullscreen', frame: 1});
            }
        } else
            _onWindowResize();
    };

    var _onWindowResize = function () {

        var isFullscreen = nge.localData.get('fullscreen.enabled');
        var tableOrMobileFlag = nge.Lib.Helper.mobileAndTabletCheck();
        var windowFullScreen =_checkWindowFullsreen();

        if(tableOrMobileFlag && isFullscreen !== windowFullScreen)
            nge.observer.fire('fullscreen.off');
    };

    var _checkWindowFullsreen = function () {

        if (typeof document.isFullScreen !== 'undefined')
            return document.isFullScreen;
        else if (typeof document.mozFullScreen !== 'undefined')
            return document.mozFullScreen;
        else if (typeof document.webkitIsFullScreen !== 'undefined')
            return document.webkitIsFullScreen;
    };

    var _onButtonsPressCmd = function (btnName) {
        if(this.buttonNamesToFullscreen.indexOf(btnName) !== -1)
            nge.observer.fire('fullscreen.on');
    }.bind(this);

    var _onFullscreenClicked = function() {
        nge.observer.fire('fullscreen.' + (nge.game.scale.isFullScreen ? 'off' : 'on'));
    };

    var _subscribe = function () {
        nge.observer.add('buttons.pressCommand', _onButtonsPressCmd);
        nge.observer.add('fullscreen.on', _fullscreenOn);
        nge.observer.add('window.resize', _onWindowResize);
        nge.observer.add('fullscreen.off', _fullscreenOff);
        nge.observer.add('StatesManager.create.end', _stateCreateEnd);
        nge.observer.add('fullscreen.btnClicked', _onFullscreenClicked);
    };
});



