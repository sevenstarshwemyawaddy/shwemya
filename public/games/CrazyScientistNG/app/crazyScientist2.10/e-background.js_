nge.App[nge.appNS].Mlm.Brain.Jackpot = Class.extend(function () {

    this.subscribe = function () {
        nge.observer.add('StatesManager.create.end', this.statesManagerCreateEndHandler, false, true);
        nge.observer.add('jackpot.end', this.onJackpotEnd, false, true);
        nge.observer.add('transportMessage.JackpotResponse', this.jackpotResponseHandler, false, true);
        nge.observer.add('transportMessage.JackpotCanPlayResponse', this.jackpotCanPlayResponseHandler, false, true);
        nge.observer.add('transportMessage.JackpotPlayResponse', this.jackpotPlayResponseHandler, false, true);
        nge.observer.add('transportMessage.BalanceResponse', this.balanceResponseHandler, false, true);
        nge.observer.add('Transport.close', this.transportCloseHandler, false, true);
        nge.observer.add('window.visibilitychange', this.visibilityChange, false, true);
        nge.observer.add('jackpot.playRequest', this.jackpotPlayRequestHandler, false, true);
    };

    this.statesManagerCreateEndHandler = function(scene){
        if(scene === 'jackpot')
            this.showJackpot();
    };  

    this.showJackpot = function(){
        nge.observer.fire('jackpot.showLayer');
    };

    this.visibilityChange = function(vis) {
        if(nge.localData.get('jackpot.inProgress') && vis === 'visible' && nge.localData.get('jackpot.gotBalance')) {
            nge.observer.fire('jackpot.forceClose');
        }
    };

    this.onJackpotEnd = function() {
        nge.localData.set('slotMachine.slotWin', undefined);
        nge.localData.set('jackpot.gotBalance', false);
        nge.localData.set('jackpot.canPlay', false);
        nge.localData.set('jackpot.checkPlay', false);
        nge.localData.set('jackpot.inProgress', false);
        nge.localData.set('jackpot.jackpotCanPlayRequested', false);
        nge.localData.set('jackpot.waitingForExit', false);
    };

    this.transportCloseHandler = function(){
        nge.localData.set('jackpot.canPlay', false);
        nge.localData.set('jackpot.gotBalance', false);
        nge.localData.set('jackpot.checkPlay', false);
        nge.localData.set('jackpot.inProgress', false);
        nge.localData.set('jackpot.jackpotCanPlayRequested', false);
    };

    this.balanceResponseHandler = function(){
        if(nge.localData.get('jackpot.inProgress')) {
            nge.localData.set('jackpot.gotBalance', true);
        }

        if(nge.localData.get('jackpot.waitingForExit')) {
            nge.observer.fire('jackpot.forceClose');
        }

        var jackpotCanPlayRequested = nge.localData.get('jackpot.jackpotCanPlayRequested');
        var isSpinning = nge.localData.get('slotMachineSpinning');
        if(nge.localData.get('jackpot.canPlay') && !nge.localData.get('jackpot.inProgress') && !nge.localData.get('jackpot.checkPlay') && !jackpotCanPlayRequested && !isSpinning) {
            nge.localData.set('jackpot.checkPlay', true);
            nge.transport.send(nge.App.getInstance('Mlm.Transport.Models.JackpotCanPlayRequest', false, {
                'result': true,
                'data': { }
            }));
            nge.localData.set('jackpot.jackpotCanPlayRequested', true);
        }
    };
    
    this.jackpotPlayResponseHandler = function(response){
        nge.brain.do('receivedResponse', 'JackpotPlay');
        nge.observer.fire('jackpot.playResponse', response.data);
    };

    this.jackpotShowPopup = function(){
        var jackpotPopupContainer = nge.findOne('^jackpotPopupContainer');
        var jackpotPopupInnerContainer = nge.findOne('^jackpotPopupInnerContainer');

        var showPopupTween = nge.tween.add(jackpotPopupInnerContainer).
            from({y: -900}, 800, nge.Lib.Tween.Easing.Exponential.Out);

        showPopupTween.onStart.add(function(){
            jackpotPopupContainer.visible = true;
            showPopupTween.target.visible = true;
            jackpotPopupContainer.parent.parent.parent.bringToTop(jackpotPopupContainer.parent.parent);
            showPopupTween.target.parent.parent.bringToTop(showPopupTween.target.parent);
            
            nge.observer.fire('jackpot.startPopup.show');
        });

        showPopupTween.onComplete.add(function(){
            nge.localData.set('loadingBar.generateBarOnPreload', true);
            nge.observer.fire('loadingBar.generateLoaderBar');
        });

        showPopupTween.start();
    };

    this.jackpotPlayRequestHandler = function(index){
        nge.transport.send(nge.App.getInstance('Mlm.Transport.Models.JackpotPlayRequest', false, {
            'result': true,
            'data': {
                'fieldId': index
            }
        }));
        nge.brain.do('waitForResponse', 'JackpotPlay');
    };

    this.jackpotResponseHandler = function(response){
        var canPlay = response.data.canPlay === 'true';
        nge.localData.set('jackpot.canPlay', canPlay);
        nge.observer.fire('slotMachine.jackpotResponse', response);
    };

    this.jackpotCanPlayResponseHandler = function(response){
        nge.localData.set('jackpot.checkPlay', false);
        var isSpinning = nge.localData.get('slotMachineSpinning');
        var isAutoSpin = nge.localData.get('autospin');
        var isJackpot = nge.localData.get('jackpot.inProgress');

        if(isAutoSpin){
            var tableOrMobileFlag = nge.Lib.Helper.mobileAndTabletCheck();

            if (tableOrMobileFlag) 
                nge.observer.fire('buttons.insidePress', 'autoSpinMobile');
            else 
                nge.observer.fire('buttons.insidePress', 'auto');
        }


        if(response.data.canPlay === 'true' && !isSpinning && !isJackpot){
            nge.localData.set('jackpot.jackpots', response.data.jackpots);
            nge.localData.set('jackpot.canPlay', response.data.canPlay);  
            nge.localData.set('jackpot.inProgress', true);
            nge.observer.fire('winlines.stopAnimation');
            nge.observer.fire('jackpot.start');

            this.jackpotShowPopup();
            
            nge.rafSetTimeout(function(){
                nge.objects.takeScreenshot('jackpotLoaderBg');
                nge.statesManager.display('jackpotLoader', 'newloader');
            }, 3300);
        } else if(response.data.canPlay === 'false' && !isSpinning && !isJackpot){
            
            
            if(nge.localData.get('jackpot.jackpotCanPlayRequested')){
                nge.localData.set('jackpot.canPlay', false);
                nge.localData.set('jackpot.jackpotCanPlayRequested', false);
                nge.observer.fire('balanceRequest');
            }
            
        }
    };
});



nge.App[nge.appNS].Mlm.Brain.Sounds = nge.Mlm.Brain.Sounds.extend(function () {
    var _self = this;

    var _cycleComplete = false;
    var _winTriggered = false;
    var _canGamble;
    var _reelsWithScatters = [];
    var _stopCommandFired = false;
    var _slotMachineSymbols;
    var _dbInProgress = false;

    this.winSoundsQueue = false;
    var _freespinsFirstStageAnimationEnded = true;
    var _freespinsStageTwoIsset = false;

    /**
     * Amount of different reel spin sounds
     * Sound file name bs_wheel_spin_X
     * @type {number}
     */
    this.wheelSpinSoundCount = 5;

    /**
     * Amount of game reels
     * Needed to set all reels stop sounds and for some scatter sounds
     * @type {number}
     */
    this.reelsCount = 5;

    /**
     * Symbols that have custom sounds that will be played
     * when there is a combination of that symbol
     * Config sound files keys: S{symbolName}
     * @type {string[]}
     */
    this.soundedSymbols = ['0', '1', '2', '3', '4', '11'];

    /**
     * Scatter symbols needed for scatter sounds
     * @type {string[]}
     */
    this.scatterSymbols = ['11'];

    /**
     * Joker symbols needed for correct combination sounds
     * @type {string[]}
     */
    this.jokerSymbols = ['12'];

    /**
     * Amount of scatters that trigger custom scatter sound (if present)
     * @type {number}
     */
    this.scatterCountSoundTrigger = 2;

    /**
     * Amount of credits necessary for symbol sounds
     * @type {number}
     */
    this.creditsForSymbolSound = 10;

    /**
     * Should reels spin sounds should be played inside freespins
     * @type {boolean}
     */
    this.playReelsSoundInsideFreespins = false;

    /**
     * Should scatter play sounds on appearance
     * @type {boolean}
     */
    this.playScatterSounds = true;

    /**
     * Amount of scatters that trigger freespins
     * Needed for correct scatter appearance sounds
     * @type {number}
     */
    this.scattersNeededForFreespins = 3;

    /**
     * Amount of reels that scatters can appear at
     * Needed for correct scatter appearance sounds
     * @type {number}
     */
    this.scatterReelsCount = 5;

    /**
     * Sounds durations
     * Keys: event names that trigger line sounds
     * Values: number - duration, string('dynamic') - dynamicaly get sound's duration
     * @type {Object.<string, number|string>}
     */
    this.winSoundsDurations = {
        'win.tiny': 'dynamic',
        'win.small': 'dynamic',
        'win.middle': 'dynamic',
        'win.big': 'dynamic',
        'win.major.low': 'dynamic',
        'win.major.middle': 'dynamic',
        'win.major.high': 'dynamic'
    };

    /**
     * array of unused sounds
     */
    this.soundsUnused = [];

    /**
     * Sounds extension
     * s: Sound name from config
     * e: Event that triggers sound
     * @type {{s: string, e: string}[]}
     */
    this.soundExt = [
        { s: 'fs_show', e: 'popup.animate.start' },
        { s: 'fg_show', e: 'popupInsideBonus.animate.start' },
        { s: 'xw_you_won_intro', e: 'popupFinish.animate.start' },
        { s: 'xw_you_won_intro', e: 'gamble.go', action: 'stop' },
        { s: 'xw_you_won_intro', e: 'gamble.take', action: 'stop' },
        { s: 'bs_spin_fast', e: 'slotMachine.reel_2.intrigue.start', relaunch: true },
        { s: 'bs_spin_fast', e: 'slotMachine.reel_3.intrigue.start', relaunch: true },
        { s: 'bs_spin_fast', e: 'slotMachine.reel_4.intrigue.start', relaunch: true },
        { s: 'bs_spin_fast', e: 'slotMachine.spinComplete', action: 'stop' }
    ];

    /**
     * Base sounds
     * Dont override this property, only loop through it and change needed values
     * @type {{s: string, e: string}[]}
     * @private
     */
    this._soundCfgBase = [
        { s: 'rl_open', e: 'paytable.show' },
        { s: 'bn_background', e: 'sounds.preloaded.bonus', action: 'play', loop: true },
        { s: 'bn_background', e: 'freespin.startProcess.start', action: 'play', loop: true },
        { s: 'bn_background', e: 'popupFinish.animate.start', action: 'stop' },
