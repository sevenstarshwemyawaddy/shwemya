nge.App[nge.appNS].Com.Respin.View = Class.extend(function () {
    "use strict";

    this.showPopup = function (popupView, ms) {

        if (popupView.popup.start) {
            popupView.popup.start();
            return;
        }

        for (var k in popupView) {
            if (popupView.hasOwnProperty(k))
                popupView[k].visible = true;
        }

        if (ms) {
            nge.rafSetTimeout(function () {
                for (var key in popupView) {
                    if (popupView.hasOwnProperty(key))
                        popupView[key].visible = false;
                }
                nge.observer.fire('respin.popupIsHidden');
            }, ms);
        }
    };

    this.showStateOfRespin = function (text) {
        nge.observer.fire('infoPanel.showText', {
            text: text,
            position: 'down',
            colors: [{color: '#ff8600', from: 0}]
        });
    };

});



nge.App[nge.appNS].Com.SettingsScreen = {};



nge.App[nge.appNS].Com.SettingsScreen.Controller = nge.Com.Base.extend(function() {
    var _created = false;
    var _self = this;

    this.thOld = null;
    this.thNew = null;
    this.additionalBlursSystemUsed = false;
    this.slotMachineConfig = null;

    this.oldOriginal = null;
    this.newOriginal = null;


    this.turboModeSpeed = 0.5;

    this.toggles = {
        'settingsDisplayValuesInCoins': {
            obj: null,
            data : '!settings.settingsDisplayValuesInCoins'
        },
        'settingsPressSpaceToSpin': {
            obj: null,
            data : 'spaceHandler.isEnable'
        },
        'turboMode': {
            obj: null,
            data : 'settings.turboMode'
        },
        'settingsSplashScreen': {
            obj: null,
            data: '!settings.dontShowSplashScreen'
        }
    };

    this.toggleStates = {
        on: { over: 2, out:  1, down: 0 }, 
        off: { over: 6, out:  5, down: 4 }
    };

    this.sliders = {
        'audioSlider': { 
            obj: null,
            data: 'settings.globalVolume',
            event: 'sound.volumeAll',
            disable: 'sounds.preload'
        }
    };
    
    this.switchTurboMode = function(value) {
        
        var turboModeEnabled;
        if (typeof value !== 'undefined') {
            turboModeEnabled = value;
        } else {
            turboModeEnabled = nge.localData.get('settings.turboMode');
            turboModeEnabled = !turboModeEnabled;
        }

        if (_self.additionalBlursSystemUsed) {
            if (turboModeEnabled) {
                _self.slotMachineConfig.additionalBlurs = _self.thNew;
                nge.localData.set('slotMachineAdditionalBlurs', _self.thNew);
                nge.localData.set('slotMachineOriginalAdditionalBlurs', _self.thNew);
            } else {
                _self.slotMachineConfig.additionalBlurs = _self.thOld;
                nge.localData.set('slotMachineAdditionalBlurs', _self.thOld);
                nge.localData.set('slotMachineOriginalAdditionalBlurs', _self.thOld);
            }
        } else {
            _self.slotMachineConfig.th = turboModeEnabled ? _self.thNew : _self.thOld;
        }

        nge.localData.set('settings.turboMode', turboModeEnabled);
        nge.Lib.Helper.setCookie('turboModeButtonEnable', turboModeEnabled);
        nge.observer.fire('slotMachine.updateBlurs');
    };

    this._splashScreenSwitch = function() {
        var newState = !nge.localData.get('settings.dontShowSplashScreen');
        nge.Lib.Helper.setCookie('dontShowSplashScreen', newState);
        nge.localData.set('settings.dontShowSplashScreen', newState);
    };

    var _getToggleData = function (toggleName) {
        var isOn = false;
        var invert = false;
        var dataGetter = _self.toggles[toggleName].data;
        if (nge.Lib.Helper.typeCheck.isFunction(dataGetter))
            isOn = dataGetter();
        else {
            var dataString = dataGetter;
            if(dataString.indexOf('!')=== 0){
                invert = true;
                dataString = dataString.replace('!', '');
            }

            isOn = nge.localData.get(dataString);
        }

        isOn = invert ? !isOn : isOn;
        return isOn;
    };

    var _updateToggleState = function(toggleName){
        if(!_self.toggles[toggleName] || !_self.toggles[toggleName].obj)
            return;

        var isOn = _getToggleData(toggleName);
        var stateName = isOn ? 'on' : 'off';
        var state = _self.toggleStates[stateName];

        _self.toggles[toggleName].obj.setFrames(state.over, state.out, state.down);
    };

    var _buttonsPressCommand = function(toggleName){
        nge.rafSetTimeout(function(){
            _updateToggleState(toggleName);
        }, 10);
    };

    var _initControls = function(){
        var selector;
        for(var toggleName in _self.toggles){
            selector = '^'.concat(toggleName, 'ButtonButton');
            _self.toggles[toggleName].obj = nge.findOne(selector);
        }

        var dragSliderCallback = function(sliderName){
            return function(val){
                var slider = _self.sliders[sliderName];                
                if(+val !== 0 && sliderName === 'audioSlider' && slider && !nge.localData.get('sounds.preload'))
                    return nge.observer.fire('buttons.insidePress', 'soundMobile');
                nge.Lib.Helper.setCookie('audioVolume', val);
                nge.observer.fire(slider.event, val);
            };
        };

        for(var sliderName in _self.sliders){
            selector = '^'.concat(sliderName, 'ButtonContainer');
            _self.sliders[sliderName].obj = nge.findOne(selector);
            
            if(_self.sliders[sliderName].obj){
                _self.sliders[sliderName].obj.toggleBgInput(true);
                _self.sliders[sliderName].obj.setOnChange(dragSliderCallback(sliderName));
                _self.sliders[sliderName].obj.setOnDrag(dragSliderCallback(sliderName));
            }
        }
        // quick fix for non prototypes games
        if(_self.sliders.audioSlider.obj){
            let audioValue = parseFloat(nge.Lib.Helper.getCookie('audioVolume') || nge.localData.get(_self.sliders.audioSlider.data));
            let audioSteps = [];
            for (let i = 0; i < 1; i+=0.01) {
                audioSteps.push(+i.toFixed(2));
            }
            audioSteps.push(1);
            _self.sliders.audioSlider.obj.setValuesRange(audioSteps, audioValue);
        }
    };

    var _updateSlidersState = function(sliderName){
        if(!_self.sliders[sliderName] || !_self.sliders[sliderName].obj)
            return;

        var val = nge.localData.get(_self.sliders[sliderName].data);
        _self.sliders[sliderName].obj.val(val);
    };

    var _settingsUpdate = function(){
        for(var toggleName in _self.toggles)
            _updateToggleState(toggleName);

        for(var sliderName in _self.sliders)
            _updateSlidersState(sliderName);
    };

    this.switchSpaceHandler = function(value){
        var spaceHandlerEnabled;

        if (typeof value !== 'undefined') {
            spaceHandlerEnabled = value;
        } else {
            spaceHandlerEnabled = nge.Lib.Helper.getCookie('spaceButtonSpinsEnable') !== 'false';
            spaceHandlerEnabled = !spaceHandlerEnabled;
        }

        nge.Lib.Helper.setCookie('spaceButtonSpinsEnable', spaceHandlerEnabled);
    };

    this.subscribe = function(){
        nge.observer.add('buttons.pressCommand', _buttonsPressCommand);
        nge.observer.add('settings.update', _settingsUpdate);
        nge.observer.add('settings.turboModeSwitch', _self.switchTurboMode);
        nge.observer.add('settings.splashScreenSwitch', _self._splashScreenSwitch);
        nge.observer.add('spaceHandler.switched', _self.switchSpaceHandler);
    };

    this._removeTooglesOnMobile = () => { // TODO: Бимба
        if(nge.Lib.Helper.mobileAndTabletCheck()){
            if(_self.toggles.settingsPressSpaceToSpin && _self.toggles.settingsPressSpaceToSpin.obj)
                _self.toggles.settingsPressSpaceToSpin.obj.parent.destroy();

            if(_self.toggles.settingsPressSpaceToSpin)
                delete _self.toggles.settingsPressSpaceToSpin;
        }
    };

    this._reset = () => {
        var spaceButtonSpinsEnable = nge.Lib.Helper.getCookie('spaceButtonSpinsEnable') !== 'false';
        _self.switchSpaceHandler(spaceButtonSpinsEnable);

        var turboModeButtonEnableCookie = nge.Lib.Helper.getCookie('turboModeButtonEnable') === 'true';
        _self.switchTurboMode(turboModeButtonEnableCookie);
    };

    this._updateTh = () => {
        // @Todo (reiven) quick fix, refactor it
        if (this.newOriginal) {
            _self.thNew = _self.newOriginal.slice();
        } else {
            _self.thNew = _self.slotMachineConfig.additionalTurboBlurs;
            if (_self.thNew) {
                _self.newOriginal = _self.thNew.slice();
            }
        }

        if (this.oldOriginal) {
            _self.thOld = _self.oldOriginal.slice();
        } else {
            _self.thOld = _self.slotMachineConfig.additionalBlurs;
            if (_self.thOld) {
                _self.oldOriginal = _self.thOld.slice();
            }
        }
        
        nge.localData.set('slotMachineAdditionalBlurs', _self.thOld);
        nge.localData.set('slotMachineOriginalAdditionalBlurs', _self.thOld);

        
        if (_self.slotMachineConfig.additionalBlurs) {
            _self.additionalBlursSystemUsed = true;
            if (!_self.thNew) {
                _self.thNew = _self.slotMachineConfig.additionalBlurs.map(function(count){
                    return Math.round(count * _self.turboModeSpeed);
                });
            }
        } else {
            _self.additionalBlursSystemUsed = false;
            _self.thOld = _self.slotMachineConfig.th;
            _self.thNew = _self.thOld.map(function(count){
                return Math.round(count * _self.turboModeSpeed);
            });
        }
    };

    this.create = function (){
        _self.slotMachineConfig = nge.App.getInstance('Com.SlotMachine.Cfg').get();
        _initControls();
        this._updateTh();
        // press space to spin no need in mobile!
        this._removeTooglesOnMobile();

        _self._reset();
       
        if(!_created)
            _self.subscribe();

        _created = true;
    };
});



nge.App[nge.appNS].Com.SettingsSimple = {};



nge.App[nge.appNS].Com.SettingsSimple.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _soundButton;

    var _volume = {
        on : 1,
        off: 0
    };

    var _lastStateSound = 0;
    var noNeedSoundButtonAction = false;

    /**
     * create
     * @returns {Boolean} =
     */
    this.create = function () {
        this.createDefault();
        var globalVolume = nge.localData.get('settings.globalVolume');

        if (typeof globalVolume === 'undefined') {
            globalVolume = 1;
            var mobile = nge.Lib.Helper.mobileAndTabletCheck();
            var soundsPreload = nge.localData.get('sounds.preload');

            if (mobile && soundsPreload !== 'done')
                globalVolume = 0;

            nge.localData.set('settings.globalVolume', globalVolume);
        }
        _lastStateSound = globalVolume;
        if (!_created)
            _subscribe();

        _created = true;
        return true;
    };
    
    var _soundCallback = function (noSoundUpdate) {
        if (noNeedSoundButtonAction)
            return false;

        var soundsPreload = nge.localData.get('sounds.preload');

        if (!soundsPreload) {
            nge.observer.fire('sounds.preload.start');
            nge.soundManager.preload();
            return false;
        }

        if (soundsPreload !== 'done'){
            nge.localData.set('settings.globalVolume', 1);
            return false;
        }

        if(noSoundUpdate)
            return;

        var vol = nge.localData.get('settings.globalVolume');
        var newVol = (vol) ? _volume.off : _volume.on;
  
        nge.Lib.Helper.setCookie('audioVolume', newVol);
        _setSoundVolume(newVol); 
        _updateSoundButtonLink();
    };

    var _soundsPreloadedHandler = function(){
        var vol = nge.localData.get('settings.globalVolume');
        var noSoundUpdate = vol > 0;
        _soundCallback(noSoundUpdate);
    };

    var _stateCreateEnd = function (state) {
        if (state !== 'play')
            return;

        _initSoundButton();
    };

    var _initSoundButton = function () {
        var isMobile = nge.Lib.Helper.mobileAndTabletCheck();
        var buttonName = _getSoundButtonName();
        var isEnabled = nge.localData.get('settings.globalVolume');

        _updateSoundButtonLink();
       
        if (typeof isEnabled === 'undefined') {
            nge.localData.set('settings.globalVolume', 0);
            _soundCallback();
            return;
        }

        if(!isEnabled && !isMobile){
            noNeedSoundButtonAction = true;
            nge.observer.fire('buttons.insidePress', buttonName);

            nge.rafSetTimeout(function(){
                noNeedSoundButtonAction = false;
                _setSoundVolume(_volume.off);
                if (_soundButton.events.onInputOut.dispatch)
                    _soundButton.events.onInputOut.dispatch();
            }, 10);
        }
        
        if(isEnabled && isMobile){
            noNeedSoundButtonAction = true;
            nge.observer.fire('buttons.insidePress', buttonName);
           
            nge.rafSetTimeout(function(){
                noNeedSoundButtonAction = false;
                _setSoundVolume(_volume.on);
            }, 10);   
        }
    };

    var _setSoundVolume = function(volume){
        nge.localData.set('settings.globalVolume', volume);
        nge.observer.fire('sound.volumeAll', volume);
    };

    var _getSoundButtonName = function(){
        
        var isMobile = nge.Lib.Helper.mobileAndTabletCheck();
        return 'sound' + (isMobile ? 'Mobile': '');
    };

    var _updateSoundButtonLink = function(){
        
        var buttonName = _getSoundButtonName();
        _soundButton = nge.findOne('^' + buttonName + 'ButtonButton');
    };

    var _visibilityChange = function(visibilityStatus){
        if(visibilityStatus !== 'visible')
            _lastStateSound = nge.localData.get('settings.globalVolume');
        var newVolume = visibilityStatus !== 'visible' ? _volume.off : _lastStateSound;
        _setSoundVolume(newVolume);
    };

    var _subscribe = function () {
        nge.observer.add('sounds.preloaded', _soundsPreloadedHandler);
        nge.observer.add('settings.soundSwitch', _soundCallback);
        nge.observer.add('StatesManager.create.end', _stateCreateEnd);

        nge.observer.add('window.visibilitychange', _visibilityChange);

        nge.observer.add('initSoundButton', _initSoundButton);
    };
});



