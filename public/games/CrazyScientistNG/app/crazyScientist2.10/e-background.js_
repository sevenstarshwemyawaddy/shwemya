// console.log = log = logRemote;

document.addEventListener('contextmenu', function (evt) {
    evt.preventDefault();
}, false);

//main game NS
window.nge.wrap = {};

// reference to the Phaser.Game instance
window.nge.game = null;

// here we will store all states
window.nge.state = {};
window.nge.transitions = null;

// main function
window.nge.main = function () {
    var _getRenderer = function (mobile) {
        var Renderer = {
            AUTO: 0,
            CANVAS: 1,
            WEBGL: 2
        };

        //if browsers dont support webGL  - set canvas mode
        var renderer = Renderer.AUTO;
        //IE, Safari and Mobiles are not stable with WebGL
        if (mobile || browser.indexOf('IE') !== -1 || browser.indexOf('Safari') !== -1)
            renderer = Renderer.CANVAS;

        var renderer = Renderer.CANVAS;  //fps fix

        //get param ???  TODO remove
        var getRenderer = nge.Lib.Helper.parseGetParams('renderer');
        switch (getRenderer) {
            case 'canvas':
                renderer = Renderer.CANVAS;
                break;
            case 'webgl':
                renderer = Renderer.WEBGL;
                break;
            default :
                renderer = Renderer.CANVAS;
                break;
        }

        return renderer;
    };

    //-------------------------------------------//
    nge.userInfoHTML('Creating game');

    var browser = nge.Lib.Helper.browserDetect();
    log('---browser---', browser);

    var mobile = nge.Lib.Helper.mobileAndTabletCheck();
    nge.Cfg.Main.mobile = mobile;
    log('---mobile---', mobile);

    var renderer = _getRenderer(mobile);
    log('---renderer---', renderer);

    var config = {
        width: 1,
        height: 1,
        renderer: renderer,
        scale: true
    };

    nge.game = new mt.GameAdapter();
    nge.wrap.cache = new nge.Mlm.Cache.Controller();
    nge.wrap.load = new nge.Mlm.Loader.Controller(nge.wrap.cache);
    nge.wrap.states = (new nge.Mlm.States.Controller()).init(config);

    nge.transitions = new PIXI.Transitions({
        duration: 3000,
        ease: nge.Lib.Tween.Easing.Exponential.InOut,
        properties: {
            alpha: 0
        }
    });

    //launch force update before we cannot boot
    nge.phaserAdapter.forcePC('hidden');

    nge.wrap.states.add('boot', nge.state.boot);
    nge.wrap.states.start('boot');
};

window.nge.state.boot = {
    preload: function () {
        //page reload on loading error in production mode  
        if (nge.Cfg.Main.mode === 'production')
            nge.wrap.load.onError.add(function () {
                location.reload();
            }, this);

        //init mt helper
        mt.init(nge.wrap);

        //set background color - true (set also to document.body)
        mt.setBackgroundColor(true);

        var checkFocus = function () {
            if (!document.hasFocus())
                window.focus();
        };

        document.addEventListener("click", checkFocus);
        checkFocus();
    },
    create: function () {
        nge.userInfoHTML('Almost done');
        nge.phaserAdapter.forcePC(document.visibilityState);
        var run = new nge.App.Run();

        nge.Lib.Device.whenReady(function () {
            // goto default state
            run.run();
        }, this);
    }
};

window.nge.PhaserAdapter = function () {
    var _self = this;

    /**
     * Phaser init function on ready event
     * @returns {Boolean}
     */
    this.initialisePhaser = function () {
        console.log('loaded');
        window.mt.data = mt.tplsPathsPrepare(window.mt.data);
        mt.assetsPath = nge.realPathPrefix;
        window.nge.main();
        return true;
    };

    var _forcePCtimeOutID = false;

    var _clearForceTimeout = function () {
        if (_forcePCtimeOutID) {
            clearTimeout(_forcePCtimeOutID);
            _forcePCtimeOutID = false;
        }
    };

    var _forceOnLoop = function (doNotUpdateAtFirstCall) {
        if (!doNotUpdateAtFirstCall)
            nge.wrap.states.update();

        _forcePCtimeOutID = window.setTimeout(_forceOnLoop, 1);
    };

    this.forcePC = function (state) {
        if (state === 'hidden') {
            //start setTimeout
            _clearForceTimeout();
            _forceOnLoop(true);
        } else {
            //clearTimeout
            _clearForceTimeout();

            var normalizeTime = function () {
                nge.wrap.states.resetLoopTime();
            };

            if (nge.rafSetTimeout)
                nge.rafSetTimeout(normalizeTime, 50);
            else
                window.setTimeout(normalizeTime, 1);
        }
    };

    /**
     * recursive path in object replacer
     * 
     * @param {Object} obj assets data object
     * @param {String} pref path prefix
     * @returns {Object}
     */
    var _recPathReplace = function (obj, pref) {
        for (var k in obj) {
            if (typeof obj[k] === 'object')
                obj[k] = _recPathReplace(obj[k], pref);
            if (k === 'fullPath')
                obj[k] = pref + obj[k];
        }

        return obj;
    };
};



