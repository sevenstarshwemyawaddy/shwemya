};




nge.App[nge.appNS].Com.WinCounter = {};




nge.App[nge.appNS].Com.WinCounter.Controller = nge.Com.Base.extend(function () {
    let _created = false;
    let _counterTextObj = null;
    let _amount = 0;
    let _initialScale = 1;

    const COUNTER_STATE = {
        STOPPED: 0,
        COUNTER: 1,
        SCALE: 2
    };

    let _currentState = COUNTER_STATE.STOPPED;

    this.tweens = {
        counterTween: null,
        scaleTween: null
    };

    this.tweenTimeFactor = 1000;
    this.scaleAmount = 1.2;
    this.scaleDuration = 300;
    this.tweenScaleDelay = 50;

    this.counterStartHandler = (amount) => {
        amount = parseInt(amount, 10);

        if (isNaN(amount))
            return;

        _amount = amount;

        this.resetCounter();
        this.tweens.counterTween.start();
    };

    this.onScaleCompleteCallback = () => {
        this.resetCounter();
        nge.observer.fire('winCounter.finished');
    };

    this.onCounterCompleteCallback = () => {
        _counterTextObj.text = _amount;
        nge.observer.fire('winCounter.countingFinished');
        this.tweens.scaleTween.start();
    };

    this.createTweens = () => {
        const { tweenScaleDelay, scaleAmount, scaleDuration, 
                onCounterCompleteCallback, onScaleCompleteCallback } = this;
        
        _counterTextObj.scale.set(_initialScale);
       
        const easing = nge.Lib.Tween.Easing.Quadratic.InOut;
        const scaleDownIndex = 2;
        let curIndex = 0;
        let curVal = 0;

        this.tweens.scaleTween = nge.tween.add(_counterTextObj.scale).
            to({ x: scaleAmount, y: scaleAmount }, scaleDuration / 2, null, false, tweenScaleDelay).
            to({ x: _initialScale, y: _initialScale }, scaleDuration / 2, null, false, tweenScaleDelay).
            to({ alpha: 0 }, (650 - scaleDuration), easing, false, tweenScaleDelay * 3);

        this.tweens.scaleTween.onUpdateCallback((t, v) => {
           
            if(curVal > v)
                ++curIndex;

            curVal = v;

            if(scaleDownIndex === curIndex)
                _counterTextObj.alpha = 1 - v;

        });

        this.tweens.scaleTween.onStart.add(() => _currentState = COUNTER_STATE.SCALE);
        this.tweens.scaleTween.onComplete.add(onScaleCompleteCallback);

        const totalBet = nge.localData.get('totalBet.value');
        const coins = nge.localData.get('coins.value');
        
        const duration = _amount * this.tweenTimeFactor / (totalBet / coins);

        this.tweens.counterTween = nge.tween.add(_counterTextObj).to({}, duration);

        this.tweens.counterTween.onUpdateCallback((tween, value) => _counterTextObj.text = Math.ceil(_amount * value));

        this.tweens.counterTween.onStart.add(() => {
            _currentState = COUNTER_STATE.COUNTER;
            _counterTextObj.visible = true;
        });

        this.tweens.counterTween.onComplete.add(onCounterCompleteCallback);
    };

    this.customSubscribe = () => {};

    this.resetCounter = () => {
        if(_currentState !== COUNTER_STATE.STOPPED)
         for(let tweenName in this.tweens)
            this.tweens[tweenName] && this.tweens[tweenName].stop();
        

        _counterTextObj.scale.set(_initialScale);
        _counterTextObj.visible = false;
        _counterTextObj.alpha = 1;
        _counterTextObj.text = '';
        _currentState = COUNTER_STATE.STOPPED;
        this.createTweens();
    };

    this.counterStopHandler = (forceStopAll, shouldPropagateFinish) => {  

        if (forceStopAll){
            this.resetCounter();
    
            if(shouldPropagateFinish)
                nge.observer.fire('winCounter.finished');
            
            return;
        }

        switch (_currentState) {
            case COUNTER_STATE.COUNTER:
                this.tweens.counterTween.stop();
                this.onCounterCompleteCallback();
                break;
            case COUNTER_STATE.SCALE:
                this.tweens.scaleTween.stop();
                this.onScaleCompleteCallback();
                break;
            default:
                this.resetCounter();
        }
    };

    this.counterResetHandler = (shouldPropagateFinish) => {
        this.counterStopHandler(true, shouldPropagateFinish);
    };

    this._subscribe = () => {
        nge.observer.add('winCounter.start', this.counterStartHandler);
        nge.observer.add('winCounter.stop', this.counterStopHandler);
        nge.observer.add('winCounter.reset', this.counterResetHandler);
        this.customSubscribe();
    };

    this.create = () => {
        this.super.createDefault();
        _counterTextObj = nge.findOne('^winLinesCount');

        if (!_counterTextObj)
            return false;

        _initialScale = _counterTextObj.scale.x;
        this.scaleAmount *= _initialScale;

        if (!_created)
            this._subscribe();

        _created = true;
        return true;
    };
});



