nge.App[nge.appNS].Com.Bet = {};



nge.App[nge.appNS].Com.Bet.Controller = nge.Com.Bet.Controller.extend(function () {
    var _textArr;

    this.create = function () {
        this.super.create();
        _textArr = nge.findAll('.betNumber');
    };

    var _updateVal = function() {
        var extraBet = (nge.localData.get('extraBet') === '1') ? nge.localData.get('extraBetMult') : 1;
        var val = nge.localData.get('bet.value');
        for (var k in _textArr)
            _textArr[k].text = val * extraBet;
    };

    this.setVal = function (v) {
        var extraBet = (nge.localData.get('extraBet') === '1') ? nge.localData.get('extraBetMult') : 1;
        for (var k in _textArr)
            _textArr[k].text = v * extraBet;

        nge.localData.set('bet.value', v);
        nge.observer.fire('bet.change', v);
    };

    this.customSubscribe = function () {
        nge.observer.add('bet.change', _updateVal);
    };
});



nge.App[nge.appNS].Com.BetSettings = {};



nge.App[nge.appNS].Com.BetSettings.Controller = nge.Com.Base.extend(function () {
    this.isMobileOnly = true;
    var _self = this;
    var _subscribed = false;

    this.sliders = {
        'bet': {
            name: 'betLevelButtonContainer',
            obj: null
        },
        'lines': {
            name: 'linesSliderButtonContainer',
            obj: null
        },
        'coins': {
            name: 'coinValueSliderButtonContainer',
            obj: null
        }
    };

    this.availabilityCheckVars = {
        freespin: function(){
            return nge.localData.get('freespin.inProgress');
        },
        respin: function(){
            return nge.localData.get('respin.inProgress');
        },
        offer: function() {
            return nge.localData.get('freeGame.inProgress');
        },
        pickupBonusGame: function(){
            return nge.localData.get('pickBonusWon');
        }
    };

    this.availabilityCheck = function() {
        var checkVarNames = Object.getOwnPropertyNames(this.availabilityCheckVars); 
        return checkVarNames.some(function(checkVarName){
            return _self.availabilityCheckVars[checkVarName]();
        });
    };

    var _initVars = function(){
        return true;
    };

    var _setSliderValue = function(dataName){
        var data = nge.localData.get(dataName);
        var slider = _self.sliders[dataName].obj;

        if(!data || !slider)
            return;

        var min = data.cfg ? data.cfg[0] : data.value;
        var totalMin = min || 0;
        var max = (data.cfg && data.cfg.length) ? data.cfg[data.cfg.length - 1] : data.value;
        var totalMax = max || 0;
        var minText = nge.findOne('.'.concat(dataName, 'Minimum'));
        var maxText = nge.findOne('.'.concat(dataName, 'Maximum'));

        if(minText)
            minText.text = totalMin;

        if(maxText)
            maxText.text = totalMax;

        if(!data.cfg){
            data.cfg = [];
            data.cfg.push(data.value);
        }

        slider.toggleBgInput(true);
        slider.setValuesRange(data.cfg, data.value);

        slider.setOnDrag(function(value){
            if(data.value !== value){
                nge.observer.fire(dataName.concat('.set'), value);
                nge.observer.fire('denom_change.play');
            }
        });

        slider.setOnChange(function(){});
    };

    var _initSliders = function(){
        for(var sliderName in _self.sliders){
            _self.sliders[sliderName].obj = nge.findOne('^'.concat(_self.sliders[sliderName].name));
            _setSliderValue(sliderName);
        }
    };

    var _updateSliderValues = function(){
        for(var sliderName in _self.sliders){
            _setSliderValue(sliderName);
        }
    };

    var _updateSliders = function (){
        var disabled = _self.availabilityCheck();
        for(var sliderName in _self.sliders){
            _self.sliders[sliderName].obj.updateState(nge.localData.get(sliderName.concat('.value')));
            if(disabled)
                _self.sliders[sliderName].obj.disable(3);
            else
                _self.sliders[sliderName].obj.enable(1);
        }  
    };

    this.create = function () {
        var isMobileOrTablet = nge.Lib.Helper.mobileAndTabletCheck();

        if(!isMobileOrTablet && _self.isMobileOnly)
            return;

        this.createDefault();
        _initVars();
        _initSliders();
    
        if(!_subscribed)
            this.subscribe();

        _subscribed = true;
    };

    this.subscribe = function(){
        nge.observer.add('betSettings.updateSliders', _updateSliders);
        nge.observer.add('betSettings.updateSliderValues', _updateSliderValues);
    };
});



