nge.App[nge.appNS].Mlm = {};



nge.App[nge.appNS].Mlm.Brain = {};



nge.App[nge.appNS].Mlm.Brain.ButtonsExtension = function () {
    let _cache = {};
    let _getObjFromCache = name => {
        if(!_cache[name])
            _cache[name] = nge.findOne(`^${name}`);

        return _cache[name];
    };
    
    this._buttonsCreateEndHandler = () => {
        this._cofigureDroneButtons();
        this._cofigureFlaskButtons();
    };

    this.beforeUpdateHandler = function(model) {
        if(!model.spin)
            return;
    
        const spin = model.spin;
        
        let frame = 3;

        if(spin.title === nge.i18n.get(this.stopBtnName))
            frame = 7;

        spin.frame = frame;

        this.super.beforeUpdateHandler(model);
    };

    this._cofigureDroneButtons = () => {
        const config = {};

        for (let i = 1; i < 7; i++) {
            const callback = () => {
                this._changeDroneButtonsEnableStatusTo(false);
                nge.observer.fire('pickupBonusGame.sendRequest', i); 
                nge.observer.fire('sound.pick.freespins');
            };
            const name = 'dron' + i;
            config[name] = { callback };
        }

        nge.observer.fire('buttons.changeData', config);
    };

    this._cofigureFlaskButtons = () => {
        const config = {};

        for (let i = 1; i < 7; i++) {
            const callback = () =>{
                this._changeLaternButtonsEnableStatusTo(false);
                nge.observer.fire('pickupBonusGame.sendRequest', i);
                nge.observer.fire('sound.pick.multiplier');
            };
            const name = 'pg10' + i;
            config[name] = { callback };
        }

        nge.observer.fire('buttons.changeData', config);
    };

    this._changeDroneButtonsEnableStatusTo = (isEnable) => {
        const config = {};

        for (let i = 1; i < 7; i++) {
            const name = 'dron' + i;
            config[name] = { enabled: isEnable };
            const obj =_getObjFromCache(name + 'Container');
            obj && obj.children[0] && obj.children[0].scale.set(1 / nge.assets.getQualityFactor());
        }
    
        config.settings = {
            enabled: isEnable
        };

        config.paytable = {
            enabled: isEnable
        };

        nge.observer.fire('buttons.changeData', config);
    };

    this._changeLaternButtonsEnableStatusTo = (isEnable) => {
        const config = {};

        for (let i = 1; i < 7; i++) {
            const name = 'pg10' + i;
            config[name] = { enabled: isEnable };
            const obj =_getObjFromCache(name + 'Container');
            obj && obj.children[0] && obj.children[0].scale.set(1 / nge.assets.getQualityFactor());
        }

        config.settings = {
            enabled: isEnable
        };

        config.paytable = {
            enabled: isEnable
        };

        nge.observer.fire('buttons.changeData', config);
    };

    this.onPaytableHide = function(){
        const { pickBonusWon, freespin } = nge.localData.get();

        if(!pickBonusWon && !freespin.inProgress)
            this.super.onPaytableHide();

        const config = {};

        config.settings = {
            enabled: true
        };

        config.paytable = {
            enabled: true
        };

        nge.observer.fire('buttons.changeData', config);
    };

    this._disableLaternButtonsHandler = () => this._changeLaternButtonsEnableStatusTo(false);
    this._enableLaternButtonsHandler = () => this._changeLaternButtonsEnableStatusTo(true);

    this._disableDroneButtonsHandler = () => this._changeDroneButtonsEnableStatusTo(false);
    this._enableDroneButtonsHandler = () => this._changeDroneButtonsEnableStatusTo(true);

    this._buttonsPressCommandHandler = (btnName) => {
        const noPressSoundBtns = [
            'spin',
            'maxBet',
            'sound',
            'fullscreen',
            'dron0',
            'dron1',
            'dron2',
            'dron3',
            'dron4',
            'dron5',
            'dron6',
            'pg100',
            'pg101',
            'pg102',
            'pg103',
            'pg104',
            'pg105',
            'pg106'
        ];

        if(noPressSoundBtns.indexOf(btnName) === -1)
            nge.observer.fire('sound.pressButton');

        if(btnName === 'auto' && nge.localData.get('autospin'))
            nge.observer.fire('sound.autoSpinOff');

    };

    var _tryDisableLinesChanger = function (buttonState) {
        if (!buttonState.linesChanger)
            return;

        buttonState.linesChanger.enabled = false;
    };

    this.beforeUpdateHandler = function (state) {
        this.super.beforeUpdateHandler(state);
        _tryDisableLinesChanger(state);
    };


    var _onFreespinContinue = function () {
        nge.observer.fire('freespin.press.spinButton');
    };

    this.subscribe = function(){
        this.super.subscribe();
        nge.observer.add('buttons.freespinContinue', _onFreespinContinue, false, true);
        nge.observer.add('buttons.pressCommand', this._buttonsPressCommandHandler, false, true);
        nge.observer.add('buttons.latern.disable', this._disableLaternButtonsHandler, false, true);
        nge.observer.add('buttons.latern.enable', this._enableLaternButtonsHandler, false, true);
        nge.observer.add('buttons.drone.disable', this._disableDroneButtonsHandler, false, true);
        nge.observer.add('buttons.drone.enable', this._enableDroneButtonsHandler, false, true);
        nge.observer.add('buttons.create.end', this._buttonsCreateEndHandler, false, true);
    };
};



nge.App[nge.appNS].Mlm.Brain.Buttons = nge.App.RiverGameBase.Mlm.Brain.Buttons.extend(nge.App[nge.appNS].Mlm.Brain.ButtonsExtension);



nge.App[nge.appNS].Mlm.Brain.Controller = nge.App.ClassicGameBase.Mlm.Brain.Controller.extend(function () {
    this._logicBlocks.push('substrate', 'pickupBonusGame');
});



nge.App[nge.appNS].Mlm.Brain.PickupBonusGame = Class.extend(function () {
    const PICK_RESPONSE_FREESPINS = 'FreeSpins';
    const PICK_RESPONSE_MULTIPLIER = 'Multiplier';

    this._sendPickBonusRequest = (n) => {
        var mm = nge.App.getInstance('Mlm.Transport.Models.PickBonusItemRequest', false, {
            result: true,
            data: {
                index: n
            }
        });
        nge.transport.send(mm);
    };

    this._sendRequestHandler = (n) => this._sendPickBonusRequest(n);
    
    this._processFirstStageData = function(data){
        nge.localData.set('pickupBonusGame.stage1', data);
        nge.observer.fire('pickupBonusGame.stage1.finish', data);
    };

    this._processSecondStageData = function(data){
        nge.localData.set('pickupBonusGame.stage2', data);
        nge.observer.fire('pickupBonusGame.stage2.finish', data);
    };

    this._responseHandler = (data) => {
        data = data.data;
        const { type } = data.bonusItem;

        switch (type) {
            case PICK_RESPONSE_FREESPINS:
                this._processFirstStageData(data);
                break;

            case PICK_RESPONSE_MULTIPLIER:
                this._processSecondStageData(data);
                break;
        
            default:
                break;
        }

    };
    
    this._popupShowHandler = () => nge.observer.fire('background.cover.show');
    this._popupHidedHandler = () => nge.observer.fire('background.cover.hide');

    this._freespinFinishHandler = () => { nge.localData.set('pickupBonusGame',{});};

    this._stageTwoAnimationFinishedHandler = () => {
        const freeSpinsCount = nge.localData.get('pickupBonusGame.stage1.bonusItem.value');
        nge.observer.fire('freespin.start', freeSpinsCount);
        nge.observer.fire('spinAndWinComplete');
    };

    this._hidePickupBonusGame = () => {
        nge.observer.fire('pickupBonusGame.hide');
    };

    this._pickupBonusGameFinished = () => {
        nge.observer.fire('freespin.started.cs2');
        nge.observer.fire('freespin.press.spinButton');
        nge.observer.fire('slotMachine.trySpin');
    };

    this.subscribe = function () {
        nge.observer.add('pickupBonusGame.finished', this._pickupBonusGameFinished, false, true);
        nge.observer.add('freespin.startPopup.hided', this._hidePickupBonusGame, false, true);
        nge.observer.add('pickupBonusGame.stageTwoAnimation.finished', this._stageTwoAnimationFinishedHandler, false, true);
        nge.observer.add('freespin.end', this._freespinFinishHandler, false, true);
        nge.observer.add('pickupBonusGame.sendRequest', this._sendRequestHandler, false, true);
        nge.observer.add('pickBonus.startPopup.show',this._popupShowHandler , false, true);
        nge.observer.add('pickBonus.startPopup.hided',this._popupHidedHandler , false, true);
        nge.observer.add('transportMessage.PickBonusItemResponse', this._responseHandler, false, true);
    };
});



nge.App[nge.appNS].Mlm.Brain.SoundsExtension = function () {
    var _self = this;

    var _scatterCount = 0;
    var _scatterPlayColumns = [];

    var _wildCount = 0;
    var _wildPlayColumns = [];
    
    var _bigWinStopPlayed = false;

    this.scatterSymbols = ['10'];
    this.scatterReelsCount = 5;
    this.reelsCount = 5;
    this.scattersNeededForFreespins = 3;
    this.wheelSpinSoundCount = 3;

    this.wheelSpinSoundCount = 5;
    this.soundedSymbols = [];
    this.soundsUnused = [
        'rl_open',
        'denom_change',
        'sr_bell_low',
        'sr_bell_middle',
        'sr_bell_high',
        'sr_win_tiny',
        'sr_win_small',
        'sr_win_middle',
        'gn_wait',
        'db_background',
        'db_win_5',
        'db_open'
    ];

    this.soundExt = [
        { s: 'doctor_win', e: 'background.doctor.winStart', relaunch: true },
        { s: 'bs_background', e: 'jackpot.start', action: 'stop' },
        { s: 'denom_change_overrided', e: 'sound.pressButton' },
        { s: 'gn_autoplay_on', e: 'autospin.started', relaunch: true },
        { s: 'gn_autoplay_off', e: 'sound.autoSpinOff', relaunch: true },
        { s: 'bs_bn_spin', e: 'slotMachine.spinStart', relaunch: true, loop: true},
        { s: 'bs_bn_spin', e: 'slotMachine.reel_4.customPostAnimation.stopped', action: 'stop' },
        { s: 'bs_bn_spin', e: 'bs_bn_spin.stop', action: 'stop' },

        { s: 'bs_bn_wheel_stop_0', e: 'slotMachine.reel_0.animation.stopped', relaunch: true },
        { s: 'bs_bn_wheel_stop_1', e: 'slotMachine.reel_1.animation.stopped', relaunch: true },
        { s: 'bs_bn_wheel_stop_2', e: 'slotMachine.reel_2.animation.stopped', relaunch: true },
        { s: 'bs_bn_wheel_stop_3', e: 'slotMachine.reel_3.animation.stopped', relaunch: true },
        { s: 'bs_bn_wheel_stop_4', e: 'slotMachine.reel_4.animation.stopped', relaunch: true },
        { s: 'intrigue', e: 'slotMachine.reel_4.animation.stopped', action: 'stop' },

        { s: 'win_small', e: 'win_small' },
        { s: 'win_medium', e: 'win_medium'},
        { s: 'win_large', e: 'win_large'},
        { s: 'gn_win_counter', e: 'winCounter.start', relaunch: true, loop: true },
        { s: 'gn_win_counter', e: 'winCounter.countingFinished', action: 'stop' },
        { s: 'gn_win_counter_end', e: 'winCounter.countingFinished', relaunch: true },
        { s: 'intrigue', e: 'sound.intrigue.start', relaunch: true, loop: true },

        { s: 'bonus_0', e: 'bonus_0', relaunch: true },
        { s: 'bonus_1', e: 'bonus_1', relaunch: true },
        { s: 'bonus_2', e: 'bonus_2', relaunch: true },
        { s: 'bonus_3', e: 'bonus_3', relaunch: true },
        { s: 'bonus_4', e: 'bonus_4', relaunch: true },
        { s: 'scatter_0', e: 'scatter_0', relaunch: true },
        { s: 'scatter_1', e: 'scatter_1', relaunch: true },
        { s: 'scatter_2', e: 'scatter_2', relaunch: true },
        { s: 'scatter_3', e: 'scatter_3', relaunch: true },
        { s: 'scatter_4', e: 'scatter_4', relaunch: true },
        { s: 'sr_win_big', e: 'sr_win_big', relaunch: true },
        { s: 'bell', e: 'bell', relaunch: true },

        { s: 'big_win_counter', e: 'bigWin.start', relaunch: true, loop: true },
        { s: 'big_win_counter', e: 'bigWin.counter.complete', action: 'stop' },
        { s: 'big_win_counter', e: 'slotMachine.quickFinish', action: 'stop' },
        { s: 'big_win_end', e: 'cs.sound.bigWin.end' },
        { s: 'big_win_text_change', e: 'bigWin.changestate', relaunch: true },

        { s: 'big_win_end', e: 'Transport.close', action: 'stop' },
        { s: 'big_win_counter', e: 'Transport.close', action: 'stop' },
        
        { s: 'pick_appear', e: 'sound.pick.appear', relaunch: true },
        { s: 'pick_disappear', e: 'sound.pick.disappear', relaunch: true },
        { s: 'pick_free_spins', e: 'sound.pick.freespins', relaunch: true },
        { s: 'pick_multiplier', e: 'sound.pick.multiplier', relaunch: true },

        { s: 'fs_popup_start', e: 'sound.popup.start', relaunch: true },
        { s: 'fs_popup', e: 'sound.popup.won', relaunch: true },
        { s: 'xw_popup', e: 'sound.popup.finish', relaunch: true },

        { s: 'ambient_pickem', e: 'sound.stop.pick', action: 'stop' },
        { s: 'bs_background', e: 'sound.stop.regular', action: 'stop' },
        { s: 'bn_background', e: 'sound.stop.bonus', action: 'stop' },

        { s: 'ambient_pickem', e: 'sound.pause.pick', action: 'pause' },
        { s: 'bs_background', e: 'sound.pause.regular', action: 'pause' },
        { s: 'bn_background', e: 'sound.pause.bonus', action: 'pause' },

        { s: 'ambient_pickem', e: 'bigWin.start', action: 'pause' },
         
        { s: 'ambient_pickem', e: 'sound.popup.start', action: 'pause' },
        { s: 'bs_background', e: 'sound.popup.start', action: 'pause' },
        { s: 'bn_background', e: 'sound.popup.start', action: 'pause' },
        
        { s: 'ambient_pickem', e: 'popup.animate.start', action: 'pause' },
        { s: 'bs_background', e: 'popup.animate.start', action: 'pause' },
        { s: 'bn_background', e: 'popup.animate.start', action: 'pause' },
        
        { s: 'ambient_pickem', e: 'popupFinish.animate.start', action: 'pause' },
        { s: 'bs_background', e: 'popupFinish.animate.start', action: 'pause' },
        { s: 'bn_background', e: 'popupFinish.animate.start', action: 'pause' },
   
        { s: 'ambient_pickem', e: 'pickupBonusGame.finished', action: 'pause' },

        { s: 'ambient_pickem', e: 'freespin.startPopup.hided', relaunch: true, loop: true },
        { s: 'ambient_pickem', e: 'pickBonus.startPopup.hided', relaunch: true, loop: true },
        { s: 'bn_background', e: 'pickupBonusGame.finished', relaunch: true, loop: true },
        { s: 'bs_background', e: 'popupFinish.animate.stop', relaunch: true, loop: true },

        { s: 'ambient_pickem', e: 'sound.start.pick', relaunch: true, loop: true },
        { s: 'bs_background', e: 'sound.start.regular', relaunch: true, loop: true },
        { s: 'bn_background', e: 'sound.start.bonus', relaunch: true, loop: true }
    ];

    var _isBigWin = function(data){
        if(!data.slotWin)
            return;

        var totalBetValue = nge.Lib.Money.toCoins(+nge.localData.get('totalBet.value'));
        var winCoins = nge.Lib.Money.toCoins(+data.slotWin.totalWin);

        return winCoins >= totalBetValue * 10;
    };

    this.determineWinEvent = function (amount) {
        var totalBetValue = nge.Lib.Money.toCoins(+nge.localData.get('totalBet.value'));
        var winCoins = nge.Lib.Money.toCoins(amount);

        if (winCoins <= totalBetValue * 2)
            return 'win_small';
        if (winCoins <= totalBetValue * 5)
            return 'win_medium';
        if (winCoins < totalBetValue * 10)
            return 'win_large';

        return 'sr_win_big';
    };

    var _winlinesAnimateAll = function () {
        _self.winSoundsQueue.stop();
        _self.winSoundsQueue.reset();
   
        if(nge.localData.get('bonusWin'))
            return nge.observer.fire('bell');
        
        var totalWin = nge.localData.get('slotMachine.slotWin.totalWin');
        var event = _self.determineWinEvent(totalWin);
        
        _self.winSoundsQueue.push(event);
        _self.winSoundsQueue.play();
    };

    var _subscribeSoundedSymbols = function(i) {
        var callback = function(){

            if(_scatterPlayColumns[i]){
                nge.observer.fire(`bonus_${_scatterCount}`);
                ++_scatterCount;
                return;
            }

            if(_wildPlayColumns[i]){
                nge.observer.fire(`scatter_${_wildCount}`);
                ++_wildCount;
                return;
            }
        };
    
        nge.observer.add(`slotMachine.reel_${i}.animation.stopped`, callback, false, true);
    };

    var _spinStartHandler = function(){
        _scatterPlayColumns = [];
        _wildPlayColumns = []; 
        _scatterCount = 0;
        _wildCount = 0;
        _bigWinStopPlayed = false;
        nge.localData.set('bigWin.show', false);
    };

    var _soundBackgroundStopOrPause = function(needStop = false){
        const type = needStop ? 'stop' : 'pause';

        ['pick', 'bonus', 'regular'].forEach(sound => {
            const event = `sound.${type}.${sound}`;
            nge.observer.fire(event);
        });
    };

    var _soundBackgroundStart = (needStart = false) => {
        _soundBackgroundStopOrPause(needStart);
        const type = needStart ? 'start' : 'start'; // 'resume'
        const restoredType = nge.localData.get('slotMachine.lastResponse.state');
        let { state } = nge.localData.get('slotMachine');

        if(restoredType)
            state = restoredType;

        let event = `sound.${type}.`;

        switch (state){
            case 'PickFreeSpins':
                event += 'pick';
                break;
            case 'FreeSpins':
                event += 'bonus';
                break;
            default :
                event += 'regular';
                break;
        }

        nge.observer.fire(event);
    };

    var _setBgSoundVolumeTo = function (to) {
        nge.observer.fire('sound.volume', { s: 'bn_background', volume: to });
        nge.observer.fire('sound.volume', { s: 'bs_background', volume: to });
    };

    var _soundBackgroundStartHandler = function(){
        _soundBackgroundStart(true);
    };

    
    var _statesManagerCreateEndHandler = function (state) {
        var lastResponse = nge.localData.get('brain.restoreGame.lastResponse');
        if (state === 'play' && !lastResponse)
            nge.observer.fire('sound.background.start', null, 1000);
    };

    var _spinResponseHandler = function (data) {
        nge.localData.set('bigWin.show', _isBigWin(data));

        const checkForSymbol = (symbol, column) => column.indexOf(symbol) !== -1;
        const { columns } = data.spinResult;
        let wildCount = 0;
        let scatterCount = 0;

        columns.forEach((col, index) => {
            _wildPlayColumns[index] = checkForSymbol('11', col);
            _scatterPlayColumns[index] = checkForSymbol('10', col);
        });

        wildCount = _wildPlayColumns.filter(elem => elem).length;
        scatterCount = _scatterPlayColumns.filter(elem => elem).length;
     

        if(wildCount === 1 && _wildPlayColumns[4])
            _wildPlayColumns[4] = false;

        if(scatterCount === 1 && _scatterPlayColumns[4])
            _scatterPlayColumns[4] = false;

        if(scatterCount === 1 && _scatterPlayColumns[3])
            _scatterPlayColumns[3] = false;

        if(scatterCount === 2 && _scatterPlayColumns[3] && _scatterPlayColumns[4]){
            _scatterPlayColumns[3] = false;
            _scatterPlayColumns[4] = false;
        }

        if(scatterCount === 2 && _scatterPlayColumns[4])
            _scatterPlayColumns[4] = false;
    };

    this.customSubscribe = function () {
        this.super.customSubscribe();
        nge.observer.add('sounds.preloaded', _soundsPreloaded, false, true);
        nge.observer.add('Transport.close', () => {
            nge.observer.fire('bs_bn_spin.stop');
        }, false, true);
        
        nge.observer.add('winlines.animateAll', _winlinesAnimateAll, false, true);
        nge.observer.add('slotMachine.spinStart', _spinStartHandler, false, true);
        _subscribeSoundedSymbols(0);
        _subscribeSoundedSymbols(1);
        _subscribeSoundedSymbols(2);
        _subscribeSoundedSymbols(3);
        _subscribeSoundedSymbols(4);
        nge.observer.add('slotMachine.spinResponse', _spinResponseHandler, false, true);
        nge.observer.add('sound.background.start', _soundBackgroundStartHandler, false, true);

        nge.observer.add('bigWin.complete', () => {
            _setBgSoundVolumeTo(1);
        }, false, true);

        nge.observer.add('bigWin.start', () => {
            const { state } = nge.localData.get('slotMachine');
            
            if(state === 'PickFreeSpins'){
                nge.observer.fire('sound.stop.regular');
                nge.observer.fire('sound.stop.bonus');
            }
                
            _setBgSoundVolumeTo(0);
            
        }, false, true);

        nge.observer.add('bigWin.counter.complete', function(){
            if(!_bigWinStopPlayed)
                nge.observer.fire('cs.sound.bigWin.end');

            _bigWinStopPlayed = true;

        }, false, true);
        
        nge.observer.add('bigWin.quickFinish.start', function(){
            if(!_bigWinStopPlayed && nge.localData.get('bigWin.show'))
                nge.observer.fire('cs.sound.bigWin.end');
            
            _bigWinStopPlayed = true;

        }, false, true);

        nge.observer.add('StatesManager.create.end', _statesManagerCreateEndHandler, false, true);
    };

    var _soundsPreloaded = function(){
        if(!nge.Lib.Helper.mobileAndTabletCheck())
            return;

        nge.observer.fire('sound.background.start');
    };


    this.constructor = function () {
        nge.localData.set('scatterSymbols', this.scatterSymbols);
        this.winSoundsQueue = nge.App.getInstance('Mlm.Brain.SoundsQueue', false, this, []);

        let indexes = [];
        
        this._soundCfgBase.forEach((e, i) => { 
            if(e.s === 'bn_background' && (e.e === 'winlines.animateAll' || e.e === 'winlines.animateByOne.cycleComplete'))
                indexes.push(i);      
        });

        var modifier = 0;
        if(indexes.length !== 0)
            indexes.forEach(function(index){
                _self._soundCfgBase.splice(index - modifier, 1);
                ++modifier;
            });    
    };
};



nge.App[nge.appNS].Mlm.Brain.Slot = nge.App.RiverGameBase.Mlm.Brain.Slot.extend(function () {
    this.canIntrigue = true;
    let _oneByOneStarted = false;
    let _stateChanged = false;
    let _spins = 0;
    let _pickFinished = false;
    let _bigWinWaitingCallback = null;
    let _bigWinWaitingRafId = null;
    let _bigWinShowTimes = 0;
    var _printWin = this.printWin;
    var _winCounterWasShown = false;
    var _retriggerBonusInProgress = false;

    this.printWin = () => {};

    var _printTotalWin = function(){
        var slotMachine = nge.localData.get('slotMachine');
        var freespinInProgress = nge.localData.get('freespin.inProgress');

        if (!slotMachine.slotWin)
            return;

        var winAmount = freespinInProgress ? (slotMachine.totalBonusWin || slotMachine.slotWin.totalWin) : slotMachine.slotWin.totalWin;
        var winInCoins = nge.Lib.Money.toCoinsInt(winAmount);

        _printWin(winInCoins);
    };


    this.bonusGameHandler = function (data) {
        nge.observer.add(
            'brain.runBonusGame',
            function (bonusName) {
    
                if (bonusName === 'Ready') {
                    bonusName = 'play';
                } else if (bonusName === 'Bonus') {
                    bonusName = 'bonusGame';
                } else if (bonusName === 'PickFreeSpins'){
                    return;
                } else {
                    bonusName = nge.Lib.Helper.lowerFirstLetter(bonusName);
                }
                nge.statesManager.display(bonusName, true);
            },
            false,
            true
        );
    };

    var _startOneByOneAnimation = function(){
        if(_oneByOneStarted)
            return;
        
        _oneByOneStarted = true;
        
        var slotMachine = nge.localData.get('slotMachine');
        
        nge.observer.fire('winlines.pauseAnimation', true);
        nge.observer.fire('winlines.setNewQuery', slotMachine);
        nge.observer.fire('winlines.animateByOne');
    };

    var _startPickFreespins = function(){
        if(nge.localData.get('autospin'))
            nge.observer.fire('autospin.off');

        nge.localData.set('pickBonusWon', true);  
        
        nge.observer.fire('buttons.disable.all');
        nge.observer.fire('cs2.buttons.stop.showDisabled');
        nge.observer.fire('winlines.pauseAnimation', true);
        nge.observer.fire('pickupBonusGame.start', null, 100);
    };

    var _tryStartPickBonus = function(){
        const { state } = nge.localData.get('slotMachine');

        const needStartPickGame = state === 'PickFreeSpins' && !nge.localData.get('slotMachineSpinning');

        if(needStartPickGame)
            _startPickFreespins();
        
        return needStartPickGame;
    };

    this.balanceResponseHandler = data => {
        this.super.balanceResponseHandler(data);
        this.tryLaunchJackpot();
    };
    
    var _tryFinishFreespin = function(){
        const { state } = nge.localData.get('slotMachine');
        const { inProgress } = nge.localData.get('freespin');


        if(state === 'Ready' && inProgress && _winCounterWasShown){
            _finishCycle();
            return true;
        }
    };

    var _firstWinlineAnimationComplete = function () {
        _startOneByOneAnimation();
    };

    var _spinResponseHandler = function (data) {
        const lineWinAmounts = nge.Lib.Helper.recursiveGet('data.slotWin.lineWinAmounts', data, false);

        if(!lineWinAmounts)
            return;

        const bonusWin = lineWinAmounts.filter(lineWinAmount => lineWinAmount.type === 'Bonus')[0];
        nge.localData.set('bonusWin', !!bonusWin);

        nge.localData.set('spaceHandler.isEnable', true);
    };
    
    this.updateFreespinWin = function(win){
        if(isNaN(win))
            win = nge.Lib.Money.toCoins(nge.localData.get('slotMachine.totalBonusWin'));

        var restoreTotalBonusWin = nge.localData.get('brain.restoreGame.lastResponse.totalBonusWin');
        var totalWin = 0;

        if(restoreTotalBonusWin){
            totalWin = nge.Lib.Money.toCoins(restoreTotalBonusWin);
        } else {
            var freespinInProgress = nge.localData.get('freespin.inProgress');
            var totalBonusWin = nge.Lib.Money.toCoins(nge.localData.get('slotMachine.totalBonusWin'));
            totalWin = (freespinInProgress && totalBonusWin) ? totalBonusWin : win;
        }

        nge.observer.fire('infoPanel.showText', this.getWinData(totalWin));
        nge.observer.fire('creditsWin.setValue', totalWin);
    };   

    var _winlinesAnimateAllHandler = function () {
        if (nge.localData.get('wasQuickFinish')) {
            nge.rafSetTimeout(function () {
                if (_bigWinWaitingCallback)
                    _bigWinWaitingCallback();
                // nge.localData.set('wasQuickFinish', false);
                nge.localData.set('slotMachine.quickFinishWaiting', true);
                nge.observer.fire('slotMachine.quickFinish');
            }, 1);
        }

        if(nge.localData.get('bonusWin'))
            return;

        var totalWin = nge.localData.get('slotMachine.slotWin.totalWin');
        var totalCoinsWin = nge.Lib.Money.toCoinsInt(totalWin);
        
        var duration = totalWin / +nge.localData.get('totalBet.value') / 0.5 * 150;

        var bigWinParams = {
            duration: duration, 
            value: totalCoinsWin
        };
    
        if (!isNaN(totalCoinsWin) && totalCoinsWin > 0)
            if (nge.localData.get('bigWin.show')) {
                _bigWinWaitingCallback = function () {
                    if (_bigWinWaitingRafId) {
                        nge.rafClearTimeout(_bigWinWaitingRafId);
                        _bigWinWaitingRafId = null;
                    }
                    _bigWinWaitingCallback = null;
                    
                    if(_bigWinShowTimes === 0)
                        nge.observer.fire('riverslot.bigWin.show', bigWinParams);

                    _bigWinShowTimes++;
                    
                };
                _bigWinWaitingRafId = nge.rafSetTimeout(function () {
                    if (_bigWinWaitingCallback)
                        _bigWinWaitingCallback();
                }, 1000);
            } else
                nge.observer.fire('winCounter.start', totalCoinsWin);
        else {
            // if(_tryRetriggerFreespin())
            //     return;
            _tryStartPickBonus();
        }
            
    };

    this.restoreBonusGame = function (data) {
        nge.statesManager.display('play');
        _retriggerBonusInProgress = false;
    };

    var _statesManagerCreateEndHandler = function (state) {
        _winCounterWasShown = false;

        var lastResponse = nge.localData.get('brain.restoreGame.lastResponse');
        
        if (state !== 'play' || !lastResponse)
            return;

        nge.localData.set('offers.restoreGame', true);

        if (lastResponse.state === 'PickFreeSpins') {
            _startPickFreespins();
        } else if(lastResponse.state === 'PickMultyplier'){
            var stage1 = {
                bonusItem: {
                    value: lastResponse.freeSpinsTotal
                },
                state: lastResponse.state
            };

            nge.localData.set('pickupBonusGame.stage1', stage1);
            _startPickFreespins();
        }
    };

    var _finishCycle = function(){
        nge.observer.fire('winlines.animateByOne.cycleComplete');
    };

    this.freespinStart = () => {
        if(!nge.localData.get('freespin.inProgress'))
            this.super.freespinStart();
    };

    this.stateChangedCallback = () => {
        _stateChanged = true;
    };

    this.quickFinishHandler = function () {
        if(!nge.localData.get('bigWin.show')) {
            nge.observer.fire('winCounter.stop');
        } else {
            nge.observer.fire('buttons.disable.all');
            nge.observer.fire('cs2.buttons.stop.showDisabled');
            nge.localData.set('wasQuickFinish', true);
        }
    };

    this.trySpinHandler = () => {
        const freespin = nge.localData.get('freespin');
        const freespinFinish = freespin.inProgress && (parseInt(freespin.spinsLeft, 10) === 0) && nge.localData.get('wasQuickFinish');
        
        if(!freespinFinish && !_retriggerBonusInProgress)
            this.super.trySpinHandler();
    };

    var _spinCommandHandler = function () {
        _winCounterWasShown = false;
        _oneByOneStarted = false;
        _stateChanged = false;
        nge.localData.set('brain.restoreGame');
        _retriggerBonusInProgress = false;
    };

    this.startCounterHandler = () => {
        this.super.startCounterHandler();

        _winCounterWasShown = true;
    };
    
    this.counterFinished = () => {
        if(_tryStartPickBonus())
            return;

        if(_tryFinishFreespin())
            return;

        if(!nge.localData.get('slotMachineSpinning') && !_stateChanged && _winCounterWasShown)
            _finishCycle();
        
        this.super.counterFinished();
    };

    this.countingFinishedHandler = () => {
        _printTotalWin();
        
        if(_tryRetriggerFreespin(true))
            return;

        this.super.countingFinishedHandler();
    };

    var _freespinStartHandler = function(spins){
        _spins = spins;

        if(!nge.localData.get('pickupBonusGame.stage1.bonusItem.value'))
            nge.localData.set('pickupBonusGame.stage1.bonusItem.value', spins);
    };

    this.printFreesinData = function(){
        var freespinData = nge.localData.get('freespin');
        var spinsLeft = parseInt(freespinData.spinsLeft, 10);
        var spinsTotal = parseInt(freespinData.spinsTotal, 10);

        nge.observer.fire('freespin.counterUpdate', {total: spinsTotal, current: spinsTotal - spinsLeft});
    };

    var _freespinStartedHandler = function(){
        var freespinData = nge.localData.get('freespin');
        var spinsLeft = parseInt(freespinData.spinsLeft, 10);
        var spinsTotal = parseInt(freespinData.spinsTotal, 10);

        if(!spinsTotal || isNaN(spinsTotal)){
            spinsLeft = parseInt(_spins, 10);
            spinsTotal = parseInt(_spins, 10);
        }

        // nge.localData.set('freespin.spinsLeft', spinsLeft);
        // nge.localData.set('freespin.spinsTotal', spinsTotal);

        nge.observer.fire('freespin.counterUpdate', {total: spinsTotal, current: spinsTotal - spinsLeft});
    };

    this.winDecreaseTextComplete = function(winnerPaid, win){
        var totalBonusWin = nge.Lib.Money.toCoins(nge.localData.get('slotMachine.totalBonusWin'));
        winnerPaid = (totalBonusWin) ? totalBonusWin : winnerPaid;

        var text = '';
        var colorFrom = 0;
        if (winnerPaid > 0) {
            nge.observer.fire('sound.gamble.taking.stop');
            text = nge.i18n.get('WINNER PAID') + ' ';
            colorFrom = text.length;
            text += winnerPaid + ' '; // ' ' is for correct winNumber output

            nge.observer.fire('creditsWin.setValue', winnerPaid);
            nge.observer.fire('win.winField.setValue', win);
            nge.observer.fire('infoPanel.showText', this.getWinnerData(text, colorFrom));
        }
    };

    this.pickupBonusGameFinishedHandler = () => {
    
    };

    this._pickBonusGameStage2Finished = () => {
        _pickFinished = true;
        this.setState('FreeSpins');
        nge.localData.set('pickBonusWon', false);  
    };

    this.spinStartHandler = () => {
        this.super.spinStartHandler();

        nge.localData.set('brain.restoreGame');

        if(_pickFinished)
            this.setState('FreeSpins');
        
        _bigWinShowTimes = 0;
        _pickFinished = false;
    };

    this._winHandler = amount => {
        const totalBet = nge.localData.get('totalBet.value');
        const needDoctorAnimation = (amount/totalBet) >= 2;

        if(needDoctorAnimation)
            nge.observer.fire('background.doctor.winStart');
    };

    var _tryRetriggerFreespin = function(withoutWin){
        const { freespin, slotMachine } = nge.localData.get();
        const { inProgress } = freespin;
    
        if(!slotMachine.slotWin || !inProgress)
            return false;

        const bonus = slotMachine.slotWin.lineWinAmounts.filter(line => line.bonusName === 'FreeSpins');
        const winAmount = parseFloat(slotMachine.slotWin.totalWin);
        
        if(bonus && (!winAmount || withoutWin) && !_retriggerBonusInProgress){
            _retriggerBonusInProgress = true;
            nge.observer.fire('spinAndWinComplete', null, 1000);
            return true;
        }

        return false;
    };

    this.spinCompleteHandler = function(){
        this.super.spinCompleteHandler();

        const { freespin, slotMachine } = nge.localData.get();
        const { inProgress } = freespin;
    
        if(!slotMachine.slotWin && !inProgress)
            this.tryLaunchJackpot();

    };

    this._popupHidedHandler = function(){
        _retriggerBonusInProgress = false;
        this._setCounterFinished(true);
    };
    
    this.customSubscribe = function () {
        this.super.customSubscribe();

        nge.observer.add('pickupBonusGame.stage2.finish', this._pickBonusGameStage2Finished, false, true);
        nge.observer.add('win', this._winHandler, false, true);
        nge.observer.add('pickupBonusGame.finished', this.pickupBonusGameFinishedHandler, false, true);
        nge.observer.add('StatesManager.create.end', _statesManagerCreateEndHandler, false, true);
        nge.observer.add('slotMachine.spinCommand', _spinCommandHandler, false, true);
        nge.observer.add('winlines.animateAll', _winlinesAnimateAllHandler, false, true);
        nge.observer.add('transportMessage.SpinResponse', _spinResponseHandler, false, true);
        nge.observer.add('transportMessage.FreeSpinResponse', _spinResponseHandler, false, true);
        nge.observer.add('winlines.animateByOne.cycleComplete.firstTime', _firstWinlineAnimationComplete, false, true);
        nge.observer.add('freespin.start', _freespinStartHandler, false, true);
        nge.observer.add('freespin.started.cs2', _freespinStartedHandler, false, true);
        nge.observer.add('cs2.finishPopup.hided', this._popupHidedHandler, false, true);
    };
});



nge.App[nge.appNS].Mlm.Brain.Sounds = nge.App.ClassicGameBase.Mlm.Brain.Sounds.extend(nge.App[nge.appNS].Mlm.Brain.SoundsExtension);



nge.App[nge.appNS].Mlm.Brain.Substrate = Class.extend(function () {
 
    this.animateSymbolHandler = (position) => nge.observer.fire('substrate.animate', position);
