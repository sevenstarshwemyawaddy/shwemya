nge.Mlm.Objects.Slider = function (param) {
    if (!param)
        param = {};
    var _self;
    var _bg;
    var _handler;
    var _tooltip;
    var _checkObjectsLinks = function () {
        if (!_bg || !_handler)
            _self.children.forEach(function (item) {
                if (item instanceof Phaser.Button) {
                    _handler = item;
                    return;
                }
                if (item instanceof Phaser.Group) {
                    _tooltip = item;
                    return;
                }

                if (item instanceof Phaser.Text) {
                    return;
                }

                if (item.key && item.key.indexOf('_bg') !== -1)
                    _bg = item;
            });
    };
    return {
        'id': (param.hasOwnProperty('id')) ? param.id : false,
        'name': (param.hasOwnProperty('name')) ? param.name : false,
        'class': (param.hasOwnProperty('class')) ? param.class : false,
        'scaleX': (param.hasOwnProperty('scaleX')) ? param.scaleX : 1,
        'scaleY': (param.hasOwnProperty('scaleY')) ? param.scaleY : 1,
        'alignX': (param.hasOwnProperty('alignX')) ? param.alignX : 'left',
        'alignY': (param.hasOwnProperty('alignY')) ? param.alignY : 'top',
        'angle': (param.hasOwnProperty('angle')) ? param.angle : 0,
        'alpha': (param.hasOwnProperty('alpha')) ? param.alpha : 1,
        'isVisible': (param.hasOwnProperty('isVisible')) ? param.isVisible : true,
        'x': (param.hasOwnProperty('x')) ? param.x : 0,
        'y': (param.hasOwnProperty('y')) ? param.y : 0,
        'z': (param.hasOwnProperty('z')) ? param.z : 0,
        'value': (param.hasOwnProperty('value')) ? param.value : 0, //0-100
        'vertical': (param.hasOwnProperty('vertical')) ? param.vertical : false, //todo
        'bgAssetKey': (param.hasOwnProperty('bgAssetKey')) ? param.bgAssetKey : false,
        'fillAssetKey': (param.hasOwnProperty('fillAssetKey')) ? param.fillAssetKey : false,
        'tooltipBg': (param.hasOwnProperty('tooltipBg')) ? param.tooltipBg : false,
        'tooltipText': (param.hasOwnProperty('tooltipText')) ? param.tooltipText : false,
        'valueText': (param.hasOwnProperty('valueText')) ? param.valueText : false,
        'handleAssetKey': (param.hasOwnProperty('handleAssetKey')) ? param.handleAssetKey : false,
        'onDrag': (param.hasOwnProperty('onDrag')) ? param.onDrag : false, //function, onDrugUpdate
        'onChange': (param.hasOwnProperty('onChange')) ? param.onChange : false, //function, drag stop handler
        'marginLeft': (param.hasOwnProperty('marginLeft')) ? parseInt(param.marginLeft) : 0,
        'marginRight': (param.hasOwnProperty('marginRight')) ? parseInt(param.marginRight) : 0,
        'type': mt.objects.SLIDER,
        'assetKey': (param.hasOwnProperty('assetKey')) ? param.assetKey : false,
        //system
        _originalModel: (param.hasOwnProperty('_originalModel')) ? param._originalModel : (param) ? nge.Lib.Helper.jsObjClone(param) : null,

        _protoF: {
            toggleTooltipAutoUpdate: function (enabled) { // TODO: rename
                _self.autoUpdate = enabled;
            },
            setTooltipValue: function (value) { // TODO: rename
                _self.setTextValue(value);
            },
            /**
             * set value to slider
             * @param {Number} val 0-100
             * @returns {Boolean} - Always true
             */
            val: function (val) {
                if (!_self)
                    _self = this;
                _checkObjectsLinks();
                if (val !== undefined) {
                    _handler.setValue(val / 100.0);
                    _handler.events.onDragStop$dispatch(null, null);
                    return true;
                }

                var data = _self.getData();
                //just return current value
                var from = _bg.width - (data.marginLeft + data.marginRight);
                var to = _handler.x - data.marginLeft;
                val = to * 100 / from;
                return val.toFixed(0);
            },
            setOnDrag: function (callback) {
                this.getData().onDrag = callback;
            },
            setOnChange: function (callback) {
                this.getData().onChange = callback;
            }
        }
    };
};



