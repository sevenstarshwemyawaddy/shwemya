nge.Cfg.Resolutions = Class.extend(function () {
    this.singleton = true;

    this.contents = [
        {
            "name": 'main',
            "width": 1920,
            "height": 1080,
            "orientation": 0,
            "adaptive": false,
            "_fixed": 1
        }/*,
         {
         "name": 'med',
         "width": 1024,
         "height": 768,
         "orientation": 0
         },
         {
         "name": 'low',
         "width": 512,
         "height": 384,
         "orientation": 0
         },
         {
         "name": 'low-album',
         "width": 512,
         "height": 384,
         "orientation": 1
         }*/
        /*,
         {
         "name": 'medium',
         "width": 1366,
         "height": 768,
         "orientation": 0,
         "_fixed": 1
         },
         {
         "name": 'low',
         "width": 1136,
         "height": 640,
         "orientation": 0,
         "_fixed": 1
         }*/
        /*,
         {
         "name": 'portrait',
         "width": 1200,
         "height": 1600,
         "orientation": 1,
         "_fixed": 1
         },
         {
         "name": 'test1',
         "width": 1080,
         "height": 720,
         "orientation": 0
         },
         {
         "name": 'test2',
         "width": 600,
         "height": 400,
         "orientation": 0
         },
         {
         "name": 'test3',
         "width": 800,
         "height": 1000,
         "orientation": 1
         },
         {
         "name": 'test4',
         "width": 400,
         "height": 600,
         "orientation": 1
         }*/
    ];

    this.adaptiveCfg = {//works only if "adaptive": true  for current resolution
        desctop: {
            supported: false,
            limits: {
                horizontal: {
                    min: 1, // width:height factor
                    max: 2
                },
                vertical: {
                    min: 0.5,
                    max: 1
                }
            }
        },
        mobile: {
            supported: true,
            limits: {
                horizontal: {
                    min: 1, // width:height factor
                    max: 2
                },
                vertical: {
                    min: 0.5,
                    max: 1
                }
            }
        }
    };

    /**
     * get contents
     * @returns {Object}
     */
    this.get = function () {
        return this.contents;
    };

    /**
     * get adaptiveCfg
     * @returns {resolutionsResolutions.adaptiveCfg}
     */
    this.getAdaptive = function () {
        return this.adaptiveCfg;
    };

    this.orientations = function () {
        var orientations = [];

        for (var i = 0; i < this.contents.length; i++)
            if (orientations.indexOf(this.contents[i].orientation) === -1)
                orientations.push(this.contents[i].orientation);

        return orientations;
    };

    this.orientationsStrings = function () {
        var orientations = this.orientations();

        for (var i = 0; i < orientations.length; i++)
            orientations[i] = nge.Cfg.Main.orientations[orientations[i]];

        return orientations;
    };

    this.maxSize = function () {
        return Math.max(this.maxWidth(), this.maxHeight());
    };

    this.maxWidth = function () {
        return _maxDimension.call(this, 'width');
    };

    this.maxHeight = function () {
        return _maxDimension.call(this, 'height');
    };

    var _maxDimension = function (dim) {
        return this.contents.reduce((res, obj) => obj[dim] > res ? obj[dim] : res, 0);
    };
});



