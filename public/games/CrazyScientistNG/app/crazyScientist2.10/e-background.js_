nge.Com.Buttons = {};



nge.Com.Buttons.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _cfg;

    this.create = function () {
        this.createDefault();

        var cfg = this.getInstance('Cfg');
        _cfg = cfg.get();

        var restoreGame = nge.localData.get('brain.restoreGame');
        if (restoreGame && restoreGame.lastResponse && restoreGame.lastResponse.state === 'FreeSpinReady') {
            _paytableButtonDisable();
            _settingsButtonDisable();
            _euroButtonDisable();
        }
        if (!_created) {
            _subscribe();
        }
        _created = true;
    };

    var _paytableButtonEnable = function () {
        _enableButton(_cfg.paytableButton, true);
    };

    var _paytableButtonDisable = function () {
        _enableButton(_cfg.paytableButton, false);
    };

    var _settingsButtonEnable = function () {
        _enableButton(_cfg.settingsButton, true);
    };

    var _settingsButtonDisable = function () {
        _enableButton(_cfg.settingsButton, false);
    };

    var _euroButtonEnable = function () {
        _enableButton(_cfg.euroButton, true);
    };

    var _euroButtonDisable = function () {
        _enableButton(_cfg.euroButton, false);
    };

    var _enableButton = function (name, enable) {
        var button = nge.find('^' + name);
        if (button)
            enable ? button.enable(1) : button.disable(3);
    };

    var _subscribe = function () {
        nge.observer.add(
                'paytableButton.disable',
                _paytableButtonDisable
                );
        nge.observer.add(
                'paytableButton.enable',
                _paytableButtonEnable
                );
        nge.observer.add(
                'settingsButton.disable',
                _settingsButtonDisable
                );
        nge.observer.add(
                'settingsButton.enable',
                _settingsButtonEnable
                );
        nge.observer.add(
                'euroButton.disable',
                _euroButtonDisable
                );
        nge.observer.add(
                'euroButton.enable',
                _euroButtonEnable
                );
    };
});



nge.Com.Buttons.Cfg = Class.extend(function () {
    this.singleton = true;

    this.cfg = {
        'paytableButton': 'btn_paytable',
        'settingsButton': 'btn_settings',
        'euroButton': 'btn_euro',
        'autospinButton': 'btn_autospin'
    };

    this.get = function () {
        return this.cfg;
    };

});



nge.Com.ClearButton = {};



nge.Com.ClearButton.Cfg = Class.extend(function () {
    this.singleton = true;

    this.cfg = {
        color: '#fff',
        stroke: '#766ce2',
        offset: {
            x: 0,
            y: -7
        }
    };

    this.get = function () {
        return this.cfg;
    };

});



nge.Com.ClearButton.Controller = nge.Com.Base.extend(function () {
    var _self;
    var _cfg;
    var _created;

    this.preload = function () {
        _self = this;
        if (!_cfg){
            _getCfg();
        }
        this.preloadDefault(false, _cfg);
    };

    this.create = function () {

        this.createDefault();

        if (!_created) {
            _subscribe();
        }
        _created = true;
        this.animateDefault();
    };
    var _getCfg = function () {
        _cfg = _self.getInstance('Cfg');
        return true;
    };

    var _disable = function(){
        var button = nge.find('^clearButtonTexture');
        if (button){
            button.disable(3);
        }
    };
    var _enable = function(){
        var button = nge.find('^clearButtonTexture');
        if (button){
            button.enable(1);
        }
    };

    var _subscribe = function () {
        nge.observer.add('clearButton.enable', _enable);
        nge.observer.add('clearButton.disable', _disable);
    };
});



nge.Com.ClearButton.Animator = Class.extend(function () {

    this.firstCreation = function (callback) {
        _firstCreation(callback);
        return true;
    };

    var _firstCreation = function (callback) {
        var container = nge.find('^clearButtonContainer');

        var y = container.y + 200;


        var reelTween = nge.tween.add(container);
        reelTween.from({
            y: y
        }, 600, nge.Lib.Tween.Easing.Back.Out, false, 800).onComplete.add(function () {
            if (callback)
                callback();
        });
        reelTween.start();
    };
});



