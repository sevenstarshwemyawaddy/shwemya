                    x: 250,
                    y: 101,
                    contents: data
                }
            ]
        }
    };
};



nge.App[nge.appNS].Mlm = {};



nge.App[nge.appNS].Mlm.Brain = {};



nge.App[nge.appNS].Mlm.Brain.Buttons = Class.extend(function () {

    this.enableNewLogic = false;
    var _self = this;
    var _gambleWasShown;
    var _gambleBlack;
    var _gambleRed;
    var _showGamble;
    var _offerFinishFlag;
    var _canGamble;
    var _staticContainer;
    var _cycleComplete;
    var _isWin;
    var _buttonsWasCreated = false;
    var _scenesWasCreated = false;

    this.paytableBtnName = 'PAY TABLE';

    this.hold1 = 'HOLD 1';
    this.hold2 = 'HOLD 2';
    this.hold3 = 'HOLD 3';
    this.hold4 = 'HOLD 4';
    this.hold5 = 'HOLD 5';
    this.holdEnabled = true;

    this.bonusGameStartEvent = 'freespin.press.spinButton';
    this.stopCommandEvent = 'slotMachine.stopCommand';
    this.spinCommandEvent = 'slotMachine.spinCommand';

    this.continueBtnName = 'CONTINUE\nBONUS';
    this.spinBtnName = 'SPIN';
    this.stopBtnName = 'STOP';
    this.spinBackToGameName = 'SPIN';
    this.gambleRedBtnName = 'RED';
    this.gambleBlackBtnName = 'BLACK';
    this.takeButtonName = 'TAKE';
    this.oneBetBtnName = 'ONE BET';
    this.maxBetBtnName = 'MAX BET';
    this.autoBtnOn = 'AUTO\nON';
    this.autoBtnOff = 'AUTO\nOFF';

    this.customGambleGame = false;

    this.scenes = [
        'play'
    ];

    this.gambleChooseButtonSelectors = {
        'red': '^oneBetButtonButton',
        'black': '^maxBetButtonButton'
    };

    // buttons that blocks when it needed
    this.mainButtons = [
        'coinMinus',
        'coinPlus',
        'paytable',
        'hold1',
        'hold2',
        'hold3',
        'hold4',
        'hold5',
        'oneBet',
        'maxBet',
        'spin',
        'auto'
    ];

    // buttons that never blocks
    this.controlButtons = [
        'sound',
        'fullscreen'
    ];

    this.disableButtonsOnMinMax = false;

    this.minMaxComponentList = [
        {
            name: 'coins',
            btnNames: ['coinMinus', 'coinPlus'],
            disabled: [false, false],
            event: 'change',
            cfg: null
        }
    ];

    this.enableWinlinesQuickFinish = true;

    var _changeButtonState = function (btn, title, callback, isEnabled, isVisible, frame) {

        if (_self.mainButtons.indexOf(btn) === -1 && _self.controlButtons.indexOf(btn) === -1)
            return;

        var state = {};
        state[btn] = {
            title: nge.i18n.get(title),
            callback: callback,
            enabled: isEnabled,
            visible: isVisible,
            frame: frame
        };
        _self.beforeUpdateHandler(state);
        nge.observer.fire('buttons.changeData', state);
        _self.afterUpdateHandler(state);
    };

    this._autoSpinSimpleOffCallback = function () {
        nge.observer.fire('autospinSimple.off');
    };

    this._autoSpinSimpleOnCallback = function () {
        nge.observer.fire('autospinSimple.on');
    };

    this._autoButtonEnableSwitch = function (bool) {
        var auto = nge.localData.get('autospin');
        if (auto)
            _changeButtonState('auto', _self.autoBtnOn, _self._autoSpinSimpleOffCallback, bool);
        else
            _changeButtonState('auto', _self.autoBtnOff, _self._autoSpinSimpleOnCallback, bool);
    };

    var _checkCfg = function (obj) {

        if (!obj.cfg)
            obj.cfg = nge.localData.get(obj.name + '.cfg');

        return obj;
    };

    var _changeButtonEnableState = function (button, state) {
        _changeButtonState(button, undefined, undefined, state);
    };

    var _checkMinMaxState = function () {

        if (!_self.disableButtonsOnMinMax)
            return;

        _self.minMaxComponentList.forEach(function (obj) {
            obj.btnNames.forEach(function (t, n) {
                _changeButtonEnableState(obj.btnNames[n], !obj.disabled[n]);
            });
        });
    };

    var _changeAllButtonsEnableState = function (state) {
        _self.mainButtons.forEach(function (item) {
            if (item.indexOf('hold') !== -1 && !_self.holdEnabled)
                return;

            _changeButtonEnableState(item, state);
        });

        if (state)
            _checkMinMaxState();
    };

    var _checkMinMaxValue = function (obj, value) {
        obj = _checkCfg(obj);

        var index = obj.cfg.indexOf(value);

        obj.disabled[0] = (index === 0);
        obj.disabled[1] = (index === obj.cfg.length - 1);

        if (_scenesWasCreated)
            _checkMinMaxState();
    };

    var _subscribeMinMax = function () {

        _self.minMaxComponentList.forEach(function (obj) {

            var _callback = function (value) {
                _checkMinMaxValue(obj, value);
            };

            nge.observer.add(obj.name + '.' + obj.event, _callback, false, true);
        });
    };

    // fired every time, when buttons are returning
    // to normal state or value changed by buttons from minMaxComponentList arr

    this.restoreDesktopButtons = function () {

        _changeButtonState('sound', undefined, function () {
            nge.observer.fire('settings.soundSwitch');
        }, true);

        if (nge.localData.get('fullscreen.enabled')) {
            _changeButtonState('fullscreen', undefined, function () {
                nge.observer.fire('fullscreen.off');
            }, true);
        } else {
            _changeButtonState('fullscreen', undefined, function () {
                nge.observer.fire('fullscreen.on');
            }, true);
        }
        _changeButtonState('oneBet', _self.oneBetBtnName, function () {
            nge.observer.fire('bet.up');
        }, true);
        _changeButtonState('maxBet', _self.maxBetBtnName, function () {
            nge.observer.fire('maxbet.go');
        }, true);

        _self._autoButtonEnableSwitch(true);

        _changeButtonState('hold1', _self.hold1, function () {
            var n = nge.localData.get('lines.cfg')[0];
            if (n)
                nge.observer.fire('lines.set', n);
        }, _self.holdEnabled);
        _changeButtonState('hold2', _self.hold2, function () {
            var n = nge.localData.get('lines.cfg')[1];
            if (n)
                nge.observer.fire('lines.set', n);
        }, _self.holdEnabled);
        _changeButtonState('hold3', _self.hold3, function () {
            var n = nge.localData.get('lines.cfg')[2];
            if (n)
                nge.observer.fire('lines.set', n);
        }, _self.holdEnabled);
        _changeButtonState('hold4', _self.hold4, function () {
            var n = nge.localData.get('lines.cfg')[3];
            if (n)
                nge.observer.fire('lines.set', n);
        }, _self.holdEnabled);
        _changeButtonState('hold5', _self.hold5, function () {
            var n = nge.localData.get('lines.cfg')[4];
            if (n)
                nge.observer.fire('lines.set', n);
        }, _self.holdEnabled);
        _changeButtonState('paytable', _self.paytableBtnName, function () {
            nge.observer.fire('paytable.show');
        }, true);
        _changeButtonState('spin', _self.spinBtnName, function () {
            nge.observer.fire(_self.spinCommandEvent);
        }, true);
        _changeButtonState('coinMinus', undefined, function () {
            nge.observer.fire('coins.down');
        }, true);
        _changeButtonState('coinPlus', undefined, function () {
            nge.observer.fire('coins.up');
        }, true);
        _checkMinMaxState();
    };


    this.startFreeSpin = function () {
        _changeButtonState('spin', _self.spinBtnName, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, true);
        _changeButtonState('oneBet', _self.oneBetBtnName, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, true);
        _changeButtonState('maxBet', _self.maxBetBtnName, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, true);
        _self._autoButtonEnableSwitch(false);
        _changeButtonState('hold1', _self.hold1, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, _self.holdEnabled);
        _changeButtonState('hold2', _self.hold2, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, _self.holdEnabled);
        _changeButtonState('hold3', _self.hold3, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, _self.holdEnabled);
        _changeButtonState('hold4', _self.hold4, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, _self.holdEnabled);
        _changeButtonState('hold5', _self.hold5, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, _self.holdEnabled);
        _changeButtonState('paytable', _self.paytableBtnName, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, true);
    };

    var _removeButtonStyle = function (btn, style) {
        var state = {};
        state[btn] = {
            classes: [{
                title: style,
                action: 'remove'
            }]
        };
        nge.observer.fire('buttons.changeData', state);
    };

    var _addButtonStyle = function (btn, style) {
        var state = {};
        state[btn] = {
            classes: [{
                title: style,
                action: 'add'
            }]
        };
        nge.observer.fire('buttons.changeData', state);
    };

    this.beforeUpdateHandler = function () { };
    this.afterUpdateHandler = function () { };

    this.changeButtonState = _changeButtonState;

    this.onRestoreExtension = function () {

    };

    this.offerRestore = function () {
        var auto = nge.localData.get('autospin');

        var freeGameAmount = parseInt(nge.localData.get('freeGame.amount'), 10);
        var enableButtons = (freeGameAmount !== 0) && !auto;

        _self._autoButtonEnableSwitch(enableButtons);

        _changeButtonState('paytable', _self.paytableBtnName, function () {
            nge.observer.fire('paytable.show');
        }, enableButtons);

        _changeButtonState('spin', _self.spinBtnName, function () {
            nge.observer.fire(_self.spinCommandEvent);
        }, enableButtons);

        _changeButtonState('oneBet', _self.oneBetBtnName, function () {
            nge.observer.fire('bet.up');
        }, false);

        _changeButtonState('maxBet', _self.maxBetBtnName, function () {
            nge.observer.fire('maxbet.go');
        }, false);
    };

    var _offerRestore = function () {
        _offerFinishFlag = false;
        _self.offerRestore();
    };

    this.onRestore = function (scene) {
        if (!_buttonsWasCreated || this.enableNewLogic ||
            (typeof scene !== 'undefined' && this.scenes.indexOf(scene) === -1))
            return;

        _scenesWasCreated = true;

        _checkMinMaxState();
        _self.onRestoreExtension();

        var offer = nge.localData.get('freeGame.inProgress');

        if (!offer)
            _self.restoreDesktopButtons();
        else
            _offerRestore();


        if (nge.localData.get('slotMachine.lastResponse')) {
            _changeAllButtonsEnableState(false);
        }

        _showGamble = false;
        // _checkMinMaxOnStart();
    };

    var _autoSpinOn = function () {

        var isFreespin = nge.localData.get('freespin.inProgress');
        var isRespin = nge.localData.get('respin.inProgress');

        if (!isFreespin || !isRespin)
            _changeAllButtonsEnableState(false);

        _changeButtonState('auto', _self.autoBtnOn, _self._autoSpinSimpleOffCallback, true);
    };

    var _autoSpinOff = function () {

        if (_offerFinishFlag) {
            _offerFinishFlag = false;
            _changeButtonState('auto', _self.autoBtnOn, _self._autoSpinSimpleOnCallback, false);
            return;
        }

        _changeButtonState('auto', _self.autoBtnOff, _self._autoSpinSimpleOnCallback, true);

    };

    this.onPaytableShow = function () {

        _changeAllButtonsEnableState(false);

        _changeButtonState('paytable', _self.paytableBtnName, function () {
            nge.observer.fire('paytable.hide');
        }, true);
        _changeButtonState('oneBet', 'BACK', function () {
            nge.observer.fire('paytable.back');
        }, true);
        _changeButtonState('maxBet', 'NEXT', function () {
            nge.observer.fire('paytable.next');
        }, true);
        _changeButtonState('spin', _self.spinBackToGameName, function () {
            nge.observer.fire('paytable.hide');
        }, true);
    };

    this.onPaytableHide = function () {

        var offer = nge.localData.get('freeGame.inProgress');

        if (offer)
            _offerRestore();
        else
            _self.onRestore();

        var auto = nge.localData.get('autospin');
        if (auto) {
            _changeButtonState('auto', _self.autoBtnOn, _self._autoSpinSimpleOffCallback, true);
        } else {
            _changeButtonState('auto', _self.autoBtnOff, _self._autoSpinSimpleOnCallback, true);
        }
    };

    this.onSpinStop = function () {
        _changeButtonState('spin', _self.spinBtnName, function () {
            nge.observer.fire(_self.spinCommandEvent);
        }, false);
        nge.localData.set('spin.onStop', true);
    };

    this.onSpinStart = function () {
        _gambleWasShown = false;
        _isWin = false;
        _cycleComplete = false;

        this.onSpinStartExtension();
    };

    this.onSpinStartExtension = function () {
        _changeAllButtonsEnableState(false);
        _changeButtonEnableState('auto', true);
    };

    this._processWinOnCycleComplete = () => {
        var offerCount = nge.localData.get('freeGame.amount');
        var offer = nge.localData.get('freeGame.inProgress');
        var canGamble = nge.localData.get('slotMachine.slotWin.canGamble');
        var auto = nge.localData.get('autospin');

        _changeAllButtonsEnableState(false);
        _self._autoButtonEnableSwitch(true);

        if (!auto && !_self.customGambleGame && canGamble === 'true')
            _self.setButtonsStateOnWinCycleComplete();

        if (offer && parseInt(offerCount, 10) === 0 && auto) {
            nge.observer.fire('buttons.insidePress', 'auto');
            _self._autoButtonEnableSwitch(true);
        }
    };

    var _cycleCompleteHandler = function () {
        var offer = nge.localData.get('freeGame.inProgress');
        var isFreespin = nge.localData.get('freespin.inProgress');
        var isRespin = nge.localData.get('respin.inProgress');

        if (isFreespin || isRespin || _showGamble || _gambleWasShown)
            return;

        var auto = nge.localData.get('autospin');
        

        if (_isWin && !_cycleComplete) {
            _self._processWinOnCycleComplete();

        } else if (!_cycleComplete && !offer) {
            _changeButtonState('spin', _self.spinBtnName, function () {
                nge.observer.fire(_self.spinCommandEvent);
            }, !auto);

            if (!auto)
                _changeAllButtonsEnableState(true);

        } else if (!_cycleComplete && offer)
            _offerRestore();

        _cycleComplete = true;
        _isWin = false;
    };

    this.setButtonsStateOnWinCycleComplete = function () {
        _changeButtonState('spin', _self.takeButtonName, function () {
            nge.observer.fire('gamble.take');
        }, true);
        _changeButtonState('oneBet', 'GAMBLE', function () {
            if (nge.localData.get('gamble.canPlay'))
                nge.observer.fire('gamble.go');
        }, true);
        _changeButtonState('maxBet', 'GAMBLE', function () {
            if (nge.localData.get('gamble.canPlay'))
                nge.observer.fire('gamble.go');
        }, true);
    };

    var _win = function () {
        _isWin = true;
    };

    var _onButtonsRedSwitchFrame = function (frame) {
        if (_gambleRed && _showGamble && !_gambleRed.input.pointerOver())
            _self.setButtonStateOnRedSwitchFrame(frame);
    };

    this.setButtonStateOnRedSwitchFrame = function (frame) {
        _changeButtonState('oneBet', undefined, undefined, undefined, undefined, frame);
    };

    var _onButtonsBlackSwitchFrame = function (frame) {
        if (_gambleBlack && _showGamble && !_gambleBlack.input.pointerOver())
            _changeButtonState('maxBet', undefined, undefined, undefined, undefined, frame);
    };

    this.onGambleTake = function () {
        _canGamble = false;
        _isWin = false;
        _showGamble = false;

        var offerCount = nge.localData.get('freeGame.amount');
        var offer = nge.localData.get('freeGame.inProgress');

        _changeAllButtonsEnableState(false);

        if (offer && parseInt(offerCount, 10) === 0)
            _self._autoButtonEnableSwitch(false);
        else
            _self._autoButtonEnableSwitch(true);

        _onButtonsRedSwitchFrame(1);
        _onButtonsBlackSwitchFrame(1);

        this.onGambleTakeExtension();;
    };

    this.onGambleTakeExtension = function () {
        var auto = nge.localData.get('autospin');
        _changeButtonState('spin', _self.takeButtonName, function () {
            nge.observer.fire('gamble.take');
        }, !auto);
    };

    var _onGambleGo = function () {
        _gambleWasShown = true;
        _showGamble = true;
        _canGamble = true;

        if (!_self.customGambleGame)
            _self.setButtonStateOnGambleGo();
    };

    this.setButtonStateOnGambleGo = function () {
        _changeButtonState('oneBet', _self.gambleRedBtnName, function () {
            nge.observer.fire('gamble.red');
        }, true);
        _changeButtonState('maxBet', _self.gambleBlackBtnName, function () {
            nge.observer.fire('gamble.black');
        }, true);
        _self._autoButtonEnableSwitch(false);
    };

    this.onGambleButtonsShow = function () {


        var freeGameAmount = nge.localData.get('freeGame.amount');
        var freeGameInProgress = nge.localData.get('freeGame.inProgress');
        _self._autoButtonEnableSwitch(true);
        if (freeGameInProgress && parseInt(freeGameAmount, 10) === 0) {
            _self._autoButtonEnableSwitch(false);
        }

        var canGamble = nge.localData.get('slotMachine.slotWin.canGamble');

        if (!nge.localData.get('autospin') && !_self.customGambleGame && canGamble === 'true') {
            _changeButtonState('oneBet', 'GAMBLE', function () {
                if (nge.localData.get('gamble.canPlay'))
                    nge.observer.fire('gamble.go');
            }, true);
            _changeButtonState('maxBet', 'GAMBLE', function () {
                if (nge.localData.get('gamble.canPlay'))
                    nge.observer.fire('gamble.go');
            }, true);
            _changeButtonState('spin', _self.takeButtonName, function () {
                nge.observer.fire('gamble.take');
            }, true);
        }
    };

    var _onFreespinStart = function () {
        _self.startFreeSpin();
    };

    this.onPressSpinButton = function () {
        _self.restoreDesktopButtons();
        _changeAllButtonsEnableState(false);
        _changeButtonState('spin', _self.spinBtnName, undefined, false);
    };

    var _onFullscreenOn = function () {
        _changeButtonState('fullscreen', undefined, function () {
            nge.observer.fire('fullscreen.off');
        }, true);
    };

    var _onFullscreenOff = function () {
        _changeButtonState('fullscreen', undefined, function () {
            nge.observer.fire('fullscreen.on');
        }, true);
    };

    var _onFreespinContinue = function () {

        _changeAllButtonsEnableState(false);

        _addButtonStyle('spin', 'buttonTextContinueButton');

        _changeButtonState('spin', _self.continueBtnName, function () {
            _removeButtonStyle('spin', 'buttonTextContinueButton');
            nge.observer.fire(_self.bonusGameStartEvent);
        }, true);

    };

    var _onGambleTakingStop = function () {
        _changeButtonEnableState('spin', false);
    };

    var _onGambleButtonsHided = function () {
        _showGamble = false;
    };

    var _actionBlack = function () {
        if (!_canGamble) {
            nge.rafSetTimeout(function () {
                nge.observer.fire('gamble.buttons.hided');
            }, 20);
            return;
        }

        _showGamble = false;
        _changeAllButtonsEnableState(false);
    };

    var _actionRed = function () {
        if (!_canGamble) {
            nge.rafSetTimeout(function () {
                nge.observer.fire('gamble.buttons.hided');
            }, 20);
            return;
        }
        _showGamble = false;
        _changeAllButtonsEnableState(false);
    };

    var _actionResponse = function () { };

    var _onInfoPanelHide = function () {
        _staticContainer = nge.findOne('^staticContainer');
        _staticContainer.visible = false;
        _changeButtonState('coinMinus', undefined, function () {
            nge.observer.fire('coins.down');
        }, true, false);
        _changeButtonState('coinPlus', undefined, function () {
            nge.observer.fire('coins.up');
        }, true, false);
    };

    var _onInfoPanelShow = function () {
        _staticContainer = nge.findOne('^staticContainer');
        _staticContainer.visible = true;
        _changeButtonState('coinMinus', undefined, function () {
            nge.observer.fire('coins.down');
        }, true, true);
        _changeButtonState('coinPlus', undefined, function () {
            nge.observer.fire('coins.up');
        }, true, true);
    };

    var _onFreespinFinish = function () {
        var fsTotalWin = nge.localData.get('freespin.totalWin');

        if (!_isWin && !fsTotalWin)
            _self.restoreDesktopButtons();
        else
            _self.onGambleButtonsShow();
    };

    var _onFreespinBtnEnable = function () {
        _changeButtonState('spin', _self.spinBtnName, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, true);
    };

    this.onGambleRestoreChangeButtonsState = function () {
        _changeButtonState('oneBet', _self.gambleRedBtnName, function () {
            nge.observer.fire('gamble.red');
        }, true);
        _changeButtonState('maxBet', _self.gambleBlackBtnName, function () {
            nge.observer.fire('gamble.black');
        }, true);
        _changeButtonState('spin', _self.takeButtonName, function () {
            nge.observer.fire('gamble.take');
        }, true);
    };

    this.onGambleRestore = function () {
        _showGamble = true;
        _self.onGambleRestoreChangeButtonsState();
    };


    var _onButtonsDisable = function () {
        _changeAllButtonsEnableState(false);
    };

    var _onButtonsEnable = function () {
        _changeAllButtonsEnableState(true);
    };

    var _onButtonsEnableSpin = function () {
        _changeButtonEnableState('spin', true);
    };

    var _onButtonsEnableAuto = function () {
        _changeButtonEnableState('auto', true);
    };

    var _onButtonsDisableAuto = function () {
        _changeButtonEnableState('auto', false);
    };

    var _offerFinish = function () {
        _offerFinishFlag = true;
        _onButtonsDisableAuto();
    };

    var _onButtonsFullscreenSwitchFrame = function (button) {
        _changeButtonState(button.name, undefined, undefined, undefined, undefined, button.frame);
    };

    this.buttonsRestoreAutoUpdates = function () {
        nge.observer.fire('fAutoUpdate', 'fullscreen');
        nge.observer.fire('buttons.restoreAutoUpdate', 'sound');
        nge.observer.fire('buttons.restoreAutoUpdate', 'auto');
    };

    this.onButtonsCreateEnd = function () {
        this.buttonsRestoreAutoUpdates();
        _buttonsWasCreated = true;

        _self.spinBtnName = nge.i18n.get(_self.spinBtnName);
        _self.stopBtnName = nge.i18n.get(_self.stopBtnName);
        _self.takeButtonName = nge.i18n.get(_self.takeButtonName);
        _self.spinBackToGameName = nge.i18n.get(_self.spinBackToGameName);

        if (!_self.customGambleGame) {
            var red = nge.findOne(_self.gambleChooseButtonSelectors.red);
            var black = nge.findOne(_self.gambleChooseButtonSelectors.black);

            if (black)
                _gambleBlack = black;

            if (red)
                _gambleRed = red;
        }
    };

    this.spinCompleteHandler = function () {

        var isWin = nge.localData.get('slotMachine.slotWin');

        if (this.enableWinlinesQuickFinish && isWin)
            nge.rafSetTimeout(function () {
                nge.localData.set('slotMachine.quickFinishWaiting', true);
                _changeButtonState('spin', _self.stopBtnName, function () {
                    nge.localData.set('slotMachine.quickFinishWaiting', false);
                    nge.observer.fire('slotMachine.quickFinish');
                }, true);
            }, 1);
    };

    var _disableQuickFinishWaiting = function () {
        nge.localData.set('slotMachine.quickFinishWaiting', false);
    };

    var _onPopupInsideBonusHandler = function () {
        _changeButtonState('spin', undefined, undefined, false);
    };

    this.spinResponceHandler = function () {
        _changeButtonState('spin', _self.stopBtnName, function () {
            nge.observer.fire(_self.stopCommandEvent);
        }, true);
    };

    this.subscribe = function () {
        if (this.enableNewLogic)
            return nge.App.getInstance('Mlm.Brain.ButtonsNewLogic.Controller').subscribe();

        _subscribeMinMax();

        nge.observer.add('buttons.restore', _self.onRestore, false, true);

        nge.observer.add('fullscreen.on', _onFullscreenOn, false, true);
        nge.observer.add('fullscreen.off', _onFullscreenOff, false, true);

        nge.observer.add('autospinSimple.on', _autoSpinOn, false, true);
        nge.observer.add('autospinSimple.off', _autoSpinOff, false, true);

        nge.observer.add('buttons.freespin.enableSpin', _onFreespinBtnEnable, false, true);

        nge.observer.add('buttons.disable.all', _onButtonsDisable, false, true);
        nge.observer.add('buttons.enable.all', _onButtonsEnable, false, true);

        nge.observer.add('buttons.restore.offer', _offerRestore, false, true);
        nge.observer.add('buttons.finish.offer', _offerFinish, false, true);

        nge.observer.add('buttons.enable.spin', _onButtonsEnableSpin, false, true);

        nge.observer.add('buttons.enable.auto', _onButtonsEnableAuto, false, true);
        nge.observer.add('buttons.disable.auto', _onButtonsDisableAuto, false, true);

        nge.observer.add('buttons.show.navPanel', _onInfoPanelShow, false, true);
        nge.observer.add('buttons.hide.navPanel', _onInfoPanelHide, false, true);

        nge.observer.add('buttons.freespinStart', _onFreespinStart, false, true);
        nge.observer.add('buttons.freespinContinue', _onFreespinContinue, false, true);
        nge.observer.add('freespin.press.spinButton', _self.onPressSpinButton, false, true);
        nge.observer.add('buttons.freespinFinish', _onFreespinFinish, false, true);

        nge.observer.add('StatesManager.create.end', _self.onRestore, false, true);
        nge.observer.add('buttons.create.end', _self.onButtonsCreateEnd, false, true);

        nge.observer.add('slotMachine.spinStart', this.onSpinStart, false, true);
        nge.observer.add('slotMachine.stopCommand', _self.onSpinStop, false, true);
        nge.observer.add('slotMachine.spinComplete', _self.spinCompleteHandler, false, true);
        nge.observer.add('slotMachine.spinResponse', _self.spinResponceHandler, false, true);

        nge.observer.add('spinAndWinComplete', _cycleCompleteHandler, false, true);
        nge.observer.add('spinAndWinComplete', _disableQuickFinishWaiting, false, true);
        nge.observer.add('win', _win, false, true);

        nge.observer.add('buttons.showGamble', _self.onGambleButtonsShow, false, true);
        nge.observer.add('gamble.take', _self.onGambleTake, false, true);
        nge.observer.add('gamble.go', _onGambleGo, false, true);
        nge.observer.add('buttons.gamble.restore', _self.onGambleRestore, false, true);
        nge.observer.add('gamble.taking.stop', _onGambleTakingStop, false, true);
        nge.observer.add('gamble.red', _actionRed, false, true);
        nge.observer.add('gamble.black', _actionBlack, false, true);
        nge.observer.add('gamble.response', _actionResponse, false, true);
        nge.observer.add('gamble.buttons.hided', _onGambleButtonsHided, false, true);

        nge.observer.add('buttons.switchFrame.red', _onButtonsRedSwitchFrame, false, true);
        nge.observer.add('buttons.switchFrame.black', _onButtonsBlackSwitchFrame, false, true);

        nge.observer.add('buttons.switchFrame', _onButtonsFullscreenSwitchFrame, false, true);

        nge.observer.add('paytable.show', _self.onPaytableShow, false, true);
        nge.observer.add('paytable.hide', _self.onPaytableHide, false, true);

        nge.observer.add('popupInsideBonus.animate.start', _onPopupInsideBonusHandler, false, true);
    };
});



nge.App[nge.appNS].Mlm.Brain.BonusWheel = Class.extend(function () {
    var _self = this;
    var _waitingForFreespinUIOn = false;
    var _lastData;
    var _stage1FreespinsSector;
    var _reel1Played = false;

    var _playStateBonusFreeSpinsRun = function(){
        nge.localData.set('bonusWheelWon', false);
        var bonusGameData = nge.localData.get('bonusGame');
        var freeSpinsCount = bonusGameData.lastResponse.params.freeSpins;
        var freespinsMultiplier = bonusGameData.lastResponse.params.multiplier;
        var freespinsSymbol = bonusGameData.lastResponse.params.symbol;
        if (freeSpinsCount) {
            nge.observer.fire('freespin.start', freeSpinsCount, 100);
            nge.observer.fire('buttons.freespinStart', null, 250);
            nge.observer.fire('switchFreespinModeOn', null, 250);
            nge.observer.fire('layersSwitcher.show', 'gameFreeSpin');
            _waitingForFreespinUIOn = true;
        } else {
            //nge.localData.set('bonusWon', false);
            nge.observer.fire('layersSwitcher.show', 'game');
        }
    };

    var _endBonusGameHandler = function(){
        nge.statesManager.display('play', 'loader');
        var nextFreespins = !!nge.localData.get('bonusGame.lastResponse.params.freeSpins');
        if (!nextFreespins)
            nge.localData.set('bonusWon', false);

        nge.observer.add(
            'StatesManager.create.end', function () {
                nge.observer.fire('screenOverlay.show');
                nge.observer.fire('screenOverlay.hide', undefined, 1000);
                _playStateBonusFreeSpinsRun();
                nge.observer.remove('StatesManager.create.end', false, 'playStateBonusFreeSpinsRun', true);
            }, 'playStateBonusFreeSpinsRun', true);
    };

    var _layersSwitcherShow = function(layer) {
        var _layerName = layer.split(' ')[0];
        if((_layerName === 'gameFreeSpin' || _layerName === 'game') && nge.statesManager.getCurrentName() === 'bonusWheel') {
            _endBonusGameHandler();
        }
    };

    var _onFreespinUIOn = function () {
        if (_waitingForFreespinUIOn) {
            _waitingForFreespinUIOn = false;
            nge.rafSetTimeout(function () {
                nge.observer.fire('freespin.press.spinButton');
            }, 250);
        }
    };

    var _onStatesManagerCreateEnd = function (state) {
        if (state !== 'bonusWheel')
            return;
        var initialStage = nge.localData.get('bonusWheel.initialStage');
        nge.localData.set('bonusWheel.stage', initialStage || 1);
        nge.localData.set('bonusWheel.canSpin', true);
        nge.observer.fire('buttons.updateState');
        _reel1Played = false;
    };

    var _sendRequest = function () {
        var mm = nge.App.getInstance('Mlm.Transport.Models.PickBonusItemRequest', false, {
            result: true,
            data: {
                index: 0
            }
        });
        nge.transport.send(mm);
    };

    var _spinPressed = function () {
        if (!nge.localData.get('bonusWheel.canSpin'))
            return;
        nge.localData.set('bonusWheel.canSpin', false);
        nge.observer.fire('buttons.updateState');
        nge.observer.fire('quickSettings.panelHide');
        nge.observer.fire('autospin.panel.hide');
        var stage = nge.localData.get('bonusWheel.stage');
        nge.observer.fire('bonusWheel.' + stage + '.spinStart');
        _lastData = null;
        _sendRequest();
    };

    this.bonusWheelStopped = function (sector) {
        var stage = nge.localData.get('bonusWheel.stage');
        if (stage === 1) {
            if (sector.type === 'freespins') {
                _stage1FreespinsSector = sector;
                var freespins = _stage1FreespinsSector.value;
                nge.observer.fire('bonusWheel.popup.bonusWheel2StartPopup.show', {
                    dynamicElements: [
                        {type: 'text', selector: '^bonusWheel2freeSpinsGamesAmount', value: freespins}
                    ],
                    buttonCallback: function () {
                        nge.localData.set('bonusWheel.stage', 2);
                        nge.localData.set('bonusWheel.canSpin', true);
                        nge.observer.fire('buttons.updateState');
                    }
                });
            } else if (sector.type === 'jackpot') {
                var winAmount = nge.Lib.Money.toCoinsInt(_lastData.params.winAmount);
                nge.observer.fire('bonusWheel.popup.jackpotPopup.show', {
                    dynamicElements: [
                        {type: 'text', selector: '^jackpotAmount', value: winAmount}
                    ],
                    buttonCallback: (function (reel1Played) {
                        return function () {
                            if (reel1Played)
                                _layersSwitcherShow('game');
                            else {
                                nge.localData.set('bonusWheel.canSpin', true);
                                nge.observer.fire('buttons.updateState');
                            }
                        };
                    })(_reel1Played)
                });
            }
            _reel1Played = true;
        } else if (stage === 2) {
            var freespinsCount = _stage1FreespinsSector.value;
            var freespinsMult = 1;
            if (sector.type === 'add')
                freespinsCount += sector.value;
            if (sector.type === 'mult')
                freespinsMult = sector.value;

            nge.observer.fire('bonusWheel.popup.startPopup.show', {
                dynamicElements: [
                    {type: 'text', selector: '^freeSpinsGameAmount', value: freespinsCount},
                    {type: 'text', selector: '^freeSpinsMultiplier', value: 'x' + freespinsMult}
                ],
                buttonCallback: function () {
                    //_layersSwitcherShow('gameFreeSpin');
                }
            });
        }
    };

    var _onResponse = function (data) {
        _lastData = data;
        nge.observer.fire('bonusWheel.actionResponse', data);
    };

    this.subscribe = function () {
        nge.observer.add('layersSwitcher.show', _layersSwitcherShow, false, true);
        nge.observer.add('freespin.ui.on', _onFreespinUIOn, false, true);
        nge.observer.add('StatesManager.create.end', _onStatesManagerCreateEnd, false, true);
        nge.observer.add('bonusWheel.spinPressed', _spinPressed, false, true);
        nge.observer.add('bonusWheel.stopped', _self.bonusWheelStopped, false, true);
        nge.observer.add('pickUpBonusGame.actionResponse', _onResponse, false, true);
    };
});



