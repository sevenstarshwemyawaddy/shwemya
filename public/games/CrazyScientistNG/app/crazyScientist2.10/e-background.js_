        //do not need anymore
        //_firstCreation(callback);
        return true;
    };*/

    var _firstCreation = function (callback) {
        var asd = nge.find('^slotMachineGameContainer');
        var reelsContainer = asd.children[0];

        var promise,
            promisesArr = [];

        for (var i = 0; i < reelsContainer.children.length; i++) {
            //animation olly foor reels groups, not 4 mask
            if (!(reelsContainer.children[i] instanceof Phaser.Group))
                continue;

            promise = (function (k) {
                var dfd = new $.Deferred();

                var reel = reelsContainer.children[k];
                var y = reel.y;
                reel.y = -2000;

                (function (reel, k, y) {
                    var reelTween = nge.tween.add(reel);
                    reelTween.to({
                        y: y
                    }, 800, nge.Lib.Tween.Easing.Quadratic.Out, false, 800 - k * 150).onComplete.add(function () {
                        dfd.resolve();
                    });
                    reelTween.start();
                })(reel, k, y);

                return dfd.promise();
            })(i);

            promisesArr.push(promise);
        }

        $.when.apply($, promisesArr).done(function () {
            if (callback)
                callback();
        });
    };
});



nge.Com.SlotMachine.Cfg = Class.extend(function () {
    this.singleton = true;

    var _blurSymbolsCount = 25; //number or array of numbers

    /**
     * slot machine settings
     */
    this.params = {
        mw: 3,
        mh: 3,
        mhv: false, // or vectors length array like [5, 4, 3, 2, 1]
        rowsXoffset: false, // or array like [15, 20, 30, 40, 50]
        rowsYoffset: false, // or array like [15, 20, 30, 40, 50]
        th: _blurSymbolsCount,
        imageWidth: 'original', //original/auto/number
        imageHeight: 'original', //original/auto/number
        padding: {x: 15, y: 15}, //deprecated
        symbolsScale: 1, //deprecated
        parentName: 'slotMachineGameContainer',
        maskName: 'slotMachineGameContainer',
        imgPath: 'img/slots/',
        blurAlpha: 0.5,
        spinCompleteDelay: 200,
        speedUpReelsFactor: 2,
        intrigueSpeedReelsFactor: 1.5,
        tweenType: 'default', // default/custom  if custom - uses nge.tweens
        tweenDuration: {
            oldSymbols: 600,
            blur: 53 * _blurSymbolsCount,
            newSymbols: 800,
            symbolsDurationType: 'duration', //factor/duration
            blurDurationType: 'duration', //factor/duration
            animationType: 'custom'  // custom/linear
        },
        symbolsBlurKeys: [], //array or array of arrays for each reel
        lastSymbolsBlurStaticKeys: [], //array or array of arrays for each reel [1,2,3,4] or [false,false,[1]]
        tweenStartInterval: 200,
        tweenEndInterval: 0,
        blursShiftOnReelsHold: true,
        recyclerView: {
            enabled: false,
            reelsStopCounter: [5, 10, 15, 20, 25],
            reelsMinStopCounter: 0,
            reelsSpeed: [1, 1, 1, 1, 1],
            reelsIntrigueSpeed: 1.5,
            reelsSpeedUpSpeed: 2,
            hideBorderSymbols: true,
            intrigueAdditionalCounter: 20
        }
    };

    /**
     * get params
     * @returns {Object}
     */
    this.get = function () {
        return this.params;
    };

    /**
     * set method for params prop
     * @param {String} key
     * @param {mixed} value
     * @returns {Boolean}
     */
    this.set = function (key, value) {
        if (!this.params[key])
            return false;
        this.params[key] = value;
        return true;
    };

});



nge.Com.SlotMachine.Controller = nge.Com.Base.extend(function () {
    var _self;
    this._service;
    var _created;

    /**
     * component preload
     * @returns {Boolean}
     */
    this.preload = function () {
        _self = this;

        this._getService();
        var updatedTpl = _self._service.preload();
        this.preloadDefault(updatedTpl);
        return true;
    };

    this._getService = function () {
        if (!_self._service) {
            _self._service = this.getInstance('Service');
            _self._service.init();
        }
    };

    /**
     * component create
     * @returns {Boolean}
     */
    this.create = function () {
        this.createDefault();

        _self._service.create();
        this.animateDefault();

        if (!_created)
            _self._subscribe();

        _created = true;

        return true;
    };

    this.deactivate = function () {
        _self._service.deactivate();
    };

    this.destroy = function () {
        _self._service.destroy();
    };

    /**
     * return last Spin Response data
     * @returns {Object}
     */
    this.getLastData = function () {
        return _self._service.getLastData;
    };

    this.customSubscribe = function () {

    };

    /**
     * display slot machine
     * @param {Object} data openGameResponse
     * @returns {Boolean}
     */
    var _display = function (data) {
        return _self._service.display(data);
    };

    var _doSpin = function (data) {
        return _self._service.doSpin(data);
    };

    var _spinHandler = function () {
        return _self._service.spinHandler();
    };

    var _spinFailHandler = function () {
        return _self._service.spinFailHandler();
    };

    var _fakeSpinsStart = function (direction) {
        return _self._service.fakeSpinsStart(direction);
    };

    var _spinFailed = function () {
        return _self._service.spinFailed();
    };

    var _stopHandler = function () {
        return _self._service.stopHandler();
    };

    var _lastDataRequest = function () {
        return _self._service.lastDataRequest();
    };

    var _animateSymbol = function (symbolPosition) {
        return _self._service.animateSymbol(symbolPosition);
    };

    var _animateSymbolUnsafe = function (symbolPosition) {
        return _self._service.animateSymbol(symbolPosition, true);
    };

    var _stopAnimateSymbol = function (symbolPosition) {
        return _self._service.stopAnimateSymbol(symbolPosition);
    };

    var _holdSymbol = function (symbolPosition) {
        return _self._service.holdSymbol(symbolPosition);
    };

    var _unholdSymbol = function (symbolPosition) {
        return _self._service.unholdSymbol(symbolPosition);
    };

    var _unholdAll = function () {
        return _self._service.unholdAll();
    };

    var _holdReel = function (index) {
        return _self._service.holdReel(index);
    };

    var _unholdReel = function (index) {
        return _self._service.unholdReel(index);
    };

    var _unholdAllReels = function () {
        return _self._service.unholdAllReels();
    };

    var _reset = function () {
        return _self._service.reset();
    };

    /**
     * 
     * @param {Object} data // {coords:[1,2], key:5}
     * @returns {Boolean}
     */
    var _setSymbol = function (data) {
        return _self._service.setSymbol(data);
    };

    var _destroySymbol = function (data) {
        var symbolPosition = data.symbolPosition;
        var animation = data.animation;

        return _self._service._view.destroySymbol(symbolPosition, animation);
    };

    var _normalizeReelsSymbolsPositions = function (data) {
        var animation = data.animation;
        return _self._service._view.normalizeReelsSymbolsPositions(animation);
    };

    var _changeSymbolPosition = function (data) {
        var symbolPosition = data.symbolPosition;
        var newSymbolPosition = data.newSymbolPosition;
        var callback = data.callback;
        var animation = data.animation;

        return _self._service._view.changeSymbolPosition(symbolPosition, newSymbolPosition, callback, animation);
    };

    var _appendSymbol = function (data) {
        var symbolPosition = data.symbolPosition;
        var key = data.key;
        var animation = data.animation;

        return _self._service._view.appendSymbol(symbolPosition, key, animation);
    };

    var _updateBlurs = function () {
        return _self._service.updateBlurs();
    };

    var _setSymbolsBlurKeys = function (keys) {
        return _self._service.setSymbolsBlurKeys(keys);
    };

    var _setLastSymbolsBlurStaticKeys = function (keys) {
        return _self._service.setLastSymbolsBlurStaticKeys(keys);
    };

    var _resetMachine = function () {
        return _self._service.resetMachine();
    };

    var _changeBlursSpeed = function (speed) {
        return _self._service.changeBlursSpeed(speed);
    };

    this._subscribe = function () {
        nge.observer.add('brain.openGameSuccess', _display);
        nge.observer.add('slotMachine.spinResponse', _doSpin);
        nge.observer.add('slotMachine.spinCommand', _spinHandler);
        nge.observer.add('slotMachine.spinRequest.fail', _spinFailHandler);
        nge.observer.add('slotMachine.stopCommand', _stopHandler);
        nge.observer.add('slotMachine.lastDataRequest', _lastDataRequest);
        nge.observer.add('slotMachine.animateSymbol', _animateSymbol);
        nge.observer.add('slotMachine.animateSymbolUnsafe', _animateSymbolUnsafe);
        nge.observer.add('slotMachine.stopAnimateSymbol', _stopAnimateSymbol);
        nge.observer.add('slotMachine.holdSymbol', _holdSymbol);
        nge.observer.add('slotMachine.unholdSymbol', _unholdSymbol);
        nge.observer.add('slotMachine.unholdAll', _unholdAll);
        nge.observer.add('slotMachine.holdReel', _holdReel);
        nge.observer.add('slotMachine.unholdReel', _unholdReel);
        nge.observer.add('slotMachine.unholdAllReels', _unholdAllReels);
        nge.observer.add('slotMachine.resetSpinState', _reset);
        nge.observer.add('winlines.lineHighlite.start', _self._service.winLineStartHandler);
        nge.observer.add('winlines.view.startHideAll', _self._service.winLineHideAllHandler);
        nge.observer.add('slotMachine.setSymbol', _setSymbol);
        nge.observer.add('slotMachine.appendSymbol', _appendSymbol);
        nge.observer.add('slotMachine.changeSymbolPosition', _changeSymbolPosition);
        nge.observer.add('slotMachine.normalizeReelsSymbolsPositions', _normalizeReelsSymbolsPositions);
        nge.observer.add('slotMachine.destroySymbol', _destroySymbol);
        nge.observer.add('slotMachine.updateBlurs', _updateBlurs);
        nge.observer.add('slotMachine.setSymbolsBlurKeys', _setSymbolsBlurKeys);
        nge.observer.add('slotMachine.setLastSymbolsBlurStaticKeys', _setLastSymbolsBlurStaticKeys);
        nge.observer.add('slotMachine.fakeSpins.start', _fakeSpinsStart);
        nge.observer.add('slotMachine.spinFailed.noBalance', _spinFailed);
        nge.observer.add('slotMachine.resetMachine', _resetMachine);
        nge.observer.add('slotMachine.changeBlursSpeed', _changeBlursSpeed);
        _self.customSubscribe();
    };
});



nge.Com.SlotMachine.Helper = Class.extend(function () {

    /**
     * set width and height to texture
     * @param {Object} texture
     * @param {Object} symbolSize
     * @param {Com.SlotMachine.Cfg} cfg
     * @returns {Object}
     */
    this.setTextureSize = function (texture, symbolSize, cfg) {
        if (!cfg)
            cfg = this.getInstance('Cfg').get();

        var qualityFactor = nge.assets.getQualityFactor();

        //define image width 
        if (cfg.imageWidth === 'auto')
            texture.width = symbolSize.width;
        else if (typeof cfg.imageWidth === "number")
            texture.width = cfg.imageWidth;
        else if (cfg.imageWidth === "original" && nge.Cfg.Main.imagesQualityObeys)
            texture.width /= nge.assets.getQualityFactor();

        //define image height 
        if (cfg.imageHeight === 'auto')
            texture.height = symbolSize.height;
        else if (typeof cfg.imageHeight === "number")
            texture.height = cfg.imageHeight;
        else if (cfg.imageHeight === "original" && nge.Cfg.Main.imagesQualityObeys)
            texture.height /= nge.assets.getQualityFactor();

        /*if (nge.Cfg.Main.imagesQualityObeys) {  //deprecated by Mort at 19.08.2016
         texture.width /= nge.assets.getQualityFactor();
         texture.height /= nge.assets.getQualityFactor();
         }*/

        return texture;
    };

    /**
     * Generates array of frames for symbols animations.
     * @param {Object} options
     * @returns {Array}
     */
    this.getAnimationFrames = function (options) {
        var model = function (options) {
            return {
                'prefix': nge.Lib.Helper.recursiveGet('prefix', options, ''),
                'count': nge.Lib.Helper.recursiveGet('count', options, 0),
                'suffix': nge.Lib.Helper.recursiveGet('suffix', options, ''),
                'ldg': nge.Lib.Helper.recursiveGet('ldg', options, 0)
            };
        };

        var m = new model(options);
        var animationFrames = [];
        var num = '';

        for (var i = 0; i < m.count; i++) {
            num = nge.Lib.Helper.LdgZero(i, m.ldg);
            animationFrames.push(m.prefix + num + m.suffix);
        }

        return animationFrames;
    };
});



nge.Com.SlotMachine.Pool = nge.Com.Base.extend(function () {
    this.singleton = true;
    var _pool = {};

    /**
     * reset pool
     * @returns {undefined}
     */
    this.reset = function () {
        for (var k in _pool)
            for (var k1 in _pool[k])
                if (_pool[k][k1].destroy)
                    _pool[k][k1].destroy(true, true);

        _pool = {};
    };

    /**
     * Store Element in ObjectPool
     * @param  {String} poolName
     * @param  {Object} element
     */
    this.store = function (poolName, element) {
        if(poolName && nge.Lib.Helper.isNumeric(poolName))
            console.warn('nge.Com.SlotMachine.Pool warning - trying to store numeric element (symbol). It can be universal.');
        
        if (!poolName)
            poolName = 'universal';

        if (!_pool[poolName])
            _pool[poolName] = [];

        _pool[poolName].push(element);
    };

    /**
     * Check isset object in ObjectPool by poolName
     * @param {String} poolName
     * @returns {Boolean}
     */
    this.check = function (poolName) {
        if (_pool[poolName] && _pool[poolName].length > 0)
            return true;

        return false;
    };

    /**
     * Get object from ObjectPool by poolName
     * @param  {String} poolName
     * @return {Object}
     */
    this.release = function (poolName) {
        var element;

        if (!poolName || !_pool[poolName]) {
            //is it symbol ?
            var symbols = this.getInstance('Symbols').get();

            var symbolCfg = symbols.filter(function (el) {
                return el.name === poolName;
            })[0];

            if (symbolCfg) {
                element = _pool['universal'].pop();

                if (element) {
                    element.setSymbolCfg(symbolCfg);
                    return element;
                }
            } 
        }

        if (!_pool[poolName]) {
            console.error('No key in pool: ', poolName);
            console.warn('Please check slotMachine symbols config');
            return false;
        }

        if (_pool[poolName].length > 0) {
            element = _pool[poolName].pop();
            return element;
        }

        if (!element) {
            console.error('Unable to find object with name ' + poolName);
            return false;
        }
    };
    /**
     * debug function
     * show current status for ObjectPool
     * @returns {Boolean}
     */
    this.status = function () {
        var status = [],
            obj;

        for (var key in _pool) {
            obj = {
                'poolName': key,
                'Size': _pool[key].length
            };
            status.push(obj);
        }
        console.table && console.table(status);
        return true;
    };

});



nge.Com.SlotMachine.Service = Class.extend(function () {
    var _self,
        _cfg,
        _lastData,
        _symbols,
        _helper,
        _tpl;


    //system
    var _spinInProgress = false;

    this._view;
    this._cfg;

    this.init = function () {

    };

    this.preload = function () {
        _self = this;
        _helper = _self.getInstance('Helper');
        var cfg = this.getInstance('Cfg');
        _cfg = cfg.get();
        _self._cfg = _cfg;
        this._getView();
        _symbols = this.getInstance('Symbols');
        _tpl = this.getInstance('Tpl');
        _symbolsPreload();
        this._customPreload();
        return _tpl;
    };

    this._customPreload = function () {};

    this.create = function (doNotResetPool) {
        this.reset();
        _self._view.createSlotMachine(_cfg, _self, _symbols, doNotResetPool);
        var data = nge.localData.get('slotMachine');
        if (data)
            _self.display(data);

        return true;
    };

    this.deactivate = function () {
        _self._view.deactivate();
    };

    this.destroy = function () {
        _self._view.destroy();
    };

    this.resetMachine = function () {
        nge.objects.blockUpdateStyles();
        _self._view.destroyReelsContainer();
        _self.create(true);
        nge.objects.unblockUpdateStyles();
        nge.objects.setStyles(); //set styles
    };

    /**
     * Resets slotMachine
     */
    this.reset = function () {
        _setSpinning(false);
    };

    /**
     * return last Spin Response data
     * @returns {Object}
     */
    this.getLastData = function () {
        return _lastData;
    };

    /**
     * @param  {data}   data from the server last spin response
     * @return {Boolean}
     */
    this.display = function (data) {
        nge.localData.set('slotMachine', data);
        if (!_spinInProgress) {
            var initialSymbols = _getInitialSymbols(data);
            _self._view.displaySymbols(initialSymbols.symbols, initialSymbols.isHistory);
        }
        //_continueWinlinesAnimation(data); //deprecated at 14.09.2016 by Serg

        return true;
    };

    /**
     * fires slotMachine.lastDataResponse event
     *
     */
    this.lastDataRequest = function () {
        nge.observer.fire('slotMachine.lastDataResponse', _lastData);
    };

    /**
     * Sends spinRequest event
     * @return {Boolean}
     */
    this.spinHandler = function () {
        if (_spinInProgress)
            return false;

        _setSpinning(true);

        nge.observer.fire('slotMachine.spinRequest');

        return true;
    };

    /**
     * reset spinning flag
     * @returns {Boolean}
     */
    this.spinFailHandler = function () {
        _setSpinning(false);
        return true;
    };

    this.fakeSpinsStart = function (direction) {
        nge.observer.fire('slotMachine.spinStart');
        nge.observer.fire('winlines.stopAnimation');

        _self._view.reelSpins(direction);
    };

    this.spinFailed = function () {
        _setSpinning(false);

        return true;
    };

    this.stopHandler = function () {
        if (!_spinInProgress)
            return false;

        _self._view.speedUpReels();

        return true;
    };

    /**
     * Animate one symbol by his position
     * @param  {Object} symbolPosition [position in slotMachine {reel: reelIndex, row: rowIndex}
     * @param  {Boolean} unsafe
     * @return {Boolean}
     */
    this.animateSymbol = function (symbolPosition, unsafe) {
        if (_spinInProgress && !unsafe)
            return false;

        _self._view.showAnimationSymbolsCover(symbolPosition);

        var symbol = _self._view.getSymbolByPosition(symbolPosition);

        if (!symbol || !symbol.animate)
            return false;

        symbol.animate();

        //check correctwinline duration
        var symbolConfig = symbol.getConfig();
        if (symbolConfig.winlineTime) {
            nge.observer.fire(
                'winlines.setCurrentLineDurationFirstTime',
                symbolConfig.winlineTime, 1
                );
        }

        return true;
    };

    /**
     * Stop animation of the symbol by his position
     * @param  {Object} symbolPosition [position in slotMachine {reel: reelIndex, row: rowIndex}
     * @return {Boolean}
     */
    this.stopAnimateSymbol = function (symbolPosition) {
        var symbol = _self._view.getSymbolByPosition(symbolPosition);

        if (!symbol || !symbol.cancelAnimation)
            return false;

        symbol.cancelAnimation();
        return true;
    };

    this.changeBlursSpeed = function (speed) {
        if (!_spinInProgress)
            return false;

        _self._view.changeBlursSpeed(speed);

        return true;
    };

    this.holdSymbol = function (symbolPosition) {
        if (_spinInProgress)
            return false;

        nge.Lib.Helper.varOrArrOfVarsChk(symbolPosition, _holdSymbolSafe);
    };

    this._getView = function () {
        if (!_self._view)
            _self._view = this.getInstance((_self._cfg.recyclerView && _self._cfg.recyclerView.enabled) ? 'RecyclerView' : 'View');
    };

    var _holdSymbolSafe = function (symbolPosition) {
        var symbol = _self._view.getSymbolByPosition(symbolPosition);

        if (!symbol)
            return false;

        _self._view.holdSymbol(symbolPosition, symbol);
    };

    this.unholdSymbol = function (symbolPosition) {
        var callback = _self._view.unholdSymbol;
        nge.Lib.Helper.varOrArrOfVarsChk(symbolPosition, callback);
    };

    this.unholdAll = function (symbolPosition) {
        _self._view.unholdAll(symbolPosition);
    };

    this.holdReel = function (index) {
        if (_spinInProgress)
            return false;

        return _self._view.holdReel(index);
    };

    this.unholdReel = function (index) {
        return _self._view.unholdReel(index);
    };

    this.unholdAllReels = function () {
        return _self._view.unholdAllReels();
    };

    this.doSpin = function (data) {
        return _self._doSpin(data);
    };

    this.setSymbol = function (data) {
        return _self._view.setSymbol(data); //{coords:[1,2], key:5}
    };

    this.updateBlurs = function () {
        return _self._view.updateBlurs();
    };

    this.setSymbolsBlurKeys = function (keys) {
        _cfg.symbolsBlurKeys = keys;
    };

    this.setLastSymbolsBlurStaticKeys = function (keys) {
        _cfg.lastSymbolsBlurStaticKeys = keys;
    };

    /**
     * Initiate slotMachine spin
     * @param {Object} data - servers spin response data
     * @return {Boolean}
     */
    this._doSpin = function (data) {
        _lastData = data;
        nge.localData.set('slotMachine', data);

        var newReelsCfg = data.spinResult.columns;
        //reels ready to spin
        //spinning reels
        _self._view.setNewReelsCfg(newReelsCfg);
        return true;
    };

    /**
     * Callback trigered after slotMachine stops
     */
    this.spinCompleteCallback = function () {
        _setSpinning(false);
        nge.observer.fire('slotMachine.spinComplete');
    };

    this.winLineStartHandler = function (winData) {
        if (!winData || !winData.wonSymbols)
            return false;

        var wonSymbols = winData.wonSymbols;

        var symbol;
        var symbolsNames = [];
        for (var i = 0; i < wonSymbols.length; i++) {
            symbol = _self._view.getSymbolByPosition({reel: wonSymbols[i][0], row: wonSymbols[i][1]});

            if (symbol)
                symbolsNames.push(symbol.getName());
        }
        nge.observer.fire('slotMachine.winLineSymbols', {
            symbolsNames: symbolsNames,
            amount: winData.amount,
            type: winData.type,
            selectedLine: winData.selectedLine,
            wonSymbols: winData.wonSymbols,
            bonusName: winData.bonusName
        });
    };

    this.winLineHideAllHandler = function () {
        _self._view.hideAnimationSymbolsCovers();
    };

    var _setSpinning = function (val) {
        _spinInProgress = val;
        nge.localData.set('slotMachineSpinning', val);
    };

    /**
     * Preloads symbols assets (symbols images, symbols animations)
     */
    var _symbolsPreload = function () {
        var symbolsBlurKeysNeed = (_cfg.symbolsBlurKeys.length === 0) ?
            true : false;

        // Pre load all images.
        var path = _cfg.imgPath;
        //elements
        var items = _symbols.get();
        var frameMax;
        for (var i = 0; i < items.length; i++) {
            if (symbolsBlurKeysNeed)
                _cfg.symbolsBlurKeys.push(items[i].name);

            _tpl.assets.contents.push({
                //'fullPath': path + nge.Lib.Helper.lowerFirstLetter(items[i].textureUrl), /deprecated at 04.11.2016 by Mort
                type: mt.assets.IMAGE,
                fullPath: path + items[i].textureUrl,
                key: items[i].name
            });

            if (items[i].animationFramesAuto)
                items[i].animationFrames = _helper.getAnimationFrames(items[i].animationFramesAuto);

            if (items[i].animationFrames) {
                for (var j = 0; j < items[i].animationFrames.length; j++) {
                    _tpl.assets.contents.push({
                        type: mt.assets.IMAGE,
                        fullPath: path + nge.Lib.Helper.lowerFirstLetter(items[i].animationFrames[j]),
                        key: items[i].animationFrames[j]
                    });
                }
            }
            if (items[i].animationSprite) {
                var ext = items[i].animationSpriteExtension || 'png';
                if (items[i].multipack) {
                    for (var k = 0; k < items[i].multipack; k++) {
                        if (items[i].framesInLastSprite && k === items[i].multipack - 1) {
                            frameMax = items[i].framesInLastSprite;
                        } else {
                            frameMax = -1;
                        }
                        _tpl.assets.contents.push({
                            type: mt.assets.IMAGE, // TODO: or Atlas?
                            'fullPath': path + nge.Lib.Helper.lowerFirstLetter(items[i].name).replace(/ /g, "") + '/' + nge.Lib.Helper.lowerFirstLetter(items[i].name).replace(/ /g, "") + k + '.' + ext,
                            'key': items[i].name + k + '.' + ext,
                            'frameWidth': items[i].frameWidth,
                            'frameHeight': items[i].frameHeight,
                            'frameMax': frameMax
                        });
                    }
                } else {
                    _tpl.assets.contents.push({
                        type: mt.assets.IMAGE, // TODO: or Atlas?
                        'fullPath': path + nge.Lib.Helper.lowerFirstLetter(items[i].name).replace(/ /g, "") + '/' + nge.Lib.Helper.lowerFirstLetter(items[i].name).replace(/ /g, "") + '.' + ext,
                        'key': items[i].name + '.' + ext,
                        'frameWidth': items[i].frameWidth,
                        'frameHeight': items[i].frameHeight
                    });
                }
            }
        }
    };

    /**
     * Returns initial symbols for the first time slotmachine creation
     * @param {Object} data - servers initial response data
     * @return {Array}
     */
    var _getInitialSymbols = function (data) {
        var result = {
            isHistory: false
        };

        // if history state
        var historyInitSymbols = nge.localData.get('slotMachine.initialSymbols');
        var curState = nge.statesManager.getCurrentName();

        if (curState === 'history' && historyInitSymbols) {
            result.symbols = historyInitSymbols;
            result.isHistory = true;
            return result;
        }


        var initialSymbols = data.gameParameters && data.gameParameters.initialSymbols && data.gameParameters.initialSymbols.length ?
            data.gameParameters.initialSymbols : false;

        //check rows/columns  //todo if uncomment - use rowsToColumns by default
        // if (initialSymbols.length !== _cfg.mw && initialSymbols.length === _cfg.mh)

        if (initialSymbols)
            initialSymbols = nge.Lib.Helper.rowsToColumns(initialSymbols);

        if (!initialSymbols)
            if (data.spinResult && data.spinResult.columns)
                initialSymbols = data.spinResult.columns;

        //random
        if (!initialSymbols)
            initialSymbols = _view.getRandomSymbolsTable();

        result.symbols = initialSymbols;
        return result;
    };

    /**
     * Continue winLines animations when return the game after bonus games/freespins
     * @param {Object} data - last spin response
     * @return {undefined}
     */
    var _continueWinlinesAnimation = function (data) {
        //deprecated at 14.09.2016 by Serg
        if (data.slotWin && data.slotWin.linePickBonus.length && data.slotWin.lineWinAmounts.length) {
            nge.rafSetTimeout(function () {
                nge.observer.fire('winlines.animateByOne');
            }, 1000);
        }
    };
});



/* global nge */

nge.Com.SlotMachine.SymbolBase = Class.extend(function () {
    var _self = this;

    this._originalParams = {};
    this._animationCreated = false;
    this._subscribed = false;
    this._spritesList = [];
    this._frames;
    this._name;
    this._repeat;
    this._animateNonStop;
    this._frameTime;
    this._initialScale = {x: 1, y: 1};

    this.setCustomContext = function (ctx) {
        _self = ctx;
    };

    this.setSymbolBase = function (cfg) {
        _self._symbolConfig = cfg;

        if (typeof _self._symbolConfig.animationMainTextureNeed === 'undefined')
            _self._symbolConfig.animationMainTextureNeed = true;

        if (typeof _self._symbolConfig.animationOnTop === 'undefined')
            _self._symbolConfig.animationOnTop = true;

        _self._repeat = cfg.repeat || 1;
        _self._frameTime = cfg.frameTime || 30;

        if (!_self._texture) {
            var modelI = nge.Mlm.Objects.Image({
                name: 'smSymbol_' + cfg.name + '_' + _self._sid,
                class: cfg.name,
                assetKey: cfg.name,
                anchorX: 0.5,
                anchorY: 0.5
            });

            _self._texture = nge.objects.create(modelI, false, true, true);
        } else {
            _self._texture.loadTexture(cfg.name);
            _self._texture.visible = true;
            _self._texture.getData().name = 'smSymbol_' + cfg.name + '_' + _self._sid;
            _self._texture.getData().class = cfg.name;
        }

        /*if (_self._texture.parent)
         _self._texture.parent.remove(_self._texture);*/

        _self.texture = _self._texture;
        _self._textureAnimation = false;
        _self._animationCreated = false;

        _self._originalParams = {
            alpha: _self._texture.alpha,
            scale: {
                x: _self._texture.scale.x,
                y: _self._texture.scale.y
            }
        };

        _self._name = cfg.name;
    };

    this.destroy = function (destroyTextures) {
        _self._unsubscribe();

        if (destroyTextures) {
            _self._texture && _self._texture.destroy();
            _self._textureAnimation && _self._textureAnimation.destroy();
        }
    };

    /**
     * get Symbol Name
     * @returns {String}
     */
    this.getName = function () {
        return _self._name;
    };

    /**
     * get Symbol Config
     * @returns {Object}
     */
    this.getConfig = function () {
        return _self._symbolConfig;
    };



    /**
     * get textureAnimation
     * @returns {Phaser.Sprite}
     */
    this.getTextureAnimation = function () {
        return _self._textureAnimation;
    };

    /**
     * set symbol scale, alpha to defaults
     * @returns {Boolean}
     */
    this.reset = function () {
        _self._animateNonStop = false;

        if (_self._tween) {
            _self._tween.stop();
            _self._tween = null;
            delete _self._tween;

            if (_self._textureAnimation)
                _self._textureAnimation.loadTexture(_self._name);
        }

        _self._animationCheck();

        if (!_self._textureAnimation)
            return false;

        _self._textureAnimation.alpha = _self._originalParams.alpha;
        _self._textureAnimation.scale.x = _self._originalParams.scale.x;
        _self._textureAnimation.scale.y = _self._originalParams.scale.y;

        return true;
    };

    this._animationEndHandler = function () {
        if (_self._animateNonStop)
            _self.animate(true);
    };

    /**
     * animation start
     * @param {Boolean} insideCall
     * @returns {Boolean}
     */
    this.animate = function (insideCall) {
        if (_self._symbolConfig.animationRelaunchOnWinlinesCycle)
            _self._cancelAnimation();

        if (
            typeof _self._texture === 'undefined' ||
            typeof _self._texture.parent === 'undefined' || !_self._texture ||
            !_self._texture.parent
            ) {
            console.warn('nge.Com.SlotMachine.Symbol.animate error', _self._symbolConfig);
            return false;
        }

        if (!_self._subscribed)
            _self._subscribe();

        if (!_self._animationCreated)
            _self._animationCreate();

        _self._subscribed = true;
        _self._animationCreated = true;

        _self.textureAnimationShow(insideCall);

        if (!_self._tween)
            _self._createTween();

        _self._tween.start();

        if (_self._symbolConfig.animateAllWinlinesCycle)
            _self._animateNonStop = true;

        return true;
    };

    this.textureAnimationShow = function (insideCall) {
        //_self._textureAnimation on top
        _self._textureAnimation.x = _self._texture.x + _self._texture.parent.x;
        _self._textureAnimation.y = _self._texture.y + _self._texture.parent.y;
        _self._textureAnimation.visible = true;

        _self._texture.visible = false;

        if (!insideCall && _self._symbolConfig.animationOnTop)
            _self._smContainer.bringToTop(_self._textureAnimation);
    };

    this._animationCreate = function () {
        //_self._textureAnimation create
        var modelI = nge.Mlm.Objects.Image({
            assetKey: _self._symbolConfig.name,
            anchorX: 0.5,
            anchorY: 0.5,
            isVisible: false
        });
        _self._textureAnimation = nge.objects.create(modelI, _self._smContainer, true);

        if (_self._symbolConfig.animationSprite) {
            var ext = _self._symbolConfig.animationSpriteExtension || 'png';
            if (_self._symbolConfig.multipack) {
                for (var k = 0; k < _self._symbolConfig.multipack; k++) {
                    _self._spritesList.push(nge.wrap.cache.getImage(_self._symbolConfig.name + k + '.' + ext));
                }
            } else {
                _self._spritesList.push(nge.wrap.cache.getImage(_self._symbolConfig.name + '.' + ext));
            }
        }

        _self._createTween();
    };
    this.animationCreate = this._animationCreate;

    this._createTween = function () {
        if (_self._symbolConfig.animationFrames)
            _self._createFramesTween(_self._symbolConfig.animationFrames);
        else if (_self._symbolConfig.animationSprite)
            _self._createSpriteTween();
        else
            _self._createScaleTween();
    };

    /**
     * createTween
     * @returns {Boolean}
     */
    this._createScaleTween = function () {
        _self._tween = nge.tween.add(_self._textureAnimation.scale);
        _self._initialScale.x = _self._textureAnimation.scale.x;
        _self._initialScale.y = _self._textureAnimation.scale.y;
        _self._tween.to({
            x: _self._initialScale.x * _self.maxScale.x,
            y: _self._initialScale.y * _self.maxScale.y
        }, _self.durationScale)
            .to(_self._initialScale, _self.durationScale)
            .to({
                x: _self._initialScale.x * _self.maxScale.x,
                y: _self._initialScale.y * _self.maxScale.y
            }, _self.durationScale)
            .to(_self._initialScale, _self.durationScale).onComplete.add(function () {
            _self._animationEndHandler();
        });

        return true;
    };

    /**
     * create Tween from frames array
     * @param {Array} frames
     * @returns {Boolean}
     */
    this._createFramesTween = function (frames) {
        var frameTime = _self._frameTime;
        var totalFrames = frames.length;
        _self._frames = frames;
        _self._tween = nge.tween.add({x: 0});
        _self._tween.enableUpdate = true;
        var repeat = _self._repeat;
        for (var i = 0; i < repeat; i++) {
            _self._tween.to({
                x: totalFrames
            }, totalFrames * frameTime);
        }

        _self._tween.onUpdateCallback(function (context, time, tweenData) {
            _self._textureAnimation.loadTexture(
                _self._frames[~~(tweenData.percent * tweenData.vEnd.x)]
                );
        }).onComplete.add(function () {
            if (_self._animateNonStop && _self._symbolConfig.animationMainTextureNeed)
                _self._textureAnimation.loadTexture(_self._name);

            if (!_self._symbolConfig.animateAllWinlinesCycle)
                _self.reset();

            _self._animationEndHandler();
        });

        return true;
    };

    /**
     * create Tween from sprite
     * @returns {Boolean}
     */
    this._createSpriteTween = function () {
        var frameTime = _self._frameTime;
        var totalFrames = 0;
        var frame;
        _self._frames = [];

        for (var i = 0; i < _self._spritesList.length; i++) {
            for (var j = 0; j < _self._spritesList[i].frameData._self._frames.length; j++) {
                frame = _self._spritesList[i].frameData._self._frames[j];
                frame.spriteName = _self._spritesList[i].key;
                frame.startsFrom = totalFrames;
                _self._frames.push(frame);
            }
            totalFrames += _self._spritesList[i].frameData._self._frames.length;
        }
        _self._tween = nge.tween.add({x: 0});
        _self._tween.enableUpdate = true;

        if (!_self._symbolConfig.animationMainTextureNeed) {
            _self._textureAnimation.loadTexture(_self._frames[0].spriteName);
            _self._textureAnimation.frame = 0;
        }

        var repeat = _self._repeat;
        for (var k = 0; k < repeat; k++) {
            _self._tween.to({x: totalFrames}, totalFrames * frameTime);
        }

        _self._tween.onUpdateCallback(function (context, time, tweenData) {
            var frameIndex = ~~(tweenData.percent * tweenData.vEnd.x);

            _self._textureAnimation.loadTexture(_self._frames[frameIndex].spriteName);
            _self._textureAnimation.frame = frameIndex - _self._frames[frameIndex].startsFrom;
        }).onComplete.add(function () {
            if (_self._animateNonStop && _self._symbolConfig.animationMainTextureNeed)
                _self._textureAnimation.loadTexture(_self._name);

            _self.reset();
            _self._animationEndHandler();
        });

        return true;
    };

    this._hideAnimation = function () {
        if (!_self._animateNonStop) {
            _self._texture.visible = true;

            if (_self._textureAnimation)
                _self._textureAnimation.visible = false;

            _self.reset();

            if (_self._subscribed) {
                _self._unsubscribe();
                _self._subscribed = false;
            }
        }
    };

    this._stopLinesAnimation = function () {
        _self._animateNonStop = false;

        _self.reset();
    };

    this._animationCheck = function () {
        if (!_self._textureAnimation)
            _self._textureAnimation = false;
    };

    this._cancelAnimationLoop = function () {
        _self._animateNonStop = false;
    };

    this._cancelAnimation = function () {
        _self._stopLinesAnimation();
    };

    this.cancelAnimation = this._cancelAnimation;

    this._subscribe = function () {
        nge.observer.add('slotMachine.symbols.cancelAnimation', _self._cancelAnimation, 'slotMachine.symbol.' + _self._sid + '.cancel');
        nge.observer.add('slotMachine.symbols.cancelAnimationLoop', _self._cancelAnimationLoop, 'slotMachine.symbol.' + _self._sid + '.cancel');
        nge.observer.add('winlines.view.startHideAll', _self._hideAnimation, 'slotMachine.symbol.' + _self._sid + '.hide');
        nge.observer.add('winlines.stoppingAnimation.start', _self._stopLinesAnimation, 'slotMachine.symbol.' + _self._sid + '.stop');
    };

    this._unsubscribe = function () {
        nge.observer.remove('slotMachine.symbols.cancelAnimation', false, 'slotMachine.symbol.' + _self._sid + '.cancel');
        nge.observer.remove('slotMachine.symbols.cancelAnimationLoop', false, 'slotMachine.symbol.' + _self._sid + '.cancel');
        nge.observer.remove('winlines.view.startHideAll', false, 'slotMachine.symbol.' + _self._sid + '.hide');
        nge.observer.remove('winlines.stoppingAnimation.start', false, 'slotMachine.symbol.' + _self._sid + '.stop');
    };
});



nge.Com.SlotMachine.Symbol = nge.Com.SlotMachine.SymbolBase.extend(function () {
    this.texture = null;

    /** scale animation **/
    this.maxScale = {x: 1.08, y: 1.08};
    this.durationScale = 400;


    var _symbolSize;
    var _self = this;
    var _view;
    var _extendKeys = [];
    var _extendBkp = {};

    this._smContainer;
    this._symbolConfig;
    this._tween;
    this._texture;
    this._textureAnimation;
    this._sid;

    /**
     * creating symbol and animation prepare
     * @param {Object} cfg
     * @param {Object} symbolSize
     * @param {Object} smContainer //slotMachine container
     * @param {Boolean} unactive
     * @returns {Boolean}
     */
    this.init = function (cfg, symbolSize, smContainer, unactive) {
        _self._sid = nge.Lib.Helper.getRandomInt(0, 999999); //symbolId
        _symbolSize = symbolSize;
        _self._smContainer = smContainer;

        if (cfg)
            _self.setSymbolCfg(cfg);

        if (unactive) {
            _self.animate = function () {};
            _self._subscribe = function () {};
        }

        return true;
    };

    /**
     * get Symbol Size
     * @returns {Object}
     */
    this.getSize = function () {
        return _symbolSize;
    };

    this.setView = function (v) {
        _view = v;
    };

    this.setSymbolCfg = function (cfg) {
        _self._symbolConfig = cfg;

        var customInstance = _self.getInstance('Symbol' + cfg.name);

        //some extending magic
        _cleanup();

        if (customInstance) {
            _extendKeys = nge.Lib.Helper.mergeArrs(Object.keys(customInstance), _extendKeys);

            for (var k in customInstance) {
                if (_self[k])
                    _extendBkp[k] = _self[k];

                _self[k] = customInstance[k];
            }

            if (customInstance.setContext)
                customInstance.setContext(_self);
            else
                console.warn('Context can be invalid in nge.Com.SlotMachine.Symbol' + cfg.name + '. Use setContext function');
        }

        _self.setSymbolBase(cfg);
    };

    var _cleanup = function () {
        if (_self.reset)
            _self.reset();

        _clearKeys();

        if (_self._tween) {
            _self._tween.stop();
            _self._tween = null;
        }

        //_self._texture && _self._texture.destroy();
        _self._textureAnimation && _self._textureAnimation.destroy();
    };

    var _clearKeys = function () {
        for (var i = 0; i < _extendKeys.length; i++)
            delete _self[_extendKeys[i]];

        for (var k in _extendBkp)
            _self[k] = _extendBkp[k];

        _extendKeys = [];
    };
});



nge.Com.SlotMachine.Symbols = Class.extend(function () {
    this.singleton = true;

    /**
     * @name : symbol name from server side
     * @textureUrl: image path relative to slotMachine->cfg.js: params->imgPath
     * @textureZ (optional | default: 0): compared to other symbols             (!)(!)(!) very hard to calculate this params. Do not use without urgency !
     * @frameTime (optional | default: 30): each frame duration time
     * @countInPool (optional | default: 0): count of symbol instance in the pool
     * @repeat (optional | default: 1): how many times animation will be played
     * @winlineTime (optional | default: false): winline duration time
     * @animateAllWinlinesCycle (optional | default: false): symbol will animating all winlines cycle
     * @animationRelaunchOnWinlinesCycle (optional | default: false): relaunch animation on each winlines cycle
     * 
     * @animationMainTextureNeed(optional): true by default
     * @animationOnTop(optional): true by default  //over or under winlines
     *
     * @animationFrames(optional): paths to animation frames relative to SlotMachine cfg imgPath
     * @animationFramesAuto(optional): {prefix: 'm01_', count: 2, suffix: '.jpg', ldg: 3} --> ["m01_000.jpg", "m01_001.jpg"]
     *
     * @animationSprite(optional | default: false): folders structure required: 
     *      imgPath -> <@name> -> <@name>.png   [url for image atlass]
     *      imgPath -> <@name> -> <@name>.json  [url for json file with atlass configurations]
     *          json file should have all info about atlass
     *          @frames contains frames with configuration
     *          @meta: sprite meta information
     *  @animationSpriteExtension(optional | default: false)
     *  @multipack (optional | default: 1) number of animationSprite attlases
     *  @framesInLastSprite(optional | default: false) if atlass have space blocks
     */
    this.items = [
        {
            name: 'Wild',
            textureUrl: 'Wild.png'
        },
        {
            name: 'TopAward',
            textureUrl: 'Creck-it.png'
        },
        {
            name: 'Group1',
            textureUrl: 'Egg_Gold.png'
        },
        {
            name: 'Group2',
            textureUrl: 'Egg_silver.png'
        },
        {
            name: 'Group3',
            textureUrl: 'Egg_bronze.png'
        },
        {
            name: 'Animal1',
            textureUrl: 'chicken.png'
        },
        {
            name: 'Animal2',
            textureUrl: 'sheep.png'
        },
        {
            name: 'Animal3',
            textureUrl: 'Pig.png'
        },
        {
            name: 'Animal4',
            textureUrl: 'cow.png'
        },
        {
            name: 'Slingshot',
            textureUrl: 'BOHUS.png'
        },
        {
            name: 'Skillet',
            textureUrl: 'SIZZILING_BONUSE.png'
        },
        {
            name: 'any_Group1_Group2_Group3',
            textureUrl: 'any_Egg.png'
        }
    ];

    /**
     * items get
     * @returns {Array}
     */
    this.get = function () {
        return this.items;
    };
});



