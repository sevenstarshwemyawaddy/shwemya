        'id': nge.Lib.Helper.recursiveGet('id', param, false),
        'name': nge.Lib.Helper.recursiveGet('name', param, nge.Lib.Helper.recursiveGet('key', param, false)),
        'fullPath': nge.Lib.Helper.recursiveGet('fullPath', param, false),
        'atlas': nge.Lib.Helper.recursiveGet('atlas', param, false),
        'originalPath': (param.hasOwnProperty('originalPath')) ? param.originalPath : (param.hasOwnProperty('fullPath')) ? param.fullPath : false,
        'atlasType': nge.Lib.Helper.recursiveGet('atlasType', param, 0), // 0 = Phaser.Loader.TEXTURE_ATLAS_JSON_ARRAY
        'assetsPath': '',
        'key': nge.Lib.Helper.recursiveGet('key', param, false)
    };
};



