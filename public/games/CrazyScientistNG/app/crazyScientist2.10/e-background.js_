nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.States.SpinState = nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.States.BaseState.extend(function () {
    
    var _self = this;

    this.standardSpinEvent = 'slotMachine.spinCommand';
    this.standardStopEvent = 'slotMachine.stopCommand';

    var _auto = this.propUpdateHandlers.auto;
    var _quickFinishEnable = this.propUpdateHandlers.quickFinishEnable;

    var _cycleComplete = true;
    var _spinStarted = false;
    var _stopCommand = false;
    var _balanceReceived = true;
    var _spinCompleted = true;
    var _wasOffer = false;
    var _spinResponseReceived = false;

    var _cfg;

    this.init = function (buttons) {
        _cfg = nge.App.getInstance('Mlm.Brain.ButtonsNewLogic.Cfg');
        this.super.init(buttons);
    };

    this.model = {
        order: ['OFFER?', 'READY', 'STARTED', 'STOPPED'],
        
        actions: {
            OFFER:{},
            READY: {
                'spin': {
                    title: nge.i18n.get('SPIN'),
                    enabled: ['!auto'],
                    callback: function(){
                        nge.observer.fire(_self.standardSpinEvent); 
                    }
                },
                'oneBet': {
                    title: nge.i18n.get('ONE BET'),
                    enabled: ['!auto', '!offerInProgress'],
                    callback: function(){
                        nge.observer.fire('bet.up'); 
                    }
                },
                'maxBet': {
                    title: nge.i18n.get('MAX BET'),
                    enabled: ['!auto', '!offerInProgress'],
                    callback: function(){
                        nge.observer.fire('maxbet.go'); 
                    }
                },
                'paytable': {
                    title: nge.i18n.get('PAYTABLE'),
                    enabled: ['!auto'],
                    callback: function(){
                        nge.observer.fire('paytable.show'); 
                    }
                },
                'hold1': {
                    title: nge.i18n.get('HOLD 1'),
                    enabled: ['!auto', '!offerInProgress'],
                    callback: function(){
                        var n = nge.localData.get('lines.cfg')[0]; 
                        if(n) nge.observer.fire('lines.set', n);
                    }
                },
                'hold2': {
                    title: nge.i18n.get('HOLD 2'),
                    enabled: ['!auto', '!offerInProgress'],
                    callback: function(){
                        var n = nge.localData.get('lines.cfg')[1];
                        if(n) nge.observer.fire('lines.set', n);
                    }
                },
                'hold3': {
                    title: nge.i18n.get('HOLD 3'),
                    enabled: ['!auto', '!offerInProgress'],
                    callback: function(){
                        var n = nge.localData.get('lines.cfg')[2];
                        if(n) nge.observer.fire('lines.set', n);
                    }
                },
                'hold4': {
                    title: nge.i18n.get('HOLD 4'),
                    enabled: ['!auto', '!offerInProgress'],
                    callback: function(){
                        var n = nge.localData.get('lines.cfg')[3];
                        if(n) nge.observer.fire('lines.set', n);
                    }
                },
                'hold5': {
                    title: nge.i18n.get('HOLD 5'),
                    enabled: ['!auto', '!offerInProgress'],
                    callback: function(){
                        var n = nge.localData.get('lines.cfg')[4];
                        if(n) nge.observer.fire('lines.set', n);
                    }
                },
                'coinMinus': {
                    title: '',
                    enabled: ['!auto', '!offerInProgress'],
                    callback: function(){
                        nge.observer.fire('coins.down'); 
                    }
                },
                'coinPlus': {
                    title: '',
                    enabled: ['!auto', '!offerInProgress'],
                    callback: function(){
                        nge.observer.fire('coins.up'); 
                    }
                },
                'auto': {
                    callback: ['autoCallback']
                }
            },

            STARTED: {
                'spin': {
                    title: nge.i18n.get('STOP'),
                    enabled: ['!auto', '!stopped', 'spinResultReceived'],
                    callback: function(){
                        nge.observer.fire(_self.standardStopEvent); 
                    }
                },
                'auto': {
                    callback: ['autoCallback']
                }
            },

            STOPPED: {
                'spin': {
                    enabled: ['!auto', 'quickFinishEnable'],
                    callback: ['quickFinishCallback']
                },
                'auto': {
                    callback: ['autoCallback']
                }
            }
        }
    };

    this.subscribeCfgExt = {
        'slotMachine.spinComplete': 'spinCompleteHandler',
        'slotMachine.spinResponse': 'spinResponceHandler'
    };

    this.validityCheckHandler = function(){
        var canGamble = nge.localData.get('slotMachineData.slotWin.canGamble') === 'true';
        
        if(_cycleComplete && canGamble)
            return false;
        
        return (_balanceReceived);
    };
    
    this.propUpdateHandlers = {
        auto: _auto, 
        quickFinishEnable: _quickFinishEnable,
        stopped: function(){
            return _stopCommand;
        },
        cycleCompleted: function(){
            return _cycleComplete;
        },
        offerInProgress: function(){
            return nge.localData.get('freeGame.inProgress');
        },
        spinResultReceived: function(){
            return _spinResponseReceived;
        }
    };

    this.actionUpdateHandlers = {
        onOffer: function(){
            var offerData = nge.localData.get('freeGame');
            return offerData && (!offerData.amount || offerData.showingOfferMenu) && _balanceReceived && _wasOffer;
        },
        onOfferStart: function(){
            return nge.localData.get('freeGame.showingOfferMenu');
        },
        onReady: function(){
            return _cycleComplete && _balanceReceived && !_spinStarted;
        },
        onStarted: function(){
            return _spinStarted;
        },
        onStopped: function(){
            return _spinCompleted && !_cycleComplete;
        }
    };

    this.spinStartHandler = function(){
        this.super.spinStartHandler();
        _stopCommand = false;
        _spinStarted = true;
        _cycleComplete = false;
        _spinCompleted = false;
    };
    
    this.spinStopHandler = function(){
        _stopCommand = true;
        nge.localData.set('spin.onStop', true);
    };
    
    this.spinCompleteHandler = function(){
        _spinStarted = false;
        _spinCompleted = true;

        nge.rafSetTimeout(function(){
            var isWin = nge.localData.get('slotMachine.slotWin');
            if(_cfg && _cfg.enableWinlinesQuickFinish && isWin) {
                nge.localData.set('slotMachine.quickFinishWaiting', true);

                var spinObj = {};
                var spinButtonName = nge.Lib.Helper.mobileAndTabletCheck() ? 'spinMobile' : 'spin';

                spinObj[spinButtonName] = {};
                spinObj[spinButtonName] = {
                    title: _self.stopBtnName,
                    callback: function () {
                        nge.localData.set('slotMachine.quickFinishWaiting', false);
                        nge.observer.fire('slotMachine.quickFinish');
                    },
                    enabled: true
                };
                nge.observer.fire('buttons.changeData', spinObj);
            }
        }, 1);

        _spinResponseReceived = false;
    };

    this.balanceResponseHandler = function(){
        this.super.balanceResponseHandler();
        _balanceReceived = true;
    };

    this.cycleCompleteHandler = function(){
        this.super.cycleCompleteHandler();   
        _cycleComplete = true;
        _balanceReceived = false;
        nge.localData.set('slotMachine.quickFinishWaiting', false);
    };

    this.applyOfferHandler = function(){
        this.super.applyOfferHandler();
        _wasOffer = true;
    };

    this.offerGoToGameHandler = function(){
        this.super.offerGoToGameHandler();
        _wasOffer = false;
    };
    
    this.offerListLaterHandler = function(){
        this.super.offerListLaterHandler();
        _wasOffer = false;
    };

    this.spinResponceHandler = function(){
        if(this.super.spinResponceHandler)
            this.super.spinResponceHandler();
        _spinResponseReceived = true;
    };
});



nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.States.GambleState = nge.App.ClassicGameBase.Mlm.Brain.ButtonsNewLogic.States.BaseState.extend(function () {
    var _cycleComplete = false;
    var _gambleShowed = false;
    var _gambleTakedCount = 0;
    var _actionRequested = false; 
    var _balanceReceived = false;

    this.model = {
        order: ['READY', 'STARTED?'],
        
        actions: {
            READY: {
                'spin': {
                    title: nge.i18n.get('TAKE'),
                    enabled: ['!auto', '!gambleTakedTwiceAndMore'],
                    callback: function(){
                        nge.observer.fire('gamble.take'); 
                    }
                },
                'oneBet': {
                    title: nge.i18n.get('GAMBLE'),
                    enabled: ['!auto', '!gambleTakedOnceAndMore'],
                    callback: function(){
                        nge.observer.fire('gamble.go'); 
                    }
                },
                'maxBet': {
                    title: nge.i18n.get('GAMBLE'),
                    enabled: ['!auto', '!gambleTakedOnceAndMore'],
                    callback: function(){
                        nge.observer.fire('gamble.go'); 
                    }
                },
                'auto': {
                    callback: ['autoCallback']
                }
            },

            STARTED: {
                'spin': {
                    title: nge.i18n.get('TAKE'),
                    enabled: ['!actionRequested'],
                    callback: function(){
                        nge.observer.fire('gamble.take'); 
                    }
                },
                'oneBet': {
                    title: nge.i18n.get('RED'),
                    enabled: ['!actionRequested'],
                    callback: function(){
                        nge.observer.fire('gamble.red'); 
                    }
                },
                'maxBet': {
                    title: nge.i18n.get('BLACK'),
                    enabled: ['!actionRequested'],
                    callback: function(){
                        nge.observer.fire('gamble.black'); 
                    }
                }
            }
        }
    };

    this.subscribeCfgExt = {
        'gamble.go': 'gambleGoHandler',
        'gamble.take': 'gambleTakeHandler',
        'gamble.taking.stop': 'gambleTakingStopHandler',
        'gamble.actionRequest': 'actionRequestHandler',
        'buttons.gamble.restore': 'gambleRestoreHandler',
        'gamble.loose': 'gambleTakingStopHandler'
    };

    this.validityCheckHandler = function(){
        var canGamble = nge.localData.get('slotMachine.slotWin.canGamble') === 'true';
        return canGamble && _cycleComplete && !_balanceReceived;
    };

    this.actionUpdateHandlers = {
        onReady: function(){
            return !_gambleShowed; 
        },
        onStarted: function(){
            return _gambleShowed;
        }
    };
    
    var auto = this.propUpdateHandlers.auto;
    
    this.propUpdateHandlers = {
        auto: auto,

        gambleTakedOnceAndMore: function(){
            return _gambleTakedCount >= 1;
        },
        gambleTakedTwiceAndMore: function(){
            return _gambleTakedCount >= 2;
        },
        actionRequested: function(){
            return _actionRequested;
        }
    };
    
    this.gambleTakeHandler = function(){
        _gambleShowed = false;
        _gambleTakedCount++;
    };

    this.gambleGoHandler = function(){
        _gambleShowed = true;
    };

    this.gambleTakingStopHandler = function(){
        _gambleTakedCount = 3;
    };

    this.spinStartHandler = function(){
        this.super.spinStartHandler();
        _gambleTakedCount = 0;
        _cycleComplete = false;
        _balanceReceived = false;
    };

    this.actionRequestHandler = function(){
        _actionRequested = true;
    };

    this.gambleRestoreHandler = function(){
        _actionRequested = false;
    };

    this.cycleCompleteHandler = function(){
        this.super.cycleCompleteHandler();
        _cycleComplete = true;
    };

    this.balanceResponseHandler = function(){
        this.super.balanceResponseHandler();
        _balanceReceived = true;
    };

    // this.subscribe = function(){
    //     this.super.subscribe();
    //     nge.observer.add('gamble.go', this.gambleGoHandler, 'gamble.go'.concat(this.id), true);
    //     nge.observer.add('gamble.take', this.gambleTakeHandler, 'gamble.take'.concat(this.id), true);
    //     nge.observer.add('gamble.taking.stop', this.gambleTakingStopHandler, 'gamble.taking.stop'.concat(this.id), true);
    //     nge.observer.add('gamble.actionRequest', this.actionRequestHandler, 'gamble.actionRequest'.concat(this.id), true);
    //     nge.observer.add('buttons.gamble.restore', this.gambleRestoreHandler, 'gamble.gamble.restore'.concat(this.id), true);
    //     nge.observer.add('gamble.loose', this.gambleTakingStopHandler, 'gamble.loose'.concat(this.id), true);
    // };

    // this.unsubscribe = function(){
    //     this.super.unsubscribe();
    //     nge.observer.remove('gamble.go', false, 'gamble.go'.concat(this.id), true);
    //     nge.observer.remove('gamble.take', false, 'gamble.take'.concat(this.id), true);
    //     nge.observer.remove('gamble.taking.stop', false, 'gamble.taking.stop'.concat(this.id), true);
    //     nge.observer.remove('gamble.actionRequest', false, 'gamble.actionRequest'.concat(this.id), true);
    //     nge.observer.remove('buttons.gamble.restore', false, 'gamble.gamble.restore'.concat(this.id), true);
    //     nge.observer.remove('gamble.loose', false, 'gamble.loose'.concat(this.id), true);
    // };
});



