nge.Com.LoadAssets = {};



nge.Com.LoadAssets.Controller = nge.Com.Base.extend(function () {
    var _self;
    var _cfg;
    var _authCheckStartTime;
    var _authDone = false;
    var _loginSuccess = false;
    var _soundsPreloaded = false;
    var _created;
    var MAX_AUTH_WAIT_TIME = 20000;

    this.preload = function () {
        this.preloadDefault();
        _self = this;
        _cfg = nge.App.getInstance('Com.Load.Cfg');
        _preloadScrollbars();
        _preloadLoader();
        _preloadAtlases();
        _preloadBitmapFonts();
    };

    this.create = function () {
        _authCheckStartTime = nge.Lib.Time.get();
        _preloadSounds();

        if (!_created) {
            this.subscribe();
            _created = true;
        }

        var condition = function () {
            var delta = nge.Lib.Time.getDeltaT(_authCheckStartTime);

            if (!_authDone) {
                if (delta > MAX_AUTH_WAIT_TIME) {
                    _loginSuccess = false;
                    _authDone = true;
                } else if (nge.localData.get('brain.firstAuthComplete') === true) {
                    _loginSuccess = true;
                    _authDone = true;
                }
            }

            return _authDone && _soundsPreloaded;
        };

        var callback = function () {
            // We should skip one frame cause we can't change state in 'create' function
            nge.rafSetTimeout(function () {
                if (_loginSuccess) {
                    nge.userInfoHTML('Auth Complete');
                    nge.observer.fire('loadAssets.complete');
                    nge.statesManager.display(nge.statesManager.getDefaultState());
                } else {
                    nge.userInfoHTML('Auth Fail. Try again later.');
                    nge.userFatalErrorHTML('Auth Fail', 'Try again later.');
                }
            }, 1);
        };

        //NOTE (r.rakhman): Total  waiting timeout: 5'000 seconds.
        nge.Lib.Checker.delay(condition, callback, 500, 10000, true);
    };

    this.subscribe = function () {
        nge.observer.add('sounds.preloaded', function () {
            _soundsPreloaded = true;
        });
    };

    var _preloadScrollbars = function () {
        _self.preloadDefault(nge.tpl.group('scrollbarVertical'));
        _self.preloadDefault(nge.tpl.group('scrollbarHorizontal'));
    };

    var _preloadLoader = function () {
        window.mt.data.assets.contents.push(
            {
                "name": "loader",
                "contents": nge.tpl.group('loader').assets.contents,
                "id": 4
            }
        );

        window.mt.data.objects.contents.push({
            "id": 'loader',
            "name": 'loader',
            "contents": nge.tpl.group('loader').objects.contents,
            "isVisible": true,
            type: mt.objects.GROUP
        });
    };

    var _preloadAtlases = function () {
        if (!_cfg || !_cfg.atlasesGroups || !_cfg.atlasesGroups.length)
            return false;

        for (var i = 0; i < _cfg.atlasesGroups.length; i++) {
            var name = _cfg.atlasesGroups[i];

            window.mt.data.assets.contents.push(
                {
                    "name": name,
                    "contents": nge.tpl.group(name).assets.contents
                }
            );
        }
    };

    var _preloadBitmapFonts = function () {
        if (_cfg && _cfg.bitmapFonts) {
            for (var fontName in _cfg.bitmapFonts) {
                window.mt.data.assets.contents.push(
                    {
                        key: fontName,
                        type: mt.assets.BITMAP_FONT,
                        textureURL: _cfg.bitmapFonts[fontName].textureURL,
                        bitmapFont: _cfg.bitmapFonts[fontName].bitmapFont
                    }
                );
            }
        }
    };

    var _preloadSounds = function () {
        var mobile = nge.Lib.Helper.mobileAndTabletCheck();

        if (!mobile)
            nge.soundManager.preload();
        else {
            _soundsPreloaded = true;
            //buttons logic will set sounds button inactive
        }
    };
});



nge.Com.LoadAssets.Tpl = function () {

    var tpl = {
        assets: {
            contents: []
        },
        objects: {
            contents: []
        }
    };

    if (typeof customButtons === 'undefined') return tpl;

    for (var name in customButtons) {
        var button = customButtons[name];

        if (!button.callback) continue;

        if (button.imageUrl) {
            var asset = {};
            asset.key = name.concat('-blank');
            asset.fullPath = button.imageUrl;

            tpl.assets.contents.push(asset);
        }
        
        if (customButtons[name].imageBase64) {
            var img = new Image();
            img.src = customButtons[name].imageBase64;
            
            (function (btnName) {
                img.onload = function () {
                    nge.wrap.cache.addImage(btnName.concat('-blank'), img.src, img);
                };
            })(name);
        }
    }

    return tpl;
};


nge.Com.Maxbet = {};



nge.Com.Maxbet.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _cfg;
    var _max;

    this.create = function () {
        this.createDefault();
        var cfg = this.getInstance('Cfg');
        _cfg = cfg.get();

        if (!_created) {
            _subscribe();
            _update();
        }
        _created = true;
    };

    var _update = function () {

        var l = nge.localData.get('lines.value');
        var b = nge.localData.get('bet.value');
        var maxBet = nge.localData.get('maxBetValue');
        var maxLines = nge.localData.get('maxLinesValue');
        //no max
        if (l !== maxLines || b !== maxBet) {
            _maxbetButtonChange(false);
            _spinButtonChange(false);
            return false;
        }
        //max
        _maxbetButtonChange(true);
        _spinButtonChange(true);

        return true;
    };

    var _maxbetButtonChange = function (max) {
        if (!_cfg.maxbetButtonChange)
            return false;

        _max = max;
        if (max) {
            _maxBetButtonDisableMax();
        } else {
            _maxBetButtonEnable();
        }
    };

    var _spinButtonChange = function (max) {
        if (!_cfg.spinButtonChange)
            return false;

        nge.observer.fire('spinButton.maxBet', max);
    };

    var _maxBetButtonEnable = function () {
        if (nge.localData.get('autospin.inProgress') ||
            nge.localData.get('freespin.inProgress') ||
            nge.localData.get('freeGame.inProgress')
            ) {
            return false;
        }

        if (_max) {
            _maxBetButtonDisableMax();
        } else {
            var button = nge.find('^' + _cfg.maxbetButtonName);
            button.enable();

            nge.find('^btn_maxbet_text1').removeClass('disableText');
            nge.find('^btn_maxbet_text2').removeClass('disableText');
        }
    };

    var _maxBetButtonDisable = function () {
        var button = nge.find('^' + _cfg.maxbetButtonName);
        button.disable(4);

        nge.find('^btn_maxbet_text1').addClass('disableText');
        nge.find('^btn_maxbet_text2').addClass('disableText');
    };

    var _maxBetButtonDisableMax = function () {
        if (nge.localData.get('autospin.inProgress') ||
            nge.localData.get('freespin.inProgress') ||
            nge.localData.get('freeGame.inProgress')
            ) {
            return false;
        }
        var button = nge.find('^' + _cfg.maxbetButtonName);
        button.disable(3);

        nge.find('^btn_maxbet_text1').removeClass('disableText');
        nge.find('^btn_maxbet_text2').removeClass('disableText');
    };

    var _subscribe = function () {
        nge.observer.add(
            'bet.change',
            function () {
                //all buttons events will path
                _update();
            }
        );
        nge.observer.add(
            'lines.change',
            function () {
                //all buttons events will path
                _update();
            }
        );
        nge.observer.add(
            'maxBetButton.enable',
            _maxBetButtonEnable
            );
        nge.observer.add(
            'maxBetButton.disable',
            _maxBetButtonDisable
            );
        nge.observer.add(
            'slotMachine.spinComplete',
            function () {
                //all buttons events will path
                _update();
            }
        );
    };

});



nge.Com.Maxbet.Cfg = Class.extend(function () {
    this.singleton = true;

    this.cfg = {
