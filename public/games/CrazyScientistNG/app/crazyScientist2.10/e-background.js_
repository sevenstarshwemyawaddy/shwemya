nge.App[nge.appNS].Tpl.Groups.Tabs = function () {
    var _imagePath = nge.appPath + 'img/help/';
    var _img = nge.appPath + 'img/scrollbar/';
    
    return { 
        'styles': {
            '^headersContainer .tabHeaderText': {
                'style': {
                    'fill': '#ffffff'
                }
            },
            '^headersContainer .active .tabHeaderText': {
                'style': {
                    'fill': '#fec36d'
                }
            },
            '^headersContainer .tabHeaderImage': {
                'isVisible': false
            },
            '^headersContainer .active .tabHeaderImage': {
                'isVisible': true
            }
        },
        
        'assets': {
            'name': 'assets',
            'contents': [
                { type: mt.assets.IMAGE, 'key': 'betSettings_group', 'fullPath': _imagePath + 'betSettings_group.png' },
                { type: mt.assets.IMAGE, 'key': 'help_group', 'fullPath': _imagePath + 'help_group.png' },
                { type: mt.assets.IMAGE, 'key': '1px_empty', 'fullPath': _img + '1px_empty.png'},
