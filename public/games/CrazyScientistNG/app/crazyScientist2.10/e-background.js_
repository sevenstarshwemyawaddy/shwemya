        nge.progressBar.setLoadedValue(_loadTo);
    };
});



nge.App[nge.appNS].Com.LoadingBar = {};



nge.App[nge.appNS].Com.LoadingBar.Controller = nge.Com.Base.extend(function () {
    var _loadingBar = null;
    var _dotsSprites = [];
    var _count = 0;
    var _between = 5;
    var _minMargin = 8;
    var _created = false;

    var _reset = function(){
        _dotsSprites = [];

        if(_loadingBar)
            _loadingBar.destroy(true);

        _loadingBar = null;
    };

    var _generateSpritesForFill = function(dotsIsVisible){
        var createDotSprite = function(isVisible){
            return nge.objects.create(nge.Mlm.Objects.Image({
                assetKey: 'loadingBarDot',
                isVisible: isVisible,
                x: _minMargin,
                y: 0,
                anchorX: 0.5,
                anchorY: 0.5
            }), null);
        };

        var width = _loadingBar.width;
        var dotSpriteImage = createDotSprite(false);
        var sW = dotSpriteImage.width;

        _count = Math.round((width - (_minMargin/2)) / (sW + (_between)));

        for(var i = 0; i < _count; i++){
            var spr = createDotSprite(dotsIsVisible);
            spr.x += (sW + _between) * i;

            _dotsSprites.push(spr);
            _loadingBar.children[0].addChild(spr);
        }
    };

    this.loadUpdate = function(data){
        if(!_loadingBar)
            return;

        var progress = data.progress / 100;
        var visibleCount = Math.round(_count * progress);

        for(var i = 0; i < visibleCount; i++){
            _dotsSprites[i].visible = true;
        }
    };

    var _constructLoadingBar = function(dotsIsVisible){
        _reset();

        _loadingBar = nge.objects.create('newLoadingBarContainer');
        _generateSpritesForFill(dotsIsVisible);
    };

    this.create = function () {

        if(nge.localData.get('loadingBar.generateBarOnPreload'))
            _constructLoadingBar(true);

        nge.localData.set('loadingBar.generateBarOnPreload', false);

        if(!_created)
            this.subscribe();
        _created = true;
    };

    this.preload = function(){
        this.super.preload();
        _reset();

        if(nge.localData.get('loadingBar.generateBarOnPreload'))
            _constructLoadingBar();
    };

    this.subscribe = function(){
        nge.observer.add('loadingBar.generateLoaderBar', function(dotsIsVisible){
            _constructLoadingBar(dotsIsVisible);
        });
    };
});



nge.App[nge.appNS].Com.Odometer = {};



nge.App[nge.appNS].Com.Odometer.Controller = nge.Com.Base.extend(function () {
    var _self;
    var _cfg;
    var _created;
    var _target;
    var _data;

    var _setText = function(value) {
        _target.setText(value);
        if(_target instanceof Phaser.BitmapText) {
            _target.removeChildren();
            _target.purgeGlyphs();
        }
    };

    var _tweenUpdate = function(ctx, progress) {
        if(_data.to)
            _setText(Math.ceil(_data.to * progress));
    };

    var _tweenWinComplete = function() {
        if(_data.to) {
            _setText(_data.to);
            nge.observer.fire('odometer.completeValue', _data);
        }
    };

    var _tweenComplete = function() {
        nge.observer.fire('odometer.complete', _data);
    };

    /**
     * data.to: Number (optional)
     * data.duration: Number
     * data.effect: { type: 'none' }
     * @private
     */
    var _noneEffect = function() {
        var _tween = nge.tween.add(_target.scale).to( _target.scale, _data.duration, null, true);
        _tween.onUpdateCallback(_tweenUpdate, _self);
        _tween.onComplete.add(_tweenWinComplete);
        _tween.onComplete.add(_tweenComplete);
    };

    /**
     * data.to: Number (optional)
     * data.duration: Number
     * data.effect: { type: 'jump', scale: Number, jumpScale: Number }
     * @private
     */
    var _jumpEffect = function() {
        var _effect = _data.effect;
        var _duration = Math.max(_data.duration - 1200, 500);
        var _tween = nge.tween.add(_target.scale).to( { x: _effect.scale, y: _effect.scale }, _duration, null, true);
        _tween.onUpdateCallback(_tweenUpdate, _self);
        _tween.onComplete.add(_tweenWinComplete);

        var _bounceTween = nge.tween.add(_target.scale)
            .to( { x:_effect.jumpScale, y: _effect.jumpScale }, 500, null, false)
            .to( { x: 1, y: 1 }, 700, null, false);
        _bounceTween.onComplete.add(_tweenComplete);
        _tween.chain(_bounceTween);
    };

    /**
     * data.to: Number (optional)
     * data.duration: Number
     * data.effect: { type: 'linear', scale: Number }
     * @private
     */
    var _linearEffect = function() {
        var _effect = _data.effect;
        var _tween = nge.tween.add(_target.scale).to( { x: _effect.scale, y: _effect.scale }, _data.duration, null, true);
        _tween.onUpdateCallback(_tweenUpdate, _self);
        _tween.onComplete.add(_tweenWinComplete);
        _tween.onComplete.add(_tweenComplete);
    };

    this.effects = {
        'none': _noneEffect,
        'jump': _jumpEffect,
        'linear': _linearEffect
    };

    var _updateValue = function(value) {
        _setText(value);
    };

    var _reset = function() {
        _target = undefined;
        _data = {};
    };

    var _init = function(selector) {
        _reset();
        _target = nge.find(selector);
    };

    var _go = function (data) {
        _data = data;
        if(!_target)
            return console.log('Ododmeter.js._go: odometer requires target!');
        _self.effects[data.effect.type]();
    };

    this.create = function () {
        this.createDefault();
        _self = this;

        if (!_created) {
            _created = true;
            _self.subscribe();
        }
        _reset();
    };

    this.subscribe = function () {
        nge.observer.add('odometer.init', _init);
        nge.observer.add('odometer.go', _go);
        nge.observer.add('odometer.updateValue', _updateValue);
    };
});


nge.App[nge.appNS].Com.Offers = {};



nge.App[nge.appNS].Com.Offers.Controller = nge.Com.Base.extend(function () {
    var _self = this;
    var _subscribed = false;
    var _offerFinished = false;
    var _offers = [];
    var _objs = {
        bg: {name: 'offersBG', o: false},
        offersList: {name: 'offersList', o: false},
        offerStatistic: {name: 'offerStatistic', o: false},
        offerCancelConfirmation: {name: 'offerCancelConfirmation', o: false}
    };
    this.bgElements = [{key: 'bg', alpha: 0.83}];
    this.objs = _objs;
    var _curN = 0;
    var _takingFinished;
    var _isLastWin;
    var _allFreeGames = 0;

    var _isCancelOffer = false;
    var _offerWas;

    var _balanceReceived = false;
    var _finishOfferReceived = false;
    var _finishOfferData = false;

    /**
     * create
     * @returns {Boolean}
     */
    this.preload = function () {
        //nge.localData.set('actions', [{"type":"offer","id":"715","coinValue":"1.00","bet":"1","lines":"50","freespins":"20","totalspins":"20","expires":"0"}]);

        nge.localData.set('offersList', []);


        nge.localData.set('freeGame.inProgress', false);
        nge.localData.set('freeGame.amount', false);
        _offerWas = false;

        var actions = nge.localData.get('actions');

        if (!actions)
            return false;

        _offers = [];

        for (var i = 0; i < actions.length; i++)
            if (actions[i].type && actions[i].type === 'offer')
                _offers.push(actions[i]);

        if (_offers.length === 0)
            return false;

        nge.localData.set('offersList', _offers);

        if (!_subscribed)
            _subscribe();

        _subscribed = true;

        //offers !!!
        this.preloadDefault();
    };

    this.create = function () {

        if (_offers.length === 0)
            return false;

        this.createDefault();
        _prepareLinks();

        _takingFinished = false;
        _offerFinished = false;
        _offerWas = true;
        //cancel text handler
        var cancelText = nge.findOne('^offerCancelText');
        if (cancelText) {
            cancelText.inputEnabled = true;
            cancelText.input.useHandCursor = true;
            cancelText.events.onInputDown.add(function () {
                nge.observer.fire('offers.list.cancel');
            }, this);
        }

        //if bonus game in progress do not show offers
        var state = nge.statesManager.getCurrentName();

        var restoreGame = nge.localData.get('brain.restoreGame');
        var freespins = nge.localData.get('freespin.inProgress');
        if (restoreGame || freespins || state !== 'play')
            return false;

        //else we will show offers list
        if (!_isCancelOffer)
            nge.rafSetTimeout(function () {
                nge.rafSetTimeout(_checkOffersToShow, 1);
            }, 1);
    };

    var _prepareLinks = function () {
        for (var k in _objs)
            _objs[k].o = nge.findOne('^' + _objs[k].name);
    };

    var _checkOffersToShow = function () {

        _offerFinished = false;

        _hideAll();

        if (_offers.length === 0) {
            _isCancelOffer = true;
            _activatedButton();
            return false;
        }

        // nge.observer.fire('buttons.disable.all');
        _changeAlpha('offersList', 1);
        _showInList(0);

        nge.localData.set('freeGame.showingOfferMenu', true);
    };

    this.normalizeListIndex = function (rawIndex, offersList) {
        return nge.Lib.Math.valBetween(rawIndex, 0, offersList.length - 1);
    };

    var _showInList = function (n) {
        _curN = _self.normalizeListIndex(n, _offers);
        var offer = _offers[_curN];
        _self.showOffer(nge.Cfg.Main.title.toUpperCase(), _curN, _offers.length, offer);
    };

    this.showOffer = function (title, curN, offersLength, offer) {
        nge.findOne('^offersListGameName').text = title;
        nge.findOne('^offerCurrentNum').text = curN + 1;
        nge.findOne('^offersTotalNum').text = offersLength;

        nge.findOne('^offerFreeGamesAmount').text = offer.freespins;

        var expires = parseInt(offer.expires);
        nge.findOne('^offerAvaliableTo').text = expires ?
            nge.Lib.Time.unixtimeToDDMMYYYY(expires) : '-';

        nge.findOne('^offerCoinValue').text = offer.coinValue;
        nge.findOne('^offerBet').text = offer.bet;
        nge.findOne('^offerLines').text = offer.lines;
    };

    var _hideAll = function () {
        for (var k in _objs) {
            if (_objs[k].o) {
                _objs[k].o.alpha = 0;
                _objs[k].o.visible = false;
            }
        }
    };

    var _changeAlpha = function (str, alpha, timing) {
        if (!_objs[str].o)
            return;
        _tweenAlpha(_objs[str].o, alpha, timing);
        _self.bgElements.forEach(function (bgElement) {
            if (_objs[bgElement.key].o)
                _tweenAlpha(_objs[bgElement.key].o, alpha * bgElement.alpha, timing);
        });
    };

    var _tweenAlpha = function (obj, a, timing) {
        timing = timing || 200;
        obj.visible = true;
        var tween = nge.tween.add(obj).to({alpha: a}, timing);

        tween.onComplete.addOnce(function () {
            if (a === 0)
                obj.visible = false;
        });

        tween.start();
    };

    this.showStatisticsValues = function (data) {
        nge.findOne('^offerFreeGamesPlayed').text = data.playedSpins;
        nge.findOne('^offerFreeGamesWin').text = nge.Lib.Money.toCoins(data.totalOfferWin);
    };

    this._finishOffer = function () {
        _balanceReceived = false;
        _finishOfferReceived = false;
        //"data": {“offerId”:34, "totalOfferWin":123.12, “playedSpins”:21}
        var data = _finishOfferData;
        var time = 1; //;_isLastWin ? 500 : 2700;

        nge.localData.set('freeGame.amount', 0);
        _changeOfferStateText();

        if (+data.playedSpins === 0) {
            _hideAll();
            _changeAlpha('offerStatistic', 1, 200);
            _self.showStatisticsValues(data);
            nge.observer.fire('offers.finishFreeGames');
            _isCancelOffer = false;
            nge.localData.set('freeGame.showingOfferMenu', true);
            return;
        }

        _checkAutospin();

        nge.observer.fire('buttons.finish.offer');
        nge.rafSetTimeout(function () {
            _changeStateOfOffer();
            _hideAll();
            _changeAlpha('offerStatistic', 1, 200);
            _self.showStatisticsValues(data);
            nge.observer.fire('offers.finishFreeGames');
            nge.localData.set('freeGame.amount', false);
            nge.localData.set('freeGame.showingOfferMenu', true);
            nge.observer.fire('freespin.counterReset');

        }, time);
       
        this._btnRestore(time);

        _offerFinished = true;
    };

    this._btnRestore = function(time) {
        nge.rafSetTimeout(function () {
            nge.observer.fire('buttons.restore');
        }, time+ 700);
    };

    this._finishOfferResponseHandler = function (data) {
        _finishOfferReceived = true;
        _finishOfferData = data;
        if (_balanceReceived)
            _self._finishOffer();
    };

    var _removeCurOfferFromList = function () {
        _offers.splice(_curN, 1);
        _checkOffersToShow();
    };

    var _removeAllOffersFromList = function () {
        _offers = [];
        _checkOffersToShow();
    };

    var _checkAutospin = function () {
        if (nge.localData.get('autospin')) {
            var tableOrMobileFlag = nge.Lib.Helper.mobileAndTabletCheck();

            if(tableOrMobileFlag)
                nge.observer.fire('buttons.insidePress', 'autoSpinMobile');
            else
                nge.observer.fire('buttons.insidePress', 'auto');
        }
    };

    var _cancel = function () {
        _hideAll();
        _changeAlpha('offerCancelConfirmation', 1);
    };

    var _apply = function () {
        _hideAll();
        nge.observer.fire('buttons.restore.offer');

        var offer = _offers[_curN];
        nge.observer.fire('offer.apply', offer.id);
        _offers.splice(_curN, 1);
        //apply settings
        nge.observer.fire('lines.set', parseInt(offer.lines));
        nge.observer.fire('bet.set', offer.bet);
        nge.observer.fire('coins.set', offer.coinValue);

        nge.localData.set('freeGame.totalspins', offer.totalspins);
        nge.localData.set('freeGame.amount', offer.freespins);
        nge.localData.set('freeGame.inProgress', true);

        _allFreeGames = offer.totalspins || 0;

        nge.observer.fire('infoPanel.showText', {
            text: _getTextFreeGame(),
            position: 'down',
            colors: [{color: '#ff8600', from: 0}]
        });
        
        nge.localData.set('freeGame.showingOfferMenu', false);
        nge.observer.fire('offers.startGame');

        var left = +offer.totalspins - +offer.freespins;
        nge.observer.fire('freespin.counterUpdate', {total :offer.totalspins, current: left});
    };

    var _getTextFreeGame = function () {
        var total = _allFreeGames - nge.localData.get('freeGame.amount');
        return 'FREE GAME ' + (total || 0) + ' OF ' + _allFreeGames;
    };

    var _listPrev = function () {
        _showInList(_curN - 1);
    };

    var _listNext = function () {
        _showInList(_curN + 1);
    };

    var _cancelConfirm = function () {
        nge.observer.fire('offer.cancel', _offers[_curN].id);
        _removeCurOfferFromList();

        nge.localData.set('freeGame.showingOfferMenu', false);
    };

    var _changeStateOfOffer = function () {
        var freeGameAmount = nge.localData.get('freeGame.amount');
        //_chkActiveOffers
        if (!freeGameAmount) {
            nge.localData.set('freeGame.inProgress', false);
        }
    };

    /** spins **/
    var _winlinesCompleteHandler = function () {
        var lastWin = nge.localData.get('slotMachine.slotWin.totalWin');

        if (!lastWin || parseFloat(lastWin) === 0) {
            _takingFinished = true;
        }
        var isFreeGameInProgress = nge.localData.get('freeGame.inProgress');
        var isFreeSpinInProgress = nge.localData.get('freespin.inProgress');

        if(isFreeGameInProgress && isFreeSpinInProgress) {
            var freeGameAmount = parseInt(nge.localData.get('freeGame.amount'));
            var freespinsLeft = parseInt(nge.localData.get('freespin.spinsLeft'));

            if(freeGameAmount === 0 && freespinsLeft === 0)
                nge.observer.fire('buttons.disable.all', null, 5);
        }
    };

    var _spinStartHandler = function () {
        _isLastWin = false;
        _takingFinished = false;
        _balanceReceived = false;
        _finishOfferReceived = false;

        if(nge.localData.get('freeGame.inProgress') && nge.localData.get('freeGame.amount') === 0) {
            if (nge.localData.get('autospin')) {
                nge.localData.set('offersLastSpinAutoPlayed', true);
            }

            _checkAutospin();
        } else {
            nge.localData.set('offersLastSpinAutoPlayed', false);
        }
    };

    var _gameTakingStopHandler = function () {
        _takingFinished = true;
    };

    this._balanceResponseHandler = function () {
        // var freeGame = nge.localData.get('freeGame.inProgress');
        var restoreGame = nge.localData.get('offers.restoreGame');
        if(!_offerFinished && restoreGame){
            nge.localData.set('freeGame.inProgress', false);
            nge.localData.set('offers.restoreGame', false);
            _checkAutospin();
            _checkOffersToShow();
            _offerFinished = true;
            return;
        }

        var freeGame = nge.localData.get('freeGame.inProgress');
        var freeGameAmount = nge.localData.get('freeGame.amount');
        var isFreespinInProgress = nge.localData.get('freespin.inProgress');

        if (isFreespinInProgress) {
            nge.localData.set('freeGame.inProgress', false);
            return false;
        } else if (nge.localData.get('freeGame.amount')) {
            if (!nge.localData.get('freeGame.inProgress')) {
                nge.localData.set('freeGame.inProgress', true);
                freeGame = nge.localData.get('freeGame.inProgress');
            }
        }

        if (_takingFinished && freeGameAmount > 0) {
            return true;
        } else if (!freeGame && _offers.length >= 0 && !_isCancelOffer) {
            if (!isFreespinInProgress && !nge.localData.get('autospin') && _offerWas)
                _activatedButton();
        }

        if(nge.localData.get('freeGame.inProgress'))
            nge.rafSetTimeout(function () {
                if (!nge.localData.get('freeGame.amount'))
                    nge.observer.fire('buttons.disable.all');
            }, 5);

        _balanceReceived = true;
        if (_finishOfferReceived)
            _self._finishOffer();
    };

    var _winHandler = function () {
        _isLastWin = true;
    };

    var _activatedButton = function () {
        if (_offers.length === 0) {
            nge.observer.fire('buttons.restore');
            nge.localData.set('freeGame.showingOfferMenu', false);
        }
    };

    var _changeOfferStateText = function () {
        var isFreeGameInProgress = nge.localData.get('freeGame.inProgress');
        var freeGameAmount = nge.localData.get('freeGame.amount');
        var isFreespinInProgress = nge.localData.get('freespin.inProgress');
        
        if(!isFreeGameInProgress || isFreespinInProgress)
            return;

        var tableOrMobileFlag = nge.Lib.Helper.mobileAndTabletCheck();

        if(!tableOrMobileFlag){

            if (typeof freeGameAmount === 'number') {
                nge.observer.fire('infoPanel.showText', {
                    text: '',
                    position: 'up'
                });

                nge.observer.fire('infoPanel.showText', {
                    text: _getTextFreeGame(),
                    position: 'down',
                    colors: [{color: '#ff8600', from: 0}]
                });
            }
        }
    };

    var _onFreespinFinish = function () {
        var freeGameInProgress = nge.localData.get('freeGame.inProgress');
        var freeGameAmount = parseInt(nge.localData.get('freeGame.amount'), 10);
        if(typeof freeGameAmount !== 'boolean' && freeGameAmount === 0 && freeGameInProgress){
            _checkAutospin();
            nge.rafSetTimeout(function () {
                nge.observer.fire('buttons.disable.auto');
            }, 50);
        }
    };

    var _onSpinComplete = function(){
        
        var freeGameAmount = parseInt(nge.localData.get('freeGame.amount'), 10);
        var freespinsLeft = parseInt(nge.localData.get('freespin.spinsLeft'), 10);
    
        if(typeof freeGameAmount !== 'boolean' && freeGameAmount === 0 && freespinsLeft===0){
            _checkAutospin();
            nge.rafSetTimeout(function () {
                nge.observer.fire('buttons.disable.auto');
            }, 50);
        }
    };

    var _spinResponseHandler = function(){
        var offerData = nge.localData.get('freeGame');
        var isFreespin = nge.localData.get('freespin.inProgress');

        if(offerData.inProgress && !isFreespin){
            var left = +offerData.totalspins - +offerData.amount;
            nge.observer.fire('freespin.counterUpdate', {total : offerData.totalspins, current: left});
        }
    };

    var _onTransportClose = function () {
        nge.localData.set('freeGame', false);
    };

    var _subscribe = function () {
        nge.observer.add('win', _winHandler);
        nge.observer.add('offer.finishOfferResponse', _self._finishOfferResponseHandler);
        nge.observer.add('offers.list.hideAll', _hideAll);
        nge.observer.add('offers.list.later', _removeCurOfferFromList);
        nge.observer.add('offers.list.later.all', _removeAllOffersFromList);
        nge.observer.add('offers.list.cancel', _cancel);
        nge.observer.add('offers.list.cancel.cancel', _checkOffersToShow);
        nge.observer.add('offers.list.cancel.confirm', _cancelConfirm);
        nge.observer.add('offers.list.apply', _apply);
        nge.observer.add('offers.list.prev', _listPrev);
        nge.observer.add('offers.list.next', _listNext);
        nge.observer.add('offers.result.goToGame', _checkOffersToShow);
        nge.observer.add('offers.result.goToGame', _activatedButton);
        nge.observer.add('winlines.animateByOne.cycleComplete', _winlinesCompleteHandler);
        nge.observer.add('slotMachine.spinStart', _spinStartHandler);
        nge.observer.add('gamble.taking.stop', _gameTakingStopHandler);
        nge.observer.add('balance.amount', _self._balanceResponseHandler);
        nge.observer.add('freespin.start', _hideAll);
        nge.observer.add('transportMessage.SpinResponse', _changeOfferStateText);
        nge.observer.add('slotMachine.spinCommand', _changeOfferStateText);
        nge.observer.add('slotMachine.spinResponse', _spinResponseHandler);
        nge.observer.add('slotMachine.spinComplete', _onSpinComplete);
        nge.observer.add('buttons.freespinFinish', _onFreespinFinish);
        nge.observer.add('Transport.close', _onTransportClose);
    };
});



nge.App[nge.appNS].Com.Offers.Tpl = function () {
    var _offers = nge.tpl.group('offers');

    return {
        styles: _offers.styles,
        assets: {
            name: 'assets',
            contents: [
                { type: mt.assets.GROUP, contents: _offers.assets.contents }
            ]
        },
        objects: {
            name: 'objects',
            contents: [
                { type: mt.objects.GROUP, contents: _offers.objects.contents }
            ]}
    };
};



nge.App[nge.appNS].Com.Offers.UI_v3 = {};



nge.App[nge.appNS].Com.Offers.UI_v3.Offers_v3 = {};



nge.App[nge.appNS].Com.Offers.UI_v3.Offers_v3.Controller = nge.App[nge.appNS].Com.Offers.Controller.extend(function () {
    var _self = this;
    var _created = false;
    var _finished = false;

    delete this.objs.offerCancelConfirmation;
    this.objs.bgCover = {name: 'offersBGCover', o: false};
    this.objs.closeOffersButton = {name: 'closeOffersButton', o: false};
    this.objs.offerSelectNextButton = {name: 'offerSelectNextButton', o: false};
    this.objs.offerSelectPreviousButton = {name: 'offerSelectPreviousButton', o: false};
    this.bgElements = [
        {key: 'bg', alpha: 1},
        {key: 'bgCover', alpha: 1}, //Was 0.83 but iOS
        {key: 'closeOffersButton', alpha: 1}
    ];

    this.titleTextFill = '#ff0000';
    this.titleValuesFill = '#ff0000';
    this.valuesFill = '#ff0000';
    this.defaultFill = '#ff0000';
    this.currencyColor = '#00BFFF';

    var _alignRight = [
        {selector: '^offerAvaliableTo', object: null, layoutX: 0},
        {selector: '^offerCoinValue', object: null, layoutX: 0},
        {selector: '^offerTotalBet', object: null, layoutX: 0},
        {selector: '^offerLines', object: null, layoutX: 0}
    ];

    var _offers1Container;

    this.create = function () {
        _offers1Container = nge.findOne('^offers1Container');
        if (_offers1Container)
            _offers1Container.visible = false;

        this.super.create();

        for (var k in this.objs)
            if (this.objs[k].o)
                this.objs[k].o.visible = false;

        var actions = nge.localData.get('actions') || [];
        var offers = [];
        for (var i = 0; i < actions.length; i++)
            if (actions[i].type && actions[i].type === 'offer')
                offers.push(actions[i]);

        if (offers.length === 0) {
            return false;
        }

        _offers1Container = nge.findOne('^offers1Container');

        nge.rafSetTimeout(function () {
            for (var i = 1; i <= 4; i++) {
                var rightbox = nge.findOne('^rightbox' + i);
                rightbox.text = '\n- ' + nge.i18n.get(rightbox.text) + '\n';
            }

            var offerPlayLaterButtonButton = nge.findOne('^offerPlayLaterButtonButton');
            var leftButtonText = nge.findOne('^leftButtonText');
            offerPlayLaterButtonButton.scale.set((leftButtonText.width / offerPlayLaterButtonButton.width) * (1 / nge.assets.getQualityFactor()) + 0.15, 1 / nge.assets.getQualityFactor());
        }, 1);

        _alignRight.forEach(function (value) {
            var obj = nge.findOne(value.selector);
            if (obj) {
                value.object = obj;
                value.layoutX = obj.x;
            }
        });

        if (!_created)
            this.subscribe();
        _created = true;
        return true;
    };

    this.showOffer = function (gameTitle, curN, offersLength, offer) {
        _finished = false;

        _offers1Container.visible = true;

        this.objs.offerSelectNextButton.visible = offersLength !== 1;
        this.objs.offerSelectPreviousButton.visible = offersLength !== 1;

        var youHaveText = nge.i18n.get('offersYouHaveText');
        var freespinsText = offer.freespins.toString();
        var freeGamesOfText = nge.i18n.get('offersFreeGamesOfText');
        var titleText = nge.findOne('^offersListTitleText');
        titleText.text = '';
        nge.rafSetTimeout(function () {
            var needNewline = true; // titleText.measureLine(youHaveText + freespinsText + freeGamesOfText + gameTitle) > 1150;
            titleText.text = youHaveText + freespinsText + freeGamesOfText + (needNewline ? '\n' : '') + gameTitle;
            titleText.clearColors();
            titleText.addColor(_self.titleTextFill, 0);
            titleText.addColor(_self.titleValuesFill, youHaveText.length);
            titleText.addColor(_self.titleTextFill, (youHaveText + freespinsText).length);
            titleText.addColor(_self.titleValuesFill, (youHaveText + freespinsText + freeGamesOfText).length);
        }, 1);

        var offersNum = nge.findOne('^offerNum');
        if (offersLength === 1) {
            offersNum.visible = false;
        } else {
            offersNum.text = (curN + 1) + '/' + offersLength + ' ' + nge.i18n.get('offers');
            offersNum.clearColors();
            offersNum.addColor(_self.valuesFill, 0);
            offersNum.addColor(_self.defaultFill, (curN + 1).toString().length);
        }

        var expires = parseInt(offer.expires);
        nge.findOne('^offerAvaliableTo').text = expires ?
            nge.Lib.Time.unixtimeToDDMMYYYY(expires) : '-';

        nge.findOne('^offerCoinValue').text = offer.coinValue;

        var ways = nge.localData.get('ways');
        nge.findOne('^offerLines').text = ways ? ways : offer.lines;

        var offerTotalBet = nge.findOne('^offerTotalBet');
        var currency = nge.localData.get('balance.currency');
        var bm = nge.localData.get('betMultiplier') || 1;
        var text = (+offer.bet * bm * +offer.lines * +offer.coinValue).toFixed(2);
        offerTotalBet.text = text + ' ' + currency;
        offerTotalBet.clearColors();
        offerTotalBet.addColor(_self.currencyColor, text.length);

        _alignRight.forEach(function (value) {
            if (value.object) {
                value.object.addColor(_self.valuesFill, 0);
                if (+value.object.text[value.object.text.length - 1] === 1)
                    value.object.x = value.layoutX + 6;
            }
        });
    };

    this.showStatisticsValues = function (data) {
        var offerFreeGamesPlayed = nge.findOne('^offerFreeGamesPlayed');
        var countOfcompletedGamesOrig = nge.i18n.get('countOfcompletedGames');
        var countOfcompletedGames = countOfcompletedGamesOrig.replace('%playedSpins%', data.playedSpins);
        offerFreeGamesPlayed.text = countOfcompletedGames;
        offerFreeGamesPlayed.clearColors();
        if (countOfcompletedGamesOrig.indexOf('%playedSpins%') === 0) {
            offerFreeGamesPlayed.addColor(_self.valuesFill, 0);
            offerFreeGamesPlayed.addColor(_self.defaultFill, data.playedSpins.toString().length);
        }
        
        var currency = nge.localData.get('balance.currency');
        var offerFreeGamesWinCredits = nge.findOne('^offerFreeGamesWinCredits');
        offerFreeGamesWinCredits.text = nge.Lib.Money.toCoins(data.totalOfferWin);
        var offerFreeGamesWin = nge.findOne('^offerFreeGamesWin');
        offerFreeGamesWin.text = parseFloat(data.totalOfferWin).toFixed(2) + ' ' + currency;
    };

    this.normalizeListIndex = function (rawIndex, offersList) {
        var normalizedIndex = rawIndex;
        if (offersList.length === 0 || offersList.length === 1)
            normalizedIndex = 0;
        else if (rawIndex > offersList.length - 1)
            normalizedIndex = 0;
        else if (rawIndex < 0)
            normalizedIndex = offersList.length - 1;
        return normalizedIndex;
    };

    var _onButtonsPressCommand = function (buttonName) {
        switch (buttonName) {
            case 'offersListApply':
                nge.observer.fire('offers.list.apply');
                break;
            case 'offersListLater':
                nge.observer.fire('offers.list.later');
                break;
            case 'offersListNext':
                nge.observer.fire('offers.list.next');
                break;
            case 'offersListPrev':
                nge.observer.fire('offers.list.prev');
                break;
            case 'offersListClose':
                if (_finished)
                    nge.observer.fire('offers.result.goToGame');
                else
                    nge.observer.fire('offers.list.later.all');
                break;
            case 'offersResultGoToGame':
                nge.observer.fire('offers.result.goToGame');
                break;
            default:
                return;
        }
    };

    var _onFinishOfferResponse = function () {
        _finished = true;
    };

    this.subscribe = function () {
        nge.observer.add('buttons.pressCommand', _onButtonsPressCommand);
        nge.observer.add('offer.finishOfferResponse', _onFinishOfferResponse);
    };
});



nge.App[nge.appNS].Com.Offers.UI_v3.Offers_v3.Gold = {};



nge.App[nge.appNS].Com.Offers.UI_v3.Offers_v3.Gold.Controller = nge.App[nge.appNS].Com.Offers.UI_v3.Offers_v3.Controller.extend(function () {
