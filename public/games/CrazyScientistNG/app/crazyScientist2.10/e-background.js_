nge.App[nge.appNS].Com.Gamble.ShowingAnimation.ControllerExtension = function () {

    var _cfg;

    this.create = function () {
        this.super.create();
        _cfg = this.getInstance('CfgMode').get();
        var smCon = nge.findOne('^slotMachineGameContainer').getData();
        var smGameCon = nge.findOne('^slotMachineGameContainer').parent.getData();
        var _gambleContainer = nge.findOne('^gambleContainer');
        var _mask = nge.game.add.graphics();

        _mask.lineStyle(0);
        _mask.beginFill(0xFFFFFF);
        _mask.drawRect(
            +smGameCon.x + _cfg.offsetX, 
            +smGameCon.y + _cfg.offsetY, 
            +smCon.width + _cfg.offsetWidth, 
            +smCon.height + _cfg.offsetHeight
        );
        _mask.endFill();
        if (_gambleContainer)
            _gambleContainer.mask = _mask;
    };
};



/* global nge */

/**
 * Created by s.kleimenov on 29.11.2018.
 */

nge.App[nge.appNS].Com.Gamble.ShowingAnimation.ViewExtension = function () {

    var _winlinesAddon;
    var _gambleScreen;
    var _cfg;
    var _tween;

    this.init = function () {
        this.super.init();
        _winlinesAddon = nge.findOne('^winlinesAddon');
        _gambleScreen = nge.findOne('^gambleScreen');
        _gambleScreen.visible = false;
        _cfg = this.getInstance('CfgMode').get();
    };
    
    this.showGambleScreen = function () {
        this.toggleSlotMachine(false);
        _gambleScreen.y = _cfg.from;
        _gambleScreen.visible = true;
        if(_tween)
            _tween.stop();
        _tween = nge.game.add.tween(_gambleScreen).to({ y: _cfg.to }, _cfg.tweenDuration, Phaser.Easing.Linear.None, false);
        _tween.start();
        _winlinesAddon.visible = false;
    };

    this.showSlotMachine = function () {
        this.toggleSlotMachine(true);
        _gambleScreen.y = _cfg.to;
        if(_tween)
            _tween.stop();
        _tween = nge.game.add.tween(_gambleScreen).to({ y: _cfg.from }, _cfg.tweenDuration, Phaser.Easing.Linear.None, false);
        _tween.onComplete.add(function () {
            _gambleScreen.visible = false;
        });
        _tween.start();
        _winlinesAddon.visible = true;
    };
};



