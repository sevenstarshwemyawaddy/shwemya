nge.App[nge.appNS].Com.Jackpot.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _service;

    var _updateTimer = function(deltaTime){
        var inProgress = nge.localData.get('jackpot.inProgress');
        
        if(inProgress)
            _service.updateTimer(deltaTime);
    };
    
    this.update = function(deltaTime){
        _updateTimer(deltaTime.deltaT);
    }; 

    this.customSubscribe = function(){};

    var _jackpotPlayResponseHandler = function(data){
        _service.showSymbol(data);
    };

    var _symbolPressedHandler = function(index){
        nge.observer.fire('jackpot.playRequest', index);
    };

    this.initLayers = function(){
        _service = this.getInstance('Service');
        _service.init();
    };

    var _showJackpot = function(){
        _service.showJackpotLayer();
    };

    var _hideJackpot = function(){
        _service.hideJackpotLayer();
    };

    var _forceClose = function() {
        _service.clear();
        nge.observer.fire('jackpot.end');
        nge.statesManager.display('play');
    };

    var _subscribe = function(){
        nge.observer.add('jackpot.showLayer', _showJackpot);
        nge.observer.add('jackpot.hide', _hideJackpot);
        nge.observer.add('jackpot.forceClose', _forceClose);
        nge.observer.add('jackpot.pressedSymbol', _symbolPressedHandler);
        nge.observer.add('jackpot.playResponse', _jackpotPlayResponseHandler);

        this.customSubscribe();
    }.bind(this);


    this.create = function () {
        this.createDefault();
 
        this.initLayers();

        if(!_created)
            _subscribe();

        _created = true;
        return true;
    };
});



nge.App[nge.appNS].Com.Jackpot.Service = nge.Com.Base.extend(function () {
    var _view;
    var _ms = 0; 

    this.maxSeconds = 90;

    this.init = function(){
        _view = this.getInstance('View');
        _view.init();
    };

    this.updateTimer = function(deltaTime){
        
        // using for timer correction on first update call
        if(_ms++ === 0) 
            return; 

        _ms += deltaTime;
        var seconds = Math.floor(_ms/1000);

        var totalSecondsLeft = this.maxSeconds - seconds;
        
        _view.updateTimer(totalSecondsLeft);

        if(seconds >= this.maxSeconds)
            _view.showSymbolsOnTimeFinish();
    };

    this.showJackpotLayer = function(){
        _ms = 0;
        _view.showJackpotPopup();
        nge.observer.fire('jackpot.show');
    };

    this.showSymbol = function(data){
        _view.showSymbol(data);
    };

    this.hideJackpotLayer = function(){
        _view.hideJackpotLayer();
    };

    this.clear = function(){
        _view.clear();
    };
});



