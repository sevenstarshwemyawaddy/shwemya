nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.Controller = Class.extend(function () {

    var _buttonsWasCreated = false;
    var _manager = null;
    var _applyUpdates = false;
    /**
     *  Buttons logic based on three main objects: State, Action and ButtonState.
     * 
     *  State - describes current slotMachine state (general spin, freespin, 
     *          gamble, etc.) and contains a set of actions.
     * 
     *  Action - describes buttons behavior and depends on current action. Each action 
     *           may content a buttonStates. If actinon doesn't contain button 
     *           or any buttons, logic will apply defaultBtnState of cfg.js file to 
     *           that buttons.
     * 
     *  ButtonState - describes a button props for current action.
     * 
     *  All states must inherit from BaseState.
     *  Any logic that can be used in many states must be described in BaseState.
     */

    // array of events to update button state
    this.updateButtonStateOnEvents = [
        'slotMachine.spinCommand',
        'slotMachine.spinStart',
        'slotMachine.stopCommand',
        'slotMachine.spinComplete',
        'slotMachine.spinResponse',
        'transportMessage.BalanceResponse',
        'winlines.animateByOne.cycleComplete',
        'winlines.animateByOne.cycleComplete.firstTime',
        'gamble.go',
        'gamble.take',
        'gamble.taking.stop',
        'paytable.show',
        'paytable.hide',
        'betSettings.show',
        'betSettings.hide',
        'freespin.start',
        'buttons.freespinStart',
        'freespin.press.spinButton',
        'buttons.freespinContinue',
        'popupFinish.animate.stop',
        'popupFinish.animate.start',
        'gamble.actionRequest',
        'buttons.gamble.restore',
        'autospinSimple.on',
        'autospinSimple.off',
        'offers.list.apply',
        'offers.result.goToGame',
        'offers.list.later'
    ];

    this.init = function(scene){
        this.destroyManager();

        _manager = nge.App.getInstance('Mlm.Brain.ButtonsNewLogic.Manager');
        _manager.configure(scene);
        nge.observer.fire('buttons.updateState');
    };

    this.destroyManager = function(){
        if(_manager)
            _manager.destroy();
    };

    this.updateOnEvents = function(){
        
        var callback = function(){
            nge.observer.fire('buttons.updateState');
        };

        var subscribe = function(eventName){
            nge.observer.add(eventName, callback, false, true);
        };
        
        this.updateButtonStateOnEvents.forEach(subscribe);
    };

    this.buttonsCreateEndHandler = function(){
        _buttonsWasCreated = true;
    };
    
    this.sceneCreateEndHandler = function(scene){
        _applyUpdates = true;
        
        if(!_buttonsWasCreated) return;

        this.init(scene); 
    };
    
    this.buttonsUpdateStateHandler = function(){
        if(_buttonsWasCreated && _applyUpdates)
            _manager.update();
        
        _applyUpdates = _buttonsWasCreated;
    };

    var _printStatus = function(){
        if(_buttonsWasCreated)
            _manager.printStatus();
    };

    this.onTransportClose = function(){
        _buttonsWasCreated = false;
        _applyUpdates = false;
    };

    this.sceneCreateStartHandler = function(){
        _buttonsWasCreated = false;
    };

    this.subscribe = function () {
        nge.observer.add('buttons.printStatus', _printStatus, false, true);
        nge.observer.add('buttons.updateState', this.buttonsUpdateStateHandler, false, true);
        nge.observer.add('StatesManager.display.start', this.sceneCreateStartHandler, false, true);
        nge.observer.add('StatesManager.create.end', this.sceneCreateEndHandler, false, true);
        nge.observer.add('buttons.create.end', this.buttonsCreateEndHandler, false, true);
        nge.observer.add('Transport.close', this.onTransportClose, false, true);
        this.updateOnEvents();
    };
});



nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.Manager = Class.extend(function () {

    // flag enables force state update on update func call even if state is't valid
    this.forceCurrStateUpdate = false;

    var _states = null;
    var _currState = null;
    var _parser = null;

    var instancesEnum = {
        parser: 'Parser'
    };

    var _isMobileView = function(){ 
        return nge.Lib.Helper.mobileAndTabletCheck();
    };

    var _getInstanceOf = function(instanceName){
        return nge.App.getInstance('Mlm.Brain.ButtonsNewLogic.' + instanceName);
    };

    var _findStateByName = function (stateName) {
        var newState = null;
        _states.forEach(function (item) {
            if (item.getName() === stateName)
                newState = item;
        });

        return newState;
    };

    var _getCfgPath = function(){
        var isMobileView = _isMobileView();
        var pathPart = isMobileView ? '.Mobile' : '';
        return nge.App.getInstance('Mlm.Brain' + pathPart + '.ButtonsNewLogic.Cfg');
    };

    this.configure = function (scene) {
        var cfg = _getCfgPath();
        var isMobileView = _isMobileView();

        _parser = _getInstanceOf(instancesEnum.parser);
        _parser.configure(cfg, isMobileView);
        _states = _parser.buildStates(scene);
    };

    this.destroy = function(){
        _parser.destroy();
    };

    var _getDefaultState = function (currScene) {
        var defaultStateName = _parser.getDefaultStateName(currScene);
        return _findStateByName(defaultStateName);
    };

    var _findStateFromNamesArr = function(namesArr){
        var nextState = null;

        for(var i = 0; i < namesArr.length; i++) {
            var tempState = _findStateByName(namesArr[i]);
            
            if (tempState && tempState.isValid()){
                nextState =  tempState;
                break;
            }
        }

        _currState = nextState || _currState;
        return !!nextState;
    };

    var _findNextRouteState = function(currScene){
        var allStates = _parser.getSlotMachineStates(currScene);
        var allStateNames = allStates[_currState.getName()];

        return !allStateNames ? false : _findStateFromNamesArr(allStateNames);
    };

    var _getNextGlobalState = function(currScene){
        var allStates = _parser.getSlotMachineStates(currScene);
        var allStateNames = Object.getOwnPropertyNames(allStates).reverse();

        return _findStateFromNamesArr(allStateNames);
    };

    var _findNextState = function () {
        var currScene = nge.statesManager.getCurrentName();
        var stateUpdated = false;

        if(!_currState)
            stateUpdated = _getNextGlobalState(currScene);

        if(!_currState)
            _currState = _getDefaultState(currScene);

        if(!stateUpdated)
            _findNextRouteState(currScene);

        _currState.reset();
    };

    var _checkForForceState = function(){
        var forceState;

        var currStateName = _currState.getName();
        var currScene = nge.statesManager.getCurrentName();
        var allStates = _parser.getSlotMachineStates(currScene);
        var newStatesNames = allStates[currStateName];

        if(!newStatesNames)
            return _currState;

        var forceStateNames = newStatesNames.filter(function(stateName){
            return stateName.indexOf('@') !== -1;
        });

        forceStateNames.forEach(function(forceStateName){
            var newStateName = forceStateName.replace('@', ''); 
            var newState = _findStateByName(newStateName);

            if(newState.isValid())
                forceState = newState;
            
            return null;
        }); 

        _currState = forceState ? forceState : _currState;
    };

    var _updateState = function () {

        if (!_currState)
            _findNextState();

        var canGoNext = _currState.canGoNext();
        var isValid = _currState.isValid();
        var isForceSwitchAvail = _currState.isForceSwitchAvail();

        if(canGoNext && !isForceSwitchAvail) {
            _currState.update();
        } else {
            if(isValid && isForceSwitchAvail) {
                _checkForForceState();
            } else if(!isValid && !canGoNext) {
                _findNextState();
            }

            if(_currState.isValid() || this.forceCurrStateUpdate) {
                _currState.update();
            }
        }
        // this.printStatus(true);
    }.bind(this);

    this.printStatus = function (onlyCurrState) {
        log('\n');
        log('------------BUTTONS LOGIC------------');
        log('CURRENT STATE NAME: %c ' + _currState.getName() + ' ', 'color:#fff;background:#0080FF;');
        if(onlyCurrState)
            return _currState.printStatus(onlyCurrState);
       
        _states.forEach(function (state) {
            state.printStatus();
        });

        log('-------------------------------------');
        log('\n');
    };

    this.update = function () {
        _updateState();
    };
});



nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.Parser = Class.extend(function () {
    var _cfg = null;
    var _isMobileView = false;

    var _statesCache = {};

    var instancesEnum = {
        action: 'Action',
        buttonState: 'ButtonState',
        state: 'State'
    };

    var buttonStatesEnum = {
        gereric: 'buttons',
        shared: 'sharedButtons'
    };

    var _getInstanceOf = function(instanceName, isMobileView){
        var pathPart = isMobileView ? '.Mobile' : '';
        var path = 'Mlm.Brain'+ pathPart +'.ButtonsNewLogic.' + instanceName;
        return nge.App.getInstance(path);
    };

    var _getClone = function (obj) {
        return nge.Lib.Helper.jsObjClone(obj);
    };

    var _capitalize = function (str) {
        return nge.Lib.Helper.capitaliseFirstLetter(str.toLowerCase());
    };

    var _getStateName = function(rawName){
        var name = rawName.replace('?', '');
        var strArr = name.split('_');
        var callbackName = '';

        strArr.forEach(function (str) {
            callbackName += _capitalize(str);
        });

        return callbackName;
    };

    var _getStateInstance = function(stateName){
        var instancePath = 'States.' + _getStateName(stateName) + 'State';
        return _getInstanceOf(instancePath, _isMobileView);
    };
    
    var _findCallbackHandlerName = function (rawName) {
        var name = rawName.replace('?', '');
        var strArr = name.split('_');
        var callbackName = 'on';

        strArr.forEach(function (str) {
            callbackName += _capitalize(str);
        });

        return callbackName;
    };

    var _removeNullFromArr = function(arr){
        var removeNull = function(state){
            return !!state;
        };
        return arr.filter(removeNull);        
    };

    var _createState = function (name, stateData) {
        var callbackHandler = stateData.validityCheckHandler;
        var actionOrder = stateData.model.order;
        var stateResetCallback = stateData.stateResetHandler;
        
        var state = _getInstanceOf(instancesEnum.state);
        state.init(name, callbackHandler, actionOrder, stateResetCallback);

        return state;
    };

    var _createAction = function (actionName, actionUpdateHandlers, additionalHandlers) {
        var callbackHandlerName = _findCallbackHandlerName(actionName);
        
        var callbackHandler = actionUpdateHandlers[callbackHandlerName] || function () {};
        var beforeUpdateHandler = additionalHandlers.beforeUpdateHandler[callbackHandlerName] || function () {};
        var afterUpdateHandler = additionalHandlers.afterUpdateHandler[callbackHandlerName] || function () {};

        var action = _getInstanceOf(instancesEnum.action);
        action.init(actionName, callbackHandler, beforeUpdateHandler, afterUpdateHandler);

        return action;
    };

    var _createActions = function (stateName, stateData) {
        var actionNames = stateData.model.order;
        var actionUpdateHandlers = stateData.actionUpdateHandlers || {};

        var additionalHandlers = {
            beforeUpdateHandler: stateData.beforeUpdateHandlers,
            afterUpdateHandler: stateData.afterUpdateHandlers
        };

        var actions = actionNames.map(function(actionName){
            return _createAction(actionName, actionUpdateHandlers, additionalHandlers);
        });

        return actions;
    };

    var _getButtonStateData = function (actionName, buttonName, stateData) {
        var btnData = stateData.model.actions[actionName][buttonName];

        if (btnData)
            return _getClone(btnData);

        return _cfg.defaultBtnState;
    };

    var _createButtonStates = function (actionName, stateData, btnType) {
        var currDisplayState = nge.statesManager.getCurrentName();
        var buttonCfgNames = Object.getOwnPropertyNames(_cfg[btnType][currDisplayState]);  

        if(!buttonCfgNames || !buttonCfgNames.length)
            return [];

        var buttonStates = buttonCfgNames.map(function (buttonCfgName) {
            var btnCfg = _cfg[btnType][currDisplayState][buttonCfgName];
            var rawData = _getButtonStateData(actionName, buttonCfgName, stateData);
            
            var updateHandlers = {
                propUpdateHandlers: stateData.propUpdateHandlers,
                callbackHandlers: stateData.callbackHandlers
            };
            
            var buttonState = _getInstanceOf(instancesEnum.buttonState);
            buttonState.init(btnCfg, rawData, updateHandlers);
            return buttonState;
        });
        return buttonStates;
    };

    var _getSharedState = function(stateName){
        var sharedStateNames = _cfg.sharedStates[stateName];
       
        if(!sharedStateNames) return null;

        return _getStateInstance(sharedStateNames[0]);
    };

    var _mergeProps = function(objTo, objFrom){
        objTo.propUpdateHandlers = nge.Lib.Helper.mergeObjsRecursive(objTo.propUpdateHandlers, objFrom.propUpdateHandlers);
    };

    var _buildState = function(stateName){
        var stateData = _getStateInstance(stateName);
        var currDisplayState = nge.statesManager.getCurrentName();
        var buttonsCfg = nge.App.getInstance('Com.Buttons.Cfg');
        var buttons = buttonsCfg[currDisplayState];
        
        if(!buttons)
            buttons = buttonsCfg.params;

        if(!stateData){
            console.error('State', stateName, 'was not created! State file was not found!');
            return null;
        }

        if(!_statesCache[currDisplayState])
            _statesCache[currDisplayState] = {};

        if(!_statesCache[currDisplayState].sharedState){
            var tempStaredState = _getSharedState(currDisplayState);

            if(tempStaredState){
                tempStaredState.init(_cfg[buttonStatesEnum.shared][currDisplayState]);
                _statesCache[currDisplayState].sharedState = tempStaredState;
            }   
        } 
        
        var sharedState = _statesCache[currDisplayState].sharedState;

        if(sharedState){
            var sharedActionName = sharedState.model.order[0];
            _mergeProps(stateData, sharedState);
        }
        
        _statesCache[currDisplayState][stateName] = stateData;
        stateData.init(buttons);

        var state = _createState(stateName, stateData);
        var actions = _createActions(stateName, stateData);
    
        actions.forEach(function(action){
            var actionName = action.getName();
            var buttonStates = _createButtonStates(actionName, stateData, buttonStatesEnum.gereric);
            if(sharedState){
                var sharedButtonStates = _createButtonStates(sharedActionName, sharedState, buttonStatesEnum.shared);
                buttonStates.push.apply(buttonStates, sharedButtonStates);
            }

            action.addButtonStates(buttonStates);
        });

        state.addActions(actions);
        return state;
    };

    var _buildStates = function (sceneName) {
        var stateNames = this.getStateNames(sceneName);
        var states = stateNames.map(_buildState);

        return _removeNullFromArr(states);
    }.bind(this);

    this.destroy = function(){
        for(var sceneName in _statesCache){
            for(var stateName  in _statesCache[sceneName])
            {
                _statesCache[sceneName][stateName].destroy();
            }
        }

        _statesCache = {};
    };

    this.buildStates = function (scene) {
        return _buildStates(scene);
    };

    this.getDefaultStateName = function (sceneName) {
        var slotMachineStates = _cfg.slotMachineStates[sceneName];
        var stateNames = Object.getOwnPropertyNames(slotMachineStates);
        return stateNames[0];
    };
    
    this.configure = function (cfg, isMobileView) {
        _cfg = cfg;
        _isMobileView = isMobileView;
    };

    this.getStateNames = function (sceneName) {
        return Object.getOwnPropertyNames(_cfg.slotMachineStates[sceneName]);
    };

    this.getSlotMachineStates = function(sceneName){
        return _cfg.slotMachineStates[sceneName];
    };
});



nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.State = Class.extend(function () {
    var _name = null;
    var _callbackChecker = null;
    var _actions = null;
    var _currentAction = null;
    var _actionOrder = null;
    var _stateResetCallback = null;

    this.init = function (name, callbackCkecker, actionOrder, stateResetCallback) {
        _name = name;
        _callbackChecker = callbackCkecker;
        _actionOrder = actionOrder;
        _stateResetCallback = stateResetCallback;
    };

    var _findActionByName = function(actionName){
        var searchedAction = _actions.filter(function(action){
            return action.getName() === actionName;
        });    
        
        if(!searchedAction || !searchedAction[0])
            return false;

        return searchedAction[0];
    };

    var _resetCurrentAction = function () {
        var firstAction = null;

        _actionOrder.forEach(function(actionName){
            var tempAction = _findActionByName(actionName);

            if((!tempAction.isOptional() || tempAction.isValid()) && !firstAction)
                firstAction = tempAction;              
        });
        
        _currentAction = firstAction || _actions[0];
    };

    var _getNextValidActionIndex = function(){
        var newIndex = -1;

        var currActionIndex = _actions.indexOf(_currentAction);

        for (var index = ++currActionIndex; index < _actions.length; index++) {

            var nextAction = _actions[index];
            if (nextAction.isValid()) {
                newIndex = index;
                break;
            }

            if (!nextAction.isValid() || !nextAction.isOptional())
                continue; //?
        }
        return newIndex;
    };

    var _checkOrderHasNextNonOptionalActions = function(fromIndex){
        var itHas = false;
        
        for (var index = ++fromIndex; index < _actions.length; index++) {
            
            if(!_actions[index].isOptional()){
                itHas = true;   
                break;
            }
        }

        return itHas;
    };

    var _getNextValidAction = function () { 
        var index = _getNextValidActionIndex();
        
        if(index > 0)
            return _actions[index];

        return _currentAction;
    };

    var _checkForOptionalActions = function(){
        _actionOrder = _actionOrder.map(function(actionName){

            var isOptional = actionName.indexOf('?') !== -1;
            var normalizedName = actionName.replace('?', '');
            var action = _findActionByName(normalizedName);

            if(action)
                action.setOptional(isOptional);
            
            return normalizedName;
        });
    };

    this.getName = function () {
        return _name;
    };

    this.isValid = function () {
        return _callbackChecker();
    };

    this.canGoNext = function(){

        var currActionName = _currentAction.getName().replace('?', '');   
        var currIndex = _actionOrder.indexOf(currActionName);     
        
        var isValid = _currentAction.isValid();
        var isLast = currIndex === _actionOrder.length - 1;
        var hasNonOptional = _checkOrderHasNextNonOptionalActions(currIndex);

        return isValid && !isLast && hasNonOptional;
    };

    this.isForceSwitchAvail = function(){
        var firstAction = null;
        
        _actionOrder.forEach(function(actionName){
            var tempAction = _findActionByName(actionName);
            
            if(!tempAction.isOptional() && !firstAction)
                firstAction = tempAction;

        });
        
        var isFirstAction = _currentAction === firstAction;

        return isFirstAction;
    };

    this.printStatus = function (onlyCurrState) {
        
        if (this.isValid())
            log('%c STATUS NAME: ' + _name + ' VALID ', 'color:#fff;background:#0B6623;');
        else
            log('STATUS NAME: ' + _name);
        
        if(onlyCurrState)
            return _currentAction.printStatus();
    
        _actions.forEach(function (action) {
            action.printStatus();
        });
    };

    this.addActions = function (actions) {
        _actions = actions;
        _checkForOptionalActions();
        _resetCurrentAction();
    };

    this.update = function () {
        var curActionIsValid = _currentAction.isValid();
    
        if (!curActionIsValid)
            _currentAction = _getNextValidAction();
        _currentAction.update();
    };

    this.reset = function(){
        _resetCurrentAction();
        _stateResetCallback();
    };
});




