    /**
     * apply var or array of vars to function
     * @param {Mixed} vars
     * @param {Function} callback
     * @returns {Boolean}
     */
    varOrArrOfVarsChk: function (vars, callback) {
        if (Object.prototype.toString.call(vars) === '[object Array]') {
            for (var i = 0; i < vars.length; i++) {
                callback(vars[i]);
            }

            return false;
        }

        callback(vars);
        return true;
    },
    /**
     * arguments {oblect} (ClassInstance, functionName, param1, param2, ...)
     * needs {Object} obj._logicBlocks;
     * creates {Object} obj._logicBlocksInstances;
     * @returns {Array|nge.Lib.Helper.do.results}
     */
    logicBlocksDo: function () {
        var params = Array.prototype.slice.call(arguments);
        var entity = params.shift();
        var funcName = params.shift();

        //if no instances we will create them
        if (!entity._logicBlocksInstances) {
            entity._logicBlocksInstances = {};
            for (var k in entity._logicBlocks) {
                var name = entity._logicBlocks[k];
                var nameCap = nge.Lib.Helper.capitaliseFirstLetter(name);
                entity._logicBlocksInstances[name] = entity.getInstance(nameCap);
            }
        }

        var results = [];
        //game
        for (var name in entity._logicBlocksInstances) {
            if (entity._logicBlocksInstances[name][funcName]) {
                var res = entity._logicBlocksInstances[name][funcName].apply(this, params);
                results.push(res);
            }
        }

        return results;
    },
    /**
     * find key in object for searching element in function
     * @param {Object} obj
     * @param {Function} func
     * @returns {string|Boolean} element key or boolean
     */
    objFind: function (obj, func) {
        for (var k in obj) {
            var res = func(obj[k], k, obj);
            if (res)
                return k;
        }

        return false;
    },
    /**
     * find element in object
     * @param {Object} obj
     * @param {Function} func
     * @returns {string|Boolean} element key or boolean
     */
    objFindEl: function (obj, func) {
        var k = nge.Lib.Helper.objFind(obj, func);

        if (k)
            return obj[k];

        return undefined;
    },
    /**
     * функция для сложного рекурсивного поска по обьектам
     * @param {mixed} key  val1.val2.val3 || [val1, val2, val3]
     * @param {mixed} value
     * @param {String} childrenKeyName
     * @param {Object} parent
     * @param {Boolean} incompleteCompliance
     * @param {Boolean} findOne
     * @param {Boolean} eject
     * @returns {mixed}
     */
    customRecursiveFind: function (key, value, childrenKeyName, parent, incompleteCompliance, findOne, eject) {
        var arr = [];

        var removeEmpty = function (arr) {
            var filtered = arr.filter(function (el) {
                return el !== undefined && el !== null;
            });

            return filtered;
        };

        var f = function (els, n) {
            for (var k in els) {
                var el = els[k];
                var elVBK = nge.Lib.Helper.recursiveGet(key, el); //value by key

                if (
                    elVBK &&
                    (
                        elVBK === value ||
                        (incompleteCompliance && elVBK.indexOf(value) !== -1)
                        )
                    ) {
                    if (eject)
                        delete els[k];

                    if (findOne)
                        return el;
                    else
                        arr.push(el);
                }

                if (el[childrenKeyName] && el[childrenKeyName].length > 0)
                {
                    var res = f(el[childrenKeyName], n);
                    if (res)
                        if (eject)
                            el[childrenKeyName] = removeEmpty(el[childrenKeyName]);

                    if (findOne && res)
                        return res;
                    else
                        arr.concat(res);
                }
            }

            return (findOne) ? false : arr;
        };

        return f([parent], value) || false;
    },

    /**
     * checkSuffix('asdasdasd_button', '_button'))
     * @param {String} str
     * @param {String} suffix
     * @returns {Boolean}
     */
    checkSuffix: function (str, suffix) {
        var match = str.match(suffix + "$");

        if (match && match[0])
            return match[0] === suffix;

        return false;
    },
    /**
     * get Suffix
     * @param {String} str   //'asdasdasd_button'
     * @returns {String} //'_button'
     */
    getSuffix: function (str) {
        var array = str.split('_');
        return (array.length > 1) ? array[(array.length - 1)] : false;
    },
    /**
     * up chances of object to be getted by garbage collector
     * @param {Object} obj
     * @param {Boolean} phaserObjectFlag
     * @returns {undefined}
     */
    objectDelete: function (obj, phaserObjectFlag) {
        if (phaserObjectFlag) {
            obj.destroy(true);
            obj.game = false;
        }

        obj = null;
        //delete obj;
        return null;
    },
    /**
     * waitForWebfontsLoading
     * @param {Object} fonts  //array of fonts names
     * @param {Function} callback
     * @returns {undefined}
     */
    waitForWebfonts: function (fonts, callback) {
        var waitForFont = function (font) {
            var deferred = $.Deferred();
            var node = document.createElement('span');
            node.innerHTML = 'giItT1WQy@!-/#';
            node.style.position = 'absolute';
            node.style.left = '-10000px';
            node.style.top = '-10000px';
            node.style.fontSize = '300px';
            node.style.fontFamily = 'sans-serif';
            node.style.fontVariant = 'normal';
            node.style.fontStyle = 'normal';
            node.style.fontWeight = 'normal';
            node.style.letterSpacing = '0';
            document.body.appendChild(node);

            var beforewidth = node.offsetWidth;
            node.style.fontFamily = font;

            var condition = function () {
                if (!node)
                    return true;

                if (node.offsetWidth === beforewidth)
                    return false;

                node.parentNode.removeChild(node);
                node = null;
                return true;
            };

            var checkerCallback = function () {
                deferred.resolve(font);
            };

            nge.Lib.Checker.delay(condition, checkerCallback, 500, 20, true);
            return deferred;
        };

        var promises = [];
        for (var i = 0; i < fonts.length; i++) {
            promises.push(waitForFont(fonts[i]));
        }

        $.when.apply($, promises).then(function () {
            callback();
        });
    },
    /**
     * check is Font Available //at first call function generates and makes first call
     * @param {String} fontFamily  //array of fonts names
     * @returns {Boolean}
     */
    isFontAvailable: (function () {

        var generateFunction = function () {
            var width;
            var body = document.body;

            var container = document.createElement('span');
            container.innerHTML = Array(100).join('wi');
            container.style.cssText = [
                'position:absolute',
                'width:auto',
                'font-size:128px',
                'left:-99999px'
            ].join(' !important;');

            var getWidth = function (fontFamily) {
                container.style.fontFamily = fontFamily;

                body.appendChild(container);
                width = container.clientWidth;
                body.removeChild(container);

                return width;
            };

            // Pre compute the widths of monospace, serif & sans-serif
            // to improve performance.
            var monoWidth = getWidth('monospace');
            var serifWidth = getWidth('serif');
            var sansWidth = getWidth('sans-serif');

            var checked = [];

            return function (font) {
                if (checked.indexOf(font) !== -1)
                    return true;

                var res = monoWidth !== getWidth(font + ',monospace') ||
                    sansWidth !== getWidth(font + ',sans-serif') ||
                    serifWidth !== getWidth(font + ',serif');

                if (res)
                    checked.push(font);

                return res;
            };
        };

        if (document.body)
            return generateFunction();
        else
            document.addEventListener("DOMContentLoaded", function () {
                nge.Lib.Helper.isFontAvailable = generateFunction();
            });

    })(),
    /**
     *
     * @param {String} filename
     * @param {String} filetype
     * @param {Function} callback
     * @returns {undefined}
     */
    loadJsCssFile: function (filename, filetype, callback) {
        if (filetype === "js") { //if filename is a external JavaScript file
            var fileref = document.createElement('script');
            fileref.setAttribute("type", "text/javascript");
            fileref.setAttribute("src", filename);
        } else if (filetype === "css") { //if filename is an external CSS file
            var fileref = document.createElement("link");
            fileref.setAttribute("rel", "stylesheet");
            fileref.setAttribute("type", "text/css");
            fileref.setAttribute("href", filename);
        }

        if (fileref && callback)
            fileref.onload = fileref.onreadystatechange = callback;


        if (typeof fileref !== "undefined")
            document.getElementsByTagName("head")[0].appendChild(fileref);
    },
    /**
     * get max document Z index
     * @returns {Number}
     */
    getMaxZIndex: function () {
        return Math.max.apply(null,
            $.map($('body *'), function (e, n) {
                if ($(e).css('position') !== 'static')
                    return parseInt($(e).css('z-index')) || 1;
            }));
    },
    /**
     * makes objects key reactive
     * @param {Object} obj
     * @param {String} key
     * @param {Function} callback
     * @returns {Boolean}
     */
    makeReactive: function (obj, key, callback) {
        var targetObject = obj;
        var descriptor = Object.getOwnPropertyDescriptor(targetObject, key);

        while (!descriptor && targetObject.__proto__) {
            targetObject = targetObject.__proto__;
            var descriptorTemp = Object.getOwnPropertyDescriptor(targetObject, key);

            if (descriptorTemp && (descriptorTemp.value || descriptorTemp.set || descriptorTemp.get))
                descriptor = descriptorTemp;
        }

        if (!descriptor)  // bad descriptors and its IOS mobile
            return false;

        var setter = descriptor.set;

        descriptor.set = function (v) {
            if (setter)
                setter.call(obj, v);

            callback.call(obj, v);
        };

        Object.defineProperty(obj, key, descriptor);
        return true;
    },
    /**
     * check if value is number
     * @param {mixed} n
     * @returns {Boolean}
     */
    isNumeric: function (n) {
        if (n.match(/^-{0,1}\d+$/)) {
            return true;
        } else if (n.match(/^-{0,1}\d+\.\d+$/)) {
            return true;
        }

        return false;
    },
    /**
     * check if text is JSON
     * @param {String} text
     * @returns {Boolean}
     */
    isTextJson: function (text) {
        try {
            JSON.parse(text);
        } catch (e) {
            return false;
        }
        return true;
    },
    isBase64: function (str) {
        if (str === '' || str.trim() === '') {
            return false;
        }

        if (str.indexOf('data:image') === 0) {
            return true;
        }

        try {
            return btoa(atob(str)) === str;
        } catch (err) {
            return false;
        }
    }
};



nge.Lib.I18n = function (project) {
    var _storage = {};

    var _curSettings = {
        lang: false,
        project: false
    };

    this.get = function (text, params) {
        var text = _storage[text] || text;
        return _applyTextParams(text, params);
    };

    this.applyTextParams = function (text, params) {
        return _applyTextParams(text, params);
    };

    this.setStorage = function (o) {
        _storage = o;
    };

    this.update = function (project) {
        _loadI18nAppOnly(project);
    };

    var _loadI18nGlobalAndApp = function () {
        _loadI18n(
            'i18n/' + nge.Cfg.Main.lang + '.json',
            function () {
                _loadI18n(
                    nge.appPath + '/i18n/' + nge.Cfg.Main.lang + '.json?gameVersion=' + gameVersion,
                    function () {
                        nge.observer.fire('i18n.update');
                    }
                );
            }
        );
    };

    var _loadI18nAppOnly = function (project) {
        if (!project)
            project = nge.Cfg.Main.project;

        if (nge.Cfg.Main.lang === _curSettings.lang && _curSettings.project === project)
            return false;

        _loadI18n(
            nge.appPath + '/i18n/' + nge.Cfg.Main.lang + '.json?gameVersion=' + gameVersion,
            function () {
                nge.observer.fire('i18n.update');
            }
        );

        _curSettings.lang = nge.Cfg.Main.lang;
        _curSettings.project = nge.Cfg.Main.project;
    };

    var _loadI18n = function (path, callback) {
        var realPath = nge.realPathPrefix + path;

        $.getJSON(realPath, function (data) {
            nge.i18n.setStorage(data);
            if (callback)
                callback();
        });
    };

    var _applyTextParams = function (message, params) {
        for (var k in params) {
            message = nge.Lib.Helper.strReplace(
                '%(' + k + ')s',
                params[k],
                message);
        }
        return message;
    };

    _loadI18nAppOnly(project);
};



nge.Lib.Keyboard = Class.extend(function () {
    var _pressed = [];
    var _cfg = {
        '1': {key: 49},
        '2': {key: 50},
        '3': {key: 51},
        'CTRL': {key: 17},
        'SHIFT': {key: 16},
        'ALT': {key: 18},
        'D': {key: 68},
        'M': {key: 77},
        'N': {key: 78},
        'O': {key: 79},
        'Q': {key: 81},
        'SPACE': {key: 32}
    };

    this.constructor = () => {
        _subscribe();
    };

    this.check = (e) => {
        return _pressed.indexOf(e) !== -1 ? true : false;
    };

    var _subscribe = () => {
        _setButtonsHandler('keydown', _handlerDown);
        _setButtonsHandler('keyup', _handlerUp);

        return true;
    };

    var _setButtonsHandler = (jqHandler, handler) => {
        $(document)[jqHandler](function (e) {
            var k = nge.Lib.Helper.objFind(
                _cfg,
                function (button) {
                    return button.key === e.which;
                }
            );

            if (k)
                handler(k);
        });
    };

    var _handlerDown = (k) => {
        if (_pressed.indexOf(k) === -1) {
            _pressed.push(k);
            nge.observer.fire('keyboard.KeyDown', k);
            nge.observer.fire('keyboard.KeyDown.' + k);
        }
        return true;
    };
    var _handlerUp = (k) => {
        var i = _pressed.indexOf(k);

        if (i !== -1)
            _pressed.splice(i, 1);

        return true;
    };
});



nge.Lib.Math = {
    linear: function(p0, p1, t) {
        return (p1 - p0) * t + p0;
    },
    /**
     * float Round (1.99999999999 ~ 2)
     * @param {Number} a
     * @returns {Number}
     */
    floatRound: function (a) {
        return Math.ceil(1e4 * a) / 1e4;
    },
    /**
     * 
     * @param {Number} v
     * @param {Number} min
     * @param {Number} max
     * @returns {Number}
     */
    valBetween: function (v, min, max) {
        return (v < min) ? min : (v > max) ? max : v;
    },
    /**
     * Механизм перещения объектов по кривой Безье, состоящей из трёх контрольных точек
     * @param {Sprite} target - перемещаемый объект
     * @param {float} time - время в миллисекундах
     * @param {Point} from - начальная точка
     * @param {Point} control - опорнная точка
     * @param {Point} to - конечная точка
     * @returns {Object}
     */
    bezier: function(target, time, from, control, to) {
        return {
            onComplete: new nge.Lib.Signal(),
            onUpdate: new nge.Lib.Signal(),
            target: target,
            time: time,
            p1: from,
            p2: control,
            p3: to,
            running: false,
            _at: function(time) {
                var x = (Math.pow(1 - time, 2) * this.p1.x) + (2 * (1 - time) * time * this.p2.x) + (Math.pow(time, 2) * this.p3.x);
                var y = (Math.pow(1 - time, 2) * this.p1.y) + (2 * (1 - time) * time * this.p2.y) + (Math.pow(time, 2) * this.p3.y);
                return {x: x, y: y};
            },
            _moveTo: function(time) {
                this.target.position = this._at(time);
                this.onUpdate.dispatch(this._at(time));
            },
            start: function() {
                if(this.running || !this.target)
                    return false;

                this.current = 0;
                this.running = true;
            },
            stop: function() {
                this.running = false;
                this.onComplete.dispatch();
            },
            update: function(deltaTime) {
                if(!this.running)
                    return;

                this.current = nge.Lib.Math.clamp(this.current + deltaTime, 0, this.time);
                this._moveTo(this.current / this.time);
                if(this.current >= this.time)
                    this.stop();
            }
        };
    },
    /**
     * Интерполяция цвета
     * @param from - начальный цвет
     * @param to - конечный цвет
     * @param percent - процент интеполяции
     * @returns {*} - интерполированный цвет
     */
    interpolateColor: function(from, to, percent) {
        if(from === to)
            return from;

        var src1 = nge.Lib.Math.getRGB(from);
        var src2 = nge.Lib.Math.getRGB(to);

        var r = ((src2.red - src1.red) * percent) + src1.red;
        var g = ((src2.green - src1.green) * percent) + src1.green;
        var b = ((src2.blue - src1.blue) * percent) + src1.blue;
        return 0xFFFFFF + nge.Lib.Math.getColor32(255, r, g, b);
    },
    clamp: function(value, min, max) {
        return Math.max(min, Math.min(max, value));
    },
    clampBottom: function(value, min) {
        return Math.max(min, value);
    },
    getRGB: function (color) {
        if (color > 16777215) {
            //  The color value has an alpha component
            return {
                alpha: color >>> 24,
                red: color >> 16 & 0xFF,
                green: color >> 8 & 0xFF,
                blue: color & 0xFF,
                a: color >>> 24,
                r: color >> 16 & 0xFF,
                g: color >> 8 & 0xFF,
                b: color & 0xFF
            };
        }
        return {
            alpha: 255,
            red: color >> 16 & 0xFF,
            green: color >> 8 & 0xFF,
            blue: color & 0xFF,
            a: 255,
            r: color >> 16 & 0xFF,
            g: color >> 8 & 0xFF,
            b: color & 0xFF
        };
    },
    getColor32: function (a, r, g, b) {
        return a << 24 | r << 16 | g << 8 | b;
    }
};



nge.Lib.ModesManager = (function () {

    var _registry = {};

    return function (entity, baseComExtendingFlag) {
        var uid = nge.Lib.Random.uuid4();
        var base = false;

        var creator = Class.extend(function () {
            this.constructor = function () {
                var ourClass = (baseComExtendingFlag) ? nge.App.getPath(entity, false, true) : Class; //base class

                for (var i = 0; i < _registry[entity].length; i++) //multiextending
                    if (_registry[entity][i].uid !== uid)  //all functions must be just one time
                        ourClass = ourClass.extend(_registry[entity][i].f);

                ourClass = ourClass.extend(base); //current function must be last one and the main

                var ourInstance = new ourClass();
                this.__proto__ = ourInstance; //we cant use this = ourInstance  :( But it will be good
            };
        });

        var fakeClass = {
            extend: function (f) {
                if (!_registry[entity])
                    _registry[entity] = [];

                _registry[entity].push({uid: uid, f: f});
                base = f;

                return creator;
            }
        };

        return fakeClass;
    };

})();



nge.Lib.Money = {
    toCoins: function (n) {
        var cv = nge.localData.get('coins.value');
        return nge.Lib.Math.floatRound(parseFloat((n / cv).toFixed(2)));
    },

    toCoinsInt: function (n) {
        return Math.floor(this.toCoins(n));
    },

    fromCoins: function (coins) {
        var cv = nge.localData.get('coins.value');
        return nge.Lib.Math.floatRound(parseFloat((coins * cv).toFixed(2)));
    },

    getCoinsWin: function (amount) {
        var betValue = nge.localData.get('bet.value');
        return this.toCoins(amount) / betValue;
    },

    getSign: function (currency) {
        var signs = {
            'FUN': 'F',
            'USD': '$',
            'EUR': '€',
            'RUB': '₽',
            'UAH': '₴'
        };
        return signs[currency];
    }
};



nge.Lib.Observer = function () {
    var _events = {};
    var _namedEvents = {};
    var _fireInProgress = false;
    var _firesInProgress = [];
    var _observersQueue = [];
    var _eventsQueue = [];
    var _prefix = '';

    //sys
    var _prefixDelimiter = '_@';

    /**
     * add observer
     * @param {String} eventName
     * @param {Function} callback
     * @param {String} name
     * @param {Boolean} global
     * @returns {Boolean}
     */
    this.add = function (eventName, callback, name, global) {

        if (typeof eventName === 'object') {
            var model = eventName;
            eventName = model.eventName;
            callback = model.callback;
            name = model.name;
            global = model.global;
            model = undefined;
        }

        if (_fireInProgress) {
            _observersQueue.push([eventName, callback, name, global]);
            return false;
        }

        if (!global) {
            var prefix = _getCurPrefix();
            eventName += prefix;
        }

        if (name) {
            if (typeof (_namedEvents[eventName]) === 'undefined') {
                _namedEvents[eventName] = {};
            }

            _namedEvents[eventName][name] = callback;
        } else {
            if (typeof (_events[eventName]) === 'undefined') {
                _events[eventName] = [];
            }

            _events[eventName].push(callback);
        }

        return true;
    };

    /**
     * remove observer
     * @param {String} eventName
     * @param {Function} callback
     * @param {String} name
     * @param {Boolean} global
     * @returns {Boolean}
     */
    this.remove = function (eventName, callback, name, global) {

        if (typeof eventName === 'object') {
            var model = eventName;
            eventName = model.eventName;
            callback = model.callback;
            name = model.name;
            global = model.global;
            model = undefined;
        }

        var newQueue = [];

        for (var k in _observersQueue) {
            var event = _observersQueue[k];
            if (
                eventName !== event[0]
                || name !== event[2]
                || global !== event [3]
                || (!name && !event[2] && callback.toString() !== event[1].toString())
                ) {
                newQueue.push(event);
            }
        }

        _observersQueue = newQueue;

        if (!global) {
            var prefix = _getCurPrefix();
            eventName += prefix;
        }

        if (name) {
            if (typeof (_namedEvents[eventName]) === 'undefined') {
                return false;
            }

            if (typeof (_namedEvents[eventName][name]) === 'undefined') {
                return false;
            }

            _namedEvents[eventName][name] = undefined;
            delete(_namedEvents[eventName][name]);

            if (nge.Lib.Helper.getObjSize(_namedEvents[eventName]) === 0)
                delete(_namedEvents[eventName]);

        } else {
            if (typeof (_events[eventName]) === 'undefined')
                return false;

            var index = _events[eventName].indexOf(callback);

            if (index !== -1)
                _events[eventName].splice(index, 1);

            if (nge.Lib.Helper.getObjSize(_events[eventName]) === 0)
                delete(_events[eventName]);
        }

        return true;
    };

    this.removeByPrefix = function (p) {
        var targetPrefix = _prefixDelimiter + p;

        var clearEventsStorage = function (evts) {
            for (var k1 in evts)
                if (k1.indexOf(targetPrefix) !== -1)
                    delete(evts[k1]);
        };

        clearEventsStorage(_namedEvents);
        clearEventsStorage(_events);

        return true;
    };

    /**
     * complitly reset observer
     * @returns {Boolean}
     */
    this.clear = function () {
        _events = {};
        _namedEvents = {};
        _fireInProgress = false;
        _firesInProgress = [];
        _observersQueue = [];
        _eventsQueue = [];

        return true;
    };

    this.clearEventsQueue = function () {
        if (_eventsQueue.length > 0)
            console.warn('Lib.Observer _eventsQueue was not empty');

        _eventsQueue = [];
        _fireInProgress = false;
    };

    /**
     * set prefix to observer (all non global observers)
     * @param {type} p
     * @returns {undefined}
     */
    this.setPrefix = function (p) {
        _prefix = p;
    };

    /**
     * Fire event
     * @param {String} eventName
     * @param {Mixed} params
     * @param {Number} delay
     * @returns {undefined|Boolean}
     */
    this.fire = function (eventName, params, delay) {

        if (typeof eventName === 'object') {
            var model = eventName;
            eventName = model.eventName;
            params = model.params;
            delay = model.delay;
            model = undefined;
        }

        if (!eventName) {
            console.error('nge.Lib.Observer error: no eventName. Check your code');
            return false;
        }

        if (delay) {
            nge.rafSetTimeout(
                function () {
                    nge.observer.fire(eventName, params);
                },
                delay
                );
            return true;
        }

        if (_fireInProgress) {
            _eventsQueue.push([eventName, params]);
            return false;
        }

//debug
        /*
         if (
         ['cyclicUpdate', "StatesManager.update.start", "StatesManager.update.end"].indexOf(eventName) === -1
         && eventName.indexOf('sound.') === -1
         && eventName.indexOf('mt.object.') === -1 && eventName.indexOf('.uiOption.created') === -1
         )
         nge.log(101, 'event->', eventName, params, _getCurPrefix());
         */

        this.debugFire(eventName, params);

        _fireInProgress = true;
        _firesInProgress.push(eventName);
        var prefix = _getCurPrefix();

        var evtsCall = function (arr, name, params) {
            if (typeof (arr[name]) !== 'undefined') {
                for (var k in arr[name]) {
                    var callback = arr[name][k];
                    callback(params);
                }
            }
        };

        evtsCall(_events, eventName, params);
        evtsCall(_namedEvents, eventName, params);

        //теперь то же самое для оконных событий
        eventName += prefix;

        evtsCall(_events, eventName, params);
        evtsCall(_namedEvents, eventName, params);

        _firesInProgress.pop();

        if (_firesInProgress.length === 0) {
            _fireInProgress = false;
            //добавляем из очереди новые обсерверы
            var queue = _observersQueue;

            for (var k in queue) {
                var q = queue[k];
                this.add(q[0], q[1], q[2], q[3]);
            }

            _observersQueue = [];

            //Файрим из очереди новые ивенты
            if (_eventsQueue.length > 0) {
                var event = _eventsQueue.shift();
                this.fire(event[0], event[1]);
            }
        }

        return true;
    };

    //debug
    this.debugFire = function (eventName, params) {};

    var _getCurPrefix = function () {
        return _prefixDelimiter + _prefix;
    };
};



nge.Lib.RafSetTimeout = function () {
    var _events = {};

    this.init = function () {
        _subscibe();
    };

    this.status = function () {
        log(_events);
    };

    this.add = function (callback, delay) {
        var callTime = nge.Lib.Time.get() + delay;
        var k = callTime + '_' + nge.Lib.Helper.getRandomInt(0, 99999);
        _events[k] = {callTime: callTime, callback: callback};
        return k;
    };

    this.clear = function (id) {
        if (!_events[id])
            return false;

        delete _events[id];
        return true;
    };

    var _checkEvents = function () {
        var newEvents = [];
        var time = nge.Lib.Time.get();
        var eventsToFire = {};

        var i = 0;
        for (var k in _events) {
            var event = _events[k];

            if (event.callTime <= time) {
                var key = event.callTime * 1000 + i;
                eventsToFire[key] = event.callback;
                _events[k] = null;
                delete(_events[k]);
            }

            i++;
        }

        var keys = Object.keys(eventsToFire).sort();

        for (var i = 0; i < keys.length; i++)
            eventsToFire[keys[i]]();

        return true;
    };

    var _subscibe = function () {
        nge.observer.add(
            'StatesManager.update.start',
            _checkEvents,
            false,
            true
        );
    };

};



nge.Lib.Random = {
    /**
     * random number 0-a
     * @param {Number} a
     * @returns {Number}
     */
    generate: function (a) {
        return ~~(Math.random() * (a + 1));
    },
    /**
     * random number a-b
     * @param {Number} a
     * @param {Number} b
     * @returns {Number}
     */
    generate_range: function (a, b) {
        return Math.round(Math.random() * (b - a) + a);
    },
    /**
     * random fluctuation
     * @returns {Number}
     */
    generate_one_f_fluctuation: function () {
        var a, b = Math.random();
        return a = b < .5 ? b + 2 * b * b : b - 2 * (1 - b) * (1 - b);
    },
    /**
     * average num
     * @param {Object} a Array of numbers
     * @returns {Number}
     */
    findAverage: function (a) {
        for (var b = 0, c = 0; c < a.length; c++)
            b += a[c];
        return b / a.length;
    },
    /**
     * variance
     * @param {type} a Array of numbers
     * @returns {Number}
     */
    findVariance: function (a) {
        for (var b = this.findAverage(a), c = 0, d = 0; d < a.length; d++)
            c += Math.pow(a[d] - b, 2);
        return c / a.length;
    },
    /**
     * deviation
     * @param {type} a Array of numbers
     * @returns {Number}
     */
    findStandardDeviation: function (a) {
        var b = this.findVariance(a);
        return Math.sqrt(b);
    },
    /**
     * Returns a random real number between 0 and 1.
     * @returns {Number}
     */
    frac: function () {
        return Math.random();
    },
    /**
     * test function
     * @param {Number} a
     * @param {Number} b
     * @returns {undefined}
     */
    testGenerate: function (a, b) {
        var c = 0;
        console.log("Testing RNG Generation. Range: " + a + " Iteration: " + b);
        for (var d = 0; d <= b; d++) {
            var e = this.generate(a);
            console.log("#" + d, e), e === a && (console.log("Max value " + a), c++);
        }
        console.log("Max Value Count : " + c);
    },
    /**
     * uniq id
     * @returns {String}
     */
    uuid4: function () {
        //// return uuid of form xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx
        var uuid = '', ii;
        for (ii = 0; ii < 32; ii += 1) {
            switch (ii) {
                case 8:
                case 20:
                    uuid += '-';
                    uuid += (Math.random() * 16 | 0).toString(16);
                    break;
                case 12:
                    uuid += '-';
                    uuid += '4';
                    break;
                case 16:
                    uuid += '-';
                    uuid += (Math.random() * 4 | 8).toString(16);
                    break;
                default:
                    uuid += (Math.random() * 16 | 0).toString(16);
            }
        }
        return uuid;
    },
    //aliases
    /**
     * generate, generate_range short alias
     * @param {Number} a
     * @param {Number} b
     * @returns {Number}
     */
    get: function (a, b) {
        if (typeof b === 'undefined')
            return this.generate(a);
        else
            return this.generate_range(a, b);
    }
};



nge.Lib.SelfCheckTools = {
    _len: 0,
    _windowKeys: [],
    saveState: function ()
    {
        this._len = nge.Lib.Helper.getObjSize(window);
        for (var k in window)
        {
            this._windowKeys.push(k);
        }

        return true;
    },
    showChanges: function ()
    {
        console.log(this._len + ' ~~ ' + nge.Lib.Helper.getObjSize(window));
        for (var k in window)
        {
            if (this._windowKeys.indexOf(k) === -1) {
                console.log('---' + k, window[k]);
            }
        }
        return true;
    },

    /**
     * differences between two objects
     *
     * usage:
     *
     * var result = nge.Lib.SelfCheckTools.deepDiffMapper.map({
     *          a:'i am unchanged',
     *          b:'i am deleted',
     *          e:{ a: 1,b:false, c: null},
     *          f: [1,{a: 'same',b:[{a:'same'},{d: 'delete'}]}],
     *          g: new Date('2017.11.25')
     *      },
     *      {
     *          a:'i am unchanged',
     *          c:'i am created',
     *          e:{ a: '1', b: '', d:'created'},
     *          f: [{a: 'same',b:[{a:'same'},{c: 'create'}]},1],
     *          g: new Date('2017.11.25')
     *      },
     *      10, 
     *      true
     *  );
     *  console.log(result);
     *
     * @type type
     */
    deepDiffMapper: function () {
        return {
            VALUE_CREATED: 'created',
            VALUE_UPDATED: 'updated',
            VALUE_DELETED: 'deleted',
            VALUE_UNCHANGED: 'unchanged',
            map: function (obj1, obj2, recursiveCalls, changesOnly) {
                if (typeof recursiveCalls === 'undefined')
                    recursiveCalls = 999;

                if (this.isFunction(obj1) || this.isFunction(obj2)) {
                    throw 'Invalid argument. Function given, object expected.';
                }
                if (this.isValue(obj1) || this.isValue(obj2)) {
                    return {
                        type: this.compareValues(obj1, obj2),
                        data: (obj1 === undefined) ? obj2 : obj1
                    };
                }

                var diff = {};
                for (var key in obj1) {
                    if (this.isFunction(obj1[key])) {
                        continue;
                    }

                    var value2 = undefined;
                    if ('undefined' !== typeof (obj2[key])) {
                        value2 = obj2[key];
                    }

                    diff[key] = (recursiveCalls) ? this.map(obj1[key], value2, recursiveCalls - 1) : 'object';
                }
                for (var key in obj2) {
                    if (this.isFunction(obj2[key]) || ('undefined' !== typeof (diff[key]))) {
                        continue;
                    }

                    diff[key] = (recursiveCalls) ? this.map(undefined, obj2[key], recursiveCalls - 1) : 'object';
                }

                if (changesOnly)
                    this.removeUnchanged(diff);

                return diff;

            },
            removeUnchanged(obj) {
                for (var prop in obj) {
                    if (obj[prop].type === this.VALUE_UNCHANGED)
                        delete obj[prop];
                    else if (typeof obj[prop] === 'object') {
                        this.removeUnchanged(obj[prop]);

                        if (nge.Lib.Helper.getObjSize(obj[prop]) === 0)
                            delete(obj[prop]);
                    }
                }
            },
            compareValues: function (value1, value2) {
                if (value1 === value2) {
                    return this.VALUE_UNCHANGED;
                }
                if (this.isDate(value1) && this.isDate(value2) && value1.getTime() === value2.getTime()) {
                    return this.VALUE_UNCHANGED;
                }
                if ('undefined' === typeof (value1)) {
                    return this.VALUE_CREATED;
                }
                if ('undefined' === typeof (value2)) {
                    return this.VALUE_DELETED;
                }

                return this.VALUE_UPDATED;
            },
            isFunction: function (obj) {
                return {}.toString.apply(obj) === '[object Function]';
            },
            isArray: function (obj) {
                return {}.toString.apply(obj) === '[object Array]';
            },
            isDate: function (obj) {
                return {}.toString.apply(obj) === '[object Date]';
            },
            isObject: function (obj) {
                return {}.toString.apply(obj) === '[object Object]';
            },
            isValue: function (obj) {
                return !this.isObject(obj) && !this.isArray(obj);
            }
        };
    }(),

    /**
     * get all DOM tree with props (for debug in IOS chrome)
     * @param {DOM element} node
     * @returns {Object}
     */
    getNodeTree: function (node) {
        if (node.hasChildNodes()) {
            var children = [];
            for (var j = 0; j < node.childNodes.length; j++) {
                children.push(this.getNodeTree(node.childNodes[j]));
            }
        }

        if (node.attributes && node.attributes.length > 0)
            for (var i = 0, atts = node.attributes, n = atts.length, attributes = {}; i < n; i++) {
                attributes[atts[i].nodeName] = atts[i].nodeValue;
            }
        return {
            nodeName: node.nodeName || "",
            parentName: node.parentNode.nodeName || "",
            children: children || "",
            content: node.innerText || "",
            attributes: attributes || ""
        };
    }

};

