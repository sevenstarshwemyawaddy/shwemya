nge.App[nge.appNS].Com.Gamble = {};



nge.App[nge.appNS].Com.Gamble.Controller = nge.Com.Base.extend(function () {
    var _self = this;
    var _created;

    this.create = function () {
        this.createDefault();

        if (!_created) {
            this.subscribe();
            _created = true;
        }

        this.service = this.getInstance('Service');
        this.service.view = this.getInstance('View');

        this.service.init();
        this.service.view.init();
    };

    var _chkShowGamble = function (showAnyway) {
        _self.service.checkShowGamble(showAnyway);
    };

    var _gambleTakeHandler = function () {
        _self.service.gambleTakeHandler();
    };

    var _hideGambleButtons = function () {
        _self.service.hideGambleButtons();
    };

    var _showGambleScreen = function () {
        _self.service.showGambleScreen();
    };

    var _actionRed = function () {
        _self.service.actionRed();
    };

    var _actionBlack = function () {
        _self.service.actionBlack();
    };

    var _actionResponse = function (data) {
        _self.service.actionResponse(data);
    };

    this.update = function () {
        _self.service.update();
    };

    var _winHandler = function (n) {
        _self.service.winHandler(n);
    };

    var _freespinTotalWinHandler = function () {
        _self.service.freespinTotalWinHandler();
    };

    var _buttonsPressHandler = function(buttonName){
        var gambleIndifier = 'gambleAction';

        if(buttonName && buttonName.indexOf(gambleIndifier) !== 0)
            return;

        var card = buttonName.replace(gambleIndifier, '');
        var cardLowered = nge.Lib.Helper.lowerFirstLetter(card);

        nge.observer.fire('gamble.'.concat(cardLowered));
    };
    var _balanceRequestHandler = function () {
        _self.service.balanceRequestHandler();
    };

    this.subscribe = function () {
        nge.observer.add('winlines.animateByOne.cycleComplete', _chkShowGamble);
        nge.observer.add('autospinSimple.on', _hideGambleButtons);
        nge.observer.add('gamble.take', _gambleTakeHandler);
        nge.observer.add('gamble.taking.stop', _hideGambleButtons);
        nge.observer.add('gamble.go', _showGambleScreen);
        nge.observer.add('gamble.red', _actionRed);
        nge.observer.add('gamble.black', _actionBlack);
        nge.observer.add('gamble.response', _actionResponse);
        nge.observer.add('win', _winHandler);
        nge.observer.add('freespin.totalWin', _winHandler);
        nge.observer.add('freespin.totalWin', _freespinTotalWinHandler);
        nge.observer.add('buttons.pressCommand', _buttonsPressHandler);
        nge.observer.add('balanceRequest', _balanceRequestHandler);
    };
});



nge.App[nge.appNS].Com.Gamble.Service = Class.extend(function () {
    var _self = this;

    this.updateTime = 150;
    this.updateTimeCover = 100;
    var _lastUpdateTimeCover = 0;

    var _lastUpdateTime = 0;
    var _lastColorIsRed = false;

    var _choiceRed = false;
    var _win = 0;
    var _winTimesCounter = 0;
    var _history = [];
    var _winTriggered = false;
    var _intrigue = true;
    var _gambleScreenVisible = false;
    var _gambleSmallButtonsVisible = false;

    this.init = function () {
        _setCanGamble(false);
    };

    this.checkShowGamble = function (showAnyway) {
        if (!_winTriggered) return;

        var freespinProgress = nge.localData.get('freespin.inProgress');
        var respinProgress = nge.localData.get('respin.inProgress');
        if (!freespinProgress && !respinProgress && !nge.localData.get('gamble.canPlay'))
            nge.observer.fire('gamble.take');

        _winTriggered = false;

        if (showAnyway || nge.localData.get('slotMachine.slotWin.totalWin') > 0)
            this.showGambleButtons();
    };

    this.showGambleButtons = function () {
        var freespinProgress = nge.localData.get('freespin.inProgress');
        var respinProgress = nge.localData.get('respin.inProgress');
        if (freespinProgress || respinProgress) {
            this.hideGambleButtons();
            return;
        }

        var autospin = nge.localData.get('autospin');
        if (autospin) {
            nge.observer.fire('gamble.take');
            return;
        }
        
        nge.observer.fire('buttons.showGamble');
        _gambleSmallButtonsVisible = true;
    };

    this.showGambleScreen = function () {
        var gambleParams = nge.localData.get('slotMachine.slotWin.gambleParams');
        if (gambleParams) {
            var hist = gambleParams.history;
            for (var k in hist) {
                var resultColor = parseInt(hist[k]) ? 'Red' : 'Black';
                var gambleCardBigTexture = 'gambleCardBig' + resultColor;
                _history.push(gambleCardBigTexture);
            }
        }

        _intrigue = true;
        _self.view.redrawHistory(_history);
        this.view.showGambleScreen();
        _gambleScreenVisible = true;
    };

    this.gambleTakeHandler = function () {
        this.view.gambleTakeHandler();
        _setCanGamble(false);
        _gambleScreenVisible = false;
    };

    this.hideGambleButtons = function () {
        this.view.hideGambleButtons();
        _gambleScreenVisible = false;

        var freespinProgress = nge.localData.get('freespin.inProgress');
        var respinProgress = nge.localData.get('respin.inProgress');

        if (!freespinProgress && !respinProgress)
            nge.observer.fire('buttons.enable');

        nge.observer.fire('gamble.buttons.hided');

        _gambleSmallButtonsVisible = false;
        _winTimesCounter = 0;
    };

    this.action = function (isRed) {
        _intrigue = false;
        _choiceRed = isRed;
        nge.observer.fire('gamble.actionRequest', {card: +isRed});
    };

    this.actionRed = function () {
        if (nge.localData.get('gamble.canPlay') && _intrigue)
            this.action(true);
    };

    this.actionBlack = function () {
        if (nge.localData.get('gamble.canPlay') && _intrigue)
            this.action(false);
    };

    this.gambleResultCallback = function (winning, callback) {
        nge.rafSetTimeout(callback, 1500);
    };

    this.actionResponse = function (data) {
        var winning = parseFloat(data.winning);
        var canGamble = !(data.canGamble === false || data.canGamble === 'false');
        _setCanGamble(canGamble);

        _win = winning;
        this.view.resetButtons();

        var condition = (winning && _choiceRed) || (!winning && !_choiceRed);
        var resultColor = condition ? 'Red' : 'Black';
        var gambleCardBigTexture = 'gambleCardBig' + resultColor;

        this.view.showGambleResult(resultColor, function () {
            _self.view.winRedraw(_win);

            _history.unshift(gambleCardBigTexture);
            _self.view.redrawHistory(_history);

            var callbackWin = function () {
                nge.observer.fire('gamble.resume');
                _intrigue = true;

                nge.rafSetTimeout(function () {
                    nge.observer.fire('buttons.gamble.restore');
                }, 100);
            };

            var callbackLoose = function () {
                // _self.view.elementsChangeActivityByNames(_gambleButtons, true);
                nge.observer.fire('gamble.take');
                _self.hideGambleButtons();
            };

            var callback = (winning && canGamble) ? callbackWin : callbackLoose;
            _self.gambleResultCallback(winning, callback);

            _winTimesCounter++;
            var evt = winning ? ('gamble.win.' + _winTimesCounter) : 'gamble.loose';

            nge.observer.fire(evt);
        });
    };

    this.update = function () {
        if (!_gambleScreenVisible || !_gambleSmallButtonsVisible || !_intrigue)
            return;

        //time check cover
        var time = nge.Lib.Time.get();
        if (time - _lastUpdateTimeCover < this.updateTimeCover)
            return;

        _lastUpdateTimeCover = time;

        this.view.updateGambleBigTexture();

        //time check
        if (time - _lastUpdateTime < this.updateTime)
            return;

        _lastUpdateTime = time;

        this.view.updateGambleButtons(_lastColorIsRed);

        _lastColorIsRed = !_lastColorIsRed;
    };

    this.winHandler = function (n) {
        _winTriggered = true;
        _win = n;
        this.view.winRedraw(_win);
        var canGamble = nge.localData.get('slotMachine.slotWin.canGamble');
        _setCanGamble(canGamble);
    };

    this.freespinTotalWinHandler = function () {
        this.checkShowGamble(true);
    };

    this.balanceRequestHandler = function () {
        _setCanGamble(false);
    };

    var _setCanGamble = function (value) {
        var canGamble = value !== 'false' && value !== false;
        canGamble = canGamble && !nge.localData.get('offersLastSpinAutoPlayed');
        nge.localData.set('gamble.canPlay', canGamble);
    };
});



