nge.App[nge.appNS].Com.Help = {};



nge.App[nge.appNS].Com.Help.Controller = nge.Com.Base.extend(function () {
    var _self;
    var _created;
    var _convertedPayout;
    var _isHelpOpened;
    this.curPage = 0;
    this._pages = 3;
    var _hc = null;
    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        _self = this;
        this.createDefault();
        _convertedPayout = _calcPaytable();
        if (!_created)
            _self.subscribe();
        _isHelpOpened = false;
        _hc = nge.findOne('^helpPagesContainer');

        if(_hc)
            _hc.visible = false;
        nge.localData.set('paytable.showed', false);
        _created = true;
        return true;
    };
    this.updatePaytableForSymbol = (symbolId, suffix='', modificator=1, parent) => {
        const bet = nge.localData.get('bet.value');
        const cp = _convertedPayout[symbolId].awards;
        if (!cp || !cp.length) return;
        for (let k = 0; k < cp.length; k++) {
            const payout = cp[k];
            const selector = '.ps' + symbolId + suffix + '-' + payout.name;
            const els = nge.findAll(selector, parent);
            for (let kEl in els) {
                const el = els[kEl];
                el.text = (payout.value * bet * modificator);
            }
        }
    };
    this.drawPaytable = (suffix='', modificator=1) => {
        for (let sk in _convertedPayout) {
            this.updatePaytableForSymbol(sk, suffix, modificator);
        }
    };
    var _calcPaytable = function () {
        var payout = nge.localData.get('payout.cfg');
        var convertedPayout = {};
        var totalPayouts = 0;
        var payoutArrLen = payout.length;
        outer:
            for (var i = 0; i < payoutArrLen; i++) {
                var symbols = payout[i].symbols;
                var coins = payout[i].payout;
                var matchCount = payout[i].matchCount;
                var symbolQty = 0;
                var payoutName = symbols[0];
                if (coins === 0) {
                    continue;
                }
                if (matchCount > 0) { // then we get "any symbol" payout
                    payoutName = 'any_' + symbols.join('_');
                    symbolQty = matchCount;
                } else {
                    var symbolsArrLen = symbols.length;
                    for (var j = 0; j < symbolsArrLen; j++) {
                        if (payoutName !== symbols[j]) {
                            continue outer;
                        }
                        symbolQty++;
                    }
                }
                if (!convertedPayout[payoutName]) {
                    totalPayouts++;
                    convertedPayout[payoutName] = {};
                    convertedPayout[payoutName].awards = [];
                }
                convertedPayout[payoutName].awards.push({name: symbolQty, value: coins});
            }
        return convertedPayout;
    };
    this.show = function () {
        nge.observer.fire('button.disable', 'auto');
        nge.observer.fire('betSettings.updateSliders');
        nge.observer.fire('settings.update');

        //help
        _hc.visible = true;
        //hide slotMachine
        var sm = nge.findOne('^slotMachineContainer');
        sm.visible = false;
        _self.drawAllPayOuts();
        nge.localData.set('paytable.showed', true);
    };
    this.drawAllPayOuts = function () {
        this.drawPaytable();
        this.drawPaytable('b', 2);
        var lines = nge.localData.get('lines.value');
        this.drawPaytable('s', lines);
    };
    this.hide = function () {
        nge.observer.fire('button.enable', 'auto');

        //hide help
        _hc.visible = false;
        _self.curPage = 0;
        //show slotMachine
        var sm = nge.findOne('^slotMachineContainer');
        sm.visible = true;
        nge.localData.set('paytable.showed', false);
    };
    this.showPage = function (num) {
        if (!num)
            num = _self.curPage;
        nge.observer.fire('help.show.page', num);
        for (var i = 0; i < _self._pages; i++) {
            var selector = '^helpPage' + i;
            var el = nge.findOne(selector);
            if (el)
                el.visible = false;
        }
        var elp = nge.findOne('^helpPage' + num);
        if (elp)
            elp.visible = true;
    };
    var _pageNumValidate = function () {
        if (_self.curPage < 0)
            _self.curPage = _self._pages - 1;
        if (_self.curPage >= _self._pages)
            _self.curPage = 0;
    };
    this.next = function () {
        _self.curPage++;
        _pageNumValidate();
        _self.showPage();
    };
    this.back = function () {
        _self.curPage--;
        _pageNumValidate();
        _self.showPage();
    };
    this.subscribe = function () {
        nge.observer.add('paytable.hide', this.hide);
        nge.observer.add('paytable.show', this.show);
        nge.observer.add('paytable.back', this.back);
        nge.observer.add('paytable.next', this.next);
        nge.observer.add('paytable.updatePayout', this.drawAllPayOuts);
        nge.observer.add('paytable.updatePayoutForSymbol', (v) => {
            this.updatePaytableForSymbol(v.symbolId, v.suffix, v.modificator, v.parent);
        });
        if (_self.customSubscribe)
            _self.customSubscribe();
    };
});


