        if (cfg && cfg.length > 1)
            visibility = true;

        if (visibility) {
            offset += 200;
            num++;
        }
        return {'visibility': visibility, 'offset': offset};
    };

    var lines = _settingsParams('lines');
    var bet = _settingsParams('coins');
    var coins = _settingsParams('bet');

