nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.States.FreespinState = nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.States.BaseState.extend(function () {
    
    var _self = this;
    var _freespinNeedFinish = false;
    var _freespinStarted = false;
    var _freespinStartProcessStart = false;
    var _balanceReceived = false;
    var _restoreFreespinStart = false;
    var _freespinSpinStarted = false;
    var _finishPopupAnimating = false;

    this.freespinStartEventName = 'freespin.press.spinButton';

    var _cfg;

    this.init = function (buttons) {
        _cfg = nge.App.getInstance('Mlm.Brain.ButtonsNewLogic.Cfg');
        this.super.init(buttons);
    };

    this.model = {
        order: ['SHOW_START_POPUP', 'RESTORE?', 'READY', 'STARTED', 'SHOW_FINISH_POPUP'],
        
        actions: {
            SHOW_START_POPUP: {},

            RESTORE: {
                'spin': {
                    title: nge.i18n.get('CONTINUE\nBONUS'),
                    callback: ['freespinStartCallback']
                }
            },
            
            READY: {
                'spin': {
                    title: nge.i18n.get('SPIN'),
                    callback: ['freespinStartCallback']
                },
                'oneBet': {
                    title: nge.i18n.get('ONE BET'),
                    callback: ['freespinStartCallback']
                },
                'maxBet': {
                    title: nge.i18n.get('MAX BET'),
                    callback: ['freespinStartCallback']
                },
                'paytable': {
                    title: nge.i18n.get('PAYTABLE'),
                    callback: ['freespinStartCallback']
                },
                'hold1': {
                    title: nge.i18n.get('HOLD 1'),
                    callback: ['freespinStartCallback']
                },
                'hold2': {
                    title: nge.i18n.get('HOLD 2'),
                    callback: ['freespinStartCallback']
                },
                'hold3': {
                    title: nge.i18n.get('HOLD 3'),
                    callback: ['freespinStartCallback']
                },
                'hold4': {
                    title: nge.i18n.get('HOLD 4'),
                    callback: ['freespinStartCallback']
                },
                'hold5': {
                    title: nge.i18n.get('HOLD 5'),
                    callback: ['freespinStartCallback']
                }
            }, 
            
            STARTED: { 
                'spin': {
                    title: nge.i18n.get('STOP'),
                    enabled: ['!auto', 'quickFinishEnable'],
                    callback: ['quickFinishCallback']
                },
                'auto': {
                    callback: ['autoCallback']
                }
            },
            SHOW_FINISH_POPUP: {}
        }
    };

    this.subscribeCfgExt = {
        'freespin.start': 'freespinStartHandler',
        'freespin.end': 'freespinEndHandler',
        'buttons.freespinContinue': 'freespinContinueHandler',
        'freespin.press.spinButton': 'freespinStartCommandHandler',
        'buttons.freespinStart': 'freespinButtonsStartHandler',
        'popupFinish.animate.start': 'popupFinishAnimateStartHanldler'
    };

    this.validityCheckHandler = function(){
        var lastResponse = !!nge.localData.get('slotMachine.lastResponse');
        var canGamble = nge.localData.get('slotMachine.slotWin.canGamble') === 'true';

        if (!_freespinStarted && canGamble)
            return false;

        return lastResponse || (!_balanceReceived && _freespinNeedFinish);
    };

    this.actionUpdateHandlers = {
        onShowStartPopup: function(){
            return _freespinStartProcessStart; 
        },
        onRestore: function(){
            var restoreFreespinAvail = !!nge.localData.get('slotMachine.lastResponse');
            return restoreFreespinAvail && _restoreFreespinStart;
        },
        onReady: function(){
            var restoreFreespinAvail = !!nge.localData.get('slotMachine.lastResponse');
            return !_freespinStartProcessStart && !_freespinSpinStarted && !restoreFreespinAvail; 
        },
        onStarted:function(){
            var inProgress = nge.localData.get('freespin.inProgress');
            return _freespinSpinStarted && inProgress;
        },
        onShowFinishPopup: function(){
            return _finishPopupAnimating;
        }
    };

    this.beforeUpdateHandlers = {
        onRestore: function(model){
            if(model.spin){
                _self.changeStyle(model.spin, 
                    'buttonTextContinueButton', 
                    _self.changeStyleTypeEnum.add);
            }
            
        },
        onStarted: function(model){
            if(model.spin){
                _self.changeStyle(model.spin, 
                    'buttonTextContinueButton', 
                    _self.changeStyleTypeEnum.remove);
            }
        }
    };

    this.freespinStartHandler = function(){
        _freespinStarted = true;
        _restoreFreespinStart = true;
        _freespinStartProcessStart = true;
        _freespinNeedFinish = true;
    };

    this.callbackHandlers.freespinStartCallback = function(){ 
        nge.observer.fire(_self.freespinStartEventName);
    };

    this.freespinButtonsStartHandler = function(){
        _freespinStartProcessStart = false;
    };
    
    this.freespinStartCommandHandler = function(){
        _freespinSpinStarted = true;
        _restoreFreespinStart = false;
    };

    this.freespinContinueHandler = function(){
        _freespinStartProcessStart = false;
    };

    this.balanceResponseHandler = function(){
        this.super.balanceResponseHandler();
        _balanceReceived = true;
        _freespinNeedFinish = false;
        _finishPopupAnimating = false;
    };

    this.spinStartHandler = function(){
        this.super.spinStartHandler();
        _balanceReceived = false;
    };

    this.freespinEndHandler = function(){
        _freespinStarted = false;
        _finishPopupAnimating = false;
    };

    this.popupFinishAnimateStartHanldler = function(){
        _finishPopupAnimating = true;
        _freespinSpinStarted = false;
    };

    this.cycleCompleteHandler = function(){
        this.super.cycleCompleteHandler();
        nge.localData.set('slotMachine.quickFinishWaiting', false);
    };

    this.spinCompleteHandler = function(){
        nge.rafSetTimeout(function(){
            var isWin = nge.localData.get('slotMachine.slotWin');
            if(_cfg && _cfg.enableWinlinesQuickFinish && isWin) {
                nge.localData.set('slotMachine.quickFinishWaiting', true);

                var spinObj = {};
                var spinButtonName = nge.Lib.Helper.mobileAndTabletCheck() ? 'spinMobile' : 'spin';
                
                spinObj[spinButtonName] = {};
                spinObj[spinButtonName] = {
                    title: _self.stopBtnName,
                    callback: function () {
                        nge.localData.set('slotMachine.quickFinishWaiting', false);
                        nge.observer.fire('slotMachine.quickFinish');
                    },
                    enabled: true
                };
                nge.observer.fire('buttons.changeData', spinObj);
            }
        }, 1);
    };

    this.subscribe = function(){
        this.super.subscribe();
        nge.observer.add('freespin.start', this.freespinStartHandler, false, true);
        nge.observer.add('freespin.end', this.freespinEndHandler, false, true);
        nge.observer.add('buttons.freespinContinue', this.freespinContinueHandler, false, true);
        nge.observer.add(this.freespinStartEventName, this.freespinStartCommandHandler, false, true);
        nge.observer.add('buttons.freespinStart', this.freespinButtonsStartHandler, false, true);
        nge.observer.add('popupFinish.animate.start', this.popupFinishAnimateStartHanldler, false, true);
        nge.observer.add('slotMachine.spinComplete', this.spinCompleteHandler, false, true);
    };
});



