nge.Mlm.Objects.Folder = function (param) {
    if (!param)
        param = {};

    return {
        'id': (param.hasOwnProperty('id')) ? param.id : false,
        'name': (param.hasOwnProperty('name')) ? param.name : false,
        'class': (param.hasOwnProperty('class')) ? param.class : false,
        'anchorX': (param.hasOwnProperty('anchorX')) ? param.anchorX : 0,
        'anchorY': (param.hasOwnProperty('anchorY')) ? param.anchorY : 0,
        'x': (param.hasOwnProperty('x')) ? param.x : 0,  //numper or persents (40%)
        'y': (param.hasOwnProperty('y')) ? param.y : 0,  //numper or persents (40%)
        'alignX': (param.hasOwnProperty('alignX')) ? param.alignX : 'left', //or right or center
        'alignY': (param.hasOwnProperty('alignY')) ? param.alignY : 'top', //or bottom or center
        'sWidth': (param.hasOwnProperty('sWidth')) ? param.sWidth : false, //or 40% or 1456  // highest priority then scale  DO NOT USE WITH rightOffset
        'sHeight': (param.hasOwnProperty('sHeight')) ? param.sHeight : false, //or 40% or 568  // highest priority then scale  DO NOT USE WITH bottomOffset
        'rightOffset': (param.hasOwnProperty('rightOffset')) ? param.rightOffset : false,  //or numper or persents (40%)  DO NOT USE WITH sWidth
        'bottomOffset': (param.hasOwnProperty('bottomOffset')) ? param.bottomOffset : false,  //or numper or persents (40%)  DO NOT USE WITH sHeight
        'sType': (param.hasOwnProperty('sType')) ? param.sType : false, //or inscribed or circumscribed //works only if sWidth=sHeight=100%

// todo use mm (milimeters) ... calc with phisical and dpi
        
        'z': (param.hasOwnProperty('z')) ? param.z : 0,
        'type': mt.objects.GROUP,
