/**
 * Created by s.kleimenov 21.12.2017
 */

nge.App[nge.appNS].Com.WinlinesAddon.AnimationFrames.Controller = nge.Com.Base.extend(function () {
    var _self;
    var _created;
    var _cfg;
    var _smCfg;
    var _container;
    var _symbolWidth;
    var _symbolHeight;
    var _winlineCfg;
    var _cache;
    var _tweens;
    var _winlinesAddon;
    var _frameTypeMode;
    var _parent;

    this.create = function () {
        _cache = {};
        _tweens = {};
        _self = this;
        _smCfg = this.getInstance('Cfg', 'slotMachine').get();
        _cfg = this.getInstance('CfgMode').get();
        _winlineCfg = this.getInstance('Cfg', 'winlines');
        _frameTypeMode = _cfg.border.types[0];

        var tpl = this.getInstance('Tpl');
        _parent = nge.findOne('^winlinesAddonContainer');
        nge.objects.create(tpl.objects.contents[0], _parent);
        _winlinesAddon = nge.findOne('^winlinesAddon');
        
        _createAddon(_winlinesAddon);

        if (_cfg.routeframesUnderSymbols) {
            var SMcon = nge.findOne('^' + _smCfg.parentName);
            SMcon.add(_parent);
            _parent.x -= SMcon.x;
            _parent.y -= SMcon.y;
        }

        if (!_created) {
            _self.subscribe();
        }
        _created = true;
        return true;
    };

    var _createAddon = function () {
        _container = nge.findOne('^' + _smCfg.parentName);
        if (!_container)
            return false;
        var cData = _container.mt.data;
        _symbolWidth = cData.width / _smCfg.mw;
        _symbolHeight = cData.height / _smCfg.mh;
        _createRouteFrame(_winlinesAddon);
        _createBorderWin(_winlinesAddon);
    };

    var _createRouteFrame = function (winlineContainer) {
        for (var i = 0; i < _smCfg.mh; i++) {
            for (var j = 0; j < _smCfg.mw; j++) {

                var offsetX = (_smCfg.rowsXoffset) ? _smCfg.rowsXoffset[i] : 0 + (_cfg.rowsXoffset) ? _cfg.rowsXoffset[i] : 0;
                var offsetY = (_smCfg.rowsYoffset) ? _smCfg.rowsYoffset[i] : 0 + (_cfg.rowsYoffset) ? _cfg.rowsYoffset[i] : 0;

                var x = (j * _symbolWidth) + offsetX;
                var y = (i * _symbolHeight) + offsetY;

                var model = {
                    x:x, y:y,
                    type: 0,
                    assetKey: 'gn_border_' + _frameTypeMode + '0',
                    name: 'symbol-frame-' + i + '-' + j,
                    isVisible: false,
                    scaleX:_cfg.scaleFactor,
                    scaleY:_cfg.scaleFactor
                };
                
                var sprite = nge.objects.create(model, winlineContainer);
                sprite.name = 'symbol-frame-' + i + '-' + j;
                _cache[sprite.name] = sprite;
            }
        }
    };

    var _createBorderWin = function (winlineContainer) {
        var graphics;
        var getStrokeData = function (stroke, index) {
            if (stroke === false)
                return { stroke: null };
            var winlineStroke = _winlineCfg.stroke;
            var strokeWeight = stroke ? stroke.weight : (winlineStroke ? winlineStroke.weight : 0);
            var strokeColors = (stroke && stroke.colors) || (winlineStroke && winlineStroke.colors);
            var strokeAlpha = stroke ? stroke.alpha : (winlineStroke ? winlineStroke.alpha : 1);
            var s = stroke || winlineStroke;
            return {
                stroke: s,
                weight: strokeWeight,
                color: strokeColors[index],
                alpha: strokeAlpha
            };
        };

        var createBorder = function (i) {
            graphics = new Phaser.Graphics(nge.game);
            // graphics.name = 'border-win-frame-' + _cfg.border.types[i];
            graphics.name = 'border-win-frame';
            graphics.x = 0;
            graphics.y = 0;
            var s = getStrokeData(_cfg.border.stroke, 0);
            var strokeColor = _cfg.border.stroke.colors[i];
            _drawShape({
                width: _cfg.border.width,
                height: _cfg.border.height,
                weight: _cfg.border.weight,
                color: _cfg.border.colors[i],
                alpha: 0,
                stroke: s.stroke,
                strokeWeight: s.weight,
                strokeColor: strokeColor,
                strokeAlpha: 0,
                background: _cfg.border.background
            }, graphics);

            graphics.cacheAsBitmap = true;
            // graphics.cacheAsBitmap = false;
            graphics.visible = true;

            var model = {
                x:0, y:0,
                type: 1,
                name: 'border-win-frame-' + _cfg.border.types[i],
                isVisible: false
            };
            
            var container = nge.objects.create(model, winlineContainer);
            container.name = 'border-win-frame-' + _cfg.border.types[i];
            container.add(graphics);
            _cache[container.name] = container;
            winlineContainer.add(container);
        };

        var createText = function (i) {
            var x = 0;
            var y = 0;
            var textStyle = _cfg.textStyle;

            if (_cfg.border.textSameColor) {
                textStyle = nge.Lib.Helper.jsObjClone(_cfg.textStyle);
                textStyle.fill = _cfg.border.colors[i].replace('0x', '#');
            }

            var text = new Phaser.Text(nge.game, x, y, '1000', textStyle);
            text.name = 'border-win-text-' + _cfg.border.types[i];
            text.anchorX = 0.5;
            text.anchorY = 1;
            text.visible = false;
            _cache[text.name] = text;
            winlineContainer.add(text);
        };

        for (var i = 0; i < _cfg.border.types.length; i++){
            createBorder(i);
            createText(i);
        }
    };

    var _drawSegment = function (graphics, startX, startY, endX, endY, weight, color, alpha) {
        var a = alpha || 1;
        graphics.beginFill(color, a);
        graphics.lineStyle(weight, color, a);
        graphics.moveTo(startX, startY);

        graphics.lineTo(endX, endY);
        graphics.moveTo(endX, endY);
        graphics.endFill();
    };

    var _drawConnector = function (graphics, x, y, size, color, alpha) {
        var a = alpha || 1;
        graphics.beginFill(color, a);
        graphics.lineStyle(0, color, 0);
        graphics.drawCircle(x, y, size);
        graphics.endFill();
    };

    var _drawBackground = function (graphics, x, y, width, height, color, alpha) {
        var a = alpha || 1;
        graphics.beginFill(color, a);
        graphics.drawRect(x, y, width, height);
        graphics.endFill();
    };

    var _drawShape = function (shapeData, graphics) {
        var drawShapeLines = function (width, height, weight, color, alpha) {
            var sides = [{ x: 0, y: 0 }, { x: width, y: 0 }, { x: width, y: height }, { x: 0, y: height }];
            for (var iSide = 0; iSide < sides.length; iSide++) {
                var side = sides[iSide];
                var nextSide = sides[(iSide + 1) >= sides.length ? 0 : iSide + 1];
                _drawConnector(graphics, side.x, side.y, weight, color, alpha);
                _drawSegment(graphics, side.x, side.y, nextSide.x, nextSide.y, weight, color, alpha);
            }
        };

        if (shapeData.background) {
            _drawBackground(
                graphics,
                0, 0,
                shapeData.width,
                shapeData.height,
                shapeData.background.color,
                shapeData.background.alpha);
        }

        if (shapeData.stroke) {
            drawShapeLines(
                shapeData.width, shapeData.height,
                shapeData.strokeWeight + shapeData.weight,
                shapeData.strokeColor,
                shapeData.strokeAlpha);
        }

        drawShapeLines(
            shapeData.width, shapeData.height,
            shapeData.weight,
            shapeData.color,
            shapeData.alpha);
    };

    var _show = function (data) {
        var spinning = nge.localData.get('slotMachineSpinning');
        if (spinning)
            return false;

        var line = _frameTypeMode;
        if (typeof line === 'undefined' && _cfg.border.types[line])
            line = 'scatter';
            
        for (var key in _cache)
            _cache[key].visible = false;

        for (var i = 0; i < data.wonSymbols.length; i++) {
            var coords = data.wonSymbols[i];
            var sprite = _cache['symbol-frame-' + coords[1] + '-' + coords[0]];

            if (sprite) {
                if (i === 0) {
                    var amount = data.amount;
                    var coins = nge.Lib.Money.toCoins(amount);

                    var border = _cache['border-win-frame-' + _frameTypeMode];
                    border.visible = true;
                    border.x = sprite.x + _cfg.border.offsetX;
                    border.y = sprite.y + _cfg.border.offsetY;

                    _cache['border-win-text-' + line].x = sprite.x + _cfg.border.offsetX + (_cfg.border ? _cfg.border.textOffsetX : 0);
                    _cache['border-win-text-' + line].y = sprite.y + _cfg.border.offsetY + (_cfg.border ? _cfg.border.textOffsetY : 0);
                    _cache['border-win-text-' + line].visible = true;
                    _cache['border-win-text-' + line].text = coins;
                }
                sprite.visible = true;
                _startAnimationTween(coords[1] + '-' + coords[0], sprite);
            }
        }
    };

    var _startAnimationTween = function(name, sprite){
        _tweens[name] = nge.Lib.TweenTools.spritesAnimation(1, 'gn_border_' + _frameTypeMode, sprite, 2000);
        _tweens[name].onComplete.add(function () {
            _startAnimationTween(name, sprite);
        });
        _tweens[name].start();   
    };

    var _hide = function (data) {
        var key;
        for (key in _cache)
            _cache[key].visible = false;
        for (key in _tweens){
            if(_tweens[key])
                _tweens[key].stop(false);
        }
    };

    var _changeFrameTypeMode = function(mode){
        _frameTypeMode = mode;
    };

    var _winlinesAddonContainerEnable = function(enable){
        _winlinesAddon.visible = enable;
    };

    this.subscribe = function () {
        if (_cfg.routeframesUnderSymbols)
            nge.observer.add('winlines.lineHighlite.start.previousHided', _show);
        else
            nge.observer.add('winlines.lineHighlite.startComplete', _show);
        nge.observer.add('winlines.view.startHideAll', _hide);
        nge.observer.add('winlines.enable', _winlinesAddonContainerEnable);
        nge.observer.add('winlines.disable', _winlinesAddonContainerEnable);
        nge.observer.add('winlines.changeFrameTypeMode', _changeFrameTypeMode);  
        nge.observer.add('Transport.close', _hide);  
    };
});



