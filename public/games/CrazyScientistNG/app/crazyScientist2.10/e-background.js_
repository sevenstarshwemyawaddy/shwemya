        }
    };
};



nge.Com.Coins = {};



nge.Com.Coins.Controller = nge.Com.Base.extend(function () {
    var _created;
    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        this.createDefault();
        _setDefault();

        if (!_created)
            _subscribe();

        _created = true;
        return true;
    };

    var _setDefault = function () {
        var coinsCFG = nge.localData.get('coins.cfg');
        if (!coinsCFG)
            return false;

        //toFloat
        var coinsCFGarrLen = coinsCFG.length;
        for (var k = 0; k < coinsCFGarrLen; k++)
            coinsCFG[k] = parseFloat(coinsCFG[k]);
        nge.localData.set('coins.cfg', coinsCFG);

        var val = nge.localData.get('coins.value');
        if (!val)
            val = parseFloat(nge.localData.get('coins.defaultCoin'));


        if (!val)
            val = coinsCFG[0];

        _setVal(val);
        return true;
    };


    var _minusNC = function () {
        _minus(true);
    };

    var _plusNC = function () {
        _plus(true);
    };

    var _minus = function (nonCycle) {
        var val = nge.localData.get('coins.value');
        var coinsCFG = nge.localData.get('coins.cfg');
        if (!val)
            return false;

        var i = coinsCFG.indexOf(val);
        i--;

        if (!coinsCFG[i])
            i = (nonCycle) ? 0 : (coinsCFG.length - 1);

        val = coinsCFG[i];
        _setVal(val);
        return true;
    };

    var _plus = function (nonCycle) {
        var val = nge.localData.get('coins.value');
        var coinsCFG = nge.localData.get('coins.cfg');
        if (!val)
            return false;

        var i = coinsCFG.indexOf(val);
        i++;

        if (!coinsCFG[i])
            i = (nonCycle) ? (coinsCFG.length - 1) : 0;

        val = coinsCFG[i];
        _setVal(val);

        return true;
    };

    var _setVal = function (v) {
        var textArr = nge.findAll('.coinsNumber');
        for (var k in textArr)
            textArr[k].text = parseFloat(v).toFixed(2);

        nge.localData.set('coins.value', parseFloat(v));
        nge.observer.fire('coins.change', v);
    };

    var _subscribe = function () {
        nge.observer.add('brain.openGameSuccess', _setDefault);
        nge.observer.add('coins.down', _minus);
        nge.observer.add('coins.up', _plus);
        nge.observer.add('coins.downNC', _minusNC);
        nge.observer.add('coins.upNC', _plusNC);
        nge.observer.add('coins.set', _setVal);
        nge.observer.add('coins.update', _setDefault);
    };
});



nge.Com.Debug = {};



nge.Com.Debug.Controller = nge.Com.Base.extend(function () {
    this._logicBlocks = [
        'coords', 'fps', 'observer', 'plugin', 'renderStat', 'resolution'
    ];

    var _subscribed = false;
    var _visible = true;
    var _comObject = false;

    this.preload = function () {
        var mode = nge.Cfg.Main.mode;
        if (mode === 'production')
            return false;

        this.preloadDefault();

        nge.Lib.Helper.logicBlocksDo(this, 'preload');
        return true;
    };

    this.create = function () {
        var mode = nge.Cfg.Main.mode;
        if (mode === 'production')
            return false;

        this.createDefault();
        _comObject = nge.findOne('^debugCom');

        nge.Lib.Helper.logicBlocksDo(this, 'create');

        if (!_subscribed) {
            nge.Lib.Helper.logicBlocksDo(this, 'subscribe');
            _subscribe();
            _subscribed = true;
        }
        return true;
    };

    this.update = function () {
        var mode = nge.Cfg.Main.mode;
        if (mode === 'production')
            return false;

        nge.Lib.Helper.logicBlocksDo(this, 'update');
    };

    var _show = function () {
        _visible = !_visible;
        _comObject.visible = _visible;
    };

    var _subscribe = function () {
        nge.observer.add('keyboard.KeyDown', function (k) {
            if (k === 'D') {
                if (nge.keyboard.check('SHIFT'))
                    _show();
            }
        });
    };
});



