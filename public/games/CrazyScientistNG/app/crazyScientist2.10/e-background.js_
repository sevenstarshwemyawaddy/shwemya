/* global nge */

nge.appNS = 'RiverGameBase';
nge.App[nge.appNS] = {};



/* global nge */

nge.App[nge.appNS].Run = nge.App.ClassicGameBasePsd.Run.extend(function () {
    var _linesCfg = [1, 3, 5, 7, 9];

    nge.App.addSysInstancesMode('lang_' + nge.Cfg.Main.lang);
    var previousLang = nge.Cfg.Main.lang;
    nge.Lib.Helper.makeReactive(
        nge.Cfg.Main, 'lang',
        function(value){
            nge.App.removeSysInstancesMode('lang_' + previousLang);
            nge.App.addSysInstancesMode('lang_' + nge.Cfg.Main.lang);
            previousLang = value;
        }
    );

    this.applyClassicGameBasePsd = function () {
        if (nge.App.ClassicGameBasePsd){
            nge.App[nge.appNS] = nge.Lib.Helper.mergeObjsRecursive(
                nge.App.ClassicGameBasePsd, nge.App[nge.appNS]);
        }
    };

    var additionalComponents = [
        'autospin',
        'bigWin',
        'regularWin',
        'intro',
        'fairyButton',
        'insufficientFundsPopup'
    ];
    
    this.statesReplacements.play = nge.Lib.Helper.mergeArrs(this.statesReplacements.play, additionalComponents);

    if (!nge.Lib.Helper.mobileAndTabletCheck())
        this.statesReplacements.play.splice(this.statesReplacements.play.indexOf('autospinSimple'), 1);

    this.run = function () {
        this.runDefault();
        nge.localData.set('lines.cfg', _linesCfg);
    };
});

