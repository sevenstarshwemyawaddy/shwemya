        { s: 'db_background', e: 'jackpot.start', action: 'stop' },
        { s: 'db_background', e: 'gamble.buttons.hided', action: 'stop' },
        { s: 'db_background', e: 'Transport.close', action: 'stop' },
        { s: 'db_background', e: 'StatesManager.create.end', action: 'stop' },
        { s: 'db_win_1', e: 'gamble.win.1' },
        { s: 'db_win_2', e: 'gamble.win.2' },
        { s: 'db_win_3', e: 'gamble.win.3' },
        { s: 'db_win_4', e: 'gamble.win.4' },
        { s: 'db_win_5', e: 'gamble.win.5' },
        { s: 'db_win_5', e: 'slotMachine.spinStart', action: 'stop' },

        {s: 'denom_change', e: 'bet.up', relaunch: true},
        {s: 'denom_change', e: 'currencySwitcher.switch', relaunch: true},
        {s: 'denom_change', e: 'bet.down', relaunch: true},
        {s: 'denom_change', e: 'denom_change.play', relaunch: true},
        { s: 'denom_change', e: 'coins.up', relaunch: true},
        { s: 'denom_change', e: 'coins.down', relaunch: true},       
        {s: 'denom_change', e: 'coins.upNC', relaunch: true},
        {s: 'denom_change', e: 'coins.downNC', relaunch: true},

        { s: 'sr_win_tiny', e: 'win.tiny', relaunch: true },
        { s: 'sr_win_small', e: 'win.small', relaunch: true },
        { s: 'sr_win_middle', e: 'win.middle', relaunch: true },
        { s: 'sr_win_big', e: 'win.big', relaunch: true },
        { s: 'sr_bell_low', e: 'win.major.low' },
        { s: 'sr_bell_middle', e: 'win.major.middle' },
        { s: 'sr_bell_high', e: 'win.major.high' },
        { s: 'sr_bell_middle', e: 'gamble.take', action: 'stop' },
        { s: 'sr_bell_middle', e: 'slotMachine.spinCommand', action: 'stop' },
        { s: 'sr_bell_middle', e: 'gamble.go', action: 'stop' },
        { s: 'sr_bell_high', e: 'gamble.take', action: 'stop' },
        { s: 'sr_bell_high', e: 'slotMachine.spinCommand', action: 'stop' },
        { s: 'sr_bell_high', e: 'gamble.go', action: 'stop' },
        { s: 'gn_win_counter_take', e: 'gamble.taking.start', action: 'play', loop: true, relaunch: true },
        { s: 'gn_win_counter_take', e: 'gamble.taking.stop', action: 'stop' },
        { s: 'gn_win_counter_stop', e: 'sound.gamble.taking.stop' },

        // jackpots
        { s: 'jackpot_online_won_jackpot_movie', e: 'jackpot.startPopup.show', action: 'play', relaunch: true },
        { s: 'jackpot_online_won_jackpot_movie', e: 'jackpot.win', action: 'play', relaunch: true },
        { s: 'jackpot_online_background', e: 'jackpot.forceClose', action: 'stop' },
        { s: 'jackpot_online_background', e: 'jackpot.show', action: 'play', loop: true },
        { s: 'jackpot_online_background', e: 'jackpot.win', action: 'stop' },
        { s: 'jackpot_online_background', e: 'Transport.close', action: 'stop' },
        { s: 'jackpot_online_finish_jackpot_popup', e: 'jackpot.finalPopup.show', action: 'play' },
        { s: 'jackpot_online_coincidence_1', e: 'jackpot.openSymbol1', action: 'play', relaunch: true },
        { s: 'jackpot_online_coincidence_2', e: 'jackpot.openSymbol2', action: 'play', relaunch: true },
        { s: 'jackpot_online_coincidence_3', e: 'jackpot.openSymbol3', action: 'play', relaunch: true },
  
    ];

    this.constructor = function () {
        var i;

        /**
         * Add slotMachine spin sounds to cfg
         */
        for (i = 0; i < _self.wheelSpinSoundCount; i++) {
            _self._soundCfgBase.push(
                { s: 'bs_wheel_spin_' + i, e: 'slotMachine.reelsStartRandSound.' + i },
                { s: 'bs_wheel_spin_' + i, e: 'slotMachine.spinComplete', action: 'stop' }
            );
        }

        for (i = 0; i < _self.reelsCount; i++) {
            /**
             * Add slotMachine reels stop sounds to cfg
             */
            _self._soundCfgBase.push(
                { s: 'bs_bn_wheel_stop_' + i, e: 'slotMachine.reel_' + i + '.animation.stop.sound' }
            );
            nge.observer.add('slotMachine.reel_' + i + '.animation.stop', _soundStopReelHandler(i), false, true);

            /**
             * Add scatter appearance sounds if needed to cfg
             */
            if (_self.playScatterSounds) {
                _self._soundCfgBase.push(
                    { s: 'bs_bn_scatter_' + i, e: 'scatter_reel_sound_' + i }
                );
            }
        }

        /**
         * Add symbol sounds to cfg
         * including additional stopping logic
         * @param {String} symbol 
         */
        _self.soundedSymbols.forEach(function (symbol) {
            var s = 'S' + nge.Lib.Helper.LdgZero(symbol, 2);

            _self._soundCfgBase.push(
                { s: s, e: 'sound.winLineSymbols.' + symbol },
                { s: s, e: 'gamble.take', action: 'stop' },
                { s: s, e: 'slotMachine.spinCommand', action: 'stop' },
                { s: s, e: 'gamble.go', action: 'stop' }
            );
        });

        nge.localData.set('scatterSymbols', this.scatterSymbols);

        this.winSoundsQueue = nge.App.getInstance('Mlm.Brain.SoundsQueue', false, this, []);
    };

    var _soundStopReelHandler = function (reel) {
        return function () {
            if (!_stopCommandFired || reel === _self.reelsCount - 1) {
                nge.observer.fire('slotMachine.reel_' + reel + '.animation.stop.sound');
            }
        };
    };

    var _onSoundsPreloaded = function () {
        if(nge.Lib.Helper.mobileAndTabletCheck()){
            nge.Lib.Checker.delay(function() {
                return nge.soundManager.isReady();
            }, function() {
                _onSoundsDecoded();
            }, 500, 100, true);
        } else 
            _onSoundsDecoded();
    };

    var _onSoundsDecoded = function () {
        
        if (!nge.Lib.Helper.mobileAndTabletCheck())
            return;

        var silence = nge.soundManager.getSound('silence');
        if (silence)
            silence.play('silence', 0, 1, true);
        else
            console.color('Cannot find sound "silence" in audio sprite', '#ff0000', '#000000');

        var isBonusGame = nge.localData.get('freespin.inProgress') || nge.localData.get('bonusGame.inProgress');
        if (isBonusGame) {
            nge.observer.fire('sounds.preloaded.custom.bonus');
            if (nge.soundManager.checkKey('bn_background'))
                nge.observer.fire('sounds.preloaded.bonus');
        } else {
            nge.observer.fire('sounds.preloaded.custom.simple');
            if (nge.soundManager.checkKey('bs_background'))
                nge.observer.fire('sounds.preloaded.simple');
        }

        if (_dbInProgress)
            nge.observer.fire('gamble.preloaded');
    };

    this.customSubscribe = function () {
        nge.observer.add('sounds.preloaded', _onSoundsPreloaded, false, true);
        nge.observer.add('win', _winHandler, false, true);
        nge.observer.add('winlines.stopAnimation', _winHandler, false, true);
        nge.observer.add('slotMachine.spinStart', _spinStartHandler, false, true);
        nge.observer.add('slotMachine.winLineSymbols', _winLineSymbolsHandler, false, true);
        nge.observer.add('winlines.animateByOne.cycleComplete', _cycleCompleteHandler, false, true);
        nge.observer.add('spinAndWinComplete', _spinAndWinCompleteHandler, false, true);
        
        nge.observer.add('sound.stopped.xw_you_won_intro', _disableGnWaitMusic, false, true);
        nge.observer.add('slotMachine.stopCommand', _stopCommandHandler, false, true);
        nge.observer.add('slotMachine.reel_0.animation.stop', _resetReelsWithScatters, false, true);

        for (var i = 0; i < this.reelsCount; i++) {
            nge.observer.add('slotMachine.reel_' + i + '.animation.stop', this.reelStopHandler(i), false, true);
        }

        var dbInProgressSet = function (value) {
            return function () {
                _dbInProgress = value;
            };
        };

        nge.observer.add('gamble.go', dbInProgressSet(true), false, true);
        nge.observer.add('gamble.resume', dbInProgressSet(true), false, true);
        nge.observer.add('gamble.response', dbInProgressSet(false), false, true);
        nge.observer.add('gamble.take', dbInProgressSet(false), false, true);
        nge.observer.add('jackpot.start', dbInProgressSet(false), false, true);
        nge.observer.add('gamble.buttons.hided', dbInProgressSet(false), false, true);
        nge.observer.add('Transport.close', dbInProgressSet(false), false, true);
        nge.observer.add('StatesManager.create.end', dbInProgressSet(false), false, true);

        this.subscribeWinSoundsStop();
    };

    /**
     * Determines which event is needed to be fired for line win
     * @param {number} amount -
     * @returns {string} - event to be fired
     */
    this.determineWinEvent = function (amount) {
        if (amount <= 10)
            return 'win.tiny';
        if (amount <= 50)
            return 'win.small';
        if (amount <= 75)
            return 'win.middle';
        return 'win.big';
    };

    /**
     * Determines which event is needed to be fired before line win
     * Typically used for bell sounds
     * @param {number} amount -
     * @returns {string|undefined} - event to be fired before line win event
     */
    this.determineMajorWinEvent = function (amount) {
        if (amount >= 1000)
            return 'win.major.high';
        if (amount >= 500)
            return 'win.major.middle';
        if (amount >= 100)
            return 'win.major.low';
    };

    /**
     * Launch winline sound on winline animation start
     * only during the first winline cycle
     * @param {number} data -
     */
    var _winLineSymbolsHandler = function (data) {
        if (!_cycleComplete) {
            _self.winSoundsQueue.reset();
            _self.soundsForSymbolsHandler(data);
            _self.winSoundsQueue.play();
        }
    };

    /**
     * Launches one of the given spin sounds
     */
    var _fireRandomSound = function () {
        var freespinProgress = nge.localData.get('freespin.inProgress');
        var n = nge.Lib.Helper.getRandomInt(0, _self.wheelSpinSoundCount - 1);

        if (_self.playReelsSoundInsideFreespins || !freespinProgress) {
            nge.observer.fire('slotMachine.reelsStartRandSound.' + n);
        }
    };

    /**
     * At the start of the spin launch spin sound
     */
    var _spinStartHandler = function () {
        _stopCommandFired = false;

        _fireRandomSound();
    };

    /**
     * Fires events for gamble waiting sound
     */
    var _cycleCompleteHandler = function () {
        if (!_cycleComplete && _winTriggered)
            nge.observer.fire('winlines.animateByOne.cycleComplete.firstTime');
        _cycleComplete = true;
        _winTriggered = false;
    };

    var _spinAndWinCompleteHandler = function(){
        var freespinInProgress = nge.localData.get('freespin.inProgress');
        if (freespinInProgress || _freespinsStageTwoIsset && _freespinsFirstStageAnimationEnded)
            return;
        _canGamble = nge.localData.get('slotMachine.slotWin.canGamble');
        if (_canGamble === 'true' || _canGamble === true)
            nge.observer.fire('winlines.animateByOne.cycleComplete.firstTimeAndCanGamble');
    };

    var _winHandler = function () {
        _cycleComplete = false;
        _winTriggered = true;
    };

    var _resetReelsWithScatters = function () {
        _reelsWithScatters = [];
    };

    var _stopCommandHandler = function () {
        _stopCommandFired = true;
    };

    this.reelStopHandler = function (reel) {
        return function () {
            if (_self.playScatterSounds) {
                var columns = nge.localData.get('slotMachine.spinResult.columns');

                var isScatterInColumn = columns[reel].some(function (item) {
                    return _self.scatterSymbols.indexOf(item) !== -1;
                });

                /**
                 * Find reel index of reels where scatter can appear
                 * Example: Scatters in columbus can appear at reels 0, 2, 4
                 * so scatter index will be 0, 1, 2 for those reels
                 */

                var scatterReel = reel / Math.round(_self.reelsCount / _self.scatterReelsCount);

                if (isScatterInColumn) {
                    _reelsWithScatters.push(reel);

                    /**
                     * Find reels count on which scatter can still appear
                     * then find count of additional scatters to trigger bonus
                     * then if needed is less than remaining play scatter sound
                     */

                    var remainingReels = _self.scatterReelsCount - 1 - scatterReel;
                    var neededScattersCount = _self.scattersNeededForFreespins - _reelsWithScatters.length;

                    if (neededScattersCount <= remainingReels) {
                        nge.observer.fire('scatter_reel_sound_' + scatterReel);
                    }
                }
            }

            /**
             * Checks whether intrigue sound should play
             * if localData intrigue starts from next reel
             * and next reel exists
             */

            var intrigue = nge.localData.get('slotMachineIntrigue');
            if (intrigue) {
                var nextReel = reel + 1;
                var endsFrom = (intrigue.endsFrom) ? intrigue.endsFrom : Infinity;

                var intrigueSoundShouldPlay =
                    !_stopCommandFired &&
                    nextReel <= _self.reelsCount &&
                    intrigue &&
                    intrigue.status &&
                    intrigue.startsFrom <= nextReel &&
                    endsFrom > nextReel;

                if (intrigueSoundShouldPlay) {
                    nge.observer.fire('slotMachine.reel_' + nextReel + '.intrigue.start');
                }
            }
        };
    };

    /**
     * Override this function to add sounds that are played
     * BEFORE winline sounds and bell sounds
     *
     * @param {object} data -
     */
    this.processPrecedingSounds = function (data) {

    };

    /**
     * Checks whether this winline should be sounded with scatter sounds
     * @param {string[]} symbols -
     * @returns {boolean} -
     */
    this.shouldScatterSoundPlay = function (symbols) {
        return symbols.every(_isScatter) &&
            this.soundedSymbols.indexOf(symbols[0]) !== -1 &&
            symbols.length >= this.scatterCountSoundTrigger;
    };

    /**
     * Responsible for firing winline sound events
     * and setting line animation duration
     * Override if game needs custom line sounds and duration logic
     * @param {object} data -
     * @sub-param {string[]} data.symbolsNames - winline symbols
     * @sub-param {number} data.amount - winline win amount (needs to be converted to credits)
     */
    this.soundsForSymbolsHandler = function (data) {
        /**
         * Determine symbol of combination with accountance for joker
         */
        var symbols = data.symbolsNames.filter(_isNotJoker);
        symbols = symbols.length > 0 ? symbols : data.symbolsNames;
        var symbol = symbols[0];

        var credits = nge.Lib.Money.getCoinsWin(data.amount);

        var symbolSoundIsPlayed =
            this.shouldScatterSoundPlay(symbols) ||
            credits > _self.creditsForSymbolSound &&
            _self.soundedSymbols.filter(_isNotScatter).indexOf(symbol) !== -1;

        var majorWinEvent = _self.determineMajorWinEvent(credits);

        this.processPrecedingSounds(data);

        if (majorWinEvent && !(symbols.every(_isScatter) && symbols.length >= this.scattersNeededForFreespins)) {
            this.winSoundsQueue.push(majorWinEvent);
        }

        /**
         * Winline sound consists of major sound(bell) and win sound (low-high) or symbol sound
         * winline duration is total duration of all played sounds
         */

        if (symbolSoundIsPlayed) {
            var duration = false;
            if (_isNotJoker(symbol) && symbols.length !== data.symbolsNames.length || this.winSoundsQueue.getDuration()) {
                if (!_slotMachineSymbols)
                    _slotMachineSymbols = nge.App.getInstance('Com.SlotMachine.Symbols');

                duration = _slotMachineSymbols.items.filter(function (item) {
                    return item.name === symbol;
                })[0].winlineTime;
            }

            this.winSoundsQueue.push('sound.winLineSymbols.' + symbol, duration);
        } else {
            var event = _self.determineWinEvent(credits);
            this.winSoundsQueue.push(event);
        }

        nge.observer.fire('winlines.setCurrentLineDuration', this.winSoundsQueue.getDuration(), 1);
    };

    this.setFreespinsFirstStageAnimationEnded = function (enable) {
        _freespinsFirstStageAnimationEnded = enable;
    };

    var _isScatter = function (symbol) {
        return ~_self.scatterSymbols.indexOf(symbol);
    };

    var _isNotScatter = function (symbol) {
        return !_isScatter(symbol);
    };

    var _isNotJoker = function (symbol) {
        return _self.jokerSymbols.indexOf(symbol) === -1;
    };

    var _disableGnWaitMusic = function () {
        _canGamble = nge.localData.get('slotMachine.slotWin.canGamble');

        if (_canGamble === 'false' || _canGamble === false) {
            nge.observer.fire('sound.stopped.gn.wait');
        }
    };

    this.subscribeWinSoundsStop = function () {
        var subscribe = function (callback) {
            nge.observer.add('slotMachine.quickFinish.done', callback, false, true);
            nge.observer.add('winlines.stopAnimation', callback, false, true);
            nge.observer.add('Transport.close', callback, false, true);
            nge.observer.add('transportMessage.AuthResponse', callback, false, true);
            nge.observer.add('gamble.take', callback, false, true);
            nge.observer.add('gamble.taking.start', callback, false, true);
            nge.observer.add('gamble.go', callback, false, true);
            //NOTE (r.rakhman): Auto mode triggers unwanted call. Reel King has bug around this one.
            //nge.observer.add('slotMachine.spinCommand', callback, false, true);
            nge.observer.add('slotMachine.spinStart', callback, false, true);
            nge.observer.add('jackpot.start', callback, false, true);
        };

        var stopCallback = this.winSoundsQueue.stop.bind(this.winSoundsQueue);
        subscribe(stopCallback);
        subscribe(function () {
            nge.observer.fire('sounds.stopWinSounds');
            nge.localData.set('sounds.winSoundsQueues.stopped', true);
        });

        nge.observer.add('slotMachine.spinResponse', function (response) {
            _freespinsStageTwoIsset = false;
            if (response.slotWin && response.slotWin.lineWinAmountsStage2)
                _freespinsStageTwoIsset = true;
            nge.localData.set('sounds.winSoundsQueues.stopped', false);
        }, false, true);
    };
});



nge.App[nge.appNS].Mlm.Brain.SoundsQueue = Class.extend(function () {
    var DEFAULT_SOUND_DURATION = 500;

    var _self = this;
    this.data = [];
    this._id = false;
    this._winEventsCache = {};
    this._brainSounds = false;
    this._archiveIds = [];
    this._onStopAnywayCallback = false;
    var _spritemap;
    var _cfgSounds;

    this.constructor = function (brainSounds, q) {
        this._brainSounds = brainSounds;
        if (q && q.length)
            this.data = q;
    };

    this.stop = function () {
        if (this._id) {
            nge.observer.fire('sounds.queue.' + this._id + '.stop');
        }

        for (var i = 0; i < this._archiveIds.length; i++)
            nge.observer.fire('sounds.queue.' + this._archiveIds[i] + '.stop');

        this._archiveIds = [];
        this.data = [];
        this._id = false;

        if (this._onStopAnywayCallback) {
            this._onStopAnywayCallback();
            this._onStopAnywayCallback = false;
        }
    };

    this.reset = function () {
        if (this._id) {
            this._archiveIds.push(this._id);
        }

        this.data = [];
        this._id = false;
    };

    this.play = function () {
        this._id = nge.Lib.Helper.getRandomInt(0, 999999);
        for (var i = 0; i < this.data.length; i++) {
            this._processSoundsQueueStep(this.data[i], i, i === this.data.length - 1, this._id);
        }

        nge.observer.fire('sounds.queue.' + this._id + '.start');

        var queueCompleteEvent = 'sounds.queue.' + this._id + '.complete';
        nge.observer.add(queueCompleteEvent, (function (soundsQueue, id, data) {
            return function () {
                nge.observer.remove(queueCompleteEvent, false, queueCompleteEvent, true);
                for (var i = 0; i < data.length; i++) {
                    soundsQueue._unsubscribeSoundsQueueStep(data[i], i, i === data.length - 1, id);
                }
            };
        })(this, this._id, nge.Lib.Helper.jsObjClone(this.data)), queueCompleteEvent, true);
    };

    this.push = function (event, duration, startCallback) {
        this.data.push({e: event, d: duration, callback: startCallback});
    };

    this.onStopAnyway = function (callback) {
        this._onStopAnywayCallback = false;
        if (callback === false) {
            this._onStopAnywayCallback = false;
        }
        else if (typeof callback === 'function') {
            this._onStopAnywayCallback = callback;
        }
        else if (typeof callback === 'string') {
            this._onStopAnywayCallback = function () {
                nge.observer.fire(callback);
            };
        }
    };

    this.getDuration = function () {
        var duration = 0;
        for (var i = 0; i < this.data.length; i++) {
            var stepData = this.data[i];
            if (stepData.d)
                duration += stepData.d;
            else {
                var s = this._getSoundByEvent(stepData.e);

                if (!s) {
                    console.error('[Sound Queue] No sound for event: ' + stepData.e);
                    return;
                }

                duration += nge.soundManager.checkKey(s)
                    ? nge.soundManager.getDurationMS(s) || DEFAULT_SOUND_DURATION
                    : this._getDurationFromUber(s) || DEFAULT_SOUND_DURATION;
            }
        }

        return duration;
    };

    this._getDurationFromUber = function (s) {
        if (!_spritemap) {
            var uber_json = null;
            if (nge.wrap.cache.checkJSONKey('uber_json'))
                uber_json = nge.wrap.cache.getJSON('uber_json');
            if (uber_json && uber_json['gameaudio.json']) {
                _spritemap = uber_json['gameaudio.json'].spritemap;
            }
        }

        if (!_cfgSounds)
            _cfgSounds = nge.App.getInstance('Cfg.Sounds').contents;

        if (_spritemap && _cfgSounds && _cfgSounds[s]) {
            var sData = _spritemap[_cfgSounds[s].split('/').pop()];
            if (sData)
                return (+sData.end - +sData.start) * 1000;
        }

        return false;
    };

    this._unsubscribeSoundsQueueStep = function (stepData, stepIndex, isLast, queueId) {
        var startEvent = stepIndex === 0
            ? 'sounds.queue.' + queueId + '.start'
            : 'sounds.queue.' + queueId + '.step.' + (stepIndex - 1) + '.complete';
        var eNameStart = 'sounds.queue.' + queueId + '.step.' + stepIndex + '.start';
        nge.observer.remove(startEvent, false, eNameStart, true);
    };

    this._processSoundsQueueStep = function (stepData, stepIndex, isLast, queueId) {
        if (!stepData.d && stepData.e && _self._brainSounds.winSoundsDurations[stepData.e])
            stepData.d = _self._brainSounds.winSoundsDurations[stepData.e];

        if (stepData.d === 'dynamic')
            stepData.d = false;

        if (!stepData.e && !stepData.d) {
            console.error('[Sound Queue] No sound event and no duration.');
            return;
        }

        var s = this._getSoundByEvent(stepData.e);

        if (stepData.e && !s) {
            console.error('[Sound Queue] No sound for event: ' + stepData.e);
            return;
        }

        if (s) {
            this._forceSoundRelaunch(stepData.e);
            this._subscribeStopEvent(stepData.e, s);
        }

        var queueCompleteEvent = 'sounds.queue.' + queueId + '.complete';
        var soundStopEvent = stepData.e + '.stop';
        var stopEvent = 'sounds.queue.' + queueId + '.stop';
        var eNameStop = 'sounds.queue.' + queueId + '.step.' + stepIndex + '.stop';
        var completeEvent = isLast
            ? queueCompleteEvent
            : 'sounds.queue.' + queueId + '.step.' + stepIndex + '.complete';
        var eNameComplete = 'sounds.queue.' + queueId + '.step.' + stepIndex + '.complete';
        var startEvent = stepIndex === 0
            ? 'sounds.queue.' + queueId + '.start'
            : 'sounds.queue.' + queueId + '.step.' + (stepIndex - 1) + '.complete';
        var eNameStart = 'sounds.queue.' + queueId + '.step.' + stepIndex + '.start';

        var customCallback;
        if (typeof stepData.callback === 'function') {
            customCallback = stepData.callback;
        }
        else if (typeof stepData.callback === 'string') {
            customCallback = function () {
                nge.observer.fire(stepData.callback);
            };
        }

        nge.observer.add(startEvent, function () {
            var id;

            if (s) {
                nge.observer.fire(stepData.e);
            }

            if (stepData.d) {
                id = nge.rafSetTimeout(function () {
                    nge.observer.fire(completeEvent);
                }, stepData.d);
            }
            else {
                nge.rafSetTimeout(function () {
                    nge.observer.add('sound.stopped.' + s, function () {
                        nge.observer.fire(completeEvent);
                    }, eNameComplete, true);
                }, 1);
            }

            if (customCallback)
                customCallback();

            nge.observer.add(stopEvent, function () {
                nge.observer.remove(stopEvent, false, eNameStop, true);
                nge.observer.remove(completeEvent, false, eNameStop, true);

                if (s) {
                    nge.observer.remove('sound.stopped.' + s, false, eNameComplete, true);
                }

                if (s) {
                    nge.observer.fire(soundStopEvent);
                }

                if (stepData.d) {
                    nge.rafClearTimeout(id);
                }

                nge.observer.fire(queueCompleteEvent);
            }, eNameStop, true);

            nge.observer.add(completeEvent, function () {
                if (s) {
                    nge.observer.remove('sound.stopped.' + s, false, eNameComplete, true);
                }
            }, eNameStop, true);
        }, eNameStart, true);
    };

    this._subscribeStopEvent = function (e, s) {
        var soundCfg = {e: e + '.stop', s: s, action: 'stop'};
        var eName = 'sound.' + soundCfg.e + '-' + soundCfg.s;
        nge.observer.remove(soundCfg.e, false, eName);

        (function (soundCfg, eName) {
            nge.observer.add(
                soundCfg.e,
                function () {
                    nge.observer.fire('sound.' + soundCfg.action, soundCfg);
                },
                eName,
                true
            );
        })(soundCfg, eName);
    };

    this._getSoundByEvent = function(e) {
        if (!e)
            return false;

        if (_self._winEventsCache[e])
            return _self._winEventsCache[e];

        var totalSoundsArr = nge.localData.get('brain.sounds.cfg');
        var cfg = nge.Lib.Helper.objFindEl(
            totalSoundsArr,
            function (cfg) {
                return cfg.e === e && (!cfg.action || cfg.action === 'play');
            }
        );

        if (cfg) {
            _self._winEventsCache[e] = cfg.s;
            return cfg.s;
        }
        else {
            return false;
        }
    };

    this._forceSoundRelaunch = function (e) {
        if (!e)
            return;

        var totalSoundsArr = nge.localData.get('brain.sounds.cfg');
        var cfg = nge.Lib.Helper.objFindEl(
            totalSoundsArr,
            function (cfg) {
                return cfg.e === e && (!cfg.action || cfg.action === 'play');
            }
        );

        if (cfg)
            cfg.relaunch = true;
    };
});



nge.App[nge.appNS].Mlm.Brain.Slot = nge.Mlm.Brain.Slot.extend(function () {
    var _self = this;
    var _gambleTaking = false;
    var _gambleLastTakeTime = 0;
    var _freeSpinWin = 0;
    var _lastData;
    var _autospinBalanceRequested = false;
    var _balanceRequested = false;
    var _canSpin = true;

    var _resolutions = null;
    var _takeButtonWasPressed;

    var _spinWin = 0;
    var _cycleComplete = false;

    var _winValueTween;

    this.canIntrigue = false;
    this._winColor = '#ff8600';

    this.creditsWinDefaultValue = 'GOOD LUCK';

    var _getLastWin = function () {
        return nge.localData.get('brain.roundWin') || 0;
    };

    var _setLastWin = function (lw) {
        nge.localData.set('brain.roundWin', lw);
    };

    var _winHandler = function (num) {
        _cycleComplete = false;

        _setLastWin(parseFloat(num));
        var freespinProgress = nge.localData.get('freespin.inProgress');
        var respinProgress = nge.localData.get('respin.inProgress');

        if (freespinProgress || respinProgress) {
            _spinWin = _toCoins(_freeSpinWin);
            _freeSpinWin += parseFloat(num);
            _updateLocalDataFreeSpinsTotalWin();
        } else {
            _spinWin = 0;
            _freeSpinWin = 0;
        }
    };

    var _gameOverHandler = function () {
        _setLastWin(0);

        var freespinProgress = nge.localData.get('freespin.inProgress');
        var freeGames = nge.localData.get('freeGame.amount');
        var respinInprogress = nge.localData.get('respin.inProgress');
        if (freespinProgress || freeGames || respinInprogress)
            return false;

        nge.observer.fire('infoPanel.showText', {position: 'up'});
        nge.observer.fire('infoPanel.showText', {
            text: nge.i18n.get('GAME OVER. PLACE YOUR BET'),
            position: 'down'
        });
    };

    this._gambleResponse = function (data) {
        if (typeof data.winning === 'undefined' || typeof data.winning === 'undefined')
            return false;

        _setLastWin(parseFloat(data.winning));
        var displayWin = _toCoins(data.winning);

        if (displayWin === 0) {
            _gameOverHandler();
            _self._balanceRequest();
            nge.observer.fire('win.printMessage', _self.creditsWinDefaultValue, 100);
        } else {
            nge.observer.fire('infoPanel.showText', _self.getWinData(displayWin));
            nge.observer.fire('creditsWin.setValue', displayWin);
        }
    };

    var _isComplete = false;

    this.gambleTakeHandler = function () {
        if (_gambleTaking) {
            _gambleTaking = false;
            return true;
        }
        if (_takeButtonWasPressed)
            return true;
        _takeButtonWasPressed = true;

        var time = nge.Lib.Time.get();
        if (time < _gambleLastTakeTime + 500)
            return false; //do not cheating
        var cv = nge.localData.get('coins.value');
        var win = _toCoins(_getLastWin());
        var winnerPaid = win;
        nge.observer.fire('gamble.taking.start');
        _gambleTaking = true;
        _gambleLastTakeTime = time;

        var balance = parseFloat(nge.localData.get('balance.totalAmount'));

        var decreaseSpeed = 1000;
        var decreaseTimeout = 100;
        var tics = decreaseSpeed / decreaseTimeout;
        var winStep = parseInt(win / tics);
        if (winStep < 1)
            winStep = 1;

        var winDecrease = function () {
            if (!_gambleTaking || win === 0 || win < winStep) {
                completeCallback();
                return true;
            }
            // var balance = nge.localData.get('balance.totalAmount');
            // balance = parseFloat(balance) + winStep * cv;
            balance += winStep * cv;

            nge.observer.fire('balance.amount', {totalAmount: balance});

            win -= winStep;
            
            nge.observer.fire('win.change', win);
            nge.observer.fire('creditsWin.setValue', win || ' ');
            nge.observer.fire('win.winField.setValue', win || ' ');
            nge.observer.fire('infoPanel.showText', _self.getWinData(win));

            nge.rafSetTimeout(winDecrease, decreaseTimeout);
        };

        var completeCallback = function () {
            if (_isComplete) {
                return;
            }
            _isComplete = true;
            nge.rafSetTimeout(function () {
                _isComplete = false;
            }, tics);

            nge.observer.fire('gamble.taking.stop');

            _gambleTaking = false;
            _gameOverHandler();
    
            _self.winDecreaseTextComplete(winnerPaid, win);

            _self._balanceRequest();
        };

        winDecrease();
    };

    this.winDecreaseTextComplete = function(winnerPaid, win){
        var text = '';
        var colorFrom = 0;
        if (winnerPaid > 0) {
            nge.observer.fire('sound.gamble.taking.stop');
            text = nge.i18n.get('WINNER PAID') + ' ';
            colorFrom = text.length;
            text += winnerPaid + ' '; // ' ' is for correct winNumber output

            nge.observer.fire('creditsWin.setValue', winnerPaid);
            nge.observer.fire('win.winField.setValue', win || ' ');
            nge.observer.fire('infoPanel.showText', _self.getWinnerData(text, colorFrom));
        }
    };

    this._balanceRequest = function () {

        var freespinProgress = nge.localData.get('freespin.inProgress');
        var respinInprogress = nge.localData.get('respin.inProgress');
        var jackpotCanPlayRequested = nge.localData.get('jackpot.jackpotCanPlayRequested');

        if (freespinProgress || respinInprogress || jackpotCanPlayRequested)
            return false;

        nge.observer.fire('balanceRequest');
    };

    var _spinCommandHandler = function () {
        if(!_resolutions)
            _resolutions = nge.App.getInstance('Cfg.Resolutions');

        _gambleTaking = false;
        _takeButtonWasPressed = false;
        _freeSpinsInfoUpdate();

        var freespinProgress = nge.localData.get('freespin.inProgress');
        var freeGames = nge.localData.get('freeGame.amount');
        var respinInprogress = nge.localData.get('respin.inProgress');
        if (freespinProgress || freeGames || respinInprogress)
            return false;

        nge.observer.fire('win.printMessage', _self.creditsWinDefaultValue);
        
        nge.observer.fire('infoPanel.showText', {position: 'up'});
        nge.observer.fire('infoPanel.showText', {
            text: nge.i18n.get('GOOD LUCK'),
            position: 'down',
            fontSize: 18 / (1920 / _resolutions.contents[0].width || 1920)
        });
    };

    var _slotMachineStopCommandHandler = function () {
        _autospinBalanceRequested = false;
        nge.observer.fire('buttons.hideAntiButtons');
    };

    var _updateLocalDataFreeSpinsTotalWin = function () {
        nge.localData.set('freespin.totalWin', _freeSpinWin);
        nge.localData.set('freespin.totalWinCoins', _toCoins(_freeSpinWin));
    };

    this.updateFreespinWin = function(win){
        nge.observer.fire('infoPanel.showText', _self.getWinData(win));
        nge.observer.fire('creditsWin.setValue', win);
    };

    var _freespinStartHandler = function () {
        var freeSpinCounter;
        var freespinProgress = nge.localData.get('freespin.inProgress');

        if (!freespinProgress) {
            _freeSpinWin = _getLastWin();
            var win = _toCoins(_freeSpinWin);
            _updateLocalDataFreeSpinsTotalWin();

            _self.updateFreespinWin(win);
        }

        _updateFreeSpinCounters();

        var freespinTotalCount = nge.localData.get('freespin.spinsTotal');
        var spinsLeft = nge.localData.get('freespin.spinsLeft');
        var respinInprogress = nge.localData.get('respin.inProgress');
        _prevFreeSpinCounter = spinsLeft;
        freeSpinCounter = freespinTotalCount - spinsLeft + 1;

        if (freeSpinCounter > freespinTotalCount)
            freeSpinCounter = freespinTotalCount;


        if (freeSpinCounter && freespinTotalCount && !respinInprogress)
            _self.printFreesinData(freeSpinCounter, freespinTotalCount);
        
           
    };

    this.printFreesinData = function(freeSpinCounter, freespinTotalCount){
        nge.observer.fire('infoPanel.showText', {
            text: _self.getInfoEventDownText(freeSpinCounter, freespinTotalCount),
            position: 'down',
            colors: [{color: _self._winColor, from: 0}]
        });
        nge.observer.fire('freespin.counterUpdate', {current: freeSpinCounter, total: freespinTotalCount});
    };

    this.getInfoEventDownText = function (arg1, arg2) {
        return nge.i18n.applyTextParams(nge.i18n.get('FREE GAME %(arg1)s OF %(arg2)s'), {
            arg1: arg1,
            arg2: arg2
        });
    };

    var _freespinEndHandler = function () {
        var fsTotalWin = nge.localData.get('freespin.totalWin');
        _setLastWin(fsTotalWin);
        var win = _toCoins(fsTotalWin);

        _self.updateFreespinWin(win);

        nge.observer.fire('freespin.totalWin', fsTotalWin);

        _freeSpinWin = 0;
    };

    var _respinEndHandler = function () {
        var fsTotalWin = nge.localData.get('freespin.totalWin');
        _setLastWin(fsTotalWin);
        var win = _toCoins(fsTotalWin);

        nge.observer.fire('infoPanel.showText', _self.getWinData(win));
        nge.observer.fire('creditsWin.setValue', win);

        nge.observer.fire('freespin.totalWin', fsTotalWin);

        _freeSpinWin = 0;
    };

    var _updateFreeSpinCounters = function () {
        //check if freeRespins ... need update freespin counters
        var fsInProgress = nge.localData.get('freespin.inProgress');
        if (fsInProgress) {
            var remain = nge.localData.get('slotMachine.freeSpinRemain');
            if (remain)
                nge.localData.set('freespin.spinsLeft', parseInt(remain));

            var total = nge.localData.get('slotMachine.freeSpinsTotal');
            if (total)
                nge.localData.set('freespin.spinsTotal', parseInt(total));
        }
    };

    var _freeSpinsInfoUpdate = function () {
        var freespinProgress = nge.localData.get('freespin.inProgress');
        if (!freespinProgress)
            return false;

        var freespinTotalCount = nge.localData.get('freespin.spinsTotal');
        var spinsLeft = nge.localData.get('freespin.spinsLeft');
        var respinInprogress = nge.localData.get('respin.inProgress');

        var freeSpinCounter = freespinTotalCount - spinsLeft + 1;

        if (freeSpinCounter > freespinTotalCount)
            freeSpinCounter = freespinTotalCount;

        if (freeSpinCounter >= 0 && freespinTotalCount >= 0 && !respinInprogress) {
            nge.observer.fire('infoPanel.showText', {
                text: _self.getInfoEventDownText(freeSpinCounter, freespinTotalCount),
                position: 'down',
                colors: [{color: _self._winColor, from: 0}]
            });
            nge.observer.fire('freespin.counterUpdate', {current: freeSpinCounter, total: freespinTotalCount});
        }
    };

    var _freespinRestoreTextHandler = function (lastWin) {
        _spinWin = 0;
        _increaseWin(_toCoins(lastWin));
    };

    var _toCoins = function (n) {
        var cv = nge.localData.get('coins.value');
        return parseFloat((n / cv).toFixed(2));
    };

    var _linesSetHandler = function () {
        nge.observer.fire('winlines.stopAnimation');
    };

    this.updateData = function (data) {
        _lastData = data;
        this.super.updateData(data);
    };

    this.getLastData = function () {
        return _lastData;
    };

    this.spinCompleteHandler = function () {
        
        var data = _lastData;

        var isBonus = _self.checkIfBonus();
        nge.localData.set('bonusWon', false);
        if (isBonus) {
            nge.localData.set('bonusWon', true);
            _self.animateBonusSymbols();

            _self.runBonusGame();
        }
        //run all win lines animation
        if (data.slotWin && data.slotWin.lineWinAmounts) {
            if (data.slotWin.lineWinAmounts.length ||
                data.slotWin.jackpotWin) {

                _self.winlinesAnimateAll();
            }
        } else {
            nge.observer.fire('winlines.animateAllDone');
            nge.observer.fire('winlines.animateByOne.cycleComplete');
        }

        var autospinInProgress = nge.localData.get('autospin.inProgress');
        var freespinInProgress = nge.localData.get('freespin.inProgress');

        if (!autospinInProgress && !freespinInProgress && !isBonus) {
            nge.observer.fire('spinButton.enable');
            _self.enableButtons();
        }

        _self.checkJackPot(isBonus);

        var totalWin = 0;
        if (_lastData.slotWin && _lastData.slotWin.totalWin)
            totalWin = _lastData.slotWin.totalWin;

        if (totalWin > 0 || isBonus) {
            nge.observer.fire('win', totalWin);
            //chk bigWin
            _self.checkBigWin(totalWin, isBonus);
        }

        if (!isBonus && totalWin === 0)
            nge.observer.fire('loose');
    };

    var _setNewQueryHandler = function () {
        _cycleComplete = false;
    };

    this.printWin = function (value) {
        nge.observer.fire('infoPanel.showText', _self.getWinData(value || _spinWin));
        nge.observer.fire('creditsWin.setValue', (value || _spinWin));
    };

    var _increaseWin = function (amount) {
        _spinWin += amount;
        _self.printWin();
    };

    this.setSlotWin = function (win) {
        _spinWin = win;
    };

    this.increaseWinSpeed = function () {
        return 500;
    };

    this.getWinValueTween = function(){
        return _winValueTween;
    };

    var _playWinlineHighlightAnimation = function (lineWin) {
        // stop previous tween if exists
        if (_winValueTween) {
            _winValueTween.stop();
        }

        // set tween 'from' point to current win value and create new tween
        var tweenData = {value: _spinWin};
        _winValueTween = nge.tween.add(tweenData);

        // set tween 'to' point to next win value
        _spinWin += lineWin;
        _winValueTween.to({value: _spinWin}, _self.increaseWinSpeed());

        // print inbetween values (from 'from' to 'to')
        _winValueTween.onUpdateCallback(function () {
            _self.printWin(Math.ceil(~~this.value));
        }, tweenData);

        // when done, print final win value
        _winValueTween.onComplete.add(function () {
            _self.printWin();
        });
        _winValueTween.start();
    };

    var _winlineHighLightHandler = function (data) {
        if (!_cycleComplete) {
            var lineWin = data.amount ? _toCoins(data.amount) : 0;

            var winShoudAnimate = nge.Cfg.Main.slotType === 'deluxe';

            if (winShoudAnimate) {
                _playWinlineHighlightAnimation(lineWin);
            } else {
                _increaseWin(lineWin);
            }
        }
    };

    var _showGambleText = function () {
        nge.observer.fire('infoPanel.showText', {
            text: nge.i18n.get('GAMBLE UP TO 5x OR TAKE WIN'),
            position: 'down'
        });
    };

    var _winlinesCompleteHandler = function () {

        nge.rafSetTimeout(function(){
            _canSpin = true;
        }, 1);

        var as = nge.localData.get('autospin');
        var canGamble = nge.localData.get('slotMachine.slotWin.canGamble');
        var freespinProgress = nge.localData.get('freespin.inProgress');
        var respinProgress = nge.localData.get('respin.inProgress');

        if (as && !_autospinBalanceRequested) {
            // _balanceRequest(); Deprecated by Yurii at 19.12.16
            _autospinBalanceRequested = true;
        } else if (!freespinProgress && !respinProgress && (canGamble === true || canGamble === 'true') && !_cycleComplete) {
            _showGambleText();
        }

        _cycleComplete = true;
    };

    var _clearDownText = function () {
        if (!nge.localData.get('freeGame.inProgress')) {
            nge.observer.fire('infoPanel.showText', {
                text: '',
                position: 'down'
            });
        }
    };

    var _spinCompleteHandler = function () {
        var freespinInProgress = nge.localData.get('freespin.inProgress');
        var respinInprogress = nge.localData.get('respin.inProgress');

        if (!freespinInProgress && !respinInprogress) {
            _clearDownText();
        }

        _updateFreeSpinCounters();
    };

    var _freespinRestoreHandler = function () {
        nge.observer.fire('buttons.disable', true);
    };

    var _looseHandler = function () {
        _self._balanceRequest();
        _gameOverHandler();
    };

    this.setIntrigue = function (data) {
        nge.localData.set('slotMachineIntrigue', {status: false});

        var soundsBrain = nge.brain._logicBlocksInstances.sounds;
        var isIntrigueOn = _self.canIntrigue && soundsBrain.scatterSymbols.length > 0;

        if (!isIntrigueOn) {
            return;
        }

        var columns = data.spinResult.columns;
        var reelsWithScatters = [];

        for (var reel = 0; reel < columns.length; reel++) {
            var columnContainsScatter = columns[reel].some(function (item) {
                return soundsBrain.scatterSymbols.indexOf(item) !== -1;
            });

            var scatterReel = reel / Math.round(soundsBrain.reelsCount / soundsBrain.scatterReelsCount);

            if (columnContainsScatter) {
                reelsWithScatters.push(reel);

                var remainingReels = soundsBrain.scatterReelsCount - 1 - scatterReel;
                var neededScattersCount = soundsBrain.scattersNeededForFreespins - reelsWithScatters.length;

                if (neededScattersCount === 1 && remainingReels > 0) {
                    nge.localData.set('slotMachineIntrigue', {status: true, startsFrom: reel + 1});
                    nge.observer.fire('slotMachineIntrigue', reel);
                    break;
                }
            }
        }
    };

    var _spinResponseHandler = function (data) {
        _canSpin = !_self.checkIfBonus();
        _self.setIntrigue(data);
    };

    var _authHandler = function (data) {
        data = data.data;
        var actions = (data.actions) ? data.actions : false;
        nge.localData.set('actions', actions);

        _resetFlags();
    };

    var _resetFlags = function () {
        _freeSpinWin = 0;
        _canSpin = true;
    };

    var _applyOfferRequest = function (id) {
        var mm = nge.App.getInstance('Mlm.Transport.Models.ApplyOfferRequest', false, {
            'msgId': '37e88b5c-18e9-9075-1720-d77e12802e49',
            'gsId': _self.getGsId(),
            'result': true,
            'data': {'id': id}
        });
        nge.transport.send(mm);
    };

    var _cancelOfferRequest = function (id) {
        var gsId = _self.getGsId();
        var mm = nge.App.getInstance('Mlm.Transport.Models.CancelOfferRequest', false, {
            'msgId': '37e88b5c-18e9-9075-1720-d77e12802e49',
            'gsId': gsId,
            'result': true,
            'data': {'id': id}
        });
        nge.transport.send(mm);
    };

    var _finishOfferResponseHandler = function (response) {
        var data = response.data;
        nge.observer.fire('offer.finishOfferResponse', data);
    };

    /**
     * Method for getting win data object for infoPanel.text event
     * Method added for redefining in children's classeses
     * @param winAmount {Number} win line amount value
     * @return {Object}
     */
    this.getWinData = function (winAmount) {
        var text = nge.i18n.get('WIN');
        var colorFrom = text.length;
        return {
            text: text + ' ' + winAmount,
            position: 'up',
            colors: [{color: _self._winColor, from: colorFrom}]
        };
    };

    this.customCheckCanSpin = function () {
        if (nge.localData.get('jackpot.checkPlay') === true || nge.localData.get('jackpot.inProgress') === true || _balanceRequested || !_canSpin)
            return false;
        return true;
    };

    /**
     * Method for setting winner data
     * Method added for redefining in children's classeses
     * @param text {String} WINNER PAID value text
     * @param {Number} colorFrom
     * @return {Object}
     */
    this.getWinnerData = function (text, colorFrom) {
        if (typeof colorFrom === 'undefined')
            colorFrom = 12;

        return {
            text: text,
            position: 'up',
            colors: [{color: _self._winColor, from: colorFrom}]
        };
    };

    this.respinEndHandler = function () {
        if (_getLastWin() === 0)
            _self._balanceRequest();
    };

    this.checkStartFreespinGame = function (slotMachineData) {

        var freespinData = nge.localData.get('freespin');
        var isFreespinAction = slotMachineData.state === 'FreeSpins';

        // check all avail situations on freespin start
        return ((+freespinData.spinsTotal === +freespinData.spinsLeft) > 0) ||
            (freespinData.inProgress && !freespinData.spinsTotal) ||
            (isFreespinAction && !freespinData.inProgress);
    };

    this.quickFinishHandler = function () {
        var freespinData = nge.localData.get('freespin');
        var slotMachineData = nge.localData.get('slotMachine');

        var isFreeSpinStart = this.checkStartFreespinGame(slotMachineData);

        if (!slotMachineData.slotWin || isFreeSpinStart)
            return;

        if (_winValueTween)
            _winValueTween.stop();

        var winValue = freespinData.inProgress ?
            freespinData.totalWin :
            slotMachineData.slotWin.totalWin;

        var coinsTotal = _toCoins(+winValue);

        _self.printWin(coinsTotal);
        nge.observer.fire('winlines.animateByOne.cycleComplete');
        nge.observer.fire('slotMachine.quickFinish.done');
    };

    var _resetWinNumbers = function () {
        nge.observer.fire('win.printMessage', _self.creditsWinDefaultValue);
    };

    var _onBalanceRequest = function () {
        _balanceRequested = true;
    };

    var _onBalanceResponse = function () {
        _balanceRequested = false;
    };

    this.customSubscribe = function () {
        nge.observer.add('respin.end', _self.respinEndHandler, false, true);
        nge.observer.add('lines.set', _linesSetHandler, false, true);
        nge.observer.add('loose', _looseHandler, false, true);
        nge.observer.add('gamble.take', _self.gambleTakeHandler, false, true);
        nge.observer.add('win', _winHandler, false, true);
        nge.observer.add('gamble.response', _self._gambleResponse, false, true);
        nge.observer.add('slotMachine.spinCommand', _spinCommandHandler, false, true);
        nge.observer.add('slotMachine.spinComplete', _spinCompleteHandler, false, true);
        // nge.observer.add('gamble.go', _gambleHandler, false, true); Deprecated by Yurii at 21.11.16
        nge.observer.add('slotMachine.stopCommand', _slotMachineStopCommandHandler, false, true);
        nge.observer.add('freespin.startProcess.end', _freespinStartHandler, false, true);
        nge.observer.add('respin.startProcess.end', _freespinStartHandler, false, true);
        nge.observer.add('freespin.restoreText', _freeSpinsInfoUpdate, false, true);
        nge.observer.add('freespin.restoreText', _winHandler, false, true);
        nge.observer.add('freespin.restoreText', _freespinRestoreTextHandler, false, true);
        nge.observer.add('freespin.end', _freespinEndHandler, false, true);
        nge.observer.add('respin.end', _respinEndHandler, false, true);
        nge.observer.add('winlines.lineHighlite.start', _winlineHighLightHandler, false, true);
        nge.observer.add('winlines.setNewQuery', _setNewQueryHandler, false, true);
        nge.observer.add('spinAndWinComplete', _winlinesCompleteHandler, false, true);
        nge.observer.add('freespin.restore', _freespinRestoreHandler, false, true);
        nge.observer.add('slotMachine.spinResponse', _spinResponseHandler, false, true);
        nge.observer.add('slotMachine.spinFailed.noBalance', _gameOverHandler, false, true);
        nge.observer.add('popupFinish.animate.start', _clearDownText, false, true);
        nge.observer.add('gamble.showGambleButtons', _showGambleText, false, true);
        //actions
        nge.observer.add('transportMessage.AuthResponse', _authHandler, false, true);
        nge.observer.add('offer.apply', _applyOfferRequest, false, true);
        nge.observer.add('offer.cancel', _cancelOfferRequest, false, true);
        nge.observer.add('transportMessage.FinishOfferResponse', _finishOfferResponseHandler, false, true);

        // quick finish handler
        nge.observer.add('slotMachine.quickFinish', this.quickFinishHandler, false, true);

        // nge.observer.add('creditsWin.setValue', _creditsWinSetValue, false, true);

        nge.observer.add('StatesManager.create.end', _resetWinNumbers, false, true);

        nge.observer.add('balanceRequest', _onBalanceRequest, false, true);
        nge.observer.add('transportMessage.BalanceResponse', _onBalanceResponse, false, true);
    };

});



nge.App[nge.appNS].Mlm.Brain.Win = Class.extend(function () {
    var _self = this;

    this.winHandler = function (data) {
        nge.observer.fire('win.winAmount.add', data);
    };

    this.quickSpinHandler = function() {
        nge.observer.fire('win.abortWin');
    };

    this.winFieldSetValueHandler = function(value) {
        nge.observer.fire('win.winField.setValue', value);
    };

    this.restoreTextHandler = function(winAmount) {
        nge.observer.fire('win.winField.showRestoredWin', winAmount);
    };

    this.freespinEndHandler = function() {
        nge.observer.fire('win.winAmount.reset');
    };

    this.lineHighlightStartHandler = function(data) {
        nge.observer.fire('win.lineWin.start.do', data);
    };

    this.winHideHandler = function() {
        nge.observer.fire('win.hide');
    };

    this.lineWinAnimationStartHandler = function() {
        nge.observer.fire('sounds.win.regularWinLinePlayByOneWin.stop');
        nge.observer.fire('sounds.win.regularWinLinePlayByOneWin.play');
    };

    this.hideLineWinHandler = function() {
        nge.observer.fire('win.lineWin.hide.do');
        nge.observer.fire('winlines.stopAnimation');
    };

    this.showLineWinHandler = function() {
        nge.observer.fire('winlines.setNewQuery', nge.localData.get('slotMachine'));
        nge.observer.fire('winlines.animateByOne', null, 400);
    };

    this.regularPopupShowHandler = function() {
        nge.observer.fire('win.regular.show');
        nge.observer.fire('sounds.win.regularWinAllLinesWin');
        nge.observer.fire('sounds.win.counterClicking.play');
    };

    this.regularWinCounterCompleteHandler = function() {
        nge.observer.fire('sounds.win.counterClicking.stop');
    };

    this.bigWinShowHandler = function() {
        nge.observer.fire('winlines.pauseAnimation', false);
        nge.observer.fire('sounds.win.counterClicking.play');
    };

    this.bigWinCounterCompleteHandler = function() {
        nge.observer.fire('sounds.win.counterClicking.stop'); 
    };

    this.bigWinHideHandler = function() {
        nge.observer.fire('winlines.animateAll');
        nge.observer.fire('winlines.animateAllDone');

        if(nge.localData.get('freespin.inProgress'))
            nge.observer.fire('winlines.animateByOne.cycleComplete', 1);
    };

    this.winAnimationCompleteHandler = function() {
        nge.observer.fire('win.animationComplete');
    };

    this.winSetCreditsValueHandler = function(value) {
        nge.observer.fire('creditsWin.setValue', value);
    };

    this.winlineOnHideDoneHandler = function() {
        nge.observer.fire('win.lineWin.hide.done');
    };

    this.showWinPopupHandler = function(data) {
        var totalWin = nge.Lib.Money.toCoins(data.totalWin);
        if (totalWin === 0) {
            nge.observer.fire('win.animationComplete');
            return;
        }
        if (data.isBigWin)
            nge.observer.fire('win.bigWin.startShow', totalWin);
        else
            nge.observer.fire('win.regularWin.startShow', totalWin);
    };

    this.subscribe = function(){
        nge.observer.add('winData', _self.winHandler, false, true);
        nge.observer.add('win.winAmount.add', _self.showWinPopupHandler, false, true);
        nge.observer.add('win.brain.animationComplete', _self.winAnimationCompleteHandler, false, true);
        nge.observer.add('win.brain.setValue', _self.winSetCreditsValueHandler, false, true);
        nge.observer.add('win.brain.lineWin.animation.start', _self.lineWinAnimationStartHandler, false, true);
        nge.observer.add('win.brain.lineWin.hide', _self.winlineOnHideDoneHandler, false, true);

        // nge.observer.add('slotMachine.spinStart', _self.spinStartHandler, false, true);
        nge.observer.add('slotMachine.quickSpin', _self.quickSpinHandler, false, true);
        
        nge.observer.add('creditsWin.setValue', _self.winFieldSetValueHandler, false, true); 
        nge.observer.add('freespin.restoreText', _self.restoreTextHandler, false, true);
        nge.observer.add('freespin.end', _self.freespinEndHandler, false, true);

        nge.observer.add('winlines.lineHighlite.start', _self.lineHighlightStartHandler, false, true);
        nge.observer.add('win.brain.regular.show', _self.regularPopupShowHandler, false, true);
        nge.observer.add('win.brain.regular.counterComplete', _self.regularWinCounterCompleteHandler, false, true);

        nge.observer.add('win.big.show', _self.bigWinShowHandler, false, true);
        nge.observer.add('win.big.hide', _self.bigWinHideHandler, false, true);
        nge.observer.add('win.big.counterComplete', _self.bigWinCounterCompleteHandler, false, true);
    };
});



nge.App[nge.appNS].Mlm.Brain.Mobile = {};



nge.App[nge.appNS].Mlm.Brain.Mobile.Buttons = Class.extend(function () {

    this.enableNewLogic = false;

    var _self = this;
    var _customButton01Enabled;
    var _customButton02Enabled;
    var _cycleComplete;
    var _isWin;

    var _buttonsWasCreated = false;
    var _scenesWasCreated = false;

    var _offerFinishFlag;
    
    this.bonusGameStartEvent = 'freespin.press.spinButton';
    this.stopCommandEvent = 'slotMachine.stopCommand';

    this.holdEnabled = true;
    this.disableAutoButton = false;

    var _autoOnText = nge.i18n.get('AUTO\n  OFF');
    var _autoOffText = nge.i18n.get('AUTO\n  ON');

    var _mobileButtons = [
        'spinMobile',
        'takeMobile',
        'gambleMobile',
        'stopMobile'
    ];

    this.pressActiveStyle = 'buttonStylePressed';

    this.styledButtons = {
        'gambleButtonMobileButton': null,
        'autoSpinButtonMobileButton': null
    };

    this.controlButtons = [
        'infoMobile',
        'coinMinusMobile',
        'coinPlusMobile',
        'betSettingButtonMobile'
    ];
    this.enableWinlinesQuickFinish = true;

    var _changeButtonEnableState = function(button, state) {
        _changeButtonState(button, undefined, undefined, state);
    };

    var _setupStyledButtons = function(){
        for(var btnName in _self.styledButtons){
            _self.styledButtons[btnName] = nge.findOne('^'.concat(btnName));
            
            var button = _self.styledButtons[btnName];
            
            if(!button)
                return;

            button.onInputDown.add(function(){
                _setStyle(button, _self.pressActiveStyle);
            });
            
            button.onInputUp.add(function(){
                _unsetStyle(button, _self.pressActiveStyle);
            });
        }
    };

    var _setStyle = function(button, style){
        if(button)
            button.parent.children[1].addClass(style);
    };

    var _unsetStyle = function(button, style){
        if(button)
            button.parent.children[1].removeClass(style);
    };

    this.restoreMobileButtons = function () {
        // MOBILE //

        _switchAutoButton();

        _changeButtonState('pageOneTrigger', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('paytable.updatePayout');
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageOneHeaderContainer', container: 'pageOneContainer'}, 1);
        }, true, true);
        
        _changeButtonState('pageTwoTrigger', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageTwoHeaderContainer', container: 'pageTwoContainer'}, 1);
        }, true, true);

        _changeButtonState('spinMobile', undefined, function () {
            nge.observer.fire('sounds.spinClick');
            nge.observer.fire('slotMachine.spinCommand');
        }, true, true);

        _changeButtonState('takeMobile', undefined, function () {
            nge.observer.fire('gamble.take');
        }, true, false);

        _changeButtonState('stopMobile', undefined, function () {
            nge.observer.fire(_self.stopCommandEvent);
        }, true, false);

        _changeButtonState('soundMobile', undefined, function () {
            nge.observer.fire('settings.soundSwitch');
        }, true, true);
        
        _changeButtonState('mobileBackToGameButton', undefined, function () {
            nge.observer.fire('paytable.hide');
        }, true, true);

        _changeButtonState('gambleMobile', 'х2', function () {
            if (nge.localData.get('gamble.canPlay'))
                nge.observer.fire('gamble.go');
        }, true, false);

        _changeButtonState('quickSettingsPanel', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('quickSettings.panelSwitch');
        }, true, true);

        _changeButtonState('coinMinusMobile', undefined, function () {
            nge.observer.fire('bet.down');
        }, true, true);

        _changeButtonState('coinPlusMobile', undefined, function () {
            nge.observer.fire('bet.up');
        }, true, true);

        _changeButtonState('betSettingButtonMobile', undefined, function () {
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageTwoHeaderContainer', container: 'pageTwoContainer'});
            nge.observer.fire('paytable.show');
        }, true, true);
        
        _determineCustomBtn01();
        _determineCustomBtn02();

        if(_customButton01Enabled)
            _changeButtonState('customBtn01', undefined, function () {
                customButtons.customBtn01.callback();
            }, true, true);

        if(_customButton02Enabled)
            _changeButtonState('customBtn02', undefined, function () {
                customButtons.customBtn02.callback();
            }, true, _customButton02Enabled);

        _changeButtonState('infoMobile', undefined, function () {
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageOneHeaderContainer', container: 'pageOneContainer'});
            nge.observer.fire('paytable.show');
        }, true, true);
    };

    var _changeButtonState = function (btn, title, callback, isEnabled, isVisible) {

        var state = {};
        state[btn] = {
            title: title,
            callback: callback,
            enabled: isEnabled,
            visible: isVisible
        };
        nge.observer.fire('buttons.changeData', state);
    };

    this.changeButtonState = _changeButtonState;

    var _hideButtonsOnAutoSpinOn = function () {
        _mobileButtons.forEach(function (btn) {
            _changeButtonVisibleState(btn, false);
        });
        _changeButtonVisibleState('autoSpinMobile', true);
    };

    var _switchAutoButton = function () {
        var auto = nge.localData.get('autospin');
        if(!auto) { 
            _changeButtonState('autoSpinMobile', _autoOnText, function () {
                _hideButtonsOnAutoSpinOn();
                nge.observer.fire('autospinSimple.on');
            }, true, true);
        } else {
            _changeButtonState('autoSpinMobile', _autoOffText, function () {
                _hideButtonsOnAutoSpinOn();
                nge.observer.fire('autospinSimple.off');
            }, true, true);
        }
    };

    var _onRestore = function () {
        if(!_buttonsWasCreated)
            return;

        if(nge.localData.get('freespin.inProgress') && _self.disableAutoButton)
            _changeButtonVisibleState('autoSpinMobile', false);

        _scenesWasCreated = true;

        var offer = nge.localData.get('freeGame.inProgress');

        if(offer)
            return _self._offerRestore();

        if(nge.localData.get('slotMachine.lastResponse')){
            _mobileButtons.forEach(function (button) {
                _changeButtonState(button, undefined, undefined, undefined, false);
            });

            _changeButtonVisibleState('stopMobile', false);

            _changeButtonState('soundMobile', undefined, function () {
                nge.observer.fire('settings.soundSwitch');
            }, true, true);

        } else
            _self.restoreMobileButtons();

        _self.onRestoreExtension();

        if(typeof _customButton01Enabled === 'undefined')
            _determineCustomBtn01();

        if(typeof _customButton02Enabled === 'undefined')
            _determineCustomBtn02();

        if(nge.localData.get('freespin.inProgress') && _self.disableAutoButton)
            _changeButtonVisibleState('autoSpinMobile', false);
    };

    this.onRestoreExtension = function () {};

    var _changeButtonVisibleState = function (button, state) {
        _changeButtonState(button, undefined, undefined, state, state);
    };

    var _autoSpinOn = function () {
        var freespinInProgress = nge.localData.get('freespin.inProgress');

        if(!freespinInProgress) {
            _mobileButtons.forEach(function (btn) {
                _changeButtonVisibleState(btn, false);
            }); 
        }

        _changeButtonState('stopMobile', undefined, function () {
            nge.observer.fire(_self.stopCommandEvent);
        }, false, true);

        _changeButtonState('infoMobile', undefined, function () {
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageOneHeaderContainer', container: 'pageOneContainer'});
            nge.observer.fire('paytable.show');
        }, false, true);

        _switchCustomBtn01Availability(false);
        _switchCustomBtn02Availability(false);

        _changeButtonState('autoSpinMobile', _autoOffText, function () {
            nge.observer.fire('autospinSimple.off');
        }, true, true);
    };

    var _autoSpinOff = function () {
        if(_offerFinishFlag){
            _offerFinishFlag = false;
            _changeButtonState('autoSpinMobile', _autoOnText, function () {
                nge.observer.fire('autospinSimple.on');
            }, false);
            return;
        }

        _changeButtonState('autoSpinMobile', _autoOnText, function () {
            nge.observer.fire('autospinSimple.on');
        }, true);

        if(!nge.localData.get('freespin.inProgress')) {

            _changeButtonState('spinMobile', undefined, function () {
                nge.observer.fire('slotMachine.spinCommand');
            }, true, false);
        }
    };

    var _onPaytableShow = function () {        
        _mobileButtons.forEach(function (btn) {
            _changeButtonVisibleState(btn, false);
        });

        _switchCustomBtn01Visibility(false);
        _switchCustomBtn02Availability(false);
        // _setEnableStatusControlButtons(false);

        nge.observer.fire('betSettings.updateSliders');
        nge.observer.fire('settings.update');
    };

    var _onPaytableHide = function () {
        var offer = nge.localData.get('freeGame.inProgress');
        
        if(offer)
            _self._offerRestore();
        else {
            _changeButtonState('infoMobile', undefined, function () {
                nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageOneHeaderContainer', container: 'pageOneContainer'});
                nge.observer.fire('paytable.show');
            }, true, true);
            _self.restoreMobileButtons();
        }
    };

    var _onSpinStop = function () {
        _changeButtonState('stopMobile', undefined, function () {
            nge.observer.fire(_self.stopCommandEvent);
        }, false, true);
    };

    this._spinStartButtonsChange = () => {
        _changeButtonState('spinMobile', undefined, function () {
            nge.observer.fire('slotMachine.spinCommand');
        }, true, false);

        _changeButtonState('stopMobile', undefined, function () {
            nge.observer.fire(_self.stopCommandEvent);
        }, false, true);
    };

    var _onSpinStart = function () {
        _isWin = false;
        _cycleComplete = false;

        _self._spinStartButtonsChange();

        _setEnableStatusControlButtons(false);
        _switchCustomBtn01Availability(false);
        _switchCustomBtn02Availability(false);
    };

    var _onSpinComplete = function () {
        _self.spinCompleteHandler();
    };

    var _cycleCompleteHandler = function () {

        var offerCount = nge.localData.get('freeGame.amount');

        if(nge.localData.get('freespin.inProgress') || nge.localData.get('respin.inProgress'))
            return;
        
        var offer = nge.localData.get('freeGame.inProgress');
        var auto = nge.localData.get('autospin');

        if(_isWin && !_cycleComplete){

            if(offer && parseInt(offerCount) === 0 && auto){
                nge.observer.fire('buttons.insidePress', 'autoSpinMobile');
                _changeButtonVisibleState('autoSpinMobile', false);
            }

        } else if (!_cycleComplete && !offer){
            _changeButtonState('spinMobile', undefined, function () {
                nge.observer.fire('sounds.spinClick');
                nge.observer.fire('slotMachine.spinCommand');
            }, true, !auto);

            _changeButtonState('stopMobile', undefined, function () {
                nge.observer.fire(_self.stopCommandEvent);
            }, !auto, auto);

            _setEnableStatusControlButtons(!auto);
            _switchCustomBtn01Availability(!auto);
            _switchCustomBtn02Availability(!auto);

        } else if(!_cycleComplete && offer){
            if(!auto)
                _self._offerRestore();
        }
        _cycleComplete = true;
        _isWin = false;
    };

    var _switchCustomBtn01Availability = function (isAvail) {
        if(!_customButton01Enabled) 
            return;

        var isVisible = isAvail ? isAvail : (customButtons.customBtn01.frames > 1 || nge.wrap.cache.hasSpritesheet('customBtn01'));
        _changeButtonState('customBtn01', undefined, undefined, isAvail || !isVisible, isVisible);
    };

    var _switchCustomBtn01Visibility = function(isVisible){
        if(!_customButton01Enabled) 
            return;

        _changeButtonState('customBtn01', undefined, undefined, true, isVisible);
    };

    var _switchCustomBtn02Availability = function (isAvail) {
        if(!_customButton02Enabled)
            return;

        var isVisible = isAvail ? isAvail : customButtons.customBtn02.frames > 1;
        _changeButtonState('customBtn02', undefined, undefined, isAvail || !isVisible, isVisible);
    };

    var _win =function () {
        _isWin = true;
    };

    var _onGambleTake = function () {
        _changeButtonState('gambleMobile', undefined, function () {
            if (nge.localData.get('gamble.canPlay'))
                nge.observer.fire('gamble.go');
        }, true, false);
    };

    this.onGambleButtonsShow = function () {
        var respinInprogress = nge.localData.get('respin.inProgress');
        var freeGameAmount = nge.localData.get('freeGame.amount');
        var freeGameInProgress = nge.localData.get('freeGame.inProgress');
        var canGamble = nge.localData.get('slotMachine.slotWin.canGamble');

        _changeButtonVisibleState('autoSpinMobile', true);

        if(freeGameInProgress && parseInt(freeGameAmount) === 0)
            _changeButtonVisibleState('autoSpinMobile', false);

        if(canGamble === 'false'|| respinInprogress)
            return;

        _changeButtonVisibleState('stopMobile', false);

        _changeButtonState('gambleMobile', undefined, function () {
            if (nge.localData.get('gamble.canPlay'))
                nge.observer.fire('gamble.go');
        }, true, true);

        _changeButtonState('takeMobile', undefined, function () {
            nge.observer.fire('gamble.take');
        }, true, true);
    };

    var _onFreespinStart = function () {
        _startFreeSpin();
    };

    var _startFreeSpin = function () {

        _changeButtonVisibleState('autoSpinMobile', false);

        _setEnableStatusControlButtons(false);
        _switchCustomBtn01Availability(false);
        _switchCustomBtn02Availability(false);

        _changeButtonState('spinMobile', undefined, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, true, true);

        _changeButtonVisibleState('stopMobile', false);
    };

    this.onPressSpinButton = function () {

        _switchAutoButton();
        if(_self.disableAutoButton)
            _changeButtonVisibleState('autoSpinMobile', false);
        _changeButtonState('spinMobile', _self.spinBtnName, undefined, false, false);
    };

    var _onGambleGo = function () {

        _switchCustomBtn01Availability(false);
        _switchCustomBtn02Availability(false);

        _changeButtonState('autoSpinMobile', _autoOnText, function () {
            _hideButtonsOnAutoSpinOn();
            nge.observer.fire('autospinSimple.on');
        }, true, false);

        _changeButtonState('gambleMobile', undefined, function () {
            if (nge.localData.get('gamble.canPlay'))
                nge.observer.fire('gamble.go');
        }, true, false);

    };

    var _onFreespinContinue = function () {
        _mobileButtons.forEach(function (btn) {
            _changeButtonVisibleState(btn, false);
        });

        if(_self.disableAutoButton)
            _changeButtonVisibleState('stopMobile', false);

        _changeButtonState('spinMobile', undefined, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, true, true);

        _changeButtonState('quickSettingsPanel', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('quickSettings.panelSwitch');
        }, true, true);

        _changeButtonState('autoSpinMobile', undefined, function () {
            
            if(nge.localData.get('autospin'))
                nge.observer.fire('autospinSimple.off');
            else
                nge.observer.fire('autospinSimple.on');
        }, false, true);

        if(_self.disableAutoButton)
            _changeButtonVisibleState('autoSpinMobile', false);

        _switchCustomBtn01Availability(false);
        _switchCustomBtn02Availability(false);
        _setEnableStatusControlButtons(false);
    };

    var _setEnableStatusControlButtons = function(isEnabled){
        _self.controlButtons.forEach(function(buttonName){  
            _changeButtonState(buttonName, undefined, undefined, isEnabled, true);
        });
    };

    var _onGambleTakingStop = function () {
        
        var auto = nge.localData.get('autospin');
        var freeGames = nge.localData.get('freeGame.inProgress');

        if(freeGames && !auto){
            _self._offerRestore();
            return;
        }
         
        _changeButtonState('takeMobile', undefined, function () {
            nge.observer.fire('gamble.take');
        }, true, false);

        _changeButtonState('spinMobile', undefined, function () {
            nge.observer.fire('slotMachine.spinCommand');
        }, false, !auto);
    };

    this.onFreespinFinish = function (restore) {
        if(_self.disableAutoButton)
            _changeButtonVisibleState('autoSpinMobile', true);
        var totalWin = nge.localData.get('freespin.totalWin');
        
        if(totalWin && !restore) return;

        if(!_isWin || restore)
            _self.restoreMobileButtons();
    };

    var _onInfoPanelHide = function () {
        var _staticContainer = nge.findOne('^staticContainer');
        _staticContainer.visible = false;
    };

    var _onInfoPanelShow = function () {
        var _staticContainer = nge.findOne('^staticContainer');
        _staticContainer.visible = true;
    };

    var _onAllButtonsHide = function () {
        _mobileButtons.forEach(function (btn) {
            _changeButtonVisibleState(btn, false);
        });
    };
    var _onAllButtonsShow = function () {
        _mobileButtons.forEach(function (btn) {
            _changeButtonVisibleState(btn, true);
        });
        _switchAutoButton();
    };

    var _onButtonsEnableSpin = function () {
        _changeButtonVisibleState('spinMobile', true);
    };

    var _onButtonsEnableAuto = function () {
        _changeButtonVisibleState('autoSpinMobile', true);
    };

    var _disableButtonOnTake = function () {
        _changeButtonEnableState('takeMobile', false);
    };

    var _actionResponse = function () {
        _changeButtonEnableState('takeMobile', true);
    };

    this._offerRestore = function () {
        _offerFinishFlag = false;

        var freeGameAmount = nge.localData.get('freeGame.amount');

        _mobileButtons.forEach(function (btn) {
            _changeButtonVisibleState(btn, false);
        });

        if(parseInt(freeGameAmount, 10) === 0)
            return;

        _changeButtonEnableState('coinMinusMobile', false);
        _changeButtonEnableState('coinPlusMobile', false);
        _changeButtonVisibleState('autoSpinMobile', true);
        _changeButtonVisibleState('spinMobile', true);

        _changeButtonState('infoMobile', undefined, function () {
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageOneHeaderContainer', container: 'pageOneContainer'});
            nge.observer.fire('paytable.show');
        }, true, true);

        _changeButtonState('betSettingButtonMobile', undefined, function () {
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageTwoHeaderContainer', container: 'pageTwoContainer'});
            nge.observer.fire('paytable.show');
        }, true, true);

        _switchCustomBtn01Availability(true);
        _switchCustomBtn02Availability(true);
    };

    var _offerFinish = function () {
        _offerFinishFlag = true;
        _changeButtonVisibleState('autoSpinMobile', false);
    };

    var _onButtonsCreateEnd = function(){
        _setupStyledButtons();

        _autoOnText = nge.i18n.get('AUTO\n  OFF');
        _autoOffText = nge.i18n.get('AUTO\n  ON');

        _buttonsWasCreated = true;

        if(_self.disableAutoButton)
            _changeButtonVisibleState('autoSpinMobile', false);
    };

    var _determineCustomBtn02 = function(){
        if(typeof customButtons !== 'undefined')
            _customButton02Enabled = !!customButtons.customBtn02;
    };

    var _determineCustomBtn01 = function () {
        if(typeof customButtons !== 'undefined')
            _customButton01Enabled = !!customButtons.customBtn01;
    };

    this.spinCompleteHandler = function(){
        var isWin = nge.localData.get('slotMachine.slotWin');

        if(_self.enableWinlinesQuickFinish && isWin) {
            nge.rafSetTimeout(function(){
                _changeButtonState('stopMobile', undefined, function () {
                    if (!_cycleComplete) {
                        nge.observer.fire('slotMachine.quickFinish');
                        _changeButtonState('stopMobile', undefined, function () {}, false, true);
                    }
                }, true, true);
            }, 1);
        }
    };

    this.spinResponceHandler = function(){
        _changeButtonState('stopMobile', undefined, function () {
            nge.observer.fire(_self.stopCommandEvent);
        }, true, true);
    };

    this.subscribe = function () {

        if(this.enableNewLogic)
            return nge.App.getInstance('Mlm.Brain.ButtonsNewLogic.Controller').subscribe();

        nge.observer.add('buttons.restore', _onRestore, false, true);
        nge.observer.add('buttons.create.end', _onButtonsCreateEnd, false, true);
        nge.observer.add('StatesManager.create.end', _onRestore, false, true);
        
        nge.observer.add('slotMachine.spinStart', _onSpinStart, false, true);
        nge.observer.add('slotMachine.stopCommand', _onSpinStop, false, true);
        nge.observer.add('slotMachine.spinComplete', _onSpinComplete, false, true);
        nge.observer.add('slotMachine.spinResponse', _self.spinResponceHandler, false, true);

        nge.observer.add('autospinSimple.on', _autoSpinOn, false, true);
        nge.observer.add('autospinSimple.off', _autoSpinOff, false, true);

        nge.observer.add('buttons.disable.all', _onAllButtonsHide, false, true);
        nge.observer.add('buttons.enable.all', _onAllButtonsShow, false, true);

        nge.observer.add('buttons.finish.offer', _offerFinish, false, true);

        nge.observer.add('buttons.enable.spin', _onButtonsEnableSpin, false, true);
        nge.observer.add('buttons.enable.auto', _onButtonsEnableAuto, false, true);

        nge.observer.add('paytable.show', _onPaytableShow, false, true);
        nge.observer.add('paytable.hide', _onPaytableHide, false, true);

        nge.observer.add('buttons.restore.offer', _self._offerRestore, false, true);

        nge.observer.add('buttons.show.navPanel', _onInfoPanelShow, false, true);
        nge.observer.add('buttons.hide.navPanel', _onInfoPanelHide, false, true);

        nge.observer.add('buttons.showGamble', _self.onGambleButtonsShow, false, true);
        nge.observer.add('gamble.take', _onGambleTake, false, true);
        nge.observer.add('gamble.go', _onGambleGo, false, true);
        nge.observer.add('gamble.taking.stop', _onGambleTakingStop, false, true);

        nge.observer.add('gamble.red', _disableButtonOnTake, false, true);
        nge.observer.add('gamble.black', _disableButtonOnTake, false, true);
        nge.observer.add('buttons.gamble.restore', _actionResponse, false, true);

        nge.observer.add('buttons.freespinStart', _onFreespinStart, false, true);
        nge.observer.add('buttons.freespinContinue', _onFreespinContinue, false, true);
        nge.observer.add('freespin.press.spinButton', _self.onPressSpinButton, false, true);
        nge.observer.add('buttons.freespinFinish', _self.onFreespinFinish, false, true);

        nge.observer.add('winlines.animateByOne.cycleComplete', _cycleCompleteHandler, false, true);
        nge.observer.add('win', _win, false, true);
    };
});



nge.App[nge.appNS].Mlm.Brain.UI_v3 = {};



nge.App[nge.appNS].Mlm.Brain.UI_v3.Buttons = nge.App[nge.appNS].Mlm.Brain.Buttons.extend(function () {
    var _self = this;
    var _spinButton;
    var _playButtonText;
    var _tempMaxBetButtonName = '';

    this.holdEnabled = false;
    this.continueBtnName = '';
    this.backToGameBtnName = 'BACK\nTO\nGAME';
    this.autoBtnOn = 'AUTO\nON';
    this.autoBtnOff = 'AUTO\nOFF';
    this.takeButtonName = 'TAKE';
    this.spinBtnName = 'SPIN';
    this.stopBtnName = 'STOP';
    this.spinBackToGameName = 'SPIN';
    this.maxBetBtnName = 'MAX\nBET';
    this.maxBetBtnNameDefault = 'MAX\nBET';
    this.gambleRedBtnName = 'LEFT';
    this.gambleBlackBtnName = 'RIGHT';
    this.gambleBtnName = 'GAMBLE'; 

    this.mainButtons = [
        'coinMinus',
        'coinPlus',
        'betMinus',
        'betPlus',
        'paytable',
        'maxBet',
        'spin',
        'auto',
        'linesChanger'
    ];

    this.pressActiveStyle = 'buttonStylePressed';

    this.styledButtons = {
        'autoButtonButton': null
    };

    var _setupStyledButtons = function(){
        for(var btnName in _self.styledButtons)
            _self.styledButtons[btnName] = nge.findOne('^'.concat(btnName));
    };

    this.buttonsRestoreAutoUpdates = function(){};

    var _freespinContainer;
    var _freespinTotal;
    var _freespinPlayed;
    var _autoButton;
    var _maxbetButton;

    var _changeSpinButtonState = function(state){
        if(typeof _spinButton === 'undefined')
            return; 
            
        switch (state.spin.title) {
            case nge.i18n.get('SPIN'):
                state.spin.title = '';
                nge.rafSetTimeout(function(){
                    _spinButton.setFrames(2, 1, 0);
                }, 1);
                break;
            case nge.i18n.get('STOP'):
                state.spin.title = '';
                nge.rafSetTimeout(function(){
                    _spinButton.setFrames(6, 5, 4);
                }, 1);
                break;
            case nge.i18n.get('TAKE'):
                state.spin.title = '';
                nge.rafSetTimeout(function(){
                    _spinButton.setFrames(10, 9, 8);
                }, 1);
                break;
            default:
                nge.rafSetTimeout(function(){
                    state.spin.title = '';
                    _spinButton.setFrames(2, 1, 0);
                }, 1);
                break;
        }
    };

    var _onButtonsCreateEnd = function(){
        nge.localData.set('gamble.waiting', false);
        _spinButton = nge.findOne('^spinButtonButton');
        _playButtonText = nge.findOne('^playButtonText');

        _self.maxBetBtnName = nge.i18n.get(_self.maxBetBtnNameDefault);
        _self.autoBtnOn = nge.i18n.get(_self.autoBtnOn);
        _self.autoBtnOff = nge.i18n.get(_self.autoBtnOff);
        _self.gambleRedBtnName = nge.i18n.get(_self.gambleRedBtnName);
        _self.gambleBlackBtnName = nge.i18n.get(_self.gambleBlackBtnName);
        _self.gambleBtnName = nge.i18n.get(_self.gambleBtnName); 

        _tempMaxBetButtonName = _self.maxBetBtnName;

        _changeButtonState('maxBet', _self.maxBetBtnName);

        _setupStyledButtons();
    };

    var _actionGambleButton = function(){
        _playButtonText.text = '';
    };

    var _changeButtonState = function (btn, title, callback, isEnabled, isVisible, frame) {
        var state = {};
        state[btn] = {
            title: title,
            callback: callback,
            enabled: isEnabled,
            visible: isVisible,
            frame: frame
        };
        _self.beforeUpdateHandler(state);
        nge.observer.fire('buttons.changeData', state);
        _self.afterUpdateHandler(state);
    };

    this.changeButtonState = _changeButtonState;

    var _changeButtonEnableState = function(button, state) {
        _changeButtonState(button, undefined, undefined, state);
    };

    var _checkMinMaxState = function () {

        if(!_self.disableButtonsOnMinMax)
            return;

        _self.minMaxComponentList.forEach(function (obj) {
            obj.btnNames.forEach(function (t, n) {
                _changeButtonEnableState(obj.btnNames[n], !obj.disabled[n]);
            });
        });
    };

    this._autoButtonEnableSwitch = function (bool) {
        var auto = nge.localData.get('autospin');
        if(auto){
            _changeButtonState('auto', _self.autoBtnOn, _self._autoSpinSimpleOffCallback, bool);
            _self.styledButtons.autoButtonButton.setFrames(2, 0, 0);
        } else {
            _changeButtonState('auto', _self.autoBtnOff, _self._autoSpinSimpleOnCallback, bool);  
            _self.styledButtons.autoButtonButton.setFrames(2, 1, 0);
        }        
    };

    this.autoButtonEnableSwitch = this._autoButtonEnableSwitch;

    var _changeAllButtonsEnableState = function (state) {
        _self.mainButtons.forEach(function (item) {
            if(!_self.holdEnabled)
                return;

            _changeButtonEnableState(item, state);
        });

        if(state)
            _checkMinMaxState();
    };

    this.enableFreespinText = function(enable){
        _freespinContainer.visible = enable;
        _freespinTotal.visible = enable;
        _freespinPlayed.visible = enable;
        _autoButton.visible = !enable;
        _maxbetButton.visible = !enable;

        _freespinTotal.text = '';
        _freespinPlayed.text = '';
    };

    var _updateFreespin = function(data){
        _freespinTotal.text = data.total;
        _freespinPlayed.text = data.current;
    };

    this.onPressSpinButton = function () {
        this.super.onPressSpinButton();
        this.enableFreespinText(true);
    };

    this.spinCompleteHandler = function(){
        var isWin = nge.localData.get('slotMachine.slotWin');

        if(this.enableWinlinesQuickFinish && isWin)
            nge.rafSetTimeout(function(){
                nge.localData.set('slotMachine.quickFinishWaiting', true);
                _self.changeButtonState('spin', _self.stopBtnName, function () {
                    nge.localData.set('slotMachine.quickFinishWaiting', false);
                    nge.observer.fire('slotMachine.quickFinish');
                }, true);
            }, 1);
    };

    this.beforeUpdateHandler = function(state){
        if(typeof state.spin === 'undefined' || typeof state.spin.title === 'undefined')
            return;
        if(state.oneBet)
            state.auto = state.oneBet;
        _changeSpinButtonState(state);
        if(state.spin.title === 'SPIN' || state.spin.title === 'STOP')
            state.spin.title = '';
    };

    this.onSpinStartChangeBtn = function(){
        _changeButtonState('auto', _self.autoBtnOn, function () {}, false);
       
        _changeButtonState('maxBet', _self.maxBetBtnName, function () {
            nge.observer.fire('maxbet.go');
        }, false);
       
        _changeButtonState('spin', _self.spinBtnName, function () {
            nge.observer.fire('slotMachine.spinCommand');
        }, false);
    };

    this.onPaytableShow = function () {
        _changeAllButtonsEnableState(false);
    };

    this.restoreDesktopButtons = function () {
        _changeButtonState('mobileBackToGameButton', undefined, function () {
            nge.observer.fire('paytable.hide'); 
        }, true, true);

        _changeButtonState('pageOneTrigger', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('paytable.updatePayout');
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageOneHeaderContainer', container: 'pageOneContainer'}, 1);
        }, true);
        
        _changeButtonState('pageTwoTrigger', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageTwoHeaderContainer', container: 'pageTwoContainer'}, 1);
        }, true);

        _changeButtonState('sound', undefined, function () {
            nge.observer.fire('settings.soundSwitch');
        }, true);

        _changeButtonState('fullscreen', undefined, function () {
            if(!nge.localData.get('fullscreen.enabled'))
                nge.observer.fire('fullscreen.on');
            else
                nge.observer.fire('fullscreen.off');
        }, true);

        _changeButtonState('maxBet', _self.maxBetBtnName, function () {
            nge.observer.fire('maxbet.go');
        }, true);

        _self._autoButtonEnableSwitch(true);
        
        _changeButtonState('paytable', _self.paytableBtnName, function () {
            nge.observer.fire('paytable.show');
            nge.observer.fire('betSettings.updateSliders', null, 1);
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageOneHeaderContainer', container: 'pageOneContainer'}, 1);
        }, true);

        _changeButtonState('spin', _self.spinBtnName, function () {
            nge.observer.fire('slotMachine.spinCommand');
        }, true);

        _changeButtonState('coinMinus', undefined, function () {
            nge.observer.fire('coins.down');
        }, true);

        _changeButtonState('coinPlus', undefined, function () {
            nge.observer.fire('coins.up');
        }, true);

        _changeButtonState('betMinus', undefined, function () {
            nge.observer.fire('bet.down');
        }, true, true);

        _changeButtonState('betPlus', undefined, function () {
            nge.observer.fire('bet.up');
        }, true, true);

        _changeButtonState('quickSettingsPanel', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('quickSettings.panelSwitch');
        }, true, true);

        _changeButtonState('linesChanger', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('lines.up');
        }, true, true);
    };

    this.startFreeSpin = function () {
        _changeButtonState('spin', _self.spinBtnName, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, true);
        
        _changeButtonState('maxBet', _self.maxBetBtnName, function () {
            nge.observer.fire(_self.bonusGameStartEvent);
        }, true);
        
        nge.localData.set('autospin', false);
        _self._autoButtonEnableSwitch(false);
    };

    this.onGambleButtonsShow = function () {
        var freeGameAmount = nge.localData.get('freeGame.amount');
        var freeGameInProgress = nge.localData.get('freeGame.inProgress');
        var canGamble = nge.localData.get('slotMachine.slotWin.canGamble');

        _self._autoButtonEnableSwitch(true);

        if(freeGameInProgress && parseInt(freeGameAmount, 10) === 0)
            _self._autoButtonEnableSwitch(false);

        if(!nge.localData.get('autospin') && !_self.customGambleGame && canGamble === 'true') {
            nge.localData.set('gamble.waiting', true);
            nge.observer.fire('buttons.gamble.waiting');
            _changeButtonState('auto', _self.gambleBtnName, function () {
                if (nge.localData.get('gamble.canPlay')) {
                    nge.localData.set('gamble.waiting', false);
                    nge.observer.fire('gamble.go');
                }
            }, true);
            _changeButtonState('maxBet', _self.gambleBtnName, function () {
                if (nge.localData.get('gamble.canPlay')) {
                    nge.localData.set('gamble.waiting', false);
                    nge.observer.fire('gamble.go');
                }
            }, true);

            _changeButtonState('spin', _self.takeButtonName, function () {
                nge.localData.set('gamble.waiting', false);
                nge.observer.fire('gamble.take');
            }, true);
        }
    };

    this.setButtonsStateOnWinCycleComplete = function(){
        nge.localData.set('gamble.waiting', true);
        nge.observer.fire('buttons.gamble.waiting');
        _changeButtonState('spin', _self.takeButtonName, function () {
            nge.localData.set('gamble.waiting', false);
            nge.observer.fire('gamble.take');
        }, true);
        _changeButtonState('auto', _self.gambleBtnName, function () {
            if (nge.localData.get('gamble.canPlay')) {
                nge.localData.set('gamble.waiting', false);
                nge.observer.fire('gamble.go');
            }
        }, true);
        _changeButtonState('maxBet', _self.gambleBtnName, function () {
            if (nge.localData.get('gamble.canPlay')) {
                nge.localData.set('gamble.waiting', false);
                nge.observer.fire('gamble.go');
            }
        }, true);
    };

    this.setButtonStateOnGambleGo = function(){
        _changeButtonState('auto', _self.gambleRedBtnName, function () {
            nge.observer.fire('gamble.red');
        }, true);

        _changeButtonState('maxBet', _self.gambleBlackBtnName, function () {
            nge.observer.fire('gamble.black');
        }, true);
    };

    this.setButtonStateOnRedSwitchFrame = function(frame){
        _changeButtonState('auto', undefined, undefined, undefined, undefined, frame);
    };

    this.gambleChooseButtonSelectors = {
        'red': '^autoButtonButton',
        'black': '^maxBetButtonButton'
    };

    this.onGambleRestoreChangeButtonsState = function () {
        _changeButtonState('auto', _self.gambleRedBtnName, function () {
            nge.observer.fire('gamble.red');
        }, true);
        _changeButtonState('maxBet', _self.gambleBlackBtnName, function () {
            nge.observer.fire('gamble.black');
        }, true);
        _changeButtonState('spin', _self.takeButtonName, function () {
            nge.observer.fire('gamble.take');
        }, true);
    };

    this.onButtonsCreateEnd = function(){
        this.super.onButtonsCreateEnd();

        _freespinContainer = nge.findOne('^freespinPlayedTotalContainer');
        _freespinTotal = nge.findOne('^freespinTotalValueText');
        _freespinPlayed = nge.findOne('^freespinPlyedValueText');

        _autoButton = nge.findOne('^autoButton');
        _maxbetButton = nge.findOne('^maxBetButton');
    };

    var _freespinFinishHandler = function(){
        _self.enableFreespinText(false);
    };

    this.onSpinStop = function () {
        nge.localData.set('spin.onStop', true);
        _spinButton.disable(7);
    };


    this._takingStopHandler = function(){
        nge.localData.set('gamble.waiting', false);
        _changeButtonState('spin', '', function () {
            nge.observer.fire('gamble.take');
        }, false);
        nge.rafSetTimeout(function(){
            _spinButton.setFrames(2, 1, 0);
        }, 5);
    };

    var _gambleTakeHandler = function(){
        _changeButtonState('maxBet', _self.maxBetBtnName, function () {
            nge.observer.fire('maxbet.go');
        }, false);
    };

    var _autoSpinOn = function(){
        _self.styledButtons.autoButtonButton.setFrames(2, 0, 0);
    };

    var _autoSpinOff = function(){
        _self.styledButtons.autoButtonButton.setFrames(2, 1, 0);
    };

    var _updateOfferText = function(){
        var offerData = nge.localData.get('freeGame');
        var freespinData = nge.localData.get('freespin');

        if(offerData.inProgress && !freespinData.inProgress)
            _self.maxBetBtnName = offerData.amount + ' FS';
        else
            _self.maxBetBtnName = _tempMaxBetButtonName;

        _changeButtonState('maxBet', _self.maxBetBtnName, function () {
            nge.observer.fire('maxbet.go');
        }, false);
    };

    this.updateOfferText = _updateOfferText;

    var _spinResponseHandler = function(){
        _updateOfferText();
    };

    this.offerRestore = function(){
        var auto = nge.localData.get('autospin');
        var freeGameAmount = parseInt(nge.localData.get('freeGame.amount'), 10);
        var enableButtons = (freeGameAmount !== 0) && !auto;

        _changeButtonEnableState('coinMinus', false);
        _changeButtonEnableState('coinPlus', false);
        _changeButtonEnableState('betMinus', false);
        _changeButtonEnableState('betPlus', false);
        _changeButtonEnableState('linesChanger', false);
        _self._autoButtonEnableSwitch(enableButtons);

        _changeButtonState('paytable', _self.paytableBtnName, function () {
            nge.observer.fire('paytable.show');
        }, enableButtons);

        _changeButtonState('spin', _self.spinBtnName, function () {
            nge.observer.fire('slotMachine.spinCommand');
        }, enableButtons);
    };

    var _onBalanceResponce = function () {
        nge.localData.set('gamble.waiting', false);
    };

    var _onSpinStart = function () {
        nge.localData.set('gamble.waiting', false);
    };

    this.subscribe = function(){
        if(nge.Lib.Helper.mobileAndTabletCheck())
            return;

        _self.super.subscribe();

        nge.observer.add('slotMachine.spinResponse', _spinResponseHandler, false, true);
        nge.observer.add('autospinSimple.on', _autoSpinOn, false, true);
        nge.observer.add('autospinSimple.off', _autoSpinOff, false, true);
        nge.observer.add('gamble.take', _gambleTakeHandler, false, true);
        nge.observer.add('gamble.taking.stop', _self._takingStopHandler, false, true);
        nge.observer.add('buttons.freespinFinish', _freespinFinishHandler, false, true);
        nge.observer.add('buttons.create.end', _onButtonsCreateEnd, false, true);
        nge.observer.add('gamble.red', _actionGambleButton, false, true);
        nge.observer.add('gamble.black', _actionGambleButton, false, true);
        nge.observer.add('freespin.counterUpdate', _updateFreespin, false, true);
        nge.observer.add('offers.startGame', _updateOfferText, false, true);
        nge.observer.add('offers.result.goToGame', _updateOfferText, false, true);
        nge.observer.add('transportMessage.BalanceResponse', _onBalanceResponce, false, true);
        nge.observer.add('slotMachine.spinStart', _onSpinStart, false, true);
    };
});



nge.App[nge.appNS].Mlm.Brain.UI_v3.Sounds = nge.App[nge.appNS].Mlm.Brain.Sounds.extend(function () {
    var _subscribeSpinButtonClick = function () {
        var sound = {
            action: 'play',
            s: 'spin_button_click',
            e: 'slotMachine.spinStart'
        };
        var eName = 'sound.' + sound.e + '-' + sound.s;
        nge.observer.add(sound.e, function () {
            nge.observer.fire('sound.' + sound.action, sound);
        }, eName, true);
    };

    this.customSubscribe = function () {
        this.super.customSubscribe();
        _subscribeSpinButtonClick();
    };
});



nge.App[nge.appNS].Mlm.Transport = {};



nge.App[nge.appNS].Mlm.Transport.Mapper = nge.Mlm.Transport.Mapper.extend(function () {

    this.init = function () {
        var apiMockupGameSettings = nge.App.getInstance('Cfg.APIMockupGameSettings');

        if (apiMockupGameSettings) {
            nge.Cfg.Main.mode = 'development';
            var apiMockupMapper = nge.App.getInstance('Mlm.Transport.APIMockup.Mapper');

            for (var k in apiMockupMapper)
                this[k] = apiMockupMapper[k];

            this.init(apiMockupGameSettings);
        } else
            this.super.init();
    };
});



nge.App[nge.appNS].Mlm.UserInfo = {};



nge.App[nge.appNS].Mlm.UserInfo.Controller = Class.extend(function () {
    var _self = this;
    var _created;
    var _text;
    var _con;
    var _timeoutID;

    this.init = function () {
        _create1pxBlackAsset();
        _subscribe();
        _setUpdate();
    };

    this.update = null;

    var _create1pxBlackAsset = function () {
        if (!nge.wrap.cache.checkImageKey('1pxBlack')) {
            var img = nge.Lib.Helper.create1PxPng(1, 1, 1, 255, true);
            // TODO: нужна ли обёртка над PIXI.Texture?
            nge.wrap.cache.addTexture('1pxBlack', PIXI.Texture.fromImage(img));
        }
    };

    /**
     * create
     * @returns {Boolean}
     */
    var _create = function () {
        var tpl = nge.App.getInstance('Mlm.UserInfo.Tpl');
        nge.objects.create(tpl.data);

        _con = nge.findOne('^userInfoBar');
        _text = nge.findOne('^userInfoText');

        if (!_created)
            _created = true;

        return true;
    };

    var _show = function (params) {
        if (!_created)
            _create();

        var text = params.text;
        var alpha = params.alpha;
        var delay = params.delay;

        _text.text = text;
        _text.alpha = alpha;
        _con.visible = true;

        if (_timeoutID)
            clearTimeout(_timeoutID);

        if (delay)
            _timeoutID = setTimeout(function () {
                _hide();
            }, delay);
    };
    this.show = _show;

    var _hide = function () {
        _con.visible = false;
    };

    var _setUpdate = function (func) {
        _self.update = func;
    };

    var _removeOldObjects = function () {
        _setUpdate();
        _con = false;
        _text = false;
        _created = false;
    };

    var _cyclicUpdate = function (p) {
        if (_self.update && typeof _self.update === "function")
            _self.update(p);
    };

    var _subscribe = function () {
        nge.observer.add('userInfo.show', _show, false, true);
        nge.observer.add('userInfo.hide', _hide, false, true);
        nge.observer.add('userInfo.setUpdate', _setUpdate, false, true);
        nge.observer.add('StatesManager.display.start', _removeOldObjects, false, true);
        nge.observer.add('cyclicUpdate', _cyclicUpdate, false, true);
    };
});



nge.App[nge.appNS].Mlm.UserInfo.Tpl = function () {

    this.data =
        {
            type: mt.objects.GROUP,
            isVisible: false,
            "name": "userInfoBar",
            "y": 980,
            contents: [
                {type: mt.objects.TEXT, "name": "userInfoText", text: 'userInfoTextDown', x: 960, y: 50, "anchorX": 0.5, "anchorY": 0.5, style: {"fill": "#fff", "font": "36pt \"roboto_condensed_regular\""}},
                {
                    'inputEnabled': true,
                    'scaleX': 1920,
                    'scaleY': 100,
                    'alpha': 0.75,
                    'isVisible': 1,
                    'assetKey': '1pxBlack'
                }
            ]
        };
};




/**
 * @author Vitalii Kulyavets
 * @date 28.03.2018
 */

nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic = {};


nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.Action = Class.extend(function () {

    var _name = null;
    var _actionUpdateHandlers = null;
    var _isOptional = null;
    var _buttonStates = null;
    var _beforeUpdateHandler = null;
    var _afterUpdateHandler = null;

    this.init = function (name, actionUpdateHandlers, beforeUpdateHandler, afterUpdateHandler) {
        _name = name;
        _actionUpdateHandlers = actionUpdateHandlers;
        _beforeUpdateHandler = beforeUpdateHandler;
        _afterUpdateHandler = afterUpdateHandler;
    };

    this.isValid = function () {
        return _actionUpdateHandlers();
    };

    this.isOptional = function () {
        return _isOptional;
    };

    this.setOptional = function (isOptional) {
        _isOptional = isOptional;
    };

    this.getName = function () {
        return _name.replace('?', '');
    };

    this.addButtonStates = function (buttonStates) {
        _buttonStates = buttonStates;
    };

    this.appendButtonState = function (buttonState) {
        _buttonStates.push(buttonState);
    };

    this.printStatus = function () {
        var optionalText = this.isOptional() ? '%c OPTIONAL ' : '%c';
        var validText = this.isValid() ? '%c VALID ' : '%c';
        log('----ACTION NAME: ' + this.getName() + ' ' + optionalText + validText, 'color:#fff;background:#FD6A02;', 'color:#fff;background:#2E8B57;');
    };

    this.update = function () {
        _buttonStates.forEach(function (buttonState) {
            buttonState.update(_beforeUpdateHandler, _afterUpdateHandler);
        });
    };
});


nge.App[nge.appNS].Mlm.Brain.ButtonsNewLogic.ButtonState = Class.extend(function () {
    var _name = null;
    var _rawData = null;
    var _beforeUpdateHandlers = null;
    var _afterUpdateHandlers = null;
    var _propUpdateHandlers = null;
    var _callbackHandlers = null;
    var _btnCfg = null;

    var _model = {};

    this.init = function (btnCfg, rawData, updateHandlers) {
        _name = btnCfg.name;
        _rawData = rawData;
        _beforeUpdateHandlers = updateHandlers.beforeUpdateHandlers;
        _afterUpdateHandlers = updateHandlers.afterUpdateHandlers;
        _propUpdateHandlers = updateHandlers.propUpdateHandlers; 
        _callbackHandlers = updateHandlers.callbackHandlers;
        _btnCfg = btnCfg;
    };

    var _getClone = function (obj) {
        return nge.Lib.Helper.jsObjClone(obj);
    };

    var _checkIsArr = function (obj) {
        return nge.Lib.Helper.typeCheck.isArray(obj);
    };

    var _checkIsStr = function (obj) {
        return nge.Lib.Helper.typeCheck.isString(obj);
    };

    var _checkIsFunc = function (obj) {
        return nge.Lib.Helper.typeCheck.isFunction(obj);
    };

    var _getButtonModel = function () {
        var rawData = _getClone(_rawData);

        var model = {};
      
        model[_name] = {};
        model[_name].title = rawData.title;
        model[_name].enabled = _parseEnable(rawData);
        model[_name].visible = _parseVisible(rawData);
        model[_name].callback = _parseCallback(rawData);

        return model;
    };

    var _parseCallback = function (rawData) {
        var callback = rawData.callback;

        if (_checkIsFunc(callback))
            return callback;

        if (_checkIsArr(callback))
            return _parseCallbackArray(callback);

        return function () {};
    };

    var _parseCallbackArray = function (arr) {
        
        var callbacks = arr.map(function (callbackName) {
            if (_callbackHandlers[callbackName] && _checkIsFunc(_callbackHandlers[callbackName]))
                return _callbackHandlers[callbackName];
        });

        var runCallback = function (callback) {
            callback();
        };

        return function () {
            callbacks.forEach(runCallback);
        };
    };

    var _parseEnable = function (rawData) {
        var enabled = rawData.enabled;
        var result = _parseProp(enabled);
        
        return result && _btnCfg.enabled;
    };

    var _parseVisible = function(rawData){
        var visible = rawData.visible;
        var result = _parseProp(visible);
        
        return result && _btnCfg.visible;
    };

    var _parseProp = function(prop){
        
        if (typeof prop === 'undefined')
            prop = true;

        if (_checkIsArr(prop))
            prop = _parseArr(prop);
        
        return prop;
    };

    var _runCallback = function (name) {
        var inverted = false;

        if (name.indexOf('!') === 0) {
            inverted = true;
            name = name.replace('!', '');
        }

        if (!_propUpdateHandlers[name])
            return false;

        var result = _propUpdateHandlers[name]();

        return inverted ? !result : result;
    };

    var _parseArr = function (enableDataArr) {

        var parseArr = function (callbackName) {

            if (_checkIsStr(callbackName))
                return _runCallback(callbackName);

            if (_checkIsArr(callbackName));
            return callbackName.every(parseArr);
        };

        var result = enableDataArr.every(parseArr);
        return result;
    };

    this.update = function (_beforeUpdateHandler, _afterUpdateHandler) {
        var model = _getButtonModel();
        
        _beforeUpdateHandler(model);
        nge.observer.fire('buttons.changeData', model);
        _afterUpdateHandler(model);
    };
});


