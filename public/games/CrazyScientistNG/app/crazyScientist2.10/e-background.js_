nge.App[nge.appNS].Com.Winlines.View = nge.Com.Winlines.View.extend(function () {
    let _wlCache = [];
    let _blinkingTween = null;
    let _winlineAmountTextPositions = {};
    let _winlineWinAmountText = null;
    let _winlineWinAmountScaleTween = null;
    let _scatterWinAmouts = [];

    this.create = function() {
        this.super.create();
        _wlCache = [];
        _scatterWinAmouts = [];
        _winlineWinAmountText = nge.findOne('^winLineWinAmount');

        for (let i = 0; i < 20; i++){
            const line = nge.findOne('^line_' + nge.Lib.Helper.LdgZero(i, 2));
            _wlCache.push(line);
        }       

        const lightningLines = nge.findOne('^lightningLines');
        const slotMachineGameContainer = nge.findOne('^slotMachineGameContainer');

        slotMachineGameContainer.addChild(lightningLines);

        lightningLines.x -= slotMachineGameContainer.parent.x;
        lightningLines.y -= slotMachineGameContainer.parent.y;

        this._calculateSymbolPositions();
    };

    this._calculateWinlineWinAmountTextPos = (line) => {
        const len = line.wonSymbols.length;
        const mod = 0;
        const index = Math.floor(len / 2) + mod;

        return line.wonSymbols[index];
    };

    this.animateAll = () => {
        _scatterWinAmouts = [];

        if(nge.localData.get('bonusWin')){
            nge.rafSetTimeout(() => {
                const { totalWin } = nge.localData.get('slotMachine.slotWin');

                nge.localData.set('bonusWin', false);
                nge.observer.fire('winlines.animateAll'); 
                
                if(parseFloat(totalWin, 10) > 0)
                    nge.observer.fire('winlines.pauseAnimation'); 
            }, 1500);
            return;
        }
        this.super.animateAll();
        const lineWinAmounts = nge.localData.get('slotMachine.slotWin.lineWinAmounts');
        _scatterWinAmouts = lineWinAmounts.filter(winAmount => !winAmount.selectedLine);
    };

    this._showWinlineWinAmount = function(lineIndex) {
        const lineWinAmounts = nge.localData.get('slotMachine.slotWin.lineWinAmounts');
        const line = lineWinAmounts.filter(lineWinAmount => lineWinAmount.selectedLine === lineIndex.toString())[0];

        if(!line)
            return;

        const center = this._calculateWinlineWinAmountTextPos(line);
        const amount = nge.Lib.Money.toCoinsInt(line.amount);

        this._startLineWinAmountTween(center, amount);
    };

    this._startLineWinAmountTween = (center, amount) => {
        
        const { x, y } = _winlineAmountTextPositions[`${center[0]}_${center[1]}`];

        _winlineWinAmountText.position.set(x, y);
        _winlineWinAmountText.scale.set(0);
        _winlineWinAmountText.alpha = 0;
        _winlineWinAmountText.text = amount;

        _winlineWinAmountScaleTween = nge.tween.add(_winlineWinAmountText.scale).
            to({ x: 1.2, y: 1.2 }, 230, null, false).to({x: 0, y: 0}, 130, null, false, 630);
        _winlineWinAmountScaleTween.onComplete.add(() => {
            _winlineWinAmountText.scale.set(0);
            _winlineWinAmountText.alpha = 0;
        });

        let reverse = false;
        let lastVal = 0;
        
        _winlineWinAmountScaleTween.onUpdateCallback((t, v) => {
            if(lastVal > v)
                reverse = !reverse;

            lastVal = v;

            const totalAlpha = !reverse ? v : 1 - v;
            _winlineWinAmountText.alpha = totalAlpha;
        });

        _winlineWinAmountScaleTween.start();
    };

    this._hideWinlineWinAmount = function(){
        _winlineWinAmountScaleTween && _winlineWinAmountScaleTween.stop(true);
        _winlineWinAmountScaleTween = null;
    };

    this._calculateSymbolPositions = function(){
        const slotMachine = nge.findOne('^slotMachineContainer');
        const slotMachineGameContainer = nge.findOne('^slotMachineGameContainer');
        const { mw, mh, recyclerView } = nge.App.getInstance('Com.SlotMachine.Cfg').get();
    
        const containerX = slotMachine.x;
        const containerY = slotMachine.y;

        for (let w = 0; w < mw; w++) {
            for (let h = 0; h < mh; h++) {
                const reel = slotMachineGameContainer.children[0].children[w + 1];
                const reelX = reel.x;
                const reelY = reel.y;
                const { x, y } = reel.children[h + recyclerView.borderSymbolsCount];

                _winlineAmountTextPositions[`${w}_${h}`] = {
                    x: x + reelX + containerX + 1,
                    y: y + reelY + containerY - 20
                };
            }     
        }
    };

    this._createBlinkingTween = function(line){
        let startAlpha = 1;
        let totalAlpha = 0.7;

        _blinkingTween = nge.tween.add(line).to({}, 200, null, false, 0, -1, true);

        line.visible = true;
        line.alpha = startAlpha;

        _blinkingTween.onComplete.add(() => {
            line.visible = false;
        });

        let reverse = false;
        let lastVal = 0;
        _blinkingTween.onUpdateCallback((t, v, a) => {
           
            if(lastVal > v)
                reverse = !reverse;
            
            lastVal = v;

            if(nge.localData.get('substrate.needHideLine')){
                t.target.alpha -= 0.15;
                return;
            }  

            t.target.alpha = (!reverse ? (startAlpha + (totalAlpha - startAlpha) * v) : totalAlpha + (startAlpha - totalAlpha) * v);
        });
        
        _blinkingTween.onLoop.add(() => {
            startAlpha = 1;
            totalAlpha = 0.7;
        });
        
        _blinkingTween.start();   
    };

    this.highlightLines = function(){};

    this._stopBlinkingTween = function(){
        _blinkingTween && _blinkingTween.stop(true);
        _blinkingTween = null;
    };

    this.show = function(lineIndex) {
        if (!_wlCache[lineIndex] || !nge.localData.get('cycleComplete'))
            return false;

        let spinning = nge.localData.get('slotMachineSpinning');
        if (spinning)
            return false;

        this._createBlinkingTween(_wlCache[lineIndex]);
        this._showWinlineWinAmount(lineIndex);
        return true;
    };

    this.hide = function(lineIndex) {
        if (!_wlCache[lineIndex])
            return false;

        this._stopBlinkingTween();
        this._hideWinlineWinAmount();
        return true;
    };

    this.hideAll = function() {
        this.super.hideAll();

        for (let i = 0; i < _wlCache.length; i++)
            this.hide(i);
    };

    
    this.cycleComplete = function() {
        nge.localData.set('cycleComplete', true);
        _showWinlines = true;
    };

    this.spinCommand = function() {
        nge.localData.set('cycleComplete', false);
        _showWinlines = false;
        
        for (let i = 0; i < _wlCache.length; i++)
            this.hide(i);
    };

    this._animateSymbols = (symbols) => {
        this.super._animateSymbols(symbols);

        const line = _scatterWinAmouts.filter(symb => {
            return JSON.stringify(symb.wonSymbols) === JSON.stringify(symbols) && !symb.selectedLine;
        })[0];

        if(!line)
            return;

        const center = this._calculateWinlineWinAmountTextPos(line);
        const amount = nge.Lib.Money.toCoinsInt(line.amount);

        if(parseInt(amount, 10) > 0)
            this._startLineWinAmountTween(center, amount);
    };
});



