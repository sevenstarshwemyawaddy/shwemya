nge.Com.Tutorial = {};



nge.Com.Tutorial.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _view;

    this.create = function () {
        this.createDefault();

        if (!_created) {
            _subscribe();
            _view = this.getInstance('View');
            _created = true;
        }
        return true;
    };

    var _showTutorial = function(){
        _view.show();
    };

    var _close = function(){
        _view.close();
    };
    var _next = function(){
        _view.next();
    };
    var _back = function(){
        _view.back();
    };

    var _subscribe = function () {
        nge.observer.add('welcomePopup.hidden', _showTutorial);
        nge.observer.add('tutorial.next', _next);
        nge.observer.add('tutorial.back', _back);
        nge.observer.add('tutorial.close', _close);
    };

});



