nge.App[nge.appNS].Com.CustomButtons = {};



nge.App[nge.appNS].Com.CustomButtons.Controller = nge.Com.Base.extend(function () {
    var _created = false;

    var _initButtons = function () {

        for (var btnName in customButtons) {

            if(customButtons[btnName].imageKey){
                var textureData = nge.wrap.cache.getImage(customButtons[btnName].imageKey, true);
                
                if(textureData){
                    nge.wrap.cache.addTexture(btnName, textureData);
                    continue;
                }
                
                var spritesheetData = nge.wrap.cache.getSpritesheet(customButtons[btnName].imageKey, true);

                if(spritesheetData)
                    nge.wrap.cache.addSpritesheet(btnName, spritesheetData);
            }
        }
    };

    this.create = function () {
        if (typeof customButtons === 'undefined')
            return;

        this.createDefault();
        _initButtons();

        if (!_created)
            _subscribe();

        _created = true;
    };

    var _buttonsCreateEnd = function () {
        for (var btnName in customButtons) {
            var btn = nge.findOne('^'.concat(btnName));

            if (btn) {
                btn.scale.set(1 / nge.assets.getQualityFactor());

                if (customButtons[btnName].x)
                    btn.x = customButtons[btnName].x;

                if (customButtons[btnName].y)
                    btn.y = customButtons[btnName].y;
            }
        }
    };

    var _subscribe = function () {
        nge.observer.add('buttons.create.end', _buttonsCreateEnd);
    };
});



nge.App[nge.appNS].Com.CustomButtons.Tpl = function () {
    
    var tpl = {
        styles: {
            '.centeredButton': {
                anchorX: 0.5,
                anchorY: 0.5
            }
        },
        assets: {
            contents: []
        },
        objects: {
            contents: []
        }
    };

    if(typeof customButtons === 'undefined') return tpl;

    for(var name in customButtons){
        var button = customButtons[name];

        if(!button.callback || button.imageKey) 
            continue;

        var image = nge.wrap.cache.getImage(name.concat('-blank'), true);

        if(!image)
            continue;

        var width = image.base.width;
        var height = image.base.height;
        var frames = button.frames;

        if(button.imageUrl) {
            var asset = {};
            asset.key = name;
            asset.width = width;
            asset.frameWidth = width / frames;
            asset.fullPath = button.imageUrl;
            asset.qualityObeys = button.imageUrl.indexOf('http') === 0; 
            tpl.assets.contents.push(asset);
            continue;
        }
        
        if(button.imageBase64) {
        
            var assetObj = {
                base: image.base,
                data: image,
                frameData: new Phaser.FrameData(),
                key: name
            };

            var fWidth = width/frames;
            
            for(var i = 0; i < frames; i++){
                var frame = new Phaser.Frame();
                frame.index = i;
                frame.x = i * fWidth;
                frame.y = 0;
                frame.width = fWidth;
                frame.height = height;
                frame.right = fWidth + (i * fWidth);

                assetObj.frameData._frames.push(frame);
            }
            nge.wrap.cache.addTexture(name, assetObj.base);
        }
    }
    
    return tpl;
};



