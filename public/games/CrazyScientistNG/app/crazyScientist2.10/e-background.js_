nge.Mlm.Transport.Models.CollectionBonusItemResponse = nge.Mlm.Transport.Model.extend(function () {

    const _validate = (o, key) => {
        if (typeof o[key] === 'undefined')
            throw new Error(`No expected value ${key} in model`);
        return o[key];
    };

    const _parseItems = (items) => {
        const parsedItems = [];
        if (Array.isArray(items)) {
            items.forEach((v) => {
                const item = {
                    type: _validate(v, 'type'),
                    index: _validate(v, 'index'),
                    value: _validate(v, 'value'),
                    picked: _validate(v, 'picked')
                };
                parsedItems.push(item);
            });
        } else {
            throw new Error('"Items" must be an array');
        }
        return parsedItems;
    };

    const _parseCollections = (collections) => {
        const parsedCollections = [];
        if (Array.isArray(collections)) {
            collections.forEach((v) => {
                const collection = {
                    type: _validate(v, 'type'),
                    symbolId: _validate(v, 'symbolId'),
                    value: _validate(v, 'value'),
                    count: _validate(v, 'count')
                };
                parsedCollections.push(collection);
            });
        } else {
            throw new Error('"Collections" must be an array');
        }
        return parsedCollections;
    };

    this.customConstructor = function (options) {
        this.action = 'CollectionBonusItemResponse';
        this.result = nge.Lib.Helper.recursiveGet('result', options, false);
        this.sesId = nge.Lib.Helper.recursiveGet('sesId', options, false);

        this.data = {
            state: nge.Lib.Helper.recursiveGet('data.state', options, false),
            lastPick: nge.Lib.Helper.recursiveGet('data.lastPick', options, false),
            bonusItem: {
                type: nge.Lib.Helper.recursiveGet('data.bonusItem.type', options, false),
                index: nge.Lib.Helper.recursiveGet('data.bonusItem.index', options, false),
                value: nge.Lib.Helper.recursiveGet('data.bonusItem.value', options, false),
                picked: nge.Lib.Helper.recursiveGet('data.bonusItem.picked', options, false),
                collectionSymbolId: nge.Lib.Helper.recursiveGet('data.bonusItem.collectionSymbolId', options, false)
            }
        };

        var items = nge.Lib.Helper.recursiveGet('data.items', options, false);
        this.data.items = _parseItems(items);

        var collections = nge.Lib.Helper.recursiveGet('data.collections', options, false);
        this.data.collections = _parseCollections(collections);

        // @Note: not described in API
        // var gameParameters = nge.Lib.Helper.recursiveGet('data.gameParameters', options, false);
        // if (gameParameters)
        //     this.data.gameParameters = gameParameters;
    };
});



