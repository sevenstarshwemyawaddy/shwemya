nge.App[nge.appNS].Tpl.Groups.PlayStylesExtension = function () {
    var _playStyles = { styles: {} };

    _playStyles.styles['.buttonStyleNormal'] = { anchorX: 0.5, anchorY: 0.5, style: { fill: '#fec36d', align: 'center' } };
    _playStyles.styles['.buttonStylePressed'] = { anchorX: 0.5, anchorY: 0.5, style: { fill: '#5d4739' } };
    _playStyles.styles['.settingTexts'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '28pt futuraptmedium', fill: '#eee0bf' } };
    _playStyles.styles['.autobuttonAmountTextBaseYellow'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '25pt futuraptheavy', fill: '#fec36d' } };
    _playStyles.styles['.freeSpinPlayedAmount'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '21pt futuraptheavy', fill: '#e5e7db', stroke: '#000000', strokeThickness: 4 } };
    _playStyles.styles['.freeSpinTotalAmount'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '21pt futuraptheavy', fill: '#e5e7db', stroke: '#000000', strokeThickness: 4 } };
    _playStyles.styles['.autoButtonAmountTextInfinity'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '44pt futuraptheavy', fill: '#f1b96d' } };
    _playStyles.styles['.autoButtonAmountTextBase'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '24pt futuraptheavy', fill: '#f1b96d' } };
    _playStyles.styles['.menuElementOver'] = { style: { fill: '#e5e7db' } };
    _playStyles.styles['.menuElementBase'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '20pt futuraptheavy', fill: '#e5e7db' } };
    _playStyles.styles['.menuElementInfinity'] = { anchorX: 0.5, anchorY: 0.3, style: { font: '32pt futuraptheavy', fill: '#e5e7db' } };
    _playStyles.styles['.menuElementText'] = { anchorX: 0.5, anchorY: 0.1, style: { font: '20pt futuraptheavy', fill: '#e5e7db' } };
    _playStyles.styles['.uiNumbers'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '20pt futuraptheavy', fill: '#e5e7db' } };
    _playStyles.styles['.totalWinNumber'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '20pt futuraptheavy', fill: '#000000', stroke: '#000000', strokeThickness: 1 } };
    _playStyles.styles['.uiTitles'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '16pt futuraptheavy', fill: '#efe1bf', stroke: '#331f19', strokeThickness: 4 } };
    _playStyles.styles['.freespinStatusText'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '18pt futuraptheavy', fill: '#efe1bf', stroke: '#331f19', strokeThickness: 4 } };
    _playStyles.styles['.mobileGambleButton'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '42pt futuraptheavy', fill: '#efc273' } };
    _playStyles.styles['.mobileAutoButton'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '23pt futuraptheavy', fill: '#efc273' } };
    _playStyles.styles['.mobileFreeSpinsTexts'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '24pt futuraptheavy', fill: '#fec36d' } };
    _playStyles.styles['.mobileUiTitles'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '26pt futuraptheavy', fill: '#efe1bf', stroke: '#482817', strokeThickness: 5 } };
    _playStyles.styles['.mobileUiNumbers'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '32pt futuraptheavy', fill: '#e5e7db' } };
    _playStyles.styles['.mobileWinNumbers'] = { anchorX: 0.5, anchorY: 0.5, style: { font: '42pt futuraptheavy', fill: '#e5e7db' } };
    _playStyles.styles['.insufficientFundsTitle'] = { style: { font: '52pt futuraptheavy', fill: '#fff' } };
    _playStyles.styles['.insufficientFundsText'] = { style: { font: '30pt futuraptheavy', fill: '#efe1bf', align: 'center' } };

    return _playStyles;
};



nge.App[nge.appNS].Tpl.Groups.PlayStyles = function () {
