nge.Com.Tutorial.View = Class.extend(function () {
    var _self = this;
    var _minSideSize = 132;
    var _cornerSize = {h: 16 , w: 16};
    var _curSize = false;

    var _currentStep = 0;
    var _padding = 30;
    var _min = {x: 20, y: 20};
    var _max = {x: nge.game.world.width - 20, y: nge.game.world.height - 20};

    var _tutorialBox;
    var _arrow;
    var _tutorialNext;
    var _tutorialBack;

    var _steps = [
        {
            text: 'SPINS THE REELS',
            arrowPosition: 'right',
            target: nge.findOne('^spinButton'),
            targetSelector: '^spinButton'
        },
        {
            text: 'ACTIVATES ALL AVAILABLE PAY LINES',
            arrowPosition: 'right',
            target: nge.findOne('^maxbetContainer'),
            targetSelector: '^maxbetContainer'
        },
        {
            text: 'AFTER A WIN, YOU MAY GAMBLE TO DOUBLE  YOUR WIN',
            arrowPosition: 'right',
            target: nge.findOne('^gambleButton'),
            targetSelector: '^gambleButton'
        },
        {
            text: 'OPENS OPTIONS AND LAUNCHES AUTOSPIN',
            arrowPosition: 'right',
            target: nge.findOne('^autoSpinButtonContainer'),
            targetSelector: '^autoSpinButtonContainer'
        },
        {
            text: 'SHOWS YOUR CASH BALANCE AND ALLOWS YOU TO MAKE A DEPOSIT',
            arrowPosition: 'top',
            target: nge.findOne('^playHeader'),
            targetSelector: '^playHeader'
        },
        {
            text: 'CHANGES THE SETTINGS FOR BET AMOUNT, PAY LINES, IMAGE QUALITY AND SOUND',
            arrowPosition: 'bottom',
            target: nge.findOne('^btn_settings'),
            targetSelector: '^btn_settings'
        },
        {
            text: 'SHOWS PAYOUTS FOR SYMBOLS, SPECIALS AND PAY LINES',
            arrowPosition: 'bottom',
            target: nge.findOne('^paytableButtonContainer'),
            targetSelector: '^paytableButtonContainer'
        },
        {
            text: 'SHOWS INFO ABOUT CURRENT WINS, STAKES ETC.',
            arrowPosition: 'bottom',
            target: nge.findOne('^infoPanelContainer'),
            targetSelector: '^infoPanelContainer',
            targetShift: {x: -580, y:0}
        },
        {
            text: 'LEAVE THE GAME',
            arrowPosition: 'top',
            target: nge.findOne('^btn_close'),
            targetSelector: '^btn_close',
            targetShift: {x: -35, y:10}
        }
    ];



    this.show = function () {
        _tutorialBox = nge.findOne('.tutorial-box');
        _arrow = nge.findOne('.tutorial-arrow');
        _tutorialNext = nge.findOne('^tutorialNext');
        _tutorialBack = nge.findOne('^tutorialBack');

        var tutorialClose = nge.findOne('^tutorialClose');
        var realCloseButton = nge.findOne('^btn_close');
        tutorialClose.x = realCloseButton.x;
        tutorialClose.y = realCloseButton.y;
        tutorialClose.anchor.x = realCloseButton.anchor.x;
        tutorialClose.anchor.y = realCloseButton.anchor.y;

        var gambleButton = nge.findOne('^gambleButtonContainer');
        gambleButton.visible = true;
        _updateSteps();
        _showStep(_currentStep);
    };

    this.next = function(){
        _currentStep++;
        if (_currentStep >= _steps.length){
            this.close();
        } else {
            _showStep(_currentStep);
        }
    };
    this.back = function(){
        _currentStep--;
        if (_currentStep <= 0){
            _showStep(0);
        } else {
            _showStep(_currentStep);
        }
    };
    this.close = function(){
        var gambleButton = nge.findOne('^gambleButtonContainer');
        gambleButton.visible = false;

        var tutorial = nge.findOne('^tutorial');
        var tween = nge.tween.add(tutorial);
        tween.to({alpha:0}, 300);
        tween.onComplete.addOnce(function(){
            tutorial.destroy(true);
            nge.observer.fire('tutorial.closed');
        });
        tween.start();
    };

    var _updateSteps = function(){
        for (var i = 0; i < _steps.length; i++) {
            _steps[i].target = nge.findOne(_steps[i].targetSelector);
        }
    };

    var _showStep = function (n) {
        _currentStep = n;
        var step = _steps[n];
        if (!step.target){
            _self.next();
            return false;
        }
        var clone = _objClone(step);

        _createTooltip(step, clone);

        nge.findOne('^tutorial').visible = true;

        _updateNavButtons(n);
        return false;
    };

    var _updateNavButtons = function(stepIndex){
        switch (stepIndex){
            case 0:
                _tutorialNext.visible = true;
                _tutorialBack.visible = false;
                break;
            default:
                _tutorialNext.visible = true;
                _tutorialBack.visible = true;
                break;
        }
    };
    var _createTooltip = function(step, clone){
        _updateTextContainer(step);
        _textContainerPositioning(step, clone);
        _arrowPositioning(step, clone);
    };
    var _updateTextContainer = function(step){
        var text = nge.findOne('.tutorial-box .tutorial-text');
        text.text = step.text;
        var minHeight = 110;


        //px-middle
        var pxMiddle = nge.findOne('.tutorial-box .px-middle');
        pxMiddle.width = text.width;
        pxMiddle.height = text.height < minHeight ? minHeight : text.height;
        //pxMiddle.alpha = 0.4;

        //px-top
        var pxTop = nge.findOne('.tutorial-box .px-top');
        pxTop.width = pxMiddle.width + 1;
        pxTop.height = _cornerSize.h;
        // pxTop.alpha = 0.5;

        //corner-right-top
        var cornerRightTop = nge.findOne('.tutorial-box .corner-right-top');
        cornerRightTop.x = pxMiddle.width + _cornerSize.w*2;

        //px-left
        var pxLeft = nge.findOne('.tutorial-box .px-left');
        pxLeft.height = pxMiddle.height + 1;
        pxLeft.width = _cornerSize.w;
        // pxLeft.alpha = 0.5;

        //px-right
        var pxRight = nge.findOne('.tutorial-box .px-right');
        pxRight.height = pxMiddle.height + 2;
        pxRight.width = _cornerSize.w;
        pxRight.x = pxMiddle.width + _cornerSize.w;
        //pxRight.alpha = 0.5;

        //corner-left-bottom
        var cornerLeftBottom = nge.findOne('.tutorial-box .corner-left-bottom');
        cornerLeftBottom.y = pxMiddle.height + _cornerSize.h * 2;

        //px-bottom
        var pxBottom = nge.findOne('.tutorial-box .px-bottom');
        pxBottom.y = pxMiddle.y + pxMiddle.height - 3;
        pxBottom.width = pxMiddle.width + 2;
        pxBottom.height = _cornerSize.h + 3;
        //pxBottom.alpha = 0.5;

        //corner-right-bottom
        var cornerRightBottom = nge.findOne('.tutorial-box .corner-right-bottom');
        cornerRightBottom.x = _cornerSize.w*2 + pxMiddle.width;
        cornerRightBottom.y = _cornerSize.h*2 + pxMiddle.height;
    };
    var _textContainerPositioning = function(step, target){
        var shiftX = (step.targetShift && step.targetShift.x) ? step.targetShift.x : 0;
        var shiftY = (step.targetShift && step.targetShift.y) ? step.targetShift.y : 0;
        _tutorialBox.x = target.x + shiftX;
        _tutorialBox.y = target.y + shiftY;
        switch (step.arrowPosition) {
            case 'top':
                _tutorialBox.x += target.width/2 - _tutorialBox.width/2;
                _tutorialBox.y += target.height + _arrow.height - 2;
                _checkMinMax(_tutorialBox, 'x');
                break;
            case 'bottom':
                _tutorialBox.x += target.width/2 - _tutorialBox.width/2;
                _tutorialBox.y -= _tutorialBox.height + _arrow.height - 2;
                _checkMinMax(_tutorialBox, 'x');
                break;
            case 'left':
                _tutorialBox.x += target.width + _arrow.height - 2;
                _tutorialBox.y += target.height/2 - _tutorialBox.height/2;
                _checkMinMax(_tutorialBox, 'y');
                break;
            case 'right':
                _tutorialBox.x -= _tutorialBox.width + _arrow.height - 2;
                _tutorialBox.y += target.height/2 - _tutorialBox.height/2;
                _checkMinMax(_tutorialBox, 'y');
                break;

            default:
                break;
        }
        return false;
    };
    var _checkMinMax = function(target, axis){
        switch(axis){
            case 'x':
                if (target.x < _min.x){
                    target.x = _min.x;
                } else if (target.x + target.width > _max.x){
                    target.x = _max.x - target.width;
                }
                break;
            case 'y':
                if (target.y < _min.y){
                    target.y = _min.y;
                } else if (target.y + target.height > _max.y){
                    target.y = _max.y - target.height;
                }
                break;
        }
    };
    var _arrowPositioning = function (step, clone) {
        var arrow = _arrow;
        var shiftX = (step.targetShift && step.targetShift.x) ? step.targetShift.x : 0;
        var shiftY = (step.targetShift && step.targetShift.y) ? step.targetShift.y : 0;
        var pos = {
            x: clone.x + shiftX,
            y: clone.y + shiftY,
            angle: _getArrowAngle(step.arrowPosition)
        };

        arrow.x = pos.x;
        arrow.y = pos.y;
        arrow.pivot.x = 0.5;
        arrow.pivot.y = 0.5;
        arrow.angle = pos.angle;

        switch (step.arrowPosition) {
            case 'top':
                arrow.x += clone.width/2;
                arrow.y += clone.height + arrow.height/2;
                break;
            case 'bottom':
                arrow.x += clone.width/2;
                arrow.y -= arrow.height/2;
                break;
            case 'left':
                arrow.x += clone.width + arrow.height/2;
                arrow.y += clone.height/2;
                break;
            case 'right':
                arrow.x -= arrow.height/2;
                arrow.y += clone.height/2;
                break;

            default:
                break;
        }
        return false;
    };

    var _getArrowAngle = function(position){
        var angle;
        switch (position){
            case 'bottom':
                angle = 0;
                break;
            case 'right':
                angle = -90;
                break;
            case 'left':
                angle = 90;
                break;
            case 'top':
                angle = 180;
                break;
        }
        return angle;
    };

    var _objClone = function (step) {
        var target = step.target;
        var copy = nge.findOne('^tutorial-container .obj-copy');
        var isButton = target instanceof Phaser.Button;
        copy.x = target.worldTransform.tx / target.worldTransform.a;
        copy.y = target.worldTransform.ty / target.worldTransform.d;

        //for some reason Phaser incorrectly calculates worldTransfom for
        //a buttons
        if (isButton){
            copy.x /= nge.assets.getQualityFactor();
            copy.y /= nge.assets.getQualityFactor();
        }

        var texture = target.generateTexture();
        copy.x += target._bounds.x;
        copy.y += target._bounds.y;

        copy.setTexture(texture);

        copy.width = target.width ;
        copy.height = target.height ;
        return copy;
    };

});



nge.Com.WelcomePopup = {};



nge.Com.WelcomePopup.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _self;
    var _dontShowFlag = false;

    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        _self = this;
        this.createDefault();

        if (!_created) {
            _subscribe();
            _created = true;
        }

        //some games(livingLarge) has a big logo. need to scale them
        var logo = nge.find('^welcomePopupLogo');
        var scale = logo.width > 900 ? 0.8 : 1;
        logo.scaleY = scale;
        logo.scaleX = scale;
        
        return true;
    };

    var _show = function () {
        var popup = nge.find('#welcomePopup');
        popup.visible = true;
    };

    var _dontShow = function () {
        _dontShowFlag = !_dontShowFlag;

        var el = nge.find('.welcomePopup .welcome-checkbox');
        el.removeClass('regular').removeClass('active');
        if (_dontShowFlag)
            el.addClass('active');
        else
            el.addClass('regular');

        nge.observer.fire('welcomePopup.showTutorial', !_dontShowFlag);
    };

    var _play = function () {
        nge.localData.set('showTutorial', false);
        var popup = nge.find('#welcomePopup');
        popup.destroy(true);

        nge.observer.fire('welcomePopup.hidden');
    };

    var _subscribe = function () {
        nge.observer.add('welcomePopup.show', _show);
        nge.observer.add('welcomePopup.dontShow', _dontShow);
        nge.observer.add('welcomePopup.play', _play);
    };
});



