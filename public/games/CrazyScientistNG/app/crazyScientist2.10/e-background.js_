nge.App[nge.appNS].Com.PickupBonusGame.View = nge.Com.Base.extend(function () {
    let _cache = null;
    let _animationHelper = null;

    this.createPickupBonusGame = () => {
        _cache = this.getInstance('ObjectsCache');
        _animationHelper = this.getInstance('AnimationHelper');

        _cache.reset();
        _animationHelper.create();
        
        this._prepareLinks();
        this._prepareObjects();
        this._reset();
    };

    this._prepareLinks = () => {

    };

    this._prepareStartPopup = () => {
        const startPopup = _cache.get('startPickBonusPopupContainer');

        startPopup.x += startPopup.children[0].x;
        startPopup.y += startPopup.children[0].y;

        startPopup.children.forEach(child => {
            child.x -= startPopup.x;
            child.y -= startPopup.y;
        });
    
    };

    this._prepareObjects = () => {
        this._prepareStartPopup();

        const borderShineContainer = _cache.get('borderShineContainer');

        borderShineContainer.children.forEach(child =>  { 
            child.anchor.set(0.5);
            child.x += child.width / 2;
            child.y += child.height / 2;
            child.scale.set(child.scale.x * 0.8); 
            child.visible = false;
        });
    };

    this._resetFirstStage = () => {
        const pG1Text = _cache.get('pG1Text');
        pG1Text.alpha = 0;

        for(let i = 1; i < 7; i++){
            const drone = _cache.get('dron'.concat(i, 'Container'));
            const text = _cache.get('pG1Win'.concat(i));
           
            drone.children[0].loadTexture('robot_idle_000');
            drone.children[0].scale.set(0);
            
            drone.alpha = 0;
            text.alpha = 0;
        }

        nge.observer.fire('buttons.drone.disable');
    };

    this._resetSecondStage = () => {
        const pg2Text = _cache.get('pg2Text');
        pg2Text.alpha = 0;

        const pickGameInfo = _cache.get('pickGameInfo');
        pickGameInfo.alpha = 0;
        
        for(let i = 1; i < 7; i++){
            const latern = _cache.get('pg10'.concat(i, 'Container'));
            const text = _cache.get('pG2Win'.concat(i));
            
            latern.children[0].loadTexture('flask_idle_animation_000');
            latern.children[0].scale.set(0);
            latern.alpha = 0;
            text.alpha = 0;
        }

        nge.observer.fire('buttons.latern.disable');
    };

    this._reset = () => {
        this._resetMainContainers();
        this._resetFirstStage();
        this._resetSecondStage();
        this._resetBackgroundBorder();
    };

    this._resetBackgroundBorder = () => {
        const borderShineContainer = _cache.get('borderShineContainer');
        borderShineContainer.children.forEach(child => child.visible = false);
    };
    
    this._resetMainContainers = () => {
        const startPopup = _cache.get('startPickBonusPopupContainer');
        const slotMachineContainer = _cache.get('slotMachineContainer');
        const pickupBg = _cache.get('pickGameBgContainer');
        const pickGameContainer = _cache.get('pickGameContainer');
        
        startPopup.visible = false;
        startPopup.scale.set(0);
        // startPopup.alpha = 0;

        slotMachineContainer.alpha = 1;

        pickGameContainer.visible = false;

        pickupBg.alpha = 0;
    };
    
    this.startPickupBonusGame = () => {
        _animationHelper.stopAllAnimation();
        this._reset();
        _animationHelper.run('showStartPopup');
    };

    this.finishStage1 = data => {
        _animationHelper.run('finishFirstStage');
    };

    this.finishStage2 = data => {
        _animationHelper.run('finishSecondStage');
    };

    this.hidePickupBonusGame = () => {
        _animationHelper.run('hideBonusGame');
    }
});



