nge.App[nge.appNS].Com.SlotMachine.View = nge.Com.SlotMachine.View.extend(function () {
    this.stopJumpDistance = 75; //was 75
    this.stopJumpTime = 200;  //100 if forceSetTimeOut false
    var _self;

    this.getSymbolKeyForUpperAnimation = function (index) {
        if(!_self) {
            return console.warn('_self is not defined! Aborting...');
        }

        var symbolsKeys = _self._cfg.symbolsBlurKeys;

        if (_self._cfg.symbolsBlurKeys &&
            _self._cfg.symbolsBlurKeys[index] &&
            typeof _self._cfg.symbolsBlurKeys[index] === 'object'
            )
            symbolsKeys = _self._cfg.symbolsBlurKeys[index];

        return symbolsKeys[~~(Math.random() * symbolsKeys.length)];
    };

    /**
     * bounce reel at stopping
     * @param {object} phaserReel
     * @param {number} index
     * @returns {Boolean}
     */
    this.customReelStopCallback = function (phaserReel, index) {
        if (!phaserReel || this.spinDirection !== 'forward')
            return false;

        _self = this;
        var stopY = 0;

        if (_self._cfg.rowsYoffset && _self._cfg.rowsYoffset[index])
            stopY = _self._cfg.rowsYoffset[index];

        var key = _self.getSymbolKeyForUpperAnimation(index);

        var symbol = _self._pool.release(key);
        symbol.texture.y = (-0.5) * _self._symbolSize.height;
        symbol.texture.x = _self._symbolSize.width / 2;
        phaserReel.addChild(symbol.texture);

        if (_self._cfg.rowsYoffset && _self._cfg.rowsYoffset[index])
            phaserReel.y = _self._cfg.rowsYoffset[index];

        var reelTween = nge.tween.add(phaserReel);
        reelTween.to({y: stopY + _self.stopJumpDistance}, _self.stopJumpTime / 2, nge.Lib.Tween.Easing.Linear.None, false);
        reelTween.to({y: stopY}, _self.stopJumpTime / 2, nge.Lib.Tween.Easing.Linear.None, false);
        reelTween.onComplete.addOnce(function () {
            phaserReel.removeChild(symbol.texture);
            _self._pool.store(false, symbol);
            nge.observer.fire('slotMachine.reel_' + index + '.customPostAnimation.stopped');
        });
        reelTween.start();
    };
});



nge.App[nge.appNS].Com.SlotMachine.RecyclerView = nge.Com.SlotMachine.RecyclerView.extend(function () {
    this.stopJumpDistance = 75;
    this.stopJumpTime = 200;

    this.getBaseStopCounters = function() {
        var counters = this.super.getBaseStopCounters();

        var turboModeEnabled = nge.localData.get('settings.turboMode');

        if (turboModeEnabled) {
            for (var i = 0; i < counters.length; i++) {
                counters[i] = Math.round(counters[i]/2);
            }
        }
        return counters;
    };

    this.customReelStopCallback = (reel, index) => {
        const offset = { y: 0 };
        const tween = nge.tween.add(offset);

        let lastY = 0;

        tween.to({y: this.stopJumpDistance}, this.stopJumpTime / 2, nge.Lib.Tween.Easing.Linear.None, false);
        tween.to({y: 0}, this.stopJumpTime / 2, nge.Lib.Tween.Easing.Linear.None, false);
        tween.onUpdateCallback(() => {
            reel.move(offset.y - lastY);
            lastY = offset.y;
        });
        tween.onComplete.addOnce(() => {
            reel.move(offset.y - lastY);
            nge.observer.fire('slotMachine.reel_' + index + '.customPostAnimation.stopped');
        });
        tween.start();
    };
});



nge.App[nge.appNS].Com.SpaceHandler = {};



nge.App[nge.appNS].Com.SpaceHandler.Controller = nge.Com.Base.extend(function () {
    var _self = this;
    var _created;
    var _spinButtonState;
    var _firstStart;
    var _winlinesAnimated;
    var _balanceRequested = false;
    var _safeFramesFromCreate = false;
    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        _firstStart = true;
        _winlinesAnimated = true;
        _balanceRequested = false;
        _safeFramesFromCreate = false;
        if (!_created)
            _subscribe();
        nge.localData.set('spaceHandler.isEnable', true);
        _created = true;
        return true;
    };

    this.extendDo = function() {};

    var _do = function () {
        var tableOrMobileFlag = nge.Lib.Helper.mobileAndTabletCheck();

        if(tableOrMobileFlag)
            return;
        
        var isPaytableShowed = nge.localData.get('paytable.showed');
        var restore = nge.localData.get('slotMachine.lastResponse');
        var isOfferMenu = nge.localData.get('freeGame.showingOfferMenu', true);
        var isEnable = nge.localData.get('spaceHandler.isEnable');
        var quickFinishWaiting = nge.localData.get('slotMachine.quickFinishWaiting');

        if(!restore && _firstStart){
            var spinStopped = nge.localData.get('spin.onStop', false);
            if(!spinStopped) {
                _firstStart = false;
                _spinButtonState = true;
            }
        }

        if (_self.extendDo())
            return true;

        if ((_spinButtonState && !isOfferMenu && !isPaytableShowed && (_winlinesAnimated || quickFinishWaiting) && isEnable) &&
            !(_spinButtonState && !_balanceRequested && _safeFramesFromCreate && !isOfferMenu && !isPaytableShowed && (_winlinesAnimated || quickFinishWaiting) && isEnable)) {
            console.color('OOOPS! | Balance Requested: ' + _balanceRequested + ' | Safe Frames: ' + _safeFramesFromCreate, '#ff5', '#33a');
        }

        //NOTE (r.rakhman): [JSCLIENT-3580] _balanceRequested and _safeFramesFromCreate flags added.
        //To see incorrect spinCommands: set transport delay (mapper: raf in socket.onMessage), uncomment code (1) and execute in console (2).
        //Need (case 1) to receive jackpot in spin without win and (case 2) back to play scene after jackpots.
        /* (1)
        if ((_spinButtonState && !isOfferMenu && !isPaytableShowed && (_winlinesAnimated || quickFinishWaiting) && isEnable) &&
            !(_spinButtonState && !_balanceRequested && _safeFramesFromCreate && !isOfferMenu && !isPaytableShowed && (_winlinesAnimated || quickFinishWaiting) && isEnable)) {
            console.color('OOOPS! | Balance Requested: ' + _balanceRequested + ' | Safe Frames: ' + _safeFramesFromCreate, '#ff5', '#33a');
        }
         */
        /* (2)
        var f = function(){
        var f2 = function(){nge.observer.fire('space.press.do');};
        f2();
        setTimeout(f2, 1);
        setTimeout(f2, 2);
        nge.rafSetTimeout(f,1);
        }
        f();
         */
        if (_spinButtonState && _safeFramesFromCreate && !isOfferMenu && !isPaytableShowed && (_winlinesAnimated || quickFinishWaiting) && isEnable)
            nge.observer.fire('buttons.pressCommand', 'spin');

        return false;
    };

    var _changeData = function (data) {
        if(data && data.spin){
            _spinButtonState = data.spin.enabled;
        }
    };

    var _offSpaceHandler = function () {
        _winlinesAnimated = false;
    };

    var _onSpaceHandler = function () {
        _winlinesAnimated = true;
    };

    this.customSubscribe = function() {
        nge.observer.add('slotMachine.spinComplete', _offSpaceHandler);
        nge.observer.add('winlines.animateByOne.cycleComplete', _onSpaceHandler);
    };

    var _onSpaceSwitch = function(){
        var currState = nge.localData.get('spaceHandler.isEnable') || false;
        nge.localData.set('spaceHandler.isEnable', !currState);
        nge.observer.fire('spaceHandler.switched', !currState);
    };

    var _onBalanceRequest = function () {
        _balanceRequested = true;
    };

    var _onBalanceResponse = function () {
        _balanceRequested = false;
    };

    var _subscribe = function () {
        nge.observer.add('space.press.do', _do);
        nge.observer.add('keyboard.KeyDown.SPACE', _do);
        nge.observer.add('buttons.changeData', _changeData);
        nge.observer.add('spaceHandler.off', _offSpaceHandler);
        nge.observer.add('spaceHandler.on', _onSpaceHandler);
        nge.observer.add('spaceHandler.switch', _onSpaceSwitch);
        nge.observer.add('balanceRequest', _onBalanceRequest);
        nge.observer.add('transportMessage.BalanceResponse', _onBalanceResponse);
        nge.observer.add('settings.settingsPressSpaceToSpin', function(toggle) {
            if (toggle)
                _onSpaceHandler();
            else
                _offSpaceHandler();
        });

        nge.observer.add('StatesManager.display.start', function () {
            _safeFramesFromCreate = false;
        });
        nge.observer.add('StatesManager.create.end', function () {
            nge.rafSetTimeout(function () {
                _safeFramesFromCreate = true;
            }, 1);
        });

        _self.customSubscribe();
    };
});



nge.App[nge.appNS].Com.QuickSettingsPanel = {};



nge.App[nge.appNS].Com.QuickSettingsPanel.Controller = nge.Com.Base.extend(function() {
    var AUTO_CLOSE_TIME = 3000;
    var _created = false;
    var _self = this;

    this.mobileOnly = false; // TODO: для прототипов должно быть false. Расхождение классики с prototypes

    var _isMobile = false;
    var _namingPart = '';

    var _quickSettingsBtn;
    var _quickSettingsBg;

    var _bgMaxHeigth = 0;
    var _bgMinHeigth = 0;
    var _bgMinWidth = 0;
    var _bgMaxWidth = 0;

    var _quickSettingsButtons = {
        fullscreen: null,
        sound: null,
        settings: null,
        help: null
    };

    var _autoClose = true;
    var _soundPreloadingTween = null;

    function initButtons() {
        var key, button;
        for (key in _quickSettingsButtons) {
            button = nge.findOne('^' + key + _namingPart + 'ButtonButton');
            if (button){
                button.startY = +button.y;
                button.disable(3);
                button.y = _quickSettingsBtn.y;
                _quickSettingsButtons[key] = button;
            } else {
                delete _quickSettingsButtons[key];   
            }
        }
        if(_isMobile)
            nge.rafSetTimeout(function(){
                setSoundButtonIcon(0);
            }, 10);
    }

    var _resizeBg = function(width, height){
        if(_quickSettingsBg) {
            _quickSettingsBg.resize(width, height);
        }
        
    };

    function switchToggle(button, onCallback, offCallback) {
        button.toggleOn = !button.toggleOn;
        if (button.toggleOn) {
            button.setFrames(5, 4, 3);
            if (onCallback) onCallback();
        } else {
            button.setFrames(2, 1, 0);
            if (offCallback) offCallback();
        }
    }

    function interpolatePosition(item, y0, y1, t) {
        var tt = nge.Lib.Math.clamp(t, 0, 1);
        item.y = +y0 + (tt * (+y1 - +y0));
    }
    

    function panelUnfoldAnimation() {

        var y0 = _quickSettingsBtn.y;
        var data = {y: _bgMinHeigth};

        var tween = nge.tween.add(data).
            to({y: _bgMaxHeigth}, 100).
            onUpdateCallback(function (ctx, time, tweenData) {
                for (var key in _quickSettingsButtons) {
                    var button = _quickSettingsButtons[key];
                    
                    if(!button)
                        return;
                    
                    var y1 = button.startY;
                    interpolatePosition(button, y0, y1, tweenData.percent);                    
                }
                var height = ((tweenData.vEnd.y - tweenData.vStart.y) * tweenData.value) + tweenData.vStart.y;
                _resizeBg(_bgMaxWidth, height);

            }, data);

        tween.onComplete.add(function() {
            for (var key in _quickSettingsButtons) {
                var button = _quickSettingsButtons[key];
                if(!button)
                    return;
                button.y = button.startY;
                _resizeBg(_bgMaxWidth, _bgMaxHeigth);
            }
        });

        for (var key in _quickSettingsButtons){
            if(_quickSettingsButtons[key])
                _quickSettingsButtons[key].visible = true;    
        }        
        tween.start();
    }

    function panelFoldAnimation() {
        var y1 = _quickSettingsBtn.y;
        var data = {y: _bgMaxHeigth};
        var tween = nge.tween.add(data).
            to({y: _bgMinHeigth}, 100).
            onUpdateCallback(function (ctx, time, tweenData) {
                for (var key in _quickSettingsButtons) {
                    var button = _quickSettingsButtons[key];

                    if(!button)
                        return;
                    
                    var y0 = button.startY;
                    interpolatePosition(button, y0, y1, tweenData.percent);
                }
                var height = ((tweenData.vEnd.y - tweenData.vStart.y) * tweenData.value) + tweenData.vStart.y;
                _resizeBg(_bgMaxWidth, height);
            
            }, data);

        tween.onComplete.add(function() {
            for (var key in _quickSettingsButtons) {
                var button = _quickSettingsButtons[key];
                
                if(!button)
                    return;

                button.y = y1;
                button.visible = false; 
                _resizeBg(_bgMaxWidth, _bgMinHeigth);
            }
        });
        tween.start();
    }

    function quickSettingsPanelSwitch() {
        switchToggle(
            _quickSettingsBtn,
            function() {
                panelUnfoldAnimation();
            },
            function() {
                panelFoldAnimation();
            });
    }

    function setSoundButtonIcon(vol) {
        if (vol === 0)
            _quickSettingsButtons && _quickSettingsButtons.sound.setFrames(5, 4, 3);
        else
            _quickSettingsButtons && _quickSettingsButtons.sound.setFrames(2, 1, 0);
    }

    function switchSound() {
        var vol = nge.localData.get('settings.globalVolume', 1);
        if (typeof vol === 'undefined') vol = 1;

        var newVol = (vol) ? 0 : 1;
        nge.localData.set('settings.globalVolume', newVol);
        nge.observer.fire('sound.volumeAll', newVol);

        setSoundButtonIcon(newVol);
    }

    function _panelForceHide() {
        if (_quickSettingsBtn.toggleOn) quickSettingsPanelSwitch();
    }

    function onLayersSwitcherShow(layer) {
        _panelForceHide();
        
        if (layer === 'settingWindow') 
            nge.observer.fire('settings.show');
    }

    function fullscreenToggle() {
        if(_isMobile || !_quickSettingsButtons.fullscreen)
            return;

        var fullscreen = nge.localData.get('fullscreen.enabled', true);
        if (fullscreen)
            _quickSettingsButtons.fullscreen.setFrames(5, 4, 3);
        else
            _quickSettingsButtons.fullscreen.setFrames(2, 1, 0);
    }

    function spinStartHandler() {
        _panelForceHide();
    }

    var _soundsStartPreloadHandler = function(){
        var startValue = 6;
        var finishValue = 9;
        var framesCount = (finishValue - startValue) + 1;

        _soundPreloadingTween = nge.tween.add({}).to({}, 2000, null, false, 500, -1);

        _soundPreloadingTween.onUpdateCallback(function(tween, value){
            var frameDelta = (framesCount*value) + (0.05*framesCount);
            var totalFrame = startValue + Math.floor(frameDelta);

            // last frame duration fix
            if((finishValue + 1) === totalFrame)
                totalFrame -= 1;

            _quickSettingsButtons.sound.frame = totalFrame;
        });

        _soundPreloadingTween.onComplete.add(function(){
            setSoundButtonIcon(1);
        });

        _soundPreloadingTween.start();
    };
    
    var _soundsPreloadedHandler = function(){
        _soundPreloadingTween.stop();
    };

    function _checkButton(button, callback) {
        if (_quickSettingsBtn === button)
            return callback();
        for (var i in _quickSettingsButtons)
            if (_quickSettingsButtons[i] === button)
                return callback();
    }

    function _onInputOver() {
        _autoClose = false;
    }

    function _onInputOut() {
        _autoClose = true;
        nge.rafSetTimeout(function() {
            if (!_autoClose) return;
            _panelForceHide();
        }, AUTO_CLOSE_TIME);
    }

    function _onButtonHover(button) {
        _checkButton(button, _onInputOver);
    }

    function _onButtonUnhover(button) {
        _checkButton(button, _onInputOut);
    }

    this.subscribe = function() {
        nge.observer.add('layersSwitcher.show', onLayersSwitcherShow);
        nge.observer.add('quickSettings.panelHide', _panelForceHide);
        nge.observer.add('quickSettings.panelSwitch', quickSettingsPanelSwitch);
        nge.observer.add('quickSettings.soundSwitch', switchSound);
        nge.observer.add('sound.volumeAll', setSoundButtonIcon);
        nge.observer.add('fullscreen.on', fullscreenToggle);
        nge.observer.add('fullscreen.off', fullscreenToggle);
        nge.observer.add('slotMachine.spinStart', spinStartHandler);
        nge.observer.add('button.hover', _onButtonHover);
        nge.observer.add('button.unhover', _onButtonUnhover);

        if(_isMobile){
            nge.observer.add('sounds.preload.start', _soundsStartPreloadHandler);
            nge.observer.add('sounds.preloaded', _soundsPreloadedHandler);
        }
    };

    this.create = function() {
        _isMobile = nge.Lib.Helper.mobileAndTabletCheck();
       
        if(this.mobileOnly && !_isMobile)
            return;

        if(_isMobile){
            _namingPart = 'Mobile';
            delete _quickSettingsButtons.fullscreen;
        }

        _quickSettingsBtn = nge.findOne('^quickSettingsPanel' + _namingPart + 'ButtonButton');
        _quickSettingsBtn.toggleOn = false;
        _quickSettingsBg = nge.findOne('^settingPanel' + _namingPart + 'BackBg');
        _quickSettingsBg.scale.set(1 / nge.assets.getQualityFactor());
        _quickSettingsBg.rotation = Math.PI;

        if(_quickSettingsBg){
            var data = _quickSettingsBg.getData();
            _bgMinHeigth = (+data.top + +data.bottom) * nge.assets.getQualityFactor();
            _bgMaxHeigth = _quickSettingsBg.height * nge.assets.getQualityFactor();
            _bgMinWidth = (+data.left + +data.right) * nge.assets.getQualityFactor();
            _bgMaxWidth = _quickSettingsBg.width * nge.assets.getQualityFactor();
            _resizeBg(_bgMaxWidth, _bgMinHeigth);
        }

        initButtons();

        quickSettingsPanelSwitch();

        if (!_created)
            _self.subscribe();

        _created = true;
    };
});



nge.App[nge.appNS].Com.QuickSettingsPanel.UI_v3 = {};



nge.App[nge.appNS].Com.QuickSettingsPanel.UI_v3.Controller = nge.App[nge.appNS].Com.QuickSettingsPanel.Controller.extend(function() {
    this.mobileOnly = false;
});



nge.App[nge.appNS].Com.TotalBet = {};



nge.App[nge.appNS].Com.TotalBet.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _isMobile = false;
    this.currencyColor = '#00BFFF';
    var _self = this;

    var DESKTOP_MAX_WIDTH = 150;
    var MOBILE_MAX_WIDTH = 250;

    var _additionalMaxWidth = {
        'betSettingsExtended': 250
    };

    this.create = function () {
        this.createDefault();

        _isMobile = nge.Lib.Helper.mobileAndTabletCheck();

        nge.rafSetTimeout(_update, 1);

        if (!_created)
            _subscribe();
        _created = true;
        return true;
    };

    var _update = function () {
        var l = nge.localData.get('lines.value');
        var b = nge.localData.get('bet.value');
        var c = nge.localData.get('coins.value');
        var bm = nge.localData.get('betMultiplier');

        if (!l || !b || c === undefined)
            return false;

        var totalBet = l * b * c * bm;
        nge.localData.set('totalBet.value', totalBet);
        var totalBetNumbers = nge.findAll('.totalBetNumber');
        var hand = nge.localData.get('pokerMachine.gameParameters.handsQty');
        var currency = nge.localData.get('balance.currency') || '';
        var extraBet = (nge.localData.get('extraBet') === '1') ? nge.localData.get('extraBetMult') : 1;
        var text = (totalBet * extraBet).toFixed(2);

        if (hand)
            text = nge.Lib.Validator.convertToFloat(totalBet * hand);

        var maxWidth = _isMobile ? MOBILE_MAX_WIDTH : DESKTOP_MAX_WIDTH;

        totalBetNumbers.forEach(function (totalBetNumber) {
            totalBetNumber.text = text + ' ' + currency;
            totalBetNumber.clearColors();
            totalBetNumber.addColor(_self.currencyColor, text.length);

            if (totalBetNumber.hasClass('betSettingsExtended'))
                maxWidth += _additionalMaxWidth.betSettingsExtended;

            totalBetNumber.maxSizeResize('width', maxWidth);
        });

        nge.observer.fire('totalBet.change');
        return true;
    };

    var _subscribe = function () {
        nge.observer.add('brain.openGameSuccess', _update);
        nge.observer.add('bet.change', _update);
        nge.observer.add('lines.change', _update);
        nge.observer.add('coins.change', _update);
        nge.observer.add('totalBet.update', _update);
    };
});



