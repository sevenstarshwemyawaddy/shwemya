nge.App[nge.appNS].Cfg = {};


/* global nge */

nge.App[nge.appNS].Mlm = {};



/* global nge */

nge.App[nge.appNS].Mlm.Brain = {};




nge.App[nge.appNS].Mlm.Brain.ButtonsExtension = function () {
    this.autoBtnOn = 'STOP\n';
    this.autoBtnOff = 'AUTO\nSTART';
    this.stopCommandEvent = 'slotMachine.tryStop';
    var _spinButton;

    var _self = this;
    var _cache = {};

    this.mainButtons.push('settings');

    this.beforeUpdateHandler = function(model) {
        this.super.beforeUpdateHandler(model);
        
        if(model.auto && nge.localData.get('autospin'))
            model.auto.title = this.autoBtnOn;
    };

    this.onGambleTakeExtension = function () {};
    this.setButtonsStateOnWinCycleComplete = () => {};

    this.restoreDesktopButtons = function () {
        var freespinInProgress = nge.localData.get('freespin.inProgress');

        if (freespinInProgress)
            return;

        this.super.restoreDesktopButtons();
    
        this.changeButtonState('pageThreeTrigger', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageThreeHeaderContainer', container: 'pageThreeContainer'}, 1);
        }, true);

        this.changeButtonState('settings', undefined, _settingsButtonCallback, true);

        this.changeButtonState('settingsSplashScreen', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('settings.splashScreenSwitch');
        }, true);

        this.changeButtonState('settingsDisplayValuesInCoins', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('currencySwitcher.switch');
        }, true);

        this.changeButtonState('turboMode', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('settings.turboModeSwitch');
        }, true);

        this.changeButtonState('settingsPressSpaceToSpin', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('spaceHandler.switched');
        }, true);
        
        this.changeButtonState('spin', this.spinBtnName, () => nge.observer.fire('slotMachine.trySpin'), true);
    };

    this._autoButtonEnableSwitch = function (bool) {
        this.super._autoButtonEnableSwitch(bool);
        nge.observer.fire('autoButtonEnableSwitched');
    };

    this.offerRestore = function(){
        var freespinInProgress = nge.localData.get('freespin.inProgress');
        var spinsLeft = parseInt(nge.localData.get('freespin.spinsLeft'), 10);
        if (freespinInProgress && spinsLeft > 0)
            return false;

        this.super.offerRestore();
        var auto = nge.localData.get('autospin');
        var freeGameAmount = parseInt(nge.localData.get('freeGame.amount'), 10);
        var enableButtons = (freeGameAmount !== 0) && !auto;
        
        this.changeButtonState('settings', undefined, _settingsButtonCallback, enableButtons);
        this.changeButtonState('auto', undefined, undefined, true);
    };

    var _settingsButtonCallback = function () {
        nge.observer.fire('paytable.show');
        nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageThreeHeaderContainer', container: 'pageThreeContainer'}, 1);
    };

    var _onStartBigWin = function () {
        nge.observer.fire('buttons.changeData', {
            quickSettingsPanel: {
                enabled: false
            }
        });

        if (_cache.spinButtonTopContainer && _cache.spinButtonContainer)
            _cache.spinButtonTopContainer.add(_cache.spinButtonContainer);
    };

    var _onCompleteBigWin = function () {
        nge.observer.fire('buttons.changeData', {
            quickSettingsPanel: {
                enabled: true
            }
        });

        if (_cache.spinButtonUIParent && _cache.spinButtonContainer)
            _cache.spinButtonUIParent.add(_cache.spinButtonContainer);
    };

    var _onDoSpinPress = function () {
        nge.observer.fire('buttons.pressCommand', 'spin');
    };

    var _onFreespinContinue = function () {
        const param = { enabled: true };

        nge.rafSetTimeout(function () {
            nge.observer.fire('buttons.changeData', {
                settings: param,
                paytable: param
            });
        }, 1);
    };

    var _onPaytableHide = function () {
        if (nge.localData.get('freespin.inProgress') && !nge.localData.get('autospin'))
            nge.observer.fire('buttons.changeData', {
                spin: {
                    enabled: true
                }
            });
    };

    this.onTryStop = function() {
        _spinButton.disable(7);
    };

    this.onButtonsCreateEnd = function(){
        this.super.onButtonsCreateEnd();
        _spinButton = nge.findOne('^spinButtonButton');
        this.enableFreespinText(false);
        _cache.spinButtonTopContainer = nge.findOne('^spinButtonTopContainer');
        if (_spinButton)
            _cache.spinButtonContainer = _spinButton.parent;
        if (_cache.spinButtonContainer)
            _cache.spinButtonUIParent = _cache.spinButtonContainer.parent;
    };

    this._autoSpinSimpleOffCallback = () => nge.observer.fire('autospin.button.click');
    this._autoSpinSimpleOnCallback = () => nge.observer.fire('autospin.button.click');

    this._autospinEndedHandler = () => {
        this.changeButtonState('auto', this.autoBtnOff);
    };

    this.freespinReadyHandler = () => {
        _spinButton.setFrames(2, 1, 0, 3);
        nge.observer.fire('buttons.changeData', {
            spin: {
                enabled: true,
                title: this.spinBtnName,
                callback: () => nge.observer.fire(_self.spinCommandEvent)
            },
            settings: {
                enabled: true
            },
            paytable: {
                enabled: true
            }
        });
    };

    var _onAutospinStarted = function () {
        nge.observer.fire('buttons.changeData', {
            auto: {
                title: _self.autoBtnOn
            }
        });
    };

    this.onSpinStartExtension = () => {
        const params = {};
        const enabled = false;
        const noUpdateButtons = ['spin', 'auto'];

        for(let btnIndex in this.mainButtons){
            const btnName = this.mainButtons[btnIndex];

            if (!_self.holdEnabled && noUpdateButtons.indexOf(btnName) !== -1)
                continue;

            params[btnName] = { enabled };         
        }

        nge.observer.fire('buttons.changeData', params);
    };

    this.slotMachineIntrigueHandler = () => {
        _spinButton.disable(7);
    };

    this.spinCommandHandler = () => {
        _spinButton.disable(7);
    };

    this._processWinOnCycleComplete = () => {
        let offerCount = nge.localData.get('freeGame.amount');
        let offer = nge.localData.get('freeGame.inProgress');
        let auto = nge.localData.get('autospin');
        
        const freeGameCountIsZero = parseInt(offerCount, 10) === 0;

        if (offer && freeGameCountIsZero && auto) {
            nge.observer.fire('buttons.insidePress', 'auto');
            _self._autoButtonEnableSwitch(true);
        }
    };

    this.spinCompleteHandler = () => {
        let name = nge.localData.get('wasQuickFinish') ? this.stopBtnName : this.spinBtnName;
        this.changeButtonState('spin', name, () => nge.observer.fire('slotMachine.trySpin'), true); 
    };

    this.onRestore = () => {
        if(!nge.localData.get('slotMachineSpinning')){
            this.super.onRestore();
            nge.localData.set('spaceHandler.isEnable', true);
        }
    }

    this.onGambleButtonsShow = () => {}

    this.freespinResumeHandler = () => {
        nge.observer.fire('buttons.changeData', {
            spin: {
                title: this.spinBtnName,
                enabled: true,
                callback: () => nge.observer.fire(_self.spinCommandEvent)
            }
        });
    };

    this.quickFinishHandler = () => {
        nge.localData.set('slotMachine.quickFinishWaiting', false);
        _spinButton.disable(7);
    };

    this.disableAllRiverButtons = () => {
        nge.observer.fire('buttons.disable.all');
    };

    this.subscribe = function(){
        this.super.subscribe();
        nge.observer.add('river.buttons.disable.all', this.disableAllRiverButtons, false, true);
        nge.observer.add('slotMachine.quickFinish', this.quickFinishHandler, false, true);
        nge.observer.add('slotMachine.spinCommand', this.spinCommandHandler, false, true);
        nge.observer.add('slotMachine.intrigueStarted', this.slotMachineIntrigueHandler, false, true);
        nge.observer.add('buttons.freespinReady', this.freespinReadyHandler, false, true);
        nge.observer.add('autospin.ended', this._autospinEndedHandler, false, true);
        nge.observer.add('buttons.startBigWin', _onStartBigWin, false, true);
        nge.observer.add('buttons.completeBigWin', _onCompleteBigWin, false, true);
        nge.observer.add('buttons.doSpinPress', _onDoSpinPress, false, true);
        nge.observer.add('buttons.freespinContinue', _onFreespinContinue, false, true);
        nge.observer.add('paytable.hide', _onPaytableHide, false, true);
        nge.observer.add('slotMachine.tryStop', _self.onTryStop, false, true);
        nge.observer.add('autospin.started', _onAutospinStarted, false, true);
    };
};



nge.App[nge.appNS].Mlm.Brain.Buttons = nge.App.ClassicGameBase.Mlm.Brain.Buttons.extend(nge.App[nge.appNS].Mlm.Brain.ButtonsExtension);



nge.App[nge.appNS].Mlm.Brain.Jackpot = nge.App.ClassicGameBase.Mlm.Brain.Jackpot.extend(function () {
    const _balanceResponce = this.balanceResponseHandler;

    this.balanceResponseHandler = () => {
        if(nge.localData.get('jackpot.inProgress'))
            _balanceResponce();
    };

    this.subscribe = function () {
        this.super.subscribe();
        nge.observer.add('slotMachine.tryLaunchJackpot', _balanceResponce, false, true);

    };
});



nge.App[nge.appNS].Mlm.Brain.Slot = nge.App.ClassicGameBase.Mlm.Brain.Slot.extend(function () {
    this._wasQuickFinish = false;
    this._popupInPopupStarted = false;

    let _balanceData = {};
    let _balanceRequested = false;
    let _counterFinished = true;
    let _stateChanged = false;
    let _curState = 'Ready';
    let _wasFreespin = false;
    let _bigWinFinished = false;
    let _realBalanceRequested = false;
    let _balanceReceived = false;
    let _autoWasEnabled = true;

    this.gameStateCheckCallbacks = {
        isFreespin: () => nge.localData.get('freespin.inProgress')
    };

    this._printTotalWin = function () {
        var slotMachine = nge.localData.get('slotMachine');
        var freespinInProgress = nge.localData.get('freespin.inProgress');

        if (!slotMachine.slotWin)
            return;

        var winAmount = freespinInProgress ? (slotMachine.totalBonusWin || slotMachine.slotWin.totalWin) : slotMachine.slotWin.totalWin;
        var winInCoins = nge.Lib.Money.toCoinsInt(winAmount);

        this.printWin(winInCoins);
    };

    this.gambleTakingStopAndBalanceResponseBothHandler = () => {
        nge.observer.fire('balance.set', _balanceData.data);
    };

    this.gambleTakingStopHandler = () => {};

    this.looseHandler = () => {};

    this.balanceResponseHandler = data => {
        _balanceData = data;
        _balanceReceived = true;
        if (_wasFreespin) {
            _wasFreespin = false;

            nge.observer.fire('balance.update');

            if (nge.localData.get('freeGame.inProgress') && (parseInt(nge.localData.get('freeGame.amount'), 10) === 0)) {
                nge.localData.set('offers.waitingForFinish', true);
                return;
            }

            var offersList = nge.localData.get('offersList');
            if (offersList && offersList.length > 0 && nge.localData.get('offers.restoreGame')) {
                nge.observer.fire('offers.tryStart', null, 500);
                return;
            }

            nge.observer.fire('buttons.restore');
        }
    };

    this.spinStartHandler = () => {
        const isFreespin = this.gameStateCheckCallbacks.isFreespin();

        _counterFinished = false;
        _stateChanged = false;
        _realBalanceRequested = false;
        _balanceReceived = false;
        this._popupInPopupStarted = false;
        _balanceRequested = false;
        this._wasQuickFinish = false;

        const {
            slotMachine
        } = nge.localData.get();

        _curState = !slotMachine.state ? !slotMachine.lastResponse ? 'Ready' : slotMachine.lastResponse.state : slotMachine.state;

        nge.localData.set('slotMachine.quickFinishWaiting', true);

        // removing restore
        nge.localData.set('brain.restoreGame.lastResponse');

        if (!isFreespin)
            this.printWin(nge.i18n.get('GOOD LUCK'));
    };

    this.subscribeReelsStopAnimation = () => {
        const smCfg = nge.App.getInstance('Com.SlotMachine.Cfg');
        const {
            mw
        } = smCfg.get();

        const callback = (i) => {
            return () => {
                const {
                    startsFrom,
                    status
                } = nge.localData.get('slotMachineIntrigue') || {};

                if (status && (i === (startsFrom - 1)))
                    nge.observer.fire('slotMachine.intrigueStarted', i);
            };
        };

        for (let reelIndex = 0; reelIndex < mw; reelIndex++)
            nge.observer.add(`slotMachine.reel_${reelIndex}.animation.stop`, callback(reelIndex), false, true);
    };

    var _modifiedSuperBalanceRequest = function () {
        var freespinProgress = nge.localData.get('freespin.inProgress');
        var respinInprogress = nge.localData.get('respin.inProgress') && (+nge.localData.get(('respin.spinsLeft') || 0) > 0);
        var jackpotCanPlayRequested = nge.localData.get('jackpot.jackpotCanPlayRequested');
        if (freespinProgress || respinInprogress || jackpotCanPlayRequested)
            return false;
        _realBalanceRequested = true;
        nge.observer.fire('balanceRequest');
    };

    this._balanceRequest = function () {
        if (!_balanceRequested && nge.localData.get('slotMachine.state') === 'Ready')
            _modifiedSuperBalanceRequest();

        _balanceRequested = true;
    };

    this.spinResponseHandler = function (data) {
        this.super.spinResponseHandler(data);

        _counterFinished = false;

        nge.rafSetTimeout(this._balanceRequest, 0);

        this.updateState(data);

        nge.rafSetTimeout(() => nge.localData.set('slotMachine.quickFinishWaiting', true), 10);

        nge.localData.set('wasQuickFinish', false);
    };

    this.updateState = (data) => {
        const newState = data.state;

        _stateChanged = _curState !== newState;

        if (_stateChanged)
            nge.observer.fire('slotMachine.stateChanged');

        _curState = newState;
    };

    this.animateAllDoneHandler = function () {
        this.gambleTakingStopAndBalanceResponseBothHandler();
    };

    this.trySpinHandler = () => {
        const {
            slotWin = {}
        } = nge.localData.get('slotMachine');
        const totalWin = parseFloat(slotWin.totalWin) || 0;

        if (_bigWinFinished)
            return;
        
        if ((totalWin === 0 || _counterFinished) && !nge.localData.get('jackpot.canPlay')) {
            if (_realBalanceRequested && !_balanceReceived) {

                if(Object.keys(slotWin).length === 0 && !_stateChanged)
                    this._runConditionChecker();

                return;
            }
            nge.observer.fire('slotMachine.spinCommand');
            _autoWasEnabled = false;
            return;
        }
    
        this._wasQuickFinish = true;

        this.tryFinishBigWin();

        nge.localData.set('wasQuickFinish', true);

        nge.localData.set('slotMachine.quickFinishWaiting', true);
        nge.observer.fire('slotMachine.quickFinish');
    };

    this.tryFinishBigWin = () => {
        if (nge.localData.get('bigWin.show') && !_bigWinFinished) {
            nge.observer.fire('sound.bigWin.end');
            _bigWinFinished = true;
        }
    };

    this.stateChangedCallback = () => {
        nge.observer.fire('river.buttons.disable.all', null, 1);
    };

    this._setCounterFinished = function(val){
        _counterFinished = val;
    };

    this.countingFinishedHandler = () => {
        if (nge.localData.get('slotMachineSpinning'))
            return;

        _counterFinished = true;

        nge.observer.fire('balance.update');

        this.tryFinishBigWin();

        if (nge.localData.get('jackpot.canPlay') && (nge.localData.get('slotMachine.state') === 'Ready'))
            return;

        this._printTotalWin();

        if (_stateChanged)
            return this.stateChangedCallback();

        if (this.checkEndOfTheFreeGame())
            return;

        if (nge.localData.get('autospin')){
            _autoWasEnabled = true;
            return;
        }

        if (!this._wasQuickFinish && !this._popupInPopupStarted)
            return nge.observer.fire('buttons.restore');

        if (!nge.localData.get('bigWin.show')) {
            this._runConditionChecker();
        } else
            nge.observer.fire('buttons.restore', null, 300);
    };

    this._runConditionChecker = function(){
        nge.rafSetTimeout(() => {

            const condition = () => {
                var freespinInProgress = nge.localData.get('freespin.inProgress');
                var spinsLeft = parseInt(nge.localData.get('freespin.spinsLeft'), 10);
                return (freespinInProgress && spinsLeft > 0) || (_realBalanceRequested && _balanceReceived);
            };

            const callback = () => {
                nge.observer.fire('slotMachine.trySpin');
            };

            nge.Lib.Checker.delay(condition, callback, 50, 100000, true);
        }, 300);
    };

    this.checkEndOfTheFreeGame = () => {
        const {
            freeGame
        } = nge.localData.get();
        const freeGameEnded = parseInt(freeGame.amount, 10) === 0;
        const inProgress = freeGame.inProgress || false;

        if (freeGameEnded && inProgress) {
            nge.observer.fire('river.buttons.disable.all');
            nge.localData.set('spaceHandler.isEnable', false);
            nge.observer.fire('offers.tryFinish', null, 500);
            return;
        }

        return freeGameEnded;
    };

    this._freespinEnd = () => {
        _balanceRequested = false;
        _wasFreespin = true;
        this._balanceRequest();
    };

    this.startCounterHandler = () => {
        nge.localData.set('spaceHandler.isEnable', true);
        nge.localData.set('slotMachine.quickFinishWaiting', true);
    };

    this.setState = val => {
        _curState = val;
    };

    this.tryLaunchJackpot = () => {
        const canLaunch = nge.localData.get('jackpot.canPlay') && (nge.localData.get('slotMachine.state') === 'Ready');

        if(canLaunch)
            nge.observer.fire('slotMachine.tryLaunchJackpot');

        return canLaunch;
    };

    this.gambleTakeHandler = () => {};

    this.freespinFinishHandler = () => {
        nge.localData.set('spaceHandler.isEnable', false);
    };

    this.counterFinished = () => {
        if(this.tryLaunchJackpot())
            return;

        if (_stateChanged || !nge.localData.get('bigWin.show'))
            return;

        nge.observer.fire('buttons.restore');
    };

    this.freespinStart = () => {
        _stateChanged = true;
    };

    this.noBalanceHandler = () => {
        nge.observer.fire('buttons.restore');
    };

    this.spinCompleteHandler = () => {
        this.super.spinCompleteHandler();
        const {
            slotMachine
        } = nge.localData.get();

        if (!slotMachine.slotWin)
            this.checkEndOfTheFreeGame();
    };

    this._bigWinFinishedHandler = () => {
        _bigWinFinished = false;
    };

    this.updateOfferCountersHandler = () => {
        if (!nge.Lib.Helper.mobileAndTabletCheck())
            return;

        const {
            amount,
            totalspins,
            inProgress
        } = nge.localData.get('freeGame');
        const total = parseInt(totalspins, 10);
        const current = total - parseInt(amount, 10);

        if (inProgress && !nge.localData.get('freespin.inProgress'))
            nge.observer.fire('freespin.counterUpdate', {
                total,
                current
            });
    };

    this.finishAutoSpinsHandler = function(){
        const {
            freeGame
        } = nge.localData.get();
        const inProgress = freeGame.inProgress || false;

        if(inProgress)
            return;

        if (_autoWasEnabled){
            _autoWasEnabled = false;
            nge.observer.fire('buttons.restore');
        }
    };

    this.customSubscribe = function () {
        this.super.customSubscribe();
        this.subscribeReelsStopAnimation();

        nge.observer.add('slotMachine.view.finishAutospins', this.finishAutoSpinsHandler, false, true);
        nge.observer.add('freespin.counterReset', this.updateOfferCountersHandler, false, true);
        nge.observer.add('bigWin.complete', this._bigWinFinishedHandler, false, true);
        nge.observer.add('freespin.start', this.freespinStart, false, true);
        nge.observer.add('winCounter.finished', this.counterFinished, false, true);
        nge.observer.add('bigWin.complete', this.counterFinished, false, true);
        nge.observer.add('freespin.finish', this.freespinFinishHandler, false, true);
        nge.observer.add('winCounter.start', this.startCounterHandler, false, true);
        nge.observer.add('riverslot.bigWin.show', this.startCounterHandler, false, true);
        nge.observer.add('slotMachine.trySpin', this.trySpinHandler, false, true);
        nge.observer.add('winCounter.countingFinished', this.countingFinishedHandler, false, true);
        nge.observer.add('bigWin.complete.start', this.countingFinishedHandler, false, true);
        nge.observer.add('freespin.end', this._freespinEnd, false, true);
        nge.observer.add('winlines.animateAllDone', this.animateAllDoneHandler, false, true);
        nge.observer.add('transportMessage.BalanceResponse', this.balanceResponseHandler, false, true);
        nge.observer.add('slotMachine.spinStart', this.spinStartHandler, false, true);
        nge.observer.add('slotMachine.spinFailed.noBalance', this.noBalanceHandler, false, true);
    };
});




nge.App[nge.appNS].Mlm.Brain.UI_v3 = {};




nge.App[nge.appNS].Mlm.Brain.UI_v3.Buttons = nge.App.ClassicGameBase.Mlm.Brain.UI_v3.Buttons.extend(nge.App[nge.appNS].Mlm.Brain.ButtonsExtension);




nge.App[nge.appNS].Mlm.Brain.Mobile = {};




nge.App[nge.appNS].Mlm.Brain.Mobile.Buttons = nge.App.ClassicGameBase.Mlm.Brain.Mobile.Buttons.extend(function () {
    let _self = this;
    this.disableAutoButton = true;
    this.stopCommandEvent = 'slotMachine.tryStop';
    let _cache = {};

    this.controlButtons.push('settingsMobile');

    this.onRestoreExtension = function() {
        this.super.onRestoreExtension();

        this.changeButtonState('pageThreeTrigger', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageThreeHeaderContainer', container: 'pageThreeContainer'}, 1);
        }, true);

        this.changeButtonState('settingsMobile', undefined, function () {
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageThreeHeaderContainer', container: 'pageThreeContainer'});
            nge.observer.fire('paytable.show');
        }, true);

        this.changeButtonState('settingsSplashScreen', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('settings.splashScreenSwitch');
        }, true);

        this.changeButtonState('settingsDisplayValuesInCoins', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('currencySwitcher.switch');
        }, true);

        this.changeButtonState('turboMode', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('settings.turboModeSwitch');
        }, true);

        this.changeButtonState('settingsPressSpaceToSpin', undefined, function () {
            nge.observer.fire('denom_change.play');
            nge.observer.fire('spaceHandler.switched');
        }, true);

        this.changeButtonState('spinMobile', this.spinBtnName, () => nge.observer.fire('slotMachine.trySpin'), true);
    };    

    this.restoreMobileButtons = function () {
        var freespinInProgress = nge.localData.get('freespin.inProgress');
        if (!freespinInProgress)
            this.super.restoreMobileButtons();
    };

    this._offerRestore = function () {
        var freespinInProgress = nge.localData.get('freespin.inProgress');
        if (!freespinInProgress)
            this.super._offerRestore();

        var freeGameAmount = nge.localData.get('freeGame.amount');
        if(parseInt(freeGameAmount, 10) === 0)
            return;

        this.changeButtonState('settingsMobile', undefined, function () {
            nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageThreeHeaderContainer', container: 'pageThreeContainer'});
            nge.observer.fire('paytable.show');
        }, true);
    };

    this._spinStartButtonsChange = () => {

        nge.observer.fire('buttons.changeData', {
            spinMobile: {
                enabled: false
            }
        });
    };

    this.spinResponceHandler = () => {
        nge.observer.fire('buttons.changeData', {
            spinMobile: {
                visible: false
            },
            stopMobile: {
                visible: true,
                enabled: true,
                callback: () => nge.observer.fire(this.stopCommandEvent)
            }
        });

    };

    this.spinCompleteHandler = () => {
        const { autospin } = nge.localData.get();
        const spinName = 'spinMobile';
        const stopName = 'stopMobile';

        if(autospin){
            this.changeButtonState(spinName, undefined, undefined, false, false); 
            this.changeButtonState(stopName, undefined, () => nge.observer.fire('slotMachine.trySpin'), true, true);
            return;
        }

        let name = nge.localData.get('wasQuickFinish') ? stopName : spinName;
        let nameToHide = name === stopName ? spinName : stopName;

        this.changeButtonState(nameToHide, undefined, undefined, false, false); 
        this.changeButtonState(name, undefined, () => nge.observer.fire('slotMachine.trySpin'), true, true);
    };

    var _onFreespinReady = function () {
        _self.changeButtonState('spinMobile', undefined, function () {
            nge.observer.fire('sounds.spinClick');
            nge.observer.fire('slotMachine.spinCommand');
        }, true, true);

        _self.changeButtonState('takeMobile', undefined, function () {
            nge.observer.fire('gamble.take');
        }, true, false);

        _self.changeButtonState('stopMobile', undefined, function () {
            nge.observer.fire(_self.stopCommandEvent);
        }, true, false);

        nge.observer.fire('buttons.changeData', {
            infoMobile: {
                enabled: true
            }
        });

        nge.observer.fire('buttons.changeData', {
            settingsMobile: {
                enabled: true
            }
        });
    };

    var _onStartBigWin = function () {
        nge.observer.fire('buttons.changeData', {
            quickSettingsPanel: {
                enabled: false
            }
        });

        if (_cache.spinButtonTopContainer && _cache.spinButtonContainer)
            _cache.spinButtonTopContainer.add(_cache.spinButtonContainer);
    };

    var _onCompleteBigWin = function () {
        nge.observer.fire('buttons.changeData', {
            quickSettingsPanel: {
                enabled: true
            }
        });

        if (_cache.spinButtonUIParent && _cache.spinButtonContainer)
            _cache.spinButtonUIParent.add(_cache.spinButtonContainer);
    };

    var _onButtonsCreateEnd = function () {
        _cache.spinButtonTopContainer = nge.findOne('^spinButtonTopContainer');
        var spinButton = nge.findOne('^spinButtonMobileButton');
        if (spinButton)
            _cache.spinButtonContainer = spinButton.parent;
        if (_cache.spinButtonContainer)
            _cache.spinButtonUIParent = _cache.spinButtonContainer.parent;
    };

    var _onDoSpinPress = function () {
        nge.observer.fire('buttons.pressCommand', 'spinMobile');
    };

    var _onFreespinContinue = function () {
        nge.rafSetTimeout(function () {
            nge.observer.fire('buttons.changeData', {
                infoMobile: {
                    enabled: true,
                    callback: function () {
                        nge.observer.fire('paytable.show');
                    }
                }
            });

            nge.observer.fire('buttons.changeData', {
                settingsMobile: {
                    enabled: true,
                    callback: function () {
                        nge.observer.fire('paytable.show');
                        nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageThreeHeaderContainer', container: 'pageThreeContainer'}, 1);
                    }
                }
            });

            nge.observer.fire('buttons.changeData', {
                betSettingButtonMobile: {
                    enabled: true,
                    callback: function () {
                        nge.observer.fire('paytable.show');
                        nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageTwoHeaderContainer', container: 'pageTwoContainer'}, 1);
                    }
                }
            });

            nge.observer.fire('buttons.changeData', {
                mobileBackToGameButton: {
                    callback: function () {
                        nge.observer.fire('paytable.hide');
                    }
                }
            });

            nge.observer.fire('buttons.changeData', {
                pageOneTrigger: {
                    enabled: true,
                    callback: function () {
                        nge.observer.fire('denom_change.play');
                        nge.observer.fire('paytable.updatePayout');
                        nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageOneHeaderContainer', container: 'pageOneContainer'}, 1);
                    }
                }
            });

            nge.observer.fire('buttons.changeData', {
                pageTwoTrigger: {
                    enabled: true,
                    callback: function () {
                        nge.observer.fire('denom_change.play');
                        nge.observer.fire('tabs.menuContainer.switch', {tab: 'pageTwoHeaderContainer', container: 'pageTwoContainer'}, 1);
                    }
                }
            });
        }, 1);
    };

    var _onPaytableHide = function () {
        if (nge.localData.get('freespin.inProgress') && !nge.localData.get('autospin'))
            nge.observer.fire('buttons.changeData', {
                spinMobile: {
                    enabled: true,
                    visible: true
                }
            });
    };

    this.onTryStop = function() {
        nge.observer.fire('buttons.changeData', {
            stopMobile: {
                enabled: false,
                visible: true
            }
        });
    };

    this.slotMachineIntrigueHandler = () => {
        nge.observer.fire('buttons.changeData', {
            stopMobile: {
                enabled: false,
                visible: true
            }
        });
    };

    this.disableAllRiverButtons = () => {
        const enabled = { enabled: false };
        const params = { spinMobile: enabled};

        for(let btnIndex in this.controlButtons){
            const btnName = this.controlButtons[btnIndex];
            params[btnName] = enabled;
        }

        nge.observer.fire('buttons.changeData', params);
    };

    this.slotMachineStateHandler = () => {};

    this.showStopDisabledHandler = () => {
        nge.observer.fire('buttons.changeData', {
            stopMobile: {
                enabled: false,
                visible: true
            }
        });
    };

    this.subscribe = function(){
        this.super.subscribe();
        nge.observer.add('cs2.buttons.stop.showDisabled', this.showStopDisabledHandler, false, true)
        nge.observer.add('river.buttons.disable.all', this.disableAllRiverButtons, false, true);
        nge.observer.add('slotMachine.stateChanged', this.slotMachineStateHandler, false, true);
        nge.observer.add('slotMachine.intrigueStarted', this.slotMachineIntrigueHandler, false, true);
        nge.observer.add('buttons.freespinReady', _onFreespinReady, false, true);
        nge.observer.add('buttons.startBigWin', _onStartBigWin, false, true);
        nge.observer.add('buttons.completeBigWin', _onCompleteBigWin, false, true);
        nge.observer.add('buttons.create.end', _onButtonsCreateEnd, false, true);
        nge.observer.add('buttons.doSpinPress', _onDoSpinPress, false, true);
        nge.observer.add('buttons.freespinContinue', _onFreespinContinue, false, true);
        nge.observer.add('paytable.hide', _onPaytableHide, false, true);
        nge.observer.add('slotMachine.tryStop', _self.onTryStop, false, true);
    };
});




