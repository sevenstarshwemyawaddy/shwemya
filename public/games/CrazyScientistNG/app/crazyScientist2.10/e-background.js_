nge.App[nge.appNS].Com = {};


nge.App[nge.appNS].Com.Autospin = {};




nge.App[nge.appNS].Com.Autospin.Controller = nge.Com.Base.extend(function() {
    this.autospinAmounts = [10, 25, 50, 75, 100, 250, 500, 750, 1000, 'Infinity'];
    this.autospinAmountAnimationDuration = 200;
    this.autospinRunExceptions = [
        function() {
            return nge.localData.get('freespin.inProgress');
        },
        function() {
            return nge.localData.get('respin.inProgress');
        },
        function() {
            return nge.localData.get('bonusGame.inProgress');
        },
        function() {
            return nge.localData.get('freeGame.inProgress') && !nge.localData.get('freespin.inProgress') &&
            (nge.localData.get('freeGame.amount') === '0' || nge.localData.get('freeGame.amount') === 0);
        }
    ];

    this.inputEnabled = false;
    this.timeDelayForSpin = 500;

    this.useAmountSetter = true;

    this.autospinSpinEvents = [
        // 'win.big.hide',
        // 'spinComplete.noWin',
        // 'win.brain.animationComplete'
        'winlines.animateByOne.cycleComplete'
    ];

    var _canNotStartAutospins = false;

    var _self = this;
    var _created;
    var _view;

    var _buttonIcon;

    function _checkExceptions() {
        return !_self.autospinRunExceptions.some(function(elem){
            return elem();
        });
    }

    this.spin = function () {

        if (!nge.localData.get('autospin') || !_checkExceptions()) {
            console.log('[AUTOSPIN]: this.spin 1');
            _self.stopAutospins();
            return;
        }
        var autospinAmount = +nge.localData.get('autospinAmount');
        if (this.useAmountSetter && autospinAmount <= 0) {
            console.log('[AUTOSPIN]: this.spin 2');
            _self.stopAutospins();
        } else {
            nge.observer.fire('slotMachine.trySpin');
            // nge.observer.fire('spinButton.pressFromCode');
        }
    };

    this.runAutospins = function(autospinAmount) {
        if (_self.useAmountSetter)
            _view.pickAmountItem(autospinAmount);

        _buttonIcon.visible = true;

        nge.localData.set('autospin', true);
        nge.localData.set('autospinAmount', autospinAmount);
        nge.observer.fire('autospin.started');

        var slotMachineSpinning = nge.localData.get('slotMachineSpinning');
        if (!slotMachineSpinning) {
            var jackpotInProgress = nge.localData.get('jackpot.inProgress');
            var jackpotCanPlayRequested = nge.localData.get('jackpot.jackpotCanPlayRequested');
            if (!_canNotStartAutospins && !jackpotInProgress && !jackpotCanPlayRequested) {
                console.log('[AUTOSPIN]: .runAutospins');
                _self.spin();
            }
        }
    };

    this.stopAutospins = function() {
        _buttonIcon.visible = false;

        if (_self.useAmountSetter) {
            _view.hideAutospinText();
            nge.observer.fire('slotMachine.view.finishAutospins');
        }

        nge.localData.set('autospin', false);
        nge.localData.set('autospinAmount', 0);
        nge.observer.fire('autospin.ended');
    };

    this.onElementWasClicked = function(autospinAmount) {
        return function() {
            if(!_self.inputEnabled) return;
            if (nge.localData.get('gamble.waiting')) {
                _view.autospinAmountClose();
                return;
            }
            console.log('[AUTOSPIN]: .onElementWasClicked');
            _self.runAutospins(autospinAmount);
        };
    };

    function _createEndHandler(scene) {
        if (_self.useAmountSetter && scene === 'play') {
            nge.rafSetTimeout(function() {
                _view.hideAutospinText();
            }, 50);
        }
    }

    function _spinStartHandler() {
        var autospinAmount = nge.localData.get('autospinAmount');
        var isEnable = _checkExceptions();

        if (isEnable && autospinAmount){
            if(Number.isFinite(autospinAmount)) {
                nge.localData.set('autospinAmount', --autospinAmount);
            }

            if (_self.useAmountSetter)
                _view.spinStartHandler(autospinAmount);
        }
    }

    function _layerSwitcherShowHandler(layerName) {
        if (_self.useAmountSetter) {
            _view.autospinAmountClose();
        }

        // @Note (reiven): uncomment if you need to autostart autospins when layer changes to game
        // var autospinAmount = nge.localData.get('autospinAmount');
        // if(layerName === 'game' && autospinAmount && _checkExceptions()) {
        // _self.runAutospins(autospinAmount);
        // }
    }

    function _freespinStartHandler() {
        if (_self.useAmountSetter) {
            _view.hideAutospinText();
        }
    }

    this.customSubscribe = function() {
    };

    function _onAutospinButtonClick() {
        var isAuto = nge.localData.get('autospin');
        if(isAuto){
            console.log('[AUTOSPIN]: _onAutospinButtonClick');
            _self.stopAutospins();
            return;
        }

        if (_self.useAmountSetter) {
            if (_view.panelIsOpened()) {
                _view.autospinAmountClose();
            } else {
                var isEnable = _checkExceptions();
                _view.autospinAmountOpen(isEnable);
            }
        } else {
            console.log('[AUTOSPIN]: _onAutospinButtonClick');
            _self.runAutospins(_self.autospinAmounts[_self.autospinAmounts.length-1]);
        }
    }

    function _onAutospinPauseHandler() {
        nge.observer.fire('autospin.hideAutospinText');
        nge.localData.set('autospin', false);
    }

    function _subscribe() {
        nge.observer.add('slotMachine.spinFailed.noBalance', function() {
            console.log('[AUTOSPIN] slotMachine.spinFailed.noBalance');
            _self.stopAutospins();
        });
        nge.observer.add('autospin.button.click', _onAutospinButtonClick);

        _self.autospinSpinEvents.forEach(function(event) {
            nge.observer.add(event, function() {
                console.log('[AUTOSPIN]: autospin/controller.js event: ' + event);
                _canNotStartAutospins = false;
                _self.spin();
            });
        });

        nge.observer.add('slotMachine.spinStart', function () {
            _canNotStartAutospins = true;
        });

        nge.observer.add('autospin.off', function() {
            console.log('[AUTOSPIN] autospin.off');
            _self.stopAutospins();
        });
        nge.observer.add('autospin.pause', _onAutospinPauseHandler);

        nge.observer.add('layersSwitcher.show', _layerSwitcherShowHandler);
        nge.observer.add('slotMachine.spinStart', _spinStartHandler);

        nge.observer.add('freespin.press.spinButton', _freespinStartHandler);
        nge.observer.add('StatesManager.create.end', _createEndHandler);

        if (_self.useAmountSetter) {
            nge.observer.add('autospin.hideAutospinText', _view.hideAutospinText);
            nge.observer.add('slotMachine.view.finishAutospins', _view.finishAutospins);
            nge.observer.add('autospin.panel.hide', _view.autospinAmountClose);
            nge.observer.add('slotMachine.spinStart', _view.autospinAmountClose);
            // nge.observer.add('layersSwitcher.show', _view.autospinAmountClose);
            nge.observer.add('button.hover', _view.onButtonHover);
            nge.observer.add('button.unhover', _view.onButtonUnhover);
            nge.observer.add('buttons.gamble.waiting', _view.autospinAmountClose);
            nge.observer.add('autoButtonEnableSwitched', function (bool) {
                if (!bool)
                    _view.hideAutospinText();
            });
        }

        nge.observer.add('Transport.close', function() {
            nge.localData.set('autospin', false);
            nge.localData.set('autospinAmount', 0);
            _canNotStartAutospins = false;
        });

        _self.customSubscribe();
    }

    this.create = function() {
        this.createDefault();

        if (nge.Lib.Helper.mobileAndTabletCheck())
            _self.useAmountSetter = false;

        if (_self.useAmountSetter) {
            if (!_view) {
                _view = _self.getInstance('View');
            }
            _view.create(_self);
        }

        if (!_created) {
            _subscribe();
            _created = true;
        }

        _buttonIcon = nge.findOne('.autoIcon');
        _buttonIcon.visible = !!nge.localData.get('autospin');
        return true;
    };
});




nge.App[nge.appNS].Com.Autospin.Tpl = function () {
