nge.App[nge.appNS].Com.Substrate = {};



nge.App[nge.appNS].Com.Substrate.Controller = nge.Com.Base.extend(function () {
    let _created = false;
    let _tween = null;

    let _substatesAnimationPool = [];
    let _substrates = {};
    let _substratesContainer = null;

    let _firstTextureKey = 'win_frame_000.png';

    this.create = () => {
        this.createDefault();

        this._clearLinks();
        this._prepareLinks();
        this._createSubstrates();
        this._reset();

        if(!_created)
            this._subscribe();
    };

    this._clearLinks = () => {
        for(let substrateName in _substrates){
            _substrates[substrateName].destroy();
            delete _substrates[substrateName];
        }

        _substrates = {};
 
        _substratesContainer && _substratesContainer.destroy();
        _substratesContainer = null;

        _tween = null;
    };

    this._createSubstrates = () => {
        const smCfg = this.getInstance('Cfg', 'SlotMachine').get();
        const { x, y } =  nge.findOne('^slotMachineContainer').getData()

        _substratesContainer.position.set(x, y);

        for (let i = 0; i < smCfg.mh; i++) {
          for (let j = 0; j < smCfg.mw; j++) {
           const imageModel =  new nge.Mlm.Objects.Image({
                'assetKey': _firstTextureKey,
                'anchorX': 0.5, 
                'anchorY': 0.5,
                'x': smCfg.imageWidth * j + smCfg.imageWidth / 2 - 40 - (40* 2*j),
                'y': smCfg.imageHeight * i + smCfg.imageHeight / 2 -  48 - (48 * 2*i)
            });
    
            const obj = nge.objects.create(imageModel, _substratesContainer);
            _substrates[`${j}_${i}`] = obj;
          }
            
        }
    };

    this._prepareLinks = () => {
        _substratesContainer = nge.findOne('^substratesContainer');
    };

    this._reset = () => {
        for(let substrateName in _substrates){
            _substrates[substrateName].loadTexture(_firstTextureKey);
            _substrates[substrateName].visible = false;
        }

        _tween = null;
        _substatesAnimationPool = [];
    };

    this._startSubstateAnimation = () => {
        nge.localData.set('substrate.needHideLine', false);

        _tween = nge.tween.add({x: 0}).to({x: 26}, 1100, null, false);
        
        _tween.onUpdateCallback((t, v, td) => {
            for(let index in _substatesAnimationPool){
                const substrate = _substrates[_substatesAnimationPool[index]];
                substrate.visible = true;
                substrate.loadTexture('win_frame_' + nge.Lib.Helper.LdgZero(~~(td.percent * td.vEnd.x), 3) + '.png');

                const needHide = v >= 0.8;
                nge.localData.set('substrate.needHideLine', needHide);
    

                substrate.alpha = needHide ? ((1 - v) / 0.2) : 1;                
            }
        });
        
        _tween.onComplete.add(this._reset);

        _tween.start();
    };

    this._showSubstateAnimation = (position) => {
       _substatesAnimationPool.push(`${position.reel}_${position.row}`);

       if(!_tween)
        this._startSubstateAnimation();
    }; 

    this._hideSubstrateAnimation = () => {
        _tween && _tween.stop(true);
    };

    this.showSubstrateAnimationHandler = this._showSubstateAnimation;
    this.hideSubstrateAnimationHandler = this._hideSubstrateAnimation;

    this._subscribe = () => {
        nge.observer.add('substrate.animate', this.showSubstrateAnimationHandler);
        nge.observer.add('substrate.hide', this.hideSubstrateAnimationHandler);
    };
});


