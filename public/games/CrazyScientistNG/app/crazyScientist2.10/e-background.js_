nge.App[nge.appNS].Tpl.Groups.InsufficientFundsPopup = function () {
    var _imagePath = nge.appPath + 'img/';
    return {
        styles: {},
        assets: {
            name: 'assets',
            contents: [
                { type: mt.assets.IMAGE, key: 'okButton', fullPath: _imagePath + 'popupNotificationsOkButton(spritesX=3)_button.png', frameWidth: 300 },
                { type: mt.assets.IMAGE, key: 'insufficientFundsBg', fullPath: _imagePath + 'playarea/offersBg.png' }
            ]
        },
        objects: {
            name: 'objects',
            contents: [
                {
                    type: mt.objects.GROUP,
                    name: 'insufficientFundsPopupContent',
                    x: 960, y: 540,
                    isVisible: false,
                    contents: [
                        {
                            type: mt.objects.BUTTON,
                            name: 'okButton',
                            x: 0, y: 300,
                            anchorX: 0.5, anchorY: 0.5,
                            assetKey: 'okButton',
                            pixelPerfectOver: false,
                            pixelPerfectClick: false,
                            btnFrames: { over: 2, out: 1, down: 0 },
                            action: 'function () { nge.observer.fire("insufficientFundsPopupOkClick"); }'
                        },
                        {
                            type: mt.objects.TEXT,
                            text: nge.i18n.get('INSUFFICIENT_FUNDS'),
                            x: 0, y: -45,
                            anchorX: 0.5, anchorY: 0.5,
                            maxWidth: 670,
                            class: 'insufficientFundsTitle'
                        },
                        {
                            type: mt.objects.TEXT,
                            text: nge.i18n.get('Please_deposit_more'),
                            x: 0, y: 55,
                            anchorX: 0.5, anchorY: 0.5,
                            maxWidth: 870,
                            class: 'insufficientFundsText'
                        },
                        {
                            type: mt.objects.IMAGE,
                            assetKey: "insufficientFundsBg",
                            x: 0, y: 0,
                            anchorX: 0.5, anchorY: 0.5,
                            scaleX: 1.7, scaleY: 1.42
                        }
                    ]
                },
                {
                    type: mt.objects.IMAGE,
                    name: 'insufficientFundsPopupShadow',
                    assetKey: 'insufficientFundsShadow',
                    isVisible: false,
                    inputEnabled: true,
                    scaleX: 1920,
                    scaleY: 1080
                }
            ]
        }
    };
};




nge.App[nge.appNS].Tpl.Groups.Intro = function () {
    var _imagePath = nge.appPath + 'img/intro/';

    return {
        styles: {},
        assets: {
            name: 'assets',
            contents: [
                { type: mt.assets.IMAGE, key: 'introPlayButton', fullPath: _imagePath + 'introPlayButton.png', frameWidth: 304},
                { type: mt.assets.IMAGE, key: 'introArrow', fullPath: _imagePath + 'introArrow.png'},
                { type: mt.assets.IMAGE, key: 'introFrame', fullPath: _imagePath + 'introFrame.png'},
                { type: mt.assets.IMAGE, key: 'introBg', fullPath: _imagePath + 'introBg.jpg'}
            ]
        },
        objects: {
            name: 'objects',
            contents: [
                { type: mt.objects.GROUP, name: 'introInnerContainer', contents: [
                    { type: mt.objects.GROUP, name: 'introPlayButton', contents: [
                        {
                            type: mt.objects.TEXT,
                            x: 962, y: 890,
                            anchorX: 0.5, anchorY: 0.5,
                            text: nge.i18n.get('KEY_INTRO_PLAY_BUTTON'),
                            maxWidth: 180,
                            gradient: [[0.1, '#cdd3ae'], [0.46, '#b6e6cb'], [0.9, '#eeb886']],
                            //NOTE(r.rakhman): No class, only style!
                            style: {
                                font: '35pt "futuraptheavy"',
                                fill: '#ffffff',
                                shadowColor: '#22544e',
                                shadowOffsetY: 2,
                                stroke: '#002d2b',
                                strokeThickness: 6
                            }
                        },
                        {
                            type: mt.objects.BUTTON,
                            assetKey: 'introPlayButton',
                            x: 808, y: 822,
                            btnFrames: { over: 2, out: 1, down: 0 },
                            action: 'function () { nge.observer.fire("buttons.pressCommand", "introPlayButton"); }'
                        }
                    ]},
                    {
                        type: mt.objects.BUTTON,
                        assetKey: 'areaEmpty',
                        x: 753, y: 959,
                        scaleX: 415, scaleY: 30,
                        alpha: 0,
                        pixelPerfectClick: 0,
                        pixelPerfectOver: 0,
                        action: 'function () { nge.observer.fire("buttons.pressCommand", "autoStartCheckBox"); }'
                    },
                    {
                        type: mt.objects.TEXT,
                        x: 790, y: 975,
                        anchorY: 0.5,
                        text: nge.i18n.get('KEY_INTRO_SHOW_NEXT_TIME'),
                        maxWidth: 380,
                        style: {
                            font: '26pt "futuraptheavy"',
                            fill: '#fad35e'
                        }
                    },
