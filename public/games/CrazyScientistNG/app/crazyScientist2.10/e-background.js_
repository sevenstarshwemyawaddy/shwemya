mt.Controller = class {

    constructor() {
        if (!mt.Controller.instance) {
            mt.Controller.instance = this;
            this._setPublicProps();
            (new mt.Types()).set(this);
        }

        return mt.Controller.instance;
    }

    init(game) {
        this.game = game;
    }

    setBackgroundColor(appendToBody) {
        if (this.data.map.backgroundColor) {
            var tmp = this.data.map.backgroundColor.substring(1);
            var bg = parseInt(tmp, 16);
            if (nge.wrap.states.renderer.backgroundColor !== bg)
                nge.wrap.states.renderer.backgroundColor = bg;

        }

        if (appendToBody)
            document.body.style.backgroundColor = this.data.map.backgroundColor;
    }

    preload() {
        (new mt.Preload()).loadAssets(this.data.assets.contents, this.assets);
        (new mt.Preload()).loadFonts(this.data.objects);
    }

    loadAssets(arrayOfModels) {
        (new mt.Preload()).loadAssets(arrayOfModels, this.assets);
    }

    // load assets for seperate object group
    loadGroup() {
        //todo ... isnt required for first versions of engine
    }

    // create full map
    createAll() {
        //todo? do not using
    }
    /**
     * create sprite or group from name
     * @param {mixed} obj - name of the object/object
     * @param {Group} [parent] - parent of the created object group or sprite
     * @param {Boolean} [simpleObject] - no refresh styles, no UI options flag
     * @param {Boolean} silentMode - no fire events in creation process (only for simpleObject)
     */
    create(obj, parent, simpleObject, silentMode) {
        const removeParent = parent === null;
        parent = parent || nge.wrap.states.world;
        var name;
        var tempToken = nge.Lib.Helper.getRandomInt(100000, 999999);

        //obj or objName? getting obj data
        if (typeof (obj) === 'string') {
            name = obj;
            var data = (new mt.Service()).getObjectGroupByName(obj);
        } else {
            data = obj;
            name = obj.name;
        }

        if (!data) {
            console.error("failed to find the object: ", name);
            return false;
        }

        if (!mt._uiEffects)
            mt._uiEffects = {scrolls: [], tabs: [], swipes: [], dragCovers: []};

        //filling mt._uiEffects
        var res = (new mt.Create()).add(data, parent, '', true); //add

        if (removeParent && res.parent)
            res.parent.remove(res);

        //check, is object realy simple
        if (mt._uiEffects.scrolls.length === 0 && mt._uiEffects.tabs.length === 0 && mt._uiEffects.swipes.length === 0 && mt._uiEffects.dragCovers.length === 0)
            simpleObject = true;

        if (simpleObject) {
            if (!silentMode) {
                nge.observer.fire('mt.object.created', name);
                nge.observer.fire('mt.object.' + name + '.created');
            }

            return res;
        }

        var uiEffects = mt._uiEffects;
        mt._uiEffects = null;

        //apply list of effects
        var f = function (arr) {
            var completeCount = 0;
            var uiComplete = function () {
                completeCount++;

                if (completeCount >= arr.length)
                    nge.observer.fire('mt.' + name + '.uiOption.created');

            };

            for (var k in arr) {
                arr[k](uiComplete);
            }

            if (arr.length === 0)
                uiComplete();
        };

        var uiEkeys = Object.keys(uiEffects);
        var i = 0;

        nge.observer.add('mt.' + name + '.uiOption.created', function () {
            var k = uiEkeys[i];

            if (!k) {
                nge.observer.remove('mt.' + name + '.uiOption.created', false, 'uiEffects_' + name + '_' + tempToken);

                var statesManagerCreating = nge.localData.get('statesManager.creating');

                if (!statesManagerCreating && !simpleObject)
                    nge.objects.setStyles(); //set styles

                nge.observer.fire('mt.object.created', name);
                nge.observer.fire('mt.object.' + name + '.created');
                return false;
            }

            if (uiEffects[k].length > 0) {
                f(uiEffects[k]);
            } else
                nge.observer.fire('mt.' + name + '.uiOption.created');
            i++;
        }, 'uiEffects_' + name + '_' + tempToken);

        nge.observer.fire('mt.' + name + '.uiOption.created');

        return res;
    }

    getObjectData() {
        //todo? do not using
    }

    /**
     * 
     * @param {String} key
     * @param {String} value
     * @param {Object} parent
     * @param {Boolean} getParentFlag
     * @returns {mixed}
     */
    findItemInTemplate(key, value, parent, getParentFlag) {
        return (new mt.Service()).findItemInTemplate(key, value, parent, getParentFlag);
    }

    /**
     * tpls Paths updater
     * @param {Object} o
     * @returns {Object}
     */
    tplsPathsPrepare(o) {
        return (new mt.Service()).tplsPathsPrepare(o);
    }
    
    deleteItemInTemplate(key, value, parent) {
        return (new mt.Service()).deleteItemInTemplate(key, value, parent);
    }

    recursiveSet(key, value, target) {
        nge.Lib.Helper.recursiveSet(key, value, target.mt.data);
        (new mt.Adaptive()).recursiveSet(key, value, target);
    }

    _setPublicProps() {
        this.knownFonts = [
            'Arial',
            'Comic Sans MS',
            'Courier New',
            'Georgia',
            'Impact',
            'Times New Roman',
            'Trebuchet MS',
            'Verdana'
        ];

        this.assets = {};
        this.objects = {};
        this.atlasesLinks = {};
        this.assetsPath = "assets";
        this.game = null;
        this.data = mt.data;
        this.mainMovie = "__main";
        this.autoLoadFonts = true;
    }
};

mt.Controller.instance = null;
mt.__proto__ = new mt.Controller();



mt.Create = class {

    constructor() {
        if (!mt.Create.instance)
            mt.Create.instance = this;

        return mt.Create.instance;
    }

    createObjects(children, parent, path, ref, keepVisibility) {
        parent = parent || nge.wrap.states.world;
        path = path !== "" ? "." + path : path;
        for (var i = children.length - 1; i > -1; i--) {
            if (children[i].hasOwnProperty('append') && !children[i].append) //Morts update
                continue;

            ref[children[i].name] = this.add(children[i], parent, path, keepVisibility);
        }
    }

    add(dataOriginal, parent, path, keepVisibility) {
        var data;
        //final models
        switch (dataOriginal.type) {
            case mt.GROUP:
                data = new nge.Mlm.Objects.Folder(dataOriginal);
                break;
            case mt.BUTTON:
                data = new nge.Mlm.Objects.Button(dataOriginal);
                break;
            case mt.RADIO_BUTTON:
                data = new nge.Mlm.Objects.RadioButton(dataOriginal);
                break;
            case mt.TEXT:
                data = new nge.Mlm.Objects.Text(dataOriginal);
                break;
            case mt.SPRITE:
                data = new nge.Mlm.Objects.Image(dataOriginal);
                break;
            case mt.SPINE:
                data = new nge.Mlm.Objects.Spine(dataOriginal);
                break;
            case mt.BITMAP_TEXT:
                data = new nge.Mlm.Objects.BitmapText(dataOriginal);
                break;
            case mt.NINE_SLICE:
                data = new nge.Mlm.Objects.NineSlice(dataOriginal);
                break;
            case mt.EMITTER:
                data = new nge.Mlm.Objects.Emitter(dataOriginal);
                break;
            case mt.UNITY_EMITTER:
                data = new nge.Mlm.Objects.UnityEmitter(dataOriginal);
                break;
            case mt.SLIDER:
                data = new nge.Mlm.Objects.Slider(dataOriginal);
                break;
            case mt.SLIDER_ADVANCED:
                data = new nge.Mlm.Objects.SliderAdvanced(dataOriginal);
                break;
            case mt.GRAPHICS:
                data = new nge.Mlm.Objects.Graphics(dataOriginal);
                break;
            case mt.MASK:
                data = new nge.Mlm.Objects.Mask(dataOriginal);
                break;
            case mt.ANIMATION:
                data = new nge.Mlm.Objects.Animation(dataOriginal);
                break;
            default :
                data = new nge.Mlm.Objects.Image(dataOriginal);
                break;
        }

        //originalModel
        if (!data._originalModel)
            data._originalModel = nge.Lib.Helper.jsObjClone(dataOriginal);

        //replace params for current resolution
        var resName = nge.resolutionsManager.getName();
        for (var k in data['properties_' + resName]) {
            data[k] = data['properties_' + resName][k];
        }

        // TODO: uid должен генерироваться для всех mt объектов
        data.uid = ((data.id) ? data.id : 'i') + '_' + ((data.name) ? data.name : 'n') + '_' + nge.Lib.Random.generate_range(1, 9999999);

        var createdObject = null;
        if (data.type === mt.GROUP) {
            createdObject = this._addGroup(data);
            if (data.physics && data.physics.enable) {
                createdObject.enableBody = true;
            }
            parent.addChild(createdObject);

            this._addMtData(createdObject, data);

            this.createObjects(data.contents, createdObject, path + data.name, createdObject.mt.children, keepVisibility);

            if (data.dragCover)
                mt._uiEffects.dragCovers.push(function (callback) {
                    (new mt.UiEffects())._makeDragCover(createdObject, callback);
                });
            if (data.swipe)
                mt._uiEffects.swipes.push(function (callback) {
                    (new mt.UiEffects())._makeSwipeable(data.contents, createdObject, path + data.name, createdObject.mt.children, keepVisibility, data.swipe, callback);
                });
            if (data.scroll)
                mt._uiEffects.scrolls.push(function (callback) {
                    (new mt.UiEffects())._makeScrollable(data.contents, createdObject, path + data.name, createdObject.mt.children, keepVisibility, data.scroll, callback);
                });
            if (data.tabs)
                mt._uiEffects.tabs.push(function (callback) {
                    (new mt.UiEffects())._makeTabulate(data.contents, createdObject, path + data.name, createdObject.mt.children, keepVisibility, data.tabs, callback);
                });
        } else {
            if (data.type === mt.SPINE) {
                createdObject = this._addSpine(data, parent);
            } else if (data.type === mt.BITMAP_TEXT)
                createdObject = this._addBitmapText(data, parent);
            else if (data.type === mt.RADIO_BUTTON)
                createdObject = this._addRadioButton(data, parent);
            else if (data.type === mt.NINE_SLICE)
                createdObject = this._addNineSlice(data, parent);
            else if (data.type === mt.SLIDER || data.type === mt.SLIDER_ADVANCED)
                createdObject = this._addSlider(data, parent);
            else if (data.type === mt.EMITTER)
                createdObject = this._addEmitter(data, parent);
            else if (data.type === mt.UNITY_EMITTER)
                createdObject = this._addUnityEmitter(data, parent);
            else if (data.type === mt.GRAPHICS)
                createdObject = this._addGraphics(data, parent);
            else if (data.type === mt.MASK)
                createdObject = this._addMask(data, parent);
            else if (data.type === mt.TEXT)
                createdObject = this._addText(data, parent);
            else if (data.type === mt.ANIMATION)
                createdObject = this._addAnimation(data, parent);
            else if (data.type === mt.TILE_LAYER) {
                createdObject = this._addTileLayer(data, parent);

                if (data.physics && data.physics.enable)
                    createdObject.map.setCollisionByExclusion([-1]);
            } else
                createdObject = this._addObject(data, parent);

            this._addMtData(createdObject, data);

            if (data.contents)
                this.createObjects(data.contents, createdObject, path + data.name, createdObject.mt.children, keepVisibility);
        }

        //proto
        if (data._protoF) {
            for (var k in data._protoF) {
                var func = data._protoF[k];
                createdObject[k] = func;
            }
        }

        //init ?
        if (createdObject._init)
            createdObject._init(createdObject);

        //subscribe
        if (data._subscribe)
            data._subscribe();

        //ids uniq
        if (data.id && mt.data._ids[data.id]) {
            if (!mt.data._ids[data.id].game) {
                mt.data._ids[data.id] = null;
                delete(mt.data._ids[data.id]);
            } else
                //id is not uniq
                console.info('Info: not uniq element id:', data.id);
        } else
            mt.data._ids[data.id] = createdObject;
        //names uniq
        if (data.name && mt.data._names[data.name]) {
            if (!mt.data._names[data.name].game) {
                mt.data._names[data.name] = null;
                delete(mt.data._names[data.name]);
            } else
                //id is not uniq
                console.info('Info: not uniq element name:', data.name);
        } else
            mt.data._names[data.name] = createdObject;

        createdObject = nge.Lib.Helper.objectApply(createdObject, new nge.Mlm.Objects.Base());
        createdObject.baseInit();
        (new mt.Service()).updateCommonProperties(data, createdObject, keepVisibility);

        return createdObject;
    }

    _addMtData(obj, data) {

        obj.mt = {
            self: obj,
            data: data,
            children: {}
        };
        obj.self = obj;
        obj.getData = function () {
            return this.mt.data;
        };
    }

    _addGroup(object) {
        var group = new PIXI.Container();
        group.x = object.x;
        group.y = object.y;
        group.fixedToCamera = !!object.fixedToCamera;
        if (object.angle) {
            group.angle = object.angle;
        }
        group.alpha = (typeof (group.alpha) !== 'undefined') ? object.alpha : 1;
        return group;
    }

    _addText(object, group) {
        group = group || nge.wrap.states.world;

        //gradient
        if (object.gradient) {
            nge.Lib.Helper.recursiveSet('style.fill', 'gradient', object._originalModel);

            object.style.fill = [];
            object.style.fillGradientStops = [];

            for (var i = 0; i < object.gradient.length; i++) {
                object.style.fill.push(object.gradient[i][1]);
                object.style.fillGradientStops.push(object.gradient[i][0]);
            }
        }

        //shadow
        if ((object.style.shadowFill || object.style.shadowStroke) && (object.style.shadowOffsetX > 0 || object.style.shadowOffsetY > 0)) {
            object.style.dropShadow = true;
            object.style.dropShadowBlur = object.style.shadowBlur;
            object.style.dropShadowColor = object.style.shadowColor;
            object.style.dropShadowDistance = Math.sqrt(Math.pow(object.style.shadowOffsetX, 2) + Math.pow(object.style.shadowOffsetY, 2));
            object.style.dropShadowAngle = (object.style.shadowOffsetX > 0) ? Math.atan(object.style.shadowOffsetY / object.style.shadowOffsetX) : (object.style.shadowOffsetY > 0) ? Math.PI / 2 : Math.PI * 3 / 2;
        }

        let t = new PIXI.Text(object.text || object.name, object.style);
        t.position.set(object.x, object.y);
        t.lineSpacing = object.lineSpacing; //не будет работать в PIXI, добавлено в валидатор текста
        t.blendMode = object.blendMode;
        group.addChild(t);
        return t;
    }
    _addGraphics(object, group) {
        group = group || nge.wrap.states.world;
        let t = new PIXI.Graphics();
        t.position.set(object.x, object.y);
        group.addChild(t);
        return t;
    }
    _addMask(object, group) {
        group = group || nge.wrap.states.world;

        const mask = new PIXI.Graphics();
        mask.position.set(object.x, object.y);
        mask.lineStyle(0);
        mask.beginFill(0xffffff);

        if (!Array.isArray(object.rects[0]))
            mask.drawRect(object.rects[0], object.rects[1], object.rects[2], object.rects[3]);
        else
            for (var i = 0; i < object.rects.length; i++)
                mask.drawRect(object.rects[i][0], object.rects[i][1], object.rects[i][2], object.rects[i][3]);

        mask.endFill();
        mask.cacheAsBitmap = true;
        mask.dirty = true;

        group.addChild(mask);
        return mask;

    }
    _addBitmapText(object, group) {
        group = group || nge.wrap.states.world;
        const t = new PIXI.extras.BitmapText(object.text || '', {font: object.size + 'px ' + object.assetKey});
        t.position.set(object.x, object.y);
        group.add(t);
        return t;
    }
    _addSpine(object, group) {
        group = group || nge.wrap.states.world;
        var n = (nge.wrap.cache.hasSpine(object.assetKey)) ? new nge.Spine(nge.wrap, object.assetKey, null) : (new mt.Sponge()).add(object);
        group.add(n);
        return n;
    }
    _addAnimation(object, group) {
        group = group || nge.wrap.states.world;
        const textures = [];
        for (let i = 0; i < object.frames.length; i++) {
            textures.push(nge.wrap.cache.getTexture(object.frames[i]));
        }
        var n = new PIXI.extras.AnimatedSprite(textures);
        n.texture = nge.wrap.cache.getTexture(object.assetKey);
        n.loop = object.loop;
        n.animationSpeed = object.speed;
        n.blendMode = object.blendMode;
        if (object.autoStart)
            n.play();
        group.add(n);
        return n;
    }
    _addEmitter(object, group) {
        group = group || nge.wrap.states.world;
        var container = new PIXI.particles.ParticleContainer();
        container.setProperties({
            scale: true,
            position: true,
            rotation: true,
            uvs: true,
            alpha: true
        });

        const particles = nge.Lib.Helper.jsObjClone(object.particles);
        if (!object.animated) {
            for (let i = 0; i < particles.length; i++)
                particles[i] = nge.wrap.cache.getTexture(particles[i]);
        } else {
            for (let i = 0; i < particles.length; i++) {
                const textures = particles[i].textures;
                for (let j = 0; j < textures.length; j++)
                    textures[j] = nge.wrap.cache.getTexture(textures[j]);
            }
        }


        const config = JSON.parse(JSON.stringify(nge.wrap.cache.getJSON(object.assetKey)));

        config.scale.start = config.scale.start / nge.assets.getQualityFactor();
        config.scale.end = config.scale.end / nge.assets.getQualityFactor();

        const emitter = new PIXI.particles.Emitter(container, particles, config);
        if (object.animated)
            emitter.particleConstructor = PIXI.particles.AnimatedParticle;

        switch (config.blendMode) {
            case 'add':
                container.blendMode = PIXI.BLEND_MODES.ADD;
                break;
            case 'multiply':
                container.blendMode = PIXI.BLEND_MODES.MULTIPLY;
                break;
            case 'screen':
                container.blendMode = PIXI.BLEND_MODES.SCREEN;
                break;
            default:
                container.blendMode = PIXI.BLEND_MODES.NORMAL;
                break;
        }

        emitter.autoUpdate = true;
        container.emitter = emitter;
        container.x = object.x;
        container.y = object.y;
        group.add(container);
        return container;
    }

    _addUnityEmitter(object, group) {
        group = group || nge.wrap.states.world;
        var n = new PIXI.UnityEmitter();
        n.x = object.x;
        n.y = object.y;
        n.makeParticles(object.assetKey);
        group.add(n);
        return n;
    }

    _addNineSlice(object, group) {
        group = group || nge.wrap.states.world;

        // Костыль для бага: https://jira.servupdate.com/browse/JSCLIENT-4198
        // https://github.com/pixijs/pixi.js/issues/3671
        let texture = nge.wrap.cache.getTexture(object.assetKey);
        let sprite = new PIXI.Sprite(texture);
        let renderTexture = nge.wrap.states.renderer.generateTexture(sprite);
        sprite.destroy();

        let n = new PIXI.mesh.NineSlicePlane(renderTexture,
            object.left * nge.assets.getQualityFactor(),
            object.top * nge.assets.getQualityFactor(),
            object.right * nge.assets.getQualityFactor(),
            object.bottom * nge.assets.getQualityFactor());
        n.width = object.width;
        n.height = object.height;
        n.anchor = new PIXI.ObservablePoint(function () {
            this.pivot.x = this.anchor.x * this.width / this.scale.x;
            this.pivot.y = this.anchor.y * this.height / this.scale.y;
        }, n);
        group.add(n);
        delete object.assetKey;
        return n;
    }

    _addRadioButton(object, group) {
        group = group || nge.wrap.states.world;

        const btn = (new mt.СustomObjects()).createButtonObject(
            object.x,
            object.y,
            object.assetKey,
            () => {
            nge.observer.fire('radiobutton.click.' + object.groupName, object.selection);
        },
            this,
            object.btnFrames.over,
            object.btnFrames.over,
            object.btnFrames.over
            );

        nge.observer.add('radiobutton.click.' + object.groupName, function (index) {
            const frame = index === object.selection ? 1 : 0;
            btn.setFrames(frame, frame, frame, frame);
            btn.frame = frame;
        }, object.groupName + '-' + object.selection);

        if (!object.enabled) {
            btn.input.enabled = false;
            btn.frame = object.frame;
        } else
            btn.inputEnabled = true;

        btn.input.useHandCursor = true;
        btn.input.pixelPerfectOver = object.pixelPerfectOver;
        btn.input.pixelPerfectClick = object.pixelPerfectClick;

        group.addChild(btn);
        return btn;
    }

    _addSlider(object, group) {
        group = group || nge.wrap.states.world;

        const background = nge.objects.create(new nge.Mlm.Objects.Image({
            assetKey: object.bgAssetKey
        }));

        object.y = object.y + background.height * 0.5;

        // TODO: фореграунд в PSD должен быть найнслайсом, а не закрываться маской
        const foreground = nge.objects.create(new nge.Mlm.Objects.NineSlice({
            assetKey: object.fillAssetKey,
            left: 20,
            right: 20,
            top: 0,
            bottom: 0,
            height: 18,
            width: 0
        }));

        const thumb = nge.objects.create(new nge.Mlm.Objects.Button({
            assetKey: object.handleAssetKey,
            btnFrames: {
                over: 2,
                out: 1,
                down: 0
            }
        }));

        foreground.activeTexture = foreground.texture;
        foreground.inactiveTexture = nge.wrap.cache.getTexture(object.fillInactiveAssetKey);

        // FIXME: Y-позиция слайдера в PSD неверная
        const slider = new PIXI.Slider(background, foreground, thumb);
        slider.margins = {left: object.marginLeft, right: object.marginRight};

        if (object.tooltipBg && object.tooltipText) {
            const tooltipBackground = nge.objects.create(new nge.Mlm.Objects.Image(object.tooltipBg));
            const tooltipText = nge.objects.create(new nge.Mlm.Objects.Text(object.tooltipText));
            const tooltip = new PIXI.Tooltip(tooltipBackground, tooltipText);
            const tooltipOffset = object.tooltipBg.y - object.y;
            const tooltipTextOffset = object.tooltipText.y - object.y;
            tooltip.setOffsets(-30, -75); // FIXME: оффсеты должны быть исправлены в PSD
            slider.tooltip = tooltip;
        }

        if (object.valueText) {
            const label = nge.objects.create(new nge.Mlm.Objects.Text(object.valueText));
            // FIXME: оффсеты должны быть исправлены в PSD
            label.offset = -60;
            slider.label = label;
        }

        group.add(slider);
        return slider;
    }

    _addTileLayer(object, group) {
        group = group || nge.wrap.states.world;
        var map = mt.game.add.tilemap(null, object.tileWidth, object.tileHeight, object.widthInTiles, object.heightInTiles);
        var tl = map.createBlankLayer(object.name, object.widthInTiles, object.heightInTiles, object.tileWidth, object.tileHeight);
        var nextId = 0;
        var im = null;
        var asset = "";
        for (var i = 0; i < object.images.length; i++) {
            asset = (new mt.Service()).getAssetById(object.images[i]);
            if (asset) {
                im = map.addTilesetImage(asset.key, asset.key, asset.frameWidth, asset.frameHeight, asset.margin, asset.spacing, nextId);
                nextId += im.total;
            } else {
                console.warn("cannot find image", object.images[i]);
            }
        }

        var tiles = object.tiles;
        var tile = null;
        for (var y in tiles) {
            for (var x in tiles[y]) {
                tile = map.putTile(tiles[y][x], parseInt(x, 10), parseInt(y, 10), tl);
            }
        }
        tl.fixedToCamera = object.isFixedToCamera;
        return tl;
    }

    templateFunctionCall(func) {
        if (func)
            if (typeof func === 'string')
                eval('(' + func + ')()');
            else
                func();
    }

    _addObject(object, group) {
        let sp;
        group = group || nge.wrap.states.world;
        if (group instanceof PIXI.Container) {
            if (object.btnFrames) {
                var callback = object.action;
                sp = (new mt.СustomObjects()).createButtonObject(
                    object.x,
                    object.y,
                    object.assetKey,
                    () => {
                    nge.observer.fire('button.click', sp);
                    this.templateFunctionCall(callback);
                },
                    this,
                    object.btnFrames.over,
                    object.btnFrames.out,
                    object.btnFrames.down
                    );

                sp.events.onInputOver.add(function () {
                    nge.observer.fire('button.hover', sp);
                }, this);

                sp.events.onInputOut.add(function () {
                    nge.observer.fire('button.unhover', sp);
                }, this);

                group.addChild(sp);

                if (!object.enabled) {
                    sp.input.enabled = false;
                    sp.frame = object.frame;
                } else
                    sp.inputEnabled = true;

                sp.input.useHandCursor = true;
                sp.input.pixelPerfectOver = object.pixelPerfectOver;
                sp.input.pixelPerfectClick = object.pixelPerfectClick;
            } else {
                if (mt.game.cache.hasTexture(object.assetKey)) {
                    sp = new PIXI.Sprite(mt.game.cache.getTexture(object.assetKey));
                } else if (mt.game.cache.hasSpritesheet(object.assetKey)) {
                    const spritesheet = mt.game.cache.getSpritesheet(object.assetKey);
                    sp = new PIXI.Sprite(spritesheet.textures[0]);
                    sp.spritesheet = spritesheet;
                    sp.frame = 0;
                } else {
                    console.warn('No texture with key ' + object.assetKey + ' found in cache. Using black-bg instead', object);
                    sp = new PIXI.Sprite(mt.game.cache.getTexture('black-bg'));
                }

                sp.position.set(object.x, object.y);
                sp.blendMode = object.blendMode;
                group.addChild(sp);
                //sprite
                if (object.scratchable) {
                    var scratchColor = 'rgba(0, 0, 0, 255)';
                    sp.alpha = 0;
                    var width = sp.width;
                    var height = sp.height;

                    var bmd = nge.game.add.bitmapData(width, height);
                    bmd.draw(object.assetKey);
                    bmd.update();
                    var absPos = (new mt.Service()).getAbsPos(sp);

                    bmd.addToWorld(
                        absPos.x,
                        absPos.y,
                        0, 0,
                        1 / nge.assets.getQualityFactor(),
                        1 / nge.assets.getQualityFactor()
                        );

                    sp.inputEnabled = true;
                    sp.scratchBMD = bmd;
                    var cursor;

                    bmd.reveal = function () {
                        if (!bmd)
                            return false;

                        bmd.rect(0, 0, width, height, scratchColor);
                        bmd.clear();
                        bmd = false;
                        sp.alpha = 1;
                        var tween = nge.tween.add(sp).to(
                            {alpha: 0}, 500, "Linear", true);
                        tween.onComplete.addOnce(function () {
                            nge.observer.fire('scratchReveal', sp.getData().name);

                            sp.destroy();
                            if (cursor)
                                destroyCursor();
                        });
                        tween.start();
                    };

                    if (object.scratchCursor) {
                        var getCurCoords = function () {
                            return {
                                x: nge.game.input.mousePointer.x / nge.wrap.states.world.scale.x,
                                y: nge.game.input.mousePointer.y / nge.wrap.states.world.scale.y
                            };
                        };
                        //onover
                        sp.events.onInputOver.add(function (e) {
                            if (cursor)
                                return false;
                            cursor = nge.game.add.sprite(getCurCoords().x, getCurCoords().y, object.scratchCursor);
                            cursor.scale.x /= nge.assets.getQualityFactor();
                            cursor.scale.y /= nge.assets.getQualityFactor();
                            cursor.anchor.x = 0.5;
                            cursor.anchor.y = 0.5;
                            nge.observer.add('StatesManager.update.start', function (k) {
                                if (!cursor) {
                                    nge.observer.remove('StatesManager.update.start', false, 'scratchProgress');
                                    return false;
                                }
                                cursor.x = getCurCoords().x;
                                cursor.y = getCurCoords().y;
                            }, 'scratchCursorProgress');
                        }, this);
                        //onout
                        var destroyCursor = function () {
                            nge.observer.remove('StatesManager.update.start', false, 'scratchProgress');
                            cursor.destroy();
                            cursor = false;
                        };
                        sp.events.onInputOut.add(function (e) {
                            destroyCursor();
                        }, this);
                    }

                    var startTrackingInput = function () {
                        nge.observer.add('StatesManager.update.start', function (k) {
                            if (!bmd)
                                return false;

                            var x = (nge.game.input.x / nge.wrap.states.world.scale.x - absPos.x) * nge.assets.getQualityFactor();
                            var y = (nge.game.input.y / nge.wrap.states.world.scale.y - absPos.y) * nge.assets.getQualityFactor();
                            var radius = 50;
                            bmd.blendDestinationOut();
                            bmd.circle(x, y, 50 * nge.assets.getQualityFactor(), scratchColor);
                            /*bmd.blendReset();*/
                            bmd.update();
                        }, 'scratchProgress');
                    };

                    var stopTrackingInput = function () {
                        nge.observer.remove('StatesManager.update.start', false, 'scratchProgress');
                        if (!bmd)
                            return false;
                        //check pixels alpha count
                        var aCount = 0;
                        var forEachPixel = function (p) {
                            if (p.a === 0)
                                aCount++;
                        };
                        bmd.processPixelRGB(forEachPixel, this);
                        var allCount = sp.width * sp.height * (nge.assets.getQualityFactor() * nge.assets.getQualityFactor());
                        var persents = aCount * 100 / allCount;

                        if (persents > 80) {
                            bmd.reveal();
                        }
                    };


                    sp.events.onInputDown.add(function (e) {
                        startTrackingInput();
                    }, this);

                    sp.events.onInputOver.add(function (e) {
                        if (nge.game.input.activePointer.isDown)
                            startTrackingInput();
                    }, this);

                    sp.events.onInputOut.add(function (e) {
                        stopTrackingInput();
                    }, this);

                    sp.events.onInputUp.add(function (e) {
                        stopTrackingInput();
                    }, this);
                } else {
                    //regular sprite
                    if (object.inputEnabled)
                        sp.inputEnabled = true;
                }

            }
        } else {
            sp = nge.game.add.sprite(object.x, object.y, object.assetKey);
            nge.wrap.states.world.removeChild(sp);
            sp.blendMode = object.blendMode;
            group.addChild(sp);
            if (object.inputEnabled)
                sp.interactive = true;
        }
        // TODO: совсем непонятно что тут происходит и зачем
        /*var frameData = mt.game.cache.getFrameData(object.assetKey);
         if (frameData && !object.btnFrames) {
         var arr = [];
         for (var i = 0; i < frameData.total; i++) {
         arr.push(i);
         }
         sp.animations.add("default", arr, (object.fps !== void(0) ? object.fps : 10), false);
         sp.frame = object.frame;
         }*/
        return sp;
    }
};

mt.Create.instance = null;



mt.СustomObjects = class {

    constructor() {
        if (!mt.СustomObjects.instance)
            mt.СustomObjects.instance = this;
        return mt.СustomObjects.instance;
    }

    createButtonObject(x, y, key, callback, callbackContext, overFrame = 0, outFrame = 0, downFrame = 0, disabledFrame = 0) {
        let textureOut, textureDown, textureOver, textureDisabled;
        const spritesheet = nge.wrap.cache.getSpritesheet(key);

        const getTexture = function (n) {
            n = (spritesheet.textures[n]) ? n : 0;
            return spritesheet.textures[n];
        };

        if (spritesheet) {
            textureOut = getTexture(outFrame);
            textureDown = getTexture(downFrame);
            textureOver = getTexture(overFrame);
            textureDisabled = getTexture(disabledFrame);
        } else {
            textureOut = nge.wrap.cache.getTexture(key);
            textureDown = nge.wrap.cache.getTexture(key);
            textureOver = nge.wrap.cache.getTexture(key);
            textureDisabled = nge.wrap.cache.getTexture(key);
        }

        const button = new PIXI.Sprite(textureOut);
        button.spritesheet = spritesheet;
        button.interactive = true;
        button.buttonMode = true;

        button.setFrames = (over = overFrame, out = outFrame, down = downFrame, disabled = disabledFrame) => { // TODO: вместо disabled тут был up, который врядли кому вообще нужен
            if (!spritesheet)
                return;

            textureOut = getTexture(out);
            textureDown = getTexture(down);
            textureOver = getTexture(over);
            textureDisabled = getTexture(disabled);
            button.loadTexture(textureOut);
        };

        button.disable = (frame) => {
            button.interactive = false;
            if (!_.isNil(frame) && spritesheet)
                button.loadTexture(getTexture(frame));
        };

        button.enable = () => {
            button.interactive = true;
            button.loadTexture(textureOut);
        };

        Object.defineProperty(button, '_onOutFrame', {
            set: function (value) {
                if (spritesheet)
                    textureOut = getTexture(value);
            }
        });

        Object.defineProperty(button, '_onDownFrame', {
            set: function (value) {
                if (spritesheet)
                    textureDown = getTexture(value);
            }
        });

        Object.defineProperty(button, '_onOverFrame', {
            set: function (value) {
                if (spritesheet)
                    textureOver = getTexture(value);
            }
        });

        button.anchor.set(0.5, 0.5);
        button.position.x = x;
        button.position.y = y;
        button.tap = callback;
        button.click = callback;

        const onButtonDown = function () {
            this.isdown = true;
            this.loadTexture(textureDown);

            for (var i = 0; i < button._onInputDown.length; i++)
                button._onInputDown[i]();
        };

        const onButtonUp = function () {
            this.isdown = false;

            if (this.isOver)
                this.loadTexture(textureOver);
            else
                this.loadTexture(textureOut);

            for (var i = 0; i < button._onInputUp.length; i++)
                button._onInputUp[i]();
        };

        const onButtonOver = function () {
            this.isOver = true;

            if (this.isdown)
                return;

            this.loadTexture(textureOver);

            for (var i = 0; i < button._onInputOver.length; i++)
                button._onInputOver[i]();
        };

        const onButtonOut = function () {
            this.isOver = false;

            if (this.isdown)
                return;

            this.loadTexture(textureOut);

            for (var i = 0; i < button._onInputOut.length; i++)
                button._onInputOut[i]();
        };

        button
            .on('mousedown', onButtonDown)
            .on('touchstart', onButtonDown)
            .on('mouseup', onButtonUp)
            .on('touchend', onButtonUp)
            .on('mouseupoutside', onButtonUp)
            .on('touchendoutside', onButtonUp)
            .on('mouseover', onButtonOver)
            .on('mouseout', onButtonOut);

        button._onInputUp = [];
        button._onInputOver = [];
        button._onInputOut = [];
        button._onInputDown = [];

        button.events = {
            onInputOver: {
                add: function (callback, callbackContext) {
                    button._onInputOver.push(callback);
                }
            },
            onInputOut: {
                add: function (callback, callbackContext) {
                    button._onInputOut.push(callback);
                }
            },
            onInputUp: {
                add: function (callback, callbackContext) {
                    button._onInputUp.push(callback);
                }
            },
            onInputDown: {
                add: function (callback, callbackContext) {
                    button._onInputDown.push(callback);
                }
            }
        };

        //events
        button.onInputUp = button.events.onInputUp;
        button.onInputOver = button.events.onInputOver;
        button.onInputOut = button.events.onInputOut;
        button.onInputDown = button.events.onInputDown;

        //input
        button.input = {//todo
            enabled: true,
            useHandCursor: true,
            pixelPerfectOver: true,
            pixelPerfectClick: true,
            pointerOver: () => {
                return button.isOver;
            }
        };

        return button;
    }

};

mt.СustomObjects.instance = null;

// TODO: переместить в правильное место

nge.spine = {
    NONE: 0,
    HIDE: 1,
    FREEZE: 2,
    DESTROY: 3,
    LOOP: 4,
    Plugin: {
        init: function() {
            const spinePreloader = new nge.Spine.Preloader();
            spinePreloader.subscribe();
        }
    }
};

nge.RenderTexture = class extends PIXI.RenderTexture {

};

nge.Spine = class extends PIXI.Container {
    constructor(wrap, key, scalingVariant) {
        super();
        this.spine = new PIXI.spine.Spine(wrap.cache.getSpine(key));

        this.onEvent = new nge.Lib.Signal();
        this.onStart = new nge.Lib.Signal();
        this.onComplete = new nge.Lib.Signal();

        this.spine.state.addListener({
            start: () => {
                this.onStart.dispatch();
            },
            event: (track, event) => {
                this.onEvent.dispatch(track, event);
            },
            complete: () => {
                this._complete();
            }
        });

        this.onChildInputDown = new nge.Lib.Signal();
        this.on('pointerdown', () => {
            this.onChildInputDown.dispatch();
        });
        this.addChild(this.spine);
    }
    get autoUpdate() {
        debugger;
        return this._autoUpdate;
    }
    set autoUpdate(value) {
        this._autoUpdate = value;
        debugger;
    }
    _reset() {
        this._mode = nge.spine.NONE;
        this._cacheOnComplete = false;
        this._speed = 1;
        this._run = false;
    }
    _complete() {
        if (this._mode === nge.spine.LOOP)
            return;

        this._run = false;
        this.onComplete.dispatch();
        if (this._run)
            return;
        if (this._mode === nge.spine.DESTROY) {
            nge.rafSetTimeout(() => {
                this.destroy();
            }, 1);
        } else {
            this.visible = this._mode === nge.spine.FREEZE;
        }
    }
    preloadAllSprites() {
        // TODO: Preloading
    }
    getScaleFromVariant(variant) {
        console.error('error is not supported. No rescaling required');
    }
    setTint(tint) {
        this.spine.tint = tint;
    }
    _setAnimation(track, animationName, loop = true) {
        this.spine.state.setAnimation(track, animationName, loop);
    }
    _playObject(params) {
        if (this.spine._destroyed)
            return;
        this._reset();
        params.track = params.track || 0;
        this._mode = params.mode = params.mode || nge.spine.NONE;
        this.spine.name = params.name;
        if (typeof params.x === 'number')
            this.x = params.x;
        if (typeof params.y === 'number')
            this.y = params.y;
        if (typeof params.z === 'number')
            this.z = params.z;
        this.cacheAsBitmap = false;
        this.spine.visible = true;
        this.visible = true;
        this._setAnimation(params.track, params.name, this._mode === nge.spine.LOOP);
        this.setSpeed(params.speed || 1);
        this.spine.lastTime = 0;
        this.spine.update(0);

        if (params.useCache)
            this._cacheOnComplete = true;

        if (params.onComplete)
            this.onComplete.addOnce(params.onComplete);
        this._run = true;
    }
    setAnimationByMode(trackIndex, animationName, playMode, speed = 1, cacheOnFreeze = false) {
        if (_.isObjectLike(trackIndex))
            return this._playObject(trackIndex);

        this._playObject({
            track: trackIndex || 0,
            name: animationName,
            mode: playMode,
            speed: speed,
            cacheOnFreeze: cacheOnFreeze
        });
    }
    setAnimationByName(trackIndex, animationName, loop = false, freezeOnComplete = false, speed = 1, cacheOnFreeze = false) {
        if (_.isObjectLike(trackIndex))
            return this._playObject(trackIndex);

        this._playObject({
            track: trackIndex || 0,
            name: animationName,
            mode: loop ? nge.spine.LOOP : (freezeOnComplete ? nge.spine.FREEZE : nge.spine.HIDE),
            speed: speed,
            cacheOnFreeze: cacheOnFreeze
        });
    }
    play(name, loop, freezeOnComplete = false, speed = 1, cacheOnFreeze = false) {
        if (_.isObjectLike(name))
            return this._playObject(name);

        this._playObject({
            track: 0,
            name: name,
            mode: loop ? nge.spine.LOOP : (freezeOnComplete ? nge.spine.FREEZE : nge.spine.HIDE),
            speed: speed,
            cacheOnFreeze: cacheOnFreeze
        });
    }
    stop(keepVisible = false, useCacheAsBitmapAnyway = false) {
        if (this.spine._destroyed)
            return;
        this.spine.state.clearListenerNotifications();
        this.pause();
        this._mode = keepVisible ? nge.spine.FREEZE : nge.spine.HIDE;

        if (useCacheAsBitmapAnyway)
            this._cacheOnComplete = true;

        this._complete();
    }
    stopTrack(trackIndex = 0) {
        this.spine.state.clearTrack(trackIndex);
    }
    pause() {
        this.spine.state.timeScale = 0;
    }
    resume() {
        this.spine.state.timeScale = this._speed;
    }
    autoUpdateTransform() {
        console.error('autoUpdateTransform is not supported yet');
    }
    createSprite(spineName, animationName, slot, attachment, sprite) {
        console.error('createSprite is not supported yet');
    }
    hide() {
        this.visible = false;
    }
    addToDebugRender(sprite) {
        console.error('addToDebugRender is not supported yet');
    }
    debugRender() {
        console.error('debugRender is not supported yet');
    }
    // Obsolete
    getCachedBone(boneName) {
        return this.findBone(boneName);
    }
    findBone(boneName) {
        return this.spine.skeleton.findBone(boneName);
    }
    setTime(value) {
        const time = nge.Lib.Math.clamp(value, 0, 1);
        this.spine.state.tracks.forEach(track => {
            track.time = track.endTime * time;
            track.lastTime = track.endTime * time;
        });
    }
    setMixByName(fromName, toName, duration) {
        this.spine.stateData.setMixByName(fromName, toName, duration);
    }
    setPosition(x = 0, y = 0, z = 0) {
        this.x = x;
        this.y = y;
        this.z = z;
    }
    startLoopSequence(trackIndex, onEnd, loopsCount) {
        debugger;
        console.error('startLoopSequence is not supported yet');
    }
    endLoopSequence(trackIndex) {
        debugger;
        console.error('endLoopSequence is not supported yet');
    }
    playAnimationChain(trackIndex, chain, onEnd, loopsCount, speed, freezeOnStop) {
        debugger;
        console.error('playAnimationChain is not supported yet');
    }
    findSprite(spriteName) {
        return this.spine.skeleton.slots.find(slot => {
            return slot.data.name === spriteName;
        });
    }
    hideSprite(slotName) {
        const slot = this.findSprite(slotName);
        if (!slot)
            return null;
        slot.alwaysHidden = true;
        return slot;
    }
    getSlotByName(slotName) {
        return this.spine.skeleton.findSlot(slotName);
    }
    setSpeed(speed = 1) {
        this._speed = speed;
        this.spine.state.timeScale = speed;
    }
    resetSpeed() {
        this.setSpeed(1);
    }
    addAnimationByName(trackIndex, animationName, loop = false, delay = 0) {
        //debugger;
        this.spine.state.addAnimationByName(trackIndex, animationName, loop, delay);
    }
    getCurrentAnimationForTrack(trackIndex = 0) {
        debugger;
        return this.spine.state.getCurrent(trackIndex).animation.name;
    }
    setSkinByName(skinName) {
        this.spine.skeleton.setSkinByName(skinName);
    }
    setSkin(skin) {
        this.spine.skeleton.setSkin(skin);
    }
    setToSetupPose() {
        this.spine.skeleton.setToSetupPose();
    }
    getBoneWorldPosition(target) {
        return {
            x: this.x + target.bone.x,
            y: this.y + target.bone.y
        };
    }
    getBoneScale(target) {
        return {
            x: target.bone.scaleX,
            y: target.bone.scaleY
        };
    }
    getSlotAlpha(target) {
        return target.color.a;
    }
};

nge.Spine.Preloader = class {
    constructor() {
        this.cfg = null;
    }

    _createBGContainer(parentSelector) {
        const backgroundContainerParent = nge.findOne(parentSelector);
        const backgroundContainer = new PIXI.Container();
        backgroundContainer.visible = true;

        backgroundContainerParent.add(backgroundContainer);
        backgroundContainerParent.sendToBack(backgroundContainer);
        return backgroundContainer;
    }

    _processPreload(threadIndex, preloadCfg) {
        if (preloadCfg.counter >= preloadCfg.data.length)
            return;

        const current = preloadCfg.data[preloadCfg.counter];
        const modelSpine = nge.Mlm.Objects.Spine({
            assetKey: current.spineName,
            isVisible: false
        });

        const spineObj = nge.objects.create(modelSpine, preloadCfg.backgroundContainer, true);
        spineObj.preloadAllSprites();

        spineObj.x = -1920;
        spineObj.y = -1080;

        spineObj.setAnimationByMode({
            name: current.animationName,
            mode: nge.spine.DESTROY,
            speed: 5,
            onComplete: () => {
                this._processPreload(threadIndex, preloadCfg);
            }
        });

        preloadCfg.counter++;
    }

    _onStateCreateCallback(stateName) {
        if (!this.cfg.preloadForStates || !this.cfg.preloadForStates[stateName])
            return;

        const preloadCfg = {};
        preloadCfg.counter = 0;
        preloadCfg.data = this.cfg.preloadForStates[stateName];
        preloadCfg.backgroundContainer = this._createBGContainer(this.cfg.backgroundContainerParentSelector);

        for (let i = 0; i < this.cfg.preloadThreads; i++) {
            this._processPreload(i, preloadCfg);
        }
    }

    subscribe() {
        this.cfg = nge.App.getInstance('Cfg.Spine', true);
        if (!this.cfg)
            return;

        nge.observer.add('StatesManager.create.end', this._onStateCreateCallback.bind(this), false, true);

        if (this.cfg.preloadForEvents) {
            for (let i = 0; i < this.cfg.preloadForEvents.length; i++) {
                let eventCfg = this.cfg.preloadForEvents[i];
                if (!eventCfg.eventName || eventCfg.eventName === '')
                    continue;
                const eName = eventCfg.eventName + '.spinePreloader';
                nge.observer.remove(eventCfg.eventName, false, eName);
                nge.observer.add(eventCfg.eventName, ((preload) => {
                    return () => {
                        const preloadCfg = {};
                        preloadCfg.counter = 0;
                        preloadCfg.data = preload;
                        preloadCfg.backgroundContainer = this._createBGContainer(this.cfg.backgroundContainerParentSelector);

                        for (let j = 0; j < this.cfg.preloadThreads; j++) {
                            this._processPreload(j, preloadCfg);
                        }
                    };
                })(eventCfg.preload), eName, true);
            }
        }
    };
};



//future nge.game with all interfaces. But just interfaces.

mt.GameAdapter = class {

    constructor() {
        if (!mt.GameAdapter.instance) {
            mt.GameAdapter.instance = this;
            this._setPrototypes();
        }

        return mt.GameAdapter.instance;
    }

    _setPrototypes() {

        Object.defineProperty(PIXI.DisplayObject.prototype, 'angle', {
            set: function (value) {
                this.rotation = PIXI.DEG_TO_RAD * value;
            },
            get: function () {
                return this.rotation / PIXI.DEG_TO_RAD;
            }
        });

        Object.defineProperty(PIXI.Container.prototype, 'sWidth', {
            set: function (value) {
                this._sWidth = value;
                this.updateAnchors();
            },
            get: function () {
                return this._sWidth;
            }
        });

        Object.defineProperty(PIXI.Container.prototype, 'sHeight', {
            set: function (value) {
                this._sHeight = value;
                this.updateAnchors();
            },
            get: function () {
                return this._sHeight;
            }
        });

        Object.defineProperty(PIXI.Container.prototype, 'anchor', {
            set: function (value) {
                this._anchor = value;
            },
            get: function () {
                if(!this._anchor) {
                    this._anchor = new PIXI.ObservablePoint(() => {
                        this.updateAnchors();
                    }, this, 0, 0);
                }
                return this._anchor;
            }
        });

        Object.defineProperty(PIXI.Container.prototype, 'anchorX', {
            set: function (value) {
                this.anchor.x = value;
            },
            get: function () {
                return this.anchor.x;
            }
        });

        Object.defineProperty(PIXI.Container.prototype, 'anchorY', {
            set: function (value) {
                this.anchor.y = value;
            },
            get: function () {
                return this.anchor.y;
            }
        });

        Object.defineProperty(PIXI.DisplayObject.prototype, 'inputEnabled', {
            set: function (value) {
                this.interactive = value;
            },
            get: function () {
                return this.interactive;
            }
        });

        Object.defineProperty(PIXI.DisplayObject.prototype, 'inputEnableChildren', {
            set: function (value) {
                this.interactiveChildren = value;
            },
            get: function () {
                return this.interactiveChildren;
            }
        });

        Object.defineProperty(PIXI.DisplayObject.prototype, 'centerX', {
            set: function (value) {
                this.x = value - (this.width / 2);
            },
            get: function () {
                return 960;
            }
        });

        Object.defineProperty(PIXI.DisplayObject.prototype, 'centerY', {
            set: function (value) {
                this.y = value - (this.height / 2);
            },
            get: function () {
                return 540;
            }
        });

        Object.defineProperty(PIXI.DisplayObject.prototype, 'scaleX', {
            set: function (value) {
                this.scale.x = value;
            },
            get: function () {
                return this.scale.x;
            }
        });

        Object.defineProperty(PIXI.DisplayObject.prototype, 'scaleY', {
            set: function (value) {
                this.scale.y = value;
            },
            get: function () {
                return this.scale.y;
            }
        });

        Object.defineProperty(PIXI.Sprite.prototype, 'frame', {
            set: function (value) {
                if (!this.spritesheet)
                    return;
                this._frame = value;
                const scaleX = this.scale.x;
                const scaleY = this.scale.y;
                this.texture = this.spritesheet.textures[value];
                this.scale.set(scaleX, scaleY);
            },
            get: function () {
                return this._frame || 0;
            }
        });

        Object.defineProperty(PIXI.DisplayObject.prototype, 'z', {
            set: function (value) {
                this.zIndex = value;
            },
            get: function () {
                return this.zIndex;
            }
        });

        PIXI.Container.prototype.updateTransform = function updateTransform() {
            this._boundsID++;

            if (this._destroyed || !this.parent || !this.transform || !this.parent.transform)
                return;
            this.transform.updateTransform(this.parent.transform);

            // TODO: check render flags, how to process stuff here
            this.worldAlpha = this.alpha * this.parent.worldAlpha;

            this.children.forEach(function (child) {
                if (child.visible)
                    child.updateTransform();
            });
        };

        PIXI.Graphics.prototype.drawTriangle = function (points) {
            this.drawPolygon(points);
        };

        PIXI.Container.prototype.add = PIXI.Container.prototype.addChild;
        PIXI.Container.prototype.remove = PIXI.Container.prototype.removeChild;

        PIXI.Container.prototype.removeAll = function (destroy = false, silent = false, destroyTexture = false) {
            this.removeChildren();
        };

        PIXI.mesh.NineSlicePlane.prototype.resize = function (width, height) {
            this.width = width;
            this.height = height;
        };

        PIXI.Sprite.prototype.events = {
            onInputDown: new nge.Lib.Signal()
        };

        PIXI.mesh.NineSlicePlane.prototype.events = {
            onInputOver: new nge.Lib.Signal(),
            onInputOut: new nge.Lib.Signal()
        };

        PIXI.Container.prototype.sendToBack = function (child) {
            if (!child)
                return;
            this.addChildAt(child, 0);
        };

        PIXI.Container.prototype.bringToTop = function (child) {
            if (!child)
                return;
            if(!this.children.includes(child))
                return;
            this.addChildAt(child, this.children.length - 1);
        };

        PIXI.Container.prototype.forEach = function (cb) {
            this.children.forEach(cb);
        };

        PIXI.extras.BitmapText.prototype.purgeGlyphs = function () {
            //console.color('Warning! purgeGlyphs is not allowed!', '#ff0000');
        };

        PIXI.DisplayObject.prototype.worldScale = {// TODO: Set normal scale
            x: 1,
            y: 1
        };

        PIXI.Container.prototype.sort = function (field = 'zIndex') {
            let sortRequired = false;

            function sortChildren(a, b)
            {
                if (a[field] === b[field])
                {
                    return a._lastSortedIndex - b._lastSortedIndex;
                }

                return a[field] - b[field];
            }

            for (let i = 0, j = this.children.length; i < j; ++i)
            {
                const child = this.children[i];

                child._lastSortedIndex = i;

                if (!sortRequired && child[field] !== 0)
                {
                    sortRequired = true;
                }
            }

            if (sortRequired && this.children.length > 1)
            {
                this.children.sort(sortChildren);
            }

            this.sortDirty = false;
        };

        PIXI.Sprite.prototype.clearTintedTexture = function () {
            //console.color('clearTintedTexture is not supported yet', '#ff0000');
        };

        PIXI.Texture.prototype.destroy = function () {
            //console.color('Warning! Destructing textures is not allowed!', '#ff0000');
        };

        PIXI.BaseTexture.prototype.destroy = function () {
            //console.color('Warning! Destructing base textures is not allowed!', '#ff0000');
        };

        PIXI.RenderTexture.prototype.render = function (object, matrix, clear) {
            nge.wrap.states.renderer.render(object, this);
        };

        PIXI.RenderTexture.prototype.renderXY = function (object) {
            this.render(object);
        };

        PIXI.Sprite.prototype.loadTexture = function (key, frame = 0, stopAnimation = false) {
            var sX = this.scale.x;
            var sY = this.scale.y;
            if (typeof key === 'string') // TODO: resolve later
                this.texture = nge.wrap.cache.getTexture(key);
            else
                this.texture = key;

            this.scale.set(sX, sY);
        };

        PIXI.Sprite.prototype.loadTextureFromSpritesheet = function (key, frame = 0) {
            this.spritesheet = nge.wrap.cache.getSpritesheet(key);
            this.frame = frame;
        };

        PIXI.Sprite.prototype.alignTo = function () {
            // TODO: resolve later;
            console.log('PIXI.Sprite.alignTo');
        };

        PIXI.Text.prototype.clearColors = function () {
            this.colors = [];
            this.strokeColors = [];
            this.dirty = true;
            return this;
        };

        PIXI.Text.prototype.drawLetterSpacing = function drawLetterSpacing(text, x, y) {
            var isStroke = arguments.length > 3 && arguments[3] !== undefined ? arguments[3] : false;
            var style = this._style;

            //orcs color magic
            var colors = this.colors;
            if (this.colors && this.colors.length > 0) {
                var tIn = this.text.indexOf(text);

                if (tIn !== 0) {
                    colors = [];

                    for (var i = 0; i < Object.keys(this.colors).length; i++) {
                        var key = Object.keys(this.colors)[i] - tIn;

                        if (key < 0)
                            key = 0;

                        colors[key] = this.colors[Object.keys(this.colors)[i]];
                    }
                }
            }

            // letterSpacing of 0 means normal
            var letterSpacing = style.letterSpacing;

            if (letterSpacing === 0 && (!colors || colors.length === 0)) {
                if (isStroke)
                    this.context.strokeText(text, x, y);
                else
                    this.context.fillText(text, x, y);


                return;
            }

            var drawCurrent = function (from, to, color, ctx) {
                if (color)
                    ctx.context.fillStyle = color;

                var current = text.slice(from, to);

                if (isStroke)
                    ctx.context.strokeText(current, currentPosition, y);
                else
                    ctx.context.fillText(current, currentPosition, y);

                currentPosition += letterSpacing + ~~ctx.context.measureText(current).width;
            };

            if (letterSpacing === 0 && colors && colors.length > 0) {
                var currentPosition = x;

                var objKeys = Object.keys(colors);

                if (+objKeys[0] !== 0)
                    drawCurrent(0, +objKeys[0], false, this);

                var max = text.length ;

                for (var i = 0; i < objKeys.length; i++) {
                    var from = +objKeys[i];

                    if (from > max)
                        return;

                    var to = (objKeys[i + 1]) ? +objKeys[i + 1] : max;

                    if (to > max)
                        to = max;

                    var color = colors[objKeys[i]];
                    drawCurrent(from, to, color, this);
                }

                return;
            }

            var characters = String.prototype.split.call(text, '');
            var currentPosition = x;
            var index = 0;
            var current = '';

            while (index < text.length) {
                current = characters[index++];
                if (isStroke)
                    this.context.strokeText(current, currentPosition, y);
                else
                    this.context.fillText(current, currentPosition, y);

                currentPosition += this.context.measureText(current).width + letterSpacing;
            }
        };

        this._createGameFunctions();
        this._createPhaserFunctions();
    }

    _createGameFunctions() {
        this.cache = {
            checkImageKey: function (key) {
                return nge.wrap.cache.hasTexture(key);
            }
        };

        this.input = {
            mousePointer: {// TODO: resolve later
                x: 0,
                y: 0
            },
            mouse: {
                // TODO: resolve later
            }
        };
        this.time = {
            fps: 0
        };

        this.scale = {
            get isFullScreen() {
                return !!(document['fullscreenElement'] ||
                    document['webkitFullscreenElement'] ||
                    document['mozFullScreenElement'] ||
                    document['msFullscreenElement']);
            },
            onFullScreenChange: new nge.Lib.Signal()
        };

        document.addEventListener('fullscreenchange', () => {
            this.scale.onFullScreenChange.dispatch();
        });

        document.addEventListener('mozfullscreenchange', () => {
            this.scale.onFullScreenChange.dispatch();
        });

        document.addEventListener('webkitfullscreenchange', () => {
            this.scale.onFullScreenChange.dispatch();
        });

        document.addEventListener('msfullscreenchange', () => {
            this.scale.onFullScreenChange.dispatch();
        });

        let lastUpdate = nge.Lib.Time.get();
        let lastSubmit = nge.Lib.Time.get();
        let frames = 0;

        // ORLY: да, я знаю)
        setTimeout(() => {
            nge.observer.add('cyclicUpdate', () => {
                let currentUpdate = nge.Lib.Time.get();
                frames++;

                if (currentUpdate - lastSubmit > 1000) {
                    this.time.fps = Math.round(1000 * frames / (currentUpdate - lastSubmit));
                    lastSubmit = currentUpdate;
                    frames = 0;
                }

                lastUpdate = currentUpdate;
            }, false, true);

            this.input.mousePointer = nge.wrap.states.interaction.mouse.global;
        }, 5000);

        //game.canvas
        Object.defineProperty(this, 'canvas', {
            get(v) {
                return nge.wrap.states.renderer.view;
            }
        });

        Object.defineProperty(this, 'width', {
            get() {
                return nge.wrap.states.renderer.width / nge.wrap.states.world.scale.x;
            }
        });

        Object.defineProperty(this, 'centerX', {
            get() {
                return nge.wrap.states.renderer.width / 2;
            }
        });

        Object.defineProperty(this, 'height', {
            get() {
                return nge.wrap.states.renderer.height / nge.wrap.states.world.scale.y;
            }
        });

        Object.defineProperty(this, 'centerY', {
            get() {
                return nge.wrap.states.renderer.height / 2;
            }
        });

        Object.defineProperty(this, 'world', {
            get() {
                return nge.wrap.states.world;
            }
        });

        var stage = {
            backgroundColor: 0x000000
        };


        var camera = {
            x: 0,
            y: 0
        };

        Object.defineProperty(this, 'stage', {
            get() {
                return stage;
            }
        });

        Object.defineProperty(this, 'camera', {
            get() {
                return camera;
            }
        });

        Object.defineProperty(this, 'renderer', {
            get() {
                return nge.wrap.states.renderer;
            }
        });

        //nge.game.world.centerX 
        //nge.game.world.centerY
        //nge.game.world.remove
        //nge.game.world.worldScale
        //nge.game.cache.
        //nge.game.load.progress
        //nge.game.input.
        //nge.game.paused
        //nge.game.update
        //nge.game.time
        //nge.game.stage.children
        //nge.game.width
        //nge.game.height
        //nge.game.renderer.
        //nge.game.camera
        //nge.game.stage.
        //nge.game.sound
        //nge.game.scale.
        //nge.game.load
    }

    _createPhaserFunctions() {
        //Phaser.Math  we will move to nge.Lib.Math
        //Phaser.Graphics
        //Phaser.Text
        //Phaser.Timer
        //Phaser.FrameData
        window.Phaser = {
            RenderTexture: function (game, width, height) {
                return PIXI.RenderTexture.create(width, height);
            },
            scaleModes: {
                SHOW_ALL: 1
            },
            Math: {
                clamp: function (a, b, c) {
                    return Math.max(b, Math.min(c, a));
                }
            },
            Point: function (x, y) {
                this.x = x;
                this.y = y;
                this.copyFrom = (target) => {
                    this.x = target.x;
                    this.y = target.y;
                    return this;
                }
                return this;
            }
        };
    }
};

mt.GameAdapter.instance = null;



mt.Preload = class {

    constructor() {
        if (!mt.Preload.instance)
            mt.Preload.instance = this;

        return mt.Preload.instance;
    }

    loadFonts(group) {
        var obj;
        for (var i = 0; i < group.contents.length; i++) {
            obj = group.contents[i];

            if (obj.contents) {
                this.loadFonts(obj);
                continue;
            }

            if (obj.type === mt.TEXT) {
                if (!obj.style || !obj.style.fontFamily || mt.knownFonts.indexOf(obj.style.fontFamily) !== -1)
                    continue;

                // debugger;
                mt.wrap.load.AddFont(obj.style.fontFamily); // TODO: Will not work
                console.warn('mt.Preload : start loading font in runtime ', obj.style.fontFamily);
            }
        }
    }

    loadAssets(data, container) {
        for (let i = 0, l = data.length; i < l; i++) {
            let asset = data[i];
            if (asset.contents)
                asset.type = mt.assets.GROUP;

            if (_.isNil(asset.type)) {
                console.error('Asset should have type');
                console.log(asset);
            }

            switch (asset.type) {
                case mt.assets.ATLAS:
                    asset = new nge.Mlm.Assets.Atlas(asset);
                    break;
                case mt.assets.BINARY:
                    asset = new nge.Mlm.Assets.Binary(asset);
                    break;
                case mt.assets.BITMAP_FONT:
                    asset = new nge.Mlm.Assets.BitmapFont(asset);
                    break;
                case mt.assets.GROUP:
                    asset = new nge.Mlm.Assets.Folder(asset);

                    if (_.isNil(container[asset.name]))
                        container[asset.name] = {};

                    this.loadAssets(asset.contents, container[asset.name]);
                    data[i] = asset;
                    continue;
                case mt.assets.IMAGE:
                    asset = new nge.Mlm.Assets.Image(asset);
                    break;
                case mt.assets.JSON:
                    asset = new nge.Mlm.Assets.Json(asset);
                    break;
                case mt.assets.SPINE:
                    asset = new nge.Mlm.Assets.Spine(asset);
                    break;
                default:
                    console.error('Unknown asset type: ' + asset.type);
                    break;
            }

            this._addAsset(asset, container);
            data[i] = asset;
        }
    }

    _addAsset(asset, container) {
        this.a = 0;

        if (asset.fullPath)
            if (asset.fullPath.indexOf('http') === 0)
                asset.useOriginalPath = true;
            else
                asset.fullPath = mt.assetsPath + asset.fullPath;

        nge.assets.parse(asset, container);
        var imageFullPath = asset.fullPath;

        if (!asset.key) // is already loaded ?
            return false;

        if (container[asset.name]) // is already loaded ?
            return false;

        switch (asset.type) {
            case mt.assets.BINARY:
                mt.game.load.addBinary(asset.key, imageFullPath);
                break;
            case mt.assets.JSON:
                mt.game.load.addJSON(asset.key, imageFullPath);
                break;
            case mt.assets.BITMAP_FONT:
                mt.game.load.addBitmapFont(asset.key, mt.assetsPath + asset.textureURL, mt.assetsPath + asset.bitmapFont);
                break;
            case mt.assets.SPINE:
                mt.game.load.addSpine(asset.key, mt.assetsPath + asset.spine, asset.packed);
                break;
            case mt.assets.ATLAS:
            case mt.assets.IMAGE:

                const filename = _.last(asset.originalPath.split('/'));
                const atlasName = nge.assets.getAtlasForTexture(filename);

                if (atlasName) {
                    const atlas = mt.game.cache.getAtlas(atlasName);
                    const frame = atlas.data.frames[filename].frame;

                    if (!asset.width)
                        asset.width = frame.w;

                    if (!asset.height)
                        asset.height = frame.h;

                    if (!asset.frameWidth)
                        asset.frameWidth = asset.width;
                    if (!asset.frameHeight)
                        asset.frameHeight = asset.height;

                    //spritesheet
                    if ((asset.width !== asset.frameWidth || asset.height !== asset.frameHeight) || asset.spritesheet) {
                        let x = frame.x;
                        let y = frame.y;
                        let index = 0;
                        const frameWidth = asset.frameWidth;
                        const frameHeight = asset.frameHeight;
                        const width = frame.w + x;
                        const height = frame.h + y;
                        const frames = {};

                        while (true) {
                            if (y + frameHeight > height)
                                break;

                            x = frame.x;
                            while (true) {
                                if (x + frameWidth > width)
                                    break;

                                frames[index++] = {
                                    frame: {
                                        x: x,
                                        y: y,
                                        w: frameWidth,
                                        h: frameHeight
                                    }
                                };

                                x += frameWidth;
                            }
                            y += frameHeight;
                        }

                        const data = {
                            frames: frames,
                            animations: {default: _.keys(frames)},
                            meta: {
                                format: 'RGBA8888',
                                size: {w: atlas.baseTexture.width, h: atlas.baseTexture.width},
                                scale: 1
                            }
                        };
                        const sheet = new PIXI.Spritesheet(atlas.baseTexture, data);
                        sheet.parse(() => {
                            mt.game.cache.addSpritesheet(asset.key, sheet);
                        });
                    } else
                        mt.game.cache.addTexture(asset.key, atlas.textures[filename]);
                } else {
                    //2) manual load
                    if (asset.atlas) {
                        var uber_json = nge.wrap.cache.getJSON('uber_json');
                        var jsonKey = asset.atlas.split('/').pop();
                        if (uber_json && uber_json[jsonKey]) {
                            mt.game.load.addAtlas(asset.key, imageFullPath, null, uber_json[jsonKey]);
                        } else {
                            mt.game.load.addAtlas(asset.key, imageFullPath, mt.assetsPath + asset.atlas, null);
                        }

                    } else if ((asset.width !== asset.frameWidth || asset.height !== asset.frameHeight) || asset.spritesheet) {

                        if (!asset.frameWidth)
                            asset.frameWidth = asset.width;
                        if (!asset.frameHeight)
                            asset.frameHeight = asset.height;
                        mt.game.load.addSpritesheet(asset.key, imageFullPath, asset.frameWidth, asset.frameHeight, asset.frameMax, asset.margin, asset.spacing);
                    } else {
                        mt.game.load.addTexture(asset.key, imageFullPath);
                    }
                }
                break;
            default:
                // debugger;
                return;
        }

        container[asset.name] = asset;
    }
};

mt.Preload.instance = null;



mt.Service = class {

    constructor() {
        if (!mt.Service.instance)
            mt.Service.instance = this;

        return mt.Service.instance;
    }

    getAssetById(id, container) {
        container = container || mt.data.assets.contents;
        var ret = null;
        for (var i in container) {
            if (container[i].id === id)
                return container[i];

            if (container[i].contents) {
                ret = this.getAssetById(id, container[i].contents);

                if (ret)
                    return ret;
            }
        }

        return ret;
    }

    getObjectGroupByName(name, container) {
        container = container || mt.data.objects.contents;
        var ret;
        for (var i = 0; i < container.length; i++) {
            if (container[i].name === name)
                return container[i];

            if (container[i].contents) {
                ret = this.getObjectGroupByName(name, container[i].contents);

                if (ret)
                    return ret;
            }
        }
    }

    updateCommonProperties(template, object, keepVisibility) {
        object.attr('x', template.x);
        object.attr('y', template.y);

        if (template.angle)
            object.angle = template.angle;

        if (object.anchor) {
            object.attr('anchorX', template.anchorX);
            object.attr('anchorY', template.anchorY);
        }

        if (object.alignX)
            object.attr('alignX', template.alignX);

        if (object.alignY)
            object.attr('alignY', template.alignY);

        if (template.sWidth)
            object.attr('sWidth', template.sWidth);
        else if (template.rightOffset)
            object.attr('rightOffset', template.rightOffset);
        else if (template.scaleX !== void(0))
            object.attr('scaleX', template.scaleX);

        if (template.sHeight)
            object.attr('sHeight', template.sHeight);
        else if (template.bottomOffset)
            object.attr('bottomOffset', template.bottomOffset);
        else if (template.scaleY !== void(0))
            object.attr('scaleY', template.scaleY);

        if (template.sType)
            object.attr('sType', template.sType);

        if (!template.scratchable)
            object.attr('alpha', (typeof (object.alpha) !== 'undefined') ? template.alpha : 1);

        nge.assets.applyQuality(object, template);

        if (keepVisibility)
            object.attr('isVisible', template.isVisible);

        if (!object._ucp) {
            var destroyOriginal = object.destroy;

            object.destroy = function () {
                nge.objects.destroyHandler(object);
                var params = Array.prototype.slice.call(arguments);
                destroyOriginal.apply(object, params);
            };
        }

        nge.objects.createHandler(object);
        object._ucp = true;
    }

    findItemInTemplate(key, value, parent, getParentFlag) {
        var f = function (parent, n) {
            for (var k in parent.contents) {
                var el = parent.contents[k];
                if (el && typeof el[key] !== 'undefined' && (el[key] === value || value === '*ANY*')) {
                    if (getParentFlag)
                        return {
                            object: el,
                            parent: parent
                        };

                    return el;
                }

                if (el.contents && el.contents.length > 0)
                {
                    var res = f(el, n);
                    if (res)
                        return res;
                }
            }

            return false;
        };

        return f(parent, value) || false;
    }

    tplsPathsPrepare(o) {
        const _imgPath = '';

        /**
         * recursive path in object replacer
         * 
         * @param {Object} obj assets data object
         * @param {String} pref path prefix
         * @returns {Object}
         */
        var _recPathReplace = function (obj, pref) {
            for (var k in obj) {
                if (typeof obj[k] === 'object')
                    obj[k] = _recPathReplace(obj[k], pref);
                if (k === 'fullPath')
                    obj[k] = pref + obj[k];
            }

            return obj;
        };

        return _recPathReplace(o, _imgPath);
    }

    deleteItemInTemplate(key, value, parent) {
        var f = function (parent, n) {
            for (var k in parent.contents) {
                var el = parent.contents[k];
                if (el && typeof el[key] !== 'undefined' && (el[key] === value || value === '*ANY*')) {
                    delete parent[k];
                    parent.contents.splice(k, 1);
                    return true;
                }

                if (el.contents && el.contents.length > 0) {
                    var res = f(el, n);
                    if (res)
                        return res;
                }
            }
            return false;
        };

        return f(parent, value) || false;
    }

    getAbsPos(obj) {
        var pos = {x: obj.x, y: obj.y};

        while (obj.parent) {
            obj = obj.parent;
            pos.x += obj.x;
            pos.y += obj.y;
        }

        return pos;
    }
};

mt.Service.instance = null;



mt.UiEffects = class {

    constructor() {
        if (!mt.UiEffects.instance)
            mt.UiEffects.instance = this;

        return mt.UiEffects.instance;
    }

    _createHitZone(target, mode, width = 1, height = 1) {
        target.interactive = true;
        target.cursor = 'pointer';
        let startTime = 0;
        let startPoint = {x: 0, y: 0};
        let isDragging = false;
        target.hitArea = new PIXI.Rectangle(0, 0, width, height);

        const zone = {
            onDown: new nge.Lib.Signal(),
            onMove: new nge.Lib.Signal(),
            onUp: new nge.Lib.Signal()
        };

        const down = (ev) => {
            isDragging = true;
            startPoint.x = Math.round(ev.data.global.x / nge.wrap.states.world.scale.x);
            startPoint.y = Math.round(ev.data.global.y / nge.wrap.states.world.scale.y);
            startTime = nge.Lib.Time.get();

            zone.onDown.dispatch({
                startPoint: startPoint,
                startTime: startTime
            });
        };

        const up = (ev) => {
            if(!isDragging)
                return;
            isDragging = false;
            const currentTime = nge.Lib.Time.get();
            const currentPoint = {
                x: Math.round(ev.data.global.x / nge.wrap.states.world.scale.x), 
                y: Math.round(ev.data.global.y / nge.wrap.states.world.scale.y)
            };

            const vector = {
                x: Math.round(currentPoint.x - startPoint.x), 
                y: Math.round(currentPoint.y - startPoint.y)
            };
            if(mode === mt.UiEffects.VERTICAL || mode === mt.UiEffects.NONE)
                vector.x = 0;
            if(mode === mt.UiEffects.HORIZONTAL || mode === mt.UiEffects.NONE)
                vector.y = 0;

            zone.onUp.dispatch({
                startPoint: startPoint,
                startTime: startTime,
                endPoint: currentPoint,
                endTime: currentTime,
                vector: vector,
                deltaTime: currentTime - startTime
            });
        };

        const move = (ev) => {
            if(!isDragging)
                return;
            const currentTime = nge.Lib.Time.get();
            const currentPoint = {
                x: Math.round(ev.data.global.x / nge.wrap.states.world.scale.x), 
                y: Math.round(ev.data.global.y / nge.wrap.states.world.scale.y)
            };

            const vector = {
                x: Math.round(currentPoint.x - startPoint.x), 
                y: Math.round(currentPoint.y - startPoint.y)
            };
            if(mode === mt.UiEffects.VERTICAL || mode === mt.UiEffects.NONE)
                vector.x = 0;
            if(mode === mt.UiEffects.HORIZONTAL || mode === mt.UiEffects.NONE)
                vector.y = 0;

            zone.onMove.dispatch({
                startPoint: startPoint,
                startTime: startTime,
                currentPoint: currentPoint,
                currentTime: currentTime,
                vector: vector,
                deltaTime: currentTime - startTime
            });
        };

        target.on('pointerdown', down);
        target.on('pointerup', up);
        target.on('pointerupoutside', up);
        target.on('pointermove', move);
        return zone;
    }

    _makeDragCover(folder, callback) {
        const data = folder.getData();
        if(!data.name)
            return console.error('Folder model with dragCover property must have name property');

        const startEvent = `dragCover.${data.name}.start`;
        const progressEvent = `dragCover.${data.name}.progress`;
        const endEvent = `dragCover.${data.name}.end`;

        var zone = this._createHitZone(folder, mt.UiEffects.BOTH, data.width, data.height);
        zone.onDown.add((data) => {
            nge.observer.fire(startEvent, data);
        });

        zone.onMove.add((data) => {
            nge.observer.fire(progressEvent, data);
        });

        zone.onUp.add((data) => {
            nge.observer.fire(endEvent, data);
        });
        if(callback)
            callback();
    }

    _makeTabulate(children, parent, path, ref, keepVisibility, tabsType, callback) {

        var data = parent.mt.data;
        //'tabs.settingsPopupObject.switch'
        var tabsId = data.name;
        var children = parent.children;
        var activate = function (active) {
            var activeTab = nge.find('^' + tabsId + ' .active');
            if (activeTab)
                activeTab.removeClass('active');
            var newActiveTab = nge.find('^' + tabsId + ' ^' + active.tab);
            if (newActiveTab)
                newActiveTab.addClass('active');
            for (var i = 0; i < children.length - 1; i++) {
                children[i].visible = false;
            }
            var container = nge.find('^' + tabsId + ' ^' + active.container);
            if (container)
                container.visible = true;
        };
        nge.observer.remove('tabs.' + tabsId + '.switch', false, 'Tab' + tabsId);
        nge.observer.add('tabs.' + tabsId + '.switch', function (active) {
            activate(active);
        }, 'Tab' + tabsId);
        if (data.tabActive)
            nge.observer.fire('tabs.' + tabsId + '.switch', data.tabActive, 1);
        callback();
    }

    /*
     * swipeType 0 - none, 1 - vertical, 2 - horizontal, 3 - mixed
     */
    _makeSwipeable(children, parent, path, ref, keepVisibility, swipeType, callback) {
        var curTweenTuner;
        var mData = parent.getData();

        var onDragEndCallback = function (params) {
            var childrenArr = parent.children;

            var chosenOne;
            //step One is find object, that must be in zeroPosition
            for (var i = 0; i < childrenArr.length; i++) {
                if (i === 0) {
                    chosenOne = childrenArr[i];
                    continue;
                }

                chosenOne = ((swipeType === 1 || swipeType === 3) && (Math.abs(childrenArr[i].y + parent.y - mData.y) < Math.abs(chosenOne.y + parent.y - mData.y))) ? childrenArr[i] : chosenOne; //y
                chosenOne = ((swipeType === 2 || swipeType === 3) && (Math.abs(childrenArr[i].x + parent.x - mData.x) < Math.abs(chosenOne.x + parent.x - mData.x))) ? childrenArr[i] : chosenOne; //x
            }

            if (!chosenOne)
                return false;

            if (curTweenTuner)
                curTweenTuner.stop();

            curTweenTuner = nge.tween.add(parent).to(
                {x: mData.x - chosenOne.x, y: mData.y - chosenOne.y}, mData.rewParams.tuneTime, nge.Lib.Tween.Easing.Linear.None, false, mData.rewParams.tuneDelay);
            curTweenTuner.onComplete.addOnce(function () {
                if (params && params.scrollRefresh)
                    params.scrollRefresh();
                nge.observer.fire('swipe.cycleEnd', parent);
                curTweenTuner = undefined;
            });
            curTweenTuner.start();
        };

        this._makeScrollable(children, parent, path, ref, keepVisibility, swipeType, callback, true, onDragEndCallback);
    }

    /*
     * scrollType 0 - none, 1 - vertical, 2 - horizontal, 3 - mixed
     */
    _makeScrollable(children, parent, path, ref, keepVisibility, scrollType, callback, noScroll, onDragEndCallback) {

        class ScrollBar {
            constructor(container, callback) {
                this.MOUSE_MULTIPLIER = 1;
                this.TOUCH_MULTIPLIER = 2;

                this.pointer = {x: 0, y: 0};
                this.value = 0;
                this.background = container.getChildAt(0);
                this.thumb = container.getChildAt(1);
                this.constraints = {min: 0, max: 0};
                this.callback = callback;

                const mousemove = (ev) => {
                    const x = ev.data.originalEvent.clientX;
                    const y = ev.data.originalEvent.clientY;
                    this.drag({x: (x - this.pointer.x) * this.MOUSE_MULTIPLIER, y: (y - this.pointer.y) * this.MOUSE_MULTIPLIER});
                    this.pointer.x = x;
                    this.pointer.y = y;
                };

                const touchmove = function (ev) {
                    const x = ev.data.originalEvent.touches[0].clientX;
                    const y = ev.data.originalEvent.touches[0].clientY;
                    this.drag({x: (x - this.pointer.x) * this.TOUCH_MULTIPLIER, y: (y - this.pointer.y) * this.TOUCH_MULTIPLIER});
                    this.pointer.x = x;
                    this.pointer.y = y;
                };

                const up = function () {
                    this.thumb.off('mousemove', mousemove);
                    this.thumb.off('touchmove', touchmove);
                    this.thumb.off('pointerupoutside', up);
                    this.thumb.off('pointerup', up);
                };

                const down = (ev) => {
                    this.pointer = {
                        x: ev.data.originalEvent.clientX,
                        y: ev.data.originalEvent.clientY
                    };
                    if (typeof TouchEvent !== 'undefined') {
                        if (ev.data.originalEvent instanceof TouchEvent) {
                            this.pointer = {
                                x: ev.data.originalEvent.touches[0].clientX,
                                y: ev.data.originalEvent.touches[0].clientY
                            };
                        }
                    }

                    this.thumb.on('mousemove', mousemove, this);
                    this.thumb.on('touchmove', touchmove, this);
                    this.thumb.once('pointerupoutside', up, this);
                    this.thumb.once('pointerup', up, this);
                };

                this.thumb.on('pointerdown', down);
                this.thumb.interactive = true;
                this.thumb.cursor = 'pointer';
            }
            get position() {
                return this.thumb.position;
            }
        }
        class VerticalScrollBar extends ScrollBar {
            constructor(container, callback) {
                super(container, callback);
                this.constraints = {
                    min: this.background.y,
                    max: this.background.height - this.thumb.height
                };
            }

            move(value) {
                this.value = value;
                this.thumb.y = (this.value * (this.constraints.max - this.constraints.min)) + this.constraints.min;
            }

            drag(vector) {
                let y = nge.Lib.Math.clamp(this.thumb.y + vector.y, this.constraints.min, this.constraints.max);
                this.value = (y - this.constraints.min) / (this.constraints.max - this.constraints.min) || 0;
                this.move(this.value);
                if (this.callback)
                    this.callback({x: 0, y: this.value});
            }
        }
        class HorizontalScrollBar extends ScrollBar {
            constructor(container, callback) {
                super(container, callback);
                this.constraints = {
                    min: this.background.x,
                    max: this.background.width - this.thumb.width
                };
            }

            move(value) {
                this.value = value;
                this.thumb.x = (this.value * (this.constraints.max - this.constraints.min)) + this.constraints.min;
            }

            drag(vector) {
                let x = nge.Lib.Math.clamp(this.thumb.x + vector.x, this.constraints.min, this.constraints.max);
                this.value = (x - this.constraints.min) / (this.constraints.max - this.constraints.min) || 0;
                this.move(this.value);

                if (this.callback)
                    this.callback({x: this.value, y: 0});
            }
        }

        const MOUSE_MULTIPLIER = 2;
        const WHEEL_MULTIPLIER = nge.Lib.Helper.browserDetect() === 'Firefox' ? -38.5 : -2.2;
        const TOUCH_MULTIPLIER = 5;
        const data = parent.getData();
        data.extra = data.extra || {};
        const vertical = scrollType === 1 || scrollType === 3 ? 1 : 0;
        const horizontal = scrollType === 2 || scrollType === 3 ? 1 : 0;
        let scrollbarVertical = null;
        let scrollbarHorizontal = null;
        let pointer = {x: 0, y: 0};

        const constraints = {
            left: horizontal ? parent.x - ((children.length - 1) * 1920) : parent.x,
            top: vertical ? -parent.height + data.height + parent.y : parent.y,
            right: parent.x,
            bottom: parent.y
        };

        const mask = nge.objects.create(new nge.Mlm.Objects.Mask({rects: [[parent.x, parent.y, data.width, data.height]]}), parent);
        mask.interactive = true;
        mask.interactiveChildren = false;
        mask.cursor = 'pointer';
        parent.mask = mask;
        parent.parent.add(mask);

        const movescroll = function (vector) {
            if (scrollbarVertical)
                scrollbarVertical.move(vector.y);

            if (scrollbarHorizontal)
                scrollbarHorizontal.move(vector.x);
        };

        const move = function (vector) {
            const x = (vector.x * (constraints.right - constraints.left)) + constraints.left;
            const y = (vector.y * (constraints.top - constraints.bottom)) + constraints.bottom;
            parent.position.set(x, y);
        };

        const drag = function (vector) {
            const x = nge.Lib.Math.clamp(parent.x + vector.x, constraints.left, constraints.right);
            const y = nge.Lib.Math.clamp(parent.y + vector.y, constraints.top, constraints.bottom);
            const xProgress = (x - constraints.left) / (constraints.right - constraints.left) || 0;
            const yProgress = (y - constraints.bottom) / (constraints.top - constraints.bottom) || 0;
            move({x: xProgress, y: yProgress});
            movescroll({x: xProgress, y: yProgress});
        };

        const mousemove = function (ev) {
            const x = ev.data.originalEvent.clientX;
            const y = ev.data.originalEvent.clientY;
            drag({x: (x - pointer.x) * MOUSE_MULTIPLIER, y: (y - pointer.y) * MOUSE_MULTIPLIER});
            pointer.x = x;
            pointer.y = y;
        };

        const touchmove = function (ev) {
            const x = ev.data.originalEvent.touches[0].clientX;
            const y = ev.data.originalEvent.touches[0].clientY;
            drag({x: (x - pointer.x) * TOUCH_MULTIPLIER, y: (y - pointer.y) * TOUCH_MULTIPLIER});
            pointer.x = x;
            pointer.y = y;
        };

        const wheelmove = function (ev) {
            drag({x: ev.deltaX * WHEEL_MULTIPLIER, y: ev.deltaY * WHEEL_MULTIPLIER});
        };

        const down = function (ev) {
            pointer = {
                x: ev.data.originalEvent.clientX,
                y: ev.data.originalEvent.clientY
            };
            if (typeof TouchEvent !== 'undefined')
                if (ev.data.originalEvent instanceof TouchEvent) {
                    pointer = {
                        x: ev.data.originalEvent.changedTouches[0].clientX,
                        y: ev.data.originalEvent.changedTouches[0].clientY
                    };
                }

            mask.on('mousemove', mousemove, this);
            mask.on('touchmove', touchmove, this);
            mask.once('pointerupoutside', up, this);
            mask.once('pointerup', up, this);
        };

        const up = function () {
            mask.off('mousemove', mousemove);
            mask.off('touchmove', touchmove);
            mask.off('pointerupoutside', up);
            mask.off('pointerup', up);

            if (onDragEndCallback)
                onDragEndCallback();
        };

        /**
         * Выставить горизонтальную позицию контента, обновить позицию скроллбара и вызвать коллбек свайпа
         */
        data.extra.hMoveTo = (x) => {
            drag({x: x - parent.position.x, y: 0});
            if (onDragEndCallback)
                onDragEndCallback();
        };

        /**
         * Выставить вертикальную позицию контента, обновить позицию скроллбара и вызвать коллбек свайпа
         */
        data.extra.vMoveTo = (y) => {
            drag({x: 0, y: y - parent.position.y});
            if (onDragEndCallback)
                onDragEndCallback();
        };

        /**
         * обновить положение скроллбаров
         * NOTE: не может быть такой ситуации, в которой скроллбары рассинхронизируются с контентом и потребуется вызов этой функции.
         * Вызов drag c vector2.zero просто вызовет синхронизацию
         */
        data.extra.scrollRefresh = () => {
            drag({x: 0, y: 0});
        };

        /**
         * Поставить горизонтальный скроллбар в позицию.
         */
        data.extra.hScrollPos = (x) => {
            if (!scrollbarHorizontal)
                return;

            if (typeof x === 'undefined')
                return scrollbarHorizontal.position.x;

            scrollbarHorizontal.drag({x: x - scrollbarHorizontal.position.x, y: 0});
        };

        /**
         * Поставить вертикальный скроллбар в позицию.
         */
        data.extra.vScrollPos = (y) => {
            if (!scrollbarVertical)
                return;

            if (typeof y === 'undefined')
                return scrollbarVertical.position.y;

            scrollbarVertical.drag({x: 0, y: y - scrollbarVertical.position.y});
        };

        /**
         * Поставить горизонтальный скролл в позицию и выполнить колбек свайпа
         */
        data.extra.hScrollMoveTo = (x) => {
            data.extra.hScrollPos(x);
            if (onDragEndCallback)
                onDragEndCallback();
        };

        /**
         * Поставить вертикальный скролл в позицию и выполнить колбек свайпа
         */
        data.extra.vScrollMoveTo = (y) => {
            data.extra.vScrollPos(y);
            if (onDragEndCallback)
                onDragEndCallback();
        };

        mask.on('pointerdown', down);

        mask.on('mouseover', () => {
            document.addEventListener('wheel', wheelmove);
        });

        mask.on('mouseout', () => {
            document.removeEventListener('wheel', wheelmove);
        });

        if (vertical && !noScroll && parent.height > data.height) {
            const tpl = nge.tpl.group('scrollbarVertical');

            if (!tpl) {
                console.error('[FATAL]: no tpl for vertical scrollbar');
                return false;
            }

            (new mt.Create()).createObjects(tpl.objects.contents, parent.parent, path, ref, keepVisibility);
            const scrollbar = nge.objects.findItemInWorld('name', 'scrollbarVerticalContainer', parent.parent);
            nge.assets.applyQuality(scrollbar);
            scrollbar.x += parent.x + data.width - scrollbar.width;
            scrollbar.y += parent.y;
            scrollbar.getChildAt(0).height = data.height;
            scrollbarVertical = new VerticalScrollBar(scrollbar, move);
        }

        if (horizontal && !noScroll && parent.width > data.width) {
            const tpl = nge.tpl.group('scrollbarHorizontal');

            if (!tpl) {
                console.error('[FATAL]: no tpl for horizontal scrollbar');
                return false;
            }

            (new mt.Create()).createObjects(tpl.objects.contents, parent.parent, path, ref, keepVisibility);
            const scrollbar = nge.objects.findItemInWorld('name', 'scrollbarHorizontalContainer', parent.parent);
            nge.assets.applyQuality(scrollbar);
            scrollbar.x += parent.x;
            scrollbar.y += parent.y + data.height - scrollbar.height;
            scrollbar.getChildAt(0).width = data.width;
            scrollbarHorizontal = new HorizontalScrollBar(scrollbar, move);
        }

        if (callback)
            callback();
    }
};

mt.UiEffects.instance = null;
mt.UiEffects.NONE = 0;
mt.UiEffects.HORIZONTAL = 1;
mt.UiEffects.VERTICAL = 2;
mt.UiEffects.BOTH = 3;



window.mt.psd = {};

window.mt.psd.dataParser = new function () {
    var _subscribed = false;
    var _onCreateCallbacks = {};
    var _patternsAliases = null;
    var _defaultsDone = false;

    /**
     * parse images with naming _text, _bitmapText or _button
     * 
     * BUTTON
     * name(options)_button
     * @class (string, optional): class for this object
     * @spritesX (number, optional | default: 1): count of sprites by horisontal in this texture
     * @spritesY (number, optional | default: 1): count of sprites by vertical in this texture
     * @anchorX (number, optional | default: 0): 0 <---> 1
     * @anchorY (number, optional | default: 0): 0 <---> 1
     * @pixelPerfect (number, optional | default: 0) 0/1 Pixel Perfect Over/Click Detection
     * @screenGoTo (string, optional): screen name for layersSwitcher
     * 
     * @example spinButton(class=button center, spritesX=4, anchorx=0.5, pixelperfect=1, screenGoTo=info)_button
     *
     * BITMAP_TEXT
     * name(options)_bitmapText
     * @assetKey (string) bitmap font name
     * @text (string, optional): text
     * @size (number, optional): glyph size
     * @class (string, optional): class for this object
     * @anchorX (number, optional | default: 0): 0 <---> 1
     * @anchorY (number, optional | default: 0): 0 <---> 1
     * @align (string, optional) text align (left|center|right) WARNING! Use only with multiline text
     *
     * @example logoName(assetKey=mybitmapfont, text=LOGO, class=someTextClass, anchorX=0.5, size=128)_bitmapText
     *
     * NINE_SLICE
     * name(options)_nineSlice
     * @assetKey (string) name of image asset
     * @width (number): expected image width
     * @height (number): expected image height
     * @top (number): cut pixels from top
     * @bottom (number): cut pixels from bottom
     * @left (number): cut pixels from left
     * @right (number): cut pixels from right
     * @anchorX (number, optional | default: 0): 0 <---> 1
     * @anchorY (number, optional | default: 0): 0 <---> 1
     *
     * @example ninePopup(width=100, height=100, top=10, botom=10, left=10, right=10, anchorX=0.5)_nineSlice
     *
     * CLICKABLE_AREA
     * name(options)_clickableArea
     * @width (number): area width
     * @height (number): area height
     * @class (string): class that shares one handler event
     * @anchorX (number, optional | default: 0): 0 <---> 1
     * @anchorY (number, optional | default: 0): 0 <---> 1
     *
     * @example testArea(width=100, height=100, class=currencyChanger, anchorX=0.5)_clickableArea
     *
     * TEXT
     * name(options)_text
     * @text (string, optional): text
     * @class (string, optional): class for this object
     * @anchorX (number, optional | default: 0): 0 <---> 1
     * @anchorY (number, optional | default: 0): 0 <---> 1
     * @font (string, optional) "fontStyle fontSize fontTitle", all of this params are optional, fontSyze in pt only
     * @fill (string, optional): text color
     * @strokeThickness (number, optional): text outline thickness
     * @stroke (string, optional): text outline color, by default = text color
     * @wordWrap (number, optional | default: 0): 0 <---> 1
     * @wordWrapWidth (number, optional | default: 0): maximum string width. Only if wordWrap set to 1
     * @lineSpacing (number, optional | default: 0): line spacing
     * @shadowColor (string, optional): shadow color, works if shadowBlur set only
     * @shadowBlur (string, optional): shadow blur size, works if shadowColor set only
     *
     * @example logoName(text=LOGO, class=text1 paytableText, anchorX=0.5, font=bold 23pt arial, fill=#f9d700)_text
     * 
     * @returns {Boolean}
     */
    this.go = function () {
        _parse(mt.data.assets, 'asset');
        _parse(mt.data.objects, 'object');
        return true;
    };

    /**
     * parse regular template obhect
     * @param {Object} object
     * @param {String} flag   asset/object
     * @returns {Object}
     */
    this.parse = function (object, flag) {
        _parse(object, flag);
        return object;
    };


    /**
     * Get action from button or clickableArea properties
     * @param props - properties for the object
     * @returns {string} - result action
     * @private
     */
    var _getAction = function (props) {
        var action = '';
        var buttonsCfg = nge.App.getInstance('Com.Buttons.Cfg');

        if (props.screenGoTo) {
            var layerName = props.screenGoTo.split(' ')[0];
            action += "nge.observer.fire('layersSwitcher.show', '" + layerName + "');";
        }

        if (!buttonsCfg)
            return action;

        var stateName = nge.statesManager.getCurrentName();

        var buttonsParams = (buttonsCfg[stateName]) ? buttonsCfg[stateName] : buttonsCfg.params;

        var buttonKey = nge.Lib.Helper.objFind(buttonsParams, function (element) {
            return props.name === element.name + 'Button';
        });

        if (buttonKey)
            action += "nge.observer.fire('buttons.pressCommand', '" + buttonKey + "');";
        else if (nge.Lib.Helper.objFind(buttonsParams, function (element) {
            return props.class === element.class;
        }))
            action += "nge.observer.fire('buttons.pressCommand', '" + props.class + "');";

        return action;
    };

    var _applyAliasAndGetNamePattern = function (obj, flag) {
        var objKey = false;

        switch (flag) {
            case 'asset':
                objKey = 'key';
                break;
            case 'object':
                objKey = 'name';
                break;
        }

        if (_patternsAliases && _patternsAliases[obj[objKey]]) {
            if (typeof _patternsAliases[obj[objKey]] === 'object') {
                if (flag === 'object') {
                    for (var k in _patternsAliases[obj[objKey]])
                        obj[k] = _patternsAliases[obj[objKey]][k];
                }
            } else {
                obj[objKey] = _patternsAliases[obj[objKey]];
            }
        }


        return obj[objKey];
    };

    var _parse = function (parent, flag) {
        if (!_defaultsDone)
            _checkDefaults();

        var children = parent.contents;
        var newChildren = [];

        //update aliases at first
        var aliasesClass = nge.App.getInstance('Tpl.PsdAliases');
        _patternsAliases = (aliasesClass && aliasesClass.data) ? aliasesClass.data : null;

        for (var i = 0; i < children.length; i++) {
            var obj = children[i];

            if (!obj._mtParsed) {
                if(obj.x !== undefined)
                    obj.x = _propToType('x', obj.x);
                if(obj.y !== undefined)
                    obj.y = _propToType('y', obj.y);
                var pattern = _applyAliasAndGetNamePattern(obj, flag);

                if (pattern) {
                    var suffix = nge.Lib.Helper.getSuffix(pattern);

                    switch (suffix) {
                        case 'image':
                            obj = _parseImage(obj, flag);
                            break;
                        case 'group':
                            obj = _parseGroup(obj, flag);
                            break;
                        case 'asset':
                            obj = _parseAsset(obj, flag);
                            break;
                        case 'text':
                            obj = _parseText(obj, flag);
                            break;
                        case 'bitmapText':
                            obj = _parseBitmapText(obj, flag);
                            break;
                        case 'nineSlice':
                            obj = _parseNineSlice(obj, flag);
                            break;
                        case 'clickableArea':
                            obj = _parseClickableArea(obj, flag);
                            break;
                        case 'button':
                            obj = _parseButton(obj, flag);
                            break;
                        case 'radioButton':
                            obj = _parseRadioButton(obj, flag);
                            break;
                        case 'container':
                            obj = _parseContainer(obj, flag);
                            break;
                        case 'cover':
                            obj = _parseImageCover(obj, flag);
                            break;
                        case 'spritesheet':
                        case 'handle':
                            obj = _parseSpritesheet(obj, flag);
                            break;
                        case 'style':
                            obj = _parseStyle(obj, flag);
                            break;
                        case 'spine':
                            obj = _parseSpine(obj, flag);
                            break;
                        case 'slider':
                        case 'sliderAdvanced':
                            obj = _parseSlider(obj, flag);
                            break;
                        case 'coordinates':
                            obj = _parseCoordinates(obj, flag);
                            break;
                    }
                }
            }

            if (obj) {
                //container?
                if (obj.contents)
                    _parse(obj, flag);

                //parsed flag
                obj._mtParsed = true;
                newChildren.push(obj);
            }
        }

        parent.contents = newChildren;
        return true;
    };

    var _checkDefaults = function () {
        if (!nge.wrap.cache.hasTexture('areaEmpty')) {
            nge.wrap.load.addTexture('areaEmpty', nge.Lib.Helper.create1PxPng(125, 125, 125, 255, true));
        }

        _defaultsDone = true;
    };

    var _parseGroup = function (obj, flag) {
        if (flag === 'asset') {
            var props = _getPropsFromTemplate(obj.key);

            //add styles
            if (nge.tpl.group(props.name).styles)
                window.mt.data.styles = nge.Lib.Helper.objectApply(
                    window.mt.data.styles,
                    nge.tpl.group(props.name).styles
                    );

            return nge.Mlm.Assets.Folder({
                name: props.name,
                contents: nge.tpl.group(props.name).assets.contents
            });
        }

        if (flag === 'object') {
            var props = _getPropsFromTemplate(obj.name);
            return nge.Mlm.Objects.Folder({
                name: props.name,
                contents: nge.tpl.group(props.name).objects.contents
            });
        }
    };

    var _parseStyle = function (obj, flag) {
        if (flag === 'asset') {
            var props = _getPropsFromTemplate(obj.key);
            var style = _applyProps(props, {});

            delete style.name;
            var name = '.' + props.name;

            mt.data.styles[name] = style;
            return false;
        }

        if (flag === 'object')
            return false;
    };

    var _parseSpine = function (obj, flag) {
        if (flag === 'asset') {
            var props = _getPropsFromTemplate(obj.key);
            var name = props.name;
            return {key: 'spine_' + props.name, spine: nge.appPath + 'img/spine' + "/" + name + "/" + name + ".json"};
        }

        if (flag === 'object') {
            var props = _getPropsFromTemplate(obj.name);
            props.type = 6;
            props.assetKey = 'spine_' + props.name;

            if (props.auto) {
                var repeat = props.repeat ? true : false;
                _addOnCreateCallback(function () {
                    nge.findOne('^' + props.name).setAnimationByName(0, props.auto, repeat);
                });
            }

            return _applyProps(props, obj);
        }

    };

    var _parseSlider = function (obj, flag) {
        if (flag === 'asset') {
            //it cannot be, cause slider is a container
            return true;  //we must return true to parse slider contents assets
        }

        var sliderTypes = {
            'slider': {
                type: 8,
                obj: nge.Mlm.Objects.Slider
            },
            'sliderAdvanced': {
                type: 11,
                obj: nge.Mlm.Objects.SliderAdvanced
            }
        };

        var suff = nge.Lib.Helper.getSuffix(obj.name);
        var sliderType = sliderTypes[suff];

        var props = _getPropsFromTemplate(obj.name);
        props.type = sliderType.type;

        for (var k in obj.contents) {
            var o = obj.contents[k];
            if(o.x !== undefined)
                o.x = _propToType('x', o.x);
            if(o.y !== undefined)
                o.y = _propToType('y', o.y);

            var suffix = nge.Lib.Helper.getSuffix(o.name);

            switch (suffix) {
                case 'bg':
                    props.x = parseInt(o.x);
                    props.y = parseInt(o.y);
                    props.bgAssetKey = o.assetKey;
                    break;
                case 'fill':
                    props.fillAssetKey = o.assetKey;
                    break;
                case 'handle':
                    props.handleAssetKey = o.assetKey;
                    break;
                case 'value':
                    props.valueText = _parseText(o, 'object');
                    break;
                case 'tooltip':
                    props.tooltipBg = _parseImage(o, 'object');
                    break;
                case 'text':
                    props.tooltipText = _parseText(o, false);
                    break;
            }
        }

        return sliderType.obj(props);
    };

    var _parseCoordinates = function (obj, flag) {
        if (flag === 'asset') {
            return false;
        }

        nge.localData.set('coordinates.' + obj.name.split('_')[0], {x: obj.x, y: obj.y});
    };

    var _parseImage = function (obj, flag) {
        if (flag === 'asset')
            return obj;

        if (flag === 'object') {
            var props = _getPropsFromTemplate(obj.name);
            props.assetKey = obj.assetKey;
            return _applyProps(props, obj);
        }
    };

    var _parseAsset = function (obj, flag) {
        if (flag === 'asset') {
            obj.key = nge.Lib.Helper.strReplace('_asset', '', obj.key);
            return obj;
        } else
            return false;
    };

    var _parseContainer = function (obj, flag) {
        if (flag === 'asset')
            return false;

        var props = _getPropsFromTemplate(obj.name);
        props.type = 1;
        props.name += 'Container';
        if(props.x !== undefined)
            props.x = _propToType('x', props.x);
        if(props.y !== undefined)
            props.y = _propToType('y', props.y);
        if (typeof props.swipe === 'string')
            props.swipe = +props.swipe;

        return _applyProps(props, obj);
    };

    var _parseSpritesheet = function (obj, flag) {
        if (flag === 'asset') {
            return _parseSpritesheetAsset(obj);
        }

        if (flag === 'object') {
            var props = _getPropsFromTemplate(obj.name);
            props.assetKey = obj.assetKey;
            return _applyProps(props, obj);
        }
    };

    var _parseImageCover = function (obj, flag) {
        if (flag === 'asset')
            return false;

        var props = _getPropsFromTemplate(obj.name);

        var hex = props.color || '000000';
        if (!nge.wrap.cache.hasTexture('cover' + hex)) {
            var rgb = nge.Lib.Helper.hexToRgb(hex);
            nge.wrap.load.addTexture('cover' + hex, nge.Lib.Helper.create1PxPng(rgb.r, rgb.g, rgb.b, 255, true));
        }

        props.inputEnabled = true;

        props.assetKey = 'cover' + hex;
        obj = _applyProps(props, obj);
        obj.class = (obj.class) ? obj.class + ' cover' : 'cover';

        return obj;
    };

    var _processColoredText = function (obj) {
        var text = nge.i18n.get(obj.text);
        var _tempText = text.slice(0, text.length);

        while (_tempText.indexOf('\n') !== - 1)
            _tempText = _tempText.replace('\n', ' ');

        var colors = text.match(/\#.+?\)/g);
        var colorsInfo = text.match(/\(color.+?\)/g);

        if (!colors || !colorsInfo)
            return;

        for (var i = 0; i < colorsInfo.length; i++) {
            obj.addColor(colors[i].replace(')', ''), _tempText.indexOf(colorsInfo[i]));
            _tempText = _tempText.replace(colorsInfo[i], '');
            text = text.replace(colorsInfo[i], '');
        }

        obj.text = text;
    };

    var _parseText = function (obj, flag) {
        if (flag === 'asset')
            return false;

        var props = _getPropsFromTemplate(obj.name);
        props.type = 2;

        //wordWrap
        if (props.wordWrap && !props.wordWrapWidth)
            console.error('mt.psd.dataParser error: text wordWrap policy in ', obj);

        if (!props.wordWrapWidth)
            props.wordWrapWidth = nge.wrap.states.width;

        if (props.strokeThickness && props.fill && !props.stroke)
            props.stroke = props.fill;

        var hasColoredText = !!props.class && props.class.split(' ').indexOf('coloredText') !== -1;
        var hasShadow = !!props.shadowColor && !!props.shadowBlur;

        if (hasColoredText || hasShadow) {
            _addOnCreateCallback(function () {
                var objText = nge.findOne('^' + props.name);

                if (hasColoredText)
                    _processColoredText(objText);

                if (hasShadow) {
                    objText.style.shadowColor = props.shadowColor;
                    objText.style.shadowBlur = props.shadowBlur;
                    objText.style.shadowStroke = true;
                }
            });
        }

        return _applyProps(props, obj);
    };

    var _parseNineSlice = function (obj, flag) {
        if (flag === 'asset')
            return false;

        var props = _getPropsFromTemplate(obj.name);
        props.type = 9;
        return _applyProps(props, obj);
    };

    var _parseBitmapText = function (obj, flag) {
        if (flag === 'asset')
            return false;

        var props = _getPropsFromTemplate(obj.name);
        props.type = 7;

        return _applyProps(props, obj);
    };

    var _parseClickableArea = function (obj, flag) {
        if (flag === 'asset')
            return false;

        var props = _getPropsFromTemplate(obj.name);
        props.assetKey = 'areaEmpty';
        props.scaleX = props.width;
        props.scaleY = props.height;
        props.alpha = 0;
        props.pixelPerfect = 0;
        props.type = 4;
        props.action = 'function(){' + _getAction(props) + '}';

        return _applyProps(props, obj);
    };

    var _parseButton = function (obj, flag) {
        switch (flag) {
            case 'asset':
                return _parseSpritesheetAsset(obj);
                break;
            case 'object':
                return _parseButtonObject(obj);
                break;
        }
    };

    var _parseRadioButton = function (obj, flag) {
        switch (flag) {
            case 'asset':
                return _parseSpritesheetAsset(obj);
                break;
            case 'object':
                return _parseRadioButtonObject(obj);
                break;
        }
    };

    var _parseSpritesheetAsset = function (asset) {
        const props = _getPropsFromTemplate(asset.key);
        const filename = _.last(asset.fullPath.split('/'));
        const atlasName = nge.assets.getAtlasForTexture(filename);

        if (!atlasName)
            return false;

        const atlas = nge.wrap.cache.getAtlas(atlasName);
        const frame = atlas.data.frames[filename].frame;

        var qf = nge.assets.getQualityFactor();

        asset.width = frame.w / qf;
        if (props.spritesX && props.spritesX > 1) {

            asset.frameWidth = (frame.w / props.spritesX) / qf;
        }

        asset.height = frame.h / qf;
        if (props.spritesY && props.spritesY > 1) {

            asset.frameHeight = (frame.h / props.spritesY) / qf;
        }

        return asset;
    };

    var _parseButtonObject = function (obj) {
        var props = _getPropsFromTemplate(obj.name);
        props.type = 4;
        props.assetKey = obj.assetKey;
        props.pixelPerfect = (obj.pixelPerfect) ? true : false;
        props.action = 'function(){' + _getAction(props) + '}';
        props.btnFrames = {'over': 2, 'out': 1, 'down': 0};

        return _applyProps(props, obj);
    };

    var _parseRadioButtonObject = function (obj) {
        var props = _getPropsFromTemplate(obj.name);
        props.type = mt.objects.RADIO_BUTTON;
        props.assetKey = obj.assetKey;
        props.pixelPerfect = (obj.pixelPerfect) ? true : false;
        props.action = 'function(){' + _getAction(props) + '}';
        props.btnFrames = {'over': 0, 'out': 0, 'down': 0};

        return _applyProps(props, obj);
    };

    var _applyProps = function (props, obj) {
        delete obj.assetKey;

        for (var k in _keysAliases) {
            var prop = _keysAliases[k];

            if (typeof props[prop] !== 'undefined')
                nge.Lib.Helper.recursiveSet(k, props[prop], obj);
        }

        return obj;
    };

    var _getPropsFromTemplate = function (template) {
        var props = {};

        if (template.indexOf('(') === -1) {
            // name_flag
            props.name = template.split('_')[0];
        } else {
            // name(props)_flag
            var params = template.match(/\(([^\}]*)\)/)[1];
            params.replace(/([^\s*=,]+)=([\w\s.\\\/#,-:%&?()/\[|\]'"+!]*)(?:,\s|$)/g, function (nonUse, a, b) {
                props[a] = _propToType(a, b);
            });

            props.name = template.split('(')[0];
        }

        return props;
    };

    var _propToType = function (k, v) {
        var excludes = ['text'];

        if (excludes.indexOf(k) !== -1)
            return v;

        //special gradient parsing
        if (k === 'gradient' && nge.Lib.Helper.isTextJson(v))
            return JSON.parse(v);

        //check numbers in strings
        if (_.isString(v) && nge.Lib.Helper.isNumeric(v))
            return parseFloat(v);

        //just usual value
        return v;
    };

    var _addOnCreateCallback = function (callback) {
        var stateName = nge.statesManager.getCurrentName();

        if (!_onCreateCallbacks[stateName])
            _onCreateCallbacks[stateName] = [];

        _onCreateCallbacks[stateName].push(callback);

        if (!_subscribed)
            _subscribe();
    };

    var _checkCreateCallbacks = function () {
        var stateName = nge.statesManager.getCurrentName();

        if (_onCreateCallbacks[stateName])
            for (var i = 0; i < _onCreateCallbacks[stateName].length; i++)
                _onCreateCallbacks[stateName][i]();
    };

    var _subscribe = function () {
        nge.observer.add('StatesManager.create.end', _checkCreateCallbacks, false, true);
        _subscribed = true;
    };

    var _keysAliases = {
        'x': 'x',
        'y': 'y',
        'type': 'type',
        'name': 'name',
        'class': 'class',
        'text': 'text',
        'size': 'size',
        'tabs': 'tabs',
        'tabActive.tab': 'tabActiveHeader',
        'tabActive.container': 'tabActiveContainer',
        'groupName': 'groupName',
        'selection': 'selection',
        'assetKey': 'assetKey',
        'action': 'action',
        'btnFrames': 'btnFrames',
        'anchorX': 'anchorX',
        'anchorY': 'anchorY',
        'lineSpacing': 'lineSpacing',
        'style.lineHeight': 'lineHeight',
        'style.align': 'align',
        'style.font': 'font',
        'style.lineJoin': 'lineJoin',
        'style.fill': 'fill',
        'style.wordWrap': 'wordWrap',
        'style.wordWrapWidth': 'wordWrapWidth',
        'style.shadowOffsetX': 'shadowOffsetX',
        'style.shadowOffsetY': 'shadowOffsetY',
        'style.stroke': 'stroke',
        'style.strokeThickness': 'strokeThickness',
        'style.shadowColor': 'shadowColor',
        'style.shadowBlur': 'shadowBlur',
        'style.padding': 'padding',
        'gradient': 'gradient',
        'maxWidth': 'maxWidth',
        'maxHeight': 'maxHeight',
        'pixelPerfectOver': 'pixelPerfect',
        'pixelPerfectClick': 'pixelPerfect',
        'inputEnabled': 'inputEnabled',
        'width': 'width',
        'height': 'height',
        'top': 'top',
        'bottom': 'bottom',
        'left': 'left',
        'right': 'right',
        'alpha': 'alpha',
        'scaleX': 'scaleX',
        'scaleY': 'scaleY',
        'offsetX': 'offsetX',
        'offsetY': 'offsetY',
        'color': 'color',
        'scroll': 'scroll',
        'swipe': 'swipe',
        'rewParams.dragScrollSensivity': 'dragScrollSensivity',
        'rewParams.tuneTime': 'tuneTime',
        'rewParams.tuneDelay': 'tuneDelay'
    };
}();



/*
	ExtendJS 0.2.3
	More info at http://extendjs.org
*/
(function () {
    
    //Helper method for creating an super copied object clone
    function initialize(method) {
        //Recursivly execute parent methods.
        if (method.parent instanceof Function) {
            initialize.apply(this, [method.parent]);
            this.super = cloneCopy(this,
                superCopy(this, this.constructor)
            );
        }
        method.apply(this, arguments);
    }

    //Helper method which allows for super referances.
    function cloneCopy(from, to) {
        for (var x in from) {
            if (
                x !== 'super' && //Never clone the super referance
                from[x] instanceof Function && //Only overwrite functions
                !(from[x].prototype instanceof Class) //Never overwrite referances to classes
            ) {
                //Never create circular super referances.
                to[x] = from[x].super || superCopy(from, from[x]);
            }
        }
        return to;
    }

    function superCopy(scope, method) {
        var scopeSuper = scope.super;
        return method.super = function () {
            var oldScope = scope.super;
            scope.super = scopeSuper;
            var methodReturn = method.apply(scope, arguments);
            scope.super = oldScope;
            return methodReturn;
        };
    }

    //Create Class object
    Class = function () { };
    Class.extend = function ext(to) {
        function child() {
            //Prevent the prototype scope set executing the constructor.
            if (initialize !== arguments[0]) {
                //Create inhereted object
                initialize.apply(this, [to]);
                //Setup scope for class instance method calls
                cloneCopy(this, this);
                if (this.initializer instanceof Function)
                    this.initializer.apply(this);
                this.constructor.apply(this, arguments);
            }
        }

        //Set prototype and constructor enabeling propper type checking.
        child.prototype = new this(initialize);
        child.prototype.constructor = child;

        //Return expected result from toString
        child.toString = function () {
            return to.toString();
        };

        //Allow the child to be extended.
        child.extend = function (target) {
            //Create parent referance and inherentence path.
            target.parent = to;
            return ext.apply(child, arguments);
        };

        return child;
    };
    //Bootstrap Class by inheriting itself with empty constructor.
    Class = Class.extend(function () {
        this.constructor = function () { };
    });
})();



/*jslint bitwise:true, plusplus: true */
/*global Base64: false*/
(function (globalObj) {
	'use strict';

	// 0x78, 7 = 2^(7+8) = 32768 window size (CMF)
	//       8 = deflate compression
	// 0x01, (00 0 00001) (FLG)
	// bits 0 to 4  FCHECK  (check bits for CMF and FLG)
	// bit  5       FDICT   (preset dictionary)
	// bits 6 to 7  FLEVEL  (compression level)

	var DEFLATE_METHOD = String.fromCharCode(0x78, 0x01),
		CRC_TABLE = [],
		SIGNATURE = String.fromCharCode(137, 80, 78, 71, 13, 10, 26, 10),
		NO_FILTER = String.fromCharCode(0),

		make_crc_table = function () {
			var n, c, k;

			for (n = 0; n < 256; n++) {
				c = n;
				for (k = 0; k < 8; k++) {
					if (c & 1) {
						c = 0xedb88320 ^ (c >>> 1);
					} else {
						c = c >>> 1;
					}
				}
				CRC_TABLE[n] = c;
			}
		},

		inflateStore = function (data) {
			var MAX_STORE_LENGTH = 65535,
				storeBuffer = '',
				i,
				remaining,
				blockType;

			for (i = 0; i < data.length; i += MAX_STORE_LENGTH) {
				remaining = data.length - i;
				blockType = '';

				if (remaining <= MAX_STORE_LENGTH) {
					blockType = String.fromCharCode(0x01);
				} else {
					remaining = MAX_STORE_LENGTH;
					blockType = String.fromCharCode(0x00);
				}
				// little-endian
				storeBuffer += blockType + String.fromCharCode((remaining & 0xFF), (remaining & 0xFF00) >>> 8);
				storeBuffer += String.fromCharCode(((~remaining) & 0xFF), ((~remaining) & 0xFF00) >>> 8);

				storeBuffer += data.substring(i, i + remaining);
			}

			return storeBuffer;
		},

		adler32 = function (data) {
			var MOD_ADLER = 65521,
				a = 1,
				b = 0,
				i;

			for (i = 0; i < data.length; i++) {
				a = (a + data.charCodeAt(i)) % MOD_ADLER;
				b = (b + a) % MOD_ADLER;
			}

			return (b << 16) | a;
		},

		update_crc = function (crc, buf) {
			var c = crc, n, b;

			for (n = 0; n < buf.length; n++) {
				b = buf.charCodeAt(n);
				c = CRC_TABLE[(c ^ b) & 0xff] ^ (c >>> 8);
			}
			return c;
		},

		crc = function crc(buf) {
			return update_crc(0xffffffff, buf) ^ 0xffffffff;
		},

		dwordAsString = function (dword) {
			return String.fromCharCode((dword & 0xFF000000) >>> 24, (dword & 0x00FF0000) >>> 16, (dword & 0x0000FF00) >>> 8, (dword & 0x000000FF));
		},

		createChunk = function (length, type, data) {
			var CRC = crc(type + data);

			return dwordAsString(length) +
				type +
				data +
				dwordAsString(CRC);
		},

		IEND,

		createIHDR = function (width, height) {
			var IHDRdata;

			IHDRdata = dwordAsString(width);
			IHDRdata += dwordAsString(height);

			// bit depth
			IHDRdata += String.fromCharCode(8);
			// color type: 6=truecolor with alpha
			IHDRdata += String.fromCharCode(6);
			// compression method: 0=deflate, only allowed value
			IHDRdata += String.fromCharCode(0);
			// filtering: 0=adaptive, only allowed value
			IHDRdata += String.fromCharCode(0);
			// interlacing: 0=none
			IHDRdata += String.fromCharCode(0);

			return createChunk(13, 'IHDR', IHDRdata);
		},

		png = function (width, height, rgba) {
			var IHDR = createIHDR(width, height),
				IDAT,
				scanlines = '',
				scanline,
				y,
				x,
				compressedScanlines;

			for (y = 0; y < rgba.length; y += width * 4) {
				scanline = NO_FILTER;
				if (Array.isArray(rgba)) {
					for (x = 0; x < width * 4; x++) {
						scanline += String.fromCharCode(rgba[y + x] & 0xff);
					}
				} else {
					// rgba=string
					scanline += rgba.substr(y, width * 4);
				}
				scanlines += scanline;
			}

			compressedScanlines = DEFLATE_METHOD + inflateStore(scanlines) + dwordAsString(adler32(scanlines));

			IDAT = createChunk(compressedScanlines.length, 'IDAT', compressedScanlines);

			return SIGNATURE + IHDR + IDAT + IEND;
		};

	make_crc_table();
	IEND = createChunk(0, 'IEND', '');

	globalObj.generatePng = png;
}(nge));



nge.NoSleep = class NoSleep {
    constructor() {
        this.webm = 'data:video/webm;base64,GkXfo0AgQoaBAUL3gQFC8oEEQvOBCEKCQAR3ZWJtQoeBAkKFgQIYU4BnQI0VSalmQCgq17FAAw9CQE2AQAZ3aGFtbXlXQUAGd2hhbW15RIlACECPQAAAAAAAFlSua0AxrkAu14EBY8WBAZyBACK1nEADdW5khkAFVl9WUDglhohAA1ZQOIOBAeBABrCBCLqBCB9DtnVAIueBAKNAHIEAAIAwAQCdASoIAAgAAUAmJaQAA3AA/vz0AAA=';
        this.mp4 = 'data:video/mp4;base64,';

        this.oldIOS = typeof navigator !== 'undefined' && parseFloat(
            ('' + (/CPU.*OS ([0-9_]{3,4})[0-9_]{0,1}|(CPU like).*AppleWebKit.*Mobile/i.exec(navigator.userAgent) || [0, ''])[1])
                .replace('undefined', '3_2').replace('_', '.').replace('_', '')
        ) < 10 && !window.MSStream;

        if (this.oldIOS) {
            this.noSleepTimer = null;
        } else {
            // Set up no sleep video element
            this.noSleepVideo = document.createElement('video');

            this.noSleepVideo.setAttribute('muted', '');
            this.noSleepVideo.setAttribute('title', 'No Sleep');
            this.noSleepVideo.setAttribute('playsinline', '');

            this._addSourceToVideo(this.noSleepVideo, 'webm', this.webm);
            this._addSourceToVideo(this.noSleepVideo, 'mp4', this.mp4);

            this.noSleepVideo.addEventListener('loadedmetadata', () => {
                if (this.noSleepVideo.duration <= 1) { // webm source
                    this.noSleepVideo.setAttribute('loop', '');
                } else { // mp4 source
                    this.noSleepVideo.addEventListener('timeupdate', () => {
                        if (this.noSleepVideo.currentTime > 0.5) {
                            this.noSleepVideo.currentTime = Math.random();
                        }
                    });
                }
            });
        }
    }

    _addSourceToVideo(element, type, dataURI) {
        var source = document.createElement('source');
        source.src = dataURI;
        source.type = `video/${type}`;
        element.appendChild(source);
    }

    enable() {
        if (this.oldIOS) {
            this.disable();
            console.warn(`
        NoSleep enabled for older iOS devices. This can interrupt
        active or long-running network requests from completing successfully.
        See https://github.com/richtr/NoSleep.js/issues/15 for more details.
      `);
            this.noSleepTimer = window.setInterval(() => {
                if (!document.hidden) {
                    window.location.href = window.location.href.split('#')[0];
                    window.setTimeout(window.stop, 0);
                }
            }, 15000);
        } else {
            this.noSleepVideo.play();
        }
    }

    disable() {
        if (this.oldIOS) {
            if (this.noSleepTimer) {
                console.warn(`
          NoSleep now disabled for older iOS devices.
        `);
                window.clearInterval(this.noSleepTimer);
                this.noSleepTimer = null;
            }
        } else {
            this.noSleepVideo.pause();
        }
    }
};




nge.NoSleepAndroid = function () {
    var oldIOS = typeof navigator !== 'undefined' && parseFloat(('' + (/CPU.*OS ([0-9_]{3,4})[0-9_]{0,1}|(CPU like).*AppleWebKit.*Mobile/i.exec(navigator.userAgent) || [0, ''])[1]).replace('undefined', '3_2').replace('_', '.').replace('_', '')) < 10 && !window.MSStream;
    var data = 'data:video/mp4;base64,';
    
    if(!oldIOS) {
        
        
        this.noSleepVideo = document.createElement('video');
        this.noSleepVideo.setAttribute('loop',  true);
        this.noSleepVideo.setAttribute('playsinline', '');
        this.noSleepVideo.setAttribute('src', data);
        this.noSleepVideo.addEventListener('error', function (e) {
            console.log('noSleepVideo error');
        }.bind(this));
        this.noSleepVideo.addEventListener('ended', function (e) {
            console.log('noSleepVideo ended');
        }.bind(this));
        this.noSleepVideo.addEventListener('pause', function (e) {
            console.log('noSleepVideo pause');
        }.bind(this));
        this.noSleepVideo.addEventListener('abort', function (e) {
            console.log('noSleepVideo aborted');
        }.bind(this));
    }
    else
        this.noSleepTimer = null;

    this.enable = function() {
        if(!oldIOS)
            return this.noSleepVideo.play();

        this.disable();
        this.noSleepTimer = window.setInterval(function () {
            if(document.visibilityState!=="visible") return false;
            window.location.href = '/';
            window.setTimeout(window.stop, 0);
        }, 15000);
    }.bind(this);

    this.disable = function() {
        if(!oldIOS)
            return this.noSleepVideo.pause();

        if (this.noSleepTimer) {
            window.clearInterval(this.noSleepTimer);
            this.noSleepTimer = null;
        }
    }.bind(this);

    return this;
};



nge.App = {};



nge.App.Run = function () {

    /**
     * engine run
     * @returns {Boolean}
     */
    this.run = function () {
        if (nge.Cfg.Main.mode === 'testing')
            return _createGlobalFunctions();

        //***CORE***
        //i18n
        nge.Cfg.Main.lang = nge.Lib.Helper.parseGetParams('lang') || nge.Cfg.Main.lang;
        nge.i18n = new nge.Lib.I18n(nge.Cfg.Main.project);

        nge.observer = new nge.Lib.Observer();
        nge.tween = new nge.Mlm.TweenManager.Controller();
        nge.localData = new nge.Mlm.LocalData.Controller();
        nge.statesManager = new nge.Mlm.StatesManager.Controller();
        nge.tpl = new nge.Mlm.Tpl.Controller();
        nge.assets = new nge.Mlm.Assets.Controller();

        nge.objects = new nge.Mlm.Objects.Controller();
        nge.objects.init();

        //Lib.Device
        nge.device = nge.Lib.Device;

        _createGlobalFunctions();
        _setInstancesModes();

        var appRunClass = nge.App.getInstance('Run', true);

        //SoundManager
        nge.soundManager = new nge.Mlm.SoundManager.Controller();
        nge.soundManager.init();

        //transport
        nge.transport = new nge.Mlm.Transport.Controller();
        nge.transport.init();

        //Keyboard
        nge.keyboard = new nge.Lib.Keyboard();

        //resolutionsManager
        nge.resolutionsManager = new nge.Mlm.ResolutionsManager.Controller();
        nge.resolutionsManager.init();

        //animator
        nge.animator = new nge.Mlm.Animator.Controller();
        nge.animator.init();

        //assets init
        nge.assets.init();

        //brain
        nge.brain = nge.App.getInstance('Mlm.Brain.Controller');
        nge.brain.init();

        //cheatsManager
        nge.cheatsManager = nge.App.getInstance('Mlm.CheatsManager.Controller');
        nge.cheatsManager.init();

        //outer api
        nge.api = new nge.Lib.Api();

        //resize event
        var resizeId;
        var windowResizeEVT = function () {
            resizeId = setTimeout(function () {
                clearTimeout(resizeId);
                nge.observer.fire('window.resize');
            }, 1); //TODO check. was 500ms
        };
        nge.game.scale.onFullScreenChange.add(windowResizeEVT);
        $(window).resize(windowResizeEVT);
        $(window).on('orientationchange', windowResizeEVT);

        //visibilitychange
        document.addEventListener("visibilitychange", function () {
            nge.observer.fire('window.visibilitychange', document.visibilityState);
        });

        nge.userInfoHTML('run game');

        nge.spine.Plugin.init();

        //setTimeout if no RAF      //autospins continue
        var forceNeed = (!nge.Cfg.Main.mobile && !nge.Cfg.Main.forceUpdate);
        if (forceNeed)
            nge.observer.add('window.visibilitychange', nge.phaserAdapter.forcePC, false, true);

        _noSleep();
        _setDefaultStates();
        _setVersion();
        _appRun(appRunClass);

        return true;
    };

    var _noSleep = function () {
        var mobile = nge.Lib.Helper.mobileAndTabletCheck();
        if (!mobile)
            return false;

        var noSleep;
        var osData = nge.Lib.Helper.getOsAndVersion();

        if (osData.os === 'Android')
            noSleep = new nge.NoSleepAndroid();
        else
            noSleep = new nge.NoSleep();

        var wakeLockEnabled = false;

        var enableNoSleep = function () {
            if (!wakeLockEnabled) {
                noSleep.enable(); // keep the screen on!
                wakeLockEnabled = true;
                document.removeEventListener('touchend', enableNoSleep, false);
            }
        };

        nge.observer.add(
            'StatesManager.create.end', function (state) {
                if (state !== 'demo' && state !== 'load') {
                    document.addEventListener('touchend', enableNoSleep, false);

                    nge.observer.remove('StatesManager.create.end', false, 'enableNoSleep', true);
                }
            },
            false,
            'enableNoSleep',
            true
            );
    };

    var _appRun = function (appRunClass) {
        if (appRunClass)
            appRunClass.run();
        else
            //next state
            nge.statesManager.display('load');
    };

    var _setDefaultStates = function () {
        //default states
        var states = {
            demo: ['demo'],
            load: ['load'],
            loadAssets: ['loadAssets'],
            play: ['play']
        };
        nge.localData.set('states', states);
    };

    var _createGlobalFunctions = function () {
        //find by selectors
        nge.find = nge.objects.find;
        nge.findAll = nge.objects.findAll;
        nge.findOne = nge.objects.findOne;

        //nge.rafSetTimeout
        var rafSetTimeout = new nge.Lib.RafSetTimeout();
        rafSetTimeout.init();
        nge.rafSetTimeoutLib = rafSetTimeout;
        nge.rafSetTimeout = rafSetTimeout.add;
        nge.rafClearTimeout = rafSetTimeout.clear;

        nge.App.getInstance = function (path, appOnlyFlag, params) {
            var callback = function (a) {
                if (typeof a !== "function") {
                    log('ERROR TYPE !!!');
                    log(path, a);
                }

                if (a._instance && a._instance.singleton)
                    return a._instance;

                var instance = new a(params);

                if (instance.singleton)
                    a._instance = instance;

                return instance;
            };

            return _sysGet({path: path, appOnly: appOnlyFlag, callback: callback});
        };

        //example nge.App.getPath('Com.comName.View');
        nge.App.getPath = function (path, appOnlyFlag, noModes, modeName) {
            var callback = function (a) {
                return a;
            };

            return _sysGet({path: path, appOnly: appOnlyFlag, callback: callback, noModes: noModes, modeName: modeName});
        };

        //InstancesModes
        nge.App.getSysInstancesModes = function () {
            return nge.localData.get('_sysInstancesModes') || [];
        };

        nge.App.addSysInstancesMode = function (m) {
            var modes = nge.App.getSysInstancesModes();

            if (modes.indexOf(m) !== -1)
                return false;

            modes.push(m);
            return nge.localData.set('_sysInstancesModes', modes);
        };

        nge.App.removeSysInstancesMode = function (m) {
            var modes = nge.App.getSysInstancesModes();
            var index = modes.indexOf(m);

            if (index === -1)
                return false;

            modes.splice(index, 1);
            return nge.localData.set('_sysInstancesModes', modes);
        };
    };

    var _setInstancesModes = function () {
        //mobile
        var mobile = nge.Lib.Helper.mobileAndTabletCheck();
        if (mobile)
            nge.App.addSysInstancesMode('mobile');

        log('_sysInstancesModes', nge.App.getSysInstancesModes());
    };

    var _sysGetModesCache = {modesString: false, combinations: false};
    var _sysPathesCache = {};

    /**
     * 
     * @param {object} params
     * {
     *  {String} path
     *  {Boolean} appOnly
     *  {function} callback
     *  {String} modeName
     *  {Boolean} noModes
     * }
     * @returns {mixed|Boolean}
     */
    var _sysGet = function (params) {
        var cacheKey = [
            params.path,
            params.appOnly || 'false',
            params.modeName || 'none',
            params.noModes || 'false'
        ].join('_');

        //check cache
        if (cacheKey in _sysPathesCache)
            return _sysPathesCache[cacheKey] ? params.callback(_sysPathesCache[cacheKey]) : false;

        _sysPathesCache[cacheKey] = false;

        var i = 0;
        var j = 0;
        var pathArr = params.path.split('.');
        var proj = nge.Lib.Helper.capitaliseFirstLetter(nge.Cfg.Main.project);
        var modes = nge.App.getSysInstancesModes();
        var arrayOfPatchesToCheck = [];

        var appPathArr = nge.Lib.Helper.mergeArrs(['nge', 'App', proj], pathArr);
        arrayOfPatchesToCheck.push(appPathArr);

        if (!params.appOnlyFlag) {
            var corePathArr = nge.Lib.Helper.mergeArrs(['nge'], pathArr);
            arrayOfPatchesToCheck.push(corePathArr);
        }

        var callback = function (path) {
            _sysPathesCache[cacheKey] = path;
            return params.callback(path);
        };

        var modes = nge.App.getSysInstancesModes();

        return nge.Lib.Checker.paths(arrayOfPatchesToCheck, callback, modes);
    };

    var _setVersion = function () {
        var cfg = nge.Cfg.Main;
        var title = cfg.title + ' v.' + cfg.version + ' - ' + cfg.gameVersion;
        nge.localData.set('version', cfg.version);
        document.title = title;
    };
};



nge.App.RunAppBase = Class.extend(function () {
    var _self;

    this.statesExtentions = false; // {play:[freespin, slotMachine]}; //addons
    this.statesReplacements = false; //{play:[freespin, slotMachine,...]}; //full list of com

    this.run = function () {
        _self = this;
        this.runDefault();
    };

    this.runDefault = function () {
        if (!_self)
            _self = this;

        _setStates();
        _startBaseState();
        nge.setStatisticsHandlers();

        return true;
    };

    var _setStates = function () {
        var statesKey = 'States' + nge.Lib.Helper.capitaliseFirstLetter(
            nge.Cfg.Main.gameType);

        var states = nge.Cfg[statesKey];

        if (_self.statesReplacements)
            states = nge.Lib.Helper.jsObjClone(_self.statesReplacements);

        if (_self.statesExtentions) {
            for (var k in _self.statesExtentions) {
                if (!states[k])
                    states[k] = _self.statesExtentions[k];
                else
                    states[k] = nge.Lib.Helper.mergeArrs(
                        states[k], _self.statesExtentions[k]);
            }
        }

        nge.localData.set('states', states);

        return true;
    };

    var _startBaseState = function () {
        var mode = nge.Lib.Helper.parseGetParams('mode') || nge.Cfg.Main.mode;

        if (mode === 'test')
            return false;
        if (mode === 'history')
            nge.statesManager.display('historyDataCollector');
        else
            //next state
            nge.statesManager.display('load');

        return true;
    };
});



nge.Com = {};



nge.Com.Base = Class.extend(function () {
    var _tplCash = {};

    this.preload = function () {
        this.preloadDefault();
    };

    this.create = function () {
        this.createDefault();
        this.animateDefault();
    };

    this.preloadDefault = function (tplName, params) {

        if (!tplName)
            tplName = 'Tpl';

        var tpl;
        if (typeof tplName === 'object') {
            tpl = tplName;
            tplName = 'Tpl';
        }

        var name = this.comName;
        var state = nge.statesManager.getCurrentName();

        if (!tpl)
            tpl = this.getInstance(tplName, false, params);

        _tplCash[tplName] = tpl;
        if (tpl) {
            //styles
            if (tpl.styles)
                window.mt.data.styles = nge.Lib.Helper.objectApply(
                    window.mt.data.styles, tpl.styles);

            //assets
            if (
                tpl.assets &&
                tpl.assets.contents &&
                tpl.assets.contents.length > 0 &&
                window.mt.data.assets.contents.filter(function (k) {
                    return k.name === name + 'Com' ? true : false;
                }).length === 0
                ) {
                window.mt.data.assets.contents.push({
                    "name": name + 'Com',
                    "contents": mt.tplsPathsPrepare(tpl.assets.contents)
                });
            }

            //objects
            if (
                tpl.objects &&
                tpl.objects.contents &&
                tpl.objects.contents.length > 0
                ) {
                var parent = window.mt.data.objects;
                var comPlace;
                var statePlace = mt.findItemInTemplate(
                    'name', state + 'State', mt.data.objects
                    );
                if (statePlace)
                    comPlace = mt.findItemInTemplate(
                        'name', name + 'Container', statePlace
                        );

                if (comPlace)
                    parent = comPlace;

                if (!parent.contents)
                    parent.contents = [];


                //chk alredy created
                if (mt.findItemInTemplate(
                    'name', name + 'Com', parent
                    ))
                    return false;

                parent['contents'].push({
                    type: mt.objects.GROUP,
                    "id": name + 'Com',
                    "name": name + 'Com',
                    "contents": mt.tplsPathsPrepare(tpl.objects.contents)
                });
            }
        }
    };

    this.createDefault = function (tplName) {
        if (!tplName)
            tplName = 'Tpl';

        var name = this.comName;

        var res = mt.findItemInTemplate(
            'name', name + 'Com', mt.data.objects
            );

        if (!res)
            return false;

        var tpl = _tplCash[tplName];
        if (
            tpl &&
            tpl.objects &&
            tpl.objects.contents &&
            tpl.objects.contents.length > 0
            ) {

            var state = nge.statesManager.getCurrentName();
            var statePlace = mt.findItemInTemplate(
                'name', state + 'State', mt.data.objects
                );

            var statePlace = mt.findItemInTemplate(
                'name', state + 'State', mt.data.objects
                );
            if (statePlace)
                var comPlace = mt.findItemInTemplate(
                    'name', name + 'Container', statePlace
                    );

            if (!comPlace)
                nge.objects.create(name + 'Com');
        }
    };

    this.animateDefault = function () {
        var animator = this.getInstance('Animator');
        var animatorNeed = true; //todo
        if (animatorNeed && animator && animator.firstCreation) {

            var promisesArr = nge.localData.get(
                'Com.Base.animateDefault.promisesArr');
            var isset = true;
            if (!promisesArr) {
                isset = false;
                promisesArr = [];

            }

            //create dfd
            var dfd = new $.Deferred();
            promisesArr.push(dfd.promise());

            //только что созданный массив
            if (!isset) {
                nge.observer.fire('Com.Base.animateDefault.start');
                nge.localData.set(
                    'Com.Base.animateDefault.promisesArr', promisesArr);
                $.when.apply($, promisesArr).done(function () {
                    _animateCallback();
                });
            }

            animator.firstCreation(function () {
                dfd.resolve();
            });
        }
    };

    var _animateCallback = function () {
        nge.localData.set(
            'Com.Base.animateDefault.promisesArr', null);

        nge.observer.fire('Com.Base.animateDefault.end');
    };

});



nge.Com.AutoSpinButton = {};



nge.Com.AutoSpinButton.Controller = nge.Com.Base.extend(function () {
    var _created;

    this.create = function () {
        this.createDefault();
        if (!_created)
            _subscribe();
        _created = true;
    };
    var _autoSpinButtonEnable = function () {
        var autoSpinInProgress = nge.localData.get('autospin.inProgress');
        var freeSpinInProgress = nge.localData.get('freespin.inProgress');
        var freeGameInProgress = nge.localData.get('freeGame.inProgress');
        var balanceNegative =
            (nge.localData.get('balance.totalAmount') < nge.localData.get('totalBet.value'));

        if (autoSpinInProgress || freeSpinInProgress || freeGameInProgress || balanceNegative) {
            return false;
        }
        var button = nge.find('^btn_autospin');
        button.enable();
        nge.find('^' + 'btn_autospin_text1').removeClass('disableText');
        nge.find('^' + 'btn_autospin_text2').removeClass('disableText');
    };

    var _autoSpinButtonDisable = function () {
        var button = nge.find('^btn_autospin');
        var autoSpinInProgress = nge.localData.get('autospin.inProgress');
        var freeSpinInProgress = nge.localData.get('freespin.inProgress');
        if (autoSpinInProgress) {
            button.disable(3);
            nge.find('^' + 'btn_autospin_text1').removeClass('disableText');
            nge.find('^' + 'btn_autospin_text2').removeClass('disableText');
        } else if (freeSpinInProgress) {
            button.disable(5);
            nge.find('^' + 'btn_autospin_text1').removeClass('disableText');
            nge.find('^' + 'btn_autospin_text2').removeClass('disableText');
        } else {
            button.disable(4);
            nge.find('^' + 'btn_autospin_text1').addClass('disableText');
            nge.find('^' + 'btn_autospin_text2').addClass('disableText');
        }
    };
    var _spinCompleteHandler = function () {
        _checkFreeGame();
        var linePickBonus = nge.localData.get('slotMachine.slotWin.linePickBonus');
        if (linePickBonus && linePickBonus.length > 0) {
            _autoSpinButtonDisable();
        }
    };

    var _checkFreeGame = function () {
        var autoSpinInProgress = nge.localData.get('autospin.inProgress');
        var freeSpinInProgress = nge.localData.get('freespin.inProgress');

        if (autoSpinInProgress || freeSpinInProgress)
            return false;

        var freeGameInProgress = nge.localData.get('freeGame.inProgress');
        var autospinTextContainer = nge.find('^autospinTextContainer');
        var autospinSpinsLeftText = nge.find('^autospinSpinsLeftText');

        if (freeGameInProgress && nge.localData.get('freeGame.amount') > 0) {
            autospinTextContainer.visible = false;
            autospinSpinsLeftText.text = nge.localData.get('freeGame.amount');
            autospinSpinsLeftText.alpha = 1;
        } else {
            autospinTextContainer.visible = true;
            autospinSpinsLeftText.alpha = 0;
            _autoSpinButtonEnable();
        }
    };

    var _subscribe = function () {
        nge.observer.add('autospinButton.enable', _autoSpinButtonEnable);
        nge.observer.add('autospinButton.disable', _autoSpinButtonDisable);
        nge.observer.add('slotMachine.spinComplete', _spinCompleteHandler);
        nge.observer.add('freeGames.show', _spinCompleteHandler);
    };
});



nge.Com.Autospin = {};



nge.Com.Autospin.Controller = nge.Com.Base.extend(function () {
    var _selectedColor = "white";
    var _defaultColor = "#26a5b8";
    var _checkBalance;
    var _created;
    var _self;
    var _linePickBonus;

    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        _self = this;
        this.createDefault();

        if (!_created) {
            _subscribe();
        }

        var autospinStopButton = nge.find('^stopButton');
        autospinStopButton.visible = false;
        nge.localData.set('autospin.stopRequest', false);
        if (nge.localData.get('autospin.paused')) {
            _autospinStart();
        }
        nge.localData.set('autospin.spins', 10);
        _created = true;
        return true;
    };

    this.show = function () {
        _show();
        return true;
    };

    var _show = function () {
        _makeOnTop();
        var popup = nge.find('^autospinPopupContainer');
        popup.visible = true;
        nge.observer.fire('autospin.opened');
        return true;
    };
    var _makeOnTop = function () {
        var playState = nge.find('^playState');
        var popupContainer = nge.find('^autospinContainer');
        playState.bringToTop(popupContainer);
    };

    var _close = function () {
        var popup = nge.find('^autospinPopupContainer');
        popup.visible = false;
        nge.observer.fire('autospin.closed');
        return true;
    };

    var _updateSpins = function (n) {
        for (var i = 10; i <= 50; i += 10) {
            var tab = nge.find("^autospinTabSpins_" + i);
            var text = nge.find("^tab_spins_text_" + i);

            if (i === n) {
                tab.disable(3);
                text.fill = _selectedColor;
            } else {
                tab.enable(1);
                text.fill = _defaultColor;
            }
        }
        nge.localData.set('autospin.spins', n);
    };

    var _updateCheckboxes = function (checkBoxIndex) {
        var state = nge.localData.get('autospin.checkbox_' + checkBoxIndex + '.checked');
        _switchCheckbox(!state, checkBoxIndex);
    };

    var _switchCheckbox = function (on, checkBoxIndex) {
        var check = nge.find("^autospinCheck_" + checkBoxIndex);
        var moneyButtonActive = nge.find("^autospinMoneyActive_" + checkBoxIndex);
        var moneyText = nge.find("^textMoney_" + checkBoxIndex);
        var moneyEuro = nge.find("^textEuro_" + checkBoxIndex);
        if (on) {
            nge.localData.set('autospin.checkbox_' + checkBoxIndex + '.checked', true);
            check.alpha = 1;
            if (moneyButtonActive) {
                moneyButtonActive.frame = 1;
                moneyButtonActive.input.enabled = true;
                moneyButtonActive._onDownFrame = 0;
                moneyButtonActive._onOutFrame = 1;
                moneyButtonActive._onOverFrame = 2;
                moneyEuro.fill = _selectedColor;
                moneyText.text = nge.localData.get('autospin.checkbox_' + checkBoxIndex + '.value');
                moneyText.alpha = 1;
            }
        } else {
            nge.localData.set('autospin.checkbox_' + checkBoxIndex + '.checked', false);
            check.alpha = 0;
            if (moneyButtonActive) {
                moneyButtonActive.frame = 3;
                moneyButtonActive.input.enabled = false;
                moneyEuro.fill = _defaultColor;
                moneyText.alpha = 0;
            }
        }
    };

    var _updateAll = function () {
        var spins = nge.localData.get('autospin.spins');
        _updateSpins(spins);
        for (var i = 0; i < 4; i++) {
            var state = nge.localData.get('autospin.checkbox_' + i + '.checked');
            _switchCheckbox(state, i);
        }
    };

    var _autospinStart = function () {
        if (nge.localData.get('autospin.paused')) {
            nge.localData.set('autospin.paused', false);
        } else {
            var currentBalance = nge.localData.get('balance');
            nge.localData.set('autospin.startBalance', currentBalance);
            nge.localData.set('autospin.totalWin', 0);
            var spinsToDo = nge.localData.get('autospin.spins');
            nge.localData.set('autospin.spinsLeft', spinsToDo);
        }

        nge.localData.set('autospin.stopRequest', false);
        nge.localData.set('autospin.inProgress', true);

        nge.observer.fire('autospin.close');
        nge.observer.fire('slotMachine.spinCommand');
        nge.observer.fire('buttons.autospinMode');
        var autospinTextContainer = nge.find('^autospinTextContainer');
        var autospinSpinsLeftText = nge.find('^autospinSpinsLeftText');
        autospinTextContainer.visible = false;
        autospinSpinsLeftText.text = nge.localData.get('autospin.spinsLeft');
        autospinSpinsLeftText.alpha = 1;
    };

    var _autospinHandleResponse = function (data) {
        if (!nge.localData.get('autospin.inProgress'))
            return false;
        var inProgress = nge.localData.get('autospin.inProgress');
        var spinsLeft = nge.localData.get('autospin.spinsLeft');
        spinsLeft--;
        var autospinSpinsLeftText = nge.find('^autospinSpinsLeftText');
        nge.localData.set('autospin.spinsLeft', spinsLeft);
        autospinSpinsLeftText.text = spinsLeft;

        var currentWin = data.slotWin.totalWin;
        var totalWin = currentWin + nge.localData.get('autospin.totalWin');
        nge.localData.set('autospin.currentWin', currentWin);
        nge.localData.set('autospin.totalWin', totalWin);

        _linePickBonus = data.slotWin.linePickBonus;

        if (spinsLeft <= 0) {
            _autoSpinStopRequest();
        }

        // if current win is too big
        var winIsMoreThan = nge.localData.get('autospin.checkbox_1');
        if (winIsMoreThan.checked && currentWin > winIsMoreThan.value) {
            _autoSpinStopRequest();
        }

    };

    var _autoSpinBalanceHide = function () {
        var autoSpinSpinsLeftText = nge.find('^autospinSpinsLeftText');
        var autoSpinTextContainer = nge.find('^autospinTextContainer');
        autoSpinTextContainer.visible = true;
        autoSpinSpinsLeftText.alpha = 0;
    };

    var _autoSpinStopRequest = function () {
        nge.localData.set('autospin.stopRequest', true);
    };

    var _finishAutoSpin = function () {
        if (!nge.localData.get('autospin.inProgress'))
            return false;

        nge.localData.set('autospin.inProgress', false);
        nge.localData.set('autospin.paused', false);
        nge.localData.set('autospin.spinsLeft', 0);
        _autoSpinBalanceHide();
        nge.observer.fire('autospin.end');
    };

    var _spinCompleteResponse = function () {
        if (!nge.localData.get('autospin.inProgress'))
            return false;

        if (nge.localData.get('autospin.stopRequest')) {
            _finishAutoSpin();
        }
        // pause on bonus
        if (_linePickBonus && _linePickBonus.length > 0) {

            if (nge.localData.get('autospin.checkbox_0').checked && _linePickBonus[0].bonusName === 'FreeSpinReady') {
                _autoSpinStopRequest();
                _finishAutoSpin();
                nge.observer.fire('spinButton.disable');
            } else {
                nge.localData.set('autospin.paused', true);
                nge.localData.set('autospin.inProgress', false);
            }
        }
        _checkBalance = true;
    };

    var _autospinBalanceUpdate = function () {
        if (!nge.localData.get('autospin.inProgress'))
            return false;
        var inProgress = nge.localData.get('autospin.inProgress');
        var currentBalance = nge.localData.get('balance');
        var bet = nge.localData.get('totalBet').value;

        if (!_checkBalance || !inProgress) {
            return false;
        }
        _checkBalance = false;
        var startBalance = nge.localData.get('autospin.startBalance');
        var balanceIncreasedBy = nge.localData.get('autospin.checkbox_2');
        var balanceDecreasedBy = nge.localData.get('autospin.checkbox_3');

        if (balanceIncreasedBy.checked && (currentBalance.totalAmount - startBalance.totalAmount) > balanceIncreasedBy.value) { // if total win is bigger than specified
            log("stopping autospin as win is bigger than specified");
            _finishAutoSpin();
        } else if (balanceDecreasedBy.checked && (startBalance.totalAmount - currentBalance.totalAmount) > balanceDecreasedBy.value) { // if total loose is bigger than specified
            log("stopping autospin as loose is bigger than specified");
            _finishAutoSpin();
        } else if (currentBalance.totalAmount < bet) {
            _finishAutoSpin();
            nge.rafSetTimeout(function () {
                nge.observer.fire('spinButton.disable');
            }, 500);
        } else {
            nge.rafSetTimeout(function () {
                nge.observer.fire('slotMachine.spinCommand');
            }, 500);
        }
    };

    var _checkAutospin = function () {
        if (nge.localData.get('spin.type') === 'SpinRequest' && nge.localData.get('autospin.paused') && nge.localData.get('autospin.spinsLeft') > 0) {
            _autospinStart();
        }
    };

    var _subscribe = function () {
        nge.observer.add('autospin.show', _show);
        nge.observer.add('autospin.close', _close);

        _self.customSubscribe();
    };

    this.customSubscribe = function () {
        nge.observer.add('autoSpinCheckbox.press', _updateCheckboxes, "change_checkboxes");
        nge.observer.add('autoSpinSpins.press', _updateSpins, "change_spins");
        nge.observer.add('autospin.opened', _updateAll, "open_autospin");
        nge.observer.add('autospin.start', _autospinStart, "start_autospin");
        nge.observer.add('slotMachine.spinResponse', _autospinHandleResponse, "response_autospin");
        nge.observer.add('slotMachine.spinComplete', _spinCompleteResponse);
        nge.observer.add('balance.amount', _autospinBalanceUpdate, "complete_autospin");
        nge.observer.add('freespin.end', _checkAutospin);
        nge.observer.add('autospin.stopRequest', _autoSpinStopRequest);

        nge.observer.add(
            'autoSpinMoney.press',
            function (n) {
                var text = nge.find("^textMoney_" + n);

                var input = $('<input>')
                    .attr('id', 'autospinCheckbox_' + n)
                    .attr('maxlength', 5)
                    .css('position', 'absolute')
                    .css('left', '-15px').css('top', '-15px')
                    .css('width', '5px').css('height', '5px')
                    .keyup(_onTextChange).appendTo('body').focus().focusout(
                    function (e) {
                        $(this).remove();
                    }
                ).val(text.text.replace(".", ""));
            },
            "tabs_lights"
            );

        var _onTextChange = function (e) {
            e.target.value = e.target.value.replace(/[^0-9]/g, '');
            var textBoxId = e.target.id;
            var id = textBoxId.substring(textBoxId.lastIndexOf("_") + 1, textBoxId.length);
            var text = nge.find("^textMoney_" + id);
            text.text = nge.Lib.Validator.moneyWithPeriod(e.target.value);
            nge.localData.set('autospin.checkbox_' + id + '.value', text.text);
        };
        return true;
    };
});


nge.Com.Autospin.Tpl = function () {

    var _defaultStartValue = '5.00';
    var _spinsText = [];
    var _offset = 0;
    var _isFreespin = nge.localData.get('slotMachine.gameParameters.freeSpins');

    for (var i = 0; i < 4; i++) {
        nge.localData.set('autospin.checkbox_' + i + '.checked', i === 0);
        if (i > 0) {
            nge.localData.set('autospin.checkbox_' + i + '.value', _defaultStartValue);
        }
    }
    nge.localData.set('autospin.spins', 10);

    for (var i = 10; i <= 50; i += 10) {
        _spinsText.push({
            'x': 68 + _offset,
            'y': 17,
            type: mt.objects.TEXT,
            'style': {
                'font': 'bold 64px \'freesetboldc\'',
                'fill': (i === 10) ? 'white' : '#26a5b8',
                'align': 'left',
                'stroke': 'black',
                'strokeThickness': 0
            },
            'align': 'left',
            'isVisible': true,
            'text': i,
            'id': 'tab_spins_text_' + i,
            'name': 'tab_spins_text_' + i,
            'fullPath': 'tab_spins_text' + i
        });
        _offset += 204;
    }

