nge.App[nge.appNS].Com.SlotMachine.TempBlurs.Controller = nge.Com.SlotMachine.Controller.extend(nge.App[nge.appNS].Com.SlotMachine.TempBlurs.ControllerExtension.clone());





nge.App[nge.appNS].Com.SlotMachine.TempBlurs.ViewExtension = function () {
    var _self = this;
    var _cfgMode;
    var _freeUseSymbols;

    this.createSlotMachine = function (cfg, service, symbols, doNotResetPool) {
        _cfgMode = _self.getInstance('CfgMode').get();
        _freeUseSymbols = _cfgMode.freeUseSymbols;
        this.super.createSlotMachine(cfg, service, symbols, doNotResetPool);

        _createBlurTemps();
    };

    var _getRandomSymbol = function () {
        return _freeUseSymbols[nge.Lib.Helper.getRandomInt(0, _freeUseSymbols.length - 1)];
    };

    var _createBlurTemp = function (symbol, count, length) {
        var blurSymbols = [];
        for (var i = 0; i < length; i++)
            blurSymbols.push(i < count ? symbol : _getRandomSymbol());
        _self._createTempBlur(blurSymbols, 'blurTemp-' + symbol + '-x' + count);
    };

    var _createBlurTemps = function () {
        nge.localData.set('slotMachine.tempBlur.generating', true);
        var symbols = _cfgMode.symbolPucksCfg;
        for (var i = 0; i < _self._cfg.mw; i++) {
            symbols.forEach(function (symbol) {
                var size = symbol.combinations[symbol.combinations.length - 1].size;
                for (var j = 1; j <= size; j++)
                    _createBlurTemp(symbol.name, j, 4);
            });
        }

        nge.localData.set('slotMachine.tempBlur.generating', false);
    };

    var _fillStartBlurSymbols = function (blurKeys, column, symbol, symbolsCountNeed) {
        var count = 0;
        if (column[0] === symbol) {
            var symbolsInColumn = 1;
            var i = 0;

            for (i = 1; i < column.length; i++) {
                if (column[i] === symbol)
                    symbolsInColumn++;
                else
                    break;
            }

            for (i = 0; i < symbolsCountNeed - symbolsInColumn; i++)
                blurKeys[i] = symbol;

            count = symbolsCountNeed - symbolsInColumn;
        }

        return count;
    };

    var _fillInsideBlurSymbols = function (blurKeys, startBlurNumber, symbolsArray) {
        var sumP = 0;
        var i;
        for (i = 0; i < symbolsArray.length; i++)
            sumP += symbolsArray[i].p;

        for (i = 0; i < symbolsArray.length; i++) {
            symbolsArray[i].p /= sumP;
            symbolsArray[i].p *= 1000000;

            if (i > 0)
                symbolsArray[i].p += symbolsArray[i - 1].p;
        }

        var symbolsDone = [];
        for (var index = 0; index < symbolsArray.length; index++)
            symbolsDone.push(0);

        var lastChainSymbol = -1;
        for (var i = startBlurNumber; i < blurKeys.length; i++) {
            var random = nge.Lib.Helper.getRandomInt(0, 999999);
            for (var j = 0; j < symbolsArray.length; j++) {
                if (i < blurKeys.length - symbolsArray[j].count && random < symbolsArray[j].p && symbolsDone[j] <= symbolsArray[j].max && lastChainSymbol !== symbolsArray[j].symbol) {
                    lastChainSymbol = symbolsArray[j].symbol;
                    for (var k = 0; k < symbolsArray[j].count; k++) {
                        blurKeys[i] = symbolsArray[j].symbol;
                        i++;
                    }
                    i--;

                    symbolsDone[j]++;
                    break;
                }
            }
        }

        return blurKeys;
    };

    this._getBlurKeys = function (count, symbolsKeys) {
        if (count === this._cfg.mh && nge.localData.get('slotMachine.tempBlur.generating')) {
            return symbolsKeys;
        }

        var blurKeys = this.super._getBlurKeys(count, symbolsKeys);

        var columns = nge.localData.get('slotMachine.spinResult.columns');
        if (!columns)
            columns = nge.Lib.Helper.rowsToColumns(nge.localData.get('slotMachine.gameParameters.initialSymbols'));
        var column = this._cfg.th.indexOf(count);

        if (column !== -1) {
            blurKeys = blurKeys.reverse();
            var symbolsNeed = [];

            var startBlursCount = -1;
            var symbols = _cfgMode.symbolPucksCfg;
            symbols.forEach(function (symbol) {
                var combination = symbol.combinations[symbol.combinations.length - 1];

                if (startBlursCount === 0) {
                    startBlursCount = _fillStartBlurSymbols(
                        blurKeys,
                        columns[column],
                        symbol.name,
                        combination.size
                    );
                }

                symbolsNeed.push({
                    symbol: symbol.name,
                    count: combination.size,
                    max: combination.countInReel,
                    p: combination.probability
                });
            });

            symbolsNeed.push({
                symbol: _cfgMode.scatter.name,
                count: _cfgMode.scatter.size,
                max: _cfgMode.scatter.countInReel,
                p: _cfgMode.scatter.probability
            });

            var randomLength = [2, 3, 4][nge.Lib.Helper.getRandomInt(0, 2)];
            _freeUseSymbols.forEach(function (value) {
                if (startBlursCount === 0)
                    startBlursCount = _fillStartBlurSymbols(blurKeys, columns[column], value, randomLength);
            });

            // var startBlursCount = _fillStartBlurSymbols(blurKeys, columns[column], '12', 5);
            // symbolsNeed.push({ symbol: '12', count: 5, max: 1, p: 15 });

            // ['3', '4'].forEach(function (value) {
            //     if (startBlursCount === 0)
            //         startBlursCount = _fillStartBlurSymbols(blurKeys, columns[column], value, 4);
            //     symbolsNeed.push({ symbol: value, count: 4, max: 1, p: 15 });
            // });

            // ['0', '1', '2'].forEach(function (value) {
            //     if (startBlursCount === 0)
            //         startBlursCount = _fillStartBlurSymbols(blurKeys, columns[column], value, 3);
            //     symbolsNeed.push({ symbol: value, count: 3, max: 2, p: 20 });
            // });

            // symbolsNeed.push({ symbol: '11', count: 1, max: 3, p: 20 });

            // var randomLength = [2, 3, 4][nge.Lib.Helper.getRandomInt(0, 2)];
            // _freeUseSymbols.forEach(function (value) {
            //     if (startBlursCount === 0)
            //         startBlursCount = _fillStartBlurSymbols(blurKeys, columns[column], value, randomLength);
            // });

            // ['5', '6', '7', '8', '9', '10'].forEach(function (value) {
            //     symbolsNeed.push({ symbol: value, count: 4, max: 2, p: 15 });
            //     symbolsNeed.push({ symbol: value, count: 3, max: 2, p: 20 });
            //     symbolsNeed.push({ symbol: value, count: 2, max: 2, p: 2 });
            // });

            if (symbolsNeed.length > 0)
                _fillInsideBlurSymbols(blurKeys, startBlursCount + 1, symbolsNeed);

            blurKeys = blurKeys.reverse();
        }

        return blurKeys;
    };

};



