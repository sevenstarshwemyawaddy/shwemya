    this.subscribe = () => {
       nge.observer.add('slotMachine.animateSymbol', this.animateSymbolHandler, false, true);
       nge.observer.add('winlines.hideAll', this.winlinesHideAllHandler, false, true);
       nge.observer.add('winlines.view.startHideAll', this.winlinesHideAllHandler, false, true);
    };
});




