nge.App[nge.appNS].Com.SlotMachine.RecyclerReel = nge.Com.SlotMachine.RecyclerReel.extend(function () {
    const BLUR_PREFIX = 'blur_';

    this._getBlurName = name => {

        if(name.indexOf(BLUR_PREFIX) === -1)
           return BLUR_PREFIX.concat(name);

        return name;
    }; 

    this._getSymbolName = name => {

        if(name.indexOf(BLUR_PREFIX) >= 0)
            return name.replace(BLUR_PREFIX, '');

        return name;
    };
    
    this.loadUpperSymbol = (key) => {
        if(this._running && key.indexOf(BLUR_PREFIX) !== 0)
            key = this._getBlurName(key);

        this.loadSymbolAt(0, key);
    };

    this.changeSymbolsToBlurs = (reverse = false) => {
        const offset = this._borderSymbolsCount;
        const normalSymbolsLength = this._symbols.length - offset;
        const getName = reverse ? this._getSymbolName : this._getBlurName;
         
        for (let i = offset; i < normalSymbolsLength; i++) {
           const symbol = this._symbols[i];
           const blurName = getName(symbol.getName());
           this.loadSymbolAt(i, blurName);
       }
    };

    this.start = (direction = 1) => {
        this.changeSymbolsToBlurs(false);
        this.super.start(direction);
    };
});



nge.App[nge.appNS].Com.SlotMachine.RecyclerView = nge.App.RiverGameBase.Com.SlotMachine.RecyclerView.extend(function () {
    this.stopJumpTime = 250;
    const INTRIGUE_ANIMATION_DURATION = 1000;
    const INTRIGUE_ANIMATION_FRAMES_COUNT = 29;

    let _frameTween = null;

    const _inrigueFrames = {
        '^gnItrigueFrameReel2': null,
        '^gnItrigueFrameReel3': null,
        '^gnItrigueFrameReel4': null
    };

    this._startFrameTween = obj => {
        nge.observer.fire('sound.intrigue.start');
        _frameTween = nge.tween.add(obj).to({}, INTRIGUE_ANIMATION_DURATION, null, false, 0, -1);
 
        _frameTween.onStart.add(function(){
            obj.visible = true;
        });

        _frameTween.onUpdateCallback(function(tween, value){
            var index = Math.round(value * INTRIGUE_ANIMATION_FRAMES_COUNT);
            tween.target.loadTexture('fast_spin_' + nge.Lib.Helper.LdgZero(index, 3));
        });

        _frameTween.onComplete.add(function(){
            obj.visible = false;
        });

        _frameTween.start();
    };

    this.createSlotMachine = (cfg, service, symbols, doNotResetPool = false) => {
        this.super.createSlotMachine(cfg, service, symbols, doNotResetPool);
    
        const cont = nge.findOne('^intrigueFramesContainer');
        
        for(let selector in _inrigueFrames){
            _inrigueFrames[selector] = nge.findOne(selector);
            _inrigueFrames[selector].visible = false;
            cont.addChild(_inrigueFrames[selector]);
        }
    };

    this.showIntrigueFrameAnimation = reelIndex => this._startFrameTween(_inrigueFrames['^gnItrigueFrameReel' + reelIndex]);

    this.hideIntrigueFrameAnimation = () => {
        _frameTween && _frameTween.stop(true);
        _frameTween = null;
    };

    this._onReelStop = (reel, cb) => { 
        reel.changeSymbolsToBlurs(true);
        this.super._onReelStop(reel, cb);
    };

});



nge.App[nge.appNS].Com.SlotMachine.Service = nge.Com.SlotMachine.Service.extend(function () {

    this._checkIntrigue = reelIndex => {
        const currIntrigueIndex = reelIndex + 1;
        const smIntrigue = nge.localData.get('slotMachineIntrigue');
        
        this._view.hideIntrigueFrameAnimation();

        if(smIntrigue.status && smIntrigue.startsFrom <= currIntrigueIndex && currIntrigueIndex <= 4)
            this._view.showIntrigueFrameAnimation(currIntrigueIndex);
        
    };

    this.reelStopped = reelIndex => this._checkIntrigue(reelIndex);
});




