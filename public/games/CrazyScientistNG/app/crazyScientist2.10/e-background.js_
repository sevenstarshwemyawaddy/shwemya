PIXI.Slider = class extends PIXI.Container {
    constructor(background, foreground, thumb) {
        super();
        this._margin = {
            left: 0,
            right: 0
        };
        this._steps = ['0', '1'];
        this._raw = true;
        this._stepsPositions = [0, background.width];
        this._step = 0;
        this._value = 0;
        this._tooltip = null;
        this._label = null;

        this._background = background;
        this._foreground = foreground;
        this._thumb = thumb;

        this.addChild(this._background);
        this.addChild(this._foreground);
        this.addChild(this._thumb);

        this._background.anchor.set(0, 0.5);
        this._thumb.anchor.set(0.5, 0.5);

        this._foreground.x = 8; // FIXME: спрайт слайдера должен иметь те же размеры что и фон 
        this._foreground.y = -this._foreground.height / 2; // TODO: нема якоря у NineSlice
        this._foreground.width = 0;

        this._background.on('pointerdown', (e) => {
            this.move(e.data.getLocalPosition(this).x);
            if(!this._raw)
                this.move(this._stepsPositions[this._step]);
        });

        this._thumb.on('pointerdown', () => {
            this._thumb.on('pointermove', this._drag, this);

            const onPointerUp = () => {
                this._thumb.off('pointercancel', onPointerUp);
                this._thumb.off('pointerup', onPointerUp);
                this._thumb.off('pointerupoutside', onPointerUp);
                this._thumb.off('pointermove', this._drag);
                if(this._tooltip)
                    this._tooltip.visible = false;
                if(this._label)
                    this._label.visible = true;

                if(!this._raw)
                    this.move(this._stepsPositions[this._step]);

                if(this._onChange)
                    this._onChange(this._steps[this._step]);
            };

            this._thumb.once('pointercancel', onPointerUp);
            this._thumb.once('pointerup', onPointerUp);
            this._thumb.once('pointerupoutside', onPointerUp);

            if(this._tooltip)
                this._tooltip.visible = true;
            
            if(this._label)
                this._label.visible = false;
        });
        
        this._thumb.interactive = true;
        this._background.interactive = true;
    }
    _drag(e) {
        this.move(e.data.getLocalPosition(this).x);
    }
    get value() {
        return this._value;
    }
    set value(v) {
        this._value = v;
        const x = this._margin.left + (this._background.width - this._margin.right - this._margin.left) * v;
        this.move(x);
    }
    get tooltip() {
        return this._tooltip;
    }
    set tooltip(v) {
        this.add(v);
        this._tooltip = v;
        this._tooltip.visible = false;
        this._tooltip.position.set(this._thumb.x, this._thumb.y);
    }
    get label() {
        return this._label;
    }
    set label(v) {
        this.add(v);
        this._label = v;
        this._label.visible = true;
        this._label.position.set(this._thumb.x, this._thumb.y + this._label.offset);
    }
    set margins(v) {
        this._margin = {
            left: v.left || 0,
            right: v.right || 0
        };
        this.move(v.left);
    }
    move(rawX) {
        const x = Math.min(Math.max(this._margin.left, rawX), this._background.width - this._margin.right);
        const val = (x - this._margin.left) / (this._background.width - this._margin.right - this._margin.left);
        this._thumb.position.set(x, 0);
        this._foreground.width = x;

        this._step = Math.round(val * (this._steps.length - 1));

        if(this._tooltip) {
            this._tooltip.position.set(x, 0);
            this._tooltip.value = this._steps[this._step];
        }
        
        if(this._label) {
            this._label.position.set(x, this._thumb.y + this._label.offset);
            this._label.text = this._steps[this._step];
        }

        if(this._onDrag)
            this._onDrag(this._steps[this._step]);
    }
    /**
     * Nuff said
     * @param {Boolean} v state
     * @deprecated
     */
    toggleBgInput(v = true) {
        this._background.interactive = v;
    }
    setValuesRange(cfg, v) {

        if(!_.isArray(cfg) || _.isEmpty(cfg))
            return;

        if (cfg.length === 1)
            this.disable(3);
            
        this._steps = cfg;
        this._raw = this._steps === 2;
        this._stepsPositions = [];
        for(let i = 0; i < this._steps.length; i++)
            this._stepsPositions.push(i * (this._background.width / (this._steps.length - 1)));
        this.updateState(v);
    }
    setOnDrag(callback) {
        this._onDrag = callback || function() {};
    }
    /**
     * Функция которая ничего не делает.
     * @param {*} callback
     * @deprecated
     */
    setOnChange(callback) {
        this._onChange = callback || function() {};
    }
    updateState(v) {
        let index = this._steps.findIndex((item) => { return v === item; });
        if(index < 0)
            index = 0;
        const progress = this._steps.length === 1 ? 1 : index / (this._steps.length - 1);
        this.value = progress;
    }
    val(v) {
        this.value = v;
    }
    enable() {
        if(this._steps.length <= 1)
            return;
        this._thumb.enable();
        this._background.interactive = true;
        if(this.getData().fillAssetKey)
            this._foreground.texture = this._foreground.activeTexture;
    }
    disable(frame) {
        this._thumb.disable(frame);
        this._background.interactive = false;
        if(this.getData().fillInactiveAssetKey)
            this._foreground.texture = this._foreground.inactiveTexture;
    }
};



PIXI.Tooltip = class extends PIXI.Container {
    constructor(background, text) {
        super();
        this._background = background;
        this._text = text;
        this._background.position.set(0, 0);
        this._text.position.set(0, 0);

        this._text.text = '0';

        this.add(this._background);
        this.add(this._text);
    }
    set value(v) {
        this._text.text = v;
    }
    setOffsets(backgroundOffset = 0, textOffset = 0) {
        this._background.y = backgroundOffset;
        this._text.y = textOffset;
    }
};



PIXI.Transitions = class {
    constructor(settings) {
        this._settings = settings;
    }
    _destroy() {
        if(this._cover)
            this._cover.visible = false;
        
        if(this._texture)
            this._texture.visible = false;

        this._cover && this._cover.destroy();
        this._cover = null;
        this._texture && this._texture.destroy();
        this._texture = null;
    }
    _bringCoverToTop() {
        if (this._cover)
            this._cover.bringToTop();
    }
    _animateCover() {
        this._tween = nge.tween.add(this._cover).to(this._settings.properties, this._settings.duration, this._settings.ease);
        this._tween.onComplete.addOnce(this._destroy, this);
        this._tween.start();
    }
    to(state) {
        nge.statesManager.pause();

        /* If there's a sprite there, destroy it */
        if (this._cover)
            this._cover.destroy();

        /* If there's no texture create one */
        if (!this._texture)
            this._texture = PIXI.RenderTexture.create(nge.wrap.states.world.width, nge.wrap.states.world.height);

        /* We want the current background color in the transition, just in case the entire frame isn't covered by sprites. */
        var tempGraphic = new PIXI.Graphics();
        tempGraphic.beginFill(nge.game.stage.backgroundColor);
        tempGraphic.lineStyle(1, nge.game.stage.backgroundColor, 1);
        tempGraphic.drawRect(0, 0, nge.wrap.states.world.width, nge.wrap.states.world.height);
        tempGraphic.endFill();
        /* adding it to the texture before the world render */
        nge.wrap.states.renderer.render(tempGraphic, this._texture);
        /* cleanup */
        tempGraphic.clear();

        /* Draw the current world to the render */
        nge.wrap.states.renderer.render(nge.wrap.states.world, this._texture);

        /* If there's a state as a paramterer change the state and do the dew */
        if (state) {
            var _create = nge.wrap.states.states[state].create;

            nge.wrap.states.states[state].create = () => {
                //clear world
                nge.wrap.states.world.shutdown();
                this._cover = new PIXI.Sprite(this._texture);

                _create.call(nge.wrap.states.states[state]);
                if (this._cover) {
                    nge.wrap.states.world.add(this._cover);
                    this._cover.scale.set(1 / nge.wrap.states.world.scale.x, 1 / nge.wrap.states.world.scale.y);
                    this._animateCover();
                }
            };

            nge.wrap.states.start(state, false);
        }

        nge.statesManager.resume();
    }
};



