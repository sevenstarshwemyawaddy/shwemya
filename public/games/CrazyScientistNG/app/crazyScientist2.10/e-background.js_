/**
 * Класс рила слотмашины. Используется только в RecyclerView
 */
nge.Com.SlotMachine.RecyclerReel = nge.Com.Base.extend(function () {
    this.init = (config) => {
        this._index = config.index; // Индекс рила
        this._symbolSize = { width: config.symbolSize.width, height: config.symbolSize.height }; // Размер символа
        this._height = config.height * config.symbolSize.height; // Высота рила. Произведение количества символов на их высоту
        this._container = config.container; // Контейнер, в котором хранятся символы
        this._templates = config.templates; // Шаблоны символов из symbols.js
        this._symbols = config.symbols; // Массив логических символов в барабане
        this._blurs = config.blurs; // Массив имен символов в барабане
        this._borderSymbolsCount = config.borderSymbolsCount; // Количество символов за границей рила
        this._currentBlur = 0; // Индекс последнего созданного символа в барабане
        this._running = false; // Статус вращения
        this._stopping = false; // Статус докрутки
        this._onhold = false; // Статус заморозки
        this._counter = 0; // Счётчик символов до полной остановки рила
        this._stepDuration = 100; // Длительность шага слотмашины
        this._lastSymbols = [];
        this._hideBorderSymbols = config.hideBorderSymbols;
        this._offsetY = this._container.y;
        this._normalSpeed = config.speed;
        this._intrigueSpeed = config.intrigueSpeed;
        this._speedUpSpeed = config.speedUpSpeed; // Лучшее имя для поля

        for(let i = 0; i < this._symbols.length; i++) {
            this._symbols[i].setSymbolCfg(this._templates[this._blurs[this._currentBlur++]]);
            this._container.addChild(this._symbols[i].texture);
            this._symbols[i].texture.textureZ = 0;
        }
        this.resetPosition();
        this.switchBorders(!this._hideBorderSymbols);
    };

    /**
     * Выставление рила и символов в стартовую позицию
     */
    this.resetPosition = () => {
        this._container.y = this._offsetY;
        let offset = -(this._symbolSize.height / 2) - (this._symbolSize.height * (this._borderSymbolsCount - 1));
        for(let i = 0; i < this._symbols.length; i++) {
            let texture = this._symbols[i].texture;
            texture.position.set(this._symbolSize.width / 2, offset);
            offset += this._symbolSize.height;
        }
        this._container.updateTransform();
    };
    
    /**
     * Запуск вращения
     */
    this.start = (direction = 1) => {
        if(this._running)
            return;

        if(this._onhold) {
            return;
        }

        this._stopping = false;
        this._running = true;
        this._lastSymbols = [];
        this.setCounter(999999);

        this.onStart(this, () => {
            this._tween = nge.tween.add(this._container, true);
            this.resetPosition();
            this.switchBorders(true);
            this.setSpeed(this._normalSpeed);
            this.step(this._stepDuration, direction);
        });
    };

    this.isOnHold = () => {
        return this._onhold;
    };

    this.unhold = () => {
        this._onhold = false;
    };

    this.hold = () => {
        this._onhold = true;
    };

    /**
     * Индекс рила на слотмашине
     * @returns {Number} индекс
     */
    this.getIndex = () => {
        return this._index;
    };

    /**
     * Получить количество оставшихся символов в ленте до остановки не считая lastSymbols
     * @returns {Number} количество символов
     */
    this.getCounter = () => {
        return this._counter;
    };
    /**
     * Получить контейнер хранящий символы
     * @returns {Object} количество символов
     */
    this.getContainer = () => {
        return this._container;
    };

    /**
     * Выставить количество оставшихся символов в ленте до остановки не считая lastSymbols\
     * @param {Number} counter - новое значение счётчика
     */
    this.setCounter = (counter) => {
        this._counter = counter;
    };

    this.getBlurs = () => {
        return this._blurs;
    };

    this.setBlurs = (blurs) => {
        this._blurs = blurs;
        this._currentBlur = 0;
    };

    this.getCurrentBlur = () => {
        return this._currentBlur;
    };

    this.setCurrentBlur = (currentBlur) => {
        this._currentBlur = currentBlur;
    };

    this.isRunning = () => {
        return this._running;
    };

    /**
     * При вызове остановки рила мы передаём ему счетчик символов которые он должен ещё пройти и символы на которых он должен остановиться
     * @param {Array} lastSymbols - массив последних символов на ленте
     * @param {Number} counter - счетичик ленты
     */
    this.stop = (lastSymbols, counter) => {
        if(!this.isRunning())
            return;
        this.setCounter(counter);
        this._lastSymbols = lastSymbols;
    };

    this.speedUp = () => {
        if(!this._stopping)
            this._counter = 0;

        this.setSpeed(this._speedUpSpeed);   
    };

    /**
     * Установить новую скорость вращения барабанов
     * @param {Number} speed - новая скорость вращения
     */
    this.setSpeed = (speed = this._normalSpeed) => {
        if (this._tween)
            this._tween.timeScale = speed;
        this._requiredTimeScale = speed;
    };

    /**
     * Вернуть символ symbol.js из по индексу position
     * @param {Number} position - позиция символа. 
     * Для получения символа за верхним пределом рила стоит использовать -1
     * Для получения символа за нижним пределом рила стоит использовать mh - 1
     * @returns {Symbol} символ
     */
    this.getSymbolAt = (position) => {
        return this._symbols[position + this._borderSymbolsCount];
    };

    /**
     * Выставить новый символ в позицию на риле
     * @param {Number} position позиция на риле
     * @param {String} symbol имя символа из symbols.js
     */
    this.setSymbolAt = (position, symbol) => {
        const template = this._templates[symbol];
        const index = position + this._borderSymbolsCount;
        this._symbols[index].setSymbolCfg(template);
        this._symbols[index].texture.textureZ = template.textureZ ? template.textureZ : 0;
    };
    this.sort = () => {
        for(let i = 0; i < this._symbols.length; i++)
            this._symbols[i].texture.textureZ += i;
        this._container.sort('textureZ');
    };
    this.destroy = () => {
        this._container.destroy();
        if(this._tween)
            this._tween.stop();
    };

    this.recycle = (direction = 1) => {
        if(direction > 0) {
            this._symbols[this._symbols.length - 1].texture.position.y = this._symbols[0].texture.position.y - this._symbolSize.height;
            this._symbols.unshift(this._symbols.pop());
        }
        else if(direction < 0) {
            this._symbols[0].texture.position.y = this._symbols[this._symbols.length - 1].texture.position.y + this._symbolSize.height;
            this._symbols.push(this._symbols.shift());
        }
    };

    this.step = (duration = 100, direction = 1) => {
        this._tween.to({y: this._container.y + (this._symbolSize.height * direction)}, duration);

        if(this._requiredTimeScale && this._tween.timeScale !== this._requiredTimeScale) {
            this._tween.timeScale = this._requiredTimeScale;
            delete this._requiredTimeScale;
        }

        this._tween.onComplete.addOnce(() => {
            this.recycle(direction);

            if(direction > 0) {
                if(this._counter-- > 0) {
                    this.loadUpperSymbol(this.nextBlur());
                    this.step(duration, direction);
                    return;
                }
                
                this._stopping = true;

                if(this._lastSymbols.length > 0) {
                    this.loadUpperSymbol(this._lastSymbols.pop());
                    
                    if(this._lastSymbols.length === 0)
                        this._counter = this._borderSymbolsCount - 1;

                    this.step(duration, direction);
                    return;
                }
    
                this.loadUpperSymbol(this.nextBlur());
            }
            else {
                if(this._counter-- > 0) {
                    this.loadLowerSymbol(this.previousBlur());
                    this.step(duration, direction);
                    return;
                }
    
                if(this._lastSymbols.length > 0) {
                    this.loadLowerSymbol(this._lastSymbols.shift());
    
                    if(this._lastSymbols.length === 0)
                        this._counter = this._borderSymbolsCount - 1;
    
                    this.step(duration, direction);
                    return;
                }
    
                this.loadLowerSymbol(this.previousBlur());
            }

            this.onStop(this, () => {
                this.resetPosition();
                this._running = false;
                this.switchBorders(!this._hideBorderSymbols);
            });
        });
        this._tween.start();
    };

    this.move = (offset) => {
        this._container.y += offset;
    };
    this.previousBlur = () => {
        const blur = this._blurs[this._currentBlur--];
        if(this._currentBlur === -1)
            this._currentBlur = this._blurs.length - 1;
        return blur;
    };
    this.nextBlur = () => {
        const blur = this._blurs[this._currentBlur++];
        if(this._currentBlur === this._blurs.length)
            this._currentBlur = 0;
        return blur;
    };
    this.loadSymbolAt = (position, key) => {
        const template = this._templates[key];
        this._symbols[position].setSymbolCfg(template);
        this._symbols[position].texture.textureZ = template.textureZ ? template.textureZ : 0;
        this.sort(); 
    }
    this.loadUpperSymbol = (key) => {
        this.loadSymbolAt(0, key);
    };
    this.loadLowerSymbol = (key) => {
        this.loadSymbolAt(this._symbols.length - 1, key);
    };
    this.switchBorders = (value = false) => {
        for(let i = 0; i < this._borderSymbolsCount; i++) {
            this._symbols[i].texture.visible = value;
            this._symbols[this._symbols.length - (i + 1)].texture.visible = value;
        }
    };
});



nge.Com.SlotMachine.RecyclerView = Class.extend(function () {
    this._cfg = null;
    this._service = null;
    this._symbols = {};
    this._helper = null;
    this._symbolSize = { width: 1, height: 1 };
    this._maskContainer = null;
    this._reelsContainer = null;
    this._container = null;
    this._holdedSymbolsContainer = null;
    this._holdedSymbols = [];
    this._reels = [];
    this._animationSymbolsCovers = [];
    this._lastUpdate = 0;
    this._reelsStoped = 0;
    this._covers = null;
    this._speedUp = false;
    this._spinDirection = 'forward';

    Object.defineProperties(this, {
        spinDirection: {
            get: function () {
                return this._spinDirection;
            }
        }
    });

    this.deactivate = () => {
        console.color('[RV]deactivate', '#00ff00', '#000000');
    };

    this.destroy = () => {
        for(let i = 0; i < this._reels.length; i++) {
            this._reels[i].destroy();
        }
        this._reels = [];
    };

    this.destroyReelsContainer = () => {
        console.color('[RV]destroyReelsContainer', '#ff0000', '#000000');
        this._reelsContainer.destroy();
        this.destroy();
    };

    this.createSlotMachine = (cfg, service, symbols, doNotResetPool = false) => {
        console.color('[RV]createSlotMachine', '#ff0000', '#000000');
        this._cfg = cfg;
        this._service = service;

        for(let i = 0; i < this._reels.length; i++) {
            this._reels[i].destroy();
        }
        this._reels = [];

        for(let i = 0; i < symbols.get().length; i++)
            this._symbols[symbols.get()[i].name] = symbols.get()[i];

        if(!this._helper)
            this._helper = this.getInstance('Helper');

        this._container = nge.find('^' + this._cfg.parentName);
        this._reelsContainer = nge.objects.create(new nge.Mlm.Objects.Folder());
        const cData = this._container.getData();
        
        this._container.add(this._reelsContainer);

        this._setSymbolSize(cData);
        this._createMask(cData);
        this._createReels(cData);
        this._createCovers();
    };

    this._setSymbolSize = (cData) => {
        this._symbolSize = {
            width: cData.width / this._cfg.mw,
            height: cData.height / this._cfg.mh
        };
    };

    this._createBlurs = (keys) => {
        const REEL_BLURS_SIZE = 40; // TODO: в конфиг
        const blurs = [];

        for(let i = 0; i < this._cfg.mw; i++) {
            const array = [];
            for (let j = 0; j < REEL_BLURS_SIZE; j++) {
                if(keys[i] && Array.isArray(keys[i]))
                    array.push(keys[i][nge.Lib.Random.generate_range(0, keys[i].length -1)]);
                else
                    array.push(keys[nge.Lib.Random.generate_range(0, keys.length -1)]);
            }
            blurs.push(array);
        }
        return blurs;
    };

    this._createReels = (cData) => {
        const template = this._symbols[0];
        const blurs = this._createBlurs(this._cfg.symbolsBlurKeys);

        if(!this._cfg.mhv) {
            this._cfg.mhv = [];
            for(let i = 0; i < this._cfg.mw; i++)
                this._cfg.mhv.push(this._cfg.mh);
        }

        for (let i = 0; i < this._cfg.mw; i++) {
            this._holdedSymbols.push([]);
            let symbols = [];
            let reelContainer = nge.objects.create(new nge.Mlm.Objects.Folder());
            reelContainer.x = i * this._symbolSize.width;
            reelContainer.y = 0;

            if (this._cfg.rowsXoffset && this._cfg.rowsXoffset[i])
                reelContainer.x += this._cfg.rowsXoffset[i];

            if (this._cfg.rowsYoffset && this._cfg.rowsYoffset[i])
                reelContainer.y += this._cfg.rowsYoffset[i];

            for (let j = 0; j < this._cfg.mhv[i] + (this._cfg.recyclerView.borderSymbolsCount * 2); j++) {
                let symbol = this.getInstance('Symbol');
                symbol.init(template, this._symbolSize, this._container);
                symbol.setView(this);
                symbols.push(symbol);
            }

            const reel = this.getInstance('RecyclerReel');
            reel.init({
                index: i,
                container: reelContainer,
                symbols: symbols,
                blurs: blurs[i],
                templates: this._symbols,
                symbolSize: this._symbolSize,
                height: this._cfg.mhv[i],
                speed: this._cfg.recyclerView.reelsSpeed[i],
                intrigueSpeed: this._cfg.recyclerView.reelsIntrigueSpeed,
                speedUpSpeed: this._cfg.recyclerView.reelsSpeedUpSpeed,
                hideBorderSymbols: this._cfg.recyclerView.hideBorderSymbols,
                borderSymbolsCount: this._cfg.recyclerView.borderSymbolsCount
            });

            reel.onStart = this._onReelStart;
            reel.onStop = this._onReelStop;

            this._reelsContainer.add(reelContainer);
            this._reels.push(reel);
        }
    };

    this._onReelStart = (reel, cb) => {
        const delay = reel.getIndex() * this._cfg.tweenStartInterval;
        this.customReelStartCallback(reel, delay, cb);
        nge.observer.fire('slotMachine.reelAnimationStart', reel.getIndex(), delay);
        nge.observer.fire('slotMachine.reel_' + reel.getIndex() + '.animation.start', delay);
    };

    this._onReelStop = (reel, cb) => {
        this.customReelStopCallback(reel, reel.getIndex());
        nge.observer.fire('slotMachine.reel_' + reel.getIndex() + '.animation.stop');
        nge.observer.fire('slotMachine.reel_' + reel.getIndex() + '.animation.stopped');

        this._checkIntrigue(reel.getIndex());

        const onHoldCount = this._reels.filter((b) => {return b.isOnHold();}).length;

        if(++this._reelsStoped === (this._reels.length - onHoldCount)) {
            nge.rafSetTimeout(() => {
                this._service.spinCompleteCallback();
            }, this._cfg.spinCompleteDelay);
        }
        cb();
    };

    this._checkIntrigue = (reelIndex) => {
        const intrigue = nge.localData.get('slotMachineIntrigue');

        if(intrigue && intrigue.status) {
            const nextReel = reelIndex + 1;

            if(this._speedUp || nextReel === this._reels.length)
                return;

            const startsFrom = intrigue.startsFrom;
            const endsFrom = intrigue.endsFrom || this._reels.length;

            for(let i = 0; i < this._reels.length; i++) {
                this._reels[i].setSpeed();
            }
            if(nextReel >= startsFrom && nextReel < endsFrom) {
                for(let i = reelIndex + 1; i < this._reels.length; i++) {
                    this._reels[i].setSpeed(this._cfg.recyclerView.reelsIntrigueSpeed);
                }
            }
        }
    };

    this._createMask = (cData) => {
        this._maskContainer = nge.findOne('^' + this._cfg.maskName) || this._reelsContainer;

        var mData = (this._maskContainer.getData().width > 0 && this._maskContainer.getData().height > 0) ?
            this._maskContainer.getData() : cData;

        let rects = [];

        if (!this._cfg.rowsXoffset && !this._cfg.rowsYoffset && !this._cfg.mhv)
            rects = [0, 0, parseInt(mData.width, 10), parseInt(mData.height, 10)];
        else {
            for (let i = 0; i < this._cfg.mw; i++) {
                let width = mData.width / this._cfg.mw;
                let height = mData.height;
                let x = i * width;
                let y = 0;

                if (this._cfg.rowsXoffset && this._cfg.rowsXoffset[i])
                    x += this._cfg.rowsXoffset[i];

                if (this._cfg.rowsYoffset && this._cfg.rowsYoffset[i])
                    y += this._cfg.rowsYoffset[i];

                if (this._cfg.mhv && this._cfg.mhv[i])
                    height = mData.height * this._cfg.mhv[i] / this._cfg.mh;

                rects.push([x, y, width, height]);
            }
        }

        this._maskContainer.mask = nge.objects.create(new nge.Mlm.Objects.Mask({rects: rects}), this._maskContainer, true);
    };

    /**
     * Выставить символ в позицию
     * @param {Object} data //{coords:[1,2], key:5}
     */
    this.setSymbol = (data) => {
        this._reels[data.coords[0]].setSymbolAt(data.coords[1], data.key);
        this._reels[data.coords[0]].sort();
    };

    /**
     * В первой версии движка вызывает перегенерацию текстур блюр лент
     * Здесь же просто заполняет массив лент случайными символами из symbolsBlurKeys
     */
    this.updateBlurs = () => {
        console.color('[RV]updateBlurs', '#00ff00', '#000000');
        const blurs = this._createBlurs(this._cfg.symbolsBlurKeys);
        for(let i = 0; i < this._reels.length; i++) {
            this._reels[i].setBlurs(blurs[i]);
        }
    };

    /**
     * Заменить блюры для определенного рила
     */
    this.setBlurs = (reelIndex, blurs, startIndex = 0) => {
        this._reels[reelIndex].updateBlurs(blurs, startIndex);
    };

    /**
     * Вызывается для подмены символов в слотмашине. Например, на старте игры. 
     * Что делает isHistory мне пока непонятно
     */
    this.displaySymbols = (cfg, isHistory) => {
        console.color('[RV]displaySymbols: ' + JSON.stringify(cfg), '#00ff00', '#000000');
        for(let i = 0; i < cfg.length; i++) {
            for(let j = 0; j < this._cfg.mhv[i]; j++) {
                this._reels[i].setSymbolAt(j, cfg[i][j]);
            }
            this._reels[i].sort();
        }
    };

    this._customClearSymbols = () => {
        console.color('[RV]_customClearSymbols', '#00ff00', '#000000');
    };

    this._displaySymbolCallback = (symbol, reel, isHistory) => {
        console.color('[RV]_displaySymbolCallback', '#00ff00', '#000000');
    };

    /**
     * Начинает вращение барабанов.
     */
    this.reelSpins = (direction = 'forward') => {
        this._spinDirection = direction;
        this._requestStartTime = nge.Lib.Time.get();

        this._speedUp = false;
        this._reelsStoped = 0;
        for(let i = 0; i < this._reels.length; i++) {
            this._reels[i].start(direction === 'forward' ? 1 : -1);
        }
    };

    /**
     * По идее, эта функция вызывается когда приходит ответ от сервера. Тут мы заряжаем финальные символы в ленту
     * и запрашиваем остановку рилов с задержкой.
     */
    this.setNewReelsCfg = (cfg) => {
        const timeDiff = nge.Lib.Time.get() - this._requestStartTime;
        const countersDiff = Math.round(timeDiff / 100);
        const counters = this.getBaseStopCounters();
        const intrigueCounters = this.getIntrigueStopCounters();

        for(let i = 0; i < counters.length; i++) {
            counters[i] += intrigueCounters[i];
        }

        let min = counters[0];
        for(let i = 0; i < counters.length; i++)
            if(counters[i] < min)
                min = counters[i];

        let substract = Math.max(0, Math.min(countersDiff, min) - this._cfg.recyclerView.reelsMinStopCounter);
            
        for(let i = 0; i < this._reels.length; i++) {
            this._reels[i].stop(cfg[i].slice(0, this._cfg.mhv[i]), counters[i] - substract);
        }
    };

    this.getBaseStopCounters = () => {
        const counters = this._cfg.recyclerView.reelsStopCounter.slice();
        for(let i = 0; i < this._reels.length; i++) {
            if(this._reels[i].isOnHold())
                counters.splice(i, 0, 0);
        }
        return counters.slice(0, this._reels.length);
    };

    this.getIntrigueStopCounters = () => {
        const counters = new Array(this._reels.length).fill(0);
        const intrigue = nge.localData.get('slotMachineIntrigue');
        if(!intrigue || !intrigue.status)
            return counters;

        intrigue.endsFrom = (intrigue.endsFrom) ? intrigue.endsFrom : Infinity;

        for(let i = 0; i < counters.length; i++) {
            if(i >= intrigue.startsFrom && i < intrigue.endsFrom) {
                for(let j = i; j < counters.length; j++) {
                    counters[j] += this._cfg.recyclerView.intrigueAdditionalCounter;
                }
            }     
        }
        return counters;
    };

    this.getSymbolByPosition = (position) => {
        return this._reels[parseInt(position.reel, 10)].getSymbolAt(parseInt(position.row, 10));
    };

    this.getReels = () => {
        return this._reels;
    };

    this.speedUpReel = (index) => {
        this._reels[index].speedUp();
    };

    this.speedUpReels = () => {
        this._speedUp = true;
        for(let i = 0; i < this._reels.length; i++) {
            this.speedUpReel(i);
        }
    };

    this._createCovers = function () {
        let offsetX = 0;
        let offsetY = 0;
        this._covers = [];

        for (let j = 0; j < this._cfg.mw; j++) {
            this._covers[j] = [];
            let mh = this._cfg.mhv[j];

            if (this._cfg.rowsXoffset)
                offsetX = this._cfg.rowsXoffset[j];

            if (this._cfg.rowsYoffset)
                offsetY = this._cfg.rowsYoffset[j];

            for (let i = 0; i < mh; i++) {
                const coverKey = 'animateSymbolCover-' + j + '-' + i;
                let cover = nge.findOne('^' + coverKey);

                if (cover) {
                    this._covers[j][i] = cover;
                    continue;
                }

                if (!nge.wrap.cache.checkImageKey(coverKey))
                    continue;

                cover = nge.objects.create(new nge.Mlm.Objects.Image({
                    name: coverKey, assetKey: coverKey,
                    x: (j + 0.5) * this._symbolSize.width + offsetX,
                    y: (i + 0.5) * this._symbolSize.height + offsetY,
                    'anchorX': 0.5, 'anchorY': 0.5, isVisible: false
                }), this._container);
                this._covers[j][i] = cover;
            }
        }
    };

    this.showAnimationSymbolsCover = (sp) => {
        if (this._covers && this._covers[sp.reel] && this._covers[sp.reel][sp.row]) {
            const cover = this._covers[sp.reel][sp.row];

            cover.visible = true;
            this._container.bringToTop(cover);
        }
    };

    this.hideAnimationSymbolsCovers = () => {
        for (let j = 0; j < this._covers.length; j++) {
            const rows = this._covers[j];

            for (let i = 0; i < rows.length; i++) {
                const cover = rows[i];

                if (cover)
                    cover.visible = false;
            }
        }
    };

    this.getRandomSymbolsTable = () => {
        console.color('[RV]getRandomSymbolsTable', '#00ff00', '#000000');
    };

    this.holdSymbol = (symbolPosition, symbol) => {
        console.color('[RV]holdSymbol', '#00ff00', '#000000');

        this.unholdSymbol(symbolPosition);

        const name = symbol.getName();
        const sTexture = symbol.texture;

        if (!this._holdedSymbolsContainer) {
            this._holdedSymbolsContainer = nge.objects.create(nge.Mlm.Objects.Folder({
                name: 'holdedSymbolsContainer'
            }), this._container);
        }

        const texture = nge.objects.create(nge.Mlm.Objects.Image({
            name: 'holdedSymbol_' + symbolPosition.reel + '_' + symbolPosition.row,
            assetKey: name,
            x: sTexture.x + sTexture.parent.x,
            y: sTexture.y + sTexture.parent.y,
            anchorX: 0.5,
            anchorY: 0.5
        }), this._holdedSymbolsContainer);

        this._holdedSymbols[symbolPosition.reel][symbolPosition.row] = texture;
    };

    this.unholdSymbol = (symbolPosition) => {
        console.color('[RV]unholdSymbol', '#00ff00', '#000000');
        if (!symbolPosition)
            console.error('nge.Com.SlotMachine.View.unholdSymbol error: no symbolPosition');

        if (this._holdedSymbols[symbolPosition.reel][symbolPosition.row]) {
            this._holdedSymbols[symbolPosition.reel][symbolPosition.row].destroy(true);
            this._holdedSymbols[symbolPosition.reel][symbolPosition.row] = null;
        }
    };

    this.unholdAll = () => {
        console.color('[RV]unholdAll', '#00ff00', '#000000');
        for (const reel in this._holdedSymbols) {
            for (const row in this._holdedSymbols[reel]) {
                this.unholdSymbol({reel: reel, row: row});
            }
        }
    };

    this.holdReel = (index) => {
        this._reels[index].hold();
    };

    this.unholdReel = (index) => {
        this._reels[index].unhold();
    };

    this.unholdAllReels = () => {
        for(let i = 0; i < this._reels.length; i++) {
            this._reels[i].unhold();
        }
    };

    /**
     * Данный метод не используется ни в коре, ни в классике.
     * К тому же, уничтожать символы в текущей слотмашине нельзя
     */
    this.destroySymbol = (symbolPosition, animation) => {
        console.color('[RV]destroySymbol', '#00ff00', '#000000');
    };

    this.normalizeReelsSymbolsPositions = (animation) => {
        console.color('[RV]destroySymbol', '#00ff00', '#000000');
    };

    this.changeSymbolPosition = (symbolPosition, newSymbolPosition, callback, animation) => {
        console.color('[RV]changeSymbolPosition', '#00ff00', '#000000');
    };

    this.appendSymbol = (symbolPosition, key, animation) => {
        console.color('[RV]appendSymbol', '#00ff00', '#000000');
    };

    this._createTempBlur = (symbolsBlurKeys, customKey) => {
        console.color('[RV]_createTempBlur', '#00ff00', '#000000');
    };

    this._getBlurKeys = (count, symbolsKeys) => {
        console.color('[RV]_getBlurKeys', '#00ff00', '#000000');
    };

    this.customReelStartCallback = (reel, startDelay, cb) => {
        nge.rafSetTimeout(cb, startDelay);
    };

    this.customReelStopCallback = (phaserReel, index) => {};

    this.reelSpinsStartTweenOnUpdateCallback = false;
    this.reelSpinsFinishTweenOnUpdateCallback = false;
});



nge.Com.SlotMachine.View = Class.extend(function () {
    var _self = this,
        _helper,
        _symbols,
        _container,
        _reelsContainer,
        _reels,
        _newReels,
        _reelsStoped = 0,
        _service,
        _animationSymbolsCovers = [],
        _reelTweens = [],
        _reelsSpeeds = [],
        _newReelsCfg,
        _blurs = [],
        _blursTemp = [],
        _speedUpReels = false,
        _additionalBlursRemain = false,
        _holdedSymbols = {},
        _holdedReels = {},
        _holdedSymbolsContainer = false,
        _intrigue = false,
        _textureZNeed = false,
        _newSymbolsDuration = [],
        _spinDirection = 'forward';  //  forward/reverse

    this._cfg;
    this._pool;
    this._symbolSize; // struct { width, height }  размеры ячейки ленты на экране
    this._reelsSymbols;
    this._speedReelsCustom = [];

    //spinDirection getter
    Object.defineProperties(this, {
        "spinDirection": {
            "get": function () {
                return _spinDirection;
            }
        }
    });

    this.deactivate = function () {
        _resetGlobals(_self._cfg);
    };
    this.destroy = function () {
        _resetGlobals(_self._cfg);
    };

    this.destroyReelsContainer = function () {
        _storeSymbols();
        _reelsContainer.parent.removeChild(_reelsContainer);
        _reelsContainer.destroy(true);
        _reelsContainer = null;
    };

    /**
     * SlotMachine creation (mask, reels, symbols, blurs)
     * @param {nge.Com.SlotMachine.Cfg.params} cfg
     * @param {nge.Com.SlotMachine.Service} service
     * @param {nge.Com.SlotMachine.Symbols} symbols
     * @param {Boolean} doNotResetPool
     * @returns {Boolean}
     */
    this.createSlotMachine = function (cfg, service, symbols, doNotResetPool) {
        _self._cfg = cfg;
        _service = service;

        if (!doNotResetPool) {
            _clearOldPool();
            _self._pool = _self.getInstance('Pool');
        }

        _helper = _self.getInstance('Helper');
        _symbols = symbols;

        _calcTextureZNeed();

        _resetGlobals(cfg, doNotResetPool);
        _container = nge.find('^' + _self._cfg.parentName);
        var cData = _container.getData();
        _reelsContainer = nge.objects.create(new nge.Mlm.Objects.Folder());
        _setSymbolSize(cData);
        _maskCreate();
        _container.add(_reelsContainer);

        _reelsSymbolsCreate();

        if (!doNotResetPool) {
            _symbolsCreate();
            _createBlurs();
            _createTempBlurs();
        }

        _createAnimationSymbolsCovers();

        return true;
    };

    var _clearOldPool = function () {
        if (_self._pool)
            _self._pool.reset();
    };

    var _calcTextureZNeed = function () {
        var items = _symbols.get();
        for (var i = 0; i < items.length; i++) {
            if (items[i].textureZ)
                _textureZNeed = true;
        }
    };

    this.setSymbol = function (data) {
        //{coords:[1,2], key:5}
        var coords = data.coords;
        var x = coords[0];
        var y = coords[1];
        var key = data.key;

        _storeSymbol(x, y);

        var symbol = _self._pool.release(key);
        _self._reelsSymbols[x][y] = symbol;
        _setDefaultCoords(symbol.texture, {row: y});            // VM: центровка относительно _reel. Поэтому смещение половина ширины _reel.
        _reels[x].addChild(symbol.texture);
        _self._displaySymbolCallback(symbol, _reels[x]);

        if (_textureZNeed) {
            var textureZ = (symbol.getConfig().textureZ) ? symbol.getConfig().textureZ : 0;
            symbol.texture.z = textureZ;
            symbol.texture.z += y * .01;
            _reels[x].sort();
        }
    };

    this.updateBlurs = function () {
        _createBlurs();
    };

    /**
     * Show symbols in reels
     * @param  {Object} initialSymbols
     * @param  {Boolean} isHistory
     * @return {Bolean} 
     */
    this.displaySymbols = function (initialSymbols, isHistory) {
        if (!_container)
            return false;

        _storeSymbols();
        _self._customClearSymbols();

        for (var j = 0; j < _self._cfg.mw; j++) {
            //before adding symbols into the reels need to remove old symbols, just in case.
            _reels[j].removeChildren();
            var mh = _getMH(j);

            for (var i = 0; i < mh; i++) {
                var symbol = _self._pool.release(initialSymbols[j][i]);
                _self._reelsSymbols[j][i] = symbol;
                _setDefaultCoords(symbol.texture, {row: i});  // VM: центровка относительно _reel. Поэтому смещение половина ширины _reel.
                _reels[j].addChild(symbol.texture);
                _self._displaySymbolCallback(symbol, _reels[j], isHistory);

                if (_textureZNeed) {
                    var textureZ = (symbol.getConfig().textureZ) ? symbol.getConfig().textureZ : 0;
                    symbol.texture.z = textureZ;
                    symbol.texture.z += i * .01;
                }
            }

            if (_textureZNeed)
                _reels[j].sort();
        }

        return true;
    };

    this._customClearSymbols = function () {};

    this._displaySymbolCallback = function (symbol, reel, isHistory) {};

    /**
     * Initiate individual reel spining
     *
     * @param {String} direction
     * @return {Boolean}
     */
    this.reelSpins = function (direction) {
        _spinDirection = direction ? direction : 'forward';
        _speedUpReels = false;
        _intrigue = false;
        _self._speedReelsCustom = [];
        _setNewReelsCfg(false);

        var firstReelHolded = false;

        var blurNumber = 0;
        for (var i = 0; i < _self._cfg.mw; i++) {
            if (_holdedReels[i]) {
                if (i === 0)
                    firstReelHolded = true;

                if (!_self._cfg.blursShiftOnReelsHold)
                    blurNumber++;

                continue;
            }

            var reel = _reels[i];
            var blurName = 'blur-' + blurNumber;
            var blur = _self._pool.release(blurName);

            blur._sysSmName = blurName;
            _appendBlur(reel, i, blur);
            _startReelTween(reel, i, blur, blurNumber);
            blurNumber++;
        }

        if (firstReelHolded)
            _reelAnimationComplete(false, 0);

        return true;
    };

    this.setNewReelsCfg = function (cfg) {
        _setNewReelsCfg(cfg);
    };

    var _setNewReelsCfg = function (cfg) {
        _newReelsCfg = cfg;
    };

    /**
     * Returns Symbol object by symbol position
     * @param  {Object} symbolPosition
     * 
     * @return {Object} Symbol
     */
    this.getSymbolByPosition = function (symbolPosition) {
        return _self._reelsSymbols[symbolPosition.reel][symbolPosition.row];
    };

    /**
     * 
     * @returns {Array} reels containers
     */
    this.getReels = function () {
        return _reels;
    };

    this.speedUpReels = function () {
        _self._speedReelsCustom = [];

        for (var i in _reelTweens) { //must be for..in
            var tween = _reelTweens[i];

            if (tween && tween.timeScale)
                tween.timeScale = _self._cfg.speedUpReelsFactor;
        }

        _speedUpReels = true;
    };

    this.changeBlursSpeed = function (speed) {
        for (var i in _reelTweens) { //must be for..in
            var tween = _reelTweens[i];
            var customSpeed = (speed[i]) ? speed[i] : speed;

            if (tween.timeScale)
                tween.timeScale = customSpeed;

            _self._speedReelsCustom[i] = customSpeed;
        }
    };

    this.showAnimationSymbolsCover = function (sp) {
        var coverObj;

        if (_animationSymbolsCovers && _animationSymbolsCovers[sp.reel])
            coverObj = _animationSymbolsCovers[sp.reel][sp.row];

        if (!coverObj)
            return false;

        coverObj.visible = true;
        _container.bringToTop(coverObj);
    };

    this.hideAnimationSymbolsCovers = function () {
        for (var j = 0; j < _animationSymbolsCovers.length; j++) {
            var rows = _animationSymbolsCovers[j];

            for (var i = 0; i < rows.length; i++) {
                var row = rows[i];

                if (row)
                    row.visible = false;
            }
        }
    };

    /**
     * Returns random generated symbols
     * @return {Array}
     */
    this.getRandomSymbolsTable = function () {
        var initialSymbols = [];

        for (var j = 0; j < _self._cfg.mw; j++) {
            var tCol = [];
            var mh = _getMH(j);

            for (var i = 0; i < mh; i++) {
                var name = _getRandomSymbolName();
                tCol.push(name);
            }

            initialSymbols.push(tCol);
        }
        return initialSymbols;
    };

    var _getRandomSymbolName = function () {
        var items = _symbols.get();
        var rand = nge.Lib.Helper.getRandomInt(0, items.length - 1);
        return items[rand].name;
    };

    this._getRandomSymbolName = _getRandomSymbolName;

    this.holdSymbol = function (symbolPosition, symbol) {
        _self.unholdSymbol(symbolPosition);

        var name = symbol.getName();
        var sTexture = symbol.texture;

        if (!_holdedSymbolsContainer) {
            var model = nge.Mlm.Objects.Folder({name: 'holdedSymbolsContainer'});
            _holdedSymbolsContainer = nge.objects.create(model, _container);
        }

        var modelI = nge.Mlm.Objects.Image({
            name: 'holdedSymbol_' + symbolPosition.reel + '_' + symbolPosition.row,
            assetKey: name,
            x: sTexture.x + sTexture.parent.x,
            y: sTexture.y + sTexture.parent.y,
            anchorX: 0.5,
            anchorY: 0.5
        });

        var texture = nge.objects.create(modelI, _holdedSymbolsContainer);

        _holdedSymbols[symbolPosition.reel][symbolPosition.row] = texture;
    };

    this.unholdSymbol = function (symbolPosition) {
        if (!symbolPosition)
            console.error('nge.Com.SlotMachine.View.unholdSymbol error: no symbolPosition');

        if (!_holdedSymbols[symbolPosition.reel])
            _holdedSymbols[symbolPosition.reel] = {};

        _destroyHold(symbolPosition.row, symbolPosition.reel);
    };

    this.unholdAll = function () {
        for (var y in _holdedSymbols) {
            for (var x in _holdedSymbols[y]) {
                _destroyHold(x, y);
            }
        }
    };

    this.holdReel = function (index) {
        _holdedReels[index] = true;
    };

    this.unholdReel = function (index) {
        _holdedReels[index] = false;
    };

    this.unholdAllReels = function () {
        _holdedReels = {};
    };

    /**
     * 
     * @param {object} symbolPosition
     * @param {function} animation
     * @returns {Boolean}
     */
    this.destroySymbol = function (symbolPosition, animation) {
        if (!_self._reelsSymbols[symbolPosition.reel][symbolPosition.row]) {
            console.error('nge.Com.SlotMachine.View destroySymbol error: no symbol in this position');
            return false;
        }

        var callback = function () {
            _storeSymbol(symbolPosition.reel, symbolPosition.row);
            nge.observer.fire('slotMachine.destroySymbolComplete', symbolPosition);
        };

        var symbol = _self._reelsSymbols[symbolPosition.reel][symbolPosition.row];

        if (!animation)
            animation = callback;

        return animation(symbol, symbolPosition, callback);
    };

    this.normalizeReelsSymbolsPositions = function (animation) {
        var symbolsInfo = {allCount: _self._cfg.mw * _self._cfg.mh, processed: 0};

        var callback = function () {
            symbolsInfo.processed++;

            if (symbolsInfo.processed === symbolsInfo.allCount) {
                nge.observer.fire('slotMachine.normalizeReelsSymbolsPositionsComplete');
            }
        };

        for (var i = 0; i < _self._reelsSymbols.length; i++) {
            for (var j = _self._reelsSymbols[i].length - 1; j >= 0; j--) {
                if (_self._reelsSymbols[i][j]) {
                    callback();
                    continue;
                }

                for (var k = j - 1; k >= 0; k--) {
                    if (_self._reelsSymbols[i][k]) {
                        _self.changeSymbolPosition({reel: i, row: k}, {reel: i, row: j}, callback, animation);
                        break;
                    }
                }

                if (!_self._reelsSymbols[i][j])
                    callback();
                //break;
            }
        }
    };

    this.changeSymbolPosition = function (symbolPosition, newSymbolPosition, callback, animation) {
        if (
            !_self._reelsSymbols[symbolPosition.reel][symbolPosition.row] ||
            _self._reelsSymbols[newSymbolPosition.reel][newSymbolPosition.row]
            ) {
            console.error('nge.Com.SlotMachine.View changeSymbolPosition error: wrong incoming data');
            return false;
        }

        var symbol = _self._reelsSymbols[symbolPosition.reel][symbolPosition.row];
        _self._reelsSymbols[newSymbolPosition.reel][newSymbolPosition.row] = symbol;
        _setDefaultCoords(symbol.texture, newSymbolPosition);
        delete _self._reelsSymbols[symbolPosition.reel][symbolPosition.row];

        var customCallback = function () {
            if (callback)
                callback();

            nge.observer.fire('slotMachine.changeSymbolPositionComplete', symbolPosition);
        };

        if (!animation)
            animation = customCallback;

        return animation(symbol, symbolPosition, newSymbolPosition, customCallback);
    };

    this.appendSymbol = function (symbolPosition, key, animation) {
        if (_self._reelsSymbols[symbolPosition.reel][symbolPosition.row]) {
            console.error('nge.Com.SlotMachine.View appendSymbol error: symbol already exists in this position');
            return false;
        }

        var phaserReel = _reels[symbolPosition.reel];
        var symbol = _self._pool.release(key);

        _self._reelsSymbols[symbolPosition.reel][symbolPosition.row] = symbol;
        _setDefaultCoords(symbol.texture, symbolPosition);
        phaserReel.addChild(symbol.texture);

        if (_textureZNeed) {
            var textureZ = (symbol.getConfig().textureZ) ? symbol.getConfig().textureZ : 0;
            symbol.texture.z = textureZ;
            symbol.texture.z += symbolPosition.row * .01;
            phaserReel.sort();
        }

        var callback = function () {
            nge.observer.fire('slotMachine.appendSymbolComplete', symbolPosition);
        };

        if (!animation)
            animation = callback;

        return animation(symbol, symbolPosition, callback);
    };

    var _setDefaultCoords = function (texture, symbolPosition) {
        texture.y = (symbolPosition.row + 0.5) * _self._symbolSize.height;
        texture.x = _self._symbolSize.width / 2;
    };

    var _destroyHold = function (x, y) {
        if (_holdedSymbols[y][x]) {
            _holdedSymbols[y][x].destroy(true);
            _holdedSymbols[y][x] = null;
        }
    };

    var _getMH = function (row) {
        var mh = _self._cfg.mh;

        if (_self._cfg.mhv)
            mh = _self._cfg.mhv[row];

        return mh;
    };

    var _createAnimationSymbolsCovers = function () {
        var offsetX = 0;
        var offsetY = 0;

        for (var j = 0; j < _self._cfg.mw; j++) {
            _animationSymbolsCovers[j] = [];
            var mh = _getMH(j);

            if (_self._cfg.rowsXoffset)
                offsetX = _self._cfg.rowsXoffset[j];

            if (_self._cfg.rowsYoffset)
                offsetY = _self._cfg.rowsYoffset[j];

            for (var i = 0; i < mh; i++) {
                var coverKey = 'animateSymbolCover-' + j + '-' + i;
                var coverCheckObj = nge.findOne('^' + coverKey);

                if (coverCheckObj) {
                    _animationSymbolsCovers[j][i] = coverCheckObj;
                    continue;
                }

                var coverCheckImage = nge.game.cache.checkImageKey(coverKey);

                if (!coverCheckImage)
                    continue;

                //create cover
                var cover = new nge.Mlm.Objects.Image({
                    name: coverKey, assetKey: coverKey,
                    x: (j + 0.5) * _self._symbolSize.width + offsetX,
                    y: (i + 0.5) * _self._symbolSize.height + offsetY,
                    'anchorX': 0.5, 'anchorY': 0.5, isVisible: false
                });
                var coverObj = nge.objects.create(cover, _container);
                _animationSymbolsCovers[j][i] = coverObj;
            }
        }
    };

    var _setSymbolSize = function (cData) {
        _self._symbolSize = {
            width: cData.width / _self._cfg.mw,
            height: cData.height / _self._cfg.mh
        };
        return _self._symbolSize;
    };

    /**
     * Resets global vars to defaults
     * @param {nge.Com.SlotMachine.Cfg.params} cfg 
     * @param {Boolean} doNotResetPool 
     *
     * @return {undefined}
     */
    var _resetGlobals = function (cfg, doNotResetPool) {
        _storeSymbols();

        _holdedSymbolsContainer = false;
        _self._reelsSymbols = [];
        _reels = [];
        _newReels = [];
        _blurs = [];
        _blursTemp = [];

        for (var k in _reelTweens)
            _reelTweens[k].stop();

        _reelTweens = [];
        _reelsStoped = 0;
        _additionalBlursRemain = false;
        _intrigue = false;

        if (_self._pool && !doNotResetPool)
            _self._pool.reset();
    };

    /**
     * Stores not needed symbols to symbols Pool.
     *
     * @return {Boolean}
     */
    var _storeSymbols = function () {
        if (!_self._reelsSymbols || !_self._reelsSymbols.length)
            return false;

        for (var i = 0; i < _self._reelsSymbols.length; i++) {
            for (var j = 0; j < _self._reelsSymbols[i].length; j++) {
                _storeSymbol(i, j);
            }
        }

        return true;
    };

    var _storeSymbol = function (x, y) {
        if (!_self._reelsSymbols || !_self._reelsSymbols.length || !_self._reelsSymbols[x] || !_self._reelsSymbols[x][y])
            return false;

        _reels[x].remove(_self._reelsSymbols[x][y].texture);
        _self._reelsSymbols[x][y].reset();
        _self._pool.store(false, _self._reelsSymbols[x][y]);
        _self._reelsSymbols[x][y] = null;
    };

    /**
     * Add mask to slotMachine
     *
     * @return {undefined}
     */
    var _maskCreate = function () {
        //Creating mask for reels container;
        var cData = _container.getData();

        var maskContainer = nge.find('^' + _self._cfg.maskName);

        if (!maskContainer)
            maskContainer = _reelsContainer;

        var mData = (maskContainer && maskContainer.getData().width > 0 && maskContainer.getData().height > 0) ?
            maskContainer.getData() : cData;

        var rects = [];

        if (!_self._cfg.rowsXoffset && !_self._cfg.rowsYoffset && !_self._cfg.mhv)
            rects = [0, 0, mData.width, mData.height];
        else {
            for (var i = 0; i < _self._cfg.mw; i++) {

                var width = mData.width / _self._cfg.mw;
                var height = mData.height;
                var x = i * width;
                var y = 0;

                if (_self._cfg.rowsXoffset && _self._cfg.rowsXoffset[i])
                    x += _self._cfg.rowsXoffset[i];

                if (_self._cfg.rowsYoffset && _self._cfg.rowsYoffset[i])
                    y += _self._cfg.rowsYoffset[i];

                if (_self._cfg.mhv && _self._cfg.mhv[i])
                    height = mData.height * _self._cfg.mhv[i] / _self._cfg.mh;

                rects.push([x, y, width, height]);
            }
        }

        var mask = nge.objects.create(new nge.Mlm.Objects.Mask({rects: rects}), maskContainer, true);
        maskContainer.mask = mask;
    };

    /**
     * Creates reels containers
     *
     * @return {undefined}
     */
    var _reelsSymbolsCreate = function () {
        var reel;
        var cData = _reelsContainer.parent.getData();

        for (var i = 0; i < _self._cfg.mw; i++) {
            reel = nge.objects.create(new nge.Mlm.Objects.Folder());
            reel.width = _self._symbolSize.width;
            reel.height = cData.height;
            reel.x = i * _self._symbolSize.width;
            reel.y = 0;

            if (_self._cfg.rowsXoffset && _self._cfg.rowsXoffset[i])
                reel.x += _self._cfg.rowsXoffset[i];

            if (_self._cfg.rowsYoffset && _self._cfg.rowsYoffset[i])
                reel.y += _self._cfg.rowsYoffset[i];

            _reelsContainer.add(reel);
            _reels.push(reel);
            _self._reelsSymbols.push([]);
            _newReels.push([]);
        }
    };

    /**
     * Creates symbols and store them to Symbols Pool
     * @return {undefined}
     */
    var _symbolsCreate = function () {
        //creating Symbols
        var items = _symbols.get();
        var count = _self._cfg.mw * (_self._cfg.mh * 2 + 1);

        for (var k = 0; k < count; k++) {
            var symbol = _self.getInstance('Symbol');
            symbol.init(false, _self._symbolSize, _container);
            symbol.setView(_self);
            _self._pool.store(false, symbol);
        }
    };

    var _createTempBlurs = function () {
        var symbolsBlurKeys = _self._cfg.symbolsBlurKeys;

        for (var i = 0; i < (_self._cfg.mw * 3); i++) {
            if (_self._cfg.symbolsBlurKeys && _self._cfg.symbolsBlurKeys[i] && typeof _self._cfg.symbolsBlurKeys[i] === 'object')
                symbolsBlurKeys = _self._cfg.symbolsBlurKeys[i];

            _self._createTempBlur(symbolsBlurKeys);
        }
    };

    this._createTempBlur = function (symbolsBlurKeys, customKey) {
        var key = (customKey) ? customKey : 'blurTemp';
        var th = _self._cfg.mh;
        var blur = _createBlur(th, symbolsBlurKeys);
        blur.key = key;
        _self._pool.store(key, blur);
    };

    /**
     * Creates blurs for each reel and store them to Symbols Pool
     *
     * @return {undefined}
     */
    var _createBlurs = function () {
        var blur;
        var symbolsBlurKeys = _self._cfg.symbolsBlurKeys;
        var lastSymbolsBlurStaticKeys = _self._cfg.lastSymbolsBlurStaticKeys;

        for (var i = 0; i < _self._cfg.mw; i++) {
            if (_self._cfg.symbolsBlurKeys && _self._cfg.symbolsBlurKeys[i] && typeof _self._cfg.symbolsBlurKeys[i] === 'object')
                symbolsBlurKeys = _self._cfg.symbolsBlurKeys[i];

            if (_self._cfg.lastSymbolsBlurStaticKeys && typeof _self._cfg.lastSymbolsBlurStaticKeys[i] !== 'undefined')
                lastSymbolsBlurStaticKeys = _self._cfg.lastSymbolsBlurStaticKeys[i];

            var blurIsset = _self._pool.check('blur-' + i);
            if (blurIsset)
                _destroyBlur('blur-' + i);

            var th = (typeof _self._cfg.th === 'number') ? _self._cfg.th : _self._cfg.th[i];
            blur = _createBlur(th, symbolsBlurKeys, lastSymbolsBlurStaticKeys);
            _self._pool.store('blur-' + i, blur);
        }
    };

    var _destroyBlur = function (key) {
        var blur = _self._pool.release(key);
        blur.texture.destroy(true, true);
        blur.destroy(true, true);
        blur.key = false;
        blur.game = false;
        //delete(blur); //we must null at first (garbage collector peculiarity)
        blur = null;
        //delete(blur);

        return true;
    };

    this._getBlurKeys = function (count, symbolsKeys) {
        var blurKeys = [];
        var lastKey = false;

        var getBlurRandomKey = function (lastKey) {
            if (symbolsKeys.length === 0) {
                console.error('nge.Com.SlotMachine.View _createBlur getBlurRandomKey error: symbolsKeys.length = 0');
                return false;
            }

            if (symbolsKeys.length === 1)
                return symbolsKeys[0];

            var key = symbolsKeys[~~(Math.random() * symbolsKeys.length)];

            if (lastKey !== key)
                return key;
            else
                return getBlurRandomKey(lastKey);
        };

        for (var i = 0; i < count; i++) {
            lastKey = getBlurRandomKey(lastKey);
            blurKeys.push(lastKey);
        }

        return blurKeys;
    };

    /**
     * Creates single blur from symbols
     * Создает спрайт-полосу из символов, генерирует картинку, которую помещает в текстуру.
     * Примечание: спрайты могут иметь разную ширину, при этом на ленте они должны быть выровнены по центру.
     * @param  {Number} bluredSymbols [how many symbols will be in the blur]
     * @param  {Array} symbolsKeys [names of symbols which can be added to blur]
     * @param  {Array} lastSymbolsStaticKeys [names of symbols which will be added to end of the blur]
     *
     * @return {Object} [Phaser.Sprite object]
     */
    var _createBlur = function (bluredSymbols, symbolsKeys, lastSymbolsStaticKeys) {
        var blurAlpha = _self._cfg.blurAlpha;

        var sprite;
        var container = nge.objects.create(new nge.Mlm.Objects.Folder());
        var blur;

        //_container.add(container); // deprecated at 06/10/2016 by Serg
        var curState = nge.statesManager.getCurrentName();
        var ps = nge.findOne('^' + curState + 'State');
        ps.add(container);

        // Собираем спрайты в список,
        // определяем ширину списка (как ширина максимального),
        // после этого выводим по центру X в container.
        var sprites = [];
        var maxwidth = 0;
        var blurKeys = _self._getBlurKeys(bluredSymbols, symbolsKeys);

        for (var i = 0; i < bluredSymbols; i++) {
            var key = blurKeys[i];

            //lastSymbolsStaticKeys
            if (lastSymbolsStaticKeys && lastSymbolsStaticKeys.length > 0) {
                var lastSymbolsIndex = i + lastSymbolsStaticKeys.length - bluredSymbols;

                if (lastSymbolsIndex >= 0)
                    key = lastSymbolsStaticKeys[lastSymbolsIndex];
            }

            sprite = nge.objects.create(new nge.Mlm.Objects.Image({
                assetKey: key
            }));
            sprite.scale.x = sprite.scale.y = 1;
            _helper.setTextureSize(sprite, _self._symbolSize, _self._cfg);

            if (sprite.width > maxwidth)
                maxwidth = sprite.width;

            sprite.position.y = (i + 0.5) * _self._symbolSize.height;
            sprite.anchor.x = 0;
            sprite.anchor.y = 0.5;
            sprite.alpha = blurAlpha;

            var symbolsCfg = _symbols.get();

            if (_textureZNeed) {
                var symbolCfg = symbolsCfg.filter(function (el) {
                    return el.name === key;
                })[0];

                var textureZ = (symbolCfg.textureZ) ? symbolCfg.textureZ : 0;
                sprite.z = textureZ + i * .01;
            }

            sprites[i] = sprite;
        }

        for (var i = 0; i < bluredSymbols; i++) {
            sprite = sprites[i];
            sprite.position.x = (maxwidth - sprite.width) / 2;
            container.addChild(sprite);
        }

        if (_textureZNeed)
            container.sort();

        //need only original scale size
        container.scale.x = 1 / ps.worldScale.x;
        container.scale.y = 1 / ps.worldScale.y;

        const texture = nge.objects.generateTexture(container);
        // //var texture = container.generateTexture();
        // ///////////////////////////////////////// some magic with texture generation start
        // var bounds = container.getLocalBounds();
        // var renderTexture = new Phaser.RenderTexture(nge.game, bounds.width | 0, bluredSymbols * _self._symbolSize.height);
        // PIXI.DisplayObject._tempMatrix.tx = 0;
        // PIXI.DisplayObject._tempMatrix.ty = 0;
        // renderTexture.render(container, PIXI.DisplayObject._tempMatrix);
        // var texture = renderTexture;
        // ///////////////////////////////////////// some magic with texture generation end

        blur = nge.objects.create(new nge.Mlm.Objects.Image({
            assetKey: '1px_empty',
            class: '_slotMachineBlur'
        }), null, true, true);
        blur.loadTexture(texture);
        blur.scale.set(1, 1);
        blur.x = _self._symbolSize.width / 2;
        // blur.scale.x = blur.scale.y = 1;
        // blur.x = _self._symbolSize.width / 2;  // спрайт полосы будет сдвинут на середину колеса (относительно ширины колеса)
        blur.anchor.x = 0.5;
        container.destroy({children: true, texture: false, baseTexture: false});
        // container.game = false;
        // container.destroy(true);
        // container = null;
        // delete(container);

        return blur;
    };

    var _getReelOffsetY = function (reelIndex) {
        var offsetY = 0;

        if (_self._cfg.rowsYoffset && _self._cfg.rowsYoffset[reelIndex])
            offsetY = _self._cfg.rowsYoffset[reelIndex];

        return offsetY;
    };

    /**
     * Create tween for reel spin animation
     * @param  {Object} phaserReel
     * @param  {Number} reelIndex 
     * @param  {Object} blur
     * @param  {Number} speedIndex (if holded reels) 
     *
     * @return {Object} [Phaser.Tween object]
     */
    var _startReelTween = function (phaserReel, reelIndex, blur, speedIndex) {
        if (typeof speedIndex === 'undefined' || speedIndex === null)
            speedIndex = reelIndex;

        var mh = _getMH(speedIndex);
        var tweenDuration = _self._cfg.tweenDuration;
        var delay = _self._cfg.tweenStartInterval;
        var startDelay = speedIndex * delay;
        var reelTween;

        var blurDuration = tweenDuration.blur + speedIndex * _self._cfg.tweenEndInterval;

        if (tweenDuration.blurDurationType === 'factor') {
            var th = (typeof _self._cfg.th === 'number') ? _self._cfg.th : _self._cfg.th[speedIndex];
            blurDuration = th * tweenDuration.blur + speedIndex * _self._cfg.tweenEndInterval;
        }

        var oldSymbolsDuration = (tweenDuration.symbolsDurationType === 'factor') ?
            (typeof _self._cfg.mhv === 'number') ? _self._cfg.mhv * tweenDuration.oldSymbols : _self._cfg.mhv[speedIndex] * tweenDuration.oldSymbols :
            tweenDuration.oldSymbols;

        _newSymbolsDuration[reelIndex] = (tweenDuration.symbolsDurationType === 'factor') ?
            (typeof _self._cfg.mhv === 'number') ? _self._cfg.mhv * tweenDuration.newSymbols : _self._cfg.mhv[speedIndex] * tweenDuration.newSymbols :
            tweenDuration.newSymbols;

        var tweenFullDuration = oldSymbolsDuration + blurDuration + _newSymbolsDuration[reelIndex];

        //check if tween needed
        var tweenNeeded = (tweenFullDuration > 0);

        var globalOffsetY = _getReelOffsetY(reelIndex);

        //if tweenNeeded creating tween
        if (tweenNeeded) {
            reelTween = nge.tween.add(phaserReel, _self._cfg.tweenType === 'custom');

            var res = _self.customReelStartCallback(phaserReel, reelIndex, reelTween, startDelay);

            if (res) {
                reelTween = res.tween;
                startDelay = res.startDelay;
            }

            _reelTweens[reelIndex] = reelTween;
        }

        var targetY = (_spinDirection === 'forward') ?
            blur.height + globalOffsetY : -blur.height + globalOffsetY;

        var oldSymbolsAnimation = function () {
            var to = (_spinDirection === 'forward') ?
                _self._symbolSize.height * mh + globalOffsetY :
                -_self._symbolSize.height * mh + globalOffsetY;

            if (oldSymbolsDuration > 0) {
                reelTween.to({
                    y: to
                }, oldSymbolsDuration, nge.Lib.Tween.Easing.Quartic.In, false, startDelay);
            } else {
                phaserReel.y = to;
            }
        };

        var blurAnimation = function () {
            if (tweenDuration.blur > 0) {
                reelTween.to({
                    y: targetY
                }, blurDuration, nge.Lib.Tween.Easing.Linear.None, false);
            } else {
                phaserReel.y = targetY;
            }
        };

        if (tweenNeeded && tweenDuration.animationType === 'linear') {
            var fullLen = blur.height + _self._symbolSize.height * mh;
            var speed = fullLen / (tweenFullDuration - oldSymbolsDuration);
            _reelsSpeeds[reelIndex] = speed;
            var duration = blur.height / speed;

            reelTween.to({
                y: targetY
            }, duration, nge.Lib.Tween.Easing.Linear.None, false, startDelay);
        } else {
            oldSymbolsAnimation();
            blurAnimation();
        }

        if (tweenNeeded) {
            //if tweenNeeded start animation
            reelTween.onStart.addOnce(function () {
                //Ivents must be fired after animation starts. But delay is not count.
                //Phasers issue.
                nge.observer.fire('slotMachine.reelAnimationStart', reelIndex, startDelay);
                nge.observer.fire('slotMachine.reel_' + reelIndex + '.animation.start', startDelay);
            });

            var callback = function (a, b, c, d) {
                _reelAnimationStepEnd(phaserReel, reelIndex, blur);
            };

            reelTween.onUpdateCallback(function (tween, progress, tweenData) {

                if (_self.reelSpinsStartTweenOnUpdateCallback)
                    _self.reelSpinsStartTweenOnUpdateCallback(tween, progress, tweenData);
            }, this);

            reelTween.onComplete.addOnce(callback, this);

            reelTween.start();
        } else {
            _reelAnimationComplete(phaserReel, reelIndex, blur); //todo rewrite --> spinResult checker... mb _reelAnimationComplete calls
        }

        return true;
    };

    /**
     *
     * @param  {PhaserObject} phaserReel
     * @param  {Number} reelIndex
     * @param  {Object} blur
     *
     * @return {undefined}
     */
    var _appendBlur = function (phaserReel, reelIndex, blur) {
        //adding blur into the reels
        // don't need to touch blur.x - it's already on the right place.
        var mh = _getMH(reelIndex);
        var globalOffsetY = _getReelOffsetY(reelIndex);

        blur.y = (_spinDirection === 'forward') ? -blur.height : mh * _self._symbolSize.height + globalOffsetY;
        phaserReel.addChild(blur);
        _blurs[reelIndex] = blur;
    };

    /**
     * Single reel animation end callback
     * @param  {PhaserObject} phaserReel
     * @param  {Number} index
     * @param  {Object} blur
     *
     * @return {undefined}
     */
    var _reelAnimationStepEnd = function (phaserReel, index, blur) {
        if (!_additionalBlursRemain) {
            _additionalBlursRemain = [];

            for (var i = 0; i < _self._cfg.mw; i++)
                _additionalBlursRemain[i] = 0;
        }

        //intrigue
        /*
         done: true
         startsFrom: 3
         endsFrom: 5 (option)
         status: true
         */
        var intrigue = nge.localData.get('slotMachineIntrigue');

        if (_newReelsCfg && intrigue && intrigue.status && !intrigue.done) {
            nge.localData.set('slotMachineIntrigue.done', true);
            var rCounter = 1;

            for (var i = intrigue.startsFrom; i < _self._cfg.mw; i++) {
                _additionalBlursRemain[i] += rCounter * 5;
                rCounter++;
            }
            _intrigue = true;
        }

        //chk AdditionalBlurs
        var additionalBlurs = nge.localData.get('slotMachineAdditionalBlurs'); //additionalBlurs: [5,10,15,20,25] //optional

        if (_newReelsCfg && additionalBlurs) {
            for (var i = 0; i < additionalBlurs.length; i++) {
                if (additionalBlurs[i])
                    _additionalBlursRemain[i] += additionalBlurs[i];

                if (_additionalBlursRemain[i] < 0)
                    _additionalBlursRemain[i] = 0;
            }
        }
        nge.localData.set('slotMachineAdditionalBlurs', false);

        //chk finish spin
        if (_newReelsCfg && (_speedUpReels || _additionalBlursRemain[index] <= 0)) {
            _reelSpinsFinish(index);
            return false;
        }

        if (index === 0 && _additionalBlursRemain[0] === 0)
            for (var i = 0; i < _self._cfg.mw; i++)
                _additionalBlursRemain[i]++;

        _additionalBlursRemain[index]--;

        //intrigue speed up ?
        if (
            !_speedUpReels && _intrigue && !_self._speedReelsCustom[index] &&
            (_reelTweens[index - 1] && !_reelTweens[index - 1].isRunning)
            ) {
            var endsFrom = (intrigue.endsFrom) ? intrigue.endsFrom : _self._cfg.mw;
            for (var i = intrigue.startsFrom; i < endsFrom; i++) {
                var factor = _self._cfg.intrigueSpeedReelsFactor;
                _self._speedReelsCustom[i] = factor;

                if (_reelTweens[i])
                    _reelTweens[i].timeScale = factor;
            }
        }

        //else append temp blur
        if (!_blursTemp[index])
            _blursTemp[index] = [];

        //chk AdditionalBlursKeys
        /**
         * additionalBlursKeys: [
         *     ['blurTemp_32', 'blurTemp_44'],
         *     ['blurTemp_32', 'blurTemp_44', 'blurTemp_44'],
         *     ['blurTemp_32', 'blurTemp_44'],
         *     ['blurTemp_32', 'blurTemp_44', 'blurTemp_44', 'blurTemp_44'],
         *     ['blurTemp_32', 'blurTemp_44', 'blurTemp_44', 'blurTemp_66', 'blurTemp_43']
         * ] //optional
         * 
         * @type mixed|Object
         */
        var additionalBlursKeys = nge.localData.get('slotMachineAdditionalBlursKeys');

        var tempBlurKey = 'blurTemp';
        if (
            _newReelsCfg &&
            additionalBlursKeys &&
            additionalBlursKeys[index] &&
            additionalBlursKeys[index][_additionalBlursRemain[index]]
            )
            tempBlurKey = additionalBlursKeys[index][_additionalBlursRemain[index]];

        var blurTemp = _self._pool.release(tempBlurKey);

        if (!blurTemp)
            return false;

        //y fixing start
        var minY = Infinity;

        for (var i = 0; i < phaserReel.children.length; i++) {
            var elY = phaserReel.children[i].y;
            if (minY > elY)
                minY = elY;
        }

        minY -= blurTemp.height;  //blurTemp will be min

        if (minY !== Infinity) {
            for (var i = 0; i < phaserReel.children.length; i++) {
                phaserReel.children[i].y -= minY;
            }

            phaserReel.y += minY;
        }
        //y fixing End

        _blursTemp[index].push(blurTemp);

        //adding blurTemp into the reels
        var blurHeight;
        blurHeight = blurTemp.height;

        var lastChild = phaserReel.children[(phaserReel.children.length - 1)];
        blurTemp.y = (_spinDirection === 'forward') ? lastChild.y - blurHeight : lastChild.y + lastChild.height;
        phaserReel.addChild(blurTemp);

        //if _blursTemp > 2  --
        if (_blursTemp[index].length > 2) {
            var blurUnused = _blursTemp[index].shift();
            phaserReel.removeChild(blurUnused);
            var blurTempKey = blurUnused.key ? blurUnused.key : 'blurTemp';
            _self._pool.store(blurTempKey, blurUnused);
        }

        if (_blurs[index] && phaserReel.y >= _blurs[index].height + blurTemp.height)
            _storingMainBlur(phaserReel, index);

        _storeOldSymbols(phaserReel, index);

        //_increaseReelsY(phaserReel, index);

        //and tween it 
        var globalOffsetY = _getReelOffsetY(index);
        var mh = _getMH(index);

        var targetY = (_spinDirection === 'forward') ?
            globalOffsetY :
            phaserReel.y - _self._symbolSize.height * mh + globalOffsetY;

        _newSymbolsAnimate(phaserReel, index, _reelAnimationStepEnd, targetY);
    };

    /**
     * Single reel animation end callback
     * @param  {PhaserObject} phaserReel
     * @param  {Number} index
     *
     * @return {undefined}
     */
    var _reelAnimationComplete = function (phaserReel, index) {
        nge.observer.fire('slotMachine.reel_' + index + '.animation.stop');

        if (phaserReel) {
            _storeOldSymbols(phaserReel, index);
            _self._reelsSymbols[index] = _newReels[index];

            _storingMainBlur(phaserReel, index);

            if (_blursTemp[index]) {
                for (var i = 0; i < _blursTemp[index].length; i++) {
                    var blurTemp = _blursTemp[index][i];
                    phaserReel.removeChild(blurTemp);
                    var blurTempKey = blurTemp.key ? blurTemp.key : 'blurTemp';
                    _self._pool.store(blurTempKey, blurTemp);
                }

                _blursTemp[index] = [];
            }

            //reset reel
            var stopY = 0;

            if (_self._cfg.rowsYoffset && _self._cfg.rowsYoffset[index])
                stopY = _self._cfg.rowsYoffset[index];

            phaserReel.y = stopY;

            for (var i = 0; i < _self._reelsSymbols[index].length; i++) {
                _setDefaultCoords(_self._reelsSymbols[index][i].texture, {row: i});
            }
        }

        _reelStopCallback(phaserReel, index);
        nge.observer.fire('slotMachine.reel_' + index + '.animation.stopped');

        //chk next
        if (_holdedReels[index + 1])
            _reelAnimationComplete(false, index + 1);
    };

    this.customReelStartCallback = function (phaserReel, index, tween, startDelay) {
        return {tween: tween, startDelay: startDelay};
    };

    this.customReelStopCallback = function (phaserReel, index) { };

    var _increaseReelsY = function (phaserReel, index) {
        //todo (_spinDirection === 'forward') before usage
        var curY = phaserReel.y;

        for (var i = 0; i < phaserReel.children.length; i++)
            phaserReel.children.y += curY;
    };

    var _storeOldSymbols = function (phaserReel, index) {
        //storing not used symbols
        var symbol;

        for (var i = 0; i < _self._reelsSymbols[index].length; i++) {
            symbol = _self._reelsSymbols[index][i];

            phaserReel.removeChild(symbol.texture);
            _self._pool.store(false, symbol);
        }
        _self._reelsSymbols[index].splice(0, _self._reelsSymbols[index].length);
    };

    var _storingMainBlur = function (phaserReel, index) {
        //storing blurs
        if (_blurs[index]) {
            var blur = _blurs[index];
            phaserReel.removeChild(blur);

            var blurName = 'blur-' + index;
            if (blur._sysSmName) {
                blurName = blur._sysSmName;
                delete blur._sysSmName;
            }

            _self._pool.store(blurName, blur);
            _blurs[index] = false;
        }
    };

    /**
     * Single reel stop callback
     *
     * @param {PhaserObject} phaserReel
     * @param  {Number} index
     * @return {undefined}
     */
    var _reelStopCallback = function (phaserReel, index) {
        _reelsStoped++;
        _self.customReelStopCallback(phaserReel, index);

        if (_reelsStoped === _self._reelsSymbols.length) {
            //all reels stoped
            _reelTweens = [];
            _reelsStoped = 0;
            _additionalBlursRemain = false;
            _intrigue = false;

            nge.rafSetTimeout(function () {
                _service.spinCompleteCallback();
            }, _self._cfg.spinCompleteDelay);
        }
    };


    //////////////////////////////////////////////////////////////////////////
    /**
     * 
     * @param  {Number} index
     * @returns {Boolean}
     */
    var _reelSpinsFinish = function (index) {
        var reel = _reels[index];
        _appendNewSymbols(reel, index, _newReelsCfg[index]);
        _newSymbolsAnimate(reel, index, _reelAnimationComplete);

        if (_self.reelSpinsFinishTweenOnUpdateCallback)
            _reelTweens[index].onUpdateCallback(_self.reelSpinsFinishTweenOnUpdateCallback, this);

        return true;
    };

    this.reelSpinsStartTweenOnUpdateCallback = false;
    this.reelSpinsFinishTweenOnUpdateCallback = false;

    /**
     * 
     * @param  {PhaserObject} phaserReel
     * @param  {Number} reelIndex
     * @param  {Array} newSymbols
     * 
     * @returns {undefined}
     */
    var _appendNewSymbols = function (phaserReel, reelIndex, newSymbols) {
        var symbol;
        var lastY = 0;
        var lastElement = phaserReel.children[(phaserReel.children.length - 1)];

        if (phaserReel.children.length > 0)
            lastY = phaserReel.children[(phaserReel.children.length - 1)].y;

        //adding new symbols into the reels
        _newReels[reelIndex] = [];
        var mh = _getMH(reelIndex);

        for (var j = 0; j < mh; j++) {
            var key = newSymbols[j];
            symbol = _self._pool.release(key);
            _newReels[reelIndex].push(symbol);

            symbol.texture.y = (_spinDirection === 'forward') ?
                (j + 0.5 - mh) * _self._symbolSize.height + lastY :
                (j + 0.5) * _self._symbolSize.height + lastY + lastElement.height;

            symbol.texture.x = _self._symbolSize.width / 2;
            phaserReel.addChild(symbol.texture);


            if (_textureZNeed) {
                var textureZ = (symbol.getConfig().textureZ) ? symbol.getConfig().textureZ : 0;
                symbol.texture.z = textureZ;
                symbol.texture.z += j * .01;
            }
        }

        if (_textureZNeed)
            phaserReel.sort();

        nge.observer.fire('slotMachine.reel.newSymbolsAppended', reelIndex);
    };

    var _newSymbolsAnimate = function (phaserReel, reelIndex, callback, targetY) {
        var tweenDuration = _self._cfg.tweenDuration;
        var globalOffsetY = _getReelOffsetY(reelIndex);
        var mhv = (_self._cfg.mhv && _self._cfg.mhv[reelIndex]) ? _self._cfg.mhv[reelIndex] : _self._cfg.mh;

        if (typeof targetY === 'undefined')
            targetY = (_spinDirection === 'forward') ?
                phaserReel.y + _self._symbolSize.height * mhv :
                phaserReel.y - _self._symbolSize.height * mhv;

        var speedFactor = 1;

        if (_self._speedReelsCustom[reelIndex])
            speedFactor = _self._speedReelsCustom[reelIndex];
        else if (_speedUpReels)
            speedFactor = _self._cfg.speedUpReelsFactor;

        //TODO выяснить откуда берется этот долбанный спрайт
        //почему у основных блюров в конце y=10140 ?
        /*if (phaserReel.children[0].y > 10000) {
         log(1111, phaserReel.children[0])
         phaserReel.children[0].destroy(true);
         }*/

        if (_self._cfg.tweenType === 'custom') {
            var reelTween = _reelTweens[reelIndex];
        } else {
            var reelTween = nge.tween.add(phaserReel);
            _reelTweens[reelIndex] = reelTween;
        }

        var newSymbolsAnimation = function () {
            if (_newSymbolsDuration[reelIndex] > 0) {
                reelTween.to({
                    y: targetY
                }, _newSymbolsDuration[reelIndex], nge.Lib.Tween.Easing.Quartic.Out, true);
            } else {
                phaserReel.y = targetY;
            }
        };

        if (tweenDuration.animationType === 'linear') {
            var dur = Math.abs(targetY - phaserReel.y) / _reelsSpeeds[reelIndex]; //todo n*_self._symbolSize.height, where n=symbols count (if needs)

            reelTween.to({
                y: targetY
            }, dur, nge.Lib.Tween.Easing.Linear.None, true);
        } else {
            newSymbolsAnimation();
        }

        reelTween.onComplete.addOnce(function () {
            callback(phaserReel, reelIndex);
        });

        reelTween.timeScale = speedFactor;
    };
});



nge.Com.SpinButton = {};



nge.Com.SpinButton.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _spinButtonName = 'spinButtonButton';
    var _spinButtonText = 'spinButtonText';
    var _spinButtonContainer = 'spinButton';
    var _stopButtonContainer = 'stopButton';
    var _spinButtonMaxSprite = '/btn_spin_maxbet.png';
    var _spinButtonRegularSprite = '/btn_spin_regular.png';
    //system
    var _spinButton;
    var _autospinStopButton;
    var _freeSpinButton;

    this.create = function () {
        this.createDefault();

        if (!_created)
            _subscribe();

        _spinButton = nge.find('^' + _spinButtonContainer);
        _autospinStopButton = nge.find('^' + _stopButtonContainer);
        _freeSpinButton = nge.find('^' + 'freeSpinButton');

        var restoreGame = nge.localData.get('brain.restoreGame');
        if (restoreGame && restoreGame.lastResponse && restoreGame.lastResponse.state === 'FreeSpinReady') {
            _spinButtonDisable();
        }

        _created = true;
        return true;
    };

    var _spinRegular = function () {
        var freeGameInProgress = nge.localData.get('freeGame.inProgress');
        var spinButtonText = nge.find('^' + _spinButtonText);
        _autospinStopButton.visible = false;
        _freeSpinButton.visible = false;
        _spinButton.visible = true;
        spinButtonText.addClass('spinTextSpin');
        spinButtonText.removeClass('spinTextFree');
        spinButtonText.removeClass('disableText');

        if (freeGameInProgress) {
            spinButtonText.visible = false;
            nge.find('^freeGameButtonTextFree').visible = true;
            nge.find('^freeGameButtonTextFree').addClass('spinTextSpin');
            nge.find('^freeGameButtonTextFree').removeClass('spinTextFree');
            nge.find('^freeGameButtonTextFree').removeClass('disableText');
            nge.find('^freeGameButtonTextGame').visible = true;
            nge.find('^freeGameButtonTextGame').addClass('spinTextSpin');
            nge.find('^freeGameButtonTextGame').removeClass('spinTextFree');
            nge.find('^freeGameButtonTextGame').removeClass('disableText');
        } else {
            spinButtonText.visible = true;
            nge.find('^freeGameButtonTextFree').visible = false;
            nge.find('^freeGameButtonTextGame').visible = false;
        }
    };
    var _showSpinButton = function () {
        _autospinStopButton.visible = false;
        _freeSpinButton.visible = false;
        _spinButton.visible = true;
    };

    var _spinAutospin = function () {
        _spinButton.visible = false;
        _freeSpinButton.visible = false;
        _autospinStopButton.visible = true;
    };

    var _spinFreespin = function () {
        _spinButton.visible = false;
        _autospinStopButton.visible = false;
        _freeSpinButton.visible = true;
        _spinButtonDisable();
    };

    var _spinButtonEnable = function () {
        var spinData = nge.localData.get('slotMachine');

        var freeGamesInProgress = nge.localData.get('freeGame.inProgress');
        if (!freeGamesInProgress && spinData && spinData.slotWin &&
            spinData.slotWin.linePickBonus &&
            spinData.slotWin.linePickBonus.length) {

            return false;
        }

        var spinButtonText = nge.find('^' + _spinButtonText);
        spinButtonText.removeClass('disableText');

        var spinButton = nge.find('^' + _spinButtonName);
        if (spinButton)
            spinButton.enable();

        if (freeGamesInProgress) {
            spinButtonText.visible = false;
            nge.find('^freeGameButtonTextFree').visible = true;
            nge.find('^freeGameButtonTextFree').removeClass('disableText');
            nge.find('^freeGameButtonTextGame').visible = true;
            nge.find('^freeGameButtonTextGame').removeClass('disableText');
        } else {
            spinButtonText.visible = true;
            nge.find('^freeGameButtonTextFree').visible = false;
            nge.find('^freeGameButtonTextGame').visible = false;
        }
    };

    var _spinButtonDisable = function () {
        var spinButton = nge.find('^' + _spinButtonName);
        if (spinButton)
            spinButton.disable(3);

        var spinButtonText = nge.find('^' + _spinButtonText);
        spinButtonText.addClass('disableText');

        var freeGamesInProgress = nge.localData.get('freeGame.inProgress');
        if (freeGamesInProgress) {
            spinButtonText.visible = false;
            nge.find('^freeGameButtonTextFree').visible = true;
            nge.find('^freeGameButtonTextFree').addClass('disableText');
            nge.find('^freeGameButtonTextGame').visible = true;
            nge.find('^freeGameButtonTextGame').addClass('disableText');
        } else {
            spinButtonText.visible = true;
            nge.find('^freeGameButtonTextFree').visible = false;
            nge.find('^freeGameButtonTextGame').visible = false;
        }
    };

    var _spinButtonMaxBet = function (max) {
        var btnSpin = nge.find('^' + _spinButtonName);
        var spinButtonText = nge.find('^' + _spinButtonText);
        spinButtonText.removeClass('disableText');
        if (max) {
            btnSpin.key = _spinButtonMaxSprite;
            btnSpin.frame = 2;
            btnSpin.frame = 1;
        } else {
            btnSpin.key = _spinButtonRegularSprite;
            btnSpin.frame = 2;
            btnSpin.frame = 1;
        }
        nge.assets.applyQuality(btnSpin);
    };

    var _subscribe = function () {
        nge.observer.add('spinButton.regular', _spinRegular);
        nge.observer.add('spinButton.autospin', _spinAutospin);
        nge.observer.add('spinButton.freespin', _spinFreespin);
        nge.observer.add('spinButton.enable', _spinButtonEnable);
        nge.observer.add('spinButton.disable', _spinButtonDisable);
        nge.observer.add('spinButton.maxBet', _spinButtonMaxBet);
        nge.observer.add('autospin.end', _spinRegular);
        nge.observer.add('autospin.stopRequest', _showSpinButton);
        nge.observer.add('freespin.end', _spinRegular);
        nge.observer.add('slotMachine.spinCommand', _spinButtonDisable);
        nge.observer.add('slotMachine.spinComplete', _spinButtonEnable);

    };
});



