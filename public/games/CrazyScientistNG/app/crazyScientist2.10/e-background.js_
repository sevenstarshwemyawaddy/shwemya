/* global nge */

/**
 * Created by s.kleimenov 06.12.2018
 */

nge.App[nge.appNS].Com.SlotMachine.TempBlurs.ControllerExtension = function () {
    var _self;
    var _view;
    var _cfg;

    this.create = function () {
        this.super.create();
        _self = this;
        _view = _self._service._view;
        _cfg = this.getInstance('CfgMode').get();
    };

    var _spinCompleteHandler = function () {
        _self.slotMachineUpdateBlurs();
    };

    var _fillFinishBlurSymbols = function (column, symbol, symbolsCountNeed) {
        var reverseColumn = nge.Lib.Helper.jsObjClone(column);
        reverseColumn.reverse();
        var count = 0;

        if (reverseColumn[0] === symbol) {
            var symbolsInColumn = 1;

            for (var i = 1; i < reverseColumn.length; i++) {
                if (reverseColumn[i] === symbol)
                    symbolsInColumn++;
                else
                    break;
            }

            count = symbolsCountNeed - symbolsInColumn;
        }

        return count;
    };

    var _spinResponseHandler = function (response) {
        var additionalBlurs = [1, 1, 1, 1, 1];
        nge.localData.set('slotMachineAdditionalBlurs', additionalBlurs);

        var additionalBlursKeys = [];
        var columns = response.spinResult.columns;

        var processFinishBlurSymbols = function (reel, symbol, chainLength) {
            var count = _fillFinishBlurSymbols(columns[reel], symbol, chainLength);
            while (count > _view._cfg.mh) {
                additionalBlursKeys[reel].push('blurTemp-' + symbol + '-x' + _view._cfg.mh);
                count -= _view._cfg.mh;
            }
            if (count > 0)
                additionalBlursKeys[reel].push('blurTemp-' + symbol + '-x' + count);
        };

        var _freeUseSymbols = _cfg.freeUseSymbols;
        var randomLength;
        var i;

        for (i = 0; i < columns.length; i++) {
            additionalBlursKeys[i] = [];
            for(var j = 0; j < _cfg.symbolPucksCfg.length; j++){
                randomLength = _cfg.symbolPucksCfg[j].combinations.length > 1 ?
                    _cfg.symbolPucksCfg[j].combinations[nge.Lib.Helper.getRandomInt(0, _cfg.symbolPucksCfg[j].combinations.length - 1)].size :
                    _cfg.symbolPucksCfg[j].combinations[0].size;
                processFinishBlurSymbols(i, _cfg.symbolPucksCfg[j].name, randomLength);
            }
        }

        for (i = 0; i < columns.length; i++) {
            if (additionalBlursKeys[i].length === 0 && nge.Lib.Helper.getRandomInt(0, 99) < 85) {
                var randomSymbol = false;
                do
                    randomSymbol = _freeUseSymbols[nge.Lib.Helper.getRandomInt(0, _freeUseSymbols.length - 1)];
                while (randomSymbol === columns[i][_view._cfg.mh - 1]);

                randomLength = nge.Lib.Helper.getRandomInt(0, 99) < 50 ? 3 : 4;
                additionalBlursKeys[i].push('blurTemp-' + randomSymbol + '-x' + randomLength);
            }
        }

        nge.localData.set('slotMachineAdditionalBlursKeys', additionalBlursKeys);
    };

    this.slotMachineUpdateBlurs = function(){
        if (nge.localData.get('freespin.inProgress'))
            nge.observer.fire('slotMachine.updateBlurs');
        else
            nge.observer.fire('slotMachine.updateBlurs', null, 5);
    };

    this.customSubscribe = function () {
        this.super.customSubscribe();
        nge.observer.add('slotMachine.spinComplete', _spinCompleteHandler);
        nge.observer.add('slotMachine.spinResponse', _spinResponseHandler);
    };
};




/* global nge */

/**
