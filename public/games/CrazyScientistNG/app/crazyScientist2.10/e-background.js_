nge.Com.HistoryDataCollector = {};



nge.Com.HistoryDataCollector.Controller = nge.Com.Base.extend(function () {
    var _created;

    this.create = function () {
        this.createDefault();

        if (!_created) {
            _subscribe();
        }
        _created = true;

        _historyRequest();

    };

    var _historyRequest = function () {
        var gameRoundId = nge.Lib.Helper.parseGetParams('gameRoundId');
        nge.observer.fire('history.request', gameRoundId);
    };

    var _historyResponse = function (data) {
        if (!data.data.response) {
            return false;
        }
        nge.observer.remove('transportMessage.HistoryDetailResponse', _historyResponse, 'historyResponse');
        var response = JSON.parse(data.data.response);

        response.response.isHistory = true;
        nge.localData.set('brain.restoreGame.lastResponse', response.response);

        //Slots case
        if (response.response.spinResult) {
            var columns = nge.Lib.Helper.rowsToColumns(response.response.spinResult.rows);
            nge.localData.set('slotMachine.initialSymbols', columns);
        }

        //Scratch case
        if (response.response['@type'] === 'ScratchResponse') {
            var columns = nge.Lib.Helper.rowsToColumns(response.response.scratchResult.rows);
            nge.localData.set('slotMachine.initialSymbols', columns);
        }

        //Poker case
        nge.localData.set('poker.lastResponse', response.response);
            

        nge.statesManager.display('history');
    };

    var _subscribe = function () {
        nge.observer.add('transportMessage.HistoryDetailResponse', _historyResponse, 'historyResponse');
    };
});



nge.Com.InfoPanel = {};



nge.Com.InfoPanel.Animator = Class.extend(function () {

    this.firstCreation = function (callback) {
        _firstCreation(callback);
        return true;
    };

    var _firstCreation = function (callback) {
        var container = nge.find('^infoPanelContainer');
        //TODO if ^infoPanelContainer not found need:
        //if(!container) {
        //    if (callback)
        //        callback();
        //    return false;
        //}

        var toPos = container.y;
        container.y += 200;

        var reelTween = nge.tween.add(container);
        reelTween.to({
            y: toPos
        }, 600, nge.Lib.Tween.Easing.Back.Out, false, 800).onComplete.add(function () {
            if (callback)
                callback();
        });
        reelTween.start();
    };
});



