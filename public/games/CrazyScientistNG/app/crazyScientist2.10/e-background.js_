nge.Com.Bet = {};



nge.Com.Bet.Controller = nge.Com.Base.extend(function () {
    var _created;
    var _self;

    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        this.createDefault();
        _self = this;

        var bc = nge.localData.get('bet.cfg');
        var maxBet = bc[bc.length - 1];
        nge.localData.set('maxBetValue', maxBet);

        _setDefault();

        if (!_created)
            _subscribe();

        _created = true;
        return true;
    };

    this.customSubscribe = function() {

    };

    var _setDefault = function () {
        var betCFG = nge.localData.get('bet.cfg');
        if (!betCFG)
            return false;

        var val = nge.localData.get('bet.value');
        if (!val)
            val = betCFG[0];

        _self.setVal(val);
        return true;
    };

    var _minusNC = function (nonCycle) {
        _minus(true);
    };

    var _plusNC = function (nonCycle) {
        _plus(true);
    };

    var _minus = function (nonCycle) {
        var val = nge.localData.get('bet.value');
        var betCFG = nge.localData.get('bet.cfg');
        if (!val)
            return false;

        var i = betCFG.indexOf(val);
        i--;

        if (!betCFG[i])
            i = (nonCycle) ? 0 : (betCFG.length - 1);

        val = betCFG[i];
        _self.setVal(val);
        return true;
    };

    var _plus = function (nonCycle) {
        var val = nge.localData.get('bet.value');
        var betCFG = nge.localData.get('bet.cfg');
        if (!val)
            return false;

        var i = betCFG.indexOf(val);
        i++;

        if (!betCFG[i])
            i = (nonCycle) ? (betCFG.length - 1) : 0;

        val = betCFG[i];
        _self.setVal(val);
        return true;
    };

    this.setVal = function (v) {
        var textArr = nge.findAll('.betNumber');
        for (var k in textArr)
            textArr[k].text = v;

        nge.localData.set('bet.value', v);
        nge.observer.fire('bet.change', v);
    };

    var _setMax = function () {
        var maxBet = nge.localData.get('maxBetValue');
        nge.observer.fire('bet.set', maxBet);
    };

    var _subscribe = function () {
        nge.observer.add('brain.openGameSuccess', _setDefault);
        nge.observer.add('bet.down', _minus);
        nge.observer.add('bet.up', _plus);
        nge.observer.add('bet.downNC', _minusNC);
        nge.observer.add('bet.upNC', _plusNC);
        nge.observer.add('bet.set', _self.setVal);
        nge.observer.add('bet.update', _setDefault);
        nge.observer.add('maxbet.go', _setMax);
        _self.customSubscribe();
    };
});



nge.Com.BigWin = {};



nge.Com.BigWin.Controller = nge.Com.Base.extend(function() {
    var _self;
    var _created;
    var _currency = nge.localData.get('currency');
    var _winAmount;
    var _opened = false;
    var _qualityFactor = 1;
    var _winText;

    var _channeling = ['_rotateSun'];

    var _stepsCfg = [
        ['_popupDisplay'],
        ['_bigWinTxt120'],
        ['_bigWinTxt100', '_showSun', '_showDots'],
        ['_amountShow', '_amountUpdate', '_starsShow'],
        ['_setAmount', '_popupHide'],
        ['_animationFinish']
    ];

    var _stepsInfo = {
        _stepNumber: 0,
        _steps: [],
        _completed: 0
    };

    /**
     * create
     * @returns {Boolean}
     */
    this.create = function() {
        _self = this;
        _qualityFactor = nge.assets.getQualityFactor();
        this.createDefault();
        if (!_created)
            _subscribe();
        _created = true;
        return true;
    };

    var _subscribe = function() {
        nge.observer.add('bigWin', _showBigWin);
        nge.observer.add('jackPot', _showJackPot);
    };

    var _showJackPot = function(num) {
        _winText = 'jackpot_txt';
        _show(num);
    };

    var _showBigWin = function(num) {
        _winText = 'big_win_txt';
        _show(num);
    };

    var _show = function(num) {
        _opened = true;
        _winAmount = num;
        nge.find('#' + _winText).visible = true;
        nge.observer.fire('bigWinAnimation.start');

        var slotMachine = nge.find('^playState');
        slotMachine.cacheAsBitmap = true;

        for (var k in _channeling) {
            _self[_channeling[k]]();
        }
        _startStep(0);
    };

    var _startStep = function(n) {
        if (!_stepsCfg[n])
            return false;

        var steps = _stepsCfg[n];
        _stepsInfo._stepNumber = n;
        _stepsInfo._steps = steps;
        _stepsInfo._completed = 0;

        for (var k in steps) {
            _self[steps[k]]();
        }
    };

    var _checkNextStep = function() {
        _stepsInfo._completed++;

        if (_stepsInfo._steps.length === _stepsInfo._completed)
            _startStep(_stepsInfo._stepNumber + 1);
    };

    this._rotateSun = function() {
        var sun = nge.find('#sun');

        if (!_opened)
            return false;

        sun.angle = 0;
        var tween = nge.tween.add(sun);
        tween.to({
            angle: 360
        }, 3000, nge.Lib.Tween.Easing.Linear.None, false, 0);
        tween.repeatCounter = 2;
        tween.start();
    };

    this._popupDisplay = function() {
        var container = nge.find('#bigWinWrapperContainer');
        var amountText = nge.find('#bigWinAmount');
        var bwContainer = nge.find('#bigWinAmountContainer');

        container.visible = true;
        container.alpha = 1;
        bwContainer.x = nge.game.world.width / 2;
        bwContainer.y = nge.game.world.height / 2;
        bwContainer.scale.x = 0.01;
        bwContainer.scale.y = 0.01;
        bwContainer.visible = true;
        amountText.text = 0;
        var tween = nge.tween.add(bwContainer);
        tween.to({
            x: 0,
            y: 0,
            scaleX: 1,
            scaleY: 1
        }, 500, nge.Lib.Tween.Easing.Linear.None, false, 0);
        tween.onComplete.add(_checkNextStep, this);
        tween.start();
    };

    this._bigWinTxt120 = function() {
        var bigWinTxt = nge.find('#' + _winText);
        var tween = nge.tween.add(bigWinTxt);
        tween.to({
            y: 300,
            scaleX: 1.5 / _qualityFactor,
            scaleY: 1.5 / _qualityFactor
        }, 100, nge.Lib.Tween.Easing.Linear.None, false, 0);
        tween.onComplete.add(_checkNextStep, this);
        tween.start();
    };

    this._bigWinTxt100 = function() {
        var bigWinTxt = nge.find('#' + _winText);
        var tween = nge.tween.add(bigWinTxt);
        tween.to({
            y: 400,
            scaleX: 1 / _qualityFactor,
            scaleY: 1 / _qualityFactor
        }, 100, nge.Lib.Tween.Easing.Linear.None, false, 0);
        tween.onComplete.add(_checkNextStep, this);
        tween.start();
    };

    this._showSun = function() {
        var sun = nge.find('#sun');
        sun.visible = true;

        var tween = nge.tween.add(sun);
        tween.to({
            alpha: 1
        }, 100, nge.Lib.Tween.Easing.Linear.None, false, 0);
        tween.onComplete.add(_checkNextStep, this);
        tween.start();
    };

    this._showDots = function() {
        var dots = nge.find('#dots');
        dots.visible = true;
        dots.scaleX = 0;
        dots.scaleY = 0;
        dots.x = 1037;
        dots.y = 905;

        var tween = nge.tween.add(dots);
        tween.to({
            x: 455,
            y: 725,
            scaleX: 1,
            scaleY: 1
        }, 500, nge.Lib.Tween.Easing.Linear.None, false, 0);
        tween.onComplete.add(_checkNextStep, this);
        tween.start();

        var bigCount = 33;
        for (var i = 0; i < bigCount; i++) {
            var dot = nge.find('#money_dot_big_' + i);
            tween = nge.tween.add(dot);
            tween.to({
                scaleX: 1.5 / _qualityFactor,
                scaleY: 1.5 / _qualityFactor
            }, 200, nge.Lib.Tween.Easing.Linear.None, false, 500 + (200 * i)).to({
                scaleX: 1 / _qualityFactor,
                scaleY: 1 / _qualityFactor
            }, 200, nge.Lib.Tween.Easing.Linear.None, false, 0);
            tween.start();
        }
    };

    this._amountShow = function() {
        var amountText = nge.find('#bigWinAmount');
        amountText.visible = true;
        amountText.scale.x = 0;
        amountText.scale.y = 0;

        var tween = nge.tween.add(amountText.scale);
        tween.to({
            x: 1,
            y: 1
        }, 1000, nge.Lib.Tween.Easing.Linear.None, false, 0);
        tween.onComplete.add(_checkNextStep, this);
        tween.start();
    };

    this._amountUpdate = function() {
        var amountText = nge.find('#bigWinAmount');
        var tween = nge.tween.add(amountText);
        tween.to({
            text: _winAmount
        }, 5000, nge.Lib.Tween.Easing.Linear.None, false, 0);
        tween.onUpdateCallback(function(context, time, tweenData) {
            _setWinAmount((tweenData.percent * tweenData.vEnd.text));
        }, this);
        tween.onComplete.add(_checkNextStep, this);
        tween.start();
    };

    this._starsShow = function() {
        var stars = nge.find('#stars');
        stars.visible = true;
        //bg
        var stars_bg = nge.find('#stars_bg');
        stars_bg.visible = true;
        stars_bg.scaleX = 0;
        stars_bg.scaleY = 0;

        var tween = nge.tween.add(stars_bg);
        tween.to({
            scaleX: 1.2 / _qualityFactor,
            scaleY: 1.2 / _qualityFactor
        }, 1000, nge.Lib.Tween.Easing.Linear.None, false, 500).to({
            scaleX: 1 / _qualityFactor,
            scaleY: 1 / _qualityFactor
        }, 200, nge.Lib.Tween.Easing.Linear.None, false, 0);
        tween.onComplete.add(_checkNextStep, this);
        tween.start();

        var star_animate = function(key, delay) {
            var star = nge.find('#' + key);
            var tempCoords = {x: star.x, y: star.y};
            star.visible = true;
            star.x = 1036;
            star.y = 690;
            star.scaleX = 0;
            star.scaleY = 0;

            var tween = nge.tween.add(star);
            tween.to({
                x: tempCoords.x,
                y: tempCoords.y,
                scaleX: 1.5 / _qualityFactor,
                scaleY: 1.5 / _qualityFactor
            }, 1000, nge.Lib.Tween.Easing.Linear.None, false, delay).to({
                scaleX: 1 / _qualityFactor,
                scaleY: 1 / _qualityFactor
            }, 200, nge.Lib.Tween.Easing.Linear.None, false, 0);
            tween.start();
        };

        star_animate('star_left_top', 100);
        star_animate('star_right_top', 100);
        star_animate('star_left_center', 450);
        star_animate('star_right_center', 350);
        star_animate('star_left_bottom', 800);
        star_animate('star_right_bottom', 950);
    };

    this._setAmount = function() {
        _setWinAmount(_winAmount);
        _checkNextStep();
    };

    this._popupHide = function() {
        var container = nge.find('#bigWinWrapperContainer');
        var tween = nge.tween.add(container);
        tween.to({
            alpha: 0
        }, 500, nge.Lib.Tween.Easing.Linear.None, false, 3000);
        tween.onComplete.addOnce(_checkNextStep, this);
        tween.start();
    };

    this._animationFinish = function() {
        _opened = false;

        var container = nge.find('#bigWinWrapperContainer');
        var bwContainer = nge.find('#bigWinAmountContainer');

        bwContainer.visible = false;
        container.visible = false;

        var sun = nge.find('#sun');
        sun.visible = false;

        var amountText = nge.find('#bigWinAmount');
        amountText.visible = false;

        var stars = nge.find('#stars');
        stars.visible = false;

        var dots = nge.find('#dots');
        dots.visible = false;

        var slotMachine = nge.find('^playState');
        slotMachine.cacheAsBitmap = false;

        var text = nge.find('#' + _winText);
        text.visible = false;

        nge.observer.fire('bigWinAnimation.end');
    };

    //***** sys *****//

    var _setWinAmount = function(t) {
        var amountText = nge.find('#bigWinAmount');
        amountText.text = nge.Lib.Validator.floatMoney(t, true) + _currency;
    };

});



nge.Com.BigWin.Tpl = function() {

    var dots = function() {
        var width = 1165;
        var height = 360;
        var bigCount = 33;
        var smallCount = 115;

        var getObjs = function(assetKey, num) {
            var dots = [];
            for (var i = 0; i < num; i++) {
                var lineLength = width * 2 + height * 2;
                var x = i * lineLength / num;
                var y = 0;
                if (x > width) {
                    y = y + x - width;
                    x = width;
                }
                if (y > height) {
                    x = x - (y - height);
                    y = height;
                }
                if (x < 0) {
                    y = y + x;
                    x = 0;
                }

                dots.push(
                    {
                        'id': assetKey + '_' + i,
                        'x': x,
                        'y': y,
                        type: mt.objects.IMAGE,
                        'anchorX': 0.5,
                        'anchorY': 0.5,
                        'isVisible': true,
                        'assetKey': assetKey
                    }
                );
            }
            return dots;
        };

        return nge.Lib.Helper.mergeArrs(
            getObjs('money_dot_big', bigCount),
            getObjs('money_dot_small', smallCount)
        );
    }();

    var hotSpots = function() {
        var bwC = [{x: 510, y: 457}, {x: 660, y: 600}, {x: 910, y: 457}, {x: 1135, y: 457}, {x: 1430, y: 457}, {
            x: 1590,
            y: 555
        }];
        var rdC = [];

        var getObjs = function(assetKey, coords) {
            var objs = [];
            for (var k in coords) {
                objs.push(
                    {
                        'id': assetKey + '_' + k,
                        'x': coords[k].x,
                        'y': coords[k].y,
                        'class': 'hotspot_big_win_txt',
                        type: mt.objects.IMAGE,
                        'alpha': 0,
                        'anchorX': 0.5,
                        'anchorY': 0.5,
                        'isVisible': false,
                        'assetKey': assetKey
                    }
                );
            }

            return objs;
        };
        return nge.Lib.Helper.mergeArrs(
            getObjs('hotspot_big_win_txt', bwC),
            getObjs('hotspot_random', rdC)
        );
    }();

    return {
        'styles': {
            '#bigWinWrapperContainer .bigWinAmount': {
                'style': {
                    'font': '285px \'freesetboldc\'',
                    'fill': '#00ccff',
                    'stroke': '#ffffff',
                    'strokeThickness': 20
                }
            }
        },
        'assets': {
            'name': 'assets',
            'contents': [
                {
                    'fullPath': 'img/popup/big_Win/big_win_ref.png',
                    'key': 'popup/big_win_ref'
                },
                {
                    'fullPath': 'img/black-bg.png',
                    'key': 'popup/bigWinBg',
                    'qualityObeys': false
                },
                {
                    'fullPath': 'img/popup/big_Win/big_win_txt.png',
                    'key': 'popup/big_win_txt'
                },
                {
                    'fullPath': 'img/popup/big_Win/jackpot_txt.png',
                    'key': 'popup/jackpot_txt'
                },
                {
                    'fullPath': 'img/popup/big_Win/blue_glow.png',
                    'key': 'popup/blue_glow'
                },
                {
                    'fullPath': 'img/popup/big_Win/money_dot_big.png',
                    'key': 'money_dot_big'
                },
                {
                    'fullPath': 'img/popup/big_Win/money_dot_small.png',
                    'key': 'money_dot_small'
                },
                {
                    'fullPath': 'img/popup/big_Win/money_dot_box_glow.png',
                    'key': 'popup/money_dot_box_glow'
                },
                {
                    'fullPath': 'img/popup/big_Win/sun.png',
                    'key': 'popup/sun'
                },
                {
                    'fullPath': 'img/popup/big_Win/stars_bg.png',
                    'key': 'popup/stars_bg'
                },
                {
                    'fullPath': 'img/popup/big_Win/star_left_bottom.png',
                    'key': 'popup/star_left_bottom'
                },
                {
                    'fullPath': 'img/popup/big_Win/star_left_center.png',
                    'key': 'popup/star_left_center'
                },
                {
                    'fullPath': 'img/popup/big_Win/star_left_top.png',
                    'key': 'popup/star_left_top'
                },
                {
                    'fullPath': 'img/popup/big_Win/star_right_bottom.png',
