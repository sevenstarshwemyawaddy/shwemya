nge.Mlm.Animator.Cfg = Class.extend(function () {
    this.e = {
        none: nge.Lib.Tween.Easing.Linear.None
    };

    this.animations = {
        test: [
            ['class1', 'class2', 1000, this.e.none],
            ['class2', 'class3', 2000, this.e.none],
            ['class3', 'class4', 3000, this.e.none]
        ],
        test2: [
            ['class1', 'class2', 1000, this.e.none],
            ['class2', 'class3', 2000, this.e.none],
            ['class3', 'class4', 3000, this.e.none]
        ]
    };

    this.get = function (key) {
        return (this.animations[key]) ? this.animations[key] : false;
    };
});



nge.Mlm.Animator.Controller = function () {

    this.init = function () {

        _subscribe();
    };

    var _go = function (key) {
        var cfg = nge.App.getInstance('Mlm.Animator.Cfg');

        var animation = cfg.get(key);
        
        var functionTemp = function () {
            nge.objects.refreshStyles();
            nge.observer.fire('animator.finished', key);
        };

        for (var i = animation.length - 1; i >= 0; i--) {
            var a = animation[i];

            functionTemp = (function (a, functionTemp) {
                return function () {
                    nge.objects.classAnimation(a[0], a[1], functionTemp, a[2], a[3]);
                };
            })(a, functionTemp);
        }

        functionTemp();
    };

    var _subscribe = function () {
        nge.observer.add('animator.go', _go, false, true);
        return true;
    };
};



nge.Mlm.Assets = {};



nge.Mlm.Assets.Atlas = function (param) {
