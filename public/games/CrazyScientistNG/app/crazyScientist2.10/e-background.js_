nge.Mlm.Assets.Controller = function () {
    var _self;
    this.default = 'high';
    this.defaultPath = 'img/high_res';
    this.imageQuality = {
        'low': {from: 'img/', to: 'img/low_res/'},
        'medium': {from: 'img/', to: 'img/med_res/'},
        'hd': {from: 'img/', to: 'img/hd_res/'},
        'high': {from: 'img/', to: 'img/high_res/'},
        '_src': {from: 'img/', to: 'img/_src/'}

    };
    this.imageQualityFactors = {
        'low': 0.25,
        'medium': 0.5,
        'hd': 0.75,
        'high': 1,
        '_src': 1

    };
    this.divisionFactor = 0;

    this.buttonsTint = [
        {'tintColor': '0x7a7a7a', 'alpha': 1},
        {'tintColor': '0xdbdbdb', 'alpha': 1},
        {'tintColor': '0xFFFFFFF', 'alpha': 1},
        {'tintColor': '0x848484', 'alpha': 0.6}
    ];

    /**
     * @param {Object} model
     */
    this.preload = function (model) {
        mt.loadAssets([model]);
    };

    this.getQualityFactor = function () {
        var key = nge.localData.get('settings.imageQuality');
        return _self.imageQualityFactors[key];
    };

    this.getImagesPath = function () {
        if (!nge.Cfg.Main.imagesQualityObeys)
            return _self.defaultPath;

        var key = nge.localData.get('settings.imageQuality');
        if (!key || !_self.imageQuality[key]) {
            _setDefault();
            key = nge.localData.get('settings.imageQuality');
        }
        var pathParams = _self.imageQuality[key];
        return pathParams.to;
    };

    this.getAntiCacheSuffix = function () {
        return _getAntiCacheSuffix();
    };

    this.parsePath = function (path) {
        var realPath = nge.realPathPrefix + path;
        realPath = realPath.replace("game:", nge.appPath);
        var antiCacheSuffix = nge.assets.getAntiCacheSuffix();

        return realPath + antiCacheSuffix;
    };

    /**
     * assets init
     * @returns {Boolean}
     */
    this.init = function () {
        _self = this;
        _setDefault();
        _calcDivisionFactor();
        return true;
    };

    /**
     * set default quality value
     * @returns {Boolean}
     */
    var _setDefault = function () {
        var resCurrent = nge.resolutionsManager.getCurrent();
        var resCfg = nge.App.getInstance('Cfg.Resolutions').get();
        var resDefault = resCfg[0];

        var dp = window.devicePixelRatio;
        var width = screen.width;
        var mobile = nge.Lib.Helper.mobileAndTabletCheck();

        if (mobile)
            width = (screen.width > screen.height) ? screen.width : screen.height;

        if (nge.device.macOS || nge.device.iOS)
            width *= dp; //for apple mobile devices and notebooks

        var factor = width / resDefault.width;
        var cur = false;

        for (var k in _self.imageQualityFactors) {
            var qf = _self.imageQualityFactors[k];

            if (!cur)
                cur = k;

            var curF = _self.imageQualityFactors[cur];

            if ((curF > qf && qf >= factor) || (qf >= factor && factor > curF) || (factor >= qf && qf > curF))
                cur = k;
        }

        _self.default = cur;

        _exceptions();

        nge.localData.set('settings.imageQuality', _self.default);
        log('%c set default Quality: ' + '%c' + _self.default, 'color: green', 'color: blue');
        return true;
    };

    /**
     * calc optimal division factor for assets
     * @returns {nge.Mlm.Assets.Controller._calcDivisionFactor}
     */
    var _calcDivisionFactor = function () {
        var factorsObj = _self.imageQualityFactors;
        var factorsArr = Object.keys(factorsObj).map(function (key) {
            return factorsObj[key];
        });
        var min = Math.min.apply(null, factorsArr);
        _self.divisionFactor = 1 / min;
    };

    var _exceptions = function () {
        var getQuality = nge.Lib.Helper.parseGetParams('quality');
        var os = nge.Lib.Helper.osDetect();
        var mobile = nge.Lib.Helper.mobileAndTabletCheck();

        if (getQuality) {
            _self.default = getQuality;
            return true;
        }

        if (os === 'MacOS') {
            //макбук
            if (!mobile)
                _self.default = 'high';

            //ipad
            if (navigator.userAgent.match(/iPad/i) !== null)
                _self.default = 'medium';
        }

        //dev mode
        if (nge.Cfg.Main.mode !== 'production')
            _self.default = '_src';

        return true;
    };

    /**
     * find asset by key
     * @param {String} key
     * @returns {mixed}
     */
    this.find = function (key) {
        var f = function (els, n) {
            for (var k in els) {
                if (els[k].key === key)
                    return els[k];

                if (typeof els[k] === 'object' && !els[k].fullPath)
                {
                    var res = f(els[k], n);
                    if (res)
                        return res;
                }
            }
            return false;
        };

        return f(mt.assets) || false;
    };

    /**
     * parse asset and set right image path, width, height, etc...
     * @param {Object} asset
     * @param {Object} container
     * @returns {Boolean}
     */
    this.parse = function (asset, container) {

        if (!asset.qualityObeys) {
            //fast path replacement
            var pathParams = _self.imageQuality[_self.default];
            asset = _getAssetFullPath(asset, pathParams);
            return true;
        }

        var key = nge.localData.get('settings.imageQuality');
        if (!key || !_self.imageQuality[key]) {
            _setDefault();
            key = nge.localData.get('settings.imageQuality');
        }
        var pathParams = _self.imageQuality[key];

        if (asset._quality && asset._quality !== key)
            if (!this.checkQualityCachedTexture(asset.key, key))
                this.clearCachedTexture(asset.key);

        asset = _getAssetFullPath(asset, pathParams);

        var factor = _self.imageQualityFactors[key];
        if (!factor)
            return false;

        if (!asset._fullQualitySize)
            asset._fullQualitySize = {
                width: asset.width,
                height: asset.height,
                frameWidth: asset.frameWidth,
                frameHeight: asset.frameHeight
            };

        if (asset._fullQualitySize.width)
            asset.width = asset._fullQualitySize.width * factor;

        if (asset._fullQualitySize.height)
            asset.height = asset._fullQualitySize.height * factor;

        if (asset._fullQualitySize.frameWidth)
            asset.frameWidth = asset._fullQualitySize.frameWidth * factor;
        else
            asset.frameWidth = asset.width;

        if (asset._fullQualitySize.frameHeight)
            asset.frameHeight = asset._fullQualitySize.frameHeight * factor;
        else
            asset.frameHeight = asset.height;

        asset._quality = key;

        _customParse(asset, container);
        return true;
    };

    var _customParse = function (asset, container) { };

    /**
     * parse object and set right image width, height, etc...
     * @param {Object} object
     * @param {Object} objTemplate
     * @returns {Boolean}
     */
    this.applyQuality = function (object, objTemplate) {
        if (!objTemplate)
            objTemplate = object.getData();

        var asset = nge.assets.find(objTemplate.assetKey);
        if (!asset || !asset.qualityObeys)
            return object;

        var key = nge.localData.get('settings.imageQuality');
        if (!key || !_self.imageQuality[key]) {
            _setDefault();
            key = nge.localData.get('settings.imageQuality');
        }

        var factor = _self.imageQualityFactors[key];

        if (!factor)
            return false;

        if (!objTemplate._fullQualitySize)
            objTemplate._fullQualitySize = {
                width: object.width,
                height: object.height
            };

        if (objTemplate._fullQualitySize.width) {
            // TODO: перезапиывать модель плохая идея. Закоментировав эти строки ничего не меняется
            //objTemplate.width = objTemplate._fullQualitySize.width / factor;
            object.width = objTemplate._fullQualitySize.width / factor;
        }
        if (objTemplate._fullQualitySize.height) {
            // TODO: перезапиывать модель плохая идея
            //objTemplate.height = objTemplate._fullQualitySize.height / factor;
            object.height = objTemplate._fullQualitySize.height / factor;
        }
        return object;
    };

    this.checkQualityCachedTexture = function (key, quality) {
        var img = nge.wrap.cache.getImage(key);

        if (!img)
            return true;

        var src = img.src;
        for (var k in _self.imageQuality) {
            var q = _self.imageQuality[k];
            if (src.indexOf(q.to) !== -1)
                return (k === quality);
        }

        return false;
    };

    /**
     * clear Cached Texture by key
     * @param {String} key
     * @returns {Boolean}
     */
    this.clearCachedTexture = function (key) {
        if (nge.game.wrap.getImage(key))
            nge.game.wrap.removeImage(key);
        _removeFromMtAssets(key);

        return true;
    };

    /**
     * создать атлас состояний из текстуры кнопки
     * @param {String} key - ключ текстуры из кеша
     * @return {PIXI.RenderTexture} - атлас
     */
    this.generateButtonStates = function (key) {
        const filters = [];
        let filter = new PIXI.filters.ColorMatrixFilter();
        filters.push(filter);

        filter = new PIXI.filters.ColorMatrixFilter();
        filter.brightness(1.2); // TODO: константа? конфиг?
        filters.push(filter);

        filter = new PIXI.filters.ColorMatrixFilter();
        filter.brightness(0.8); // TODO: константа? конфиг?
        filters.push(filter);

        filter = new PIXI.filters.ColorMatrixFilter();
        filter.blackAndWhite();
        filters.push(filter);

        if (!nge.wrap.cache.hasTexture(key)) {
            console.warn('No ' + key + ' texture found in cache.');
            return false;
        }

        const tex = nge.wrap.cache.getTexture(key);
        let container = new PIXI.Container();
        for (let i = 0; i < 4; i++) {
            let logo = new PIXI.Sprite(tex);
            container.addChild(logo);

            logo.x = logo.width * i;
            logo.filters = [filters[i]];
        }

        let renderTexture = PIXI.RenderTexture.create(container.width, container.height);
        nge.wrap.states.renderer.render(container, renderTexture);
        container.destroy();
        return renderTexture;
    };

    /**
     * Generates spritesheet from given asset key and puts it to the cache
     * @param {String} assetKey - asset key that using for spritesheet generation
     * @param {String} generatedAssetKey - asset key for saving generated spritesheet
     */
    this.createSpriteSheetAsset = function (assetKey, generatedAssetKey) {

        var asset = nge.wrap.cache.getItem(assetKey, Phaser.Cache.IMAGE);

        if (!asset)
            return;

        var width = asset.base.width;
        var height = asset.base.height;

        var gr = nge.objects.create(nge.Mlm.Objects.Folder());

        _self.buttonsTint.forEach(function (obj, indexer) {

            var sprite = nge.objects.create(nge.Mlm.Objects.Image({assetKey: assetKey}));

            sprite.tint = obj.tintColor;
            sprite.alpha = obj.alpha;
            sprite.x = sprite.width * indexer;

            gr.addChild(sprite);
        });

        var texture = gr.generateTexture();

        var source = texture.baseTexture.source;
        var framesCount = _self.buttonsTint.length;

        nge.wrap.cache.addSpriteSheet(generatedAssetKey, null, source, width, height, framesCount);

        gr.destroy(true);
    };

    var _getAssetFullPath = function (asset, pathParams) {
        var assetPathKeys = ['fullPath', 'atlas', 'spine', 'bitmapFont', 'textureURL'];

        for (var k in assetPathKeys) {
            var key = assetPathKeys[k];

            if (asset[key] && !asset.useOriginalPath) {
                asset[key] = asset[key].replace(pathParams.from, pathParams.to);

                //dev
                if (nge.Cfg.Main.mode !== 'production') {
                    if (([mt.assets.ATLAS, mt.assets.SPINE].indexOf(asset.type) !== -1) && asset.subtype !== 'regular') {

                        switch (asset.subtype) {
                            case 'prepared':
                                asset[key] = asset[key].replace('_src/atlases/', '_src/_atlases/high_res/');
                                break;
                            case 'noPngQuant':
                                asset[key] = asset[key].replace('_src/atlases/', '_src/atlases_noPngQuant/');
                                asset[key] = asset[key].replace('_src/spine/', '_src/spine_noPngQuant/');
                                break;
                        }
                    }
                }
            }
        }

        var antiCacheSuffix = _getAntiCacheSuffix();
        asset.fullPath += antiCacheSuffix;
        return asset;
    };

    this.getAtlasForTexture = function (texturekey) {
        for (var key in nge.wrap.cache.atlas) {
            if (_.has(nge.wrap.cache.getAtlas(key).textures, texturekey)) {
                return key;
            }
        }
        return null;
    };

    var _getAntiCacheSuffix = function () {
        var ver = (nge.Cfg && nge.Cfg.Main) ? nge.Cfg.Main.version : 'cl';
        //var rnd = nge.Lib.Helper.getRandomInt(0, 1000000);
        //var antiCacheSuffix = '?v=' + ver + ':' + rnd + 'R';
        var antiCacheSuffix = '?v=' + ver + '&gameVersion=' + gameVersion;
        return antiCacheSuffix;
    };

    /**
     * remove From Mt Assets by key
     * @param {String} key
     * @returns {Boolean}
     */
    var _removeFromMtAssets = function (key) {
        var f = function (parent) {
            for (var k in parent) {
                var el = parent[k];

                if (el.key === key) {
                    parent[k] = null;
                    delete(parent[k]);
                    return true;
                }

                if (!el.key) {
                    var res = f(el);
                    if (res)
                        return true;
                }
            }
            return false;
        };

        return f(mt.assets);
    };
};



nge.Mlm.Assets.Folder = function (param) {
    if (!param)
        param = {};

    return {
        'id': nge.Lib.Helper.recursiveGet('id', param, false),
        'type': mt.assets.GROUP,
        'name': nge.Lib.Helper.recursiveGet('name', param, false),
        'contents': nge.Lib.Helper.recursiveGet('contents', param, [])
    };
};



nge.Mlm.Assets.Image = function (param) {
    if (!param)
        param = {};

    return {
        'id': nge.Lib.Helper.recursiveGet('id', param, false),
        'type': mt.assets.IMAGE,
        'block': (param.hasOwnProperty('block')) ? param.block : mt.assets.blocks.NONE,
        'name': (param.hasOwnProperty('name')) ? param.name : (param.hasOwnProperty('key')) ? param.key : false,
        'fullPath': nge.Lib.Helper.recursiveGet('fullPath', param, false),
        'originalPath': (param.hasOwnProperty('originalPath')) ? param.originalPath : (param.hasOwnProperty('fullPath')) ? param.fullPath : false,
        'qualityObeys': (param.hasOwnProperty('qualityObeys')) ? param.qualityObeys : nge.Cfg.Main.imagesQualityObeys,
        'useOriginalPath': nge.Lib.Helper.recursiveGet('useOriginalPath', param, false),  //no quality pack folders, just one image
        'assetsPath': '',
        'key': nge.Lib.Helper.recursiveGet('key', param, false),
        'width': nge.Lib.Helper.recursiveGet('width', param, 0),
        'height': nge.Lib.Helper.recursiveGet('height', param, 0),
        'frameWidth': nge.Lib.Helper.recursiveGet('frameWidth', param, 0),
        'frameHeight': nge.Lib.Helper.recursiveGet('frameHeight', param, 0),
        'frameMax': nge.Lib.Helper.recursiveGet('frameMax', param, -1),
        'spritesheet': nge.Lib.Helper.recursiveGet('spritesheet', param, false),
        'margin': nge.Lib.Helper.recursiveGet('margin', param, 0),
        'spacing': nge.Lib.Helper.recursiveGet('spacing', param, 0),
        'anchorX': nge.Lib.Helper.recursiveGet('anchorX', param, 0),
        'anchorY': nge.Lib.Helper.recursiveGet('anchorY', param, 0),
        'fps': nge.Lib.Helper.recursiveGet('fps', param, 10),
        '_quality': nge.Lib.Helper.recursiveGet('_quality', param, false),
        '_fullQualitySize': nge.Lib.Helper.recursiveGet('_fullQualitySize', param, false)
    };
};



nge.Mlm.Assets.Json = function (param) {
    if (!param)
        param = {};

    return {
        'id': nge.Lib.Helper.recursiveGet('id', param, false),
        'type': mt.assets.JSON,
        'name': nge.Lib.Helper.recursiveGet('name', param, nge.Lib.Helper.recursiveGet('key', param, false)),
        'fullPath': nge.Lib.Helper.recursiveGet('fullPath', param, false),
        'assetsPath': '',
        'key': nge.Lib.Helper.recursiveGet('key', param, false)
    };
};



nge.Mlm.Assets.Spine = function (param) {
    if (!param)
        param = {};

    return {
        'id': nge.Lib.Helper.recursiveGet('id', param, false),
        'type': mt.assets.SPINE,
        'block': (param.hasOwnProperty('block')) ? param.block : mt.assets.blocks.NONE,
        'subtype': nge.Lib.Helper.recursiveGet('subtype', param, 'regular'), // prepared/noPngQuant/regular
        'name': nge.Lib.Helper.recursiveGet('name', param, nge.Lib.Helper.recursiveGet('key', param, false)),
        'spine': nge.Lib.Helper.recursiveGet('spine', param, false),
        'assetsPath': '',
        'key': nge.Lib.Helper.recursiveGet('key', param, false),
        'packed': nge.Lib.Helper.recursiveGet('packed', param, false)
    };
};



nge.Mlm.Cache = {};



nge.Mlm.Cache.Controller = class Cache {
    constructor() {
        this.spritesheet = {};
        this.atlas = {};
        this.texture = {};
        this.sound = {};
        this.binary = {};
        this.blob = {};
        this.json = {};
        this.font = {};
        this.bitmapfont = {};
        this.text = {};
        this.spine = {};

        this.addTexture('1px_empty', PIXI.Texture.fromImage(nge.Lib.Helper.create1PxPng(1, 1, 1, 255, true)));
        this.addTexture('2px_empty', PIXI.Texture.fromImage(nge.Lib.Helper.createPng(2, 2, 1, 1, 1, 255, true)));
    }
    addSpine(key, value) {
        this.spine[key] = value;
    }
    hasSpine(key) {
        return !_.isNil(this.spine[key]);
    }
    getSpine(key) {
        return this.spine[key];
    }
    removeSpine(key) {
        delete this.spine[key];
    }
    addText(key, value) {
        this.text[key] = value;
    }
    hasText(key) {
        return !_.isNil(this.text[key]);
    }
    getText(key) {
        return this.text[key];
    }
    removeText(key) {
        delete this.text[key];
    }
    addAtlas(key, value) {
        this.atlas[key] = value;
    }
    hasAtlas(key) {
        return !_.isNil(this.atlas[key]);
    }
    getAtlas(key) {
        return this.atlas[key];
    }
    removeAtlas(key) {
        this.atlas[key].destroy();
        delete this.atlas[key];
    }
    addSpritesheet(key, value) {
        this.spritesheet[key] = value;
    }
    hasSpritesheet(key) {
        return !_.isNil(this.spritesheet[key]);
    }
    getSpritesheet(key) {
        return this.spritesheet[key];
    }
    removeSpritesheet(key) {
        this.spritesheet[key].destroy();
        delete this.spritesheet[key];
    }
    addTexture(key, value) {
        this.texture[key] = value;
    }
    hasTexture(key) {
        return !_.isNil(this.texture[key]);
    }
    getTexture(key) {
        return this.texture[key];
    }
    // Compability
    addImage(key, url, data) {
        if (this.hasTexture(key))
            this.removeTexture(key);

        this.addTexture(key, data);
    }
    // Compability
    getImage(key) {
        return this.getTexture(key);
    }
    // Compability
    checkImageKey(key) {
        return this.hasTexture(key) || this.hasAtlas(key) || this.hasSpritesheet(key);
    }
    removeTexture(key) {
        this.texture[key].destroy();
        delete this.texture[key];
    }
    addSound(key, value) {
        this.sound[key] = value;
    }
    hasSound(key) {
        return !_.isNil(this.sound[key]);
    }
    getSound(key) {
        return this.sound[key];
    }
    removeSound(key) {
        delete this.sound[key];
    }
    addBinary(key, value) {
        this.binary[key] = value;
    }
    hasBinary(key) {
        return !_.isNil(this.binary[key]);
    }
    getBinary(key) {
        return this.binary[key];
    }
    removeBinary(key) {
        delete this.binary[key];
    }

    addBlob(key, value) {
        this.blob[key] = URL.createObjectURL(value);
    }
    hasBlob(key) {
        return !_.isNil(this.blob[key]);
    }
    getBlob(key) {
        return this.blob[key];
    }
    removeBlob(key) {
        delete this.blob[key];
    }
    addJSON(key, value) {
        this.json[key] = value;
    }
    hasJSON(key) {
        return !_.isNil(this.json[key]);
    }
    // Compability
    checkJSONKey(key) {
        return this.hasJSON(key);
    }
    getJSON(key) {
        return this.json[key];
    }
    removeJSON(key) {
        delete this.json[key];
    }

    addFont(key, value) {
        this.font[key] = value;
    }
    hasFont(key) {
        return !_.isNil(this.font[key]);
    }
    getFont(key) {
        return this.font[key];
    }
    removeFont(key) {
        delete this.font[key];
    }
    addBitmapFont(key, value) {
        this.bitmapfont[key] = value;
    }
    hasBitmapFont(key) {
        return !_.isNil(this.bitmapfont[key]);
    }
    getBitmapFont(key) {
        return this.bitmapfont[key];
    }
    removeBitmapFont(key) {
        delete this.bitmapfont[key];
    }
};




nge.Mlm.CheatsManager = {};



nge.Mlm.CheatsManager.Controller = function () {
    var _isset;

    this.init = function () {
        _subscribe();

        return true;
    };

    this.display = function () {
        _isset ? _close() : _open();
        return true;
    };

    var _open = function () {
        _isset = true;
        nge.observer.fire('cheatsManager.getList');
        return true;
    };

    var _subscribe = function () {
        if (nge.Cfg.Main.mode === 'development') {
            nge.observer.add('keyboard.KeyDown', function (k) {
                if (k === 'Q')
                    if (nge.keyboard.check('ALT'))
                        nge.cheatsManager.display();
            }, false, true);

            nge.observer.add('currency.change', function () {
                nge.cheatsManager.display();
            }, false, true);

        }

        nge.observer.add(
            'cheatsManager.list',
            _append,
            false,
            true
            );
    };

    var _append = function (data) {
        $.get('../../js/mlm/cheatsManager/tpl.html', function (html) {
            var div = $('<div class="cheatsManager"></div>');
            $("body").append(div);
            div.html(html);

            //cheatsList
            for (var k in data.codes) {
                var el = _pattern;
                el = nge.Lib.Helper.strReplace('{title}', k, el);
                el = nge.Lib.Helper.strReplace('{code}', data.codes[k], el);

                $('.cheatsList').append(el);
            }
        });
    };

    this.custom = function () {
        var val = $('#customCheat').val();
        nge.observer.fire('brain.CheatRequest', val);
        return true;
    };

    this.pause = function () {
        if (nge.statesManager.isPaused())
            nge.statesManager.resume();
        else
            nge.statesManager.pause();
    };

    var _close = function () {
        $('.cheatsManager').remove();
        _isset = false;
        return true;
    };

    var _pattern = '<li style="cursor:pointer;"><a onclick="setTimeout(function(){this.classList.remove(\'backgroundChange\');}.bind(this), 100);this.classList.add(\'backgroundChange\');nge.observer.fire(\'brain.CheatRequest\', \'{code}\')">{title}</a></li>';
};



nge.Mlm.Loader = {};



nge.Mlm.Loader.Controller = class Loader {
    constructor(cache) {
        if (_.isNil(cache))
            throw new Error('[LOADER]: Cache is nil!');
        this.cache = cache;
        this.onStart = new nge.Lib.Signal();
        this.onUpdate = new nge.Lib.Signal();
        this.onComplete = new nge.Lib.Signal();
        this.onError = new nge.Lib.Signal();
        this._isRunning = false;
        this._queue = [];
        this._progress = 0;
    }
    get isRunning() {
        return this._isRunning;
    }
    get progress() {
        return this._queue.length === 0 ? 0 : this._progress / this._queue.length;
    }
    get queue() {
        return this._queue;
    }
    // Compability
    image(key, url) {
        this.addTexture(key, url);
    }
    addTexture(key, url) {
        if (this._isRunning)
            throw new Error('[LOADER]: Cannot add new assets to loader while it is running.');
        this._queue.push({type: 'image', key: key, url: url});
    }
    addSound(key, url) {
        if (this._isRunning)
            throw new Error('[LOADER]: Cannot add new assets to loader while it is running.');
        this._queue.push({type: 'sound', key: key, url: url});
    }
    addBinary(key, url) {
        if (this._isRunning)
            throw new Error('[LOADER]: Cannot add new assets to loader while it is running.');
        this._queue.push({type: 'binary', key: key, url: url});
    }
    json(key, url) {
        this.addJSON(key, url);
    }
    addJSON(key, url) {
        if (this._isRunning)
            throw new Error('[LOADER]: Cannot add new assets to loader while it is running.');
        this._queue.push({type: 'json', key: key, url: url});
    }
    font(key, url) {
        this.addFont(key, url);
    }
    addFont(key, url) {
        if (this._isRunning)
            throw new Error('[LOADER]: Cannot add new assets to loader while it is running.');
        this._queue.push({type: 'font', key: key, url: url});
    }
    addBitmapFont(key, textureUrl, dataUrl) {
        if (this._isRunning)
            throw new Error('[LOADER]: Cannot add new assets to loader while it is running.');
        this._queue.push({type: 'bitmapfont', key: key, url: textureUrl, data: dataUrl});
    }
    addSpine(key, dataUrl, packed = false) {
        if (this._isRunning)
            throw new Error('[LOADER]: Cannot add new assets to loader while it is running.');
        this._queue.push({type: 'spine', key: key, data: dataUrl, packed: packed});
    }
    addSpritesheet(key, url, frameWidth, frameHeight, frameMax, margin, spacing) {
        if (this._isRunning)
            throw new Error('[LOADER]: Cannot add new assets to loader while it is running.');
        this._queue.push({type: 'spritesheet', key: key, url: url, frameWidth: frameWidth, frameHeight: frameHeight, frameMax: frameMax, margin: margin, spacing: spacing});
    }
    addAtlas(key, textureUrl, dataUrl, data) {
        if (this._isRunning)
            throw new Error('[LOADER]: Cannot add new assets to loader while it is running.');
        this._queue.push({type: 'atlas', key: key, textureUrl: textureUrl, dataUrl: dataUrl, data: data});
    }
    start() {
        if (this._isRunning)
            throw new Error('[LOADER]: already running.');
        this._isRunning = true;
        this._progress = 0;
        this.onStart.dispatch();

        async.eachLimit(this._queue, 10, (file, callback) => {
            this.onUpdate.dispatch(this.progress);
            this._progress++;
            switch (file.type) {
                case 'image':
                    this.loadImage(file, callback);
                    break;
                case 'sound':
                    this.loadSound(file, callback);
                    break;
                case 'binary':
                    this.loadBinary(file, callback);
                    break;
                case 'json':
                    this.loadJSON(file, callback);
                    break;
                case 'font':
                    this.loadFont(file, callback);
                    break;
                case 'bitmapfont':
                    this.loadBitmapFont(file, callback);
                    break;
                case 'spritesheet':
                    this.loadSpritesheet(file, callback);
                    break;
                case 'atlas':
                    this.loadAtlas(file, callback);
                    break;
                case 'spine':
                    this.loadSpine(file, callback);
                    break;
                default:
                    console.error('Unknown filetype: ' + file.type);
                    break;
            }
        }, (err) => {
            this._queue = [];
            this._isRunning = false;
            if (err)
                return this.onError.dispatch(err);
            this.onComplete.dispatch();
        });
    }
    loadSpine(file, callback) {
        const images = [];
        const basename = file.data.substring(file.data.lastIndexOf('/') + 1).replace('.json', '');
        const path = file.data.substring(0, file.data.lastIndexOf('/') + 1);
        const uber = this.cache.getJSON('uber_json');
        let jsonData = null;
        let atlasData = null;

        async.waterfall([
            (callback) => {
                if (uber) {
                    if (uber[basename + '.json']) {
                        jsonData = uber[basename + '.json'];
                    } else {
                        console.color('No JSON data for ' + file.key + ' in uber_json', '#ff00ff', '#000000');
                        return callback('No JSON data for ' + file.key + ' in uber_json');
                    }

                    if (uber.atlases && uber.atlases[basename + '.atlas']) {
                        atlasData = uber.atlases[basename + '.atlas'];
                    } else {
                        console.color('No atlas data for ' + file.key + ' in uber_json', '#ff00ff', '#000000');
                        return callback('No atlas data for ' + file.key + ' in uber_json');
                    }
                    return callback();
                }


                Loader.loadFile(path + basename + '.json', 'text', (err, data) => {
                    if (err)
                        return callback(err);
                    jsonData = JSON.parse(data);
                    Loader.loadFile(path + basename + '.atlas', 'text', (err, data) => {
                        if (err)
                            return callback(err);
                        atlasData = data;
                        callback();
                    });
                });
            },
            (callback) => {
                if (file.packed) {
                    const spineAtlas = new PIXI.spine.core.TextureAtlas(atlasData);
                    const spineAtlasLoader = new PIXI.spine.core.AtlasAttachmentLoader(spineAtlas);
                    const spineJsonParser = new PIXI.spine.core.SkeletonJson(spineAtlasLoader);
                    const spineData = spineJsonParser.readSkeletonData(jsonData);

                    this.cache.addSpine(file.key, spineData);
                    return callback();
                }
                const spineAtlas = new PIXI.spine.core.TextureAtlas(atlasData, function (line, callback) {
                    const tex = PIXI.BaseTexture.fromImage(path + line);
                    images.push(tex);
                    callback(tex);
                });

                const spineAtlasLoader = new PIXI.spine.core.AtlasAttachmentLoader(spineAtlas);
                const spineJsonParser = new PIXI.spine.core.SkeletonJson(spineAtlasLoader);
                const spineData = spineJsonParser.readSkeletonData(jsonData);

                this.cache.addSpine(file.key, spineData);
                async.every(images, (item, callback) => {
                    if (item.hasLoaded)
                        return callback(null, true);

                    item.on('loaded', () => {
                        callback(null, true);
                    });
                    item.on('error', (err) => {
                        callback(err, false);
                    });
                }, (err, success) => {
                    callback(err);
                });
            }
        ], (err) => {
            callback(err);
        });
    }
    loadFont(file, callback) {
        const ua = window.navigator.userAgent;
        const isIE = /MSIE|Trident/.test(ua);
        const url = isIE ? file.url.replace('otf', 'ttf') : file.url;
        const style = document.createElement('style');

        style.appendChild(document.createTextNode("@font-face {font-family: " + file.key + ";src: url('" + url + "') format('" + (isIE ? "truetype" : "opentype") + "');}"));
        document.head.appendChild(style);
        WebFont.load({
            timeout: 30 * 1000,
            custom: {
                families: [file.key]
            },
            fontinactive: (name) => {
                callback(name + ' failed to load');
            },
            fontactive: (name) => {
                this.cache.addFont(name, style);
                callback();
            }
        });
    }
    loadBitmapFont(file, callback) {
        new PIXI.loaders.Loader().add(file.key, file.data)
            .load((loader, resources) => {
                // TODO: error handling
                this.cache.addBitmapFont(file.key, resources[file.key]);
                callback();
            });
    }
    loadImage(file, callback) {
        const image = new Image();

        image.onload = () => {
            const baseTexture = new PIXI.BaseTexture(image);
            Loader.validateTexture(file.key, baseTexture);
            const tex = new PIXI.Texture(baseTexture);
            this.cache.addTexture(file.key, tex, true);
            callback();
        };

        image.onerror = () => {
            callback(file.key + ' failed to load');
        };

        image.src = file.url;
    }

    loadSpritesheet(file, callback) {
        const image = new Image();

        image.onload = () => {
            const baseTexture = new PIXI.BaseTexture(image);
            Loader.validateTexture(file.key, baseTexture);
            const tex = new PIXI.Texture(baseTexture);
            this.cache.addTexture(file.key, tex, true);

            let frames = {};
            let x = 0;
            let y = 0;
            let index = 0;
            const height = baseTexture.height;
            const width = baseTexture.width;
            const frameHeight = file.frameHeight || height;
            const frameWidth = file.frameWidth || width;

            while (true) {
                if (y + frameHeight > height)
                    break;

                x = 0;
                while (true) {
                    if (x + frameWidth > width)
                        break;

                    frames[index++] = {
                        frame: {
                            x: x,
                            y: y,
                            w: frameWidth,
                            h: frameHeight
                        }
                    };

                    x += frameWidth;
                }
                y += frameHeight;
            }
            const sheet = new PIXI.Spritesheet(baseTexture, {
                frames: frames,
                animations: {default: _.keys(frames)},
                meta: {
                    format: 'RGBA8888',
                    size: {w: width, h: height},
                    scale: 1
                }
            });
            sheet.parse(() => {
                this.cache.addSpritesheet(file.key, sheet, true);
                callback();
            });
        };

        image.onerror = () => {
            callback(file.key + ' failed to load');
        };

        image.src = file.url;
    }

    loadAtlas(file, callback) {
        var cbCalled = false;
        var img = new Image();

        const cb = (err, blob) => {
            if (cbCalled)
                return false;

            cbCalled = true;
            const parseData = (data, callback) => {
                if (_.isArray(data.frames)) {
                    data.frames = _.reduce(data.frames, function (obj, param) {
                        obj[param.filename] = param;
                        delete obj[param.filename].filename;
                        return obj;
                    }, {});
                }

                var baseTexture = new PIXI.BaseTexture(img);
                Loader.validateTexture(file.key, baseTexture);
                const atlas = new PIXI.Spritesheet(baseTexture, data);

                atlas.parse(() => {
                    this.cache.addAtlas(file.key, atlas, true);
                    callback();
                });
            };

            if (file.data)
                return parseData(file.data, callback);

            Loader.loadFile(file.dataUrl, 'json', (err, json) => {
                if (err)
                    return callback(file.key + ' failed to load');

                this.cache.addJSON(file.key, json, true); // TODO: возможно, в этом нет смысла
                return parseData(json, callback);
            });
        };

        img.onload = cb;
        img.onerror = function () {
            return callback(file.key + ' failed to load');
        };
        img.src = file.textureUrl;

        if (img.complete && img.width && img.height)
            cb();
    }

    loadSound(file, callback) {
        Loader.loadFile(file.url, 'blob', (err, blob) => {
            if (err)
                return callback(file.key + ' failed to load');
            this.cache.addBlob(file.key, blob, true);
            // TODO: сделать звук
            callback();
        });
    }
    loadJSON(file, callback) {
        Loader.loadFile(file.url, 'text', (err, blob) => {
            if (err)
                return callback(file.key + ' failed to load');
            this.cache.addJSON(file.key, JSON.parse(blob), true);
            callback();
        });
    }
    loadBinary(file, callback) {
        Loader.loadFile(file.url, 'arraybuffer', (err, buffer) => {
            if (err)
                return callback(file.key + ' failed to load');
            this.cache.addBinary(file.key, buffer, true);
            callback();
        });
    }
    static validateTexture(key, baseTexture) {
        if (!baseTexture)
            return console.color(key + ' base texture is undefined', '#ff0000');
        if (baseTexture.width === 0 || baseTexture.height === 0)
            return console.color(key + ' base texture size is invalid: 0', '#ff0000');
        if (baseTexture.width % 4 !== 0 || baseTexture.height % 4)
            return console.color(key + ' base texture size is invalid: ' + baseTexture.width + ' : ' + baseTexture.height, '#ff0000');

    }
    static loadFile(url, type, callback) {
        type = type || 'blob';
        const client = new XMLHttpRequest();

        client.onloadstart = () => {
            client.responseType = type;
        };

        client.onload = () => {
            if (client.status !== 200) {
                console.color('FAIL [' + client.status + ']: ' + url, '#ff0000');
                return callback('Failed to load file', null);
            }

            if (!client.response) {
                console.color('FAIL [EMPTY]: ' + url, '#ff0000');
                return callback('Failed to load file', null);
            }

            callback(null, client.response);
        };

        client.onerror = () => {
            console.color('FAIL: ' + url, '#ff0000');
            return callback('Failed to load file', null);
        };

        client.ontimeout = () => {
            console.color('TIMEOUT: ' + url, '#ff0000');
            return callback('Failed to load file', null);
        };

        client.open('GET', url, true);
        client.send();
    }
};



nge.Mlm.LocalData = {};



nge.Mlm.LocalData.Controller = function () {
    var _vars = {};
    
    /**
     * Получить значение из локальное хранилища
     * @param {mixed} name  val1.val2.val3 || [val1, val2, val3]
     * @returns {mixed}
     */
    this.get = function (name) {
        return nge.Lib.Helper.recursiveGet(name, _vars);
    };

    /**
     * Положить значение в локальное хранилище
     * @param {mixed} key  val1.val2.val3 || [val1, val2, val3]
     * @param {mixed} value
     * @returns {Boolean}
     */
    this.set = function (key, value) {
        nge.Lib.Helper.recursiveSet(key, value, _vars);
        return true;
    };
    
    /**
     * Получить все содержимое хранилища
     * @returns {Object}
     */
    this.getAll = function(){
        return _vars;
    };
};



nge.Mlm.Objects = {};



nge.Mlm.Objects.Animation = function (param) {
    if (!param)
        param = {};

    return {
        'id': (param.hasOwnProperty('id')) ? param.id : false,
        'name': (param.hasOwnProperty('name')) ? param.name : false,
        'class': (param.hasOwnProperty('class')) ? param.class : false,
        'anchorX': (param.hasOwnProperty('anchorX')) ? param.anchorX : 0,
        'anchorY': (param.hasOwnProperty('anchorY')) ? param.anchorY : 0,
        'scaleX': (param.hasOwnProperty('scaleX')) ? param.scaleX : 1,
        'scaleY': (param.hasOwnProperty('scaleY')) ? param.scaleY : 1,
        'alignX': (param.hasOwnProperty('alignX')) ? param.alignX : 'left',
        'alignY': (param.hasOwnProperty('alignY')) ? param.alignY : 'top',
        'angle': (param.hasOwnProperty('angle')) ? param.angle : 0,
        'alpha': (param.hasOwnProperty('alpha')) ? param.alpha : 1,
        'isVisible': (param.hasOwnProperty('isVisible')) ? param.isVisible : true,
        'x': (param.hasOwnProperty('x')) ? param.x : 0,
        'y': (param.hasOwnProperty('y')) ? param.y : 0,
        'z': (param.hasOwnProperty('z')) ? param.z : 0,
        'type': mt.objects.ANIMATION,
        'assetKey': (param.hasOwnProperty('assetKey')) ? param.assetKey : ((param.frames && param.frames[0]) ? param.frames[0] : false),
        'speed': (param.hasOwnProperty('speed')) ? param.speed : 1,
        'loop': (param.hasOwnProperty('loop')) ? param.loop : false,
        'frames': (param.hasOwnProperty('frames')) ? param.frames : [],
        'autoStart': (param.hasOwnProperty('autoStart')) ? param.autoStart : false,
        'blendMode': (param.hasOwnProperty('blendMode')) ? param.blendMode : PIXI.BLEND_MODES.NORMAL,
        //system
        _originalModel: (param.hasOwnProperty('_originalModel')) ? param._originalModel : (param) ? nge.Lib.Helper.jsObjClone(param) : null
    };
};



nge.Mlm.Objects.Controller = function () {
    var _service;

    this.init = function () {
        _service = new nge.Mlm.Objects.Service();
    };

    /**
     * create object
     * @param {mixed} obj - name of the object/object
     * @param {Group} [parent] - parent of the created object group or sprite
     * @param {Boolean} [noRefreshStyles] - no refresh styles flag
     */
    this.create = mt.create.bind(mt);

    /**
     * 
     * @param {string} from classNAME
     * @param {string} to cnassNAME
     * @param {function} callback
     * @param {number} duration
     * @param {nge.Lib.Tween.Easing} easing
     * @returns {boolean}
     */
    this.classAnimation = function (from, to, callback, duration, easing) {
        return _service.classAnimation(from, to, callback, duration, easing);
    };

    this.find = function (key, parent) {
        return _service.find(key, parent);
    };

    this.findAll = function (key, parent) {
        return _service.findAll(key, parent);
    };

    this.findOne = function (key, parent) {
        return _service.findOne(key, parent);
    };

    this.refreshStyles = function (object) {
        return _service.refreshStyles(object);
    };

    this.setStyles = function (object) {
        return _setStyles(object);
    };

    this.checkInputOnTop = function (btnObj) {
        return _service.checkInputOnTop(btnObj);
    };

    this.blockUpdateStyles = function () {
        return _service.blockUpdateStyles();
    };

    this.unblockUpdateStyles = function () {
        return _service.unblockUpdateStyles();
    };

    this.changeImageSize = function (key, posX, posY, width, height, newImageWidth, newImageHeight, newKey) {
        return _service.changeImageSize(key, posX, posY, width, height, newImageWidth, newImageHeight, newKey);
    };

    /**
     * findItemInWorld by param function. Do not use out of core !
     * @param {String} key
     * @param {String} value
     * @param {Object} parent
     * @param {Boolean} incompleteCompliance
     * @returns {Boolean}
     */
    this.findItemInWorld = function (key, value, parent, incompleteCompliance) {
        return _service.findItemsInWorld(key, value, parent, incompleteCompliance, true);
    };

    /**
     * findItemsInWorld by param function. Do not use out of core !
     * @param {String} key
     * @param {String} value
     * @param {Object} parent
     * @param {Boolean} incompleteCompliance
     * @param {Boolean} findOne
     * @returns {mixed}
     */
    this.findItemsInWorld = function (key, value, parent, incompleteCompliance, findOne) {
        return _service.findItemsInWorld(key, value, parent, incompleteCompliance, findOne);
    };

    var _setStyles = function (object) {
        return _service.setStyles(object);
    };

    this.takeScreenshot = function(key) {
        const resCfg = nge.App.getInstance('Cfg.Resolutions').get();
        const resolution = resCfg[0]; // TODO: refactor to resoilutionManager.getTemplateSize()
        const scaleX = nge.wrap.states.world.scale.x;
        const scaleY = nge.wrap.states.world.scale.y;
        nge.wrap.states.world.scale.set(1, 1);
        nge.wrap.states.world.updateTransform();
        const tex = nge.wrap.states.renderer.generateTexture(nge.wrap.states.world, PIXI.SCALE_MODES.LINEAR, 1, new PIXI.Rectangle(0, 0, resolution.width, resolution.height));
        nge.wrap.states.world.scale.set(scaleX, scaleY);
        nge.wrap.states.world.updateTransform();
        nge.wrap.cache.addTexture(key, tex);
        return tex;
    };

    this.generateTexture = function (object) {
        return nge.wrap.states.renderer.generateTexture(object);
    };

    this.saveTexture = function (object, key) {
        if (!object.generateTexture)
            return false;
            
        var renderTexture = this.generateTexture(object);
        nge.wrap.cache.addTexture(key, renderTexture);

        return true;
    };
    
    this.resetStateHandler = function(){
        return _service.resetStateHandler();
    };
    
    this.createHandler = function(object){
        return _service.createHandler(object);
    };
    
    this.destroyHandler = function(object){
        return _service.destroyHandler(object);
    };

    this.addClassToCache = function(obj, cls) {
        return _service.addClassToCache(obj, cls);
    };

    this.removeClassFromCache = function(obj, cls) {
        return _service.removeClassFromCache(obj, cls);
    };
};



nge.Mlm.Objects.Service = function () {
    var _blockUpdateStyles = false;
    var _cache;

    this.blockUpdateStyles = function () {
        _blockUpdateStyles = true;
    };

    this.unblockUpdateStyles = function () {
        _blockUpdateStyles = false;
    };

    this.setStyles = function (object) {
        if (_blockUpdateStyles)
            return false;

        for (var k in mt.data.styles) {
            var styles = mt.data.styles[k];

            var els = nge.findAll(k, object);

            if (els)
                for (var k1 in els) {
                    els[k1].getData()._styles[k] = styles;
                    var elData = els[k1].getData();

                    for (var style in styles) {
                        var value = styles[style];

                        //cant rewrite own objects properties
                        if (typeof (value) === "object" && elData._originalModel[style]) {
                            for (var k2 in value) {
                                var v = value[k2];

                                if (!elData._originalModel[style][k2])
                                    els[k1].attr(style + '.' + k2, v, true);
                            }
                        } else {
                            if (!elData._originalModel[style])
                                els[k1].attr(style, value, true);
                        }
                    }
                }
        }
    };

    this.refreshStyles = function (object) {
        if (_blockUpdateStyles)
            return false;

        var parent = (object) ? object : nge.wrap.states.world;

        var f = function (els, n) {
            for (var k in els) {
                var el = els[k];

                if (
                    el &&
                    el.mt &&
                    el.mt.data
                    )
                    el.defaultStyle();

                if (el.children && el.children.length > 0)
                    var res = f(el.children, n);
            }
            return true;
        };

        f([parent]);
        this.setStyles(object);
        return true;
    };

    this.find = function (key, parent) {
        var res = _find(key, parent);
        return (res.length === 0) ? false : (res.length === 1) ? res[0] : res;
    };

    this.findAll = function (key, parent) {
        var res = _find(key, parent);
        return (res.length === 0) ? false : res;
    };

    this.findOne = function (key, parent) {
        var res = _find(key, parent, true);
        return (res.length === 0) ? false : res[0];
    };

    this.classAnimation = function (from, to, callback, duration, easing) {
        if (!from || !to)
            return false;

        var p = {
            'from': from,
            'to': to,
            'duration': (duration) ? duration : 1000,
            'easing': (easing) ? easing : nge.Lib.Tween.Easing.Linear.None
        };

        var fromProps = _parseSelector(p.from);
        var toProps = _parseSelector(p.to);
        var animationStyles = [];

        //find in styles this classes usage
        for (var k in mt.data.styles) {
            var styleProps = _parseSelector(k);
            var kFrom = fromProps.length - 1;
            var kTo = toProps.length - 1;

            //chk
            for (var i = styleProps.length - 1; i >= 0; i--) {
                kFrom -= nge.Lib.Helper.chkArraysPartialEntry(
                    styleProps[i], fromProps[kFrom]);
                kTo -= nge.Lib.Helper.chkArraysPartialEntry(
                    styleProps[i], toProps[kTo]);
            }

            if (kFrom === -1) {
                //fast implementation
                var tempTo = nge.Lib.Helper.strReplace(p.from, p.to, k);

                if (mt.data.styles[tempTo])
                    animationStyles.push({from: k, to: tempTo});
            }
        }

        _animateStyles(p, animationStyles, callback);
    };


    this.checkInputOnTop = function (button) {

        if (!button || button.constructor !== Phaser.Button)  //TODO
            return false;

        var activePointer = nge.game.input.activePointer;

        var activePointerOldPosition = activePointer.position;

        activePointer.x = button.world.x + (1 - button.anchor.x * 2) * button.width / 2;
        activePointer.y = button.world.y + (1 - button.anchor.y * 2) * button.height / 2;

        activePointer.dirty = true;
        activePointer.update();

        var target = activePointer.targetObject;

        activePointer.x = activePointerOldPosition.x;
        activePointer.y = activePointerOldPosition.y;

        activePointer.dirty = true;
        activePointer.update();

        if (target && target.sprite)
            return target.sprite === button;
        else
            return false;
    };

    this.changeImageSize = function (key, posX, posY, width, height, newImageWidth, newImageHeight, newKey) {
        var bmd = nge.game.add.bitmapData(newImageWidth, newImageHeight);
        bmd.fill(255, 255, 255, 0);

        var sprite = nge.game.make.sprite(0, 0, key);

        if (width)
            sprite.width = width;

        if (height)
            sprite.height = height;

        bmd.draw(sprite, posX, posY);

        nge.wrap.cache.addBitmapData(newKey, bmd);

        return bmd;
    };

    this.createHandler = function (object) {
        return _addInCache(object);
    };

    this.destroyHandler = function (object) {
        return _removeFromCache(object);
    };

    this.resetStateHandler = function () {
        _resetCache();
    };

    this.removeClassFromCache = function (obj, className) {
        var uid = obj.getData().uid;
        if (_cache['class'][className])
            delete _cache['class'][className][uid];
    };

    this.addClassToCache = function (obj, className) {
        var uid = obj.getData().uid;
        if (!_cache['class'][className])
            _cache['class'][className] = {};

        _cache['class'][className][uid] = obj;
    };

    this.findItemsInWorld = function (key, value, parent, incompleteCompliance, findOne) {
        parent = parent || nge.game.world;

        var cached = _findInCache(key, value, findOne);
        if (cached)
            return cached;

        return nge.Lib.Helper.customRecursiveFind('mt.data.' + key, value, 'children', parent, incompleteCompliance, findOne);
    };

    var _animateStyles = function (p, animationStyles, callback) {
        var ends = 0;

        //callback in the end
        var chkCallbackTime = function () {
            ends++;

            if (ends === animationStyles.length && callback) {
                //nge.objects.setStyles(); 4 better performance --//in Animator
                callback();
            }
        };

        //animation        
        for (var i = 0; i < animationStyles.length; i++) {
            var sel = animationStyles[i];
            var elements = nge.findAll(sel.from);

            _tweensStyles(
                function () {
                    _switchClasses(p);
                    chkCallbackTime();
                },
                p,
                mt.data.styles[sel.from],
                mt.data.styles[sel.to],
                elements
                );
        }
    };

    var _tweensStyles = function (callback, p, from, to, elements, addKey) {
        var tweenObjFrom = {};
        var tweenObjTo = {};

        for (var k in to) {
            if (typeof to[k] === "number" && from[k] !== to[k]) {
                tweenObjFrom[k] = from[k];
                tweenObjTo[k] = to[k];
            } else if (typeof from[k] === "object") {
                _tweensStyles(false, p, from[k], to[k], elements, k);
            } else if (from[k] !== to[k]) {
                //string value
                var key = k;

                if (addKey)
                    key = addKey + '.' + key;

                _setElementsAttr(elements, key, to[k]);
            }
        }
        var tween = nge.tween.add(tweenObjFrom);

        tween.to(tweenObjTo, p.duration, p.easing);

        tween.onUpdateCallback(function (context, time, tweenData) {
            for (var k in context.target) {
                var key = k;

                if (addKey)
                    key = addKey + '.' + key;
                _setElementsAttr(elements, key, context.target[k]);
            }
        }).onComplete.add(function () {
            if (callback)
                callback();
        });
        tween.start();
    };

    var _setElementsAttr = function (elements, key, value) {
        for (var kEl in elements)
            elements[kEl].attr(key, value, true);
    };

    var _switchClasses = function (p) {
        var elements = nge.findAll(p.from);

        for (var k in elements) {
            elements[k].removeClass(
                nge.Lib.Helper.strReplace('.', '', p.from), true
                ).addClass(
                nge.Lib.Helper.strReplace('.', '', p.to), true
                );
        }

        return true;
    };

    var _find = function (key, parent, returnFirst) {
        var properties = _parseSelector(key);

        //last rule. We are finding lowest element by first element selector param and then will check his parents
        var rule = properties[properties.length - 1][0];

        //get elements
        var incompleteCompliance = 0;

        if (rule.type === 'class')
            incompleteCompliance = 1;

        var parent = (parent) ? parent : false;

        //find one element if just one prop
        var findOne = (returnFirst && properties.length === 1 && properties[0].length === 1) ? true : false;

        var els = nge.objects.findItemsInWorld(
            rule.type, rule.value, parent, incompleteCompliance, findOne
            );

        if (findOne) //transform element to array
            els = (els) ? [els] : [];

        if (!els || els.length === 0)
            return false;

        var chkExpected = function (data, props) {
            for (var j = 0; j < elProps.length; j++) {
                var prop = elProps[j];

                if (prop.type === 'class') {
                    if (!data[prop.type] || data[prop.type].split(' ').indexOf(prop.value) === -1)
                        return false;
                } else if (data[prop.type] !== prop.value)
                    return false;

            }

            return true;
        };

        var result = [];

        //now we will check objects for the others key selector parts
        for (var k in els) {
            var el = els[k];
            //first step is check own objects selectors conformity
            var elProps = properties[properties.length - 1];

            if (!chkExpected(el.getData(), elProps))
                continue;

            if (properties.length === 1) {
                result.push(el);

                if (returnFirst)
                    return result;

                continue;
            }

            //now we will check objects parents (for complex selectors)
            var parent = el.parent;

            for (var i = properties.length - 2; i >= 0; i--) {
                var elProps = properties[i];
                var res = 0;

                while (res !== 1 && parent.getData) {
                    if (chkExpected(parent.getData(), elProps))
                        res = 1;

                    parent = parent.parent;
                }

                if (res === 1 && i === 0) { //last propertie from selector and all is good
                    result.push(el);

                    if (returnFirst)
                        return result;
                }

                if (res === 0)
                    break;
            }
        }

        return result;
    };

    var _parseSelector = function (key) {
        //logic
        var selectors = key.split(' ');
        var properties = [];

        //to array of arrays of props
        for (var k in selectors) {
            var selector = _parseSelectorPart(selectors[k]);

            if (!selector) {
                console.info('Info: nge.find no element with selector found:', selectors[k]);
                return false;
            }

            properties[k] = selector;
        }

        return properties;
    };

    var _parseSelectorPart = function (sk) {
        var characterEncoding = "(?:\\\\.|[\\w-]|[^\\x00-\\xa0])+";
        var matchExpr = {
            "id": new RegExp("^#(" + characterEncoding + ")"),
            "name": new RegExp("^\\^(" + characterEncoding + ")"),
            "class": new RegExp("^\\.(" + characterEncoding + ")")
        };

        var res = [];

        for (var type in matchExpr) {
            var found = matchExpr[ type ].exec(sk);

            if (found) {
                res.push({type: type, value: found[1]});
                var skn = nge.Lib.Helper.strReplace(found[0], '', sk);
                var other = _parseSelectorPart(skn);

                if (other)
                    return nge.Lib.Helper.mergeArrs(res, _parseSelectorPart(skn));
            }
        }

        return (res && res.length > 0) ? res : false;
    };

    var _resetCache = function () {
        _cache = {id: {}, name: {}, class: {}};
    };

    var _addInCache = function (object) {
        if (!_cache)
            return;

        if (!object.mt || !object.mt.data)
            return;

        var data = object.getData();
        var uid = data.uid;

        if (!uid) {
            console.warn('object doesn\'t have uid');
            return;
        }


        var name = data.name;
        var classes = data.class ? data.class.split(' ') : [];
        var id = data.id;

        var createItem = function (type, value, uid, obj) {
            if (!_cache[type][value])
                _cache[type][value] = {};
            _cache[type][value][uid] = obj;
        };

        createItem('id', id, uid, object);
        createItem('name', name, uid, object);

        for (let cls of classes) {
            createItem('class', cls, uid, object);
        }
    };

    // TODO: destroy у объектов вызывается после сброса кеша
    var _removeFromCache = function (object) {
        if (!_cache)
            return;

        if (!object.mt || !object.mt.data)
            return;

        const data = object.getData();

        var uid = data.uid;
        if (!uid) {
            console.warn('object doesn\'t have uid');
            return;
        }

        var name = data.name;
        var classes = data.class ? data.class.split(' ') : [];
        var id = data.id;

        var deleteItem = function (type, value, uid) {
            if (value && _cache[type][value]) {
                delete _cache[type][value][uid];
                if (Object.keys(_cache[type][value]).length === 0)
                    delete _cache[type][value];
            }
        };

        deleteItem('id', id, uid);
        deleteItem('name', name, uid);

        for (let cls of classes) {
            deleteItem('class', cls, uid);
        }

        if (object.chidren) {
            for (let child of object.children)
                _removeFromCache(child);
        }
    };

    // TODO: сюда нужно передавать опциональный parent объекта. Влияет на производительность setStyles и результаты выдачи
    var _findInCache = function (key, value, findOne) {
        if (!_cache)
            return false;

        var item = _cache[key][value];
        if (!item)
            return false;

        var objects = Object.values(item);

        if (objects.length === 0)
            return false;

        if (findOne)
            return objects[objects.length - 1];
        return objects;
    };
};



nge.Mlm.Objects.Base = function () {
    var _object;
    var _original;

    this._sizeParams = {
        width: {
            c: 'x', //coords
            sn: 'width', //sizeName
            max: 'maxWidth' //max size
        },
        height: {
            c: 'y', //coords
            sn: 'height', //sizeName
            max: 'maxHeight' //max size
        }
    };

    this.baseInit = function () {
        _object = this;
        _object.stylesInit();
        _object.autoCheckMaxSize();
    };

    this.stylesInit = function () {
        var data = _object.getData();
        _original = data._originalModel;
        _validate();
    };

    this.autoCheckMaxSize = function () {
        if (_object.getData().maxWidth)
            if (_object.getData()._customAutoCheckMaxSize)
                _object.getData()._customAutoCheckMaxSize('width');
            else
                console.error('nge.Mlm.Objects.Base autoCheckMaxSize error !');
        //TODO
        //nge.Lib.Helper.makeReactive(_object, 'width', _object.maxSizeResize);

        if (_object.getData().maxHeight)
            if (_object.getData()._customAutoCheckMaxSize)
                _object.getData()._customAutoCheckMaxSize('height');
            else
                console.error('nge.Mlm.Objects.Base autoCheckMaxSize error !');
        //TODO
        //nge.Lib.Helper.makeReactive(_object, 'height', _object.maxSizeResize);
    };

    this.addClass = function (name, doNotRefreshStyles) {
        var data = this.getData();
        var curClass = data.class;

        if (!curClass)
            data.class = name;
        else {
            if (curClass.split(' ').indexOf(name) !== -1)
                return false;
            data.class += ' ' + name;
        }

        nge.objects.addClassToCache(_object, name);

        if (!doNotRefreshStyles)
            nge.objects.setStyles(_object);

        return _object;
    };

    this.removeClass = function (name, doNotRefreshStyles) {
        var classData = _checkClass(name);

        if (classData) {
            nge.objects.removeClassFromCache(_object, name);
            var data = this.getData();
            classData.classArr.splice(classData.index, 1);
            data.class = classData.classArr.join(' ');

            if (!doNotRefreshStyles)
                nge.objects.refreshStyles(_object);
        }

        return _object;
    };

    /**
     * 
     * @param {String} name
     * @returns {Boolean}
     */
    this.hasClass = function (name) {
        return _checkClass(name) ? true : false;
    };

    this.defaultStyle = function () {
        var data = _object.getData();
        for (var k in data._styles) {
            var styles = data._styles[k];
            //откатываем стили на стандартные
            for (var k1 in styles) {
                if ("object" === typeof styles[k1]) {
                    for (var k2 in styles[k1]) {
                        _applyNewParam(k1 + '.' + k2, styles[k1][k2]);
                    }
                } else if (data.hasOwnProperty(k1))
                    _applyNewParam(k1, data[k1]);
            }
        }
        data._styles = {};
        //_applyNewModel(data, false, false, true);
    };

    this.attr = function (k, v, sys) {
        //just get
        if (v === undefined)
            return _getByParam(k);

        //apply object
        if ("object" === typeof v) {
            _applyNewModel(v, k, true);

            if (!sys)
                nge.Lib.Helper.recursiveSet(
                    k,
                    nge.Lib.Helper.objectApply(_original[k], v),
                    _original
                    );

        } else {
            //apply single
            _applyNewParam(k, v, true);
            
            // TODO: мешает использованию attr при создании объектов
            //if (!sys)
            //    nge.Lib.Helper.recursiveSet(k, v, _original);
        }

        _validate();
    };

    this.maxWidthResize = (function () {
        var dirty = false;

        return function (maxWidth, a) {
            if (dirty)
                return false;

            dirty = true;
            var scaleNeed = ((_object.scale.y * maxWidth) / _object.width);

            if (scaleNeed > 1)
                scaleNeed = 1;

            if (_object.scale.x === scaleNeed && _object.scale.y === scaleNeed)
                return false;

            _object.scale.x = _object.scale.y = scaleNeed;
            dirty = false;
        };
    })();

    this.maxSizeResize = (function () {
        var dirty = false;

        /**
         * 
         * @param {Number} maxSize
         * @param {String} sizeType width/height
         * @returns {Boolean}
         */
        return function (sizeType, maxSize) {
            if (dirty)
                return false;

            dirty = true;

            var sp = (sizeType === 'height') ? _object._sizeParams.height : _object._sizeParams.width;
            var scaleNeed = ((_object.scale[sp.c] * maxSize) / _object[sp.sn]);

            if (scaleNeed > 1)
                scaleNeed = 1;

            if (_object.scale[sp.c] !== scaleNeed)
                _object.scale.x = _object.scale.y = scaleNeed;

            dirty = false;
        };
    })();

    var _checkClass = function (name) {
        var data = _object.getData();
        var curClass = data.class;

        if (!curClass)
            return false;

        var classArr = data.class.split(' ');
        var nameIndex = classArr.indexOf(name);

        if (nameIndex !== -1)
            return {classArr: classArr, index: nameIndex};

        return false;
    };

    var _getByParam = function (k) {
        var worldKey = _mtPhaserAliases[k];

        if (worldKey)
            if (worldKey.indexOf('function.') === 0)
                return _launchCuntomFunction(worldKey, 'get');
            else
                return nge.Lib.Helper.recursiveGet(worldKey, _object);
        else
            return null;
    };

    var _applyNewModel = function (model, key, rewrite, setDefauls) {
        for (var k in model) {
            var v = model[k];

            var nKey = k;
            if (key)
                nKey = key + '.' + k;

            if ("object" === typeof v) {
                _applyNewModel(v, nKey, rewrite, setDefauls);
            } else
                _applyNewParam(nKey, v, rewrite, setDefauls);
        }
    };

    var _applyNewParam = function (k, v, rewrite, setDefauls) {
        //chk original value
        if (!rewrite)
            if (nge.Lib.Helper.recursiveGet(k, _original))
                return false;

        //chk if changed manualy
        //todo

        //alpply to world
        var worldKey = _mtPhaserAliases[k];
        if (worldKey) {
            if (worldKey.indexOf('function.') === 0)
                _launchCustomFunction(worldKey, 'set', v);
            else
                mt.recursiveSet(worldKey, v, _object); 
        }
        else if (!setDefauls)
            console.error('Fatal Error: worldKey not found in nge.Mlm.Objects.Base, key=', k);

        return true;
    };

    var _launchCustomFunction = function (key, action, value) {
        var funkName = nge.Lib.Helper.strReplace('function.', '', key);

        if (_object[funkName])
            return _object[funkName](action, value);
        else
            console.error('nge.Mlm.Objects.Base custom function call error', _object);
    };

    var _validate = function () {
        if (_object.validate)
            _object.validate();

        return true;
    };

    //todo check all of this params
    var _mtPhaserAliases = {
        'id': 'id',
        'name': 'name',
        'class': 'class',
        'x': 'x',
        'y': 'y',
        'z': 'z',
        'angle': 'angle',
        'anchorX': 'anchor.x',
        'anchorY': 'anchor.y',
        'width': 'width',
        'height': 'height',
        'sWidth': 'sWidth',
        'sHeight': 'sHeight',
        'sType': 'sType',
        'scaleX': 'scaleX',
        'scaleY': 'scaleY',
        'alignX': 'alignX',
        'alignY': 'alignY',
        'rightOffset': 'rightOffset',
        'bottomOffset': 'bottomOffset',
        'alpha': 'alpha',
        'isVisible': 'visible',
        'text': 'text',
        'frame': 'frame',
        'blendMode': 'blendMode',
        'action': 'events.onInputUp._bindings.0._listener',
        'btnFrames.over': '_onOverFrame', //TODO подумать. Быть может сеттеры поставить
        'btnFrames.out': '_onOutFrame',
        'btnFrames.down': '_onDownFrame',
        'btnFrames.up': '_onUpFrame',
        'align': 'align',
        'lineSpacing': 'lineSpacing',
        'style.lineHeight': 'style.lineHeight',
        'style.fontSize': 'style.fontSize',
        'style.fill': 'style.fill',
        'style.stroke': 'style.stroke',
        'style.align': 'style.align',
        'style.font': 'function.handleFont',
        'style.fontFamily': 'style.fontFamily',
        'style.fontWeight': 'style.fontWeight',
        'style.strokeThickness': 'style.strokeThickness',
        'style.wordWrapWidth': 'style.wordWrapWidth',
        'style.wordWrap': 'style.wordWrap',
        'style.shadowOffsetX': 'style.shadowOffsetX',
        'style.shadowOffsetY': 'style.shadowOffsetY',
        'style.shadowColor': 'style.shadowColor',
        'style.shadowBlur': 'style.shadowBlur',
        'style.padding': 'style.padding',
        'enabled': 'input.enabled'
    };
};



