        //RU
        'hP2Text3RU': 'hP2Text3RU(text=hP2Text3RU, font=16pt molot, fill=#53e680, class=coloredText)_text',
        'hP2Text4RU': 'hP2Text4RU(text=hP2Text4RU, font=16pt molot, fill=#53e680, class=coloredText)_text',
        'hP2Text5RU': 'hP2Text5RU(text=hP2Text5RU, font=16pt molot, fill=#53e680, class=coloredText)_text',
