nge.Com.Winlines.Controller = nge.Com.Base.extend(function () {
    this._service;
    this._view;
    var _thumbsService,
        _smCfg,
        _query = [],
        _created,
        _self,
        _container;

    this.preload = function () {
        _self = this;

        this.preloadDefault();
        var cfg = this.getInstance('Cfg', 'slotMachine');
        _smCfg = cfg.get();

        if (!_self._view)
            _self._view = this.getInstance('View');

        if (!_self._service)
            _self._service = this.getInstance('Service');

        _self._service.preload(_self._view);
        return true;
    };

    this.create = function () {
        this.createDefault();

        if (!_created)
            _subscribe();

        _self._service.create(_smCfg);

        var cfg = this.getInstance('Cfg');

        if (cfg.thumbsOn) {
            if (!_thumbsService)
                _thumbsService = this.getInstance('ThumbsService');

            _thumbsService.create(_self._view);
        }

        _stopLinesAnimationWithClearQuery();

        _created = true;
        return true;
    };

    this.destroy = function () {
        _stopLinesAnimationWithClearQuery();
    };

    /**
     * Stores lines cfg and build lines
     * @param lines {Array}
     *
     */
    var _setWinlines = function (lines) {
        _normalizeRowsIndexes(lines);
        _self._view.buildWinLines(lines);
    };

    /**
     * @param lineIndex {number} line number which will be shown
     */
    var _show = function (lineIndex) {
        _self._view.show(lineIndex);
    };
    /**
     * @param lineIndex {number} line number which will be hide
     */
    var _hide = function (lineIndex) {
        _self._view.hide(lineIndex);
    };
    /**
     * hide all lines
     */
    var _hideAll = function () {
        _self._view.hideAll();
    };
    /**
     * save query of winned lines
     * @param data {Object}
     */
    var _setNewQuery = function (data) {
        _self._view.setNewQuery(data);
    };
    /**
     * Shows all winned lines for a short time
     */
    var _animateAll = function () {
        _self._view.animateAll();
    };
    /**
     * animate lines from saved winned lines query one after another
     */
    var _animateByOne = function () {
        _self._view.animateByOne();
    };
    /**
     * Get thumbs and send them via thumbsRespinse
     */
    var _getThumbs = function () {
        var thummbs = _thumbsService.getThumbs();
        nge.observer.fire('winlines.thumbsResponse', thummbs);
    };
    /**
     * show lines by lines quantity
     * @param {number} [selectedLinesCount] [lines quantity]
     */
    var _highlightLines = function (selectedLinesCount) {
        _self._view.highlightLines(selectedLinesCount);
    };
    /**
     * highlight numbers for selected lines
     * @param {number} [selectedLinesCount] [numbers quantity]
     */
    var _highlightNumbers = function (selectedLinesCount) {
        _self._view.highlightNumbers(selectedLinesCount);
    };
    var _stopLinesAnimation = function (clearQuery) {
        nge.observer.fire('winlines.stoppingAnimation.start');
        _self._view.stopLinesAnimation(clearQuery);
        _self._view.hideAll();
    };

    var _pauseLinesAnimation = function () {
        _self._view.stopLinesAnimation();
    };

    var _stopLinesAnimationWithClearQuery = function () {
        _stopLinesAnimation(true);
    };

    var _sendLineToBack = function (lineIndex) {
        _self._view.sendLineToBack(lineIndex);
    };

    var _linesChangeHandler = function () {
        nge.localData.set('winlines.updated', true);
        var selectedLinesCount = nge.localData.get('lines.value');
        _highlightLines(selectedLinesCount);
        _highlightNumbers(selectedLinesCount);
    };

    var _setCurrentLineDuration = function (t) {
        _self._view.setCurrentLineDuration(t);
    };

    var _setCurrentLineDurationFirstTime = function (t) {
        _self._view.setCurrentLineDuration(t, true);
    };

    var _subscribe = function () {
        nge.observer.add('Transport.close', _pauseLinesAnimation);
        nge.observer.add('winlines.set', _setWinlines);

        nge.observer.add('winlines.show', _show);
        nge.observer.add('winlines.hide', _hide);
        nge.observer.add('winlines.hideAll', _hideAll);

        nge.observer.add('slotMachine.spinResponse', _setNewQuery);
        nge.observer.add('winlines.setNewQuery', _setNewQuery);
        nge.observer.add('winlines.animateAll', _animateAll);
        nge.observer.add('winlines.animateByOne', _animateByOne);
        nge.observer.add('winlines.thumbsRequest', _getThumbs);
        nge.observer.add('winlines.sendLineToBack', _sendLineToBack);
        nge.observer.add('lines.change', _linesChangeHandler);
        nge.observer.add('slotMachine.spinStart', _stopLinesAnimation);
        nge.observer.add('winlines.pauseAnimation', _stopLinesAnimation);
        nge.observer.add('winlines.stopAnimation', _stopLinesAnimationWithClearQuery);

        nge.observer.add('winlines.setCurrentLineDuration', _setCurrentLineDuration);
        nge.observer.add('winlines.setCurrentLineDurationFirstTime', _setCurrentLineDurationFirstTime);

        _self.customSubscribe();

        return true;
    };

    this.customSubscribe = function () {
        return true;
    };
});



nge.Com.Winlines.Service = Class.extend(function () {
    var _view;

    this.preload = function (view) {
        _view = view;
        var cfg = this.getInstance('Cfg');

        //preloading custom lineNumber decoration
        if (cfg.numbersCustomDecoration)
            nge.game.load.image(cfg.numbersCustomDecoration, cfg.numbersCustomDecoration);

        return true;
    };

    this.create = function () {
        _view.create();
        _view.normalizeRowsIndexes();
        return true;
    };
});



nge.Com.Winlines.ThumbsService = Class.extend(function () {
    var _thumbs, //@array. contains mini winlines textures. Used for winlines visualization in paytable.
        _cfg,
        _smCfg,
        _winlines,
        _thumbsView;

    this.create = function (view) {
        _cfg = this.getInstance('Cfg');
        _winlines = nge.localData.get('winlines');
        _thumbsView = this.getInstance('ThumbsView');
        var cfg = this.getInstance('Cfg', 'slotMachine');
        _smCfg = cfg.get();
        _createThumbs(view);
        return true;
    };
    /**
     * @return {Array} list with thumbs
     */
    this.getThumbs = function () {
        if (!_thumbs) {
            _createThumbs();
        }
        return _thumbs;
    };

    /**
     * Create thumbnails for win lines. stores them to _thumbs array
     * @param view {Object} Winlines.View instanse
     */
    var _createThumbs = function (view) {

        if (_thumbs && _thumbs.length > 0)
            _destroyThumbs();

        _thumbs = [];
        var thumb,
            line,
            rows = _cfg.thumbs.rows || _smCfg.mh,
            columns = _cfg.thumbs.columns || _smCfg.mw;
        var _thumbsCfg = {
            columns: columns,
            rows: rows,
            rowsIndexesNormalizeValue: _cfg.thumbs.customRowsIndexesNormalizeValue || view.normalizeRowsIndexes(),
            width: _cfg.thumbs.width,
            height: _cfg.thumbs.height,
            cellBgColor: _cfg.thumbs.cellBgColor,
            cellStrokeColor: _cfg.thumbs.cellStrokeColor,
            cellBorderSize: _cfg.thumbs.cellBorderSize,
            lineSize: _cfg.thumbs.lineSize,
            lineColor: _cfg.thumbs.lineColor,
            lineStrokeSize: _cfg.thumbs.lineStrokeSize,
            lineStrokeColor: _cfg.thumbs.lineStrokeColor,
            symbolWidth: (_cfg.thumbs.width - (columns + 1) * _cfg.thumbs.cellBorderSize) / columns,
            symbolHeight: (_cfg.thumbs.height - (rows + 1) * _cfg.thumbs.cellBorderSize) / rows
        };
        for (var i = 0; i < _winlines.length; i++) {
            line = _winlines[i];
            thumb = _thumbsView.drawThumb(_thumbsCfg, view, line);
            //make texture from generated graphics object
            thumb = nge.objects.create(new nge.Mlm.Objects.Image({
                assetKey: '1px_empty'
            }));
            thumb.loadTexture(thumb.generateTexture());
            _thumbs.push(thumb);
        }
    };

    var _destroyThumbs = function () {
        _thumbs=[];
    };
});



nge.Com.Winlines.ThumbsView = Class.extend(function() {
    var _view;
    /**
     * create one thumbnail for win line
     * @param cfg {Object} cfg for thumbs
     * @param view {Object} link to Winlines.View instance
     * @param line {Array} cfg for one win line ex.[0,1,0,1,0]
     * @return {Object} Phaser.Graphics object
     */
    this.drawThumb = function(cfg, view, line) {
        _view = view;
        //cfg.rowsIndexesNormalizeValue = _view.normalizeRowsIndexes();
        var thumb = nge.objects.create(new nge.Mlm.Objects.Graphics(), null);
        drawGrid(thumb, cfg);
        drawLineThumb(thumb, cfg, line);
        return thumb;
    };
    /**
     * Draws first step of thumbnail drawing: background and colored grid
     * @param thumb {Object} Phaser.Graphics object
     * @param cfg {Object} cfg for thumbs
     * @return {Object} Phaser.Graphics object with drawed greed for thumbnail
     */
    var drawGrid = function(thumb, cfg) {
        var radius = 14;
        thumb.beginFill(cfg.cellStrokeColor, 1);
        thumb.drawRoundedRect(0, 0, cfg.width, cfg.height, radius);
        thumb.endFill();
        for (var i = 0; i < cfg.columns; i++) {
            for (var j = 0; j < cfg.rows; j++) {
                thumb.beginFill(cfg.cellBgColor, 1);
                thumb.drawRoundedRect(
                    cfg.cellBorderSize + (cfg.symbolWidth + cfg.cellBorderSize) * i,
                    cfg.cellBorderSize + (cfg.symbolHeight + cfg.cellBorderSize) * j,
                    cfg.symbolWidth,
                    cfg.symbolHeight,
                    radius
                );
                thumb.endFill();
            }
        }
        return thumb;
    };
    /**
     * @param thumb {Object} Phaser.Graphics object
     * @param cfg {Object} cfg for thumbs
     * @param line {Array} cfg for one win line ex.[0,1,0,1,0]
     * @return {Object}
     */
    var drawLineThumb = function(thumb, cfg, line) {
        var strokeSize = cfg.lineSize + cfg.lineStrokeSize * 2;
        if (cfg.lineStrokeSize && cfg.lineStrokeColor) {
            draw(thumb, line, cfg, cfg.lineStrokeSize * 2 + cfg.lineSize, cfg.lineStrokeColor);
        }
        draw(thumb, line, cfg, cfg.lineSize, cfg.lineColor);
        return thumb;
    };
    /**
     * @param thumb {Object} Phaser.Graphics object
     * @param segments {Array} cfg for one win line ex.[0,1,0,1,0]
     * @param cfg {Object} cfg for thumbs
     * @param lineSize {Number}
     * @param lineColor {hexNumber} #ffffff
     */
    var draw = function(thumb, segments, cfg, lineSize, lineColor) {
        var startX, startY, endX, endY;
        for (var i = 0; i < segments.length - 1; i++) {
            if (i === 0) {
                startX = cfg.symbolWidth * i + cfg.symbolWidth / 2 + cfg.cellBorderSize * (i + 1);
                startY = cfg.symbolHeight * (segments[i] - cfg.rowsIndexesNormalizeValue) + cfg.symbolHeight / 2 + cfg.cellBorderSize * (segments[i] + 1 - cfg.rowsIndexesNormalizeValue);
                endX = cfg.symbolWidth * (i + 1) + cfg.symbolWidth / 2 + cfg.cellBorderSize * (i + 2);
                endY = cfg.symbolHeight * (segments[i + 1] - cfg.rowsIndexesNormalizeValue) + cfg.symbolHeight / 2 + cfg.cellBorderSize * (segments[i + 1] + 1 - cfg.rowsIndexesNormalizeValue);
                _view.drawConnector(thumb, startX, startY, lineSize, lineColor, 1);
                _view.drawSegment(thumb, startX, startY, endX, endY, lineSize, lineColor, 1);
                _view.drawConnector(thumb, startX, startY, lineSize, lineColor, 1);
                startX = endX;
                startY = endY;
            } else {
                endX = cfg.symbolWidth * (i + 1) + cfg.symbolWidth / 2 + cfg.cellBorderSize * (i + 2);
                endY = cfg.symbolHeight * (segments[i + 1] - cfg.rowsIndexesNormalizeValue) + cfg.symbolHeight / 2 + cfg.cellBorderSize * (segments[i + 1] + 1 - cfg.rowsIndexesNormalizeValue);
                _view.drawSegment(thumb, startX, startY, endX, endY, lineSize, lineColor, 1);
                _view.drawConnector(thumb, startX, startY, lineSize, lineColor, 1);
                startX = endX;
                startY = endY;
            }
        }
        _view.drawConnector(thumb, startX, startY, lineSize, lineColor, 1);
    };
});


nge.Com.Winlines.View = Class.extend(function () {
    this._cfg;

    var _self = this,
        _smCfg,
        _winlines,
        _wlStorage, // = [],
        _wlNumbersStorage = [],
        _container,
        _numbersContainer,
        _selectedLinesCount = 0, //amount of selected lines;
        _symbolWidth,
        _symbolHeight,
        _query = [],
        //some slot machines contain different configurations for rows in winlines. Indexes for rows
        //started from 0 or -1.
        //Use _rowsIndexesNormalizeValue to make all rows indexes starts from 0
        _rowsIndexesNormalizeValue = false,
        _animatedLineIndex,
        _winlinesTween,
        _winlinesTweenUpdated = false,
        _lastLineHighlignt,
        _curAnimation,
        _animateAllDoneFlag = true;

    this.create = function () {
        _winlines = nge.localData.get('winlines');
        _wlStorage = [];
        _wlNumbersStorage = [];
        _self._cfg = this.getInstance('Cfg');
        _selectedLinesCount = nge.localData.get('lines.value') || 0;

        var cfg = this.getInstance('Cfg', 'slotMachine');
        _smCfg = cfg.get();

        this.buildWinLines();
        return true;
    };

    /**
     * Try to find out lines indexes normalize value. Needed for shifting lines
     * depends of lines start position. In some games lines starts from -1 or -2, another
     * starts form 0.
     * @return {Number}
     */
    this.normalizeRowsIndexes = function () {
        if (_self._cfg.rowsIndexesNormalizeValue !== false) {
            _rowsIndexesNormalizeValue = _self._cfg.rowsIndexesNormalizeValue;
        }
        if (_rowsIndexesNormalizeValue !== false)
            return _rowsIndexesNormalizeValue;
        if (!_winlines)
            return false;
        for (var i = 0; i < _winlines.length; i++) {
            for (var j = 0, segmentsCount = _winlines[i].length; j < segmentsCount; j++) {
                _rowsIndexesNormalizeValue = _rowsIndexesNormalizeValue > _winlines[i][j] ? _winlines[i][j] : _rowsIndexesNormalizeValue;
            }
        }
        return _rowsIndexesNormalizeValue;
    };

    this.buildWinLines = function () {
        if (_wlStorage && _wlStorage.length) {
            return false;
        }

        if (_self._cfg.buildWinLines && (!_winlines || !_winlines.length)) {
            console.error('lines is undefined ', _winlines);
            return false;
        }

        //default SM container or optional custom container
        var parentName = (_self._cfg.customParentName) ?
            _self._cfg.customParentName : _smCfg.parentName;

        _container = nge.findOne('^' + parentName);

        if (!_container)
            return false;

        if (_self._cfg.numbers) {
            _numbersContainer = nge.objects.create(new nge.Mlm.Objects.Folder({}), _container);
        }

        var cData = _container.mt.data;

        _symbolWidth = cData.width / _smCfg.mw;
        _symbolHeight = cData.height / _smCfg.mh;

        var container = _container,
            winline,
            shadowSize;

        var width = 1920;
        var height = 1080;
        var canvas = document.createElement('canvas');
        var context = canvas.getContext('2d');
        canvas.width = width;
        canvas.height = height;
        context.translate(_container.x, 0);

        if (_self._cfg.buildWinLines) {
            for (var n = 0; n < _winlines.length; n++) {
                context.clearRect(0, 0, canvas.width, canvas.height);
                var weight = 0;
                if (_self._cfg.shadow) {
                    shadowSize = _self._cfg.stroke ? _self._cfg.stroke.weight + _self._cfg.lineWeight : _self._cfg.lineWeight;
                    shadowSize++; //to make 1px shadow size;
                    weight = shadowSize + 4;
                    _drawLine(_winlines[n], n, context, shadowSize, '0x000000', 0.2);
                }

                if (_self._cfg.stroke) {
                    _drawLine(_winlines[n], n, context, _self._cfg.stroke.weight + _self._cfg.lineWeight, _self._cfg.stroke.colors[n], _self._cfg.stroke.alpha);
                    weight = weight || _self._cfg.stroke.weight + _self._cfg.lineWeight;
                }

                _drawLine(_winlines[n], n, context, _self._cfg.lineWeight, _self._cfg.lineColors[n]);
                weight = weight || _self._cfg.lineWeight;

                var graphics = _cutLine(_winlines[n], n, context, weight);

                winline = nge.objects.create(new nge.Mlm.Objects.Folder({name:'winline_'+n}));
                winline.visible = false;
                winline.add(graphics);
                _wlStorage.push(winline);

                //important! need to cache each line.
                if (_self._cfg.cacheLineObjectsAsBitmap)
                    graphics.cacheAsBitmap = true;

                container.add(winline);

                //checking winLines numbers
                if (_self._cfg.numbers) {
                    //
                    var number = _createLineNumber(n);
                    _numbersContainer.add(number);
                    _wlNumbersStorage.push(number);

                    //check if line selected
                    if (n < _selectedLinesCount) {
                        _highlightLineNumber(n);
                    }
                }

                if (nge.localData.get('winlines.updated')) {
                    //check if line selected
                    if (n < _selectedLinesCount) {
                        this.show(n);
                    }
                }
            }
        }
        nge.localData.set('winlines.items', _wlStorage);
        nge.localData.set('winlines.updated', false);
        nge.observer.fire('winlines.buildWinLines.finish');
    };

    var _cutLine = function(lineSegments, index, context, weight) {
        var graphics = nge.objects.create(new nge.Mlm.Objects.Folder({}));

        var globalOffset = _self._cfg.globalOffset,
            totalOffset,
            customCoords,
            elW = _symbolWidth,
            elH = _symbolHeight,
            tailSize = _self._cfg.tailSize || elW / 2,
            startX,
            startY,
            endX, endY;

        var _drawSegment = function (startX, startY, endX, endY, first) {
            var rectStartX = startX - (weight / 2);
            var rectStartY = (startY < endY ? startY : endY) - (weight / 2);
            var rectWidth = endX - startX + weight;
            var rectHeight = Math.abs(endY - startY) + weight;

            var imageData = context.getImageData(rectStartX + _container.x, rectStartY, rectWidth, rectHeight);
            var segmentCanvas = document.createElement('canvas');
            segmentCanvas.width = rectWidth;
            segmentCanvas.height = rectHeight;
            var tempCtx = segmentCanvas.getContext('2d');
            tempCtx.putImageData(imageData, 0, 0);
            let segmentSprite = new PIXI.Sprite(PIXI.Texture.fromCanvas(segmentCanvas));
            segmentSprite.x = rectStartX;
            segmentSprite.y = rectStartY;
            graphics.addChild(segmentSprite);
        };

        totalOffset = globalOffset + _self._cfg.lineOffsets[index];
        customCoords = _self._cfg.lineCustomCoords[index];

        //customCoords
        if (customCoords) {
            var first = true;
            for (var i = 0; i < customCoords.length; i++) {
                var endX = customCoords[i][0];
                var endY = customCoords[i][1];

                if (first) {
                    first = false;
                    startX = endX;
                    startY = endY;
                }

                _drawSegment(startX, startY, endX, endY);
                startX = endX;
                startY = endY;
            }
            return graphics;
        }

        //or regular logic
        for (var i = 0, segmentsCount = lineSegments.length; i < segmentsCount; i++) {

            if (i === 0) {
                startX = elW / 2 - tailSize;
                startY = lineSegments[0] * elH + elH / 2 + totalOffset;
                endX = (elW / 2);
                endY = startY;
                _drawSegment(startX, startY, endX, endY, true);
            } else {
                endX = (i * elW + elW / 2);
                endY = (lineSegments[i] * elH + elH / 2 + totalOffset);
                _drawSegment(startX, startY, endX, endY);
            }
            startX = endX;
            startY = endY;
        }
        _drawSegment(startX, startY, endX + tailSize, endY);
        return graphics;
    };

    this.show = function (lineIndex) {
        if (!_wlStorage[lineIndex])
            return false;

        var spinning = nge.localData.get('slotMachineSpinning');
        if (spinning)
            return false;

        _wlStorage[lineIndex].visible = true;
        _container.bringToTop(_wlStorage[lineIndex]);
    };

    this.hide = function (lineIndex) {

        if (!_wlStorage[lineIndex])
            return false;

        _wlStorage[lineIndex].visible = false;

        return true;
    };

    this.hideAll = function () {
        nge.observer.fire('winlines.view.startHideAll');
        nge.localData.set('winlines.updated', false);

        if (!_animateAllDoneFlag)
            _animationAllCallback();

        for (var i = 0; i < _wlStorage.length; i++)
            this.hide(i);

        return true;
    };

    this.highlightLines = function (selectedLinesCount) {
        var duration = _self._cfg.linesHighligntDuration;
        if (duration === 0)
            return false;

        _lastLineHighlignt = nge.Lib.Time.get();

        for (var n = 0; n < selectedLinesCount; n++)
            if (n < selectedLinesCount)
                this.show(n);

        if (duration !== -1)
            nge.rafSetTimeout(_linesHideCheck, duration);
    };

    this.highlightNumbers = function (linesCount) {
        //ex. linesCount=3. need to highlight lines with indexes: 0,1,2.
        for (var i = 0; i < linesCount; i++)
            _highlightLineNumber(i);
    };

    /**
     * get animation Query
     * @returns {Array}
     */
    this.getAnimationQuery = function () {
        return _query;
    };

    /**
     * save query of winned lines
     * @param data {Object}
     */
    this.setNewQuery = function (data) {
        _query = [];

        if (data && data.slotWin && data.slotWin.lineWinAmounts)
            for (var i = 0; i < data.slotWin.lineWinAmounts.length; i++)
                _query.push(data.slotWin.lineWinAmounts[i]);

        if (data && data.slotWin && data.slotWin.jackpotWin)
            _query.push(data.slotWin.jackpotWin);

        return true;
    };

    this.animateAll = function () {
        if (_self._cfg.animationAllDelay > 0)
            nge.rafSetTimeout(_animateAll, _self._cfg.animationAllDelay);
        else
            _animateAll();

        return true;
    };

    this.resetAnimationIndex = function () {
        _animatedLineIndex = 0;
    };

    this.animateByOne = function () {
        if (!_query[_animatedLineIndex])
            return false;

        var spinning = nge.localData.get('slotMachineSpinning');

        if (spinning)
            return false;

        nge.observer.fire('winlines.lineHighlite.start', _query[_animatedLineIndex]);

        var self = this;
        nge.rafClearTimeout(_winlinesTween);

        //no need to show oneByOne animation in auto/free spin mode
        var autospinProgress = nge.localData.get('autospin.inProgress');
        var freespinProgress = nge.localData.get('freespin.inProgress');

        if (_self._cfg.fastAutoMode && (autospinProgress || freespinProgress))
            return false;

        this.hideAll();

        if (_query[_animatedLineIndex].selectedLine !== undefined && _self._cfg.showLinesOnWin)
            this.show(_query[_animatedLineIndex].selectedLine);

        nge.observer.fire('winlines.lineHighlite.start.previousHided', _query[_animatedLineIndex]);

        _self._animateSymbols(_query[_animatedLineIndex].wonSymbols);

        _winlinesTweenUpdated = false;
        _winlinesTween = nge.rafSetTimeout(_animationOneByOneCallback, _self._cfg.animationOneByOneDuration);
        _curAnimation = 'OneByOne';

        nge.observer.fire('winlines.lineHighlite.startComplete', _query[_animatedLineIndex]);
    };

    this.sendLineToBack = function (lineIndex) {
        _container.sendToBack(_wlStorage[lineIndex]);
    };

    this.setCurrentLineDuration = function (t, firstUpdate) {
        if (firstUpdate && _winlinesTweenUpdated)
            return false;

        if (_winlinesTween) {
            _winlinesTweenUpdated = true;

            nge.rafClearTimeout(_winlinesTween);

            var callback = (_curAnimation === 'All') ?
                _animationAllCallback : _animationOneByOneCallback;

            _winlinesTween = nge.rafSetTimeout(callback, t);
        }
    };

    this.stopLinesAnimation = function (clearQuery) {
        if (_winlinesTween)
            nge.rafClearTimeout(_winlinesTween);

        if (clearQuery)
            _query = [];

        _animateAllDoneFlag = true;
    };

    this.drawSegment = function (graphics, startX, startY, endX, endY, weight, color, alpha) {
        var alpha = alpha || 1;

        /*if(alpha<1){
         graphics.save();
         graphics.globalAlpha = alpha;
         }*/

        graphics.beginPath();
        graphics.moveTo(startX, startY);
        graphics.lineTo(endX, endY);
        graphics.lineWidth = weight;

        // set line color
        graphics.strokeStyle = '#' + nge.Lib.Helper.strReplace('0x', '', color);
        graphics.stroke();

        /*if(alpha<1)
         graphics.restore();*/
    };

    this.drawConnector = function (graphics, x, y, size, color, alpha) {
        var alpha = alpha || 1;

        if (alpha < 1) {
            graphics.save();
            graphics.globalAlpha = alpha;
        }

        graphics.beginPath();
        graphics.arc(x, y, size / 2, 0, 2 * Math.PI, false);
        graphics.fillStyle = color.replace('0x', '#');
        graphics.fill();

        if (alpha < 1)
            graphics.restore();
    };

    var _animateAllDone = function () {
        if (_animateAllDoneFlag)
            return false;

        _animateAllDoneFlag = true;
        nge.observer.fire('winlines.hideAll');
        nge.observer.fire('winlines.animateAllDone');
    };

    var _animationAllCallback = function () {
        if (_winlinesTween)
            nge.rafClearTimeout(_winlinesTween);

        _animateAllDone();
    };

    var _animationOneByOneCallback = function () {
        var delay = 0;
        _animatedLineIndex++;

        if (_animatedLineIndex >= _query.length) {
            _animatedLineIndex = 0;
            delay = 5;
            nge.observer.fire('winlines.animateByOne.cycleComplete');
        }

        if (delay > 0) {
            nge.rafSetTimeout(function () {
                _self.animateByOne();
            }, delay);
        } else
            _self.animateByOne();
    };

    var _animateAll = function () {
        if (!_query || _query.length === 0)
            return false;

        var spinning = nge.localData.get('slotMachineSpinning');
        if (spinning)
            return false;

        if (_winlinesTween)
            nge.rafClearTimeout(_winlinesTween);

        _animateAllDoneFlag = false;

        //animateAllSymbols flag
        if (_self._cfg.animateAllSymbols)
            for (var k in _query)
                _self._animateSymbols(_query[k].wonSymbols);

        if (_self._cfg.animationAllDuration === 0)
            _animateAllDone();

        _animatedLineIndex = 0;
        _winlinesTweenUpdated = false;
        _winlinesTween = nge.rafSetTimeout(_animationAllCallback, _self._cfg.animationAllDuration);
        _curAnimation = 'All';

        for (var i = 0; i < _query.length; i++) {
            var el = _query[i];

            if (el && el.selectedLine !== undefined)
                if (_self._cfg.animationAllDelayPerLine <= 0)
                    nge.observer.fire('winlines.show', el.selectedLine);
                else
                    (function (index) {
                        nge.rafSetTimeout(
                            function () {
                                if (!_animateAllDoneFlag)
                                    nge.observer.fire('winlines.show', index);
                            },
                            i * _self._cfg.animationAllDelayPerLine);
                    })(el.selectedLine);
        }

        return true;
    };

    var _linesHideCheck = function () {
        var time = nge.Lib.Time.get();
        var duration = _self._cfg.linesHighligntDuration;

        if (time >= _lastLineHighlignt + duration && !_winlinesTween)
            _self.hideAll();
    };

    var _drawLine = function (lineSegments, index, graphics, weight, color, alpha = 1) {

        var globalOffset = _self._cfg.globalOffset,
            totalOffset,
            customCoords,
            elW = _symbolWidth,
            elH = _symbolHeight,
            tailSize = _self._cfg.tailSize || elW / 2,
            startX,
            startY,
            endX, endY;

        var _drawSegment = function (startX, startY, endX, endY, first) {
            if (first)
                _self.drawConnector(graphics, startX, startY, weight, color, alpha);

            _self.drawSegment(graphics, startX, startY, endX, endY, weight, color, alpha);
            _self.drawConnector(graphics, endX, endY, weight, color, alpha);
        };

        totalOffset = globalOffset + _self._cfg.lineOffsets[index];
        customCoords = _self._cfg.lineCustomCoords[index];

        //customCoords
        if (customCoords) {
            var first = true;
            for (var i = 0; i < customCoords.length; i++) {
                var endX = customCoords[i][0];
                var endY = customCoords[i][1];

                if (first) {
                    first = false;
                    startX = endX;
                    startY = endY;
                }

                _drawSegment(startX, startY, endX, endY);
                startX = endX;
                startY = endY;
            }
            return;
        }

        //or regular logic
        for (var i = 0, segmentsCount = lineSegments.length; i < segmentsCount; i++) {

            if (i === 0) {
                startX = elW / 2 - tailSize;
                startY = lineSegments[0] * elH + elH / 2 + totalOffset;
                endX = (elW / 2);
                endY = startY;
                _drawSegment(startX, startY, endX, endY, true);
            } else {
                endX = (i * elW + elW / 2);
                endY = (lineSegments[i] * elH + elH / 2 + totalOffset);
                _drawSegment(startX, startY, endX, endY);
            }
            startX = endX;
            startY = endY;
        }
        _drawSegment(startX, startY, endX + tailSize, endY);
    };

    var _createLineNumber = function (lineIndex) {
        var style = _self._cfg.numbers || {};

        var globalOffset = _self._cfg.globalOffset,
            totalOffset = globalOffset + _self._cfg.lineOffsets[lineIndex],
            tailSize = _self._cfg.tailSize || _symbolWidth / 2,
            x,
            y,
            //check if Y has custom value
            customY = _self._cfg.numbersCustomY && _self._cfg.numbersCustomY[lineIndex] !== undefined ?
            _self._cfg.numbersCustomY[lineIndex] : false,
            text,
            align = _self._cfg.numbersPositions[lineIndex],
            lineSegmentsCount = _winlines[lineIndex].length - 1,
            decoration;

        var number = nge.objects.create(new nge.Mlm.Objects.Folder({}));

        if (align === 'left' || align === 'both') {
            x = _symbolWidth / 2 - tailSize - _self._cfg.offsetFromLine;
            y = customY === false ? _winlines[lineIndex][0] * _symbolHeight + _symbolHeight / 2 + totalOffset : customY;
            if (_self._cfg.numbersCustomDecoration) {
                decoration = new Phaser.Image(nge.game, x, y, new PIXI.Texture(PIXI.BaseTextureCache[_self._cfg.numbersCustomDecoration]));
                decoration.anchor.x = 0.5;
                decoration.anchor.y = 0.5;
                number.add(decoration);
            }
            text = nge.objects.create(new nge.Mlm.Objects.Text({
                x: x,
                y: y,
                text: lineIndex + 1,
                style: style,
                anchorX: 0.5,
                anchorY: 0.5
            }), number);
        }

        if (align === 'right' || align === 'both') {
            x = lineSegmentsCount * _symbolWidth + _symbolWidth / 2 + tailSize + _self._cfg.offsetFromLine;
            y = customY === false ? _winlines[lineIndex][lineSegmentsCount] * _symbolHeight + _symbolHeight / 2 + totalOffset : customY;
            if (_self._cfg.numbersCustomDecoration) {
                decoration = new Phaser.Image(nge.game, x, y, new PIXI.Texture(PIXI.BaseTextureCache[_self._cfg.numbersCustomDecoration]));
                decoration.anchor.x = 0.5;
                decoration.anchor.y = 0.5;
                number.add(decoration);
            }

            text = nge.objects.create(new nge.Mlm.Objects.Text({
                x: x,
                y: y,
                text: lineIndex + 1,
                style: style,
                anchorX: 0.5,
                anchorY: 0.5
            }), number);
        }

        return number;
    };

    var _highlightLineNumber = function (index) {
        if (!_wlNumbersStorage[index])
            return false;

        _wlNumbersStorage[index].forEach(function (item) {
            item.setStyle && item.setStyle(_self._cfg.numbersHighlighted);
        });
    };

    this._animateSymbols = function (symbols) {
        for (var i = 0; i < symbols.length; i++) {
            if (!symbols[i])
                continue;

            nge.observer.fire('slotMachine.animateSymbol', {
                reel: symbols[i][0],
                row: symbols[i][1]
            });
        }
    };
});



