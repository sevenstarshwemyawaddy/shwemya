nge.App[nge.appNS].Com.Offers.UI_v3.Offers_v3.Silver = {};



nge.App[nge.appNS].Com.Offers.UI_v3.Offers_v3.Silver.Controller = nge.App[nge.appNS].Com.Offers.UI_v3.Offers_v3.Controller.extend(function () {
