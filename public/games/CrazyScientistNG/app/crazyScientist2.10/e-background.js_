nge.Com.FreeGameSummaryPopup = {};



nge.Com.FreeGameSummaryPopup.Controller = nge.Com.Base.extend(function() {
    var _created;
    var _self;
    /**
     * create
     * @returns {Boolean}
     */
    this.create = function() {
        _self = this;
        this.createDefault();

        if (!_created) {
            _subscribe();
            _created = true;
        }
        return true;
    };

    var _show = function() {
        var totalWin = nge.localData.get('slotMachine.params.freeGameWin');

        var numberFreeGames = nge.find('^winUserCodeTextSumGame');
        numberFreeGames.text = nge.localData.get('freeGame.totalAmount');

        var money = nge.find('^winUserCodeTextSumMoney');

        money.text = nge.localData.get('currency') + nge.Lib.Validator.floatMoney(totalWin, true);

        var popup = nge.find('^freeGameSummaryPopup');
        popup.visible = true;

        nge.observer.fire('brain.disableButtons');
        nge.observer.fire('settingsButton.disable');
        nge.observer.fire('euroButton.disable');
        nge.observer.fire('paytableButton.disable');
    };

    var _close = function() {
        var popup = nge.find('^freeGameSummaryPopup');
        popup.destroy(true);
        nge.observer.fire('spinButton.enable');
    };

    var _subscribe = function() {
        nge.observer.add('freeGameSumPopup.show', _show);
        nge.observer.add('freeGameSumPopup.close', _close);
    };
});



