        'lineSpacing': (param.hasOwnProperty('lineSpacing')) ? param.lineSpacing : 0, //do not working in v2
        'style': {
            'lineHeight': nge.Lib.Helper.recursiveGet('style.lineHeight', param, 0), //lineSpacing analog in v2
            'fontFamily': nge.Lib.Helper.recursiveGet('style.fontFamily', param, 'Arial'),
            'fontSize': nge.Lib.Helper.recursiveGet('style.fontSize', param, false),
            'fill': nge.Lib.Helper.recursiveGet('style.fill', param, '#000000'),
            'align': nge.Lib.Helper.recursiveGet('style.align', param, 'left'),
            'lineJoin': nge.Lib.Helper.recursiveGet('style.lineJoin', param, 'miter'),
            'stroke': nge.Lib.Helper.recursiveGet('style.stroke', param, 'black'),
