nge.App[nge.appNS].Tpl.Groups.Mobile.Blue.Lang_ar = {};



nge.App[nge.appNS].Tpl.Groups.Mobile.Blue.Lang_ar.Ui = function () {
    var _tpl = nge.App[nge.appNS].Tpl.Groups.Mobile.Blue.Ui();

    var _recursiveTplObjFind = function (obj, field, value) {
        for (var i = 0; i < obj.contents.length; i++) {
            var childObj = obj.contents[i];
            if (childObj[field] === value)
                return childObj;
            else if (childObj.contents) {
                var recursiveResult = _recursiveTplObjFind(childObj, field, value);
                if (recursiveResult)
                    return recursiveResult;
            }
        }

        return false;
    };

    var _moveTplObjByY = function (name, value) {
        var objModel = _recursiveTplObjFind(_tpl.objects, 'name', name);
        if (objModel)
            objModel.y = +objModel.y + +value;
    };

    [
        'balanceMobileName',
        'winMobileName',
        'totalBetMobileName'
    ].forEach(function (name) {
        _moveTplObjByY(name, -15);
    });

    return _tpl;
};



