nge.Com.SpinControlContainer = {};



nge.Com.SpinControlContainer.Animator = Class.extend(function () {

    this.firstCreation = function (callback) {
        _firstCreation(callback);
        return true;
    };

    var _firstCreation = function (callback) {
        var container = nge.find('^spinControlContainer');
        if (!container) {
            return false;
        }

        var x = container.x + 500;

        var reelTween = nge.tween.add(container);
        reelTween.from({
            x: x
        }, 500, nge.Lib.Tween.Easing.Back.Out, false, 1200).onComplete.add(function () {
            if (callback)
                callback();
        });
        reelTween.start();
    };
});



