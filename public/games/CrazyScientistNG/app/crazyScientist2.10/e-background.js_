nge.App[nge.appNS].Tpl.States.LoadAssets = function (imagesPath) {
    if(!imagesPath)
        imagesPath = nge.appPath + 'img/';

    var tpl = {
        assets: {
            name: 'assets',
            contents: []
        },
        objects: {
            name: 'objects',
            contents: []
        }
    };

    return tpl;
};



