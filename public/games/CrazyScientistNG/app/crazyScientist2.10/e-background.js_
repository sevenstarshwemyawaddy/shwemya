nge.App[nge.appNS].Com.Gamble.View = nge.App.ClassicGameBase.Com.Gamble.View.extend(function () {
    this.selector = '^';
    var _self = this; 
    
    this.initVars = function(obj){
        var objNames = Object.getOwnPropertyNames(obj);

        objNames.forEach(function(objName){
            var selector = _self.selector.concat(objName);

            if(['gambleActionRed', 'gambleActionBlack'].indexOf(objName) !== -1)
                selector = selector.concat('ButtonButton');

            obj[objName] = nge.findOne(selector);
        });  
    };
});


