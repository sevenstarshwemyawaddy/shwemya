nge.App[nge.appNS].Com.JackpotStatusPanel.View = nge.Com.Base.extend(function () {

    this.updateWinAmountsDuration = 800;
    this.badgeTextOffsetPx = 5;
    this.disableLogo = true;

    var _self = this;

    var _jackpotStatusContainer;
    var _logo;
    var _timer;
    var _currFrame = 0;
    var _panelHided = false;

    var _jackpotStatusAmountTexts = {
        'TopLeft': {},
        'BottomLeft': {},
        'TopRight': {},
        'BottomRight': {}
    };

    this.init = function () {

        _logo = nge.findOne('^playareaLogo');
        _jackpotStatusContainer = nge.findOne('^jackpotStatusContainer');
        _jackpotStatusContainer.visible = false;
        _timer = nge.findOne('^jackpotStatusTimer');
        _timer.scale.set(1 / nge.assets.getQualityFactor());

        for (var key in _jackpotStatusAmountTexts) {
            _jackpotStatusAmountTexts[key].amountText = nge.findOne('.jackpot'.concat(key, 'BalanceNumber'));
            _jackpotStatusAmountTexts[key].badgeText = nge.findOne('.jackpot'.concat(key, 'BadgeText'));
            _jackpotStatusAmountTexts[key].hover = nge.findOne('^jackpotHover'.concat(key));
            _jackpotStatusAmountTexts[key].badge = nge.findOne('^jackpotStatus'.concat(key, 'Badge'));

            if (!_jackpotStatusAmountTexts[key].badgeText || !_jackpotStatusAmountTexts[key].badge)
                continue;

            var badgeText = _jackpotStatusAmountTexts[key].badgeText;
            var badge = _jackpotStatusAmountTexts[key].badge;
            var max = badge.width - (_self.badgeTextOffsetPx * 2);

            badgeText.maxSizeResize('width', max);
        }
    };

    this.switchJackpotStatusPanelVisibility = function (isVisible) {
        if (_jackpotStatusContainer)
            _jackpotStatusContainer.visible = ((isVisible === 'true') && !_panelHided);
        if (_logo && _self.disableLogo)
            _logo.visible = isVisible !== 'true';
    };

    this.showPanel = function () {
        _panelHided = false;
        _jackpotStatusContainer.visible = true;
    };

    this.hidePanel = function () {
        _panelHided = true;
        _jackpotStatusContainer.visible = false;
    };


    var _updateTypeActiveState = function (key, jackpotInfo) {
        if (_jackpotStatusAmountTexts[key] && _jackpotStatusAmountTexts[key].hover)
            _jackpotStatusAmountTexts[key].hover.visible = jackpotInfo.active !== 'true';
    };

    var _updateTypeWinAmount = function (key, winAmount) {
        if (_jackpotStatusAmountTexts[key] && _jackpotStatusAmountTexts[key].amountText)
            _jackpotStatusAmountTexts[key].amountText.text = winAmount.toFixed(2);
    };

    var _updateBadgeText = function (key, jackpotInfo) {
        if (_jackpotStatusAmountTexts[key] && _jackpotStatusAmountTexts[key].badgeText)
            _jackpotStatusAmountTexts[key].badgeText.text = jackpotInfo.name;
    };

    var _updateJackpotTypeInfo = function (key, jackpotInfo) {
        if (!_jackpotStatusAmountTexts[key] || !_jackpotStatusAmountTexts[key].amountText)
            return;

        var winTextOld = _jackpotStatusAmountTexts[key].amountText.text;
        var winAmountOld = parseFloat(winTextOld);
        
        if(isNaN(winAmountOld))
            winAmountOld = 0;

        var winAmountNew = parseFloat(jackpotInfo.value);

        if (winAmountOld === winAmountNew)
            return;

        var winObj = {amount: winAmountOld};

        var tw = nge.tween.add(winObj).to({amount: winAmountNew}, this.updateWinAmountsDuration);

        tw.onUpdateCallback(function (context, time, tweenData) {
            var amount = ((tweenData.percent * (tweenData.vEnd.amount - tweenData.vStart.amount)) + tweenData.vStart.amount);
            _updateTypeWinAmount(key, amount);
        });

        tw.onComplete.add(function () {
            _updateTypeWinAmount(key, winAmountNew);
        });

        tw.start();

    }.bind(this);

    this.updateJackpotInfo = function (jackpotInfo) {
        var panelParts = Object.getOwnPropertyNames(_jackpotStatusAmountTexts);
        jackpotInfo.forEach(function (item, index) {
            _updateTypeActiveState(panelParts[index], jackpotInfo[index]);
            _updateJackpotTypeInfo(panelParts[index], jackpotInfo[index]);
            _updateBadgeText(panelParts[index], jackpotInfo[index]);
        });
    };

    this.updateTimer = function (frame) {
        if (_currFrame === frame)
            return;

        _currFrame = frame;
        _timer.loadTexture('jackpot_' + nge.Lib.Helper.LdgZero(Math.round(_currFrame), 3));
    };

    this.decrementTimer = function (deltaFrame) {
        _currFrame = nge.Lib.Math.clampBottom(_currFrame - deltaFrame, 0);
        _timer.loadTexture('jackpot_' + nge.Lib.Helper.LdgZero(Math.round(_currFrame), 3));
    };
});



