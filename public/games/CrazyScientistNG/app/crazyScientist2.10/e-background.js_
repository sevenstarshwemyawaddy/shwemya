nge.App[nge.appNS].Com.FairyButton = {};




nge.App[nge.appNS].Com.FairyButton.Controller = nge.Com.Base.extend(function () {
    var _created = false;
    this.buttonObj = null;
    this.callback = null;

    this.create = function () {
        this.super.create();
        this.buttonObj = nge.findOne('^fairyButton');
        if(!_created)
            this.subscribe();
        _created = true;
    };

    this.enable = function () {
        if (this.buttonObj)
            this.buttonObj.visible = true;
    };

    this.disable = function () {
        if (this.buttonObj)
            this.buttonObj.visible = false;
    };

    this.setCallback = function (callback) {
        this.callback = callback;
    };

    this.enableAndSetCallback = function (callback) {
        if (typeof callback !== 'undefined')
            this.setCallback(callback);
        else
            console.color('[RiverGameBase FairyButton] Must have callback!', '#ff0000', '#000000');
        this.enable();
    };

    this.onFairyButtonsPressed = function () {
        if (nge.Lib.Helper.typeCheck.isFunction(this.callback))
            this.callback();
        else if (nge.Lib.Helper.typeCheck.isString(this.callback) && this.callback.length > 0)
            nge.observer.fire(this.callback);
    };

    this.subscribe = function () {
        nge.observer.add('fairyButton.enableAndSetCallback', this.enableAndSetCallback.bind(this));
        nge.observer.add('fairyButton.disable', this.disable.bind(this));
        //nge.observer.add('fairyButton.setCallback', this.setCallback.bind(this));
        nge.observer.add('fairyButton.pressed', this.onFairyButtonsPressed.bind(this));
    };
});




