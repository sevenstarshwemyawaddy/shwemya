nge.Com.Paytable.Controller = nge.Com.Base.extend(function () {

    var _defaultColor = "#ff0000";
    var _linesContainer;

    var _tpl;
    var _cfg;
    var _created;

    this.preload = function () {
        var Cfg = this.getInstance('Cfg');
        _cfg = Cfg.get();
        _tpl = Cfg.tpl;
        this.preloadDefault(_tpl);
    };

    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        this.createDefault(_tpl);
        if (!_created) {
            _subscribe();
        }

        if (!_created)
            _created = true;

        this.customCreate();  // todo think to save results first time

        return true;
    };

    this.customCreate = function () {
        var paytableGroup = nge.tpl.group('paytable');
        if (paytableGroup)
            return false;

        var payout = nge.localData.get('payout.cfg');
        var convertedPayout = {};
        var totalPayouts = 0;
        var payoutArrLen = payout.length;

        outer:
            for (var i = 0; i < payoutArrLen; i++) {
            var symbols = payout[i].symbols;
            var coins = payout[i].payout;
            var matchCount = payout[i].matchCount;
            var symbolQty = 0;
            var payoutName = symbols[0];

            // Check if symbol should be removed from paytable
            if (_cfg.hasOwnProperty('paytableWasteSymbols')) {
                var waste = _cfg.paytableWasteSymbols;
                for (var w in waste) {
                    if (payoutName === waste[w]) {
                        continue outer;
                    }
                }
            }

            if (coins === 0) {
                continue;
            }

            if (matchCount > 0) { // then we get "any symbol" payout
                payoutName = "any_" + symbols.join("_");
                symbolQty = matchCount;
            } else {
                var symbolsArrLen = symbols.length;
                for (var j = 0; j < symbolsArrLen; j++) {
                    if (payoutName !== symbols[j]) {
                        continue outer;
                    }
                    symbolQty++;
                }
            }

            if (!convertedPayout[payoutName]) {
                totalPayouts++;
                convertedPayout[payoutName] = {};
                convertedPayout[payoutName].awards = [];
            }
            convertedPayout[payoutName].awards.push({name: symbolQty, value: coins});
        }

        var iCon = nge.findOne('^paytableItemsContainer');

        if (_cfg.hasOwnProperty('x'))
            iCon.x = _cfg.x;
        if (_cfg.hasOwnProperty('y'))
            iCon.y = _cfg.y;

        var horizontal = _cfg.horizontal;
        var itemLogoWidth = _cfg.itemLogoWidth;
        var itemLogoHeight = _cfg.itemLogoHeight;
        var mw = _cfg.mw;
        var gapX = _cfg.gapX;
        var gapY = _cfg.gapY;

        var itemOffsetX = 0;
        var itemOffsetY = 0;
        var itemsX = 1;

        var itemsInLastLine = totalPayouts % mw,
            totalWidth = mw * gapX,
            lastLineOffsetX = (totalWidth - itemsInLastLine * gapX) / 2;

        for (var p in convertedPayout) {
            var awards = convertedPayout[p].awards;
            var paytableItem = nge.objects.create('paytableItemContainer', iCon);
            paytableItem.visible = true;
            paytableItem.id = p + "_itemContainer";
            paytableItem.name = p + "_itemContainer";
            paytableItem.x = itemOffsetX;
            paytableItem.y = itemOffsetY;
            if (itemsX > totalPayouts - itemsInLastLine) {
                paytableItem.x += lastLineOffsetX;
            }
            var img = paytableItem.create(0, 0, p);
            img.id = p + "_logo";
            img.name = p + "_logo";
            img.width = itemLogoWidth;
            img.height = itemLogoHeight;

            var awardOffsetY = 0;
            awards.forEach(function (a) {
                var paytableItemText = nge.objects.create('paytableItemText', paytableItem);
                paytableItemText.x = (horizontal ? itemLogoWidth + 50 : 100);
                paytableItemText.y = (horizontal ? (itemLogoHeight / 5) * ((5 - awards.length) / 2) : (itemLogoHeight + 15));
                paytableItemText.visible = true;

                var awardName = nge.objects.create('paytableAwardName', paytableItemText);
                awardName.y = awardOffsetY;
                awardName.text = a.name;
                awardName.visible = true;
                var awardValue = nge.objects.create('paytableAwardValue', paytableItemText);
                awardValue.name = 'paytableAwardValue' + a + p;
                awardValue.y = awardOffsetY;
                awardValue.text = "- " + a.value;
                awardValue.visible = true;

                awardOffsetY += 50;
            });

            itemOffsetX = (((itemsX % mw) === 0) ? 0 : itemOffsetX + gapX);
            itemOffsetY += (((itemsX % mw) === 0) ? (itemLogoHeight + gapY + (horizontal ? 0 : 200)) : 0);
            itemsX++;
        }
    };

    var _showTab = function (cfg) {
        switch (cfg.tab) {
            case 'LinesTab':
                nge.observer.fire('winlines.thumbsRequest');
                break;
        }
    };
    var _createThumbs = function (thumbs) {
        _linesContainer = nge.find('#paytableLinesContainer');
        if (_cfg.hasOwnProperty('linesContainerX'))
            _linesContainer.x = _cfg.linesContainerX;
        if (_cfg.hasOwnProperty('linesContainerY'))
            _linesContainer.y = _cfg.linesContainerY;

        var perLine = 3,
            marginRight = 130,
            marginTop = 100,
            marginBottom = 150;

        var total = 0;
        var shiftX = 0;
        for (var i = 0; i < thumbs.length; i++) {
            thumbs[i].x = (i % perLine) * (thumbs[i].width + marginRight) + marginRight;
            thumbs[i].y = ~~(i / perLine) * (thumbs[i].height + marginBottom) + marginTop;
            thumbs[i].visible = true;
            var lineText = nge.objects.create('paytableLinesText');
            lineText.x = thumbs[i].x + (thumbs[i].width / 2);
            lineText.y = thumbs[i].y - 30;
            lineText.text = "LINE " + (i + 1);
            lineText.alpha = 1;
            lineText.name = "paytableLinesText_" + (i + 1);

            if (thumbs.length >= perLine && ~~(i / perLine) === ~~(thumbs.length / perLine)) {
                //if last line
                if (!total) {
                    total = thumbs.length % perLine;
                    shiftX = (_linesContainer.width - marginRight - (thumbs[i].width + marginRight) * total) / 2;
                }
                thumbs[i].x += shiftX;
                lineText.x += shiftX;
            }

            _linesContainer.addChild(lineText);
            _linesContainer.addChild(thumbs[i]);
        }
    };

    var _subscribe = function () {
        nge.observer.add('tabs.paytablePopupObject.switch', _showTab);
        nge.observer.add('winlines.thumbsResponse', _createThumbs);
    };
});



