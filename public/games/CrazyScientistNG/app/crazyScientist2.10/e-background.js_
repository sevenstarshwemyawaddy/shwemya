nge.App[nge.appNS].Com.InsufficientFundsPopup = {};




nge.App[nge.appNS].Com.InsufficientFundsPopup.Controller = nge.Com.Base.extend(function () {
    var _self = this;
    var _created = false;
    var _cache = {};
    var _popupButtonEnabled = false;
    this.create = function () {
        if (!_created)
            this.subscribe();
        _created = true;
        _popupButtonEnabled = false;
        _cache = {};
        _cache.popup = nge.findOne('^insufficientFundsPopupContent');
        _cache.shadow = nge.findOne('^insufficientFundsPopupShadow');

        if (!_cache.popup || !_cache.shadow) {
            console.error('No InsufficientFundsPopup objects found.');
        } else {
            _cache.popup.visible = false;
            _cache.shadow.visible = false;
        }
    };

    this.onNoBalance = function () {
        if (!_cache.popup || !_cache.shadow) {
            console.error('No InsufficientFundsPopup objects found.');
            return;
        }

        _popupButtonEnabled = false;
        _cache.popup.visible = true;
        _cache.shadow.visible = true;

        _cache.popup.scale.set(0.4);
        _cache.popup.alpha = 0;
        _cache.shadow.alpha = 0;

        var popupScaleTween = nge.tween.add(_cache.popup.scale);
        popupScaleTween.to({x: 1, y: 1}, 500, nge.Lib.Tween.Easing.Back.Out);
        popupScaleTween.start();

        var popupAlphaTween = nge.tween.add(_cache.popup);
        popupAlphaTween.to({alpha: 1}, 500);
        popupAlphaTween.start();

        var shadowAlphaTween = nge.tween.add(_cache.shadow);
        shadowAlphaTween.to({alpha: 1}, 500);
        shadowAlphaTween.start();

        nge.rafSetTimeout(function () {
            _popupButtonEnabled = true;
        }, 520);
    };

    this.onInsufficientFundsPopupOkClick = function () {
        if (!_popupButtonEnabled)
            return;

        _popupButtonEnabled = false;

        _cache.popup.scale.set(1);
        _cache.popup.alpha = 1;
        _cache.shadow.alpha = 1;

        var popupScaleTween = nge.tween.add(_cache.popup.scale);
        popupScaleTween.to({x: 0.4, y: 0.4}, 500, nge.Lib.Tween.Easing.Back.In);
        popupScaleTween.onComplete.add(function () {
            _cache.popup.visible = false;
        });
        popupScaleTween.start();

        var popupAlphaTween = nge.tween.add(_cache.popup);
        popupAlphaTween.to({alpha: 1}, 500);
        popupAlphaTween.start();

        var shadowAlphaTween = nge.tween.add(_cache.shadow);
        shadowAlphaTween.to({alpha: 1}, 300);
        shadowAlphaTween.to({alpha: 0}, 500);
        shadowAlphaTween.start();

        nge.rafSetTimeout(function () {
            _cache.shadow.visible = false;
        }, 820);
    };

    this.subscribe = function () {
        nge.observer.add('slotMachine.spinFailed.noBalance', _self.onNoBalance);
        nge.observer.add('insufficientFundsPopupOkClick', _self.onInsufficientFundsPopupOkClick);
    };
});



nge.App[nge.appNS].Com.Offers = {};



nge.App[nge.appNS].Com.Offers.UI_v3 = {};



nge.App[nge.appNS].Com.Offers.ControllerExtension = function () {
    this.titleTextFill = '#f0e1bf';
    this.titleValuesFill = '#fec36d';
    this.valuesFill = '#f0e1bf';
    this.defaultFill = '#fff';
    this.currencyColor = '#EFC273';

    const _finishOfferResponseHandler = this.super._finishOfferResponseHandler;
    const _balanceResponseHandler = this.super._balanceResponseHandler;

    let _finishResponseData = null;

    this._finishOfferResponseHandler = data => {
        _finishResponseData = data;

        if(nge.localData.get('offers.waitingForFinish')){
            nge.localData.set('offers.waitingForFinish', false);
            this.tryFinishOfferHandler();

        }
    };

    this._balanceResponseHandler = () => {};

    this.create = function () {
        _finishResponseData = null;
        this.super.create();
    };

    this._btnRestore = time => {};

    this.tryFinishOfferHandler = () => {
        if(!_finishResponseData)
            return;

        _balanceResponseHandler();
        _finishOfferResponseHandler(_finishResponseData);
        this._finishOffer();
        
        _finishResponseData = null;
    };

    this.subscribe = () => {
        this.super.subscribe();
        nge.observer.add('offers.tryFinish', this.tryFinishOfferHandler);
        nge.observer.add('offers.tryStart', _balanceResponseHandler);
    };

};



nge.App[nge.appNS].Com.Offers.UI_v3.Controller = nge.App.ClassicGameBase.Com.Offers.UI_v3.Offers_v3.Controller.extend(nge.App[nge.appNS].Com.Offers.ControllerExtension);



nge.App[nge.appNS].Com.SlotMachine = {};



nge.App[nge.appNS].Com.SlotMachine.Controller = nge.Com.SlotMachine.Controller.extend(function () {
    var _view;

    this.tryStop = function() {
        var slotMachineIntrigue = nge.localData.get('slotMachineIntrigue');
        if (slotMachineIntrigue.status)
            _view.tryStop();
        else
            nge.observer.fire('slotMachine.stopCommand');
    };

    this.customSubscribe = () => {
        nge.observer.add('slotMachine.tryStop', this.tryStop);
    };

    this.create = function () {
        this.super.create();
        _view = this._service._view;
    };
});



nge.App[nge.appNS].Com.SlotMachine.RecyclerView = nge.App.ClassicGameBase.Com.SlotMachine.RecyclerView.extend(function () {
    this.tryStop = () => {
        var slotMachineIntrigue = nge.localData.get('slotMachineIntrigue');
        var startsFrom = slotMachineIntrigue.startsFrom;

        for (var i = 0; i < this._cfg.mw; i++) {
            if (i < startsFrom) {
                this.speedUpReel(i);
            }
        }
    };
});



nge.App[nge.appNS].Com.SlotMachine.View = nge.App.ClassicGameBase.Com.SlotMachine.View.extend(function () {
    this.tryStop = () => {
        var slotMachineIntrigue = nge.localData.get('slotMachineIntrigue');
        var startsFrom = slotMachineIntrigue.startsFrom;
        var endsFrom = slotMachineIntrigue.endsFrom;
        var blursSpeed = [];
        for (var i = 0; i < this._cfg.mw; i++) {
            if (i < startsFrom) {
                blursSpeed[i] = this._cfg.speedUpReelsFactor;
            } else if (i >= startsFrom && i < endsFrom) {
                blursSpeed[i] = this._cfg.intrigueSpeedReelsFactor;
            } else {
                blursSpeed[i] = 1;
            }
        }
        nge.observer.fire('slotMachine.changeBlursSpeed', blursSpeed);
    };
});




nge.App[nge.appNS].Com.Help = {};




nge.App[nge.appNS].Com.Help.Controller = nge.App.ClassicGameBase.Com.Help.Controller.extend(function () {
    this.create = function () {
        this.super.create();
        var rtpValue = nge.localData.get('rtp');
        var rtpInfos = nge.findAll('.rtpInfo');

        if (rtpInfos && rtpInfos.length > 0) {
            rtpInfos.forEach(function (textObj) {
                if (typeof rtpValue !== 'undefined' && +rtpValue > 0)
                    textObj.text = nge.Lib.Helper.strReplace('%rtpValue%', rtpValue + '%', textObj.text);
                else
                    textObj.visible = false;
            });
        }
    };
});



