        sprite.scale.y = scaleFactor * -attachment.scaleY * attachment.height / region.originalHeight;
    }
    else {
        sprite.scale.x = scaleFactor * region.size.width / region.originalWidth;
        sprite.scale.y = scaleFactor * -region.size.height / region.originalHeight;
    }
};

PIXI.spine.core.TextureAtlas.prototype.defaultLoad = PIXI.spine.core.TextureAtlas.prototype.load;

PIXI.spine.core.TextureAtlas.prototype.packedlLoad = function (atlasText) {
    var _this = this;
    var reader = new PIXI.spine.core.TextureAtlasReader(atlasText);
    var tuple = new Array(4);
    var page = null;
    var iterateParser = function () {
        while (true) {
            var line = reader.readLine();
            if (line == null) {
                return;
            }
            line = line.trim();
            if (line.length == 0)
                page = null;
            else if (!page) {
                page = new PIXI.spine.core.TextureAtlasPage();
                page.name = line;
                if (reader.readTuple(tuple) == 2) {
                    page.width = parseInt(tuple[0]);
                    page.height = parseInt(tuple[1]);
                    reader.readTuple(tuple);
                }
                reader.readTuple(tuple);
                page.minFilter = PIXI.spine.core.Texture.filterFromString(tuple[0]);
                page.magFilter = PIXI.spine.core.Texture.filterFromString(tuple[1]);
                var direction = reader.readValue();
                page.uWrap = PIXI.spine.core.TextureWrap.ClampToEdge;
                page.vWrap = PIXI.spine.core.TextureWrap.ClampToEdge;
                if (direction == "x")
                    page.uWrap = PIXI.spine.core.TextureWrap.Repeat;
                else if (direction == "y")
                    page.vWrap = PIXI.spine.core.TextureWrap.Repeat;
                else if (direction == "xy")
                    page.uWrap = page.vWrap = PIXI.spine.core.TextureWrap.Repeat;
                /*textureLoader(line, function (texture) {
                    page.baseTexture = texture;
                    if (!texture.hasLoaded) {
                        texture.width = page.width;
                        texture.height = page.height;
                    }
                    _this.pages.push(page);
                    page.setFilters();
                    if (!page.width || !page.height) {
                        page.width = texture.realWidth;
                        page.height = texture.realHeight;
                        if (!page.width || !page.height) {
                            console.log("ERROR spine atlas page " + page.name + ": meshes wont work if you dont specify size in atlas (http://www.html5gamedevs.com/topic/18888-pixi-spines-and-meshes/?p=107121)");
                        }
                    }
                    iterateParser();
                });*/
                iterateParser();
                _this.pages.push(page);
                break;
            }
            else {
                var region = new PIXI.spine.core.TextureAtlasRegion();
                region.name = line;
                region.page = page;
                var rotate = reader.readValue() == "true" ? 6 : 0;
                reader.readTuple(tuple);
                var x = parseInt(tuple[0]);
                var y = parseInt(tuple[1]);
                reader.readTuple(tuple);
                var width = parseInt(tuple[0]);
                var height = parseInt(tuple[1]);
                var resolution = 1;//page.baseTexture.resolution;
                x /= resolution;
                y /= resolution;
                width /= resolution;
                height /= resolution;
                //var frame = new PIXI.Rectangle(x, y, rotate ? height : width, rotate ? width : height);
                if (reader.readTuple(tuple) == 4) {
                    if (reader.readTuple(tuple) == 4) {
                        reader.readTuple(tuple);
                    }
                }
                //var originalWidth = parseInt(tuple[0]) / resolution;
                //var originalHeight = parseInt(tuple[1]) / resolution;
                reader.readTuple(tuple);
                //var offsetX = parseInt(tuple[0]) / resolution;
                //var offsetY = parseInt(tuple[1]) / resolution;
                //var orig = new PIXI.Rectangle(0, 0, originalWidth, originalHeight);
                //var trim = new PIXI.Rectangle(offsetX, originalHeight - height - offsetY, width, height);
                const atlas = nge.assets.getAtlasForTexture(region.name + '.png');
                const texture = atlas ? nge.wrap.cache.getAtlas(atlas).textures[region.name + '.png'] : nge.wrap.cache.getTexture('1px_empty');
                region.texture = texture;
                region.index = parseInt(reader.readValue());
                region.texture._updateUvs();
                _this.regions.push(region);
            }
        }
    };
    iterateParser();
};

PIXI.spine.core.TextureAtlas.prototype.load = function(atlasText, textureLoader, callback) {
    if(textureLoader)
        this.defaultLoad(atlasText, textureLoader, callback);
    else
        this.packedlLoad(atlasText);
};



window.mt = window.mt || {};



mt.Adaptive = class {
    constructor() {
        if (mt.Adaptive.instance)
            return mt.Adaptive.instance;
            
        mt.Adaptive.instance = this;
        this._propValidators = {
            x: this._validateHorizontal.bind(this),
            y: this._validateVertical.bind(this),
            sWidth: this._validateHorizontal.bind(this),
            sHeight: this._validateVertical.bind(this),
            rightOffset: this._validateHorizontal.bind(this),
            bottomOffset: this._validateVertical.bind(this)
        };

        this._propDependencies = {
            x: [this._calcX.bind(this)],
            y: [this._calcY.bind(this)],
            alignX: [this._calcX.bind(this)],
            alignY: [this._calcY.bind(this)],
            sWidth: [this._calcWidth.bind(this)],
            sHeight: [this._calcHeight.bind(this)],
            rightOffset: [this._calcWidth.bind(this)],
            bottomOffset: [this._calcHeight.bind(this)],
            sType: [this._calcSType.bind(this)],
            all: [this._recalcPosition.bind(this), this._calcWidth.bind(this), this._calcHeight.bind(this), this._calcSType.bind(this)]
        };
        this._subscribe();
    }

    _resolutionUpdated(template) {
        let stateName = nge.statesManager.getCurrentName() + 'State';
        let state = nge.findOne('^' + stateName);
        // TODO: обновляется весь мир потому что не все компоненты идут в state почему-то
        if(state)
            this.recalculateAll(nge.wrap.states.world.children);
    }

    _subscribe() {
        nge.observer.add('resolutionsManager.newResolution', data => {
            this._resolutionUpdated(data.template);
        }, false, true);
    }

    _toAbsolute(value, max) {
        if (_.isString(value)) {
            if (value.includes('%'))
                return Math.round(parseFloat(value.replace('%', '')) * 0.01 * max);
            // TODO: mm, inches, dpi 
        }
        return value;
    }

    _toAlignedPosition(value, max, align = 'left') {
        switch (align) {
            case 'left':
            case 'top':
                return value;
            case 'center':
                return Math.round(max / 2) + value;
            case 'right':
            case 'bottom':
                return max + value;
            default:
                console.warn('Unknown align: ' + align);
                return value;
        }
    }

    _recalcPosition(obj) {
        const data = obj.getData();
        if(!_.isNumber(data.x) || data.alignX !== 'left')
            this._calcX(obj);

        if(!_.isNumber(data.y) || data.alignY !== 'top')
            this._calcY(obj);
    }

    _calcX(obj) {
        let align = obj.getData().alignX;
        let x = obj.getData().x;
        let width = this._getParentWidth(obj);
        x = this._toAlignedPosition(x, width, align);
        nge.Lib.Helper.recursiveSet('x', x, obj);
    }

    _calcY(obj) {
        let align = obj.getData().alignY;
        let y = obj.getData().y;
        let height = this._getParentHeight(obj);
        y = this._toAlignedPosition(y, height, align);
        nge.Lib.Helper.recursiveSet('y', y, obj);
    }

    _calcWidth(obj) {
        const parentWidth = this._getParentWidth(obj);
        const sWidth = obj.getData().sWidth;
        const type = obj.getData().type;
        if(sWidth) {
            if(type !== mt.objects.GROUP) {
                obj.width = this._toAbsolute(sWidth, parentWidth);
            }
            return;
        }
        const rightOffset = obj.getData().rightOffset;
        if(rightOffset) {
            if(type !== mt.objects.GROUP) {
                obj.width = parentWidth - this._toAbsolute(rightOffset, parentWidth);
            }
            return;
        }
    }

    _calcHeight(obj) {
        const parentHeight = this._getParentHeight(obj);
        const sHeight = obj.getData().sHeight;
        const type = obj.getData().type;
        if(sHeight) {
            if(type !== mt.objects.GROUP) {
                obj.height = this._toAbsolute(sHeight, parentHeight);
            }
            return;
        }
        const bottomOffset = obj.getData().bottomOffset;
        if(bottomOffset) {
            if(type !== mt.objects.GROUP) {
                obj.height = parentHeight - this._toAbsolute(bottomOffset, parentHeight);
            }
            return;
        }
    }

    _calcSType(obj) {
        const data = obj.getData();
        if(data.sWidth !== '100%' || data.sHeight !== '100%')
            return;

        obj.scale.set(1, 1);
        const sType = data.sType;
        const width = obj.width;
        const height = obj.height;
        const parentWidth = this._getParentWidth(obj);
        const parentHeight = this._getParentHeight(obj);

        switch(sType) {
            case 'inscribed':
                if(height > parentHeight)
                    obj.height = parentHeight;
                if(width > parentWidth)
                    obj.width = parentWidth;
                const min = Math.min(obj.scale.x, obj.scale.y);
                obj.scale.set(min, min);
                break;
            case 'circumscribed':
                if(parentHeight > height)
                    obj.height = parentHeight;
                if(parentWidth > width)
                    obj.width = parentWidth;
                const max = Math.max(obj.scale.x, obj.scale.y);
                obj.scale.set(max, max);
                break;
            default:
                break;
        }
    }

    _validateHorizontal(obj, value) {
        const max = this._getParentWidth(obj);
        return this._toAbsolute(value, max);
    }

    _validateVertical(obj, value) {
        const max = this._getParentHeight(obj);
        return this._toAbsolute(value, max);
    }

    _getParentWidth(obj) {
        if(obj.parent) {
            if(obj.parent.getData && obj.parent.getData().sWidth)
                return obj.parent.getData().sWidth;
            return this._getParentWidth(obj.parent);
        }
        return nge.resolutionsManager.getTemplateSize().width;
    }

    _getParentHeight(obj) {
        if(obj.parent) {
            if(obj.parent.getData && obj.parent.getData().sHeight)
                return obj.parent.getData().sHeight;
            return this._getParentHeight(obj.parent);
        }
        return nge.resolutionsManager.getTemplateSize().height;
    }

    recursiveSet(k, v, obj) {
        let value = v;
        if (this._propValidators[k])
            value = this._propValidators[k](obj, v);

        nge.Lib.Helper.recursiveSet(k, value, obj);
        if (this._propDependencies[k]) {
            for (let dependency of this._propDependencies[k])
                dependency(obj);
        }
    }

    recalculateAll(children) {
        
        for(let child of children) {
            if(!child.mt)
                return;

            for (let dependency of this._propDependencies.all)
                dependency(child);

            if(child.children)
                this.recalculateAll(child.children);
        }
    }
};
mt.Adaptive.instance = null;



