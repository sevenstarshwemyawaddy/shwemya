nge.Com.Debug.Observer = Class.extend(function () {

    var _self = this;
    var _visible = false;
    var _elDomClass = 'debugObserverEditor';
    var _events = {};

    this.create = function () {
        _createDom();
        _transportMessagesAdd();
        nge.observer.debugFire = _debugFire;
        return true;
    };

    this.show = function (visible) {
        _visible = (typeof visible !== 'undefined') ? visible : !_visible;
        var el = $('.' + _elDomClass);
        (_visible) ? el.show() : el.hide();
    };

    var _createDom = function () {
        var created = nge.localData.get('debug.observer.created');

        if (!created) {
            _create();
            nge.localData.set('debug.observer.created', true);
            return true;
        } else {
            _self.show(false);
        }

        return false;
    };

    var _chkCookies = function () {
        var str = nge.Lib.Helper.getCookie('debug.observer');

        if (!str)
            return false;

        var events = JSON.parse(str);

        var evtsLen = nge.Lib.Helper.getObjSize(events);
        if (!evtsLen)
            return false;

        for (var k in events)
            _self.add(k, events[k]);

        return true;
    };

    var _create = function () {
        $.get('../../js/com/debug/tpl.html', function (html) {
            _createDomEl(html);

            $('.eventAdd').on('click', function (e) {
                var eventName = $('.eventName').val();
                var eventColor = $('.eventColor').val();
                _self.add(eventName, eventColor);
                return false;
            });

            _chkCookies();
        });
    };

    var _createDomEl = function (html) {
        var div = $('<div class="' + _elDomClass + '"></div>');
        $("body").append(div);
        div.html(html);
        div.hide();
    };

    this.add = function (name, color) {
        if (!name) {
            alert('no event name');
            return false;
        }

        if (_events[name]) {
            alert('event name exist');
            return false;
        }

        //dom
        var newEl = _listElementTpl;
        var className = _getClassName(name);
        newEl = nge.Lib.Helper.strReplace('{className}', className, newEl);
        newEl = nge.Lib.Helper.strReplace('{color}', color, newEl);
        newEl = nge.Lib.Helper.strReplace('{name}', name, newEl);
        $('.list-observers').append(newEl);
        $('.eventName').val('');

        _events[name] = color;
        _updateCookies();
        return true;
    };

    this.remove = function (eventName) {
        var className = _getClassName(eventName);
        $('.' + className).remove();
        _events[eventName] = null;
        delete _events[eventName];
        _updateCookies();
    };

    var _updateCookies = function () {
        var str = JSON.stringify(_events);
        nge.Lib.Helper.setCookie('debug.observer', str);
    };

    var _debugFire = function (eventName, params) {
        for (var name in _events) {
            if (name === eventName) {
                _logColor(eventName, _events[name], params);
                continue;
            }

            if (name.indexOf('*') !== -1) {
                var piece = nge.Lib.Helper.strReplace('*', '', name);
                var regexp = new RegExp(piece, 'ig');

                if (regexp.test(eventName))
                    _logColor(eventName, _events[name], params);
            }
        }
    };

    var _logColor = function (name, color, params) {
        var str = name;

        if (params) {
            str += ' | ' + JSON.stringify(params);
        }

        log('%c' + str, 'color: ' + color);
    };

    var _transportMessagesAdd = function () {
        var sendClbk = function (d) {
            var str = JSON.stringify(d);
            var s = '> sendSocket ' + nge.Lib.Time.HHMMSS() + ' ' + str;

            var evtsLen = nge.Lib.Helper.getObjSize(_events);
            var styles = (evtsLen) ? 'background: #222; color: #bada55' : false;

            log('%c' + s, styles);
        };

        var getClbk = function (d) {
            var evtsLen = nge.Lib.Helper.getObjSize(_events);
            var styles = (evtsLen) ? 'background: #222; color: #bada55' : false;

            var s = '< getSocket ' + nge.Lib.Time.HHMMSS() + ' ' + d;
            log('%c' + s, styles);
        };

        nge.observer.add('sendSocket', sendClbk, 'debug.sendSocket', true);
        nge.observer.add('getSocket', getClbk, 'debug.getSocket', true);
    };

    var _transportMessagesRemove = function () {
        nge.observer.remove('sendSocket', false, 'debug.sendSocket', true);
        nge.observer.remove('getSocket', false, 'debug.getSocket', true);
    };

    var _getClassName = function (name) {
        var className = 'observer_' + name;
        className = nge.Lib.Helper.strReplace('.', '', className);
        className = nge.Lib.Helper.strReplace('\'', '', className);
        className = nge.Lib.Helper.strReplace('"', '', className);
        className = nge.Lib.Helper.strReplace('*', '', className);

        return className;
    };

    this.subscribe = function () {
        nge.observer.add('keyboard.KeyDown', function (k) {
            if (k === 'O') {
                if (nge.keyboard.check('ALT'))
                    _self.show();
            }
        });

        nge.observer.add('debug.observer.remove', _self.remove);
    };

    var _listElementTpl = '<li class="{className}"><input type="button" onclick="nge.observer.fire(\'debug.observer.remove\',\'{name}\');" value="X"> <font style="color:{color};">{name}</font></li>';

});



nge.Com.Debug.Plugin = Class.extend(function () {

    var _self = this;
    var _visible = true;
    var _debugPannelsSelectors = ['.pdebug', '.dg'];

    this.create = function () {
        var created = nge.localData.get('debug.plugin.created');

        if(!Phaser || !Phaser.Plugin || !Phaser.Plugin.Debug || !Phaser.Plugin.GameGui)
            return;

        if (!created) {
            //debug
            nge.game.plugins.add(Phaser.Plugin.Debug);

            var gameGuiPlugin = nge.game.plugins.add(Phaser.Plugin.GameGui, {
                // Default options:
                autoPlace: true,
                width: 200
            });
            gameGuiPlugin.gui.closed = true;
            //gameGuiPlugin.gui.destroy(true);

            nge.localData.set('debug.plugin.created', true);
        }

        _self.show(false);
        return true;
    };

    this.show = function (visible) {
        _visible = (typeof visible !== 'undefined') ? visible : !_visible;
        var el = $(_debugPannelsSelectors.join(','));
        (_visible) ? el.show() : el.hide();
    };

    this.subscribe = function () {
        nge.observer.add('keyboard.KeyDown', function (k) {
            if (k === 'O') {
                if (nge.keyboard.check('ALT'))
                    _self.show();
            }
        });
    };
});



nge.Com.Debug.RenderStat = Class.extend(function () {
    var _display;

    this.create = function () {
        _display = nge.find('^debugRenderStat');
        return true;
    };

    this.update = function () {
        if (_display.visible) {
            var stat = {
                nSprite: 0,
                pxSprite: 0,
                nText: 0,
                pxText: 0,
                containers: 0,
                nMesh: 0,
                nVertices: 0
            };

            nge.wrap.states.world.children.forEach(function (o) {
                _fillRenderStat(o, stat);
            });

            _display.attr('text',
                'Sprite count = ' + stat.nSprite +
                '\nSprite pixels = ' + _toShortStr(stat.pxSprite) +
                '\ntext items = ' + stat.nText +
                '\ntext pixels = ' + _toShortStr(stat.pxText) +
                '\ncontainers = ' + _toShortStr(stat.containers)+
                '\nmeshes = ' + _toShortStr(stat.nMesh)+
                '\nvertices = ' + _toShortStr(stat.nVertices)+
                '\n ifs = ' + nge.game.scale.isFullScreen+
                '\n draw calls = ' + nge.drawCalls
                );
            nge.drawCalls = 0;
        }
    };

    // Сокращение вывода: добавление модификаторов K,M если значения больше 1000 или 1000000
    // Пример: 1523 -> 1523; 23666 -> 24K; 123567890 -> 123M
    // Реализовано только для положительных чисел
    var _toShortStr = function (a) {
        if (a < 10000)
            return Math.round(a);
        if (a < 10000000)
            return Math.round(a / 1000) + 'K';
        if (a < 10000000000)
            return Math.round(a / 1000000) + 'M';
    };

    /** Рекурсивный обход всех объектов
     struct stat 
     { 
     n: count of the object, size: pixel count; 
     nText: text object amount
     pxText: test size in pixels, total
     }
     */
    var _fillRenderStat = function (obj, stat) {
        // TODO: раньше здесь у всех obj проверялся параметр inCamera, которого нет в PIXI.
        // можно проверять пересечение boundingbox объектов с канвасом
        // Текст

        if(!obj.mt || !obj.mt.data)
            return;

        if (obj.mt.data.type === mt.objects.TEXT) {
            if (obj.visible) {
                stat.pxText += Math.abs(obj.width * obj.height);
                stat.nText++;
            }
            return;
        }

        // Битмап текст
        if (obj.mt.data.type === mt.objects.BITMAP_TEXT) {
            if (obj.visible) {
                stat.pxText += Math.abs(obj.width * obj.height);
                stat.nText++;
            }
            return;
        }

        // Спрайты
        if ((obj.mt.data.type === mt.objects.IMAGE && obj.mt.data.class !== '_slotMachineBlur') || obj.mt.data.type === mt.objects.GRAPHICS || obj.mt.data.type === mt.objects.ANIMATION) {
            if (obj.visible) {
                stat.pxSprite += Math.abs(obj.width * obj.height);
                stat.nSprite++;
                if(obj.vertexData)
                    stat.nVertices += (obj.vertexData.length / 2);
            }
            return;
        }

        // Маски
        if (obj.mt.data.type === mt.objects.MASK) {
            return;
        }

        // Кнопки
        if (obj.mt.data.type === mt.objects.BUTTON) {
            if (obj.visible) {
                stat.pxSprite += Math.abs(obj.width * obj.height);
                stat.nSprite++;
                if(obj.vertexData)
                    stat.nVertices += (obj.vertexData.length / 2);
            }
            return;
        }

        // 9-slice
        if (obj.mt.data.type === mt.objects.NINE_SLICE) {
            if (obj.visible) {
                stat.pxSprite += Math.abs(obj.width * obj.height);
                stat.nSprite++;
                if(obj.vertices)
                    stat.nVertices += obj.vertices.length;
            }
            return;
        }

        if (PIXI && PIXI.spine && obj instanceof PIXI.spine.SpineMesh) {
            if (obj.visible) {
                stat.pxSprite += Math.abs(obj.width * obj.height); 
                stat.nMesh++;
                stat.nVertices += (obj.vertices.length / 2);
            } 
            return; 
        }

        // Группа: перебираем всех подчиненных, если, конечно, группа видима
        if (obj.mt.data.type === mt.objects.GROUP) {
            if (obj.visible) {
                stat.containers++;
                obj.children.forEach(function (o) {
                    _fillRenderStat(o, stat);
                });
            }
            return;
        }

        if(obj.mt.data.type === mt.objects.EMITTER) {
            if (obj.visible) {
                stat.containers++;
                obj.children.forEach(function (particle) {
                    if(particle.visible) {
                        stat.pxSprite += Math.abs(particle.width * particle.height); 
                        stat.nSprite++;
                        if(particle.vertexData)
                            stat.nVertices += (particle.vertexData.length / 2);
                    }
                });
            }
            return;
        }
    };
});



