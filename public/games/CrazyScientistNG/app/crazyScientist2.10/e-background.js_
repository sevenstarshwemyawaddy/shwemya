nge.App[nge.appNS].Com.WinField.Controller = nge.Com.Base.extend(function() {
    var _previousAmount = 0;
    var _self;
    var _subscribed;

    var _fields;
    var _creditsWinNumbers;

    this.currencyColor = '#FFFFFFF';
    this.winTextTween = false;

    var _creditsWinSetValue = function (value) {
        for (var win in _creditsWinNumbers)
            _creditsWinNumbers[win].text = value === 0 ? nge.i18n.get(_self.cfg.wonWinText) : value;
    };

    this.showTextWinAmount = function(winAmount, duration) {
        if (!_fields) return;

        var setValue = function (value) {
            var amount = value;
            var restore = nge.localData.get('slotMachine.lastResponse');
    
            if (restore)
                amount = +restore.totalBonusWin;
            
            if(amount > 0) {
                _previousAmount = amount;
                nge.observer.fire('win.brain.setValue', amount);
            }
        };

        var freespinInProgress = nge.localData.get('freespin.inProgress');

        var finalAmount = (freespinInProgress) ?
            nge.Lib.Money.toCoins(nge.localData.get('slotMachine.totalBonusWin'))
            : winAmount;

        if (isNaN(finalAmount)) finalAmount = 0;

        if(nge.localData.get('freespin.inProgress')) {
            nge.localData.set('freespin.totalWin', nge.Lib.Money.fromCoins(finalAmount));
            nge.localData.set('freespin.totalWinCoins', finalAmount);
        }

        if (finalAmount === 0)
            setValue(0);
        else {
            var data = {win: _previousAmount};

            nge.localData.set('winTweenInProgress', true);

            this.winTextTween = nge.tween.add(data);
            this.winTextTween.to({win: finalAmount}, duration);
            this.winTextTween.onUpdateCallback(function () {
                var win = ~~this.win;
                setValue(win);
            }, data);
            this.winTextTween.onComplete.addOnce(function () {
                _self.winTextTween = false;
                setValue(finalAmount);
                nge.localData.set('winTweenInProgress', false);
                if(nge.localData.get('freespin.inProgress'))
                    nge.observer.fire('win.brain.lineWin.hide');
            }, _self);

            this.winTextTween.start();
        }
    };

    this.showVFX = function(winAmount) {
        _self.showTextWinAmount(winAmount, _self.cfg.winNumberAnimDuration);
    };

    this.showFreespinsRestoredWin = function (winAmount) {
        var coins = nge.Lib.Money.toCoins(winAmount);
        _previousAmount = coins;
        nge.observer.fire('win.brain.setValue', coins);
    };

    this.setWinFieldValue = function (value) {
        var text = value;
        var currncyLength = 0;
        var currency;

        if (typeof value === 'number') {
            if (value === 0)
                text = nge.i18n.get(this.cfg.wonWinText);
            else {
                currency = nge.localData.get('balance.currency');
                text = nge.Lib.Money.fromCoins(value).toFixed(2) + ' ' + currency;
                currncyLength = currency.length;
            }
        }
           
        for (var k in _fields){
            _fields[k].text = text;
            _fields[k].clearColors();
            if (currency){
                _fields[k].addColor(_self.currencyColor, text.length - currncyLength);
            }
        }

        _creditsWinSetValue(value);
    };

    this.stopWinTextTween = function () {
        if (_self.winTextTween) {
            _self.winTextTween.stop();
            _self.winTextTween = false;
            nge.localData.set('winTweenInProgress', false);
            if(nge.localData.get('freespin.inProgress'))
                nge.observer.fire('win.brain.lineWin.hide');
        }
    };

    this.printMessage = function(text){
        text = nge.i18n.get(text);

        for (var k in _fields){
            _fields[k].text = text;
            _fields[k].clearColors();
        }

        _creditsWinSetValue(text);
    };

    this.subscribe = function() {
        nge.observer.add('win.winField.setValue', _self.setWinFieldValue);
        nge.observer.add('win.winField.showRestoredWin', _self.showFreespinsRestoredWin);
        nge.observer.add('win.printMessage', _self.printMessage);

        nge.observer.add('win.winField.setPreviousAmount', function(prevAmount) {
            _previousAmount = prevAmount;
        });
        nge.observer.add('win.winField.showVFX', _self.showVFX);
        nge.observer.add('win.winField.stopWinTextTween', _self.stopWinTextTween.bind(_self));
    };

    this.create = function() {
        _self = this;
        this.createDefault();

        _self.cfg = this.getInstance('Cfg').get();
        _fields = nge.findAll('.' + _self.cfg.numbersElementsName);
        _creditsWinNumbers = nge.findAll('.'.concat(_self.cfg.creditsElementsName));
    
        var totalBonusWin = nge.localData.get('slotMachine.totalBonusWin');
        _previousAmount = nge.Lib.Money.toCoins(totalBonusWin || 0);

        if(!_subscribed)
            this.subscribe();

        _subscribed = true;
    };
});



nge.App[nge.appNS].Com.WinField.Mobile = {};



nge.App[nge.appNS].Com.WinField.Mobile.Controller = nge.App[nge.appNS].Com.WinField.Controller.extend(function() {
    this.currencyColor = '#EFC273';
    
    var _created = false;
    var _self = this;
    var _freespinContainer = null;

    var Y_DIFF = -16;

    var _winTexts = {
        links: {
            '^winMobileNumber': null,
            '^creditsWinMobileNumber': null
        },
        isInitNeeded: true,
        isUpdatePositionNeeded: true
    };
  
    var _counterFreeSpinsText;

    var _validateInput = function(data){
        if(data === '' || isNaN(+data))
            return '';

        return +data;
    };

    var _setFreespinContainerVisibilityTo = function(isVisible){
        if(_freespinContainer)
            _freespinContainer.visible = isVisible;
    };

    //NOTE (r.rakhman): Copied from dead code in ClassicGameBase's slot.js
    this.getInfoEventDownText = function (arg1, arg2) {
        return nge.i18n.applyTextParams(nge.i18n.get('FREE GAME %(arg1)s OF %(arg2)s'), {
            arg1: arg1,
            arg2: arg2
        });
    };

    var _setFreespinStateTo = function(current, total){
        var validatedTotal = _validateInput(total);
        var validatedCurrent = _validateInput(current);
        _counterFreeSpinsText.text = _self.getInfoEventDownText(validatedCurrent, validatedTotal);
    };

    var _createLinks = function(){
        for(var winTextSelector in _winTexts.links)
            _winTexts.links[winTextSelector] = nge.findOne(winTextSelector);
    };

    var _setTextPosition = function(){
        if(_winTexts.isInitNeeded)
            _createLinks();

        if(_winTexts.isUpdatePositionNeeded)
            for(var winTextSelector in _winTexts.links)
                _winTexts.links[winTextSelector].y += Y_DIFF;

        _winTexts.isInitNeeded = false;
        _winTexts.isUpdatePositionNeeded = false;
    };

    var _resetTextPosition = function(){
        if(_winTexts.isInitNeeded)
            _createLinks();

        if(!_winTexts.isUpdatePositionNeeded)
            for(var winTextSelector in _winTexts.links)
                _winTexts.links[winTextSelector].y -= Y_DIFF;

        _winTexts.isUpdatePositionNeeded = true;
    };

    var _updateFreespinState = function(spinsCurrent, spinsTotal){
        _setTextPosition();
        _setFreespinStateTo(spinsCurrent, spinsTotal);
        _setFreespinContainerVisibilityTo(true);
    };

    var _resetStateToDefaults = function(){
        _resetTextPosition();
        _setFreespinContainerVisibilityTo(false);
        _setFreespinStateTo('', '');
    };

    var _updateCounter = function(freespinData){
        _updateFreespinState(freespinData.current, freespinData.total);
    };

    var _resetCounter = function(){
        _resetStateToDefaults();
    };

    this.create = function(){
        _freespinContainer = nge.findOne('^gameFreeSpinMobileContainer');
        _counterFreeSpinsText = nge.findOne('^counterFreeSpinsText');

        _resetStateToDefaults();
        _createLinks();

        this.super.create();

        if(!_created)
            this.subscribe();            

        _created = true;
    };

    this.subscribe = function() {
        this.super.subscribe();

        nge.observer.add('freespin.counterUpdate', _updateCounter);
        nge.observer.add('freespin.counterReset', _resetCounter);
    };
});



