nge.App[nge.appNS].Com.Respin = {};



nge.App[nge.appNS].Com.Respin.Controller = nge.Com.Respin.Controller.extend(function () {
    "use strict";

    var _created = false;
    var _freespinPause;
    var _startRespin;
    var _respinInProgress;
    var _respinFinishProgress;
    var _countOfWinRespins = null;
    var _arrayForHide;
    var _arrayOfSymbol = [];
    var _finishSubstrateAnimation = false;
    var _lastDataAuthResponse;
    var _restoredGame;


    this.respinSymbols = ['0', '12'];
    this.countDefault = 2;
    this.responseData = null;
    this.view = null;

    this.create = function () {
        _restoredGame = false;
        _freespinPause = false;
        _startRespin = false;
        _respinInProgress = false;
        _respinFinishProgress = false;
        _countOfWinRespins = null;
        _arrayForHide = [];
        _arrayOfSymbol = [];
        _finishSubstrateAnimation = false;

        if (!_created) {
            _created = true;
            _subscribe();
        } else {
            if (nge.localData.get('stateEqualRespins')) {

                var isFreeRepins =
                    _lastDataAuthResponse &&
                    _lastDataAuthResponse.data &&
                    _lastDataAuthResponse.data.lastResponse &&
                    _lastDataAuthResponse.data.lastResponse.state === "FreeReSpins";

                if (isFreeRepins) {
                    this.disableStandartGame();
                } else {
                    nge.localData.set('stateEqualRespins', false);
                }
            }
        }


        this.view = this.getInstance('View');
        this.super.create();
        this.createDefault();

    };

    var _spinResponseHandler = function (data) {

        this.responseData = data;
        if (nge.localData.get('respin.inProgress')) {
            this.view.showStateOfRespin('RESPIN ' + nge.localData.get('respin.spinsLeft') || 'WIN');
            return;
        }

        if (data && (data.state === 'ReSpins' || data.state === 'FreeReSpins')) {
            data && data.slotWin && data.slotWin.lineWinAmounts.forEach(function (el) {

                if (el.params && el.params.reSpins) {
                    _countOfWinRespins = el.params.reSpins;
                }
            });

            nge.localData.set('stateEqualRespins', true);
            nge.localData.set('myRespin.realRespinLeft', this.countDefault);
            nge.observer.fire('start.Respins');
        }

    }.bind(this);

    this.winlinesCompleteHandler = function () {

        var freespinIngrgs = nge.localData.get('freespin.inProgress');
        var arrForHold;
        if (_respinInProgress) {

            if (+nge.localData.get('respin.spinsLeft') < 1 ||
                nge.localData.get('respin.spinsTotal') === 1) {
                _respinInProgress = false;
                _respinFinishProgress = null;
                this.finishRespin();


                if (_arrayForHide && _arrayForHide.length) {
                    if (freespinIngrgs) {
                        this.freespinStartHandler(true, _arrayForHide);
                    }
                    nge.observer.fire('respin.unHoldSymbolsWin', _arrayForHide);
                    _arrayForHide = [];
                } else {
                    if (freespinIngrgs) {
                        this.freespinStartHandler(false, _arrayForHide);
                    } else {
                        nge.observer.fire('backgroundSound.play');
                    }

                }
                return;
            }
            arrForHold = this.findSymbolForHold(this.respinSymbols);
            this.freezeSymbols(arrForHold);

        }

    };

    this.freespinStartHandler = function (isWin) {

    };

    this.spinCommand = function () {
        if (_finishSubstrateAnimation) {
            _finishSubstrateAnimation = false;
            nge.observer.fire('slotMachine.setAlphaOnHoldSymbols');

            if (_arrayForHide && _arrayForHide.length) {
                nge.observer.fire('respin.unHoldSymbolsWin', _arrayForHide);
            }
            nge.observer.fire('winlines.animateAll' + this.gameForRespin || '');
        }
        if (!nge.localData.get('freespin.inProgress') || _freespinPause) {
            if (_startRespin || _respinInProgress) {
                if (+nge.localData.get('respin.spinsLeft')) {
                    nge.observer.fire('respin.soundStart');
                }
                this.super.spinCommand();
            }
        }
    };

    this.findSymbolForHold = function (respinSymbols) {

        var arrSymbolsForHold = [];

        this.responseData &&
        this.responseData.spinResult &&
        this.responseData.spinResult.columns.forEach(function (item, reelIndex) {
            item.forEach(function (item, rowIndex) {
                if (~respinSymbols.indexOf(item)) {
                    arrSymbolsForHold.push({reel: reelIndex, row: rowIndex});
                }
            });
        });

        if (!arrSymbolsForHold.length)
            return null;
        return arrSymbolsForHold;
    };

    this.freezeSymbols = function (arrOfSymbolInside) {
        if (!arrOfSymbolInside) {
            this.spinCommand();
            return;
        }
        if (_arrayOfSymbol.length !== arrOfSymbolInside.length) {
            nge.observer.fire('respin.holdSymbols', arrOfSymbolInside);
            _arrayOfSymbol = _arrayOfSymbol.concat(arrOfSymbolInside);
        } else {
            this.spinCommand();
        }
    };

    this.unFreezeSymbols = function () {
        nge.observer.fire('respin.unHoldSymbols', _arrayOfSymbol);
    };

    this.disableStandartGame = function () {
        nge.observer.fire('buttons.disable.all');
        nge.observer.fire('buttons.enable.auto');
    };

    this.enableStandartGame = function () {
        // nge.observer.fire('buttons.enable.all');
        // nge.observer.fire('buttons.enable.spin');
    };


    this.startRespin = function (popupView, ms) {
        this.disableStandartGame();
        if (!popupView) {
            this.view.showStateOfRespin('RESPIN ' + (_countOfWinRespins || this.countDefault));
            nge.observer.fire('respin.popupIsHidden');
            return;
        }
        var respinTotal = nge.localData.get('respin.spinsTotal') || _countOfWinRespins;
        popupView.popup = nge.findOne(popupView.popup);
        popupView.textTpl = this.setText(popupView.textTpl);
        popupView.value = this.setText(popupView.value, respinTotal);
        nge.observer.fire('respin.popUpShow');
        this.view.showPopup(popupView, ms);
    };

    this.setText = function (textTpl, text) {
        textTpl = nge.findOne(textTpl);
        textTpl.text = text || 'RESPIN WON';
        return textTpl;
    };

    this.finishRespin = function () {
        _freespinPause = false;

        if (!nge.localData.get('freespin.inProgress'))
            this.enableStandartGame();

        this.view.showStateOfRespin('RESPIN 0');
        this.super.finishRespin();
        nge.localData.set('stateEqualRespins', false);
    };

    var _startRespinTrigger = function () {
        if (nge.localData.get('freespin.inProgress')) {
            nge.observer.fire('freespin.pause');
            _freespinPause = true;
        }
        _startRespin = true;
    };

    var _inProgresRespinTrigger = function () {
        if(_restoredGame) {
            nge.observer.fire('buttons.freespinContinue');
            _restoredGame = false;
        }

        var arrForHold = this.findSymbolForHold(this.respinSymbols);
        this.freezeSymbols(arrForHold);
        _respinInProgress = true;
    }.bind(this);

    this.finishHideCoversAndSymbols = function () {
        if (_respinFinishProgress === null) {
            this.unFreezeSymbols();
            _arrayOfSymbol = [];
            _respinFinishProgress = false;
        }
    };

    this.showHideCoversAndSymbols = function () {
        _restoredGame = false;
        var arrForHold;
        if (_startRespin) {
            nge.observer.fire('winlines.stopAnimation');
            _startRespin = false;
            this.startRespin();
        }

        if (_arrayForHide && _arrayForHide.length) {
            _finishSubstrateAnimation = true;
            arrForHold = this.findSymbolForHold(this.respinSymbols);
            this.freezeSymbols(arrForHold);
        }
        if (_arrayForHide === null) {
            _finishSubstrateAnimation = true;
            arrForHold = this.findSymbolForHold(this.respinSymbols);
            this.freezeSymbols(arrForHold);
            _arrayForHide = [];
        }
    };

    this.computeSymbolsForUnhold = function (data) {
        if (+nge.localData.get('respin.spinsLeft') === 1) {

            nge.localData.set('isLastRespinGame', true);
            _arrayForHide = [];

            if (data && data.slotWin && data.slotWin.lineWinAmounts) {

                data.slotWin.lineWinAmounts.forEach(function (winLine) {
                    winLine.wonSymbols.forEach(function (arr) {
                        _arrayForHide.push({reel: arr[0], row: arr[1]});
                    });
                });

                // clean dublicate objects;
                _arrayForHide = _arrayForHide.filter(function (el, i, arr) {
                    for (var k = i; k < arr.length; k++) {
                        if (k === i) continue;
                        if (el.reel === arr[k].reel && el.row === arr[k].row) {
                            return false;
                        }
                    }
                    return true;
                });
                if (!_arrayForHide.length) {
                    _arrayForHide = null;
                }
                return true;
            } else {
                _arrayForHide = null;
                return false;
            }

        }

    };

    this.showCoversBetweenPopup = function () {
        if (_arrayForHide && _arrayForHide.length && _respinInProgress) {
            nge.observer.fire('respin.holdSymbolsWin', _arrayForHide);
        }
    };

    this.ressurectRespin = function () {
        _respinInProgress = nge.localData.get('respin.inProgress');
        _restoredGame = true;
        if (nge.localData.get('stateEqualRespins')) {
            nge.observer.fire('respin.restoreClassicRespin');
        }
    };

    var _saveLastData = function (data) {
        _lastDataAuthResponse = data;
    };


    var _subscribe = function () {
        nge.observer.add('respin.restoreClassicRespin', this.startRespin);
        nge.observer.add('transportMessage.AuthResponse', _saveLastData);
        nge.observer.add('freespin.restoreText', this.ressurectRespin);
        nge.observer.add('winlinesSubstrate.endTween', this.spinCommand);
        nge.observer.add('lines.set', this.finishHideCoversAndSymbols);
        nge.observer.add('popup.animation.start', this.showCoversBetweenPopup);
        nge.observer.add('slotMachine.spinResponse', this.computeSymbolsForUnhold);
        nge.observer.add('slotMachine.spinComplete', this.showHideCoversAndSymbols);
        nge.observer.add('slotMachine.spinCommand', this.finishHideCoversAndSymbols);
        nge.observer.add('respin.popupIsHidden', _inProgresRespinTrigger);
        nge.observer.add('winlines.animateByOne.cycleComplete', this.winlinesCompleteHandler);
        nge.observer.add('slotMachine.spinResponse', _spinResponseHandler);
        nge.observer.add('start.Respins', _startRespinTrigger);
    }.bind(this);
});




