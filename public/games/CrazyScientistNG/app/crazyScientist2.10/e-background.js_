        ]
    };
});



nge.Mlm.StatesManager.Controller = function () {

    var _service;

    /**
     * display new state
     * @param {String} state
     * @param {mixed} changeMode transition/loader/true  true ===transition
     * @param {boolean} clearWorld
     * @returns {Boolean}
     */
    this.display = function (state, changeMode, clearWorld) {
        _selfChk();
        return _service.display(state, changeMode, clearWorld);
    };

    /**
     * get current state name
     * @returns {String}
     */
    this.getCurrentName = function () {
        _selfChk();
        return _service.getCurrentName();
    };

    /**
     * check service instance
     * @returns {Boolean}
     */
    var _selfChk = function () {
        if (!_service)
            _service = nge.App.getInstance('Mlm.StatesManager.Service');

        return true;
    };

    /**
     * get Default State
     * @returns {Object|String}
     */
    this.getDefaultState = function () {
        _selfChk();
        return _service.getDefaultState();
    };

    /**
     * set Default State
     * @param {String} s
     * @returns {Object|String}
     */
    this.setDefaultState = function (s) {
        _selfChk();
        return _service.setDefaultState(s);
    };

    /**
     * stop loop and update (only for engine usage)
     * @returns {Object|String}
     */
    this.stop = function () {
        return _service.stop();
    };

    /**
     * pause loop and update
     * @returns {Object|String}
     */
    this.pause = function () {
        return _service.pause();
    };

    /**
     * resume loop and update
     * @returns {Object|String}
     */
    this.resume = function () {
        return _service.resume();
    };
    
    /**
     * is game paused ?
     * @returns {Boolean}
     */
    this.isPaused = function(){
        return _service.isPaused();
    };
};



nge.Mlm.StatesManager.Helper = function () {

    this.get = function (state) {
        return nge.localData.get('states.' + state) || _states[state] || false;
    };


    //example
    var _states = {
        demo: ['demo'],
        load: ['load'],
        play: ['slotMachine']
    };
};



nge.Mlm.StatesManager.Service = function () {
    var _partsReserved = ["_Package", "Controller"];
    var _stateName;
    var _defaultState = 'demo';
    var _displayInProgress = false;
    var _loaderOriginalScale = false;
    var _loader = false;

    /**
     * display new state
     * @param {String} state
     * @param {mixed} changeMode transition/loader/true  true ===transition
     * @param {boolean} clearWorld
     * @returns {Boolean}
     */
    this.display = function (state, changeMode, clearWorld) {
        var cfg = nge.App.getInstance('Mlm.StatesManager.Cfg');
        var transition = false;
        var loader = false;

        switch (changeMode) {
            case 'loader':
                loader = true;
                break;
            case 'transition':
                transition = true;
                break;
            case true:
                transition = true;
                break;
        }

        if (typeof (clearWorld) === 'undefined')
        {
            clearWorld = false;

            if (loader) {
                if (cfg.params.loaderModeClearWorld)
                    clearWorld = true;
            }
        }

        _loader = loader;

        if (_displayInProgress) {
            console.warn("nge.Mlm.StatesManager.display is busy, because displayIng Progress", state, transition);
            return false;
        }

        log('*** STATE ' + state + ' ***, mode = ' + changeMode + ', clearWorld = ' + clearWorld);
        _displayInProgress = true;
        nge.observer.fire('StatesManager.display.start');

        //reset names and ids arrays
        mt.data._ids = [];
        mt.data._names = [];

        _makeComponentsInactive(_stateName);

        nge.objects.resetStateHandler();

        if (!nge.wrap.states.checkState(state) || clearWorld) {
            if (clearWorld) {
                nge.observer.removeByPrefix(state);
                _destroyComponents(state);
            }

            var cmps = _getCom(state);
            log("StatesManager: com found", JSON.stringify(cmps));

            if (cmps) {
                _loadCom(cmps, state);
            } else {
                console.error('Fatal Error: no state found:', state);
                return false;
            }
        }

        _stateName = state;
        nge.observer.setPrefix(state);

        if (transition)
            window.nge.transitions.to(state);
        else
            nge.wrap.states.start(state, clearWorld);

        nge.observer.fire('StatesManager.display');
        return true;
    };

    /**
     * get current state name
     * @returns {String}
     */
    this.getCurrentName = function () {
        return _stateName;
    };

    /**
     * stop loop and update
     * @returns {Object|String}
     */
    this.stop = function () {
        return nge.wrap.states.stopLoop();
    };

    /**
     * pause loop and update
     * @returns {Object|String}
     */
    this.pause = function () {
        return nge.wrap.states.pauseLoop();
    };

    /**
     * resume loop and update
     * @returns {Object|String}
     */
    this.resume = function () {
        return nge.wrap.states.resumeLoop();
    };

    /**
     * is game paused ?
     * @returns {Boolean}
     */
    this.isPaused = function () {
        return nge.wrap.states.isPausedLoop();
    };

    /**
     * get and save com for state
     * @param {String} state
     * @returns {Array}
     */
    var _getCom = function (state) {
        var helper = new nge.Mlm.StatesManager.Helper();
        var com = helper.get(state);
        return com;
    };

    var _makeComponentsInactive = function (state) {
        if (!nge.state[state] || !nge.state[state].c)
            return false;

        for (var k in nge.state[state].c) {
            if (nge.state[state].c[k].deactivate)
                nge.state[state].c[k].deactivate();
        }
    };

    var _destroyComponents = function (state) {
        if (!nge.state[state] || !nge.state[state].c)
            return false;

        for (var k in nge.state[state].c) {
            if (nge.state[state].c[k].destroy)
                nge.state[state].c[k].destroy();

            delete(nge.state[state].c[k]);
        }
    };

    /**
     * com init
     * @param {Object} cmps
     * @param {String} state
     * @returns {Boolean}
     */
    var _loadCom = function (cmps, state) {
        if (!nge.state[state]) {
            nge.state[state] = {};
            nge.state[state].c = {};
            nge.state[state].com = cmps;
        }

        var cfg = nge.App.getInstance('Mlm.StatesManager.Cfg');
        var proj = nge.Lib.Helper.capitaliseFirstLetter(nge.Cfg.Main.project);

        if (cfg.params.lazyLoad)
            var blockedAssets = {};

        for (var k in cmps) {
            //var path = "com/" + cmps[k] + "/_comPackage";
            var com = nge.Lib.Helper.capitaliseFirstLetter(cmps[k]);

            //_Package
            var comPackage = nge.App.getPath('Com.' + com + '._Package');

            //dependence
            if (typeof (comPackage.dependence) !== 'undefined') {
                for (var depK in comPackage.dependence) {
                    var dep = comPackage.dependence[depK];
                    var depArr = dep.split('.');

                    //if(com) - check instance
                    if (depArr[0] === 'com') {
                        if (!nge.state[state].c[depArr[1]])
                            console.warn('Warning: no dependence for ' + comPackage.name + ' found:', dep);
                    } else {
                        //else - check in system
                        var pathCArr = [];

                        for (var dak in depArr) {
                            pathCArr.push(nge.Lib.Helper.capitaliseFirstLetter(depArr[dak]));
                        }

                        var path = pathCArr.join('.');
                        var depPackage = nge.App.getPath(path);

                        if (!depPackage)
                            console.warn('Warning: no dependence for ' + comPackage.name + ' found:', dep);
                    }
                }
            }

            //component instance
            nge.state[state].c[cmps[k]] = nge.App.getInstance(
                'Com.' + com + '.Controller');

            if (!nge.state[state].c[cmps[k]])
                nge.state[state].c[cmps[k]] = new nge.Com.Base();

            //getInstance
            if (nge.state[state].c[cmps[k]]) {
                nge.state[state].c[cmps[k]].getInstance = function (component) {
                    return function (layer, com, params) {
                        if (!com)
                            com = component;

                        com = nge.Lib.Helper.capitaliseFirstLetter(com);

                        var instance = nge.App.getInstance(
                            'Com.' + com + '.' + layer,
                            false,
                            params
                            );

                        if (instance)
                            instance.getInstance = arguments.callee;

                        return instance;
                    };
                }(cmps[k]);

                //getPath
                nge.state[state].c[cmps[k]].getPath = function (component) {
                    return function (com) {
                        if (!com)
                            com = component;

                        com = nge.Lib.Helper.capitaliseFirstLetter(com);

                        return nge.App.getPath('Com.' + com);
                    };
                }(cmps[k]);

                //name
                nge.state[state].c[cmps[k]].comName = cmps[k];
            }

        }

        var fdo = function (f, params) {
            for (var k in nge.state[state].c) {
                if (nge.state[state].c[k] && nge.state[state].c[k][f])
                    nge.state[state].c[k][f](params);
            }
        };

        var tpl = nge.tpl.state(state);

        nge.state[state].preload = function () {
            nge.observer.fire('StatesManager.preload.start', state);

            //show loader
            if (_loader) {
                nge.objects.create('loadingBarContainer');
                var bg = nge.find('^loadingBarFill');

                if (bg) {
                    bg.visible = false;
                    var mask = nge.objects.create(new nge.Mlm.Objects.Mask({rects: [[0, 0, bg.width, bg.height]]}));
                    bg.addChild(mask);
                    bg.mask = mask;
                }
            }

            //state in window.mt.data ONLY(!) if !exists
            if (
                tpl &&
                window.mt.data.assets.contents.filter(function (k) {
                    return k.name === state + 'State' ? true : false;
                }).length === 0 &&
                window.mt.data.objects.contents.filter(function (k) {
                    return k.name === state + 'State' ? true : false;
                }).length === 0
                ) {
                //styles
                if (tpl.styles)
                    window.mt.data.styles = nge.Lib.Helper.objectApply(
                        window.mt.data.styles, tpl.styles);

                //assets
                if (tpl.assets && tpl.assets.contents) {
                    window.mt.data.assets.contents.push({
                        "name": state + 'State',
                        "contents": mt.tplsPathsPrepare(tpl.assets.contents)
                    });
                }

                //objects
                window.mt.data.objects.contents.push({
                    "id": state + 'State',
                    "name": state + 'State',
                    "contents": mt.tplsPathsPrepare(tpl.objects.contents),
                    "x": 0,
                    "y": 0,
                    "isVisible": true,
                    "class": nge.App.getSysInstancesModes().join(' '),
                    "type": 1
                });

                mt.psd.dataParser.go(); //we need correct assets and objects, also correct containers(!)
            }

            fdo('preload');
            mt.psd.dataParser.go(); //we need correct assets and objects

            nge.observer.fire('StatesManager.preload.components.end', state);

            if (cfg.params.lazyLoad)
                for (var k in cfg.params.blocks) {
                    var block = cfg.params.blocks[k];
                    var blockParts = nge.Lib.Helper.customRecursiveFind('block', block, 'contents', mt.data.assets, false, false, true);

                    if (blockParts.length > 0)
                        blockedAssets[block] = blockParts;
                }

            mt.preload();
            nge.observer.fire('StatesManager.preload.end', state);
        };

        var lazyLoadProgress = function () {
            if (nge.Lib.Helper.getObjSize(blockedAssets) === 0)
                return false;

            var k = Object.keys(blockedAssets)[0];

            mt.loadAssets(blockedAssets[k]);

            var assetsFolderKey = 'lazy_' + k;
            var parent = mt.data.assets.contents.filter(function (el) {
                return el.name === assetsFolderKey;
            })[0];
            //push to this.data.assets.contents
            if (!parent) {
                parent = new nge.Mlm.Assets.Folder({name: assetsFolderKey});
                mt.data.assets.contents.push(parent);
            }

            parent.contents = nge.Lib.Helper.mergeArrs(parent.contents, blockedAssets[k]);


            nge.wrap.load.onComplete.addOnce(function () {
                delete blockedAssets[k];

                //all events must finish. Create must run in another raf cycle
                setTimeout(lazyLoadProgress, 1);
            });
            nge.wrap.load.start();
        };

        nge.state[state].loadUpdate = function () {
            fdo('loadUpdate', {progress: Math.ceil(100 * nge.wrap.load.progress)});

            //check if loader
            var bg = nge.find('^loadingBarFill');

            if (!bg)
                return false;

            if (!_loaderOriginalScale)
                _loaderOriginalScale = bg.scale.x;

            if (!bg.mask) {
                var mask = nge.objects.create(new nge.Mlm.Objects.Mask({rects: [[0, 0, bg.width, bg.height]]}));
                bg.addChild(mask);
                bg.mask = mask;
            }

            bg.mask.scale.x = nge.wrap.load.progress * 0.01 * _loaderOriginalScale;
            bg.visible = true;
            //log('game.load.progress = ' + nge.wrap.load.progress);
        };

        nge.state[state].create = function () {
            nge.observer.fire('StatesManager.create.start', state);
            nge.wrap.states.world.shutdown();

            nge.localData.set('statesManager.creating', true);

            if (tpl)
                nge.objects.create(state + 'State');

            fdo('create');
            nge.localData.set('statesManager.creating', false);
            nge.objects.setStyles();

            nge.observer.fire('StatesManager.create.end', state);
            _displayInProgress = false;

            if (cfg.params.lazyLoad)
                lazyLoadProgress();
        };

        var updateLastCall = 0;
        nge.state[state].update = function () {
            nge.observer.fire('StatesManager.update.start', state);
            var updateParams = {deltaT: nge.Lib.Time.getDeltaT(updateLastCall)};

            nge.observer.fire('cyclicUpdate', updateParams);
            fdo('update', updateParams);
            updateLastCall = nge.Lib.Time.get();

            nge.observer.fire('StatesManager.update.end', state);
        };

        nge.state[state].render = function () {
            fdo('render');
        };

        nge.wrap.states.add(state, nge.state[state]);
        return true;
    };

    /**
     * close instances of com
     * @returns {Boolean}
     */
    var _close = function () {
        for (var k in nge.c) {
            var com = nge.c[k];

            if (com.destroy)
                com.destroy();
        }

        nge.c = {};
        return true;
    };

    this.getDefaultState = function () {
        return nge.Lib.Helper.parseGetParams('state') || _defaultState;
    };

    this.setDefaultState = function (s) {
        return _defaultState = s;
    };
};



nge.Mlm.Tpl = {};



nge.Mlm.Tpl.Controller = function () {

    this.state = function (state) {
        var stateCap = nge.Lib.Helper.capitaliseFirstLetter(state);
        return nge.App.getInstance('Tpl.States.' + stateCap);
    };

    this.group = function (group) {
        var groupCap = nge.Lib.Helper.capitaliseFirstLetter(group);
        return nge.App.getInstance('Tpl.Groups.' + groupCap);
    };
};



nge.Mlm.Transport = {};



nge.Mlm.Transport.Controller = function () {

    var _service;

    /**
     * Инициализация
     * 
     * @returns {Boolean}
     */
    this.init = function () {
        _service = new nge.Mlm.Transport.Service();
        _service.init();
        _subscribe();
        return true;
    };

    this.reconnect = function () {
        _service.reconnect();
    };

    /**
     * close current connection, start new
     * @returns {undefined}
     */
    this.close = function () {
        _service.close();
    };

    /**
     * Отправить сообщение
     * @param {nge.Mlm.Transport.Model} model
     * @returns {Boolean}
     */
    this.send = function (model) {
        _service.store(model);
        return true;
    };

    this.setSESID = function (sesId) {
        return _service.setSESID(sesId);
    };

    /**
     * Прием сообщения
     * 
     * @param {mixed} data
     * @returns {Boolean}
     */
    this.receive = function (data) {
        _service.receive(data);
        return true;
    };

    /**
     * Проверка - не надо ли нам отправить что-то
     * 
     * @returns {Boolean}
     */
    this.chkStorage = function () {
        _service.chkStorage();
        return true;
    };

    this.clearQuery = function () {
        _service.clearQuery();
        return true;
    };

    /**
     * Подписка на события
     * 
     * @returns {Boolean}
     */
    var _subscribe = function () {
        nge.observer.add(
            'cyclicUpdate',
            nge.transport.chkStorage,
            'transport.cyclicUpdate',
            true
            );
        nge.observer.add(
            'transportMessage',
            nge.transport.receive,
            'transport.transportMessage',
            true
            );
        nge.observer.add(
            'Transport.clearMessagesQuery',
            nge.transport.clearQuery,
            'transport.clearMessagesQuery',
            true
            );
        return true;
    };

};


nge.Mlm.Transport.Decorator = function () {

    this.toServer = function (model) {
        if (model.action) {
            model.cmd = model.action;
        }
        return model;
    };

    this.toFront = function (message) {
        if (message.cmd) {
            message.action = message.cmd;
        }

        var responseName = 'Mlm.Transport.Models.' + message.action;
        var responseModel = nge.App.getInstance(responseName, false, message);

        if (responseName.indexOf('Responce') !== -1)
            console.error('ResponCe bug: ' + responseName);

        if (!responseModel) {
            console.error('No model for response: ' + responseName);
            return nge.Lib.Helper.jsObjClone(message);
        }

        responseModel = nge.Lib.Helper.jsObjClone(responseModel);
        return responseModel;
    };
};



nge.Mlm.Transport.Helper = {
    winlineTypes: {
        LineWinAmount: ['selectedLine', 'wonSymbols', 'amount'],
        WinAmount: ['wonSymbols', 'amount'],
        Bonus: ['wonSymbols', 'amount', 'bonusName'],
        LinePickBonus: ['wonSymbols', 'amount', 'bonusName']
    },

    bonusWinlinesFields: {
        Bonus: {
            FreeSpins: ['params.freeSpins', 'params.expandingSymbol'],
            ReSpins: ['params.reSpins'],
            PickBonus: ['params.fields'],
            FullFillJackpot: []
        }
    },

    gambleHistoryTypes: [
        '0',
        '1'
    ],

    parseWinlines: function (winlinesIn) {
        if (!winlinesIn)
            return false;

        var winlinesOut = [];
        for(var i = 0; i < winlinesIn.length; i++) {
            var winlineIn = winlinesIn[i];
            if (!winlineIn || !winlineIn.type)
                continue;
            var fields = this.winlineTypes[winlineIn.type];
            if (!fields)
                continue;
            var winlineOut = {};
            winlineOut.type = winlineIn.type;
            for(var j = 0; j < fields.length; j++) {
                var field = winlineIn[fields[j]];
                if (typeof field !== 'undefined')
                    winlineOut[fields[j]] = field;
            }

            if (winlineOut.bonusName) {
                if (!this.bonusWinlinesFields[winlineOut.type])
                    continue;
                var bonusFields = this.bonusWinlinesFields[winlineOut.type][winlineOut.bonusName];
                if (!bonusFields)
                    continue;
                for(var j = 0; j < bonusFields.length; j++) {
                    var bonusField = nge.Lib.Helper.recursiveGet(bonusFields[j], winlineIn, undefined);
                    if (typeof bonusField !== 'undefined')
                        nge.Lib.Helper.recursiveSet(bonusFields[j], bonusField, winlineOut);
                }
            }

            winlinesOut.push(winlineOut);
        }

        return winlinesOut;
    },

    parseGambleParams: function (paramsIn) {
        if (!paramsIn)
            return false;

        var paramsOut = {};
        var history = paramsIn.history;
        if (history) {
            paramsOut.history = [];
            if (history.length > 0) {
                for (var i = 0; i < history.length; i++) {
                    if (this.gambleHistoryTypes.indexOf(history[i]) !== -1)
                        paramsOut.history.push(history[i]);
                }
            }
        }

        return paramsOut;
    },

    parseSlotWin: function (slotWinIn) {
        if (!slotWinIn)
            return false;

        var slotWinOut = {};
        slotWinOut.totalWin = slotWinIn.totalWin || false;
        var canGamble = slotWinIn.canGamble;
        if (canGamble)
            slotWinOut.canGamble = canGamble;

        var lineWinAmounts = this.parseWinlines(slotWinIn.lineWinAmounts);
        if (lineWinAmounts)
            slotWinOut.lineWinAmounts = lineWinAmounts;

        var gambleParams = this.parseGambleParams(slotWinIn.gambleParams);
        if (gambleParams)
            slotWinOut.gambleParams = gambleParams;

        var maxCount = 2;
        for (i = 0; i <= maxCount; i++) {
            var lineWinAmountsStage = slotWinIn['lineWinAmountsStage' + i];
            if (lineWinAmountsStage) {
                slotWinOut['lineWinAmountsStage' + i] = this.parseWinlines(lineWinAmountsStage);
                maxCount++;
            }
        }

        return slotWinOut;
    },

    parseSpinResults: function (parentData) {
        var spinResults = {};
        if (!parentData)
            return spinResults;

        spinResults.spinResult = {};
        spinResults.spinResult.type = nge.Lib.Helper.recursiveGet('spinResult.type', parentData, false);
        spinResults.spinResult.rows = nge.Lib.Helper.recursiveGet('spinResult.rows', parentData, false);

        var maxCount = 2;
        for (var i = 0; i <= maxCount; i++) {
            var spinResultStage = nge.Lib.Helper.recursiveGet('spinResultStage' + i, parentData, false);
            if (spinResultStage) {
                spinResults['spinResultStage' + i] = {};
                spinResults['spinResultStage' + i].type = spinResultStage.type || false;
                spinResults['spinResultStage' + i].rows = spinResultStage.rows || false;
                maxCount++;
            }
        }

        return spinResults;
    },

    parsePayouts: function (payoutsIn) {
        var payoutsOut = [];
        if (!payoutsIn || !payoutsIn.length)
            return payoutsOut;

        for (var i = 0; i < payoutsIn.length; i++) {
            var payout = {};

            if (payoutsIn[i].type && ['basic', 'scatter'].indexOf(payoutsIn[i].type) !== -1)
                payout.type = payoutsIn[i].type;
            else
                continue;

            if (payoutsIn[i].payout)
                payout.payout = payoutsIn[i].payout;
            else
                continue;

            if (payoutsIn[i].symbols && payoutsIn[i].symbols.length > 0)
                payout.symbols = payoutsIn[i].symbols;
            else
                continue;

            payoutsOut.push(payout);
        }

        return payoutsOut;
    },

    parseBonusEnd: function(options) {
        var result = {};
        var gameParameters = nge.Lib.Helper.recursiveGet('data.gameParameters', options, {});
        result.initialSymbols =  gameParameters.initialSymbols || false;
        return result;
    },

    objectsEqual: function (o1, o2) {
        var objSort = function(o){
            var sortedObj = {};
            var keys = Object.keys(o);
            keys.sort();
            for(var index in keys){
                if (keys.hasOwnProperty(index)) {
                    var key = keys[index];
                    var value = o[key];
                    if (typeof o[key] === 'object')
                        value = objSort(value);
                    sortedObj[key] = value;
                }
            }
            return sortedObj;
        };

        var o1s = objSort(o1);
        var o2s = objSort(o2);
        return JSON.stringify(o1s)===JSON.stringify(o2s);
    }
};



nge.Mlm.Transport.Mapper = Class.extend(function () {

    var _mode; //ajax/socket
    var _sock;
    var _sockConnected = false;

    /**
     * Инициализация
     * 
     * @returns {Boolean}
     */
    this.init = function () {
        _mode = 'ajax';
        log('Transport.Mapper.init');
        if (_checkWebSocketSupport() && (nge.Cfg.Main.wshost || nge.Cfg.Main.wshostDev)) {
            log('Transport.Mapper.init...socket mode... trying to connect...');
            _sockInit();

            nge.observer.add(
                'sendSocket',
                function (d) {
                    var str = JSON.stringify(d);
                    _sock.send(str);
                },
                'SockJS.sendSocket',
                true
                );
        } else
            _ready();

        return true;
    };

    this.reconnect = function () {
        _sockInit();
        return true;
    };

    this.close = function () {
        _sock.close();
    };

    var _sockInit = function () {
        var host = nge.Cfg.Main.wshost;
        var getWshostMode = nge.Lib.Helper.parseGetParams('wshost');

        if (getWshostMode && getWshostMode === 'remote')
            host = nge.Cfg.Main.wshostRemote;
        else if (getWshostMode)
            host = decodeURIComponent(getWshostMode);
        else if (host === '<SERVERHOST>')
            host = nge.Cfg.Main.wshostDev;

            log('Transport host: ' + host);

        _mode = 'socket';
        _sock = new window[nge.Cfg.Main.wsType](host);
        var sock = _sock;

        sock.onopen = function () {
            _mode = 'socket';
            _sockConnected = true;
            nge.observer.fire('Transport.open', _mode);
            log('open', _mode);
            _ready();
        };

        sock.onmessage = function (e) {
            nge.observer.fire('getSocket', e.data);
            var data = JSON.parse(e.data);
            //nge.Lib.Console.color('receive: ', '#222288', '#ffff22');
            //console.log(data);
            nge.transport.receive(data);
        };

        sock.onclose = function () {
            _sockConnected = false;
            nge.observer.fire('Transport.close', _mode);
            log('close', _mode);
            _mode = 'ajax';
        };
    };

    var _checkWebSocketSupport = function () {
        //in fucking apple WebSocket is an object
        //if (typeof (WebSocket) !== "function") {
        if (!WebSocket) {
            log('_checkWebSocketSupport', false);
            return false;
        }
        log('_checkWebSocketSupport', true);
        return true;
    };

    var _ready = function () {
        nge.observer.fire('transport.ready');
        nge.localData.set('transport.ready', true);
    };

    /**
     * отправка сообщения
     * 
     * @param {mixed} data
     * @returns {Boolean}
     */
    this.send = function (data) {
        var mode = _mode;

        if (data._mode)
            mode = data._mode;

        var res;

        switch (mode) {
            case 'ajax':
                res = _sendAjax(data);
                break;
            case 'socket':
                res = _sendSocket(data);
                break;
            default:
                res = false;
                break;
        }

        return res;
    };

    /**
     * Отправка сообщения через Ajax
     * 
     * @param {mixed} data
     * @returns {Boolean}
     */
    var _sendAjax = function (data) {
        var url = _getAjaxUrl(data);
        if (!url) {
            console.error('cannot send package', data);
            return false;
        }

        $.ajax({
            type: "POST",
            url: url,
            dataType: "json",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function (response) {
                nge.transport.receive(response);
            },
            error: function (e) {
                console.error('nge.Mlm.Transport.Mapper.sendAjax...Error');
                log(e);
            }
        });
        return true;
    };

    /**
     * Получение урла для Ajax запроса
     * @param {Object} data
     * @returns {String}
     */
    var _getAjaxUrl = function (data) {
        var url = nge.Cfg.Main.sendUrl;

        if (
            !nge.Cfg.Main.sendUrlProcessing
            || nge.Cfg.Main.sendQueryMode === 'all'
            )
            return url;

        //обработка единичной модели
        if (Object.prototype.toString.call(data) !== '[object Array]') {
            url = url + nge.Lib.Helper.strReplace('.', '/', data.action) + '/';
        }

        return url;
    };

    /**
     * отправка пакета в сокет
     * @param {Object} data
     * @returns {Boolean}
     */
    var _sendSocket = function (data) {
        if (!_sockConnected)
            return false;

        //nge.Lib.Console.color(data.action, '#ffff22', '#222288');
        //console.log(data);
        nge.observer.fire('sendSocket', data);
        return true;
    };
});



nge.Mlm.Transport.Model = Class.extend(function () {
    this.customConstructor = function () {
        console.error('Model Error: not overwrited customConstructor!');
    };

    this.constructor = function (options) {
        var baseModel = {
            //action: options && options.action || 'none',
            msgId: options && options.msgId || undefined,
            sesId: options && options.sesId || false,
            gsId: options && options.gsId || undefined,
            result: options && options.result || false,
            data: options && options.data || {},
            //служебные
            _mode: options && options._mode || undefined  // undefined/ajax/socket
        };

        for (var field in baseModel)
            this[field] = baseModel[field];

        this.customConstructor(options);

        baseModel.action = this.action;
        if (options && !nge.Mlm.Transport.Helper.objectsEqual(baseModel, this)) {
            console.error('Model Error: not equal requests!');
            console.log('From client or server:');
            console.log(nge.Lib.Helper.jsObjClone(baseModel));
            console.log('From model:');
            console.log(nge.Lib.Helper.jsObjClone(this));
            console.log('Diff map:');
            console.log(nge.Lib.SelfCheckTools.deepDiffMapper.map(this, baseModel, undefined, true));
            console.log('--------------');
        }
    };
});



nge.Mlm.Transport.Service = function () {

    var _mapper;
    var _lastCall = 0;
    var _query = [];
    var _sesId;

    /**
     * Инициализация
     * 
     * @returns {Boolean}
     */
    this.init = function () {
        _mapper = nge.App.getInstance('Mlm.Transport.Mapper');
        _mapper.init();

        return true;
    };

    this.reconnect = function () {
        _mapper.reconnect();
    };

    this.close = function () {
        _mapper.close();
    };

    /**
     * Получение сообщения и генерация соответствующего события
     * 
     * @param {mixed} data
     * @returns {Boolean}
     */
    this.receive = function (data) {
        //обработка единичной модели
        if (Object.prototype.toString.call(data) !== '[object Array]') {
            _fire(data);
            return true;
        }

        //обработка коллекции моделей
        for (var k in data) {
            _fire(data[k]);
        }

        return true;
    };

    this.setSESID = function (sesId) {
        _sesId = sesId;
    };

    /**
     * Складываем модель в хранилище
     * 
     * @param {nge.Mlm.Transport.Model} model
     * @returns {Boolean}
     */
    this.store = function (model) {
        if (!model.sesId)
            model.sesId = _sesId;

        var decorator = new nge.Mlm.Transport.Decorator();
        decorator.toServer(model);
        _query.push(model);
        this.chkStorage();
        return true;
    };

    /**
     * Проверка очереди и отправка пакетов
     * 
     * @returns {Boolean}
     */
    this.chkStorage = function () {
        if (_query.length === 0)
            return false;

        if (nge.Lib.Time.get() < _lastCall + nge.Cfg.Main.sendDelay)
            return false;

        _lastCall = nge.Lib.Time.get();

        switch (nge.Cfg.Main.sendQueryMode) {
            case 'all':
                _sendAll();
                break;
            case 'single':
                _sendSingle();
                break;
            default:
                _sendSingle();
        }
    };

    this.clearQuery = function () {
        _query = [];
        return true;
    };

    /**
     * Отправка первого пакета из очереди
     * @returns {Boolean}
     */
    var _sendSingle = function () {
        var data = _query.shift();

        var res = _mapper.send(data);
        if (!res)
            _query.unshift(data);

        return true;
    };

    /**
     * отправка всей очереди
     * @returns {Boolean}
     */
    var _sendAll = function () {
        var data = _query;
        if (_query.length === 1)
            data = data[0];
        _query = [];

        _mapper.send(data);
        return true;
    };

    /**
     * Генерация события
     * 
     * @param {nge.Mlm.Transport.Model} message
     * @returns {Boolean}
     */
    var _fire = function (message) {
        /*if (!_validate(message))
         return false;*/

        //error
        if (message.data && message.data.errorCode) {
            var code = message.data.errorCode;
            var description = message.data.description;

            console.warn(code, description);
            nge.userFatalErrorHTML(code, description);
            return false;
        }

        var decorator = new nge.Mlm.Transport.Decorator();
        var model = decorator.toFront(message);

        nge.observer.fire('transportMessage.common', model);
        nge.observer.fire('transportMessage.' + model.action, model);

        return true;
    };

    /**
     * валидация пакета
     * @param {nge.Mlm.Transport.Model} message
     * @returns {Boolean}
     */
    var _validate = function (message) {
        var validator = new nge.Mlm.Transport.Validator();
        var pass = validator.validate(message);

        if (!pass) {
            var error = {code: 'transport validate'};
            log(error);
        }

        return pass;
    };
};



nge.Mlm.Transport.Validator = function () {

    /**
     * валидация пакета
     * @param {Mlm.Transport.Model} p
     * @returns {Boolean}
     */
    this.validate = function (p) {
        if (
                _validateAction(p) &&
                _validateResult(p) &&
                _validateData(p) &&
                _validateErrors(p)
                )
            return true;
        return false;
    };

    /**
     * валидация действия
     * @param {Mlm.Transport.Model} p
     * @returns {Boolean}
     */
    var _validateAction = function (p) {
        if (
                typeof p.action === 'string'
                )
            return true;
        return false;
    };

    /**
     * валидация результата
     * @param {Mlm.Transport.Model} p
     * @returns {Boolean}
     */
    var _validateResult = function (p) {
        if (
                typeof p.result !== 'undefined' &&
                (p.result === 0 || p.result === 1)
                )
            return true;
        return false;
    };

    /**
     * валидация основных данных
     * @param {Mlm.Transport.Model} p
     * @returns {Boolean}
     */
    var _validateData = function (p) {
        if (
                typeof p.data === 'object'
                )
            return true;
        return false;
    };

    /**
     * валидация ошибок
     * @param {Mlm.Transport.Model} p
     * @returns {Boolean}
     */
    var _validateErrors = function (p) {
        if (
                typeof p._errors === 'object' &&
                (p.result === 1 || Object.keys(p._errors).length !== 0)
                )
            return true;
        return false;
    };
};


/**
 * Namespace for Mlm Tween Manager
 * @namespace Mlm.TweenManager
 * @memberof! Mlm
 */
nge.Mlm.TweenManager = {};



/**
 * @class
 * @classdesc This is a description of the TweenManager.Controller class.
 * @memberof! Mlm.TweenManager
 */
nge.Mlm.TweenManager.Controller = class TweenManager {
    constructor() {
        this.custom = new nge.Lib.Tweens();
        this._subscribe();
    }
    _subscribe() {
        if(this._subscribed)
            return;
        nge.observer.add('cyclicUpdate', () => {
            nge.Mlm.TweenManager.Controller.update(nge.Lib.Time.get());
        }, false, true);

        nge.observer.add('StatesManager.create.start', () => {
            nge.Mlm.TweenManager.Controller.removeAll();
        }, false, true);

        this._subscribed = true;
    }
    add(obj, custom) {
        if(custom)
            return this.custom.add(obj);
        else
            return new nge.Mlm.TweenManager.Tween(obj);
    }
    static update(time) {
        TWEEN.time = time;
        TWEEN.update(time);
    }
    static removeAll() {
        TWEEN.removeAll();
    }
    static spritesAnimation(atlasesNum, atlasesName, image, duration) {
        const frames = [];

        for (let index = 0; index < atlasesNum; index++) {
            const spritesheet = nge.wrap.cache.getSpritesheet(atlasesName + index);
            for (let i = 0; i < spritesheet.textures.length; i++) {
                frames.push(spritesheet.textures[i]);
            }
        }

        const tween = nge.tween.add({x: 0});
        tween.to({x: frames.length - 1}, duration);
        tween.onUpdateCallback(function (context, time, tweenData) {
            const frameIndex = ~~(tweenData.percent * tweenData.vEnd.x);
            image.loadTexture(frames[frameIndex]);
        });
        tween.onComplete.add(function() {
            image.loadTexture(frames[frames.length - 1]);
        }, true);
        return tween;
    }
};

TWEEN.now = function() {
    return this.time;
};



/**
 * @class
 * @classdesc This is a description of the TweenManager.Tween class.
 * @memberof! Mlm.TweenManager
 */

nge.Mlm.TweenManager.Tween = class {
    constructor(target) {
        this.target = target;
        this.timeline = [];
        this.current = 0;
        this.tween = new TWEEN.Tween(target);
        this.tween._valuesEnd = null;
        this.onComplete = new nge.Lib.Signal();
        this.onStart = new nge.Lib.Signal();
        this.onLoop = new nge.Lib.Signal();
        this.onRepeat = new nge.Lib.Signal();
        this.isPaused = false;

        this.tween.onStart(() => {
            this.onStart.dispatch();
        });

        this.tween.onLoop(() => {
            this.onLoop.dispatch();
        });

        this.tween.onComplete(() => {
            if(this.current < this.timeline.length)
                return this.next();
            this.onComplete.dispatch();
        });
    }
    get isRunning() {
        return this.tween._isPlaying;
    }
    get timeScale() {
        return this.tween._timeScale;
    }
    set timeScale(value) {
        this.tween._timeScale = value;
    }
    to(properties, duration, ease, autoStart, delay, repeat, yoyo) {
        this.timeline.push({
            mode: 'to',
            properties: properties,
            duration: duration,
            ease: ease,
            delay: delay,
            repeat: repeat === -1 ? Number.MAX_VALUE: repeat,
            yoyo: yoyo
        });

        if(autoStart)
            this.tween = this.start().tween;
        return this;
    }
    from(properties, duration, ease, autoStart, delay, repeat, yoyo) {
        this.timeline.push({
            mode: 'from',
            properties: properties,
            duration: duration,
            ease: ease,
            delay: delay,
            repeat: repeat === -1 ? Number.MAX_VALUE: repeat,
            yoyo: yoyo
        });

        if(autoStart)
            this.tween = this.start().tween;   
        return this;
    }
    loop(value) {
        for(let i = 0; i < this.timeline.length; i++)
            this.timeline[i].repeat = value ? Number.MAX_VALUE : 0;
        this.tween.repeat(value ? Number.MAX_VALUE : 0);
    }
    onUpdateCallback(fn, ctx) {
        this.tween.onUpdate((progress) => {
            const tweenData = {percent: progress, value: progress, vStart: this.tween._valuesStart, vEnd: this.tween._valuesEnd};
            fn.call(ctx || this, this, progress, tweenData);
        });
        return this;
    }
    next() {
        if(this.timeline.length === 0) {
            console.error('timeline is empty');
            return this;
        }

        if(this.timeline.length === this.current) {
            console.error('current overflow');
            return this;
        }

        const ev = this.timeline[this.current++];
        if(ev.properties && ev.duration) {
            if(ev.mode === 'to')
                this.tween = this.tween.to(ev.properties, ev.duration);
            else
                this.tween = this.tween.from(ev.properties, ev.duration);
        }
        if(ev.ease) {
            this.tween = this.tween.easing(ev.ease);
        }
        if(ev.delay) {
            this.tween = this.tween.delay(ev.delay);
        }
        if(ev.repeat) {
            this.tween = this.tween.repeat(ev.repeat);
        }
        
        this.tween = this.tween.yoyo(ev.yoyo);

        
        this.tween = this.tween.start();
        return this;
    }
    start() {
        this.current = 0;
        this.next();
        return this;
    }
    stop(complete) {
        this.current = this.timeline.length;
        if(complete)
            this.onComplete.dispatch();
        this.tween.stop();
        return this;
    }
    chain() {
        this.tween.chain(...arguments);
        return this;
    }
    interpolation(interpolation) {
        this.tween.interpolation(interpolation);
        return this;
    }
};

nge.Mlm.TweenManager.Tween.Easing = TWEEN.Easing;



