        {"type": 1, "name": "playareaBgContainer", "alpha": "1", "contents": [
          {"type": 0, "name": "playareaBg", "assetKey": "playareaBg", "x": "0", "y": "0", "alpha": "1"}
        ]}
      ]
    }
  };
};



