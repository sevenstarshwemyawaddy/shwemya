});



nge.App[nge.appNS].Com = {};



nge.App[nge.appNS].Com.AutospinSimple = {};



nge.App[nge.appNS].Com.AutospinSimple.Controller = nge.Com.Base.extend(function () {

    var _created;
    var _self = this;
    var _inProgress;
    var _icon;

    var _balanceReceived;
    var _balanceRequested;

    var _cycleComplete;
    var _isGambleTakingStop;
    var _takingFinished;
    var _timer;

    this.spinEvent = 'slotMachine.spinCommand';
    this.timeDelayForSpin = 500;
    this.showAutoIcon = true;

    this.create = function () {
        this.createDefault();

        if (!_created) {
            _subscribe();
            _created = true;
        }

        _cycleComplete = true;
        _isGambleTakingStop = false;
        _takingFinished = false;
        _inProgress = false;
        _balanceReceived = true;
        _balanceRequested = true;
        _icon = nge.findOne('.autoIcon');

        _buttonsSwitch(false);

        return true;
    };

    var _off = function () {
        _buttonsSwitch(false);
        var slotMachineSpinning = nge.localData.get('slotMachineSpinning');
        if (!slotMachineSpinning && _cycleComplete && _isGambleTakingStop) {
            _isGambleTakingStop = false;
        }
    };

    var _on = function () {
        _buttonsSwitch(true);

        var slotMachineSpinning = nge.localData.get('slotMachineSpinning');
        var freespinInProgress = nge.localData.get('freespin.inProgress');
        var respinInprogress = nge.localData.get('respin.inProgress');
        var jackpotInProgress = nge.localData.get('jackpot.inProgress');
        var jackpotCanPlayRequested = nge.localData.get('jackpot.jackpotCanPlayRequested');

        if (!slotMachineSpinning && _cycleComplete && !freespinInProgress && !jackpotInProgress && !jackpotCanPlayRequested && !respinInprogress) {
            nge.observer.fire('balanceRequest');
        }
    };

    var _buttonsSwitch = function (vis) {

        if(!nge.Lib.Helper.mobileAndTabletCheck() && _self.showAutoIcon)
            _icon.visible = vis;
        
        nge.localData.set('autospin', vis);
        _inProgress = vis;
        nge.observer.fire('buttons.enable.autoSpin');

        var slotMachineSpinning = nge.localData.get('slotMachineSpinning');

        if (!slotMachineSpinning && _cycleComplete)
            _spin(vis);
    };

    var _spin = function (autospinOn) {
   
        if (!_inProgress)
            return false;

        var freespin = nge.localData.get('freespin.inProgress');
        var respinInprogress = nge.localData.get('respin.inProgress');
        var isRespinState = nge.localData.get('stateEqualRespins');
        if (isRespinState || freespin || respinInprogress)
            return false;
        var lastWin = nge.localData.get('slotMachine.slotWin.totalWin');
        if (!lastWin || parseFloat(lastWin) === 0) {
            _takingFinished = true;
        } else if (autospinOn && !_balanceReceived && !_balanceRequested) {
            nge.observer.fire('gamble.take');
        }
    };

    var _cycleCompleteHandler = function () {
        var sp = nge.localData.get('autospin');
        var spinning = nge.localData.get('slotMachineSpinning');
        _cycleComplete = true;
    };

    var _spinStartHandler = function () {
        _balanceReceived = false;
        _cycleComplete = false;
        _takingFinished = false;
        _balanceRequested = false;
    };

    this.setTakingFinished = function(val){
        _takingFinished = val;
    };

    var _elementsChangeActivityByNames = function (names, active, disFrame) {
        if (typeof (disFrame) === 'undefined')
            disFrame = 3;

        var arrLength = names.length;
        for (var k = 0; k < arrLength; k++) {
            var selector = names[k];
            var el = nge.findOne(selector);

            if (el) {
                if (!active && el.disable) {
                    //button !active
                    el.disable(disFrame);
                } else if (active && el.enable) {
                    //button active
                    el.enable();
                } else {
                    //not a button
                    el.visible = active;
                }
            }
        }
    };

    var _gameTakingStopHandler = function () {
        _isGambleTakingStop = true;
        _takingFinished = true;
    };

    var _balanceResponseHandler = function () {
        _balanceReceived = true;

        if (_takingFinished) {
            if (nge.localData.get('autospin')) {

                if(nge.localData.get('jackpot.canPlay') || nge.localData.get('jackpot.checkPlay')) {

                    var tableOrMobileFlag = nge.Lib.Helper.mobileAndTabletCheck();

                    if (tableOrMobileFlag) 
                        nge.observer.fire('buttons.insidePress', 'autoSpinMobile');
                    else
                        nge.observer.fire('buttons.insidePress', 'auto');

                    nge.observer.fire('buttons.disable.auto', null, 5);
                    return;
                }

                _timer = nge.rafSetTimeout(function () {
                    nge.observer.fire(_self.spinEvent);
                    _self.timeDelayForSpin = 500;
                }, _self.timeDelayForSpin);
            }
            /*
             http://jira.servupdate.com/browse/JSCLIENT-816
             bugfix: При больших задержках BalanceResponse у игрока был шанс отключить
             Auto режим, без enable spin кнопки. Тем самым игра не позволяет игроку вручную стартовать.
             Данное исправление проверяет, что в конце игры autospin отключен, и заново енеблит кнопку spin
             Если это так.
             */
            else
                nge.observer.fire('buttons.restore');
        }
    };

    var _deleteSpinTimeOut = function () {
        nge.rafClearTimeout(_timer);
    };

    var _onNoBalance = function () {
        if (nge.localData.get('autospin')) {
            var tableOrMobileFlag = nge.Lib.Helper.mobileAndTabletCheck();

            if (tableOrMobileFlag) {
                nge.observer.fire('buttons.insidePress', 'autoSpinMobile');
                nge.observer.fire('buttons.restore');
                nge.rafSetTimeout(function () {
                    nge.observer.fire('buttons.enable.spin');
                }, 20);


            } else {
                nge.observer.fire('buttons.insidePress', 'auto');
                nge.observer.fire('buttons.enable.all');
            }
        }
        /*
        http://jira.servupdate.com/browse/JSCLIENT-1807
        bugfix: Защита на случай выключения кнопки AUTO до срабатывания логики нехватки баланса.
         */
        else
            nge.observer.fire('buttons.restore');
    };

    var _onTransportClose = function () {
        nge.localData.set('autospin', false);
    };

    var _balanceRequestHandler = function(){
        _balanceRequested = true;
    };

    var _subscribe = function () {
        nge.observer.add('autospinSimple.deletSpinTimeout', _deleteSpinTimeOut);
        nge.observer.add('autospinSimple.on', _on);
        nge.observer.add('autospinSimple.off', _off);

        nge.observer.add('winlines.animateByOne.cycleComplete', _spin);
        nge.observer.add('winlines.animateByOne.cycleComplete', _cycleCompleteHandler);
        
        nge.observer.add('slotMachine.spinStart', _spinStartHandler);
        nge.observer.add('gamble.taking.stop', _gameTakingStopHandler);
        nge.observer.add('balance.amount', _balanceResponseHandler);
        nge.observer.add('balanceRequest', _balanceRequestHandler);
        nge.observer.add('slotMachine.spinFailed.noBalance', _onNoBalance);
        nge.observer.add('Transport.close', _onTransportClose);
    };
});



