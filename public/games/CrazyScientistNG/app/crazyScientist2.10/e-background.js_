nge.App[nge.appNS].Tpl.Groups.UI_v3.Blue = {};



nge.App[nge.appNS].Tpl.Groups.UI_v3.Blue.BetSettings = function () {
    var _tpl = nge.App[nge.appNS].Tpl.Groups.BetSettings();
    _tpl.styles['.sliderMinMax'].style.fill = '#CBEBFF';
    _tpl.styles['.settingName'].style.fill = '#FFFFFF';
    _tpl.styles['.betContainerName'].style.fill = '#FFFFFF';
    _tpl.styles['.betContainerValue'].style.fill = '#ffffff';
    _tpl.styles['.sliderValue'].style.fill = '#FFFFFF';
    _tpl.styles['.sliderTooltipValue'].style.fill = '#000000';
    return _tpl;
};



nge.App[nge.appNS].Tpl.Groups.UI_v3.Blue.ScrollbarVertical = function (imagesPath) {
    var _scroll = nge.App[nge.appNS].Tpl.Groups.ScrollbarVertical(imagesPath);

    var _scrollBg = _scroll.assets.contents.filter(function (value) {
        return value.fullPath.indexOf ('scroll_bg') !== -1;
    })[0];
    _scrollBg.fullPath = _scrollBg.fullPath.replace('scroll_bg', 'scroll_bg1');

    var _scrollTouch = _scroll.assets.contents.filter(function (value) {
        return value.fullPath.indexOf ('scroll_touch') !== -1;
    })[0];
    _scrollTouch.fullPath = _scrollTouch.fullPath.replace('scroll_touch', 'scroll_touch1');

    return _scroll;
};



nge.App[nge.appNS].Tpl.Groups.UI_v3.Blue.Tabs = function () {
    var _tpl = nge.App[nge.appNS].Tpl.Groups.Tabs();
    _tpl.styles['^headersContainer .active .tabHeaderText'].style.fill = '#0092E8';
    return _tpl;
};



nge.App[nge.appNS].Tpl.Groups.UI_v3.Blue.Ui = function () {

