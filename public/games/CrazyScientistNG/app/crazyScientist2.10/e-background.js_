nge.Com.PopUp.Model = function (param) {
    if (!param)
        param = {};

    return {
        'popUpType': nge.Lib.Helper.recursiveGet('popUpType', param, 'message'), //'confirm' || 'message'
        'name': nge.Lib.Helper.recursiveGet('name', param, 'popUpWrapper'),
        'class': nge.Lib.Helper.recursiveGet('class', param, false),
        'title': nge.Lib.Helper.recursiveGet('title', param, 'Message'),
        'text': nge.Lib.Helper.recursiveGet('text', param, ''),
        'submitButtonText': nge.Lib.Helper.recursiveGet('submitButtonText', param, 'YES'),
        'cancelButtonText': nge.Lib.Helper.recursiveGet('cancelButtonText', param, 'NO'),
        'x': nge.Lib.Helper.recursiveGet('x', param, 0),
        'y': nge.Lib.Helper.recursiveGet('y', param, 0),
        'onSubmit': nge.Lib.Helper.recursiveGet('onSubmit', param, false),
        'onCancel': nge.Lib.Helper.recursiveGet('onCancel', param, false)
    };
};



nge.Com.PopUp.View = Class.extend(function () {
    var _self;
    var _popUpIndex = 0;

    this.show = function (data) {
        _chkSelf(this);

        var model = new nge.Com.PopUp.Model(data);
        model.id = 'popUpWrapper' + _popUpIndex;
        model.popUpIndex = _popUpIndex;
        model.onCancel = _createAction(_popUpIndex, model.onCancel);
        model.onSubmit = _createAction(_popUpIndex, model.onSubmit);
        var tpl = this.getInstance('Tpl', false, model);
        nge.objects.create(tpl.objects.contents[0]);

        _popUpIndex++;
    };

    this.closePopup = function (obj) {
        var tween = nge.tween.add(obj);
        tween.to({
            alpha: 0
        }, 200).onComplete.add(function () {
            obj.destroy(true);
        });
        tween.start();
    };

    var _chkSelf = function (context) {
        if (!_self)
            _self = context;
    };

    var _createAction = function (popUpIndex, callback) {

        var popupDestroy = function () {
            var popup = nge.find('#popUpWrapper' + popUpIndex);
            _self.closePopup(popup);
        };

        var result = function () {
            popupDestroy();

            if (callback) {
                callback();
            }
        };

        return result;
    };
});



