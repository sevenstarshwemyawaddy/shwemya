                        {type: mt.objects.BUTTON, id: 'gambleActionBlack', 'class': 'simpleButton', x: 1390, y: 640, anchorX: 0.5, anchorY: 0.5, 'assetKey': 'gambleBlack1', 'action': 'function () { nge.observer.fire("buttons.pressCommand", "gambleActionBlack"); }'},
                        {type: mt.objects.IMAGE, id: 'gamble-hc-0', x: 955, y: 340, anchorX: 0.5, anchorY: 0.5, 'assetKey': 'gambleCardSmallBlack'},
