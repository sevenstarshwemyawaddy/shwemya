/* global nge */

nge.App[nge.appNS].Com.Buttons= {};


/* global nge */

nge.App[nge.appNS].Com.Buttons.UI_v3= {};



nge.App[nge.appNS].Com.Buttons.UI_v3.Cfg = nge.App.RiverGameBase.Com.Buttons.UI_v3.Cfg.extend(function () {
    // adding drones buttons 
    for (let i = 1; i < 7; i++) {
        const name = 'dron' + i;
        const nonPixelPerfect = false;
        
        this.play[name] = { name, nonPixelPerfect };
    }

    //adding flask buttons
    for (let i = 1; i < 7; i++) {
        const name = 'pg10' + i;
        const nonPixelPerfect = false;
        
        this.play[name] = { name, nonPixelPerfect };
    }


});



/* global nge */

nge.App[nge.appNS].Com.Buttons.Mobile = {};



/* global Class, nge */

nge.App[nge.appNS].Com.Buttons.Mobile.Cfg = nge.App.RiverGameBase.Com.Buttons.Mobile.Cfg.extend(function () {
    // adding drones buttons 
    for (let i = 1; i < 7; i++) {
        const name = 'dron' + i;
        const nonPixelPerfect = false;
        
        this.params[name] = { name, nonPixelPerfect };
    }

    //adding flask buttons
    for (let i = 1; i < 7; i++) {
        const name = 'pg10' + i;
        const nonPixelPerfect = false;
        
        this.params[name] = { name, nonPixelPerfect };
    }
});



nge.App[nge.appNS].Com.Freespin = {};



nge.App[nge.appNS].Com.Freespin.Controller = nge.App.RiverGameBase.Com.Freespin.Controller.extend(function () {

    const ROTATION_AMOUNT = Math.PI * 2;

    let _rotationTween = null;

    const _gamePopupCallbacks = {
        'start': (callback = () => {}) => {
            
            const onComplete = () => {
                nge.observer.fire('background.cover.hide');
                callback();
                nge.observer.fire('cs2.popup.hided');
                nge.observer.fire('freespin.startPopup.hided');
                nge.observer.fire('buttons.disable.all');
                this._reset();
            };

            const onStart = () => {
                const popup = _popupObjects['^startFreeSpinsPopupContainer']; 
                const freespins = nge.localData.get('pickupBonusGame.stage1.bonusItem.value');
                const multiplier = nge.localData.get('pickupBonusGame.stage2.bonusItem.value');

                _popupObjects['^multiplierNumber'].text = multiplier + 'X';
                _popupObjects['^freeSpinNumber'].text = freespins;
                popup.visible = true;

                nge.observer.fire('background.cover.show');
            };
            nge.observer.fire('sound.popup.won');
            this._showPopup('^startFreeSpinsPopupContainer', onStart, onComplete);
        },
        'inside': (callback = () => {}) => {
            nge.observer.fire('buttons.disable.all');
            nge.observer.fire('cs2.buttons.stop.showDisabled');

            const onComplete = () => {
                nge.observer.fire('background.cover.hide');
                callback();
                this._reset();
                nge.localData.set('spaceHandler.isEnable', true);
                nge.observer.fire('spaceHandler.on');
                nge.observer.fire('cs2.popup.hided');
            };

            const onStart = () => {
                const { lineWinAmounts } = nge.localData.get('slotMachine.slotWin');
                let freespins = nge.localData.get('pickupBonusGame.stage1.bonusItem.value');

                const bonusLine = lineWinAmounts.filter(item => item.bonusName === 'FreeSpins')[0];

                if(bonusLine)
                    freespins = bonusLine.params.freeSpins;
                
                const popup = _popupObjects['^startBonusInBonusPopupContainer']; 
                _popupObjects['^sBinBText1'].text = freespins;
                popup.visible = true;
                nge.observer.fire('background.cover.show');
            };
            nge.observer.fire('sound.popup.won');
            this._showPopup('^startBonusInBonusPopupContainer', onStart, onComplete);

        }, // 
        'finish': (callback = () => {}) => {
            nge.observer.fire('buttons.disable.all');
            nge.observer.fire('cs2.buttons.stop.showDisabled');
        
            const onComplete = () => {
                nge.observer.fire('background.cover.hide');
                callback();
               
                this._reset();
                nge.observer.fire('cs2.finishPopup.hided');
            };

            const onStart = () => {
                const popup = _popupObjects['^finalPopupContainer']; 
                const text = _popupObjects['^fPWin'];
                const totalBonusWin = nge.localData.get('slotMachine.totalBonusWin');
                const totalCoins = nge.Lib.Money.toCoinsInt(totalBonusWin);
               
                nge.localData.set('freespin.totalWin', totalBonusWin);
                
                if(popup.children[3])
                    popup.children[3].visible = parseInt(totalCoins, 10) > 0;
    
                text.text = totalCoins;
                popup.visible = true;

                nge.observer.fire('background.cover.show');
            };
            nge.observer.fire('sound.popup.finish');
            this._showPopup('^finalPopupContainer', onStart, onComplete);
        }   
    };

    const _popupObjects = {
        '^startFreeSpinsPopupContainer': null,
        '^finalPopupContainer': null,
        '^startBonusInBonusPopupContainer': null,
        '^multiplierNumber': null,
        '^freeSpinNumber': null,
        '^fPWin': null,
        '^sBinBText1': null,
        '^popupLight': null,
        '^fPTextCongratulationsFinal': null
    };

    this._determineLightName = popupName => {
        return '^popupLight';
    };

    this.create = () => {
        this.super.create();

        this._prepareLinks();
        this._preparePopups();
        this._reset();
    };

    this._showPopup = (selector, onStart, onComplete) => {
        const popup = _popupObjects[selector];
        const scaleTween = this._makeScaleHideTween(popup, onComplete);
        const rotationSelector = this._determineLightName(selector);
        const rotationTween = this._makeRotationTween(rotationSelector);
        const hideLight = this._makeHideLightTween(rotationSelector);
        
        const showPopup = this._makeShowPopupTween(popup, onStart, () => 
            nge.rafSetTimeout(() => { 
                hideLight.start();
                scaleTween.start();
            }, 5000));
    
        showPopup.start();
        rotationTween.start();
    };

    this._makeHideLightTween = selector => {
        const obj = _popupObjects[selector];
        const tween = nge.tween.add(obj).to({ alpha: 0 }, 400, null, false);
        obj.alpha = 1;
        return tween;
    };

    this._makeShowPopupTween = (obj, onStart, onComplete) => {
        const tween = nge.tween.add(obj.scale).to({ x: 1, y: 1 }, 300, null, false);
        tween.onComplete.add(onComplete);
        tween.onStart.add(onStart);
        obj.visible = true;
        obj.alpha = 1;
        obj.scale.set(0);
        return tween;
    };

    this._makeScaleHideTween = (obj, onComplete) => {
        const easingFirst = nge.Lib.Tween.Easing.Quadratic.Out;
        const easingSecond = nge.Lib.Tween.Easing.Quadratic.In;
        const tween = nge.tween.add(obj.scale).to({ x: 1.2, y: 1.2 }, 100, easingFirst, false).
            to({ x: 0, y: 0 }, 300, easingSecond);

        let second = false;
        let curr = 0;
    
        tween.onUpdateCallback((t, v) => {
            if(v < curr)
                second = true;
                
            curr = v;
    
            if(second)
                obj.alpha = 1 - v; 
        });
        
        tween.onComplete.add(onComplete);
        return tween;
    };

    this.finishText = function () {
        var totalWin = parseFloat(nge.localData.get('slotMachine.totalBonusWin')).toFixed(2);
        var totalWinCoins = nge.Lib.Money.toCoinsInt(totalWin);
        return 'Feature win\n' + totalWinCoins + ' credits';
    };

    this._makeAlphaTween = (obj) => {
        const tween = nge.tween.add(obj).to({ alpha: 0 }, 400, null, false);
        return tween;
    };

    this._makeRotationTween = (selector) => {
        const obj = _popupObjects[selector];
        obj.rotation = 0;

        _rotationTween = nge.tween.add(obj).to({ rotation: ROTATION_AMOUNT }, 10000, null, false, 0, -1);
    
        return _rotationTween;
    };

    this._stopRotationTween = () => {
        _rotationTween && _rotationTween.stop(true);
        _rotationTween = null;
    };

    this.animatePopup = (options, callback) => {
        _gamePopupCallbacks[options.freespinState](callback);
    };

    this._prepareLinks = () => {
        for(let selector in _popupObjects)
            _popupObjects[selector] = nge.findOne(selector);
    };

    this._reset = () => {
        const startPopup = _popupObjects['^startFreeSpinsPopupContainer'];
        startPopup.alpha = 1;
        startPopup.scale.set(0);
        _popupObjects['^finalPopupContainer'].visible = false;
        _popupObjects['^startBonusInBonusPopupContainer'].visible = false;

        this._stopRotationTween();
    };

    this.freespinStartHandler = () => {
        this.setSpinType();
    };

    this.subscribe = () => {
        this.super.subscribe();

        nge.observer.add('freespin.start', this.freespinStartHandler);
    };

    this._preparePopups = () => {
        this._preparePopup(_popupObjects['^startFreeSpinsPopupContainer']);
        this._preparePopup(_popupObjects['^finalPopupContainer']);
        this._preparePopup(_popupObjects['^startBonusInBonusPopupContainer']);
    };

    this._preparePopup = popup => {
        popup.x += popup.children[0].x;
        popup.y += popup.children[0].y;

        popup.children.forEach(child => {
            child.x -= popup.x;
            child.y -= popup.y;
        });
    };
});



nge.App[nge.appNS].Com.Load = {};



nge.App[nge.appNS].Com.Load.Cfg = nge.App.RiverGameBase.Com.Load.Cfg.extend(function () {
    var _cssPath = nge.appPath + 'css/fonts/';
    var _bitmapsPath = nge.appPath + 'img/atlases/fonts/';

    this.fonts['myriadprobold'] = _cssPath + 'myriadprobold';
    this.fonts['futuraextrablackcon'] = _cssPath + 'futuraextrablackcon';
    this.fonts['molot'] = _cssPath + 'molot';
    this.fonts['verdanabold'] = _cssPath + 'verdanabold';
    this.fonts['dezenproheavy'] = _cssPath + 'dezenproheavy';
    this.fonts['calibribold'] = _cssPath + 'calibribold';
    this.fonts['adonais'] = _cssPath + 'adonais';
    this.fonts['franclingothicm'] = _cssPath + 'franclingothicm';
    this.fonts['futuraptmedium'] = _cssPath + 'futuraptmedium';
    this.fonts['segoe_ui_black'] = _cssPath + 'segoe_ui_black';

    this.fonts.notoSansSemiCondensedBlack = _cssPath + 'notoSansSemiCondensedBlack';
    this.fonts.notoSansSemiCondensedSemiBold = _cssPath + 'notoSansSemiCondensedSemiBold';

    this.atlasesGroups = ['atlases', 'atlases_play', 'atlases_help'];


    this.bitmapFonts = {
        'winlineFont' : {type: mt.assets.BITMAP_FONT, textureURL: _bitmapsPath + 'winlineFont.png', bitmapFont: _bitmapsPath + 'winlineFont.fnt'},
        'bigWinFont' : { type: mt.assets.BITMAP_FONT, textureURL: _bitmapsPath + 'bigWinFont.png', bitmapFont: _bitmapsPath + 'bigWinFont.fnt'},
        'jackpot_font': { type: mt.assets.BITMAP_FONT, textureURL: _bitmapsPath + 'jackpot_font.png', bitmapFont: _bitmapsPath + 'jackpot_font.fnt' }
    };
});



nge.App[nge.appNS].Com.PickupBonusGame = {};



nge.App[nge.appNS].Com.PickupBonusGame.AnimationHelper = nge.Com.Base.extend(function () {
    this.singleton = true;
    
    let _cache = null; 
    let _selectedPickIndex = -1;
    let _itemCustomAnimIndex = 0;
    let _stopAnimation = false;
    let _stage1InProgress = false;
    let _stage2InProgress = false;

    var _quality = 1;

    const _tweensCache = {};

    const _stopTween = name => {
        _tweensCache[name] && _tweensCache[name].stop(true);
    };

    const _runAnimationSeq = name => {
        if(!_callbacks[name])
            return false;
        
        _callbacks[name]();

        return true;
    }; 

    this.create = () => {
        _quality = nge.assets.getQualityFactor();

        _selectedPickIndex = -1;
        _stage1InProgress = false;
        _stage2InProgress = false;

        _cache = this.getInstance('ObjectsCache');
        _cache.reset();
    };
    
    this.run = name => {    
        _runAnimationSeq(name); 
    };

    this.stopAnimation = name => _stopTween(name);

    this.stopAllAnimation = () => {
        for(let name in _tweensCache)
            _stopTween(name);
    };

    const _callbacks = {
        showStartPopup: () => {
            const easing = nge.Lib.Tween.Easing.Back.Out;
            const startPopup = _cache.get('startPickBonusPopupContainer');
            startPopup.alpha = 1;
            
            nge.observer.fire('pickBonus.startPopup.show');

            const tween = _makeTween({
                name:'showStartPopup',
                duration: 300,
                to: { x: 1, y: 1 },
                easing,
                sequence: ['rotateLight', 'hideStartPopup'],
                obj: startPopup.scale
            });
            startPopup.visible = true;
            nge.observer.fire('sound.popup.start');
            tween.start();
        },

        rotateLight: () => {
            const obj = _cache.get('popupLight');
            obj.rotation = 0;
            obj.alpha = 1;

            const tween = _makeTween({
                name:'rotateLight',
                duration: 10000,
                to: { rotation: Math.PI * 2 },
                repeat: -1,
                obj: obj
            });
            tween.start();
        },

        fadeOffPopupLight: () => {
            const light = _cache.get('popupLight');

            const tween = _makeTween({
                name:'fadeOffPopupLight',
                duration: 400,
                to: { alpha: 0 }, 
                obj: light
            });
            
            tween.start();
        },

        hidePopupByScaleAndAlpha: () => {
            const easing = nge.Lib.Tween.Easing.Quadratic.Out;
            const popup = _cache.get('startPickBonusPopupContainer');
            const maxScale = popup.scale.x * 1.2;

            const tween = _makeTween({
                name:'hidePopupByScaleAndAlpha',
                duration: 100,
                easing: easing,
                to: { x: maxScale, y: maxScale },
                sequence: ['stopLightTween', 'hideSlotMachineContainer', 'startPopupHided'],
                obj: popup.scale,
                decorateObj: popup
            });

            tween.start();
        },

        hideStartPopup: () => {         
            nge.rafSetTimeout(() => {
                nge.observer.fire('buttons.disable.all');
                _runAnimationSeq('hidePopupByScaleAndAlpha');
                _runAnimationSeq('fadeOffPopupLight');
            }, 3000);
        },

        startPopupHided: () => {
            nge.observer.fire('pickBonus.startPopup.hided');
        },

        stopLightTween: () => _stopTween('rotateLight'),

        hideSlotMachineContainer: () => {
            const tween = _makeTween({
                name:'hideSlotMachineContainer',
                duration: 300,
                to: { alpha: 0 },
                obj: _cache.get('slotMachineContainer'),
                sequence: ['showPickGameBg']
            });
            tween.start();
        },

        showPickGameBg: () => {
            const pickGameBgContainer = _cache.get('pickGameBgContainer');
            const pickGameContainer = _cache.get('pickGameContainer');

            let nextStage = nge.localData.get('pickupBonusGame.stage1') ? 'updateInfoText' : 'showFirstStageText';
            const tween = _makeTween({
                name:'showPickGameBg',
                duration: 500,
                to: { alpha: 1 },
                obj: pickGameBgContainer,
                sequence: [nextStage]
            });
            pickGameContainer.visible = true;
            pickGameBgContainer.alpha = 0;
            pickGameBgContainer.visible = true;
            tween.start();
        },       
        
        showFirstStageText: () => {
            const tween = _makeTween({
                name:'showFirstStageText',
                duration: 500,
                to: { alpha: 1 },
                obj: _cache.get('pG1Text'),
                sequence: ['showDrones']
            });
          
            tween.start();
        },
        showDrones: () => {
            for(let i = 1; i < 7; i++){
                const droneContainer = _cache.get('dron'.concat(i, 'Container'));
                let name = 'showDrone'.concat(i);
                let callbackName = (( i + 1 ) < 7) ? 'showDrone'.concat(i + 1) : 'enableDroneButtons';
                
                _callbacks[name] = () => {
                    const tween = _makeTween({
                        name: 'showDrone',
                        duration: 150,
                        to: { alpha: 1 },
                        obj: droneContainer,
                        decorateObj: droneContainer.children[0],
                        sequence: [callbackName]
                    });
                  
                    tween.start();
                };
            }

            _runAnimationSeq('showDrone1');
        },

        hideStageOneText: () => {
            for(let i = 1; i < 7; i++){
                const obj = _cache.get('pG1Win'.concat(i));
                const name = 'pG1Win'.concat(i);
                const next = 'pG1Win'.concat(i + 1);
                _callbacks[name] = () => {
                    const tween = _makeTween({
                        name: 'hideStageOneText',
                        duration: 150,
                        to: { alpha: 0 },
                        obj: obj,
                        sequence: [next]
                    });
                  
                    tween.start();
                };
            }

            _runAnimationSeq('pG1Win1');
        },

        hideDrones: () => {
            for(let i = 1; i < 7; i++){
                const droneContainer = _cache.get('dron'.concat(i, 'Container'));
                let name = 'hideDrone'.concat(i);
                let callbackName = (( i + 1 ) < 7) ? 'hideDrone'.concat(i + 1) : 'updateInfoText';
                
                _callbacks[name] = () => {
                    const tween = _makeTween({
                        name: 'hideDrone',
                        duration: 150,
                        to: { alpha: 0 },
                        obj: droneContainer,
                        decorateObj: droneContainer.children[0],
                        sequence: [callbackName]
                    });
                  
                    tween.start();
                };
            }

            _runAnimationSeq('hideDrone1');
        },

        updateInfoText: () => {
            const freeSpinsNumber = _cache.get('freeSpinsNumber1');
            const multiplierNumber = _cache.get('multiplierNumber1');
            
            freeSpinsNumber.text = nge.localData.get('pickupBonusGame.stage1.bonusItem.value');
            multiplierNumber.text = '?';
            
            _runAnimationSeq('showSecondStageText');
        },

        enableDroneButtons: () => {
            _stopAnimation = false;
            _stage1InProgress = true;   
            _runAnimationSeq('runBorderWaitingAnimation');
            _runAnimationSeq('determineCustomAnimationIndex');
            nge.observer.fire('buttons.drone.enable');
        },

        hideFirstStageText: () => {
            const tween = _makeTween({
                name:'hideFirstStageText',
                duration: 500,
                to: { alpha: 0 },
                obj: _cache.get('pG1Text'),
                sequence: ['hideDrones', 'hideStageOneText']
            });
          
            tween.start();
        },

        finishFirstStage: () => {
            const index = nge.localData.get('pickupBonusGame.stage1.bonusItem.index') || -1;
            _selectedPickIndex = parseInt(index, 10);
            _runAnimationSeq('runPickDroneAnim');
            _runAnimationSeq('showDroneWinAmountText');
            _runAnimationSeq('runBorderPickAnimation');
        },

        showDroneWinAmountText: () => {
            this._updateStageOneWinData();

            const textObj = _cache.get('pG1Win'.concat(_selectedPickIndex));
            textObj.visible = true;

            const tween = _makeTween({
                name: 'showDroneWinAmountText',
                duration: 200,
                obj: textObj,
                to: { alpha: 1 },
                decorateObj: textObj,
                sequence: ['showStageOneOtherWinTexts']
            });

            tween.start();
        },

        clearSelectedIndex: () => {
            _stopAnimation = true;
            _selectedPickIndex = -1;
        },

        runPickDroneAnim: () => {
            const tween = _makeTween({
                name: 'runPickDroneAnim',
                duration: 1000,
                to: { x: 14 },
                obj: { x: 0 },
                repeat: 3,
                sequence: ['hideFirstStageText', 'clearSelectedIndex']
            });
            
            tween.start();

        },

        showStageOneOtherWinTexts: () => {
            let firstIndex = null;

            for(let i = 1; i < 7; i++){
                const name = 'pG1Win'.concat(i);
                delete _callbacks[name];

                if(i === _selectedPickIndex)
                    continue;

                if(!firstIndex)
                    firstIndex = i;

                this._showStageNonWinText(i, 'pG1Win');
            }

            const startName = 'pG1Win'.concat(firstIndex);
            _runAnimationSeq(startName);
        },

        showSecondStageText: () => {
            const tween = _makeTween({
                name:'showSecondStageText',
                duration: 500,
                to: { alpha: 1 },
                obj: _cache.get('pg2Text'),
                sequence: ['showLaterns']
            });
          
            tween.start();
        },

        showLaterns: () => {
            for(let i = 1; i < 7; i++){
                const container = _cache.get('pg10'.concat(i, 'Container'));
                let name = 'showLatern'.concat(i);
                let callbackName = (( i + 1 ) < 7) ? 'showLatern'.concat(i + 1) : 'showStage2InfoText';
                
                _callbacks[name] = () => {
                    const tween = _makeTween({
                        name: 'showLatern',
                        duration: 150,
                        to: { alpha: 1 },
                        obj: container,
                        decorateObj: container.children[0],
                        sequence: [callbackName]
                    });
                  
                    tween.start();
                };
            }

            _runAnimationSeq('showLatern1');
        },

        showStage2InfoText: () => {
            const tween = _makeTween({
                name:'showStage2InfoText',
                duration: 100,
                to: { alpha: 1 },
                obj: _cache.get('pickGameInfo'),
                sequence: ['enableLaternButtons']
            });
          
            tween.start();
        },

        enableLaternButtons: () => {
            nge.observer.fire('buttons.latern.enable');
            _stage2InProgress = true;
            _stopAnimation = false;
            _runAnimationSeq('determineCustomAnimationIndex');
            _runAnimationSeq('runBorderWaitingAnimation');  
        },

        updateStageTwoInfo: () => {
            const multiplierNumber = _cache.get('multiplierNumber1');
            const value = nge.localData.get('pickupBonusGame.stage2.bonusItem.value');
            multiplierNumber.text = value + 'X';
            _runAnimationSeq('runPickLaternAnim');
            _runAnimationSeq('showLaternWinAmountText');
            _runAnimationSeq('runBorderPickAnimation');  
        },

        runPickLaternAnim: () => {
            const tween = _makeTween({
                name: 'runPickLaternAnim',
                duration: 1500,
                to: { x: 14 },
                obj: { x: 0 },
                repeat: 1,
                sequence: ['stageTwoAnimationFinished']
            });
            
            tween.start();

        },

        hideBonusGame: () => {
            _runAnimationSeq('hideSecondStageText');
            _runAnimationSeq('clearSelectedIndex');
        },

        stageTwoAnimationFinished: () => {
            _stopAnimation = true;
            nge.observer.fire('pickupBonusGame.stageTwoAnimation.finished');
        },

        hideStageTwoText: () => {
            for(let i = 1; i < 7; i++){
                const obj = _cache.get('pG2Win'.concat(i));
                const name = 'pG2Win'.concat(i);
                const next = 'pG2Win'.concat(i + 1);
                _callbacks[name] = () => {
                    const tween = _makeTween({
                        name: 'hideStageOneText',
                        duration: 150,
                        to: { alpha: 0 },
                        obj: obj,
                        sequence: [next]
                    });
                  
                    tween.start();
                };
            }

            _runAnimationSeq('pG2Win1');
        },
        
        showLaternWinAmountText: () => {
            this._updateStageTwoWinData();

            const textObj = _cache.get('pG2Win'.concat(_selectedPickIndex));
            textObj.visible = true;

            const tween = _makeTween({
                name: 'scaleNonWinText',
                duration: 200,
                obj: textObj,
                to: { alpha: 1 },
                decorateObj: textObj,
                sequence: ['showStageTwoOtherWinTexts']
            });

            tween.start();

        },
            
        showStageTwoOtherWinTexts: () => {
            let firstIndex = null;

            for(let i = 1; i < 7; i++){
                const name = 'pG2Win'.concat(i);
                delete _callbacks[name];

                if(i === _selectedPickIndex)
                    continue;

                if(!firstIndex)
                    firstIndex = i;

                this._showStageNonWinText(i, 'pG2Win');
            }

            const startName = 'pG2Win'.concat(firstIndex);
            _runAnimationSeq(startName);
        },

        finishSecondStage: () => {
            const index = nge.localData.get('pickupBonusGame.stage2.bonusItem.index') || -1;
            _selectedPickIndex = parseInt(index, 10);
            _runAnimationSeq('updateStageTwoInfo');
            _stage1InProgress = false;
        },

        hideSecondStageText: () => {
            const tween = _makeTween({
                name:'hideSecondStageText',
                duration: 500,
                to: { alpha: 0 },
                obj: _cache.get('pg2Text'),
                sequence: ['hideLaterns', 'hideStageTwoText']
            });
          
            tween.start();
        },

        hideLaterns: () => {
            for(let i = 1; i < 7; i++){
                const container = _cache.get('pg10'.concat(i, 'Container'));
                let name = 'hideLatern'.concat(i);
                let callbackName = (( i + 1 ) < 7) ? 'hideLatern'.concat(i + 1) : 'hideStage2InfoText';
                
                _callbacks[name] = () => {
                    const tween = _makeTween({
                        name: 'hideLatern',
                        duration: 150,
                        to: { alpha: 0 },
                        obj: container,
                        decorateObj: container.children[0],
                        sequence: [callbackName]
                    });
                  
                    tween.start();
                };
            }

            _runAnimationSeq('hideLatern1');
        },

        hideStage2InfoText: () => {
            const tween = _makeTween({
                name:'hideStage2InfoText',
                duration: 100,
                to: { alpha: 0 },
                obj: _cache.get('pickGameInfo'),
                sequence: ['hidePickGameBg']
            });
          
            tween.start();
        },

        hidePickGameBg: () => {
            const tween = _makeTween({
                name:'hidePickGameBg',
                duration: 500,
                to: { alpha: 0 },
                obj: _cache.get('pickGameBgContainer'),
                sequence: ['showSlotMachineContainer']
            });
            tween.start();
        },
        
        showSlotMachineContainer: () => {
            const tween = _makeTween({
                name:'showSlotMachineContainer',
                duration: 300,
                to: { alpha: 1 },
                obj: _cache.get('slotMachineContainer'),
                sequence: ['finishPickGame']
            });
            tween.start();
        },

        finishPickGame: () => {
            const pickGameContainer = _cache.get('pickGameContainer');
            pickGameContainer.visible = false;

            nge.localData.set('pickupBonusGame', {});
            
            nge.observer.fire('pickupBonusGame.finished');
            _stage2InProgress = false;
            _stopAnimation = true;
        },

        determineCustomAnimationIndex: () => { 
            if(_stopAnimation)
                return;

            _itemCustomAnimIndex = nge.Lib.Helper.getRandomInt(1, 6);
            
            let nextAnimation = '';

            if(_stage1InProgress)
                nextAnimation = 'runDroneAnimation';
            
            if(_stage2InProgress)
                nextAnimation = 'runLaternAnimation';

            _runAnimationSeq(nextAnimation); 
        },

        runDroneAnimation: () => {
            const tween = _makeTween({
                name:'runDroneAnimation',
                duration: 1000,
                to: { x: 14 },
                obj: { x: 0 },
                sequence: ['determineCustomAnimationIndex']
            });
            tween.start();
        },

        runLaternAnimation: () => {
            const tween = _makeTween({
                name:'runLaternAnimation',
                duration: 1000,
                to: { x: 14 },
                obj: { x: 0 },
                sequence: ['determineCustomAnimationIndex']
            });
            tween.start();
        },

        runBorderWaitingAnimation: () => {
            this.stopAnimation('runBorderPickAnimation');

            const borderContainer = this._getBorderContainer();
            const tween = _makeTween({
                name:'runBorderWaitingAnimation',
                duration: 9000,
                to: {},
                obj: borderContainer,
                decorateObj: borderContainer.children,
                repeat: -1
            });
            tween.start();
        },
        
        runBorderPickAnimation: () => {
            this.stopAnimation('runBorderWaitingAnimation');

            const borderContainer = this._getBorderContainer();
            const tween = _makeTween({
                name:'runBorderPickAnimation',
                duration: 200,
                to: { alpha: 0 },
                obj: borderContainer,
                repeat: -1,
                yoyo: true
            });
            tween.start();
        }
    };

    this._getBorderContainer = () => {
        const borderContainer = _cache.get('borderShineContainer');
        borderContainer.alpha = 1;
        return borderContainer;
    };

    this._showStageNonWinText = (index, selector) => {
        const name = selector.concat(index);
        const obj = _cache.get(name);
        const addition = ((index + 1) === _selectedPickIndex) ? 2 : 1; 
        const next = selector.concat(index + addition);
        let alpha = 0.8;

        if(selector.indexOf('pG2Win') !== -1)
            alpha = 0.65;

        _callbacks[name] = () => {
            const tween = _makeTween({
                name: 'scaleNonWinText',
                duration: 500,
                obj: obj,
                to: { alpha } /////
            });
            _runAnimationSeq(next);
            tween.start();
        };
    };

    this._updateStageOneWinData = () => {
        const items = nge.localData.get('pickupBonusGame.stage1.items') || [];

        items.forEach(item => {
            const { value, index } = item;
            const textureName = (_selectedPickIndex === parseInt(index, 10)) ? 'pGFreeSpins' : 'pGFreeSpinsAmount';
            const obj = _cache.get('pG1Win'.concat(index));
            const scale = 1 / nge.assets.getQualityFactor();
    
            obj.scale.set(scale);
            obj.loadTexture(textureName.concat(value));
        });
    };

    this._updateStageTwoWinData = () => {
        const items = nge.localData.get('pickupBonusGame.stage2.items') || [];

        items.forEach(item => {
            const { value, index } = item;
            const obj = _cache.get('pG2Win'.concat(index));
            const scale = 1 / nge.assets.getQualityFactor();
            const totalScale = (parseInt(index, 10) === _selectedPickIndex) ? scale : (scale * 0.7);
            
            obj.loadTexture('multiplier'.concat(value));
            obj.scale.set(totalScale);
        });
    };

    const _makeTween = function (config) {
        const {
            duration = 1000,
            name,
            delay = 0,
            obj = {},
            to = {},
            repeat = 0,
            sequence = false,
            easing = null,
            yoyo = false
        } = config;

        const tween = nge.tween.add(obj).to(to, duration, easing, false, delay, repeat, yoyo);
        const typeCheck = nge.Lib.Helper.typeCheck;

        if(typeCheck.isArray(sequence))
            sequence.forEach(seq => tween.onComplete.add(() => _runAnimationSeq(seq)));

        _tweensCache[name] = tween;

        tween.onComplete.add(() => {
            for(let name in to)
                obj[name] = to[name];

            delete _tweensCache[name];
        });
        
        return _decorateTween(tween, config);
    };

    const _decorateBorderWaitingAnimation = (tween, config) => {
        const decorateObj = config.decorateObj;
        const factor = 20;
        let couter = 0;
        let divider = 0;
    
        tween.onUpdateCallback(() => {
            if(couter === factor){
                couter = 0;
                divider = (divider === 0) ? 1 : 0;
            }

            decorateObj.forEach((item, index) => {
                item.visible = (index % 2) === divider;
            });

            couter++;
        });

        return tween;
    };

    const _decorateTween = (tween, config) => {
        switch (config.name) {
            case 'showDrone':
            case 'showLatern':
            case 'showDroneWinAmountText':
                return _decorateShowScale(tween, config);

            case 'hideDrone':
            case 'hideLatern':
            case 'hideStageOneText':
            case 'hideStageTwoText':
                return _decorateHideScale(tween, config);

            case 'runDroneAnimation':
            case 'runPickDroneAnim':
                return _decorateCustomDroneAnimation(tween, config);

            case 'runLaternAnimation':
            case 'runPickLaternAnim':
                return _decorateCustomLaternAnimation(tween, config);

            case 'runBorderWaitingAnimation':
                return _decorateBorderWaitingAnimation(tween, config);

            case 'hidePopupByScaleAndAlpha':
                return _decoreateHidePopup(tween, config);

            default:
                return tween;
        }
    };

    const _decoreateHidePopup = (tween, config) => {
        const { decorateObj } = config;
        const easing = nge.Lib.Tween.Easing.Quadratic.In;
        tween.to({ x: 0, y: 0 }, 300, easing);
        
        let second = false;
        let curr = 0;

        tween.onUpdateCallback((t, v) => {
            if(v < curr)
                second = true;
            
            curr = v;

            if(second)
                decorateObj.alpha = 1 - v; 
        });


        return tween;
    };

    const _ldgz = nge.Lib.Helper.LdgZero;

    const _decorateCustomDroneAnimation = (tween, config) => {
        const clbck = {
            'runDroneAnimation': (t, v, tv) => {
                for(let i = 1; i < 7; i++){
                    if(_selectedPickIndex === i)
                        continue;
                      
                    const animName = (_itemCustomAnimIndex === i) ? 'robot_pick_' : 'robot_idle_';
                    const frameIndex = _ldgz(Math.round(tv.vEnd.x * v), 3);
                    const frameName = animName.concat(frameIndex);
                    var obj = _cache.get('dron'.concat(i, 'Container')).children[0];
                    obj.loadTexture(frameName);
                    obj.scale.set(1.25 / _quality);
                }
            },

            'runPickDroneAnim': (t, v, tv) => {
                const animName = 'robot_win_';
                const frameIndex = _ldgz(Math.round(tv.vEnd.x * v), 3);
                const frameName = animName.concat(frameIndex);
                var obj = _cache.get('dron'.concat(_selectedPickIndex, 'Container')).children[0];
                obj.loadTexture(frameName);
                obj.scale.set(1.25 / _quality);
            }     
        };

        tween.onUpdateCallback(clbck[config.name]);

        return tween;
    };

    const _decorateCustomLaternAnimation = (tween, config) => {
        const clbck = {
            'runLaternAnimation': (t, v, tv) => {
                for(let i = 1; i < 7; i++){
                    if(_selectedPickIndex === i)
                        continue;
                      
                    const animName = (_itemCustomAnimIndex === i) ? 'flask_pick_animation_' : 'flask_idle_animation_';
                    const frameIndex = _ldgz(Math.round(tv.vEnd.x * v), 3);
                    const frameName = animName.concat(frameIndex);

                    var obj = _cache.get('pg10'.concat(i, 'Container')).children[0];
                    obj.loadTexture(frameName);
                    obj.scale.set(1.25 / _quality);
                }
            },

            'runPickLaternAnim': (t, v, tv) => {
                const animName = 'flask_win_animation_';
                const frameIndex = _ldgz(Math.round(tv.vEnd.x * v), 3);
                const frameName = animName.concat(frameIndex);
                var obj = _cache.get('pg10'.concat(_selectedPickIndex, 'Container')).children[0];
                obj.loadTexture(frameName);
                obj.scale.set(1.25 / _quality);
            }     
        };

        tween.onUpdateCallback(clbck[config.name]);

        return tween;
    };

    const _decorateHideScale = (tween, config) => {
        const decorateObj = config.decorateObj || config.obj;
        const scale = 1.25 / nge.assets.getQualityFactor();

        tween.onStart.add(function(){
            if(config.name === 'hideLatern' || config.name === 'hideDrone')
                nge.observer.fire('sound.pick.disappear');
        });

        tween.onUpdateCallback((t, v) => {
            decorateObj.scale.set(scale - scale * v);
        });

        tween.onComplete.add(() =>
            decorateObj.scale.set(0.01)
        );

        return tween;
    };

    const _decorateShowScale = (tween, config) => {
        const decorateObj = config.decorateObj || config.obj;
        const scale = 1.25 / nge.assets.getQualityFactor();
        
        if(config.name === 'showLatern' || config.name === 'showDrone')
            nge.observer.fire('sound.pick.appear');

        // tween.onStart.add(function(){
            
        // });

        tween.onUpdateCallback((t, v) =>
            decorateObj.scale.set(scale * v)
        );

        tween.onComplete.add(() =>
            decorateObj.scale.set(scale)
        );

        return tween;
    };
});



nge.App[nge.appNS].Com.PickupBonusGame.Controller = nge.Com.Base.extend(function () {
    let _created = false;
    let _service = null;

    
    this.create = () => {
        this.createDefault();

        _service = this.getInstance('Service');
        _service.create();       

        if(!_created)
            this._subscribe();
            
        _created = true;
    };

    this._hideHandler = () => _service.hidePickupBonusGame();
    this._startHandler = () => _service.startPickupBonusGame();
    this._stage1FinishHandler = data => _service.stage1Finish(data);
    this._stage2FinishHandler = data => _service.stage2Finish(data);

    this._subscribe = () => {
        nge.observer.add('pickupBonusGame.start', this._startHandler);
        nge.observer.add('pickupBonusGame.stage1.finish', this._stage1FinishHandler);
        nge.observer.add('pickupBonusGame.stage2.finish', this._stage2FinishHandler);
        nge.observer.add('pickupBonusGame.hide', this._hideHandler);
    };
});



nge.App[nge.appNS].Com.PickupBonusGame.ObjectsCache = nge.Com.Base.extend(function () {
    this.singleton = true;
    
    let _cache = [];

    this.reset = () => {
        _cache = [];
    };
    
    this.get = (name) => {
        if(!_cache[name])
            _cache[name] = nge.findOne('^'.concat(name)) || null;
    
