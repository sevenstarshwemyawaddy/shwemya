/**
 * @author Yurii
 * @date   22.12.2016
 */

nge.App[nge.appNS].Mlm.Brain.Sounds = nge.App.ClassicGameBase.Mlm.Brain.Sounds.extend(function () {
    var _self = this;

    this.soundsForSymbolsHandler = function (data) {
        var shouldScatterSound = !(data.symbolsNames.length >= 3 && data.symbolsNames.every(function (s) {
            return _self.scatterSymbols.indexOf(s) !== -1;
        }));

        if (shouldScatterSound) {
            return this.super.soundsForSymbolsHandler(data);
        } else {
            nge.observer.fire('winlines.setCurrentLineDuration', 500, 1);
        }
    };
});



