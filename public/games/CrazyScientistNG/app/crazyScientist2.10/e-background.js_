        ]
    };

    this.lineCustomCoords = [];
});




nge.App[nge.appNS].Com.Winlines.View = nge.Com.Winlines.View.extend(function () {
    var _getWorld = function (obj, field, sum) {
        if (!sum)
            sum = 0;
        sum += +obj[field];
        if (obj.parent)
            return _getWorld(obj.parent, field, sum);
        return sum;
    };

    this.create = function () {
        var cfg = this.getInstance('Cfg');
        var smCfg = this.getInstance('Cfg', 'slotMachine').get();

        var parentName = (cfg.customParentName) ? cfg.customParentName : smCfg.parentName;
        var parentContainer = nge.findOne('^' + parentName);

        var lineParsedCoords = [];

        var hasWinline = false;
        var lineIndex = 0;
        do {
            hasWinline = nge.localData.get('coordinates.winline' + (lineIndex + 1) + 'Point0');
            if (hasWinline) {
                lineParsedCoords.push([]);
                var pointIndex = 0;
                var point = false;
                do {
                    point = nge.localData.get('coordinates.winline' + (lineIndex + 1) + 'Point' + pointIndex);
                    if (point)
                        lineParsedCoords[lineIndex].push([point.x - _getWorld(parentContainer, 'x'), point.y - _getWorld(parentContainer, 'y')]);

                    pointIndex++;
                } while (point);
            }
            lineIndex++;
        } while (hasWinline);

        if (lineParsedCoords.length > 0) {
            cfg.lineCustomCoords = lineParsedCoords;
        }

        this.super.create();
    };
});



