nge.Com.Respin = {};



nge.Com.Respin.Controller = nge.Com.Base.extend(function () {
    var _self;
    var _created;
    var _pauseMode = false;
    var _inProgress = false;
    var _totalWin = 0;
    var _canSpin = false;
    this._restoringFlag = false;

    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        _self = this;

        if (!_created)
            _subscribe();

        nge.localData.set('respin.inProgress', false);
        nge.localData.set('spin.type', "SpinRequest");

        _created = true;
        return true;
    };

    this.freeReSpinsStart = function (spins) {
        _self.respinStart(spins);
        _self.setSpinTypeFreeRespins();
    };

    this.respinStart = function (spins) {
        nge.observer.fire('respin.startProcess.start');
        spins = parseInt(spins);
        _inProgress = true;
        _canSpin = true;

        var respinProgress = nge.localData.get('respin.inProgress');
        var respinTotalCount = nge.localData.get('respin.spinsTotal');
        var respinTotalCountResetFlag = nge.localData.get('respin.spinsTotalResetFlag');

        if (respinTotalCountResetFlag || !respinProgress || !respinTotalCount) {
            respinTotalCount = 0;
            nge.localData.set('respin.spinsTotalResetFlag', false);
        }

        respinTotalCount += spins;
        var allData = nge.localData.getAll();

        _self.setSpinTypeRespins();
        nge.localData.set('respin.inProgress', true);
        nge.localData.set('respin.lastSpin', false);

        if (!_self._restoringFlag) {
            nge.localData.set('respin.spinsTotal', respinTotalCount);
            nge.localData.set('respin.spinsLeft', parseInt(nge.localData.get('respin.spinsLeft')) || 0 + spins);
        }

        nge.observer.fire('buttons.respinMode');

        _self._restoringFlag = false;

        nge.observer.fire('respin.startProcess.end');
    };

    this.setSpinTypeRespins = function () {
        nge.localData.set('spin.type', 'RespinRequest');
    };

    this.setSpinTypeFreeRespins = function () {
        nge.localData.set('spin.type', 'FreeRespinRequest');
    };

    this.spinCommand = function () {
        _spinCommand();
    };

    var _spinHandleResponse = function (data) {
        if (!nge.localData.get('respin.inProgress'))
            return false;

        nge.localData.set('respin.spinsLeft', data.reSpinRemain);
    };

    this.finishRespin = function () {
        _inProgress = false;
        _totalWin = 0;

        var inProgress = nge.localData.get('respin.inProgress');
        if (inProgress) {
            var fsInProgress = nge.localData.get('freespin.inProgress');

            if (fsInProgress)
                nge.localData.set('spin.type', "FreeSpinRequest");
            else
                nge.localData.set('spin.type', "SpinRequest");

            nge.localData.set('respin.spinsTotalResetFlag', true);
            nge.localData.set('respin.inProgress', false);
        }

        nge.observer.fire('respin.end');
    };

    var _spinCompleteResponse = function () {
        var inProgress = nge.localData.get('respin.inProgress');
        if (!inProgress)
            return false;

        var lastSpinWin = nge.localData.get('slotMachine.slotWin');
        var spinsLeft = parseInt(nge.localData.get('respin.spinsLeft'));

        if (spinsLeft === 0) {
            _self.finishRespin();
        } else {
            if (spinsLeft > 0) {
                _canSpin = true;
            }
        }
    };

    var _pause = function () {
        _pauseMode = true;
    };

    var _resume = function () {
        _pauseMode = false;
        _spinCommand();
    };

    var _spinCommand = function () {
        if (!_canSpin || _pauseMode)
            return false;

        nge.observer.fire('slotMachine.spinCommand');
        _canSpin = false;
    };

    var _spinRestore = function (data) {
        if (data.state !== 'ReSpins' && data.state !== 'FreeReSpins')
            return false;

        var spins, totalCount = 0;

        if (data.reSpinRemain) {
            spins = data.reSpinRemain;
        } else {
            if (data.slotWin && data.slotWin.linePickBonus)
                for (var i = 0; i < data.slotWin.linePickBonus.length; i++) {
                    var bonusName = data.slotWin.linePickBonus[i].bonusName;

                    if (bonusName === 'ReSpins' || bonusName === 'FreeReSpins') {
                        spins = data.slotWin.linePickBonus[i].params;
                        break;
                    }
                }
        }

        if (data.reSpinsTotal)
            totalCount = parseInt(data.reSpinsTotal);

        nge.localData.set('respin.spinsLeft', spins);
        nge.localData.set('respin.spinsTotal', totalCount);
        //need to wait until initial animation end
        _self._restoringFlag = true;
        nge.observer.fire('respin.start', spins, 1300);
        return true;
    };

    var _winHandler = function (winAmount) {
        if (!_inProgress)
            return false;

        _totalWin = _totalWin + winAmount;

        nge.observer.fire('respinWin', {
            winAmount: winAmount,
            respinTotalWin: _totalWin
        });
    };

    var _subscribe = function () {
        nge.observer.add('freeReSpins.start', _self.freeReSpinsStart);
        nge.observer.add('respin.start', _self.respinStart);
        nge.observer.add('slotMachine.spinResponse', _spinHandleResponse);
        nge.observer.add('slotMachine.spinComplete', _spinCompleteResponse);
        nge.observer.add('respin.restore', _spinRestore);
        nge.observer.add('win', _winHandler);
        nge.observer.add('respin.pause', _pause);
        nge.observer.add('respin.resume', _resume);
    };

});



nge.Com.Settings = {};



nge.Com.Settings.Cfg = Class.extend(function () {
});



nge.Com.Settings.Controller = nge.Com.Base.extend(function () {
    var _created;

    var _self;
    var _cfg;

    this.preload = function () {
        _cfg = this.getInstance('Cfg');
        this.preloadDefault(false, {betGroup: 'settingsContent'});
    };

    /**
     * create
     * @returns {Boolean}
     */
    this.create = function () {
        _self = this;

        if (!_created) {
            _subscribe();
        }

        var quality = nge.localData.get('settings.imageQuality');
        var sound = nge.localData.get('settings.sounds');
        if (!quality) {
            quality = "high";
            nge.localData.set('settings.imageQuality', quality);
        }

        _switchSwitch(sound);
        _setQualityButtonsStyle(quality);
        _created = true;
        return true;
    };

    var _subscribe = function () {
        nge.observer.add(
            'settings.switchSound',
            _switchSound
            );

        nge.observer.add(
            'settings.changeImageQuality',
            _changeQuality
            );

        return true;
    };

    var _switchSound = function () {
        var state = nge.localData.get('settings.sounds');
        _switchSwitch(!state);
    };

    var _switchSwitch = function (state) {
        nge.localData.set('settings.sounds', state);
        nge.observer.fire('settings.sounds.changed', state);
        var switchButton = nge.find('^switch');
        var pick = nge.find('^pick');
        var text = nge.find('^switchText');

        if (!switchButton)
            return false;

        if (!state) {
            switchButton.removeClass("activeSwitch");
            pick.removeClass("activePick");
            text.removeClass("onSwitch");
            text.addClass("offSwitch");
        } else {
            switchButton.addClass("activeSwitch");
            pick.addClass("activePick");
            text.removeClass("offSwitch");
            text.addClass("onSwitch");
        }
    };

    var _changeQuality = function (data) {
        nge.localData.set('settings.imageQuality', data);
        //_setQualityButtonsStyle(data);

        //forse restart scene
        _forceRestartSettings();
    };

    var _forceRestartSettings = function () {
        var state = nge.statesManager.getCurrentName();
        nge.statesManager.display(state, false, true);
        nge.observer.add(
            'StatesManager.create.end',
            function () {
                nge.observer.fire(
                    'tabs.settingsPopupObject.switch',
                    {
                        tab: 'SettingsTab',
                        container: 'settingsPopupSettingsContainer'
                    },
                    1
                    );
                nge.observer.remove(
                    'StatesManager.create.end',
                    false,
                    'changeQualityTempEvent',
                    true
                    );
            },
            'changeQualityTempEvent',
            true
            );
    };

    var _setQualityButtonsStyle = function (data) {
        var lowButton = nge.find('^tab_settings_left');
        var medButton = nge.find('^tab_settings_center');
        var highButton = nge.find('^tab_settings_right');
        var lowButtonText = nge.find('^tab_settings_left_text');
        var medButtonText = nge.find('^tab_settings_center_text');
        var highButtonText = nge.find('^tab_settings_right_text');

        if (
            !lowButton || !medButton || !highButton ||
            !lowButtonText || !medButtonText || !highButtonText
            )
            return false;

        switch (data) {
            case "low":
                lowButton.addClass("activeBtn");
                medButton.removeClass("activeBtn");
                highButton.removeClass("activeBtn");
                lowButtonText.addClass("activeText");
                medButtonText.removeClass("activeText");
                highButtonText.removeClass("activeText");
                break;
            case "medium":
                lowButton.removeClass("activeBtn");
                medButton.addClass("activeBtn");
                highButton.removeClass("activeBtn");
                lowButtonText.removeClass("activeText");
                medButtonText.addClass("activeText");
                highButtonText.removeClass("activeText");
                break;
            case "high":
                lowButton.removeClass("activeBtn");
                medButton.removeClass("activeBtn");
                highButton.addClass("activeBtn");
                lowButtonText.removeClass("activeText");
                medButtonText.removeClass("activeText");
                highButtonText.addClass("activeText");
                break;
        }
    };
});



